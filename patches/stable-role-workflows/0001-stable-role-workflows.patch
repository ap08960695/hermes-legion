+def _profile_toolsets(assignee: str) -> Optional[set]:
+    """CLI toolsets configured for *assignee* (None when unreadable: unknown never rejects)."""
+    try:
+        import hermes_yaml
+        from hermes_constants import get_default_hermes_root
+        cfg = hermes_yaml.safe_load((get_default_hermes_root() / "profiles" / assignee / "config.yaml").read_text()) or {}
+        tools = (cfg.get("platform_toolsets") or {}).get("cli") or cfg.get("toolsets")
+        return set(tools) if isinstance(tools, list) else None
+    except Exception:
+        return None
+
+
+def _tool_fit_error(assignee: str, title: str, body: str, toolsets_of=_profile_toolsets) -> Optional[str]:
+    """Reject cards whose body requires running claimctl on a bot without the terminal toolset."""
+    from hermes_cli.kanban_task_contract import preflight_reason
+    reason = preflight_reason(body, assignee)
+    if reason:
+        return reason
+    if "claimctl claim" not in f"{title or ''} {body or ''}":
+        return None
+    have = toolsets_of(assignee)
+    if have is None or "terminal" in have:
+        return None
+    family = next((f for f in _ROLE_FAMILIES if assignee in f), frozenset())
+    fits = sorted(b for b in family if b != assignee and "terminal" in (toolsets_of(b) or set()))
+    return (f"{assignee} has no terminal toolset, so it cannot run claimctl named in this card. "
+            f"Assign a terminal-capable bot{(' such as ' + ', '.join(fits)) if fits else ''}, "
+            "or drop the claimctl step for this read-only role.")
+
+
+def _oversize_warnings(body: str) -> list[str]:
+    import re as _re
+    warns = []
+    body = body or ""
+    paths = set(_re.findall(r"(?:/[\w.\-]+){2,}\.\w{1,6}", body))
+    if len(body) > 8000:
+        warns.append(f"body is {len(body)} chars; very large cards time out and bloat context - consider splitting")
+    if body.strip() and "BRIEF" not in body:  # local patch 15: workers only see their card; the brief carries the big picture
+        warns.append("body has no 'BRIEF: <path>' line; start it with the workstream BRIEF.md so the bot sees the goal, user flow and decisions")
+    if len(paths) > 12:
+        warns.append(f"card names {len(paths)} distinct files; target <= ~5 per card - consider splitting by file group (playbook)")
+    return warns
+
