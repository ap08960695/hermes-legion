@@ -0,0 +1,56 @@
+import { ModelPicker } from './model-picker'
+import type { RosterRow } from './types'
+
+export interface BotModelSelection {
+  provider: string
+  model: string
+  effort: string
+}
+export interface BotModelSnapshot extends BotModelSelection {
+  supported_efforts: string[]
+}
+
+export function editableModel(model?: BotModelSnapshot | null): BotModelSelection | null {
+  return model ? { provider: model.provider, model: model.model, effort: model.effort } : null
+}
+
+interface Props {
+  bot: RosterRow
+  opened: BotModelSnapshot
+  value: BotModelSelection
+  onChange: (patch: Partial<BotModelSelection>) => void
+}
+
+export function BotModelFields({ bot, opened, value, onChange }: Props) {
+  const sameRoute = opened.provider === value.provider && opened.model === value.model
+
+  const efforts = sameRoute
+    ? opened.supported_efforts
+    : ['none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra']
+
+  const options = [...new Set([...efforts, ...(value.effort ? [value.effort] : [])])]
+
+  return (
+    <div className="grid gap-2 border-t border-(--ui-stroke-secondary) pt-3">
+      <ModelPicker bot={bot} onChange={onChange} requiredSelection value={value} />
+      <label className="grid gap-1 text-xs">
+        Effort
+        <select
+          className="h-8 w-full rounded-md border border-(--ui-stroke-secondary) bg-(--ui-bg) px-2 text-xs"
+          onChange={event => onChange({ effort: event.target.value })}
+          value={value.effort}
+        >
+          <option value="">Keep existing effort policy</option>
+          {options.map(effort => (
+            <option key={effort} value={effort}>
+              {effort}
+            </option>
+          ))}
+        </select>
+      </label>
+      <p className="text-xs text-(--ui-text-tertiary)">
+        Defaults for new runs. Existing chats keep their model. Quotas and fallbacks stay unchanged.
+      </p>
+    </div>
+  )
+}
