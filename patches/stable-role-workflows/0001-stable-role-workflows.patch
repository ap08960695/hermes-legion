@@ -0,0 +1,46 @@
+"""A rejected pending review parks in its own phase without borrowing a worker claim."""
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_db_connect import connect_closing
+
+
+def pending_review(conn):
+    task = kb.create_task(conn, title='Synthetic deliverable', assignee='implementer')
+    run = kb.claim_task(conn, task)
+    assert kb.request_review(conn, task, summary='Ready for independent review', reviewer='reviewer',
+                             expected_run_id=run.current_run_id)
+    return task, kb.latest_run(conn, task)
+
+
+def test_pending_review_can_be_blocked_without_rewriting_implementation(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    kb.init_db()
+    with connect_closing() as conn:
+        task, implementation = pending_review(conn)
+        assert kb.block_task(conn, task, reason='Reviewer configuration failed preflight', kind='capability',
+                             expected_status='review', expected_assignee='reviewer')
+        assert kb.get_task(conn, task).status == 'blocked'
+        assert kb.get_task(conn, task).assignee == 'reviewer'
+        assert kb.get_run(conn, implementation.id) == implementation
+        assert kb.unblock_task(conn, task)
+        assert kb.get_task(conn, task).status == 'review'
+        assert kb.get_task(conn, task).assignee == 'reviewer'
+        claim = kb.claim_review_task(conn, task)
+        assert claim is not None
+        assert kb.request_changes(conn, task, reason='Missing acceptance check', expected_run_id=claim.current_run_id)[0]
+        assert kb.get_task(conn, task).assignee == 'implementer'
+
+
+def test_review_preflight_cannot_block_another_owner_or_an_active_claim(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    kb.init_db()
+    with connect_closing() as conn:
+        task, _implementation = pending_review(conn)
+        assert not kb.block_task(conn, task, reason='Stale profile', kind='capability',
+                                 expected_status='review', expected_assignee='other-reviewer')
+        live = kb.claim_review_task(conn, task)
+        assert live is not None
+        assert not kb.block_task(conn, task, reason='Stale stage', kind='capability',
+                                 expected_status='review', expected_assignee='reviewer')
+        current = kb.get_task(conn, task)
+        assert current.status == 'running' and current.current_run_id == live.current_run_id
+        assert current.claim_lock == live.claim_lock
