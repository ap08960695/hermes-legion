+# --- local patch 12: runtime floors + tool fit at create time ---
+def _runtime_floor(assignee: str) -> int:
+    """Measured runtimes: reviews/tests ran 10-15 min and hit 900s caps; agy (Gemini 1M ctx) ran 20-50 min; 2026-10-08 owner: agy gets short cards only, fail fast at 1200s and fail over."""
+    a = (assignee or "").lower()
+    if a == "antigravity" or "-agy-" in a:
+        return 1200
+    if a.startswith(("reviewer", "tester")):
+        return 1800
+    return 0
