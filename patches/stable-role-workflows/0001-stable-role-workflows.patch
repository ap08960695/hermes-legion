+    with patch.object(agent,'_flush_messages_to_session_db',return_value=True):
+        assert _flush_session_db_after_tool_progress(agent,[message],stage='test')
+    assert 'iteration budget checkpoint' in message['content']
+
+
+@pytest.mark.parametrize('mismatch', [None, 'pid', 'claim_lock', 'started_at'])
+def test_managed_worker_terminal_uses_bound_process_not_submitter(owned_run, mismatch):
