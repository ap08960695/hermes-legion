+"""Unplanned decomposition must enter THINK, not strand an unbound ACTION."""
+import json
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_decompose as decomp
+from hermes_cli.bot_workflow import configure_workflow, workflow_snapshot
+from hermes_cli.profiles import ProfileInfo
+
+
+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    home = tmp_path / 'state'
+    home.mkdir()
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path / 'user')
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(tmp_path / 'board'))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    infos = []
+    for name, mode, peer in [('planner', 'think', 'executor'), ('executor', 'action', 'planner'),
+                              ('legacy', None, None)]:
+        root = home / 'profiles' / name
+        root.mkdir(parents=True)
+        (root / 'config.yaml').write_text('model:\n  default: offline-only\n')
+        if mode:
+            configure_workflow(root, {'role': 'developer', 'mode': mode, 'family': 'gpt',
+                                      'counterpart': peer}, workflow_snapshot(root)['revision'])
+        infos.append(ProfileInfo(name=name, path=root, is_default=False, gateway_running=False,
+                                 description='Software engineering'))
+    monkeypatch.setattr(decomp.profiles_mod, 'list_profiles', lambda **kwargs: infos)
+    monkeypatch.setattr(decomp.profiles_mod, 'get_active_profile_name', lambda: 'legacy')
+    kb.init_db()
+    return home
+
+
+def aux(monkeypatch, assignee):
+    response = MagicMock()
+    response.choices[0].message.content = json.dumps({'fanout': True, 'tasks': [
+        {'title': 'Plan the change', 'body': 'Produce a bounded accepted plan.',
+         'assignee': assignee, 'parents': []}]})
+    client = MagicMock(return_value=response)
+    monkeypatch.setattr('agent.auxiliary_client.call_llm', client)
+    return client
+
+
+def test_action_choice_routes_to_its_real_thinker_and_can_start_planning(world, monkeypatch):
+    aux(monkeypatch, 'executor')
+    with kbc.connect_closing() as conn:
+        parent = kb.create_task(conn, title='Requested change', triage=True)
+    result = decomp.decompose_task(parent)
+    assert result.ok, result.reason
+    with kbc.connect_closing() as conn:
+        task = kb.get_task(conn, result.child_ids[0])
+        assert task.assignee == 'planner'
+        run = kb.claim_task(conn, task.id)
+        assert run is not None
+        assert 'THINK' in kb.build_worker_context(conn, task.id)
+        with pytest.raises(ValueError, match='role_plan'):
+            kb.complete_task(conn, task.id, summary='no plan', expected_run_id=run.current_run_id)
+
+
+def test_roster_exposes_think_contract_and_omits_action_and_invalid_pair(world):
+    roster, names = decomp._build_roster()
+    assert names == {'planner', 'legacy'}
+    text = decomp._format_roster(roster)
+    assert 'THINK' in text and 'role_plan' in text and 'executor' in text
+    root = world / 'profiles' / 'executor'
+    configure_workflow(root, {}, workflow_snapshot(root)['revision'])
+    _, names = decomp._build_roster()
+    assert 'planner' not in names and 'legacy' in names
+
+
+def test_action_default_routes_unassigned_children_to_think(world, monkeypatch):
+    aux(monkeypatch, None)
+    from hermes_cli.config import atomic_config_replace
+    atomic_config_replace(world / 'config.yaml', {'kanban': {'default_assignee': 'executor'}})
+    with kbc.connect_closing() as conn:
+        parent = kb.create_task(conn, title='Requested change', triage=True)
+    result = decomp.decompose_task(parent)
+    assert result.ok, result.reason
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, result.child_ids[0]).assignee == 'planner'
+
+
+def test_action_root_is_refused_before_an_auxiliary_call(world, monkeypatch):
+    called = aux(monkeypatch, 'executor')
+    with kbc.connect_closing() as conn:
+        parent = kb.create_task(conn, title='Misrouted request', assignee='executor', triage=True)
+    result = decomp.decompose_task(parent)
+    assert not result.ok and 'THINK' in result.reason
+    called.assert_not_called()
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, parent).status == 'triage'
+        assert kb.child_ids(conn, parent) == []
+
+
+def test_pair_requires_both_dispatch_permissions_before_planning(world, monkeypatch):
+    from hermes_cli.config import atomic_config_replace
+
+    atomic_config_replace(world / 'config.yaml', {'kanban': {'dispatch_profiles': ['planner', 'legacy'],
+                                                           'default_assignee': 'executor'}})
+    roster, names = decomp._build_roster()
+    assert names == {'legacy'}
+    called = aux(monkeypatch, None)
+    with kbc.connect_closing() as conn:
+        parent = kb.create_task(conn, title='Pair is not admitted', triage=True)
+    result = decomp.decompose_task(parent)
+    assert not result.ok and 'dispatcher' in result.reason
+    called.assert_not_called()
+
+
+def test_ineligible_action_choice_does_not_fall_back_to_another_bot(world, monkeypatch):
+    from hermes_cli.config import atomic_config_replace
+
+    atomic_config_replace(world / 'config.yaml', {'kanban': {'dispatch_profiles': ['legacy']}})
+    aux(monkeypatch, 'executor')
+    with kbc.connect_closing() as conn:
+        parent = kb.create_task(conn, title='Bounded request', triage=True)
+    result = decomp.decompose_task(parent)
+    assert not result.ok and 'dispatcher' in result.reason
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, parent).status == 'triage'
+        assert kb.child_ids(conn, parent) == []
+
+
+def test_routed_captain_cannot_widen_fleet_pair_admission(world):
+    from hermes_cli.config import atomic_config_replace
+    from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+    atomic_config_replace(world / 'config.yaml', {'kanban': {'dispatch_profiles': ['legacy']}})
+    caller = world / 'profiles' / 'legacy'
+    atomic_config_replace(caller / 'config.yaml', {'kanban': {'dispatch_profiles': ['planner', 'executor']}})
+    token = set_hermes_home_override(caller)
+    try:
+        _, names = decomp._build_roster()
+        assert names == {'legacy'}
+    finally:
+        reset_hermes_home_override(token)
