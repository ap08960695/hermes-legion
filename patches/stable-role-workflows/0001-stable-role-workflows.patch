--- /dev/null
+++ b/hermes_cli/kanban_write_scopes.py
@@ -0,0 +1,48 @@
+"""Opt-in declared write conflicts; validates plans, never changes live task ownership."""
+from pathlib import PurePosixPath
+
+
+def normalize_scope(value):
+    if not isinstance(value, list) or len(value) > 64:
+        raise ValueError('write_scope must be a bounded list')
+    paths = []
+    for name in value:
+        if (not isinstance(name, str) or not name or len(name) > 1024 or '\\' in name
+                or any(ch in name for ch in '*?[]\x00') or name.startswith('/')
+                or '..' in PurePosixPath(name).parts):
+            raise ValueError('write_scope requires relative literal paths within the workspace')
+        paths.append(PurePosixPath(name).as_posix().rstrip('/'))
+    return sorted(set(paths))
+
+
+def validate_children(children):
+    from hermes_cli.kanban_task_contract import task_contract
+    scopes = []
+    for child in children:
+        contract = task_contract(child.get('body'))
+        scopes.append(normalize_scope(contract['write_scope']) if contract and 'write_scope' in contract else [])
+    for second, paths in enumerate(scopes):
+        if not paths:
+            continue
+        for first in range(second):
+            if _ordered(first, second, children) or _ordered(second, first, children):
+                continue
+            if any(_overlap(a, b) for a in scopes[first] for b in paths):
+                raise ValueError(f'write_scope overlap between child[{first}] and child[{second}]; add dependency or split declared paths')
+
+
+def _ordered(first, second, children):
+    pending = list(children[second].get('parents') or [])
+    visited = set()
+    while pending:
+        parent = pending.pop()
+        if parent == first:
+            return True
+        if parent not in visited:
+            visited.add(parent)
+            pending.extend(children[parent].get('parents') or [])
+    return False
+
+
+def _overlap(a, b):
+    return a == '.' or b == '.' or a == b or a.startswith(b+'/') or b.startswith(a+'/')
