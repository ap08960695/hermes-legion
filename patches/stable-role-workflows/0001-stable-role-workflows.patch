@@ -0,0 +1,76 @@
+"""Stop an owned worker after a durably committed completion or review handoff.
+
+Tool intent alone is never authority. Check the fresh result and the exact native
+run/claim/process identity; refuse uncertain proof without changing loop behavior.
+"""
+from contextlib import closing
+import json
+import os
+from pathlib import Path
+import sqlite3
+
+_TERMINAL_TOOLS = {'kanban_complete': 'completed', 'kanban_request_review': 'review_requested'}
+
+
+def completed_worker_summary(messages):
+    from agent.delegation_context import owned_kanban_task
+    task=owned_kanban_task()
+    if not task:return None
+    run=os.environ.get('HERMES_KANBAN_RUN_ID','');lock=os.environ.get('HERMES_KANBAN_CLAIM_LOCK','');path=os.environ.get('HERMES_KANBAN_DB','')
+    if not run.isascii() or not run.isdecimal() or len(run)>19 or not lock or not path or not Path(path).is_absolute():return None
+    outcome = _successful_completion(messages,task,int(run))
+    if outcome is None:return None
+    try:
+        return _verified_summary(Path(path),task,int(run),lock,outcome)
+    except (OSError,sqlite3.Error,ValueError,TypeError):
+        return None
+
+
+def _successful_completion(messages,task,run):
+    for message in messages:
+        if not isinstance(message,dict) or message.get('role')!='tool' or message.get('name') not in _TERMINAL_TOOLS:continue
+        content=message.get('content')
+        if not isinstance(content,str) or len(content)>1024*1024:continue
+        try:result=json.loads(content)
+        except (ValueError,TypeError):continue
+        if isinstance(result,dict) and result.get('ok') is True and result.get('task_id')==task and type(result.get('run_id')) is int and result['run_id']==run:return _TERMINAL_TOOLS[message['name']]
+    return None
+
+
+def _verified_summary(path,task,run,lock,outcome):
+    with closing(sqlite3.connect(path.resolve().as_uri()+'?mode=ro',uri=True,timeout=.25)) as conn:
+        conn.row_factory=sqlite3.Row;conn.execute('PRAGMA query_only=ON')
+        row=conn.execute('SELECT task_id,outcome,ended_at,claim_lock,worker_pid,worker_started_at,summary FROM task_runs WHERE id=?',(run,)).fetchone()
+        if not row or row['task_id']!=task or row['outcome']!=outcome or row['ended_at'] is None:return None
+        if row['claim_lock']!=lock or not _matching_worker(conn,row,task,run,lock):return None
+    summary=row['summary']
+    fallback = 'Kanban task completed successfully.' if outcome == 'completed' else 'Work handed off for independent review.'
+    return summary[:4000] if isinstance(summary,str) and summary.strip() else fallback
+
+
+def _matching_worker(conn,row,task,run,lock):
+    """Native managed runs retain the submitter PID; worker_bound owns execution identity."""
+    from hermes_cli.kanban_db_dispatch import _process_fingerprint
+
+    event = conn.execute(
+        "SELECT payload FROM task_events WHERE task_id=? AND run_id=? AND kind='worker_bound' ORDER BY id DESC LIMIT 1",
+        (task,run),
+    ).fetchone()
+    if event:
+        bound = json.loads(event['payload'])
+        if not isinstance(bound,dict) or bound.get('claim_lock') != lock:return False
+        pid, fingerprint = bound.get('pid'), bound.get('started_at')
+    else:
+        pid, fingerprint = row['worker_pid'], row['worker_started_at']
+    return (pid == os.getpid() and bool(fingerprint) and fingerprint != 'unverified'
+            and fingerprint == _process_fingerprint(os.getpid()))
+
+
+def preserve_reporting_grace(agent):
+    """Keep the existing one-round loop-cap grace that lets a worker report its outcome."""
+    _halt = agent._tool_guardrail_halt_decision
+    if (_halt is not None and os.environ.get("HERMES_KANBAN_TASK") and str(_halt.code or "").startswith("loop_")
+            and not getattr(agent, "_kanban_cap_grace_used", False)):
+        agent._kanban_cap_grace_used = True
+        agent._tool_guardrail_halt_decision = None
+
