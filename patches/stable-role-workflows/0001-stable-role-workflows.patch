+"""A last-turn native handoff must not be counted as a worker timeout."""
+import json
+import logging
+from unittest.mock import patch
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from tests.agent import test_kanban_terminal_stop as terminal
+
+agent = terminal.agent
+owned_run = terminal.owned_run
+call = terminal.call
+
+
+@pytest.mark.parametrize('handoff,phase', [('kanban_complete', 'done'), ('kanban_request_review', 'review')])
+def test_last_iteration_preserves_committed_handoff_and_failure_budget(agent, owned_run, handoff, phase):
+    from tools.kanban_tools import _handle_complete
+
+    conn, tid, run = owned_run
+    agent.max_iterations = 1
+    agent.valid_tool_names = {handoff}
+    agent.client.chat.completions.create.side_effect = [call(handoff, {'task_id': tid, 'summary': 'Verified.'}, 'handoff')]
+
+    def tool(name, args, *unused, **kwargs):
+        if name == 'kanban_complete':
+            return _handle_complete(args if isinstance(args, dict) else json.loads(args))
+        with kbc.connect_closing() as tool_conn:
+            assert kb.request_review(tool_conn, tid, summary='Verified.', reviewer='independent-reviewer', expected_run_id=run)
+        return json.dumps({'ok': True, 'task_id': tid, 'run_id': run})
+
+    with patch.object(agent, '_persist_session'), patch.object(agent, '_save_trajectory'), \
+         patch.object(agent, '_cleanup_task_resources'), patch('model_tools.handle_function_call', side_effect=tool):
+        result = agent.run_conversation('Hand off this owned task.')
+
+    task = kb.get_task(conn, tid)
+    assert task.status == phase
+    assert task.consecutive_failures == 0
+    assert kb.get_run(conn, run).outcome == ('completed' if phase == 'done' else 'review_requested')
+    assert not conn.execute("SELECT 1 FROM task_events WHERE task_id=? AND kind IN ('timed_out','gave_up')", (tid,)).fetchone()
+    assert result['completed'] is True and result['failed'] is False
+    assert agent.client.chat.completions.create.call_count == 1
+
+
+def test_unproven_tool_result_does_not_hide_a_real_worker_budget_failure(agent, owned_run):
+    from agent.turn_finalizer import _resolve_budget_fallback
+
+    conn, tid, run = owned_run
+    agent.max_iterations = 1
+    _resolve_budget_fallback(
+        agent, final_response='The worker did not finish.', api_call_count=1,
+        interrupted=True, failed=False, messages=[{'role': 'tool', 'name': 'kanban_complete',
+            'content': json.dumps({'ok': True, 'task_id': tid, 'run_id': run + 1})}],
+        _turn_exit_reason='interrupted', _pending_verification_response=None,
+        _pending_verification_response_previewed=False, logger=logging.getLogger(__name__),
+    )
+    assert kb.get_task(conn, tid).consecutive_failures == 1
+    assert kb.get_run(conn, run).outcome == 'timed_out'
+    agent.client.chat.completions.create.assert_not_called()
