+"""Role pairing is profile configuration, not model or quota readiness."""
+from pathlib import Path
+
+import pytest
+from hermes_yaml import safe_load
+
+from hermes_cli.bot_workflow import configure_workflow, workflow_snapshot
+
+
+@pytest.fixture
+def profiles(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    roots = []
+    for name in ("developer-think", "developer-action"):
+        root = home / "profiles" / name
+        root.mkdir(parents=True)
+        (root / "config.yaml").write_text("# Keep user policy\nmodel:\n  default: existing-model\n  provider: existing-provider\nfallback_providers: []\n")
+        (root / "profile.yaml").write_text("description: Existing bot\n")
+        roots.append(root)
+    return roots
+
+
+@pytest.mark.parametrize("family", ["gpt", "claude", "agy", "nim", "web"])
+def test_role_pairing_preserves_existing_models_and_has_no_readiness_claim(profiles, family):
+    thinker, actor = profiles
+    for root, mode, other in ((thinker, "think", actor), (actor, "action", thinker)):
+        before = safe_load((root / "config.yaml").read_text())
+        snapshot = workflow_snapshot(root)
+        result = configure_workflow(root, {"role": "developer", "mode": mode, "family": family,
+                                          "counterpart": other.name}, snapshot["revision"])
+        assert result["workflow"]["mode"] == mode
+        after = safe_load((root / "config.yaml").read_text())
+        after.pop("bot_workflow")
+        assert after == before
+        assert "# Keep user policy" in (root / "config.yaml").read_text()
+    paired = workflow_snapshot(actor)
+    assert paired["pair_status"] == "linked"
+    assert "dispatchable" not in paired and "quota_available" not in paired
+
+
+def test_stale_revision_cannot_overwrite_or_clear_a_newer_role(profiles):
+    thinker, actor = profiles
+    old = workflow_snapshot(thinker)
+    configured = {"role": "developer", "mode": "think", "family": "gpt", "counterpart": actor.name}
+    configure_workflow(thinker, configured, old["revision"])
+    before = (thinker / "config.yaml").read_bytes()
+    with pytest.raises(ValueError, match="changed"):
+        configure_workflow(thinker, {}, old["revision"])
+    assert (thinker / "config.yaml").read_bytes() == before
+
+
+def test_matching_role_and_opposite_mode_are_required(profiles):
+    thinker, actor = profiles
+    for root, role, mode, other in ((thinker, "developer", "think", actor),
+                                    (actor, "reviewer", "action", thinker)):
+        configure_workflow(root, {"role": role, "mode": mode, "family": "gpt",
+                                  "counterpart": other.name}, workflow_snapshot(root)["revision"])
+    assert workflow_snapshot(thinker)["pair_status"] == "incompatible"
+    assert workflow_snapshot(actor)["pair_status"] == "incompatible"
+
+
+@pytest.mark.parametrize("bad", [
+    {"role": "developer", "mode": "think", "family": "gpt", "counterpart": "../foreign"},
+    {"role": "developer", "mode": "think", "family": "paid", "counterpart": "developer-action"},
+    {"role": "developer", "mode": "think", "family": "gpt", "counterpart": "developer-think"},
+])
+def test_invalid_or_self_pair_is_rejected_without_writes(profiles, bad):
+    root = profiles[0]
+    before = (root / "config.yaml").read_bytes()
+    with pytest.raises(ValueError):
+        configure_workflow(root, bad, workflow_snapshot(root)["revision"])
+    assert (root / "config.yaml").read_bytes() == before
+
+
+def test_missing_counterpart_is_explicit_and_clearing_is_scoped(profiles):
+    root, _ = profiles
+    before = safe_load((root / "config.yaml").read_text())
+    configured = {"role": "developer", "mode": "think", "family": "gpt", "counterpart": "missing-action"}
+    configure_workflow(root, configured, workflow_snapshot(root)["revision"])
+    assert workflow_snapshot(root)["pair_status"] == "missing"
+    configure_workflow(root, {}, workflow_snapshot(root)["revision"])
+    assert safe_load((root / "config.yaml").read_text()) == before
+    assert workflow_snapshot(root)["workflow"] is None
+
+
+def test_root_profile_uses_default_identity_for_reciprocal_pair(profiles):
+    thinker, actor = profiles
+    root = thinker.parents[1]
+    (root / "config.yaml").write_text("model:\n  default: owner-model\n")
+    for path, mode, peer in ((root, "think", actor.name), (actor, "action", "default")):
+        configure_workflow(path, {"role": "developer", "mode": mode, "family": "claude",
+                                  "counterpart": peer}, workflow_snapshot(path)["revision"])
+    assert workflow_snapshot(root)["pair_status"] == "linked"
+    assert workflow_snapshot(actor)["pair_status"] == "linked"
+
+
+def test_malformed_role_is_visible_as_invalid_without_losing_revision(profiles):
+    root = profiles[0]
+    with (root / "config.yaml").open("a") as f:
+        f.write("bot_workflow:\n  mode: invalid\n")
+    snapshot = workflow_snapshot(root)
+    assert snapshot["pair_status"] == "invalid"
+    assert snapshot["workflow"] is None
+    configure_workflow(root, {}, snapshot["revision"])
+    assert workflow_snapshot(root)["pair_status"] == "unassigned"
