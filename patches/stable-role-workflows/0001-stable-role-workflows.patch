+def _profile_exists_in_reassign_fleet(name: str) -> bool:
+    """Use native profile identity and tombstone checks in the caller's fleet."""
+    from hermes_cli.profiles import normalize_profile_name
+    from hermes_constants import PROFILE_ID_RE, named_profile_is_live
+
+    try:
+        canon = normalize_profile_name(name)
+        if canon == "default":
+            return True
+        return bool(PROFILE_ID_RE.fullmatch(canon)) and named_profile_is_live(
+            _reassign_fleet_root() / "profiles" / canon
+        )
+    except (OSError, ValueError, RuntimeError):
+        return False
