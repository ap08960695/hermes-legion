@@ -0,0 +1,80 @@
+"""Bounded per-profile, board and conversation suppression of identical status reads."""
+from collections import OrderedDict
+import hashlib
+import json
+import logging
+import threading
+import time
+
+_SEEN = OrderedDict()
+_LOCK = threading.Lock()
+_LIMIT = 512
+_WINDOW = 900
+_BUDGET = 32768
+_LOG = logging.getLogger(__name__)
+
+
+def show_once(tid, args, text, *, now=None):
+    from hermes_constants import hermes_home_key
+    from hermes_cli.kanban_db import kanban_db_path
+    from tools.async_delegation import _current_origin_session_id
+    from gateway.session_context import get_session_env
+    if args.get('full') in (True, 'true', '1', 1):
+        return text
+    sid = get_session_env('HERMES_SESSION_ID', '') or _current_origin_session_id()
+    if not sid:
+        return text  # A process can serve many conversations: unknown identity cannot reuse.
+    scope = (hermes_home_key(), str(kanban_db_path(board=args.get('board')).resolve()), sid)
+    now = time.monotonic() if now is None else now
+    key = (*scope, tid, json.dumps({k:v for k,v in args.items() if k!='task_id'}, sort_keys=True, default=str))
+    digest, fields = _projection(text)
+    with _LOCK:
+        prev = _SEEN.get(key)
+        valid = prev is not None and 0 <= now-prev['at'] < _WINDOW
+        result = text
+        if valid and prev['digest'] == digest:
+            result = json.dumps({'task_id': tid, 'unchanged_since_last_show': True,
+                                 'note': 'Use the prior result in this conversation; full=true returns it again.'})
+        elif valid and prev['bytes'] >= _BUDGET and fields is not None and prev['fields'] is not None:
+            values = json.loads(text)
+            changed = {k: values[k] for k, v in fields.items() if prev['fields'].get(k) != v}
+            result = json.dumps({'task_id': tid, 'context_delta': True, 'changed_fields': changed,
+                                 'unchanged_fields': [k for k, v in fields.items() if prev['fields'].get(k) == v],
+                                 'removed_fields': sorted(set(prev['fields']) - set(fields)),
+                                 'note': 'Unchanged fields remain in the prior result in this conversation; full=true restores all fields.'})
+        # Envelope overhead must never make a short result more expensive.
+        if len(result.encode()) >= len(text.encode()):
+            result = text
+        _SEEN[key] = {'digest': digest, 'fields': fields, 'at': prev['at'] if valid else now,
+                      'bytes': (prev['bytes'] if valid else 0) + len(result.encode())}
+        _SEEN.move_to_end(key)
+        while len(_SEEN) > _LIMIT:
+            _SEEN.popitem(last=False)
+    if result != text:
+        _LOG.info('KANBAN_SHOW_REUSE original_chars=%s returned_chars=%s', len(text), len(result))
+    return result
+
+
+def _projection(text):
+    """Only observation-envelope bookkeeping is volatile; task/lease/evidence fields stay exact."""
+    try:
+        payload = json.loads(text)
+    except (ValueError, TypeError):
+        payload = None
+    if not isinstance(payload, dict):
+        return hashlib.sha256(text.encode()).hexdigest(), None
+    fields = {k: hashlib.sha256(json.dumps(v, sort_keys=True).encode()).hexdigest()
+              for k, v in payload.items() if k not in {'observed_at', 'observation_count'}}
+    return hashlib.sha256(json.dumps(fields, sort_keys=True).encode()).hexdigest(), fields
+
+
+def reset_session(session_id):
+    """Compaction may discard the old tool result: allow the first recovery read."""
+    if not session_id:
+        return
+    from hermes_constants import hermes_home_key
+    home = hermes_home_key()
+    with _LOCK:
+        for key in list(_SEEN):
+            if key[0] == home and key[2] == session_id:
+                del _SEEN[key]
