diff --git a/hermes_cli/bot_settings.py b/hermes_cli/bot_settings.py
new file mode 100644
index 00000000..2ddde889
--- /dev/null
+++ b/hermes_cli/bot_settings.py
@@ -0,0 +1,131 @@
+"""Atomic role/model editor shared by native and standalone bot settings.
+
+Only defaults for future runs change. Existing agents, credentials, quotas and
+counterparts are never mutated; the native model resolver owns route validation.
+"""
+from __future__ import annotations
+
+from pathlib import Path
+
+from hermes_cli.bot_workflow import _editor_config, _profile_name, normalize_workflow, workflow_snapshot
+
+
+def _model_snapshot(config: dict) -> dict:
+    from agent.reasoning_effort import route_supported_efforts
+    from hermes_constants import resolve_reasoning_config
+
+    value = config.get('model') or {}
+    route = value if isinstance(value, dict) else {'default': value}
+    model = str(route.get('default') or route.get('model') or '')
+    provider = str(route.get('provider') or '')
+    reasoning = resolve_reasoning_config(config, model) or {}
+    effort = 'none' if reasoning.get('enabled') is False else reasoning.get('effort', '')
+    return {'model': model, 'provider': provider, 'effort': effort,
+            'supported_efforts': list(route_supported_efforts(provider, model, route.get('api_mode')))}
+
+
+def settings_snapshot(profile_dir: Path) -> dict:
+    from hermes_cli.config import load_config
+    from hermes_cli.config import _CONFIG_LOCK
+    from gateway.run import _profile_runtime_scope
+
+    with _CONFIG_LOCK, _profile_runtime_scope(profile_dir, hydrate_secrets=False):
+        return workflow_snapshot(profile_dir) | {'model': _model_snapshot(load_config())}
+
+
+def _selection(value: dict) -> dict:
+    if not isinstance(value, dict) or set(value) - {'provider', 'model', 'effort'}:
+        raise ValueError('model settings accept only provider, model and effort')
+    if any(not isinstance(value.get(key), str) for key in ('provider', 'model')):
+        raise ValueError('choose a provider and model')
+    cleaned = {key: value[key].strip() for key in ('provider', 'model')}
+    if not all(cleaned.values()) or any(len(v) > 256 or any(ord(c) < 32 for c in v) for v in cleaned.values()):
+        raise ValueError('choose a valid provider and model')
+    effort = value.get('effort', '')
+    if not isinstance(effort, str):
+        raise ValueError('effort must be a supported level')
+    cleaned['effort'] = effort.strip().lower()
+    return cleaned
+
+
+def _resolve_selection(config: dict, selected: dict):
+    from hermes_cli.config import get_compatible_custom_providers
+    from hermes_cli.model_switch import switch_model
+
+    route = config.get('model') if isinstance(config.get('model'), dict) else {}
+    result = switch_model(
+        raw_input=selected['model'], explicit_provider=selected['provider'], is_global=True,
+        current_provider=str(route.get('provider') or ''), current_model=str(route.get('default') or ''),
+        current_base_url=str(route.get('base_url') or ''),
+        user_providers=config.get('providers') or {},
+        custom_providers=get_compatible_custom_providers(config))
+    if not result.success:
+        raise ValueError(result.error_message or 'model selection rejected')
+    return result
+
+
+def _prepare_model(profile_dir: Path, raw: dict, selected: dict, confirm: bool):
+    from agent.reasoning_effort import route_supported_efforts
+    from hermes_cli.config import load_config
+    from hermes_cli.model_selection_guards import combined_selection_warning
+    from hermes_cli.model_switch import apply_model_selection
+    from gateway.run import _profile_runtime_scope
+
+    with _profile_runtime_scope(profile_dir, hydrate_secrets=False):
+        effective = load_config()
+        current = _model_snapshot(effective)
+        route_changed = any(selected[key] != current[key] for key in ('provider', 'model'))
+        result = _resolve_selection(effective, selected) if route_changed else None
+        model = result.new_model if result else current['model']
+        provider = result.target_provider if result else current['provider']
+        api_mode = result.api_mode if result else (effective.get('model') or {}).get('api_mode')
+        effort = selected['effort']
+        if effort and effort not in route_supported_efforts(provider, model, api_mode):
+            raise ValueError('effort is not supported by the selected route')
+        if result and not confirm:
+            warning = combined_selection_warning(model, provider=provider, base_url=result.base_url,
+                                                 api_key=result.api_key, model_info=result.model_info)
+            if warning:
+                return None, warning.message
+        updates = {'selected_model': model, 'effort': effort}
+        if result:
+            updates['route'] = apply_model_selection(raw.get('model'), result)
+        return updates, None
+
+
+def _revision(profile_dir: Path, expected: str) -> dict:
+    config, revision = _editor_config(profile_dir)
+    if revision != expected:
+        raise ValueError('profile configuration changed; reload before saving settings')
+    return config
+
+
+def configure_settings(profile_dir: Path, workflow: dict, expected_revision: str, *,
+                       model: dict | None = None, confirm: bool = False) -> dict:
+    """Validate before the one write, then recheck CAS after off-loop catalog I/O."""
+    from hermes_cli.config import atomic_config_replace
+    from hermes_cli.config import _CONFIG_LOCK
+
+    cleaned = normalize_workflow(workflow, _profile_name(profile_dir))
+    raw = _revision(profile_dir, expected_revision)
+    updates = None
+    if model is not None:
+        updates, warning = _prepare_model(profile_dir, raw, _selection(model), confirm)
+        if warning:
+            _revision(profile_dir, expected_revision)
+            return settings_snapshot(profile_dir) | {'confirm_required': True, 'confirm_message': warning}
+    with _CONFIG_LOCK:
+        config = _revision(profile_dir, expected_revision)
+        if cleaned is None:
+            config.pop('bot_workflow', None)
+        else:
+            config['bot_workflow'] = cleaned
+        if updates:
+            if 'route' in updates:
+                config['model'] = updates['route']
+            if updates['effort']:
+                agent = config.setdefault('agent', {})
+                overrides = agent.setdefault('reasoning_overrides', {})
+                overrides[updates['selected_model']] = updates['effort']
+        atomic_config_replace(profile_dir / 'config.yaml', config)
+        return settings_snapshot(profile_dir)
