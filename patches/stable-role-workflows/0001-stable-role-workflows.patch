+"""Role and model settings commit together without touching sessions or another bot."""
+import json
+from pathlib import Path
+
+import pytest
+
+from hermes_cli.config import atomic_config_write
+from hermes_yaml import safe_load
+
+
+@pytest.fixture
+def homes(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    target = home / 'profiles' / 'developer-action'
+    target.mkdir(parents=True)
+    for path, key in ((home, 'root-fixture-key'), (target, 'bot-fixture-key')):
+        atomic_config_write(path / 'config.yaml', {
+            'model': {'provider': 'acme', 'default': 'acme/old'},
+            'custom_providers': [{'name': 'acme', 'base_url': 'https://acme.invalid/v1',
+                                  'key_env': 'ACME_KEY', 'models': ['acme/old', 'acme/new']}],
+            'fallback_providers': [],
+            'agent': {'reasoning_effort': 'max', 'reasoning_overrides': {'acme/old': 'low'}},
+            'quota_policy': {'daily': 17},
+        })
+        (path / '.env').write_text(f'ACME_KEY={key}\n')
+    return home, target
+
+
+@pytest.fixture
+def catalog(monkeypatch):
+    from hermes_cli import models_validate
+
+    seen = []
+
+    def validate(model, provider, api_key=None, **kwargs):
+        seen.append((model, provider, api_key))
+        return {'accepted': model != 'reject', 'persist': True, 'recognized': True,
+                'message': 'Fixture catalog rejection' if model == 'reject' else ''}
+
+    monkeypatch.setattr(models_validate, 'validate_requested_model', validate)
+    return seen
+
+
+def _selection(model='acme/new', effort='high'):
+    return {'provider': 'acme', 'model': model, 'effort': effort}
+
+
+WORKFLOW = {'role': 'developer', 'mode': 'action', 'family': 'nim', 'counterpart': ''}
+
+
+def test_joint_save_resolves_target_secrets_and_preserves_unrelated_policy(homes, catalog):
+    from hermes_cli.bot_settings import configure_settings, settings_snapshot
+
+    home, target = homes
+    original = (home / 'config.yaml').read_bytes()
+    opened = settings_snapshot(target)
+    assert opened['model']['effort'] == 'low'
+    saved = configure_settings(target, WORKFLOW, opened['revision'], model=_selection())
+    assert saved['workflow'] == WORKFLOW
+    assert saved['model']['model'] == 'acme/new'
+    assert saved['model']['effort'] == 'high'
+    assert catalog[-1][2] == 'bot-fixture-key'
+    assert (home / 'config.yaml').read_bytes() == original
+    raw = safe_load((target / 'config.yaml').read_text())
+    assert raw['quota_policy'] == {'daily': 17}
+    assert raw['fallback_providers'] == []
+    assert raw['agent']['reasoning_effort'] == 'max'
+    assert raw['agent']['reasoning_overrides']['acme/old'] == 'low'
+    assert 'fixture-key' not in json.dumps(saved)
+    assert 'base_url' not in saved['model'] and 'api_key' not in saved['model']
+
+
+@pytest.mark.parametrize('kind', ['stale', 'rejected_model', 'bad_effort', 'unexpected_secret'])
+def test_invalid_joint_edit_has_no_partial_role_or_model_write(homes, catalog, kind):
+    from hermes_cli.bot_settings import configure_settings, settings_snapshot
+
+    _, target = homes
+    opened = settings_snapshot(target)
+    selection = _selection()
+    revision = opened['revision']
+    if kind == 'stale':
+        revision = 'stale'
+    elif kind == 'rejected_model':
+        selection['model'] = 'reject'
+    elif kind == 'bad_effort':
+        selection['effort'] = 'infinite'
+    else:
+        selection['api_key'] = 'must-not-save'
+    before = (target / 'config.yaml').read_bytes()
+    with pytest.raises(ValueError):
+        configure_settings(target, WORKFLOW, revision, model=selection)
+    assert (target / 'config.yaml').read_bytes() == before
+
+
+def test_confirmation_defers_both_settings_and_keeps_revision(homes, catalog, monkeypatch):
+    from types import SimpleNamespace
+    from hermes_cli import model_selection_guards
+    from hermes_cli.bot_settings import configure_settings, settings_snapshot
+
+    _, target = homes
+    monkeypatch.setattr(model_selection_guards, 'combined_selection_warning',
+                        lambda *a, **kw: SimpleNamespace(message='Confirm fixture data policy'))
+    opened = settings_snapshot(target)
+    before = (target / 'config.yaml').read_bytes()
+    deferred = configure_settings(target, WORKFLOW, opened['revision'], model=_selection())
+    assert deferred['confirm_required'] and deferred['revision'] == opened['revision']
+    assert (target / 'config.yaml').read_bytes() == before
+    saved = configure_settings(target, WORKFLOW, opened['revision'], model=_selection(), confirm=True)
+    assert not saved.get('confirm_required', False)
+    assert saved['workflow'] == WORKFLOW
+
+
+def test_effort_only_edit_needs_no_catalog_or_credential_probe(homes, monkeypatch):
+    from hermes_cli import model_switch
+    from hermes_cli.bot_settings import configure_settings, settings_snapshot
+
+    _, target = homes
+
+    def forbidden(*a, **kw):
+        raise AssertionError('unchanged route must not probe provider')
+
+    monkeypatch.setattr(model_switch, 'switch_model', forbidden)
+    opened = settings_snapshot(target)
+    saved = configure_settings(target, {}, opened['revision'], model=_selection('acme/old'))
+    assert saved['model']['effort'] == 'high'
+    assert saved['workflow'] is None
+
+
+def test_edit_during_validation_is_rejected_without_overwriting(homes, catalog, monkeypatch):
+    from hermes_cli import model_selection_guards
+    from hermes_cli.bot_settings import configure_settings, settings_snapshot
+
+    _, target = homes
+    opened = settings_snapshot(target)
+
+    def concurrent_edit(*args, **kwargs):
+        raw = safe_load((target / 'config.yaml').read_text())
+        atomic_config_write(target / 'config.yaml', raw | {'concurrent_owner': 'keep'})
+
+    monkeypatch.setattr(model_selection_guards, 'combined_selection_warning', concurrent_edit)
+    with pytest.raises(ValueError, match='changed'):
+        configure_settings(target, WORKFLOW, opened['revision'], model=_selection())
+    raw = safe_load((target / 'config.yaml').read_text())
+    assert raw['concurrent_owner'] == 'keep'
+    assert raw['model']['default'] == 'acme/old' and 'bot_workflow' not in raw
