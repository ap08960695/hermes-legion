+from hermes_state import SessionDB
+
+
+@pytest.fixture
+def fleet(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    (home / 'config.yaml').write_text('model:\n  default: existing-model\n')
+    for name in ('developer-think', 'developer-action'):
+        path = home / 'profiles' / name
+        path.mkdir(parents=True)
+        (path / 'config.yaml').write_text('model:\n  default: existing-model\n')
+    return home
+
+
+def _call(home, method, params, *, host=True, capabilities=None):
+    with SessionDB(home / 'state.db') as db:
+        authority = SimpleNamespace(profile_id=str(home), instance_id='owner', db=db, events={}, sessions={})
+        identity = {'user_id': 'owner', 'profile_scope': 'host' if host else 'profile'}
+        if capabilities is not None:
+            identity['capabilities'] = capabilities
+        connection = AuthorityConnection(authority, object(), identity)
+        return asyncio.run(connection.dispatch({'id': 'workflow', 'method': method, 'params': params}))
+
+
+def test_canonical_gateway_edits_workflow_without_model_calls(fleet):
+    read = _call(fleet, 'profiles.workflow.get', {'name': 'developer-think'})
+    assert 'result' in read, read
+    result = _call(fleet, 'profiles.workflow.configure', {
+        'name': 'developer-think', 'expected_revision': read['result']['revision'],
+        'workflow': {'role': 'developer', 'mode': 'think', 'family': 'gpt', 'counterpart': 'developer-action'},
+    })
+    assert 'result' in result, result
+    assert result['result']['workflow']['mode'] == 'think'
+    assert result['result']['pair_status'] == 'one_way'
+    assert 'existing-model' in (fleet / 'profiles/developer-think/config.yaml').read_text()
+
+
+def test_profile_bound_ticket_cannot_modify_another_bot(fleet):
+    before = (fleet / 'profiles/developer-think/config.yaml').read_bytes()
+    result = _call(fleet, 'profiles.workflow.get', {'name': 'developer-think'}, host=False)
+    assert result['error']['message'] == 'profile_mismatch'
+    assert (fleet / 'profiles/developer-think/config.yaml').read_bytes() == before
+
+
+def test_read_only_ticket_cannot_change_workflow(fleet):
+    read = _call(fleet, 'profiles.workflow.get', {'name': 'default'}, capabilities=['session:read'])
+    assert 'result' in read, read
+    result = _call(fleet, 'profiles.workflow.configure', {
+        'name': 'default', 'workflow': None, 'expected_revision': read['result']['revision'],
+    }, capabilities=['session:read'])
+    assert result['error']['message'] == 'permission_denied'
+
+
+def test_workflow_on_a_real_native_gateway_socket(tmp_path):
+    import json
+    import sys
+
+    from tests.gateway.fixtures.local_recovery_probe import child_env, daemon, rpc, websocket
+
+    root = Path(__file__).resolve().parents[2]
+    home, user = tmp_path / 'state', tmp_path / 'user'
+    home.mkdir(mode=0o700)
+    user.mkdir()
+    (home / 'config.yaml').write_text(json.dumps({
+        'gateway': {'multiplex_profiles': False},
+        'model': {'provider': 'custom', 'default': 'no-inference', 'base_url': 'http://127.0.0.1:1/v1'},
+        'auxiliary': {'title_generation': {'enabled': False}},
+    }))
+    env = child_env() | dict(HOME=str(user), USERPROFILE=str(user), HERMES_HOME=str(home),
+                             PYTHONPATH=str(root), HERMES_PYTHON=sys.executable,
+                             HERMES_DISABLE_LAZY_INSTALLS='1', PYTHONUNBUFFERED='1')
+
+    async def probe(desc):
+        async with websocket(home, desc) as ws:
+            read = await rpc(ws, 'profiles.workflow.get', name='default')
+            assert 'result' in read, read
+            saved = await rpc(ws, 'profiles.workflow.configure', name='default',
+                              expected_revision=read['result']['revision'],
+                              workflow={'role': 'developer', 'mode': 'think', 'family': 'nim', 'counterpart': ''})
+            assert 'result' in saved, saved
+            assert saved['result']['workflow']['family'] == 'nim'
+            again = await rpc(ws, 'profiles.workflow.get', name='default')
+            assert again['result'] == saved['result']
+            model = again['result']['model']
+            assert model['model'] == 'no-inference'
+            edited = await rpc(ws, 'profiles.workflow.configure', name='default',
+                               expected_revision=again['result']['revision'], workflow=again['result']['workflow'],
+                               model={'provider': model['provider'], 'model': model['model'], 'effort': 'high'})
+            assert 'result' in edited, edited
+            assert edited['result']['model']['effort'] == 'high'
+            assert edited['result']['revision'] != again['result']['revision']
+            stale = await rpc(ws, 'profiles.workflow.configure', name='default',
+                              expected_revision=again['result']['revision'], workflow=None,
+                              model={'provider': model['provider'], 'model': model['model'], 'effort': 'low'})
+            assert 'error' in stale, stale
+            final = await rpc(ws, 'profiles.workflow.get', name='default')
+            assert final['result'] == edited['result']
+            refused = await rpc(ws, 'profiles.workflow.get', name='default', secret='must-not-be-accepted')
+            assert refused['error']['message'] == 'invalid_params'
+
+    with daemon(root, home, env, barrier=False) as (_process, desc):
+        asyncio.run(probe(desc))
+
+
+def test_native_model_change_uses_catalog_only_and_saves_with_role(tmp_path):
+    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+    import json
+    import sys
+    from threading import Thread
+
+    from tests.gateway.fixtures.local_recovery_probe import child_env, daemon, rpc, websocket
+
+    requests = []
+
+    class Catalog(BaseHTTPRequestHandler):
+        def log_message(self, *_args):
+            pass
+
+        def do_GET(self):
+            requests.append(('GET', self.path))
+            body = json.dumps({'data': [{'id': 'fixture-old'}, {'id': 'fixture-new'}]}).encode()
+            self.send_response(200)
+            self.send_header('Content-Type', 'application/json')
+            self.send_header('Content-Length', str(len(body)))
+            self.end_headers()
+            self.wfile.write(body)
+
+        def do_POST(self):
+            body = json.loads(self.rfile.read(int(self.headers.get('Content-Length', 0))) or '{}')
+            kind = 'INFERENCE' if body.get('messages') or body.get('input') else 'POST'
+            requests.append((kind, self.path))
+            self.send_error(405)
+
+    root = Path(__file__).resolve().parents[2]
+    home, user = tmp_path / 'state', tmp_path / 'user'
+    home.mkdir(mode=0o700)
+    user.mkdir()
+    peer = ThreadingHTTPServer(('127.0.0.1', 0), Catalog)
+    thread = Thread(target=peer.serve_forever, daemon=True)
+    thread.start()
+    try:
+        (home / 'config.yaml').write_text(json.dumps({
+            'gateway': {'multiplex_profiles': False},
+            'model': {'provider': 'custom', 'default': 'fixture-old',
+                      'base_url': f'http://127.0.0.1:{peer.server_port}/v1', 'api_key': 'loopback-fixture'},
+            'fallback_providers': [], 'auxiliary': {'title_generation': {'enabled': False}},
+        }))
+        env = child_env() | dict(HOME=str(user), USERPROFILE=str(user), HERMES_HOME=str(home),
+                                 PYTHONPATH=str(root), HERMES_PYTHON=sys.executable,
+                                 HERMES_DISABLE_LAZY_INSTALLS='1', PYTHONUNBUFFERED='1')
+
+        async def probe(desc):
+            async with websocket(home, desc) as ws:
+                opened = await rpc(ws, 'profiles.workflow.get', name='default')
+                saved = await rpc(ws, 'profiles.workflow.configure', name='default',
+                                  expected_revision=opened['result']['revision'],
+                                  workflow={'role': 'developer', 'mode': 'action', 'family': 'nim', 'counterpart': ''},
+                                  model={'provider': 'custom', 'model': 'fixture-new', 'effort': 'high'})
+                assert 'result' in saved, saved
+                assert saved['result']['model']['model'] == 'fixture-new'
+                assert saved['result']['model']['effort'] == 'high'
+                assert saved['result']['workflow']['mode'] == 'action'
+                assert 'loopback-fixture' not in json.dumps(saved)
+                assert (await rpc(ws, 'profiles.workflow.get', name='default'))['result'] == saved['result']
+
+        with daemon(root, home, env, barrier=False) as (_process, desc):
+            asyncio.run(probe(desc))
+        assert requests and all(method == 'GET' or (method, path) == ('POST', '/api/show')
+                                for method, path in requests), requests
+    finally:
+        peer.shutdown()
+        peer.server_close()
+        thread.join(timeout=5)
