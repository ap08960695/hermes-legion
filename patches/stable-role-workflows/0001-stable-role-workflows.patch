diff --git a/hermes_cli/kanban_dispatch_evidence.py b/hermes_cli/kanban_dispatch_evidence.py
new file mode 100644
index 00000000..74bb3246
--- /dev/null
+++ b/hermes_cli/kanban_dispatch_evidence.py
@@ -0,0 +1,67 @@
+"""Bounded local dispatch measurements. No model calls, state transitions or extra ticks."""
+from collections import OrderedDict
+from contextlib import suppress
+import hashlib
+import json
+import logging
+import threading
+import time
+
+_LOG = logging.getLogger(__name__)
+_LAST = OrderedDict()
+_LOCK = threading.Lock()
+_LIMIT = 128
+
+
+def mark(result, task_id, stage, *, run_id=None):
+    rows = getattr(result, '_admission_evidence', None)
+    if rows is None:
+        rows = result._admission_evidence = {}
+    if task_id not in rows and len(rows) >= _LIMIT:
+        result._admission_evidence_truncated = True
+        return
+    row = rows.setdefault(task_id, {})
+    row[stage] = time.time()
+    if run_id is not None:
+        row['run_id'] = run_id
+
+
+def capacity(result, reason, slots=None):
+    result._capacity_evidence = {'reason': reason, 'available_slots': slots}
+
+
+def snapshot(result):
+    reasons = {name: len(getattr(result, name, [])) for name in (
+        'spawned','skipped_per_profile_capped','skipped_unassigned','skipped_nonspawnable',
+        'respawn_guarded','auto_blocked')}
+    rows = getattr(result, '_admission_evidence', {})
+    return {'version': 1, 'at': time.time(), 'process_id': __import__('os').getpid(),
+            'capacity': getattr(result, '_capacity_evidence', {'reason': 'not_observed'}),
+            'counts': reasons, 'tasks': rows,
+            'truncated': bool(getattr(result, '_admission_evidence_truncated', False)),
+            'review_slot_reused': getattr(result, '_review_slot_reused', 0),
+            'passed_dispatch_gates_not_claimed': sum('passed_dispatch_gates_at' in r and 'claimed_at' not in r for r in rows.values()),
+            'eligibility_limit': 'Dispatch guards observed at this tick; atomic claim rechecks dependencies and ownership. No continuous eligibility or unused-capacity duration inferred.'}
+
+
+def emit(conn, result, *, dry_run=False):
+    """After the dispatch lock; failures cannot retry a tick or interfere with work."""
+    if dry_run or not _LOG.isEnabledFor(logging.INFO):
+        return
+    with suppress(Exception):
+        row = snapshot(result)
+        db = conn.execute('PRAGMA database_list').fetchone()[2]
+        board = hashlib.sha256(db.encode()).hexdigest()[:16]
+        row['board'] = board
+        # Idle/unchanged summaries at most once per five minutes, bounded per process.
+        signature = json.dumps([row['capacity'], row['counts'], sorted(row['tasks'])], sort_keys=True)
+        now = time.monotonic()
+        with _LOCK:
+            previous = _LAST.get(board)
+            if not row['counts']['spawned'] and previous and previous[0] == signature and now-previous[1] < 300:
+                return
+            _LAST[board] = (signature, now)
+            _LAST.move_to_end(board)
+            while len(_LAST) > _LIMIT:
+                _LAST.popitem(last=False)
+        _LOG.info('DISPATCH_EVIDENCE %s', json.dumps(row, separators=(',', ':')))
diff --git a/hermes_cli/kanban_dispatch_lane.py b/hermes_cli/kanban_dispatch_lane.py
new file mode 100644
index 00000000..b030c6a2
--- /dev/null
+++ b/hermes_cli/kanban_dispatch_lane.py
@@ -0,0 +1,330 @@
+"""Native lane helpers; preserve fairness, caps and the existing spawn contract."""
+from __future__ import annotations
+
+import sqlite3
+from contextlib import closing
+from typing import Optional
+
+
+def stop_if_paused(result) -> bool:
+    """Stop before admitting new work; an existing claim is left alone."""
+    from agent.estop import check_paused
+    from hermes_cli import kanban_db
+
+    if check_paused('kanban', kanban_db._log):
+        result.skipped_paused = True
+        return True
+    return False
+
+
+def configured_daemon_caps():
+    """Read the optional board and profile caps without changing config."""
+    from hermes_cli import kanban_db_dispatch as dispatch
+    from hermes_cli.config import load_config_readonly
+
+    config = load_config_readonly().get('kanban') or {}
+    return (dispatch._positive_int(config.get('max_spawn'), None, minimum=0),
+            dispatch._positive_int(config.get('max_in_progress_per_profile'), None))
+
+
+class CapacityUnavailable(Exception):
+    """A configured host or profile cap cannot be verified across boards."""
+
+
+def other_board_running_counts(board, *, strict=False):
+    """Count other active board rows once per resolved database path."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.sqlite_safe_read import connect_tracked
+
+    try:
+        current = str(kb.kanban_db_path(board=board).expanduser().resolve())
+        boards = kb.list_boards(include_archived=False)
+    except Exception as exc:
+        if strict:
+            raise CapacityUnavailable('board enumeration unavailable') from exc
+        return 0, {}
+    seen = {current}
+    total = 0
+    counts: dict[str, int] = {}
+    for meta in boards:
+        slug = meta.get('slug') or kb.DEFAULT_BOARD
+        try:
+            path = kb.kanban_db_path(board=slug).expanduser()
+            resolved = str(path.resolve())
+            if resolved in seen:
+                continue
+            if not path.exists():
+                if strict:
+                    raise CapacityUnavailable('board database unavailable')
+                continue
+            seen.add(resolved)
+            uri = path.resolve().as_uri() + '?mode=ro'
+            with closing(connect_tracked(uri, tracking_path=path, uri=True, timeout=1.0)) as conn:
+                conn.row_factory = sqlite3.Row
+                rows = conn.execute("SELECT assignee, COUNT(*) AS n FROM tasks WHERE status='running' GROUP BY assignee")
+                for row in rows:
+                    n = int(row['n'])
+                    total += n
+                    if row['assignee']:
+                        counts[row['assignee']] = counts.get(row['assignee'], 0) + n
+        except Exception as exc:
+            if strict:
+                raise CapacityUnavailable('board capacity unavailable') from exc
+            continue
+    return total, counts
+
+
+def claim_with_capacity(conn, task_id, assignee, result, *, lane, ttl_seconds, board,
+                        host_cap, per_profile_cap):
+    """Reserve a real claim while shared board capacity is serialized."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    from hermes_cli.kanban_dispatch_evidence import capacity
+
+    claim = kb.claim_review_task if lane == 'review' else kb.claim_task
+    if host_cap is None and per_profile_cap is None:
+        return None if stop_if_paused(result) else claim(conn, task_id, ttl_seconds=ttl_seconds)
+    with kbc._dispatch_admission_lock(kb.kanban_home()) as lock_state:
+        if lock_state != 'held':
+            result.skipped_capacity_locked = True
+            result.capacity_lock_reason = lock_state
+            return None
+        if stop_if_paused(result):
+            return None
+        try:
+            other_total, other_profiles = other_board_running_counts(board, strict=True)
+        except CapacityUnavailable:
+            result.skipped_capacity_unknown = True
+            capacity(result, 'board_capacity_unknown')
+            return None
+        if host_cap is not None:
+            local_total = conn.execute("SELECT COUNT(*) FROM tasks WHERE status='running'").fetchone()[0]
+            if local_total + other_total >= host_cap:
+                capacity(result, 'host_cap', 0)
+                result._host_capacity_exhausted = True
+                return None
+        if per_profile_cap is not None:
+            local = conn.execute("SELECT COUNT(*) FROM tasks WHERE status='running' AND assignee=?", (assignee,)).fetchone()[0]
+            current = local + other_profiles.get(assignee, 0)
+            if current >= per_profile_cap:
+                result.skipped_per_profile_capped.append((task_id, assignee, current))
+                return None
+        return claim(conn, task_id, ttl_seconds=ttl_seconds)
+
+
+def call_spawn(spawn_fn, task, workspace: str, board: str | None) -> int | None:
+    """Back-compat: older spawn_fn signatures (and test stubs) accept only
+    ``(task, workspace)``; pass ``board`` only when the callable supports it."""
+    import inspect
+    try:
+        sig = inspect.signature(spawn_fn)
+    except (TypeError, ValueError):
+        sig = None
+    # Catch signature inspection errors only. A callback may already have spawned
+    # before raising: no exception from its body can authorize a second launch.
+    if sig is not None and "board" in sig.parameters:
+        return spawn_fn(task, workspace, board=board)
+    return spawn_fn(task, workspace)
+
+
+def dispatch_ready_row(conn, row, result, default_assignee, lane_kwargs):
+    if stop_if_paused(result):
+        return False
+    assignee = row['assignee']
+    if not assignee:
+        if not default_assignee or not apply_default_assignee(
+                conn, row['id'], default_assignee, dry_run=lane_kwargs['dry_run']):
+            result.skipped_unassigned.append(row['id'])
+            return False
+        assignee = default_assignee
+        result.auto_assigned_default.append(row['id'])
+    return dispatch_lane_task(conn, row, assignee, result, lane='ready', **lane_kwargs)
+
+
+def apply_default_assignee(
+    conn, task_id: str, assignee: str, *, dry_run: bool,
+) -> bool:
+    """Persist ``kanban.default_assignee`` on an unassigned ready row.
+
+    Mutating the row keeps board state honest: the task is legitimately owned
+    by the default, not "unassigned but secretly routed". ``dry_run`` reports
+    without writing. Returns False when the write failed.
+    """
+    from hermes_cli import kanban_db as _kb
+    logger = _kb._log
+
+    if dry_run:
+        return True
+    try:
+        with _kb.write_txn(conn):
+            conn.execute(
+                "UPDATE tasks SET assignee = ? WHERE id = ? "
+                "AND (assignee IS NULL OR assignee = '')",
+                (assignee, task_id),
+            )
+            _kb._append_event(
+                conn, task_id, "assigned",
+                {"assignee": assignee, "source": "kanban.default_assignee"},
+            )
+    except Exception:
+        logger.debug(
+            "kanban dispatch: failed to apply default_assignee=%r to task %s",
+            assignee, task_id, exc_info=True,
+        )
+        return False
+    return True
+
+
+
+
+def _lane_guard_rejects(conn, row, assignee, result, *, lane, dry_run, per_profile_cap, per_profile_running):
+    """Record pre-claim guard failures without changing their existing semantics."""
+    from hermes_cli import kanban_db_dispatch as dispatch
+    _kb = dispatch._kb
+    _profile_exists_fn = dispatch._profile_exists_fn
+    check_respawn_guard = dispatch.check_respawn_guard
+    task_id = row["id"]
+    # Non-profile assignees (control-plane lanes that pull via ``claim_task``)
+    # would fail ``hermes -p <assignee>`` at startup and loop ready→crash→ready
+    # forever. Bucketed apart from skipped_unassigned: the operator cannot fix
+    # it by assigning a profile, and health telemetry suppresses "stuck" for it.
+    profile_exists = _profile_exists_fn()
+    if profile_exists is not None and not profile_exists(assignee):
+        result.skipped_nonspawnable.append(task_id)
+        # Per-task diagnostic so ``show``/``tail`` name the missing profile instead of leaving
+        # the card in ``ready`` with zero board evidence (#122422). Unlike a respawn guard the
+        # condition never expires on its own, so write it once: a repeat only when something
+        # else happened on the card since (reassign, comment) — not one row per tick forever,
+        # and not one row per foreign home per tick on a shared board (#101015).
+        if not dry_run:
+            with _kb.write_txn(conn):
+                last = conn.execute(
+                    "SELECT kind, payload FROM task_events WHERE task_id = ? "
+                    "ORDER BY created_at DESC, id DESC LIMIT 1", (task_id,)).fetchone()
+                if (last is None or last["kind"] != "skipped_nonspawnable"
+                        or last["payload"] != _kb._json_or_null({"assignee": assignee})):
+                    _kb._append_event(conn, task_id, "skipped_nonspawnable", {"assignee": assignee})
+        return True
+    # Per-profile cap: one profile's local model / API quota / browser pool
+    # must not be overwhelmed by a fan-out even with global headroom.
+    if per_profile_cap is not None:
+        current = per_profile_running.get(assignee, 0)
+        if current >= per_profile_cap:
+            result.skipped_per_profile_capped.append((task_id, assignee, current))
+            return True
+    from hermes_cli.kanban_task_contract import guard_dispatch
+    if lane == 'ready' and guard_dispatch(conn, row, assignee, result, dry_run=dry_run):
+        return True
+    guard_reason = check_respawn_guard(conn, task_id, lane=lane)
+    if guard_reason is not None:
+        result.respawn_guarded.append((task_id, guard_reason))
+        # Event so ``hermes kanban tail`` shows why the task looks stuck.
+        if not dry_run:
+            with _kb.write_txn(conn):
+                _kb._append_event(conn, task_id, "respawn_guarded", {"reason": guard_reason})
+        return True
+
+    return False
+
+
+def dispatch_lane_task(
+    conn: sqlite3.Connection,
+    row: sqlite3.Row,
+    assignee: str,
+    result,
+    *,
+    lane: str,
+    dry_run: bool,
+    ttl_seconds: Optional[int],
+    board: Optional[str],
+    failure_limit: int,
+    spawn_fn,
+    per_profile_cap: Optional[int],
+    per_profile_running: dict[str, int],
+    host_cap: Optional[int],
+) -> bool:
+    """Guard, claim, resolve the workspace and spawn one ready/review row.
+    Returns True when a spawn slot was consumed (real or ``dry_run``); every
+    skip is recorded on ``result``.
+    """
+    from hermes_cli import kanban_db_dispatch as dispatch
+    _kb, _kbw = dispatch._kb, dispatch._kbw
+    _record_task_failure, _default_spawn = dispatch._record_task_failure, dispatch._default_spawn
+    _set_worker_pid = dispatch._set_worker_pid
+    if stop_if_paused(result):
+        return False
+    task_id = row["id"]
+    from hermes_cli.kanban_dispatch_evidence import mark
+    mark(result, task_id, "considered_at")
+    if _lane_guard_rejects(conn, row, assignee, result, lane=lane, dry_run=dry_run,
+                           per_profile_cap=per_profile_cap, per_profile_running=per_profile_running):
+        return False
+
+    def _count_spawn(name: str) -> None:
+        # Later rows in this tick respect the per-profile cap; subsequent
+        # ticks re-query from the DB.
+        if per_profile_cap is not None and name:
+            per_profile_running[name] = per_profile_running.get(name, 0) + 1
+
+    if dry_run:
+        result.spawned.append((task_id, assignee, ""))
+        _count_spawn(assignee)
+        return True
+    mark(result, task_id, "passed_dispatch_gates_at")
+    claimed = claim_with_capacity(conn, task_id, assignee, result, lane=lane, ttl_seconds=ttl_seconds,
+                                  board=board, host_cap=host_cap, per_profile_cap=per_profile_cap)
+    if claimed is None:
+        return False
+    mark(result, task_id, "claimed_at", run_id=_kb._current_run_id(conn, task_id))
+    try:
+        resolved_branch_name = None
+        if claimed.workspace_kind == "worktree":
+            workspace, resolved_branch_name = _kbw._resolve_worktree_workspace(claimed, board=board)
+        else:
+            workspace = _kbw.resolve_workspace(claimed, board=board)
+    except Exception as exc:
+        if _record_task_failure(
+            conn, claimed.id, f"workspace: {exc}",
+            outcome="spawn_failed", failure_limit=failure_limit, release_claim=True, end_run=True,
+            event_payload_extra={"diagnostic": {"phase": "workspace", "error_type": type(exc).__name__}},
+        ):
+            result.auto_blocked.append(claimed.id)
+        return False
+    _kbw.set_workspace_path(conn, claimed.id, str(workspace))
+    if claimed.workspace_kind == "worktree":
+        _kbw.set_branch_name(conn, claimed.id, resolved_branch_name or (claimed.branch_name or "").strip() or f"wt/{claimed.id}")
+    _kbw._maybe_emit_scratch_tip(conn, claimed.id, claimed.workspace_kind)
+    if lane == "review":
+        # Force-load sdlc-review; the kanban lifecycle is already in every
+        # worker's system prompt via KANBAN_GUIDANCE.
+        claimed.skills = list(dict.fromkeys([*(claimed.skills or []), "sdlc-review"]))
+    try:
+        pid = call_spawn(spawn_fn if spawn_fn is not None else _default_spawn, claimed, str(workspace), board)
+        if pid:
+            _set_worker_pid(conn, claimed.id, int(pid), run_id=claimed.current_run_id, claim_lock=claimed.claim_lock)
+        # Fires AFTER the PID (when reported) is durably persisted. Best-effort.
+        _kb._fire_worker_spawned_hook(conn, claimed, str(workspace), pid, board=board)
+        # consecutive_failures is deliberately NOT reset here: resetting on
+        # spawn would let a task that keeps timing out loop forever. Cleared
+        # only on successful completion (complete_task).
+        mark(result, task_id, "spawn_returned_at")
+        result.spawned.append((claimed.id, claimed.assignee or "", str(workspace)))
+        _count_spawn(claimed.assignee)
+        return True
+    except Exception as exc:
+        from tools.process_registry import RestartSafeScopeUnavailable
+        result._spawn_attempt_failed = True
+
+        # The host refused the spawn (no restart-safe scope): nothing about the
+        # card ran, so it must not spend the card's retry budget (#114720).
+        infrastructure = isinstance(exc, RestartSafeScopeUnavailable)
+        if infrastructure:
+            _kb._log.warning("kanban dispatcher: spawn of %s deferred, host cannot place the worker: %s", claimed.id, exc)
+        if _record_task_failure(
+            conn, claimed.id, str(exc),
+            outcome="spawn_failed", failure_limit=failure_limit, release_claim=True, end_run=True,
+            infrastructure=infrastructure, event_payload_extra={"diagnostic": {"phase": "spawn", "error_type": type(exc).__name__}},
+        ):
+            result.auto_blocked.append(claimed.id)
+        return False
+
diff --git a/hermes_cli/kanban_dispatch_wake.py b/hermes_cli/kanban_dispatch_wake.py
new file mode 100644
index 00000000..f9691063
--- /dev/null
+++ b/hermes_cli/kanban_dispatch_wake.py
@@ -0,0 +1,155 @@
+"""Coalesced local hints to the existing dispatcher, never an admission authority.
+
+A hint is emitted only after the outer native transaction commits. A lost hint
+is harmless: the normal periodic dispatcher still reads durable board state.
+"""
+from __future__ import annotations
+
+import asyncio
+import contextlib
+from contextvars import ContextVar
+from dataclasses import dataclass
+import logging
+import os
+from pathlib import Path
+import socket
+import stat
+import time
+
+log = logging.getLogger(__name__)
+_WAKE_KINDS = frozenset({
+    'created', 'promoted', 'completed', 'blocked', 'unblocked', 'assigned',
+    'review_requested', 'changes_requested', 'archived', 'unlinked',
+})
+
+
+@dataclass
+class _Frame:
+    conn: object
+    dirty: bool = False
+
+
+_FRAMES: ContextVar[tuple[_Frame, ...]] = ContextVar('kanban_dispatch_transactions', default=())
+
+
+def mark_event(conn, kind, payload):
+    if kind not in _WAKE_KINDS:
+        return
+    if kind == 'created' and (payload or {}).get('status') not in ('ready', 'review'):
+        return
+    for frame in reversed(_FRAMES.get()):
+        if frame.conn is conn:
+            frame.dirty = True
+            break
+
+
+@contextlib.contextmanager
+def transaction_events(conn):
+    parents = _FRAMES.get()
+    frame = _Frame(conn)
+    token = _FRAMES.set((*parents, frame))
+    try:
+        yield
+        if frame.dirty:
+            parent = next((f for f in reversed(parents) if f.conn is conn), None)
+            if parent is not None:
+                parent.dirty = True
+            elif not conn.in_transaction:
+                notify_dispatcher()
+    finally:
+        _FRAMES.reset(token)
+
+
+def wake_path(home: Path) -> Path:
+    return home / 'kanban' / '.dispatcher.wake.sock'
+
+
+def notify_dispatcher():
+    """One nonblocking, content-free datagram; no retry, network or model call."""
+    if not hasattr(socket, 'AF_UNIX'):
+        return
+    from hermes_cli.kanban_db import kanban_home
+    try:
+        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
+            sock.setblocking(False)
+            sock.sendto(b'1', str(wake_path(kanban_home())))
+    except OSError:
+        # No listener / full queue / unsupported path: periodic fallback owns recovery.
+        return
+
+
+class DispatchWakeReceiver:
+    """Single-lock-owner listener. Burst hints collapse to one extra ordinary tick."""
+    def __init__(self, home, *, enabled=True):
+        self.path = wake_path(Path(home))
+        self.enabled = enabled
+        self.sock = None
+        self.event = asyncio.Event()
+        self.last_tick = time.monotonic()
+        self.identity = None
+
+    def __enter__(self):
+        if not self.enabled or not hasattr(socket, 'AF_UNIX'):
+            return self
+        try:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            if self.path.exists():
+                st = self.path.lstat()
+                if not stat.S_ISSOCK(st.st_mode) or st.st_uid != os.getuid():
+                    raise OSError('dispatcher wake path is not an owned socket')
+                self.path.unlink()  # caller already owns the native singleton lock
+            self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
+            self.sock.setblocking(False)
+            self.sock.bind(str(self.path))
+            os.chmod(self.path, 0o600)
+            self.identity = self.path.stat().st_ino
+            asyncio.get_running_loop().add_reader(self.sock.fileno(), self._receive)
+        except (OSError, NotImplementedError) as exc:
+            log.warning('kanban event wake unavailable; keeping periodic dispatch: %s', type(exc).__name__)
+            self.close()
+        return self
+
+    def _receive(self):
+        for _ in range(256):  # bounded drain; the loop invokes us again if necessary
+            try:
+                self.sock.recv(1)
+            except BlockingIOError:
+                break
+            self.event.set()
+
+    async def wait(self, interval, running):
+        deadline = time.monotonic() + interval
+        # At most one tick per second during event storms. No model is involved.
+        earliest = self.last_tick + min(1.0, interval)
+        while running():
+            now = time.monotonic()
+            if now >= deadline or (now >= earliest and self.event.is_set()):
+                reason = 'event' if self.event.is_set() else 'periodic'
+                self.event.clear()
+                self.last_tick = now
+                return reason
+            delay = min(1.0, max(0.001, deadline - now))
+            if now < earliest:
+                await asyncio.sleep(min(delay, earliest - now))
+            else:
+                try:
+                    await asyncio.wait_for(self.event.wait(), delay)
+                except asyncio.TimeoutError:
+                    continue
+        return 'stopped'
+
+    def close(self):
+        if self.sock is not None:
+            asyncio.get_running_loop().remove_reader(self.sock.fileno())
+            self.sock.close()
+            self.sock = None
+        if self.identity is not None:
+            try:
+                if self.path.lstat().st_ino == self.identity:
+                    self.path.unlink()
+            except FileNotFoundError:
+                pass
+            self.identity = None
+
+    def __exit__(self, *exc):
+        self.close()
diff --git a/hermes_cli/kanban_event_origin.py b/hermes_cli/kanban_event_origin.py
new file mode 100644
index 00000000..2e756431
--- /dev/null
+++ b/hermes_cli/kanban_event_origin.py
@@ -0,0 +1,52 @@
+"""Request-local attribution for avoiding a card transition's echo to its caller.
+
+Events remain in the audit log. Missing attribution is always delivered; a worker
+must never inherit the interactive caller's attribution from its environment.
+"""
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+_ORIGIN = ContextVar('kanban_event_origin', default=None)
+_KEY = '_notification_origin'
+
+
+@contextmanager
+def event_origin(task_id, target):
+    token = _ORIGIN.set((task_id, target) if task_id and target else None)
+    try:
+        yield
+    finally:
+        _ORIGIN.reset(token)
+
+
+def attributed_payload(task_id, payload):
+    origin = _ORIGIN.get()
+    if origin is None or origin[0] != task_id:
+        return payload
+    return {**(payload or {}), _KEY: origin[1]}
+
+
+def is_self_event(event, subscription):
+    origin = event.payload.get(_KEY) if isinstance(event.payload, dict) else None
+    if not isinstance(origin, dict):
+        return False
+    # A legacy subscription with no profile is ambiguous: preserve delivery.
+    for key in ('platform', 'chat_id', 'notifier_profile'):
+        if not origin.get(key) or origin[key] != subscription.get(key):
+            return False
+    if (origin.get('thread_id') or '') != (subscription.get('thread_id') or ''):
+        return False
+    return True
+
+
+def append_event(conn, task_id, kind, payload=None, *, run_id=None):
+    """Insert into the caller's existing transaction with request-local provenance."""
+    from hermes_cli import kanban_db as kb
+    conn.execute(
+        "INSERT INTO task_events (task_id, run_id, kind, payload, created_at) "
+        "VALUES (?, ?, ?, ?, ?)",
+        (task_id, run_id, kind, kb._json_or_null(attributed_payload(task_id, payload)),
+         int(kb.time.time())),
+    )
+    from hermes_cli.kanban_dispatch_wake import mark_event
+    mark_event(conn, kind, payload)
diff --git a/hermes_cli/kanban_evidence_context.py b/hermes_cli/kanban_evidence_context.py
new file mode 100644
index 00000000..0afa049e
--- /dev/null
+++ b/hermes_cli/kanban_evidence_context.py
@@ -0,0 +1,163 @@
+"""Scoped decision references and verification reuse in the existing worker brief.
+
+Comments are reference records, not an authority channel. A matching receipt
+never waives gates or proves that the referenced human approved its interpretation.
+"""
+from __future__ import annotations
+
+from contextlib import closing
+import hashlib
+import json
+from pathlib import Path
+import re
+import sqlite3
+import time
+
+from hermes_cli.kanban_task_contract import _MAX_BYTES, _verify_files, check_verification, task_contract
+
+_DECISION = 'OWNER-DECISION v1\n'
+
+
+def _source_matches(source, task):
+    """Read only the exact cited user message in the owning task's session."""
+    from hermes_constants import get_default_hermes_root
+    if not isinstance(source, dict) or source.get('session_id') != task.session_id or not task.session_id:
+        return False
+    profile = source.get('profile', '')
+    if not isinstance(profile, str) or not re.fullmatch(r'[a-zA-Z0-9_-]{1,64}', profile):
+        return False
+    root = get_default_hermes_root()
+    home = root if profile == 'default' else root / 'profiles' / profile
+    path = home / 'state.db'
+    try:
+        with closing(sqlite3.connect(path.resolve().as_uri() + '?mode=ro', uri=True, timeout=1)) as db:
+            row = db.execute(
+                'SELECT role, content, display_kind, _compressed_summary FROM messages '
+                'WHERE id = ? AND session_id = ?',
+                (source.get('message_id'), task.session_id),
+            ).fetchone()
+        if not row or row[0] != 'user' or row[2] or row[3] or not isinstance(row[1], str):
+            return False
+        return hashlib.sha256(row[1].encode()).hexdigest() == source.get('sha256')
+    except (OSError, sqlite3.Error, TypeError):
+        return False
+
+
+def decision_references(conn, task, contract, *, now=None):
+    """Latest record for each action wins, including revocation/expiry."""
+    now = time.time() if now is None else now
+    wanted = contract.get('decision_actions', [])
+    if not wanted:
+        return []
+    if not isinstance(wanted, list) or len(wanted) > 16 or any(not isinstance(x, str) for x in wanted):
+        return []
+    scope = contract.get('inputs')
+    if not scope or not task.workspace_path:
+        return []
+    try:
+        _verify_files(Path(task.workspace_path).resolve(strict=True), scope, [_MAX_BYTES])
+    except (OSError, ValueError):
+        return []
+    rows = conn.execute(
+        'SELECT id, body FROM task_comments WHERE task_id = ? ORDER BY id DESC LIMIT 100',
+        (task.id,),
+    ).fetchall()
+    seen, matches = set(), []
+    for row in rows:
+        body = row['body'] or ''
+        if not body.startswith(_DECISION) or len(body) > 16384:
+            continue
+        try:
+            record = json.loads(body[len(_DECISION):])
+            action = record.get('action')
+            if not isinstance(action, str) or action not in wanted or action in seen:
+                continue
+            if record.get('task_id') != task.id or record.get('inputs') != scope:
+                continue
+            seen.add(action)
+            expiry = record.get('expires_at')
+            if (record.get('revoked') is True or type(expiry) not in (int, float)
+                    or not now < expiry or not _source_matches(record.get('source'), task)):
+                continue
+            matches.append({'action': action, 'comment_id': row['id'], 'expires_at': expiry,
+                            'status': 'source_reference_matches'})
+        except (ValueError, TypeError, AttributeError):
+            continue
+    return matches
+
+
+def reusable_checks(conn, task, contract):
+    """Only own past runs and completed direct parents, exact inputs/environment/checks.
+
+    No global scan/cache: board, task lineage and workspace remain boundaries.
+    This is evidence reuse, not a test runner or an approval shortcut.
+    """
+    if not contract.get('checks'):
+        return []
+    rows = conn.execute(
+        'SELECT r.id, r.task_id, r.metadata FROM task_runs r JOIN tasks t ON t.id=r.task_id '
+        "WHERE r.outcome='completed' AND r.ended_at IS NOT NULL AND "
+        '(r.task_id=? OR (t.status=\'done\' AND r.task_id IN '
+        '(SELECT parent_id FROM task_links WHERE child_id=?))) '
+        'ORDER BY r.id DESC LIMIT 20', (task.id, task.id),
+    ).fetchall()
+    for row in rows:
+        try:
+            metadata = json.loads(row['metadata'] or '{}')
+            # Only records checked by the native handoff path are candidates.
+            stamp = metadata.get('handoff_check', {})
+            if stamp.get('version') != 1 or stamp.get('status') != 'declared_evidence_matches':
+                continue
+            checks = check_verification(task, contract, metadata)
+            return [{'run_id': row['id'], 'task_id': row['task_id'], 'checks': checks,
+                     'status': 'evidence_matches_now'}]
+        except (OSError, ValueError, TypeError, AttributeError):
+            continue
+    return []
+
+
+def evidence_context(conn, task):
+    try:
+        contract = task_contract(task.body)
+        if contract is None:
+            return ''
+        result = {'decisions': decision_references(conn, task, contract),
+                  'reusable_verification': reusable_checks(conn, task, contract)}
+        if not any(result.values()):
+            return ''
+        return ('\n## Scoped evidence (programmatic checks)\n'
+                + json.dumps(result, sort_keys=True)
+                + '\nDecision references require the original owner scope; no new authority is granted. '
+                'Reuse only the named checks while inputs and environment still match. '
+                'Independent review, current permissions and publication gates remain required.\n')
+    except (OSError, ValueError, TypeError):
+        return '\nScoped evidence unavailable; do not infer approval or test reuse.\n'
+
+
+def build_context(conn, task_id):
+    """Everything a worker should read about its task: header, body,
+    attachments, prior attempts, done-parent handoffs, the assignee's recent
+    work, comments. Lists are tail-capped and fields char-capped
+    (``_CTX_MAX_*``) so the prompt stays bounded on pathological boards."""
+    from hermes_cli import kanban_db as kb, kanban_db_context as context
+    task = kb.get_task(conn, task_id)
+    if not task:
+        raise ValueError(f"unknown task {task_id}")
+    # One clock reading so every relative age in this rendering agrees.
+    now = int(time.time())
+    lines: list[str] = []
+    context._ctx_header(lines, task)
+    from hermes_cli.kanban_role_flow import worker_context
+    lines.append(worker_context(conn, task))
+    scoped = evidence_context(conn, task)
+    if scoped:
+        lines.append(scoped)
+    context._ctx_attachments(lines, kb.list_attachments(conn, task_id))
+    context._ctx_prior_attempts(lines, conn, task_id, now)
+    from hermes_cli.kanban_parent_handoff import render_parent_results
+    render_parent_results(lines, conn, task_id, now)
+    context._ctx_role_history(lines, conn, task, now)
+    context._ctx_comments(lines, kb.list_comments(conn, task_id), now)
+    lines.append("Handoff: give a short decision/result summary, remaining work and blockers, plus artifact references in metadata. Keep full logs in artifacts; existing approval and verification gates still apply.")
+    return "\n".join(lines).rstrip() + "\n"
+
diff --git a/hermes_cli/kanban_failure_receipt.py b/hermes_cli/kanban_failure_receipt.py
new file mode 100644
index 00000000..785d4cbd
--- /dev/null
+++ b/hermes_cli/kanban_failure_receipt.py
@@ -0,0 +1,20 @@
+"""Content-free diagnostics bound to the native task/run; never grants a retry."""
+import hashlib
+import json
+
+_OUTCOMES = {'spawn_failed', 'timed_out', 'crashed', 'protocol_violation', 'gave_up'}
+
+
+def failure_receipt(task_id, run_id, outcome, *, phase=None, error_type=None):
+    outcome = outcome if outcome in _OUTCOMES else 'unknown'
+    phase = phase if phase in {'workspace', 'spawn', 'worker'} else 'worker'
+    # Error strings may contain secrets. Only a fixed error-type vocabulary is retained.
+    error_type = error_type if error_type in {'OSError', 'RuntimeError', 'ValueError', 'TypeError', 'RestartSafeScopeUnavailable'} else 'unknown'
+    fields = {'version': 1, 'task_id': task_id, 'run_id': run_id, 'outcome': outcome,
+              'phase': phase, 'error_type': error_type,
+              'process_started': False if phase == 'workspace' else None,
+              'replay_authorized': False, 'raw_error_retained': False}
+    # Digest classifies a repeat, not the unknown raw error or provider state.
+    signature = {k: fields[k] for k in ('outcome', 'phase', 'error_type')}
+    fields['class_digest'] = hashlib.sha256(json.dumps(signature, sort_keys=True).encode()).hexdigest()[:16]
+    return fields
diff --git a/hermes_cli/kanban_parent_handoff.py b/hermes_cli/kanban_parent_handoff.py
new file mode 100644
index 00000000..aa6fe2d8
--- /dev/null
+++ b/hermes_cli/kanban_parent_handoff.py
@@ -0,0 +1,51 @@
+"""Compact point-in-time parent handoffs with exact native recovery references."""
+import json
+
+_FACTS=('decisions','decision','remaining','next_steps','blockers','risks','gates','artifacts','verification','handoff_check','completion_advisory')
+
+
+def excerpt(text, limit):
+    text=str(text).strip()
+    if len(text)<=limit:return text
+    tail=min(240,limit//4)
+    return text[:limit-tail]+' … [excerpt; read full record before relying on omitted details] … '+text[-tail:]
+
+
+def metadata_brief(metadata):
+    if not isinstance(metadata,dict) or not metadata:return ''
+    selected={};budget=1600
+    for key in _FACTS:
+        if key not in metadata:continue
+        value=json.dumps(metadata[key],ensure_ascii=False,sort_keys=True)
+        cost=len(key)+len(value)
+        if cost<=min(480,budget):selected[key]=metadata[key];budget-=cost
+        elif budget>=160:
+            selected[key]={'excerpt':excerpt(value,min(400,budget-60)), 'full_record_required':True}
+            budget-=len(json.dumps(selected[key],ensure_ascii=False))+len(key)
+    omitted=sorted(set(metadata)-set(selected))
+    return json.dumps({'facts':selected, 'other_metadata_keys':omitted[:20],
+                       'additional_keys':max(0,len(omitted)-20)},ensure_ascii=False,sort_keys=True)
+
+
+def render_parent_results(lines,conn,task_id,now):
+    from hermes_cli import kanban_db as kb
+    parents=conn.execute('SELECT parent_id FROM task_links WHERE child_id=? ORDER BY parent_id',(task_id,)).fetchall()
+    header=False
+    for row in parents:
+        task=kb.get_task(conn,row['parent_id'])
+        if task is None or task.status!='done':continue
+        latest=conn.execute("SELECT id FROM task_runs WHERE task_id=? AND outcome='completed' AND ended_at IS NOT NULL ORDER BY started_at DESC,id DESC LIMIT 1",(task.id,)).fetchone()
+        run=kb.get_run(conn,latest['id']) if latest else None
+        if not header:
+            lines.extend(['## Parent task results',
+                'Point-in-time handoffs, not live state or permission. Recheck current source and all existing gates. Excerpts require the full record before relying on omitted details.'])
+            header=True
+        when=(run.ended_at if run else None) or task.completed_at
+        from hermes_cli.kanban_db_context import _relative_age
+        age=_relative_age(when,now)
+        lines.append(f'### {task.id}'+(f' (completed {age})' if age else ''))
+        summary=run.summary if run and run.summary and run.summary.strip() else task.result
+        lines.append(excerpt(summary,1200) if summary else '(no result recorded)')
+        if run and (facts:=metadata_brief(run.metadata)):lines.append(facts)
+        lines.append(f'Recovery: kanban_show(task_id="{task.id}", full=true); run_id={run.id if run else "legacy"}. Canonical summary/metadata and artifact references remain there.')
+        lines.append('')
diff --git a/hermes_cli/kanban_ready_order.py b/hermes_cli/kanban_ready_order.py
new file mode 100644
index 00000000..95b76e15
--- /dev/null
+++ b/hermes_cli/kanban_ready_order.py
@@ -0,0 +1,37 @@
+"""Prioritize immediate dependency release without changing eligibility or capacity."""
+import logging
+import time
+
+_LOG=logging.getLogger(__name__)
+_AGING_SECONDS=15*60
+_MAX_EDGES=20000
+
+
+def order_ready(conn, rows, *, now=None):
+    if len(rows)<2:return rows
+    # Do not traverse arbitrary depth or speculate about task durations. A child
+    # counts only if this ready task is its sole remaining nonterminal parent.
+    edges=conn.execute(
+        "SELECT l.child_id,l.parent_id,p.status FROM task_links l "
+        "JOIN tasks c ON c.id=l.child_id JOIN tasks p ON p.id=l.parent_id "
+        "WHERE c.status='todo' AND c.claim_lock IS NULL ORDER BY l.child_id,l.parent_id LIMIT ?",
+        (_MAX_EDGES+1,),
+    ).fetchall()
+    if len(edges)>_MAX_EDGES:return rows  # preserve native FIFO when evidence is incomplete
+    candidates={r['id'] for r in rows}; counts={}; pending={}
+    for edge in edges:
+        if edge['status'] not in ('done','archived'):
+            pending.setdefault(edge['child_id'],set()).add(edge['parent_id'])
+    for parents in pending.values():
+        if len(parents)==1:
+            parent=next(iter(parents))
+            if parent in candidates:counts[parent]=counts.get(parent,0)+1
+    if not counts:return rows
+    now=time.time() if now is None else now
+    def rank(row):
+        created=row['created_at'];aged=now-created>=_AGING_SECONDS
+        return (-row['priority'],0 if aged else 1,created if aged else -counts.get(row['id'],0),created)
+    ordered=sorted(rows,key=rank)
+    if [r['id'] for r in ordered]!=[r['id'] for r in rows]:
+        _LOG.info('KANBAN_READY_ORDER candidates=%d release_candidates=%d fifo_aged=%d',len(rows),len(counts),sum(now-r['created_at']>=_AGING_SECONDS for r in rows))
+    return ordered
diff --git a/hermes_cli/kanban_role_create.py b/hermes_cli/kanban_role_create.py
new file mode 100644
index 00000000..58b56c27
--- /dev/null
+++ b/hermes_cli/kanban_role_create.py
@@ -0,0 +1,139 @@
+"""Bind existing kanban_create calls to one durable THINK step, without dispatch."""
+import json
+
+from hermes_cli.kanban_role_flow import completed_plan, fingerprint, role_config
+from hermes_cli.kanban_task_contract import task_contract
+from hermes_cli.kanban_write_scopes import normalize_scope
+
+
+def step_key(parent, run, record, step):
+    return 'role-step:' + fingerprint([parent.id, run.id, record['sha256'], step])
+
+
+def _prior_step(conn, key):
+    row = conn.execute("SELECT id FROM tasks WHERE idempotency_key=? ORDER BY created_at DESC,id DESC LIMIT 1", (key,)).fetchone()
+    return row['id'] if row else None
+
+
+def _body(body, binding, step):
+    contract = task_contract(body) or {'version': 1}
+    scope = normalize_scope(step['write_scope'])
+    if 'write_scope' in contract and normalize_scope(contract['write_scope']) != scope:
+        raise ValueError('ACTION write_scope must match the planned step')
+    if 'role_plan' in contract and contract['role_plan'] != binding:
+        raise ValueError('ACTION brief already contains a different role plan')
+    contract.update(role_plan=binding, write_scope=scope)
+    prose = (body or '').split('```hermes-contract\n', 1)
+    tail = prose[1].split('```', 1)[1] if len(prose) == 2 else ''
+    result = prose[0].rstrip() + '\n```hermes-contract\n' + json.dumps(contract, sort_keys=True) + '\n```' + tail
+    task_contract(result)
+    return result
+
+
+def prepare_action(conn, args):
+    """Return scoped body/dependencies/key; original model/quota/rights remain native."""
+    profile = str(args.get('assignee') or '')
+    workflow = role_config(profile)
+    source, wanted = args.get('plan_task'), args.get('plan_step')
+    if not source and not wanted and (workflow is None or workflow['mode'] != 'action'):
+        return args
+    if not isinstance(source, str) or not isinstance(wanted, str):
+        raise ValueError('ACTION requires plan_task and plan_step')
+    parent, run, thinker, record = completed_plan(conn, source)
+    if workflow is None or workflow['mode'] != 'action' or thinker['counterpart'] != profile:
+        raise ValueError('role plan requires its paired ACTION bot')
+    step = next((s for s in record['plan']['steps'] if s['id'] == wanted), None)
+    if step is None:
+        raise ValueError('unknown role plan step')
+    binding = {'version': 1, 'task_id': parent.id, 'run_id': run.id, 'sha256': record['sha256'],
+               'step': wanted, 'actor': profile}
+    parents = list(args.get('parents') or [])
+    parents.append(parent.id)
+    for dep in step.get('after', []):
+        tid = _prior_step(conn, step_key(parent, run, record, dep))
+        if tid is None:
+            raise ValueError('create the preceding ACTION step before its dependent step')
+        from hermes_cli import kanban_db as kb
+        if kb.get_task(conn, tid).status == 'archived':
+            raise ValueError('preceding ACTION is archived; create a new THINK plan')
+        parents.append(tid)
+    key = step_key(parent, run, record, wanted)
+    if args.get('idempotency_key') not in (None, key):
+        raise ValueError('planned ACTION uses a deterministic idempotency key')
+    prepared = {**args, 'body': _body(args.get('body'), binding, step),
+                'parents': sorted(set(parents)), 'idempotency_key': key}
+    _verify_reuse(conn, prepared)
+    return prepared
+
+
+def _verify_reuse(conn, args):
+    from hermes_cli import kanban_db as kb
+
+    tid = _prior_step(conn, args['idempotency_key'])
+    if tid is None:
+        return
+    task = kb.get_task(conn, tid)
+    parents = sorted(row['parent_id'] for row in conn.execute('SELECT parent_id FROM task_links WHERE child_id=?', (tid,)))
+    expected = {'body': args['body'], 'assignee': args['assignee'],
+                'model_override': args.get('model') or None, 'provider_override': args.get('provider') or None,
+                'reasoning_effort': args.get('reasoning_effort') or None}
+    if task.assignee != args['assignee']:
+        event = kb._latest_event(conn, tid, 'review_requested')
+        provenance = kb._json_dict(event['payload']) if event else {}
+        if provenance.get('implementer') == args['assignee'] and provenance.get('reviewer') == task.assignee:
+            expected['assignee'] = task.assignee
+    mismatch = any(getattr(task, name) != value for name, value in expected.items())
+    if args.get('workspace_path') is not None and task.workspace_path != args['workspace_path']:
+        mismatch = True
+    if mismatch or parents != args['parents']:
+        raise ValueError('planned ACTION already exists with changed scope; create a new THINK plan')
+
+
+def create_planned_task(conn, *, plan_task=None, plan_step=None, replan_of=None, **kwargs):
+    """Check lineage, duplicate scope and native insertion under one write transaction."""
+    from hermes_cli import kanban_db as kb
+
+    with kb.write_txn(conn, allow_nested=True):
+        args = {**kwargs, 'plan_task': plan_task, 'plan_step': plan_step,
+                'model': kwargs.get('model_override'), 'provider': kwargs.get('provider_override')}
+        if replan_of is not None:
+            args = prepare_replan(conn, args, replan_of)
+        else:
+            args = prepare_action(conn, args)
+        for field in ('body', 'parents', 'idempotency_key'):
+            if field in args:
+                kwargs[field] = args[field]
+        if plan_task is not None or replan_of is not None:
+            prior = _prior_step(conn, args['idempotency_key'])
+            if prior is not None:
+                return prior
+        return kb.create_task(conn, **kwargs)
+
+
+def prepare_replan(conn, args, task_id):
+    """A new THINK task for a specific blocked ACTION run; never reopen/replay it."""
+    from hermes_cli import kanban_db as kb
+
+    task = kb.get_task(conn, task_id)
+    run = kb.latest_run(conn, task_id) if task else None
+    if (task is None or task.status != 'blocked' or run is None or run.ended_at is None or not run.summary
+            or run.profile != task.assignee or kb._latest_event(conn, task_id, 'claimed', run.id) is None):
+        raise ValueError('replan_of requires a genuinely blocked ACTION run with its reason')
+    contract = task_contract(task.body) or {}
+    binding = contract.get('role_plan', {})
+    parent, _, workflow, record = completed_plan(conn, binding.get('task_id'), binding.get('run_id'))
+    if binding.get('actor') != task.assignee or workflow['counterpart'] != task.assignee:
+        raise ValueError('replan_of is not the paired ACTION task')
+    if args.get('assignee') != role_config(task.assignee)['counterpart']:
+        raise ValueError('replan_of must return to the same role THINK bot')
+    if args.get('plan_task') or args.get('plan_step') or task_id in (args.get('parents') or []):
+        raise ValueError('replan must not wait on or execute the blocked ACTION')
+    reason = run.summary[:2000]
+    body = (args.get('body') or '') + '\nReplan blocked ACTION ' + task.id + ' run ' + str(run.id) + ':\n' + reason
+    body += '\nPrior plan SHA256: ' + record['sha256'] + '\nProduce a new bounded role_plan; do not replay the old step.'
+    prepared = {**args, 'body': body, 'parents': sorted(set([*(args.get('parents') or []), parent.id])),
+                'idempotency_key': 'role-replan:' + fingerprint([task.id, run.id])}
+    if args.get('idempotency_key') not in (None, prepared['idempotency_key']):
+        raise ValueError('replan uses a deterministic idempotency key')
+    _verify_reuse(conn, prepared)
+    return prepared
diff --git a/hermes_cli/kanban_role_flow.py b/hermes_cli/kanban_role_flow.py
new file mode 100644
index 00000000..4afc20b6
--- /dev/null
+++ b/hermes_cli/kanban_role_flow.py
@@ -0,0 +1,210 @@
+"""Role-specific plans on native task runs; no second scheduler or model calls.
+
+Plans are bounded immutable handoff metadata. They survive scratch cleanup and
+refer to a specific completed native run, never an ambient chat or a comment.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+
+_ID = re.compile(r'[a-z][a-z0-9-]{0,63}\Z')
+
+
+def role_config(profile):
+    from hermes_cli.bot_workflow import workflow_snapshot
+    from hermes_cli.profiles import get_profile_dir
+    from hermes_constants import get_hermes_home
+
+    if not profile:
+        return None
+    root = get_profile_dir(profile, home=get_hermes_home())
+    if not (root / 'config.yaml').is_file():
+        return None
+    snapshot = workflow_snapshot(root)
+    if snapshot['pair_status'] == 'unassigned':
+        return None
+    if snapshot['pair_status'] != 'linked':
+        raise ValueError('role plan requires a reciprocal compatible THINK/ACTION pair')
+    return snapshot['workflow']
+
+
+def fingerprint(value):
+    encoded = json.dumps(value, sort_keys=True, ensure_ascii=True, separators=(',', ':')).encode()
+    if len(encoded) > 16384:
+        raise ValueError('role_plan exceeds the 16 KiB handoff budget')
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _texts(value, name, *, maximum=16):
+    if (not isinstance(value, list) or len(value) > maximum
+            or any(not isinstance(x, str) or not x.strip() or len(x) > 500 for x in value)):
+        raise ValueError(f'role_plan {name} must be a bounded list of nonempty text')
+
+
+def validate_plan(plan, role):
+    from hermes_cli.kanban_write_scopes import validate_children
+
+    if (not isinstance(plan, dict) or set(plan) != {'version', 'role', 'constraints', 'steps'}
+            or type(plan['version']) is not int or plan['version'] != 1 or plan['role'] != role):
+        raise ValueError('role_plan requires version 1, matching role, constraints and steps')
+    fingerprint(plan)
+    _texts(plan['constraints'], 'constraints')
+    steps = plan['steps']
+    if not isinstance(steps, list) or not 1 <= len(steps) <= 16:
+        raise ValueError('role_plan needs 1 to 16 steps')
+    children, ids = [], []
+    for step in steps:
+        children.append(_plan_step(step, ids))
+        ids.append(step['id'])
+    validate_children(children)
+    return plan
+
+
+def _plan_step(step, ids):
+    from hermes_cli.kanban_write_scopes import normalize_scope
+
+    if (not isinstance(step, dict) or set(step) - {'id', 'instructions', 'acceptance', 'write_scope', 'after'}
+            or not isinstance(step.get('id'), str) or not _ID.fullmatch(step['id']) or step['id'] in ids):
+        raise ValueError('role_plan step needs a unique lowercase id')
+    instructions = step.get('instructions')
+    if not isinstance(instructions, str) or not instructions.strip() or len(instructions) > 2000:
+        raise ValueError('role_plan step instructions must contain 1 to 2000 characters')
+    _texts(step.get('acceptance'), 'acceptance')
+    if not step['acceptance']:
+        raise ValueError('role_plan step requires acceptance criteria')
+    scope = normalize_scope(step.get('write_scope'))
+    after = step.get('after', [])
+    if not isinstance(after, list) or any(not isinstance(x, str) or x not in ids for x in after):
+        raise ValueError('role_plan dependencies must name earlier steps')
+    return {'parents': [ids.index(x) for x in after],
+            'body': '```hermes-contract\n' + json.dumps({'version': 1, 'write_scope': scope}) + '\n```'}
+
+
+def completed_plan(conn, task_id, run_id=None):
+    from hermes_cli import kanban_db as kb
+
+    task = kb.get_task(conn, task_id)
+    if task is None or task.status != 'done':
+        raise ValueError('role plan parent is not completed')
+    run = kb.latest_run(conn, task_id)
+    if (run is None or run.outcome != 'completed' or not run.ended_at
+            or (run_id is not None and run.id != run_id)):
+        raise ValueError('role plan does not match the current completed native run')
+    record = (run.metadata or {}).get('role_plan', {})
+    if not isinstance(record, dict) or record.get('status') != 'validated':
+        raise ValueError('role plan parent has no validated native plan')
+    workflow = role_config(run.profile)
+    if workflow is None or workflow['mode'] != 'think' or task.assignee != run.profile:
+        raise ValueError('role plan source is not the paired THINK bot')
+    value = validate_plan(record.get('plan'), workflow['role'])
+    if record.get('sha256') != fingerprint(value) or record.get('run_id') != run.id:
+        raise ValueError('role plan metadata changed or has stale run identity')
+    return task, run, workflow, record
+
+
+def _binding(conn, task, binding):
+    from hermes_cli import kanban_db as kb
+
+    required = {'version', 'task_id', 'run_id', 'sha256', 'step', 'actor'}
+    if not isinstance(binding, dict) or set(binding) != required or type(binding['version']) is not int or binding['version'] != 1:
+        raise ValueError('ACTION requires a pinned role plan binding')
+    if not isinstance(binding['task_id'], str) or type(binding['run_id']) is not int:
+        raise ValueError('invalid role plan parent/run identity')
+    parent, run, thinker, record = completed_plan(conn, binding['task_id'], binding['run_id'])
+    actor = role_config(binding['actor'])
+    if (actor is None or actor['mode'] != 'action' or actor['counterpart'] != run.profile
+            or thinker['counterpart'] != binding['actor'] or binding['sha256'] != record['sha256']):
+        raise ValueError('ACTION role plan counterpart or hash mismatch')
+    review = task.status == 'review' or (task.current_run_id is not None
+                                        and kb._retry_status_for_run(conn, task.id) == 'review')
+    if task.assignee != binding['actor'] and not review:
+        raise ValueError('ACTION role plan belongs to another bot')
+    link = conn.execute('SELECT 1 FROM task_links WHERE parent_id=? AND child_id=?', (parent.id, task.id)).fetchone()
+    if not link:
+        raise ValueError('ACTION role plan requires its native parent dependency')
+    step = next((s for s in record['plan']['steps'] if s['id'] == binding['step']), None)
+    if step is None:
+        raise ValueError('ACTION role plan step is missing')
+    _step_dependencies(conn, task, parent, run, record, step)
+    return record, step
+
+
+def _step_dependencies(conn, task, parent, run, record, step):
+    from hermes_cli.kanban_role_create import step_key
+
+    for dependency in step.get('after', []):
+        row = conn.execute(
+            "SELECT t.id FROM tasks t JOIN task_links l ON l.parent_id=t.id "
+            "WHERE l.child_id=? AND t.idempotency_key=? AND t.status!='archived'",
+            (task.id, step_key(parent, run, record, dependency)),
+        ).fetchone()
+        if row is None:
+            raise ValueError('ACTION role plan is missing a required step dependency')
+
+
+def validate_task(conn, task):
+    """Used before claim, dispatch, worker context and native terminal transition."""
+    from hermes_cli.kanban_task_contract import task_contract, validate_task_lane
+    from hermes_cli.kanban_write_scopes import normalize_scope
+
+    validate_task_lane(task)
+    contract = task_contract(task.body) or {}
+    binding = contract.get('role_plan')
+    if binding is not None:
+        record, step = _binding(conn, task, binding)
+        if normalize_scope(contract.get('write_scope')) != normalize_scope(step['write_scope']):
+            raise ValueError('ACTION write_scope differs from its approved role plan')
+        return record, step
+    workflow = role_config(task.assignee)
+    if workflow and workflow['mode'] == 'action':
+        raise ValueError('ACTION requires plan_task and plan_step from a completed THINK task')
+    return None
+
+
+def validate_handoff(conn, task, metadata):
+    """Require a real THINK run and persist its canonical plan on that same run."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_task_contract import task_contract
+
+    contract = task_contract(task.body) or {}
+    if 'role_plan' in contract:
+        validate_task(conn, task)
+        return metadata
+    workflow = role_config(task.assignee)
+    if workflow is None or workflow['mode'] != 'think':
+        return metadata
+    run = kb.get_run(conn, task.current_run_id) if task.current_run_id is not None else None
+    if run is None or run.profile != task.assignee or run.ended_at is not None:
+        raise ValueError('role_plan requires the current native THINK run')
+    value = validate_plan((metadata or {}).get('role_plan'), workflow['role'])
+    return {**(metadata or {}), 'role_plan': {'version': 1, 'status': 'validated', 'run_id': run.id,
+                                            'sha256': fingerprint(value), 'plan': value}}
+
+
+def worker_context(conn, task):
+    """Only the selected step and shared constraints; no full THINK conversation."""
+    found = validate_task(conn, task)
+    if found:
+        record, step = found
+        return ('## Pinned THINK → ACTION plan\n' + json.dumps({'constraints': record['plan']['constraints'],
+                'step': step}, ensure_ascii=False) + '\nFollow this step and its acceptance criteria. '
+                'A material plan change requires a new THINK plan; block with the exact reason. '
+                'Existing quota, permissions, independent review and publication gates still apply.\n')
+    workflow = role_config(task.assignee)
+    if workflow and workflow['mode'] == 'think':
+        return ('## THINK planning contract\nPlan only; do not implement changes. Complete with metadata.role_plan: '
+                '{version:1, role:"' + workflow['role'] + '", constraints:[text], steps:[{id, instructions, '
+                'acceptance:[text], write_scope:[relative path], after:[earlier step id]}]}. '
+                'Keep it within 16 KiB and 16 steps. Empty write_scope means no declared writes. '
+                'Split independent work; order steps that share write paths. No new authorization or paid fallback.\n')
+    return ''
+
+
+def preflight_reason(conn, task):
+    try:
+        validate_task(conn, task)
+    except (OSError, ValueError, TypeError, KeyError) as exc:
+        return 'role plan precondition failed: ' + type(exc).__name__
+    return None
diff --git a/hermes_cli/kanban_run_activity.py b/hermes_cli/kanban_run_activity.py
new file mode 100644
index 00000000..e7d68130
--- /dev/null
+++ b/hermes_cli/kanban_run_activity.py
@@ -0,0 +1,200 @@
+"""Event-only worker timing sidecars. No prompt, tool arguments, results or model calls."""
+from contextlib import contextmanager
+from dataclasses import asdict
+import json
+import logging
+import math
+import sqlite3
+import psutil
+import os
+from pathlib import Path
+import socket
+import threading
+import time
+import uuid
+
+logger = logging.getLogger(__name__)
+_RECORDER = None
+_READ_TOOLS = frozenset({'read_file', 'search_files', 'skill_view', 'skills_list', 'session_search', 'kanban_show'})
+
+
+def activity_path(run, board=None):
+    from hermes_cli import kanban_db as kb
+    return kb.worker_log_path(run.task_id, board=board).with_suffix(f'.run-{run.id}.activity.json')
+
+
+class Recorder:
+    def __init__(self, run, path):
+        self.path = Path(path)
+        self.pid = os.getpid()
+        self.lock = threading.Lock()
+        self.active = {}
+        self.session = None
+        self.last = time.monotonic()
+        now = time.time()
+        self.data = dict(version=1, run_id=run.id, task_id=run.task_id, pid=self.pid,
+                         host=socket.gethostname(), process_created=psutil.Process().create_time(),
+                         observed_from=now, observed_at=now, unobserved_start_seconds=max(0, now-run.started_at),
+                         phase='between_calls', seconds={}, counts={})
+        self.write()
+
+    def write(self):
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        temp = self.path.with_name(self.path.name + '.' + uuid.uuid4().hex + '.tmp')
+        try:
+            with temp.open('x') as stream:
+                os.chmod(temp, 0o600)
+                json.dump(self.data, stream)
+            os.replace(temp, self.path)
+        finally:
+            temp.unlink(missing_ok=True)
+
+    def transition(self, token, phase=None, session=None):
+        with self.lock:
+            if self.pid != os.getpid() or (self.session and session != self.session):
+                return False
+            if session:
+                self.session = session
+            now = time.monotonic()
+            seconds = self.data['seconds']
+            previous = self.data['phase']
+            seconds[previous] = seconds.get(previous, 0) + max(0, now - self.last)
+            self.last = now
+            if phase:
+                self.active[token] = phase
+                counts = self.data['counts']
+                counts[phase] = counts.get(phase, 0) + 1
+            else:
+                self.active.pop(token, None)
+            phases = set(self.active.values())
+            self.data['phase'] = next(iter(phases)) if len(phases) == 1 else 'parallel' if phases else 'between_calls'
+            self.data['observed_at'] = time.time()
+            try:
+                self.write()
+            except OSError:
+                pass  # Keep the in-memory phase balanced when disk telemetry is unavailable.
+            return True
+
+
+def register(conn, task_id, run_id):
+    """Called only after native worker adoption; a foreign run cannot create a recorder."""
+    global _RECORDER
+    try:
+        from hermes_cli import kanban_db as kb
+        run = kb.get_run(conn, run_id)
+        task = kb.get_task(conn, task_id)
+        if (not run or not task or run.task_id != task_id or run.ended_at
+                or run.worker_pid != os.getpid() or task.current_run_id != run_id
+                # health: allow HX002 -- existing dispatcher-owned worker identity, no new setting.
+                or not run.claim_lock or run.claim_lock != os.environ.get('HERMES_KANBAN_CLAIM_LOCK')):
+            return
+        if _RECORDER is None:
+            # health: allow HX002 -- existing native board scope supplied by dispatcher.
+            _RECORDER = Recorder(run, activity_path(run, os.environ.get('HERMES_KANBAN_BOARD')))
+    except (OSError, sqlite3.Error, psutil.Error, ValueError, TypeError, AttributeError):
+        logger.debug("Worker timing registration unavailable")
+
+
+def tool_phase(name, args=None):
+    if name in _READ_TOOLS:
+        return 'reading'
+    # Explicit test commands only, not arbitrary shell text mentioning tests.
+    if name == 'terminal' and isinstance(args, dict):
+        command = str(args.get('command', '')).lstrip()
+        if command.startswith(('pytest ', 'python -m pytest ', 'scripts/run_tests.sh ', 'node --test ')):
+            return 'verification'
+    return 'tools'
+
+
+@contextmanager
+def phase(name, session=None, delegated=False):
+    recorder = _RECORDER
+    token = uuid.uuid4().hex
+    started = False
+    if recorder is not None and session and not delegated:
+        try:
+            started = recorder.transition(token, name, str(session))
+        except (OSError, ValueError, TypeError, RuntimeError):
+            logger.debug("Worker phase start unavailable")
+    try:
+        yield
+    finally:
+        if started:
+            try:
+                recorder.transition(token, session=str(session))
+            except (OSError, ValueError, TypeError, RuntimeError):
+                logger.debug("Worker phase end unavailable")
+
+
+def _finite_nonnegative(value):
+    return (isinstance(value, (int, float)) and not isinstance(value, bool)
+            and math.isfinite(value) and value >= 0)
+
+
+def _matches_run(data, run):
+    """PID is a live lease, not a durable identity after native terminal cleanup."""
+    if (not isinstance(data, dict) or data.get('version') != 1
+            or data.get('run_id') != run.id or data.get('task_id') != run.task_id
+            or data.get('host') != socket.gethostname()):
+        return False
+    pid = data.get('pid')
+    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
+        return False
+    if run.worker_pid is None:
+        if run.ended_at is None:
+            return False
+    elif pid != run.worker_pid:
+        return False
+    names = ('observed_from', 'observed_at', 'unobserved_start_seconds', 'process_created')
+    if not all(_finite_nonnegative(data.get(name)) for name in names):
+        return False
+    # Legacy sidecars encode the run start as observed_from - unobserved_start.
+    # Keep that binding when cleanup has removed both native PID/fingerprint fields.
+    start = data['observed_from'] - data['unobserved_start_seconds']
+    return (math.isclose(start, run.started_at, rel_tol=0, abs_tol=0.001)
+            and data['observed_at'] >= data['observed_from']
+            and 0 < data['process_created'] <= data['observed_from']
+            and (run.ended_at is None or run.ended_at >= run.started_at))
+
+
+def _snapshot_timing(data, run):
+    """One measured window for totals and phases; native completion is separate."""
+    seconds = data.get('seconds')
+    if not isinstance(seconds, dict) or not all(_finite_nonnegative(v) for v in seconds.values()):
+        return False
+    duration = data['unobserved_start_seconds'] + math.fsum(seconds.values())
+    if not math.isfinite(duration):
+        return False
+    data['duration_seconds'] = duration
+    data['card_duration_seconds'] = None if run.ended_at is None else run.ended_at - run.started_at
+    data['after_completion_seconds'] = 0 if run.ended_at is None else max(0, data['observed_at'] - run.ended_at)
+    data['unobserved_tail_seconds'] = 0 if run.ended_at is None else max(0, run.ended_at - data['observed_at'])
+    return True
+
+
+def read_activity(run, board=None):
+    """Bounded historical read; never extrapolate a snapshot or revive a PID lease."""
+    try:
+        path = activity_path(run, board)
+        with path.open() as stream:
+            raw = stream.read(16385)
+        if len(raw) > 16384:
+            return None
+        data = json.loads(raw)
+        if not _matches_run(data, run) or not _snapshot_timing(data, run):
+            return None
+        data['live'] = False
+        if run.ended_at is None:
+            process = psutil.Process(data['pid'])
+            data['live'] = (process.create_time() == data['process_created']
+                            and process.status() != psutil.STATUS_ZOMBIE)
+        return data
+    except (OSError, psutil.Error, ValueError, TypeError, KeyError, AttributeError, OverflowError):
+        return None
+
+
+def run_payloads(runs, board=None):
+    payloads = [asdict(run) for run in runs]
+    for run, payload in zip(runs[-20:], payloads[-20:]):
+        payload['activity'] = read_activity(run, board)
+    return payloads
