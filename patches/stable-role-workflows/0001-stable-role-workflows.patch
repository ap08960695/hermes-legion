diff --git a/apps/desktop/src/plugins/hermes-bots/bot-workflow.tsx b/apps/desktop/src/plugins/hermes-bots/bot-workflow.tsx
new file mode 100644
index 00000000..e63a58b1
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/bot-workflow.tsx
@@ -0,0 +1,291 @@
+import { surfaceModelSwitchConfirm } from '@hermes/plugin-sdk'
+import { useEffect, useRef, useState } from 'react'
+
+import { BotModelFields, editableModel } from './bot-model-fields'
+import type { BotModelSelection, BotModelSnapshot } from './bot-model-fields'
+import { requestForBot } from './routing'
+import type { RosterRow } from './types'
+
+interface Workflow {
+  role: string
+  mode: 'think' | 'action'
+  family: '' | 'gpt' | 'claude' | 'agy' | 'nim' | 'web'
+  counterpart: string
+}
+interface Snapshot {
+  workflow: Workflow | null
+  revision: string
+  pair_status: string
+  model?: BotModelSnapshot | null
+  confirm_required?: boolean
+  confirm_message?: string
+}
+interface Draft {
+  bot: RosterRow
+  opened: Snapshot
+  workflow: Workflow | null
+  model: BotModelSelection | null
+  dirty: boolean
+}
+
+function botKey(bot: RosterRow | null) {
+  return bot
+    ? JSON.stringify([
+        bot.name,
+        bot.route?.connectionId || bot.connectionId,
+        bot.route?.profile,
+        bot.route?.targetProfile || bot.targetProfile
+      ])
+    : ''
+}
+
+/** One read per opened bot; stale replies never replace another bot's edits. */
+export function useBotWorkflow(bot: RosterRow | null, open: boolean) {
+  const target = useRef(bot)
+  target.current = bot
+  const identity = botKey(bot)
+  const [draft, setDraft] = useState<Draft | null>(null)
+  const [error, setError] = useState('')
+  const [loading, setLoading] = useState(false)
+  const latest = useRef({ draft, identity, open })
+  latest.current = { draft, identity, open }
+
+  useEffect(() => {
+    const selected = target.current
+
+    if (!selected || !open) {
+      return
+    }
+
+    let cancelled = false
+    setDraft(null)
+    setError('')
+    setLoading(true)
+    requestForBot(selected, 'profiles.workflow.get', { name: selected.name })
+      .then(result => {
+        if (cancelled) {
+          return
+        }
+
+        const snapshot = result as Snapshot
+        setDraft({
+          bot: selected,
+          opened: snapshot,
+          workflow: snapshot.workflow,
+          model: editableModel(snapshot.model),
+          dirty: false
+        })
+      })
+      .catch(() => {
+        if (!cancelled) {
+          setError('Role pairing is unavailable. Load the updated Gateway to edit it.')
+        }
+      })
+      .finally(() => {
+        if (!cancelled) {
+          setLoading(false)
+        }
+      })
+
+    return () => {
+      cancelled = true
+    }
+  }, [identity, open])
+
+  const changeDraft = (patch: Partial<Pick<Draft, 'model' | 'workflow'>>) => {
+    setDraft(current => {
+      if (!current) {
+        return current
+      }
+
+      const next = { ...current, ...patch }
+      next.dirty =
+        JSON.stringify([next.workflow, next.model]) !==
+        JSON.stringify([current.opened.workflow, editableModel(current.opened.model)])
+
+      return next
+    })
+    setError('')
+  }
+
+  const change = (workflow: Workflow | null) => changeDraft({ workflow })
+
+  const changeModel = (patch: Partial<BotModelSelection>) => {
+    if (draft?.model) {
+      changeDraft({ model: { ...draft.model, ...patch } })
+    }
+  }
+
+  const save = async () => {
+    if (!draft?.dirty) {
+      return true
+    }
+
+    if (!open || botKey(draft.bot) !== identity) {
+      return false
+    }
+
+    if (draft.workflow && (!draft.workflow.role.trim() || !draft.workflow.family)) {
+      setError('Choose a role and family before saving.')
+
+      return false
+    }
+
+    try {
+      const modelChanged = JSON.stringify(draft.model) !== JSON.stringify(editableModel(draft.opened.model))
+
+      const payload = {
+        name: draft.bot.name,
+        workflow: draft.workflow,
+        expected_revision: draft.opened.revision,
+        ...(modelChanged ? { model: draft.model } : {})
+      }
+
+      const isStale = () =>
+        latest.current.draft !== draft || !latest.current.open || latest.current.identity !== identity
+
+      const accept = (result?: Snapshot) => {
+        if (result && !isStale()) {
+          setDraft({
+            ...draft,
+            opened: result,
+            workflow: result.workflow,
+            model: editableModel(result.model),
+            dirty: false
+          })
+          setError('')
+        }
+      }
+
+      const result = (await requestForBot(draft.bot, 'profiles.workflow.configure', payload)) as Snapshot
+
+      if (isStale()) {
+        return false
+      }
+
+      if (result.confirm_required) {
+        return await surfaceModelSwitchConfirm<Snapshot>({
+          confirmMessage: result.confirm_message,
+          failureMessage: 'Could not save bot settings. Your edits are still here.',
+          model: draft.model?.model,
+          isStale,
+          requestConfirmed: () =>
+            requestForBot(draft.bot, 'profiles.workflow.configure', { ...payload, confirm: true }) as Promise<Snapshot>,
+          finish: accept
+        })
+      }
+
+      accept(result)
+
+      return true
+    } catch {
+      setError('Could not save bot settings. Check the model and effort, or reload if another session changed them.')
+
+      return false
+    }
+  }
+
+  return { draft: botKey(draft?.bot || null) === identity ? draft : null, loading, error, change, changeModel, save }
+}
+
+interface BotWorkflowFieldsProps {
+  state: ReturnType<typeof useBotWorkflow>
+}
+const control = 'h-8 w-full rounded-md border border-(--ui-stroke-secondary) bg-(--ui-bg) px-2 text-xs'
+
+/** Role/mode is independent from model choice and does not imply available quota. */
+export function BotWorkflowFields({ state }: BotWorkflowFieldsProps) {
+  if (state.loading) {
+    return <p className="text-xs text-(--ui-text-tertiary)">Loading role pairing…</p>
+  }
+
+  const workflow = state.draft?.workflow
+  const disabled = !state.draft
+
+  const patch = (field: keyof Workflow, value: string) => {
+    if (workflow) {
+      state.change({ ...workflow, [field]: value })
+    }
+  }
+
+  return (
+    <fieldset className="grid gap-2 rounded-md border border-(--ui-stroke-secondary) p-3" disabled={disabled}>
+      <legend className="px-1 text-xs font-medium">THINK / ACTION</legend>
+      <label className="grid gap-1 text-xs">
+        Mode
+        <select
+          className={control}
+          onChange={event => {
+            const mode = event.target.value
+            state.change(
+              mode
+                ? {
+                    role: workflow?.role || '',
+                    mode: mode as Workflow['mode'],
+                    family: workflow?.family || '',
+                    counterpart: workflow?.counterpart || ''
+                  }
+                : null
+            )
+          }}
+          value={workflow?.mode || ''}
+        >
+          <option value="">Unassigned</option>
+          <option value="think">THINK — plan</option>
+          <option value="action">ACTION — execute</option>
+        </select>
+      </label>
+      {workflow ? (
+        <div className="grid gap-2 sm:grid-cols-2">
+          <label className="grid gap-1 text-xs">
+            Role
+            <input
+              className={control}
+              onChange={event => patch('role', event.target.value)}
+              placeholder="developer"
+              value={workflow.role}
+            />
+          </label>
+          <label className="grid gap-1 text-xs">
+            Family
+            <select className={control} onChange={event => patch('family', event.target.value)} value={workflow.family}>
+              <option value="">Choose family</option>
+              {['gpt', 'claude', 'agy', 'nim', 'web'].map(family => (
+                <option key={family} value={family}>
+                  {family.toUpperCase()}
+                </option>
+              ))}
+            </select>
+          </label>
+          <label className="grid gap-1 text-xs sm:col-span-2">
+            Counterpart
+            <input
+              className={control}
+              onChange={event => patch('counterpart', event.target.value)}
+              placeholder="Profile ID of the matching role"
+              value={workflow.counterpart}
+            />
+          </label>
+        </div>
+      ) : null}
+      {state.draft ? (
+        <p className="text-xs text-(--ui-text-tertiary)">
+          Pair: {state.draft.opened.pair_status}. Model, quota and capability gates stay separate.
+        </p>
+      ) : null}
+      {state.draft?.model && state.draft.opened.model ? (
+        <BotModelFields
+          bot={state.draft.bot}
+          onChange={state.changeModel}
+          opened={state.draft.opened.model}
+          value={state.draft.model}
+        />
+      ) : null}
+      {state.error ? (
+        <p className="text-xs text-red-400" role="alert">
+          {state.error}
+        </p>
+      ) : null}
+    </fieldset>
+  )
+}
