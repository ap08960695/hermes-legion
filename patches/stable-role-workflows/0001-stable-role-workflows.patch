+"""Bind new native runs to their brief and recheck declared inputs before handoff."""
+import hashlib
+import json
+from pathlib import Path
+
+
+def brief_pin(conn,task_id):
+    row=conn.execute('SELECT title,body FROM tasks WHERE id=?',(task_id,)).fetchone()
+    if row is None:raise ValueError('task disappeared before claim pin')
+    encoded=json.dumps(list(row),ensure_ascii=True,separators=(',',':')).encode()
+    return {'version':1,'sha256':hashlib.sha256(encoded).hexdigest()}
+
+
+def validate_current_inputs(conn,task_id,*,check_files=True):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_task_contract import task_contract
+    task=kb.get_task(conn,task_id)
+    if not task:return
+    from hermes_cli.kanban_role_flow import validate_task
+    validate_task(conn,task)
+    if task.current_run_id is not None:
+        event=conn.execute("SELECT payload FROM task_events WHERE task_id=? AND run_id=? AND kind='claimed' ORDER BY id DESC LIMIT 1",(task_id,task.current_run_id)).fetchone()
+        payload=kb._json_dict(event['payload']) if event else {}
+        if 'brief_pin' in payload and payload['brief_pin']!=brief_pin(conn,task_id):
+            raise ValueError('task brief changed since this run was claimed; result requires a current native run')
+    if check_files:validate_declared_files(task,task_contract(task.body))
+
+
+def validate_declared_files(task,contract):
+    if not contract or not any(contract.get(field) for field in ('inputs','environment')):return
+    if not task.workspace_path:raise ValueError('declared input workspace is unresolved')
+    from hermes_cli.kanban_task_contract import _verify_files,_MAX_BYTES
+    root=Path(task.workspace_path).resolve(strict=True);budget=[_MAX_BYTES]
+    for field in ('inputs','environment'):_verify_files(root,contract.get(field,{}),budget)
+
+
+def preflight_input_reason(task):
+    """Only resolved declared files: worktree creation and ordinary runtime failures stay native."""
+    if not task or not task.workspace_path:return None
+    from hermes_cli.kanban_task_contract import task_contract
+    try:validate_declared_files(task,task_contract(task.body))
+    except (OSError,ValueError,TypeError,KeyError) as exc:
+        return 'declared input/environment precondition failed: '+type(exc).__name__
+    return None
diff --git a/hermes_cli/kanban_task_contract.py b/hermes_cli/kanban_task_contract.py
new file mode 100644
index 00000000..0f87aeb3
--- /dev/null
+++ b/hermes_cli/kanban_task_contract.py
@@ -0,0 +1,271 @@
+"""Opt-in task requirements and bounded, deterministic handoff evidence checks.
+
+This checks declared bytes and recorded outcomes, never grants approval, executes
+commands, verifies scientific correctness, or replaces independent review.
+"""
+from __future__ import annotations
+
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+import re
+import stat
+import time
+from pathlib import Path
+
+_MARKER = '```hermes-contract\n'
+_MAX_BYTES = 16 * 1024 * 1024
+_MAX_FILES = 64
+_SHA = re.compile(r'[0-9a-f]{64}')
+
+
+def task_contract(body):
+    if _MARKER not in (body or ''):
+        return None
+    if body.count(_MARKER) != 1:
+        raise ValueError('one hermes-contract block is allowed')
+    raw = body.split(_MARKER, 1)[1].split('```', 1)
+    if len(raw) != 2 or len(raw[0]) > 16384:
+        raise ValueError('invalid or oversized hermes-contract')
+    data = json.loads(raw[0])
+    if not isinstance(data, dict) or type(data.get('version')) is not int or data['version'] != 1:
+        raise ValueError('hermes-contract version must be 1')
+    for field in ('required_tools', 'checks'):
+        values = data.get(field, [])
+        if (not isinstance(values, list) or len(values) > 32
+                or any(not isinstance(v, str) or not re.fullmatch(r'[a-zA-Z0-9_.-]{1,80}', v) for v in values)
+                or len(set(values)) != len(values)):
+            raise ValueError(f'invalid {field}')
+    for field in ('inputs', 'environment'):
+        values = data.get(field, {})
+        if not isinstance(values, dict) or len(values) > _MAX_FILES:
+            raise ValueError(f'invalid {field}')
+        for path, digest in values.items():
+            if not isinstance(path, str) or not isinstance(digest, str) or not _SHA.fullmatch(digest):
+                raise ValueError(f'invalid {field} file hash')
+    if data.get('checks') and (not data.get('inputs') or not data.get('environment')):
+        raise ValueError('checks require explicit input and environment file hashes')
+    _check_definitions(data)
+    if 'write_scope' in data:
+        from hermes_cli.kanban_write_scopes import normalize_scope
+        normalize_scope(data['write_scope'])
+    return data
+
+
+def _check_definitions(data):
+    wanted = data.get('checks', [])
+    definitions = data.get('check_definitions', {})
+    if not isinstance(definitions, dict) or set(definitions) != set(wanted):
+        raise ValueError('check definitions must name exactly the required checks')
+    for path in definitions.values():
+        if not isinstance(path, str) or path not in data.get('inputs', {}):
+            raise ValueError('check definition must be an explicitly hashed input')
+
+
+def _file_hash(root, name, budget):
+    path = (root / name).resolve(strict=True)
+    if not path.is_relative_to(root):
+        raise ValueError('evidence path escapes task workspace')
+    # Refuse devices/FIFOs before opening; bounded total I/O per validation.
+    st = path.stat()
+    if not stat.S_ISREG(st.st_mode) or st.st_size > budget[0]:
+        raise ValueError('evidence is not a bounded regular file')
+    fd = os.open(path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_NONBLOCK', 0))
+    with os.fdopen(fd, 'rb') as stream:
+        opened = os.fstat(stream.fileno())
+        if not stat.S_ISREG(opened.st_mode) or (opened.st_dev, opened.st_ino) != (st.st_dev, st.st_ino):
+            raise ValueError('evidence file changed during open')
+        data = stream.read(budget[0] + 1)
+    budget[0] -= len(data)
+    if budget[0] < 0:
+        raise ValueError('evidence byte budget exceeded')
+    return hashlib.sha256(data).hexdigest()
+
+
+def _verify_files(root, files, budget):
+    for name, digest in files.items():
+        if _file_hash(root, name, budget) != digest:
+            raise ValueError('evidence file hash mismatch')
+
+
+def check_verification(task, contract, metadata, *, now=None):
+    """Return verified check IDs. Exit codes are recorded evidence, not independently observed execution."""
+    wanted = contract.get('checks', [])
+    if not wanted:
+        return []
+    now = time.time() if now is None else now
+    evidence = (metadata or {}).get('verification')
+    if not isinstance(evidence, dict) or evidence.get('version') != 1:
+        raise ValueError('handoff requires verification v1 evidence')
+    if not task.workspace_path:
+        raise ValueError('handoff workspace is unresolved')
+    root = Path(task.workspace_path).resolve(strict=True)
+    budget = [_MAX_BYTES]
+    for key in ('inputs', 'environment'):
+        if evidence.get(key) != contract.get(key):
+            raise ValueError(f'verification {key} scope mismatch')
+        _verify_files(root, contract[key], budget)
+    if evidence.get('check_definitions') != contract.get('check_definitions'):
+        raise ValueError('verification check definitions mismatch')
+    checks = evidence.get('checks')
+    if not isinstance(checks, list) or len(checks) > 32:
+        raise ValueError('verification checks must be bounded records')
+    by_name = {row.get('name'): row for row in checks if isinstance(row, dict)}
+    if len(by_name) != len(checks):
+        raise ValueError('duplicate or malformed verification checks')
+    for name in wanted:
+        row = by_name.get(name, {})
+        if type(row.get('exit_code')) is not int or row['exit_code'] != 0:
+            raise ValueError(f'check {name} has no successful recorded exit')
+        start, end = row.get('completed_at'), row.get('expires_at')
+        if (type(start) not in (int, float) or type(end) not in (int, float)
+                or not 0 < start <= now < end):
+            raise ValueError(f'check {name} is expired or has invalid time')
+        digest, path = row.get('sha256'), row.get('log')
+        if not isinstance(digest, str) or not _SHA.fullmatch(digest) or not isinstance(path, str):
+            raise ValueError(f'check {name} has no pinned result log')
+        if _file_hash(root, path, budget) != digest:
+            raise ValueError(f'check {name} result log changed')
+    return wanted
+
+
+def validate_handoff(conn, task_id, metadata, *, summary=None):
+    from hermes_cli import kanban_db as kb
+    task = kb.get_task(conn, task_id)
+    from hermes_cli.kanban_run_inputs import validate_current_inputs
+    validate_current_inputs(conn, task_id, check_files=False)
+    contract = task_contract(task.body) if task else None
+    from hermes_cli.kanban_completion_advisory import annotate
+    metadata = annotate(metadata, summary)
+    if task:
+        from hermes_cli.kanban_role_flow import validate_handoff as validate_role_handoff
+        metadata = validate_role_handoff(conn, task, metadata)
+    if contract is None:
+        return metadata
+    verified = check_verification(task, contract, metadata)
+    if not contract.get("checks"):
+        from hermes_cli.kanban_run_inputs import validate_declared_files
+        validate_declared_files(task, contract)
+    # Declared files must actually exist before success/review is published.
+    artifacts = (metadata or {}).get('artifacts', [])
+    if not isinstance(artifacts, (list, tuple)) or len(artifacts) > _MAX_FILES:
+        raise ValueError('invalid handoff artifact list')
+    if artifacts:
+        if not task.workspace_path:
+            raise ValueError('handoff workspace is unresolved')
+        root = Path(task.workspace_path).resolve(strict=True)
+        budget = [_MAX_BYTES]
+        for path in artifacts:
+            if not isinstance(path, str):
+                raise ValueError('invalid artifact path')
+            _file_hash(root, path, budget)
+    return {**(metadata or {}), 'handoff_check': {
+        'version': 1, 'checks': verified, 'artifacts_checked': len(artifacts),
+        'status': 'declared_evidence_matches', 'independent_review': 'still_required',
+    }}
+
+
+def configured_tools(assignee):
+    """Resolve the worker's own CLI selection; no service checks or credential/model probes."""
+    from hermes_cli.profiles import resolve_profile_env
+    from hermes_cli.kanban_db_dispatch import _worker_profile_scope
+    from hermes_cli.config import load_config_readonly
+    from hermes_cli.tools_config import _get_platform_tools
+    from toolsets import resolve_toolset, session_disabled_toolsets
+    home = resolve_profile_env(assignee)
+    with _worker_profile_scope(home):
+        cfg = load_config_readonly()
+        selected = _get_platform_tools(cfg, 'cli')
+        if not selected:
+            raise ValueError('worker tool selection is unknown')
+        # Do not discover plugins or invoke check_fn/network probes in the dispatcher.
+        from toolsets import TOOLSETS
+        names = set().union(*(set(resolve_toolset(s, include_registry=False))
+                              for s in selected if s in TOOLSETS))
+        disabled = session_disabled_toolsets((cfg.get('agent') or {}).get('disabled_toolsets'), 'cli')
+        for group in disabled or ():
+            names.difference_update(resolve_toolset(group, include_registry=False))
+        return names
+
+
+def preflight_reason(body, assignee):
+    try:
+        contract = task_contract(body)
+        if not contract or not contract.get('required_tools'):
+            return None
+        missing = set(contract['required_tools']) - configured_tools(assignee)
+        return 'required tools not configured: ' + ', '.join(sorted(missing)) if missing else None
+    except (OSError, ValueError, TypeError, KeyError) as exc:
+        return 'task capability preflight unresolved: ' + type(exc).__name__
+
+
+def validate_task_lane(task):
+    """Opt-in literal data markers, bound to the assignee before claim or model I/O.
+
+    This enforces an owner's declared project boundary; it does not classify
+    documents, inspect secrets or grant clearance when a marker is absent.
+    """
+    from hermes_cli.config import require_readable_config_before_write
+    from hermes_cli.profiles import get_profile_dir
+    from hermes_constants import get_hermes_home
+
+    if not task.assignee:
+        return
+    path = get_profile_dir(task.assignee, home=get_hermes_home()) / 'config.yaml'
+    if not path.is_file():
+        return  # Legacy externally managed assignees may have no installed profile.
+    config = require_readable_config_before_write(path)
+    kanban = config.get('kanban', {})
+    markers = kanban.get('blocked_task_markers', []) if isinstance(kanban, dict) else None
+    if (not isinstance(markers, list) or len(markers) > 32
+            or any(not isinstance(x, str) or not x.strip() or len(x) > 160 for x in markers)):
+        raise ValueError('invalid profile data boundary configuration')
+    if not markers:
+        return
+    text = '\n'.join(str(getattr(task, key, '') or '') for key in
+                     ('title', 'body', 'workspace_path', 'tenant')).casefold()
+    if any(marker.casefold() in text for marker in markers):
+        raise ValueError('profile data boundary forbids this task; keep its approved lane')
+
+
+def guard_dispatch(conn, row, assignee, result, *, dry_run):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_run_inputs import preflight_input_reason
+    from hermes_cli.kanban_role_flow import preflight_reason as role_preflight
+    reason = (preflight_reason(row['body'], assignee) or role_preflight(conn, kb.get_task(conn, row['id']))
+              or preflight_input_reason(kb.get_task(conn, row['id'])))
+    if not reason:
+        return False
+    result.respawn_guarded.append((row['id'], reason))
+    if not dry_run:
+        from hermes_cli import kanban_db as kb
+        # Native capability block: no worker claim or retry budget consumed.
+        # Recheck under the normal transaction ownership fence in block_task.
+        task = kb.get_task(conn, row['id'])
+        if task and task.status == 'ready' and task.assignee == assignee:
+            kb.block_task(conn, row['id'], reason=reason, kind='capability',
+                          expected_status='ready', expected_assignee=assignee)
+    return True
+
+
+def lane_rows(conn, status):
+    """Unclaimed rows with the brief needed by configured-capability preflight."""
+    rows = conn.execute(
+        'SELECT id, assignee, body, priority, created_at FROM tasks WHERE status = ? AND claim_lock IS NULL '
+        'ORDER BY priority DESC, created_at ASC', (status,),
+    ).fetchall()
+    if status == 'ready':
+        from hermes_cli.kanban_ready_order import order_ready
+        return order_ready(conn, rows)
+    return rows
+
+
+@contextmanager
+def handoff_txn(conn,task_id):
+    """Check the current brief and declared bytes under the native terminal transition lock."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_run_inputs import validate_current_inputs
+    with kb.write_txn(conn):
+        validate_current_inputs(conn,task_id)
+        yield
diff --git a/hermes_cli/kanban_write_scopes.py b/hermes_cli/kanban_write_scopes.py
