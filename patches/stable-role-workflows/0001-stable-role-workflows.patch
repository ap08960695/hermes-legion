+    _reject_delegated_child_mutation("kanban_reassign")
+    _require_orchestrator_tool("kanban_reassign")
+    tid, target = str(args.get("task_id") or "").strip(), str(args.get("profile") or "").strip()
+    _check(tid and target, "task_id and profile are required")
+    reason = str(args.get("reason") or "").strip()[:200]
+    with _board(args.get("board")) as (kb, conn):
+        task = _existing_task(kb, conn, tid)
+        cur, st = task.assignee, task.status
+        _check(st not in ("done", "archived"), f"{tid} is {st}; use kanban_continue for follow-up work")
+        _check(st != "running", f"{tid} is running on {cur}; not interrupting the current owner")
+        _check(target != cur, f"{tid} is already assigned to {target}")
+        target_known = any(target in family for family in _ROLE_FAMILIES) or _profile_exists_in_reassign_fleet(target)
+        _check(target_known, f"unknown target role profile: {target}")
+        same_family = any(cur in family and target in family for family in _ROLE_FAMILIES)
+        _check(same_family or bool(reason),
+               f"cross-role reassignment {cur} -> {target} requires a reason explaining why the target role fits")
+        bots, status_error = _bot_status()
+        _check(status_error is None, status_error or "bot availability snapshot is unavailable")
+        if bots is not None:
+            info = bots.get(target)
+            info = info if isinstance(info, dict) else {}
+            _check(info.get("status") == "active",
+                   f"{target} is {info.get('status', 'unknown')} ({info.get('reason', '')}); pick an active bot")
+        _check(kb.reassign_task(conn, tid, target, reason=reason or "captain reassign",
+                                expected_assignment=(st, cur)),
+               f"could not reassign {tid}; task status or assignee may have changed")
+        unblocked = False
+        if st == "blocked" and bots is not None:
+            last = conn.execute(
+                "SELECT id, kind, payload FROM task_events WHERE task_id = ? AND kind NOT IN ('heartbeat','commented','assigned') "
+                "ORDER BY id DESC LIMIT 1", (tid,)).fetchone()
+            import re as _re
+            try:
+                failure = json.loads(last[2] or "{}") if last else None
+            except (ValueError, TypeError):
+                failure = None
+            if (last and last[1] in ("gave_up", "crashed", "timed_out")
+                    and isinstance(failure, dict) and not failure.get("sticky")
+                    and _re.search(_PROVIDER_FAIL_RE, last[2] or "", _re.I)):
+                unblocked = bool(kb.unblock_task(conn, tid, expected_last_event=last[0],
+                                               expected_assignee=target, protect_explicit_holds=True))
+        _board_note(kb, conn, tid, f"[reassign-done] {cur} -> {target}" + (f" ({reason})" if reason else "")
+                    + (" (unblocked)" if unblocked else ""))
+        current = kb.get_task(conn, tid)
+        return _ok(task_id=tid, previous=cur, assignee=current.assignee, unblocked=unblocked,
+                   **({"availability": "not_checked"} if bots is None else {}),
+                   **({"superseded": True} if current.assignee != target else {}), **_fields(current, ("status",)))
+
+
+@_kanban_handler("kanban_unlink")
+def _handle_unlink(args: dict, **kw) -> str:
+    _reject_delegated_child_mutation("kanban_unlink")
+    _require_orchestrator_tool("kanban_unlink")
+    pid, cid = str(args.get("parent_id") or "").strip(), str(args.get("child_id") or "").strip()
+    _check(pid and cid, "parent_id and child_id are required")
+    with _board(args.get("board")) as (kb, conn):
+        parent, child = _existing_task(kb, conn, pid), _existing_task(kb, conn, cid)
+        _check(cid in kb.child_ids(conn, pid), f"no link {pid} -> {cid}")
+        _check("GATE" not in (parent.title or "").upper() and parent.status != "blocked",
+               "parent is a gate/blocked card; unlinking would bypass it")
+        _check(child.status != "archived", "child is archived")
+        _check(kb.unlink_tasks(conn, pid, cid), f"could not unlink {pid} -> {cid}")
+        reason = str(args.get("reason") or "").strip()[:200]
+        _board_note(kb, conn, cid, f"[unlink-done] {pid} -> {cid} removed" + (f" ({reason})" if reason else ""))
+        return _ok(parent_id=pid, child_id=cid, **_fields(kb.get_task(conn, cid), ("status",)))
+
+
+@_kanban_handler("kanban_extend_runtime")
+def _handle_extend_runtime(args: dict, **kw) -> str:
+    _reject_delegated_child_mutation("kanban_extend_runtime")
+    _require_orchestrator_tool("kanban_extend_runtime")
+    tid = str(args.get("task_id") or "").strip()
+    secs = _opt_int(args.get("seconds"))
+    _check(tid and secs, "task_id and seconds are required")
+    with _board(args.get("board")) as (kb, conn):
+        task = _existing_task(kb, conn, tid)
+        cur = int(task.max_runtime_seconds or 0)
+        _check(task.status not in ("done", "archived"), f"{tid} is {task.status}")
+        _check(secs <= _EXTEND_CAP_SECONDS, f"cap is {_EXTEND_CAP_SECONDS} seconds; split the work instead")
+        _check(secs > cur, f"must exceed the current limit ({cur}s)")
+        times = conn.execute("SELECT COUNT(*) FROM task_comments WHERE task_id = ? AND body LIKE '[extend-done]%'", (tid,)).fetchone()[0]
+        _check(times < _EXTEND_MAX_TIMES, "already extended twice; split the remaining work into new cards")
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET max_runtime_seconds = ? WHERE id = ?", (secs, tid))
+        reason = str(args.get("reason") or "").strip()[:200]
+        _board_note(kb, conn, tid, f"[extend-done] max_runtime {cur}s -> {secs}s" + (f" ({reason})" if reason else ""))
+        return _ok(task_id=tid, previous_seconds=cur, max_runtime_seconds=secs)
+
+
+@_kanban_handler("kanban_continue")
+def _handle_continue(args: dict, **kw) -> str:
+    _reject_delegated_child_mutation("kanban_continue")
+    _require_orchestrator_tool("kanban_continue")
+    src = str(args.get("from_task_id") or "").strip()
+    remaining = _require_text(args, "remaining")
+    _check(src, "from_task_id is required")
+    with _board(args.get("board")) as (kb, conn):
+        parent = _existing_task(kb, conn, src)
+        _check(parent.status == "done", f"{src} is {parent.status}; continuation applies to DONE cards only")
+        assignee = str(args.get("assignee") or parent.assignee or "").strip()
+        _check(assignee, "assignee is required (parent has none)")
+        ev = conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND kind = 'completed' ORDER BY id DESC LIMIT 1", (src,)).fetchone()
+        summary = ""
+        if ev:
+            try:
+                summary = str((json.loads(ev[0] or "{}")).get("summary") or "")
+            except ValueError:
+                summary = ""
+        title = str(args.get("title") or "").strip() or f"ต่อ: {src} — {(parent.title or '')[:60]}"
+        body = (f"Continuation of {src} (DONE, not reopened; this is not a duplicate).\n\nRemaining work / acceptance:\n{remaining}\n\n"
+                f"Parent handoff summary (verify against evidence, do not trust blindly):\n{summary[:1500] or '(none)'}\n")
+        from gateway.session_context import get_session_env
+        from tools.async_delegation import _current_origin_session_id
+        session_id = (_persisted_session_id(_current_origin_session_id())
+                      or _persisted_session_id(get_session_env("HERMES_SESSION_ID", "")))
+        new_tid = kb.create_task(
+            conn, title=title, body=body, assignee=assignee, parents=(src,),
+            tenant=getattr(parent, "tenant", None), priority=int(getattr(parent, "priority", 0) or 0),
+            workspace_kind=args.get("workspace_kind"), workspace_path=args.get("workspace_path"), board=args.get("board"),
+            max_runtime_seconds=_opt_int(args.get("max_runtime_seconds")) or 1800,
+            created_by=_persisted_identity(), session_id=session_id)
+        return _ok(task_id=new_tid, parent=src, assignee=assignee,
+                   **_fields(kb.get_task(conn, new_tid), _CREATED_FIELDS), subscribed=_maybe_auto_subscribe(conn, new_tid))
+
