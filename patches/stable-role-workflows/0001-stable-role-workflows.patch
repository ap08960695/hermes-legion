+
+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    home = tmp_path / 'state'
+    home.mkdir()
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path / 'user')
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(tmp_path / 'board'))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    profile = home / 'profiles' / 'bounded-lane'
+    profile.mkdir(parents=True)
+    atomic_config_replace(profile / 'config.yaml', {'kanban': {'blocked_task_markers': ['confidential-fixture']}})
+    conn = kbc.connect()
+    yield conn, home, profile, tmp_path
+    conn.close()
+
+
+@pytest.mark.parametrize('field', ['title', 'body', 'tenant', 'workspace_path'])
+def test_confidential_task_cannot_claim_or_consume_a_run(world, field):
+    conn, _, _, root = world
+    args = {'title': 'Allowed task', 'body': 'Bounded fixture', 'assignee': 'bounded-lane'}
+    args[field] = str(root / 'CONFIDENTIAL-fixture') if field == 'workspace_path' else 'CONFIDENTIAL-fixture'
+    tid = kb.create_task(conn, **args)
+    with pytest.raises(ValueError, match='profile data boundary'):
+        kb.claim_task(conn, tid)
+    assert kb.get_task(conn, tid).status == 'ready'
+    assert kb.list_runs(conn, tid) == []
+
+
+def test_dispatch_blocks_the_same_task_without_spawning_or_retry(world):
+    from hermes_cli.kanban_task_contract import guard_dispatch
+
+    conn = world[0]
+    tid = kb.create_task(conn, title='Confidential-fixture task', assignee='bounded-lane')
+    row = conn.execute('SELECT * FROM tasks WHERE id=?', (tid,)).fetchone()
+    result = SimpleNamespace(respawn_guarded=[])
+    assert guard_dispatch(conn, row, 'bounded-lane', result, dry_run=False)
+    assert result.respawn_guarded and kb.get_task(conn, tid).status == 'blocked'
+    # Native capability blocks retain an administrative terminal run, without a claim or worker.
+    assert all(run.outcome == 'blocked' and run.claim_lock is None and run.worker_pid is None
+               for run in kb.list_runs(conn, tid))
+    assert conn.execute("SELECT count(*) FROM task_events WHERE task_id=? "
+                        "AND kind IN ('claimed','worker_started','worker_spawned')", (tid,)).fetchone()[0] == 0
+
+
+def test_lane_policy_uses_worker_profile_and_fails_closed_when_malformed(world):
+    conn, home, profile, _ = world
+    atomic_config_replace(home / 'config.yaml', {'kanban': {'blocked_task_markers': ['ordinary']}})
+    tid = kb.create_task(conn, title='ordinary allowed task', assignee='bounded-lane')
+    assert kb.claim_task(conn, tid) is not None
+    assert kb.complete_task(conn, tid, summary='Fixture complete', fire_lifecycle_hook=False)
+    atomic_config_replace(profile / 'config.yaml', {'kanban': {'blocked_task_markers': 'invalid'}})
+    other = kb.create_task(conn, title='another task', assignee='bounded-lane')
+    with pytest.raises(ValueError, match='invalid.*data boundary'):
+        kb.claim_task(conn, other)
+    assert kb.list_runs(conn, other) == []
