new file mode 100644
index 00000000..d8d83c1d
--- /dev/null
+++ b/hermes_cli/bot_workflow.py
@@ -0,0 +1,115 @@
+"""Role-specific bot pairing, stored beside each bot's existing model settings.
+
+These snapshots describe configuration, never provider readiness or available quota.
+Both native and standalone profile editors share this writer and its revision fence.
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+from pathlib import Path
+
+_FAMILIES = frozenset({'gpt', 'claude', 'agy', 'nim', 'web'})
+_FIELDS = frozenset({'role', 'mode', 'family', 'counterpart'})
+_ROLE = re.compile(r'[a-z][a-z0-9-]{0,63}\Z')
+
+
+def _profile_name(profile_dir: Path) -> str:
+    from hermes_constants import get_default_hermes_root, profile_name_for_home
+
+    name = profile_name_for_home(profile_dir)
+    if name is None and get_default_hermes_root(home=profile_dir) == profile_dir:
+        name = 'default'
+    if name is None:
+        raise ValueError('unknown profile identity')
+    return name
+
+
+def normalize_workflow(value: dict, profile_name: str) -> dict | None:
+    """An empty mapping clears pairing; reject unknown/ambiguous configuration."""
+    from hermes_cli.profiles import validate_profile_name
+
+    if not isinstance(value, dict) or set(value) - _FIELDS:
+        raise ValueError('workflow must contain only role, mode, family and counterpart')
+    if not value:
+        return None
+    if any(not isinstance(value.get(key), str) for key in _FIELDS):
+        raise ValueError('workflow fields must be strings')
+    cleaned = {key: value[key].strip() for key in sorted(_FIELDS)}
+    if not _ROLE.fullmatch(cleaned['role']):
+        raise ValueError('workflow role must be a lowercase role identifier')
+    if cleaned['mode'] not in ('think', 'action'):
+        raise ValueError('workflow mode must be think or action')
+    if cleaned['family'] not in _FAMILIES:
+        raise ValueError('workflow family must be gpt, claude, agy, nim or web')
+    counterpart = cleaned['counterpart']
+    if counterpart:
+        validate_profile_name(counterpart)
+        if counterpart == profile_name:
+            raise ValueError('a bot cannot be its own counterpart')
+    return cleaned
+
+
+def _editor_config(profile_dir: Path) -> tuple[dict, str]:
+    """Raw editor diagnostic: do not inherit another profile's role or expand secrets."""
+    from hermes_cli.config import require_readable_config_before_write
+
+    path = profile_dir / 'config.yaml'
+    raw = path.read_bytes() if path.is_file() else b''
+    config = require_readable_config_before_write(path)
+    return config, hashlib.sha256(raw).hexdigest()
+
+
+def _pair_status(profile_dir: Path, workflow: dict | None) -> str:
+    if workflow is None:
+        return 'unassigned'
+    name = workflow['counterpart']
+    if not name:
+        return 'missing'
+    from hermes_cli.profiles import get_profile_dir
+
+    other = Path(get_profile_dir(name, home=profile_dir))
+    if not other.is_dir():
+        return 'missing'
+    try:
+        config, _ = _editor_config(other)
+        peer = normalize_workflow(config.get('bot_workflow', {}), _profile_name(other))
+    except (OSError, ValueError):
+        return 'invalid'
+    if peer is None:
+        return 'one_way'
+    if peer['role'] != workflow['role'] or peer['mode'] == workflow['mode']:
+        return 'incompatible'
+    if peer['counterpart'] != _profile_name(profile_dir):
+        return 'one_way'
+    return 'linked'
+
+
+def workflow_snapshot(profile_dir: Path) -> dict:
+    """The saved role and reciprocal-link state, without loading a model or a session."""
+    config, revision = _editor_config(profile_dir)
+    try:
+        workflow = normalize_workflow(config.get('bot_workflow', {}), _profile_name(profile_dir))
+    except ValueError:
+        return {'workflow': None, 'revision': revision, 'pair_status': 'invalid'}
+    return {'workflow': workflow, 'revision': revision,
+            'pair_status': _pair_status(profile_dir, workflow)}
+
+
+def configure_workflow(profile_dir: Path, workflow: dict, expected_revision: str) -> dict:
+    """Save only this bot's role fields; never modify its peer, model, tools or quota."""
+    from hermes_cli.config import atomic_config_replace, atomic_config_write
+    from hermes_cli.config import _CONFIG_LOCK
+
+    cleaned = normalize_workflow(workflow, _profile_name(profile_dir))
+    with _CONFIG_LOCK:
+        config, revision = _editor_config(profile_dir)
+        if revision != expected_revision:
+            raise ValueError('profile configuration changed; reload before saving workflow')
+        if cleaned is None:
+            config.pop('bot_workflow', None)
+            atomic_config_replace(profile_dir / 'config.yaml', config)
+        else:
+            config['bot_workflow'] = cleaned
+            atomic_config_write(profile_dir / 'config.yaml', config)
+    return workflow_snapshot(profile_dir)
