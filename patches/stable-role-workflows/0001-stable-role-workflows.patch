+"""A successful native completion must not re-enter inference for status or a final summary."""
+import json
+import os
+from unittest.mock import MagicMock,patch
+
+import pytest
+from hermes_cli import kanban_db as kb,kanban_db_connect as kbc,kanban_db_dispatch as dispatch
+from tests.agent.test_run_agent import _mock_response,_mock_tool_call
+
+
+@pytest.fixture
+def owned_run(tmp_path,monkeypatch):
+    path=tmp_path/'board.db'
+    monkeypatch.setenv('HERMES_KANBAN_DB',str(path))
+    monkeypatch.setenv('HERMES_KANBAN_HOME',str(tmp_path))
+    monkeypatch.delenv('HERMES_DELEGATED_CHILD_CONTEXT',raising=False)
+    kb.init_db(path);conn=kbc.connect(path)
+    tid=kb.create_task(conn,title='offline terminal fixture',body='finish')
+    claimed=kb.claim_task(conn,tid)
+    dispatch._set_worker_pid(conn,tid,os.getpid())
+    for key,value in {'HERMES_KANBAN_TASK':tid,'HERMES_KANBAN_RUN_ID':str(claimed.current_run_id),'HERMES_KANBAN_CLAIM_LOCK':claimed.claim_lock}.items():monkeypatch.setenv(key,value)
+    yield conn,tid,claimed.current_run_id
+    conn.close()
+
+
+@pytest.fixture
+def agent():
+    from run_agent import AIAgent
+    with patch('model_tools.get_tool_definitions',return_value=[]),patch('model_tools.check_toolset_requirements',return_value={}),patch('agent.process_bootstrap.OpenAI'):
+        value=AIAgent(api_key='offline-test',base_url='https://offline.invalid/v1',quiet_mode=True,skip_context_files=True,skip_memory=True)
+    value.client=MagicMock();value._cached_system_prompt='Stable offline prompt';value._use_prompt_caching=False
+    value.tool_delay=0;value.compression_enabled=False;value.save_trajectories=False
+    value.valid_tool_names={'kanban_complete','kanban_show'}
+    return value
+
+
+def call(name,arguments,ident):
+    return _mock_response(content='',finish_reason='tool_calls',tool_calls=[_mock_tool_call(name=name,arguments=json.dumps(arguments),call_id=ident)])
+
+
+@pytest.mark.parametrize('max_iterations',[4,1])
+def test_native_complete_ends_loop_without_show_or_extra_model_call(agent,owned_run,max_iterations):
+    from tools.kanban_tools import _handle_complete
+    conn,tid,_run=owned_run;executed=[];agent.max_iterations=max_iterations
+    agent.client.chat.completions.create.side_effect=[call('kanban_complete',{'task_id':tid,'summary':'Verified fixture done.'},'done'),call('kanban_show',{'task_id':tid},'waste'),_mock_response(content='finished',finish_reason='stop')]
+    def tool(name,args,*unused,**kwargs):
+        executed.append(name)
+        return _handle_complete(args if isinstance(args,dict) else json.loads(args)) if name=='kanban_complete' else json.dumps({'status':'done'})
+    with patch.object(agent,'_persist_session'),patch.object(agent,'_save_trajectory'),patch.object(agent,'_cleanup_task_resources'),patch('model_tools.handle_function_call',side_effect=tool):
+        result=agent.run_conversation('Finish the owned task.')
+    assert kb.get_task(conn,tid).status=='done'
+    assert executed==['kanban_complete']
+    assert agent.client.chat.completions.create.call_count==1
+    assert result['completed'] is True and result['failed'] is False
+    assert result['final_response']=='Verified fixture done.'
+    assert result['messages'][-1]['role']=='assistant'
+
+
+def success_message(tid,run,**extra):
+    return {'role':'tool','name':'kanban_complete','content':json.dumps({'ok':True,'task_id':tid,'run_id':run,**extra})}
+
+
+def complete_fixture(owned_run):
+    conn,tid,run=owned_run
+    assert kb.complete_task(conn,tid,summary='Verified fixture done.',expected_run_id=run)
+    return conn,tid,run
+
+
+@pytest.mark.parametrize('case',['running','failed_result','wrong_task','wrong_run','wrong_lock','wrong_pid','missing_db','bad_fingerprint','not_worker','malformed'])
+def test_uncertain_or_foreign_completion_never_stops(owned_run,monkeypatch,tmp_path,case):
+    from agent.kanban_terminal_stop import completed_worker_summary
+    conn,tid,run=owned_run
+    if case!='running':complete_fixture(owned_run)
+    message=success_message(tid,run)
+    def update_run(field,value):
+        with kb.write_txn(conn):conn.execute(f'UPDATE task_runs SET {field}=? WHERE id=?',(value,run))
+    mutations={
+        'failed_result':lambda:message.update(content=json.dumps({'ok':False,'task_id':tid,'run_id':run})),
+        'wrong_task':lambda:message.update(success_message('t_foreign',run)),
+        'wrong_run':lambda:message.update(success_message(tid,run+1)),
+        'wrong_lock':lambda:monkeypatch.setenv('HERMES_KANBAN_CLAIM_LOCK','not-the-owned-lock'),
+        'wrong_pid':lambda:update_run('worker_pid',os.getpid()+1),
+        'missing_db':lambda:monkeypatch.setenv('HERMES_KANBAN_DB',str(tmp_path/'absent.db')),
+        'bad_fingerprint':lambda:update_run('worker_started_at','unverified'),
+        'not_worker':lambda:monkeypatch.delenv('HERMES_KANBAN_TASK'),
+        'malformed':lambda:message.update(content='not-json'),
+    }
+    mutations.get(case,lambda:None)()
+    assert completed_worker_summary([message]) is None
+    assert not (tmp_path/'absent.db').exists()
+
+
+def test_children_cron_and_review_handoff_keep_their_own_loop(owned_run):
+    from agent.kanban_terminal_stop import completed_worker_summary
+    from agent.delegation_context import delegated_child_context,non_dispatcher_owned_context
+    _,tid,run=complete_fixture(owned_run);message=success_message(tid,run)
+    for context in (delegated_child_context(),non_dispatcher_owned_context()):
+        with context:assert completed_worker_summary([message]) is None
+    message['name']='kanban_request_review'
+    assert completed_worker_summary([message]) is None
+
+
+def test_rejected_completion_allows_correction_then_stops(agent,owned_run):
+    from tools.kanban_tools import _handle_complete
+    conn,tid,_run=owned_run;calls=[]
+    agent.client.chat.completions.create.side_effect=[call('kanban_complete',{'task_id':tid,'summary':''},'rejected'),call('kanban_complete',{'task_id':tid,'summary':'Corrected verified result.'},'done'),_mock_response(content='unexpected continuation',finish_reason='stop')]
+    def tool(name,args,*unused,**kwargs):
+        calls.append(name);return _handle_complete(args if isinstance(args,dict) else json.loads(args))
+    with patch.object(agent,'_persist_session'),patch.object(agent,'_save_trajectory'),patch.object(agent,'_cleanup_task_resources'),patch('model_tools.handle_function_call',side_effect=tool):
+        result=agent.run_conversation('Finish the owned task.')
+    assert agent.client.chat.completions.create.call_count==2 and len(calls)==2
+    assert result['completed'] is True and result['final_response']=='Corrected verified result.'
+    assert kb.get_task(conn,tid).status=='done'
+
+
+def test_completion_at_iteration_checkpoint_does_not_request_another_model_turn(agent,owned_run):
+    """A budget notice must not corrupt the successful native completion result."""
+    from tools.kanban_tools import _handle_complete
+    conn,tid,_run=owned_run;agent.max_iterations=4;executed=[]
+    agent.client.chat.completions.create.side_effect=[
+        call('kanban_show',{'task_id':tid},'show-1'),
+        call('kanban_show',{'task_id':tid},'show-2'),
+        call('kanban_complete',{'task_id':tid,'summary':'Verified checkpoint result.'},'done'),
+        call('kanban_show',{'task_id':tid},'unexpected'),
+        _mock_response(content='unexpected model call',finish_reason='stop'),
+    ]
+    def tool(name,args,*unused,**kwargs):
+        executed.append(name)
+        if name=='kanban_complete':
+            # Place the real completion exactly on the checkpoint boundary.
+            agent.iteration_budget._used=3
+            agent._iteration_budget_warning_injected=False
+        return _handle_complete(args if isinstance(args,dict) else json.loads(args)) if name=='kanban_complete' else json.dumps({'status':'running'})
+    with patch.object(agent,'_persist_session'),patch.object(agent,'_save_trajectory'),patch.object(agent,'_cleanup_task_resources'),patch('model_tools.handle_function_call',side_effect=tool):
+        result=agent.run_conversation('Finish the owned task.')
+    assert kb.get_task(conn,tid).status=='done'
+    assert executed==['kanban_show','kanban_show','kanban_complete']
+    assert agent.client.chat.completions.create.call_count==3
+    assert result['completed'] is True and result['final_response']=='Verified checkpoint result.'
+
+
+@pytest.mark.parametrize('notice',['iteration','wallclock'])
+def test_verified_completion_result_is_not_modified_by_budget_notices(agent,owned_run,notice):
+    import time
+    from agent.iteration_budget import IterationBudget
+    from agent.tool_executor import _flush_session_db_after_tool_progress
+    _,tid,run=complete_fixture(owned_run);message=success_message(tid,run);original=message['content']
