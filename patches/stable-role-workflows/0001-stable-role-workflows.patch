+"""Native role handoffs, idempotency and review: isolated SQLite, zero inference."""
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli.bot_workflow import configure_workflow, workflow_snapshot
+
+
+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path / 'user')
+    home = tmp_path / 'state'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(tmp_path / 'board'))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    for name, mode, peer in [('developer-think', 'think', 'developer-action'),
+                             ('developer-action', 'action', 'developer-think')]:
+        root = home / 'profiles' / name
+        root.mkdir(parents=True)
+        (root / 'config.yaml').write_text('model:\n  default: offline-only\nfallback_providers: []\n')
+        configure_workflow(root, {'role': 'developer', 'mode': mode, 'family': 'gpt',
+                                  'counterpart': peer}, workflow_snapshot(root)['revision'])
+    conn = kbc.connect()
+    yield conn, home, tmp_path
+    conn.close()
+
+
+def create(world, assignee, body='bounded offline task'):
+    conn, _, root = world
+    return kb.create_task(conn, title='native role fixture', assignee=assignee,
+                          body=body, workspace_kind='dir', workspace_path=str(root))
+
+
+def plan():
+    return {'version': 1, 'role': 'developer', 'constraints': ['No model calls; no paid fallback'],
+            'steps': [{'id': 'code', 'instructions': 'Write the deterministic fixture.',
+                       'acceptance': ['Offline unit test passes'], 'write_scope': ['src/a.py']},
+                      {'id': 'docs', 'instructions': 'Document the fixture.',
+                       'acceptance': ['Document matches implementation'], 'write_scope': ['docs/a.md']}]}
+
+
+def finish_plan(world, value=None):
+    conn = world[0]
+    tid = create(world, 'developer-think')
+    run = kb.claim_task(conn, tid)
+    assert kb.complete_task(conn, tid, summary='Plan ready', metadata={'role_plan': value or plan()},
+                            expected_run_id=run.current_run_id, fire_lifecycle_hook=False)
+    return tid, run.current_run_id
+
+
+def action(world, parent, step='code', **kwargs):
+    from tools import kanban_tools as kt
+    result = json.loads(kt._handle_create({'title': 'Execute planned step',
+                         'assignee': 'developer-action', 'plan_task': parent, 'plan_step': step,
+                         'workspace_kind': 'dir', 'workspace_path': str(world[2]), **kwargs}))
+    assert result.get('ok'), result
+    return result['task_id']
+
+
+def test_think_cannot_complete_without_durable_plan(world):
+    conn = world[0]
+    tid = create(world, 'developer-think')
+    run = kb.claim_task(conn, tid)
+    with pytest.raises(ValueError, match='role_plan'):
+        kb.complete_task(conn, tid, summary='trust me', expected_run_id=run.current_run_id)
+    assert kb.get_task(conn, tid).status == 'running'
+
