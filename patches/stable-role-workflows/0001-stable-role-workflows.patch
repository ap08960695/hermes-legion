@@ -0,0 +1,50 @@
+"""Authenticated native bot-workflow editing; does not activate a bot or a model."""
+import asyncio
+from functools import partial
+from pathlib import Path
+
+from hermes_state_runtime import RuntimeStoreError
+
+
+def _profile(connection, params, *, write):
+    from hermes_cli.profiles import get_profile_dir
+
+    capability = 'session:control' if write else 'session:read'
+    if capability not in connection.actor.capabilities:
+        raise RuntimeStoreError('permission_denied')
+    try:
+        profile = get_profile_dir(params['name'], home=connection.authority.profile_id)
+    except ValueError as exc:
+        raise RuntimeStoreError('invalid_params', field='name') from exc
+    if not connection.host_scoped and profile.resolve() != Path(connection.authority.profile_id).resolve():
+        raise RuntimeStoreError('profile_mismatch')
+    if not profile.is_dir():
+        raise RuntimeStoreError('not_found', field='name')
+    return profile
+
+
+def _write(profile, params):
+    from hermes_cli.bot_settings import configure_settings
+
+    try:
+        return configure_settings(profile, params.get('workflow') or {}, params['expected_revision'],
+                                  model=params.get('model'), confirm=params.get('confirm', False))
+    except ValueError as exc:
+        raise RuntimeStoreError('invalid_params', field='workflow', detail=str(exc)) from exc
+
+
+async def _get(connection, _ref, params):
+    from hermes_cli.bot_settings import settings_snapshot
+
+    profile = _profile(connection, params, write=False)
+    return await asyncio.to_thread(settings_snapshot, profile)
+
+
+async def _configure(connection, _ref, params):
+    profile = _profile(connection, params, write=True)
+    return await asyncio.to_thread(_write, profile, params)
+
+
+def handlers(connection):
+    return {'profiles.workflow.get': partial(_get, connection),
+            'profiles.workflow.configure': partial(_configure, connection)}
