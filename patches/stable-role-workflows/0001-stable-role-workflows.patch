+# Local patch 28: a card naming a skill the assignee does not have makes every worker spawn die with
+# "Unknown skill(s)" until the card blocks (6 crashed runs on 2026-10-08/09). Drop such names at create time.
+def _skills_available_for(profile: str, skills):
+    """(kept, dropped). A skill counts as installed when <name>/SKILL.md exists under the assignee's skills dir,
+    its configured external_dirs, or the bundled skills tree. Unknown profile -> keep everything (fail open)."""
+    if not skills or not profile:
+        return skills, []
+    from pathlib import Path
+    root = Path(os.environ.get("HERMES_ROOT") or Path.home() / ".hermes")
+    home = root / "profiles" / profile
+    if not home.is_dir():
+        return skills, []
+    dirs = [home / "skills", Path(__file__).resolve().parent.parent / "skills"]
+    try:
+        import yaml as _yaml   # PyYAML is a core dependency
+        cfg = _yaml.safe_load((home / "config.yaml").read_text()) or {}
+        dirs += [Path(os.path.expanduser(str(d))) for d in ((cfg.get("skills") or {}).get("external_dirs") or [])]
+    except Exception:
+        pass
+    have = set()
+    for d in dirs:
+        for dirpath, _dirs, files in os.walk(d, followlinks=True):   # shared skill dirs are often symlinks
+            if "SKILL.md" in files:
+                have.add(os.path.basename(dirpath))
+    kept = [s for s in skills if str(s).rstrip("/").split("/")[-1] in have]
+    return kept, [s for s in skills if s not in kept]
