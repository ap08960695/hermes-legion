+def _bot_status() -> tuple[Optional[dict], Optional[str]]:
+    """Return the owning fleet's fresh bots map, or an explicit unknown state.
+
+    A missing file preserves the optional legacy integration (None, None).
+    An existing unreadable, malformed, future or stale snapshot is not evidence
+    that any bot is currently available and must not authorize reassignment.
+    """
+    error = "bot availability snapshot is unreadable or invalid"
+    try:
+        root = _reassign_fleet_root()
+        root_before = root.stat()
+        path = root / "bot-status.json"
+        try:
+            path.lstat()  # A dangling link is configured but unavailable.
+        except FileNotFoundError:
+            root_after = root.stat()
+            if (root_before.st_dev, root_before.st_ino) != (root_after.st_dev, root_after.st_ino):
+                return None, error
+            return None, None
+        with path.open(encoding="utf-8") as fh:
+            snapshot = json.load(fh)
+    except (OSError, ValueError, TypeError, RuntimeError):
+        # Includes a snapshot that disappeared between inspection and open.
+        return None, error
+    if not isinstance(snapshot, dict) or not isinstance(snapshot.get("bots"), dict):
+        return None, "bot availability snapshot is invalid"
+    updated = snapshot.get("updated")
+    try:
+        fresh = (not isinstance(updated, bool) and isinstance(updated, (int, float))
+                 and math.isfinite(updated) and 0 <= time.time() - updated <= _BOT_STATUS_MAX_AGE_SECONDS)
+    except OverflowError:
+        fresh = False
+    if not fresh:
+        return None, "bot availability snapshot is stale or has an invalid timestamp"
+    return snapshot["bots"], None
