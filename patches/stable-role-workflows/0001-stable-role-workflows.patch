diff --git a/hermes_cli/kanban_attempt_evidence.py b/hermes_cli/kanban_attempt_evidence.py
new file mode 100644
index 00000000..d49ba256
--- /dev/null
+++ b/hermes_cli/kanban_attempt_evidence.py
@@ -0,0 +1,92 @@
+"""Explain native attempts without changing retries, gates or authorization."""
+
+def classify_attempt(lane, previous, transition=None):
+    reason = 'unknown'
+    outcome = previous.get('outcome') if previous else None
+    if previous is None:
+        reason = 'initial'
+    elif transition in {'changes_requested', 'reopened', 'review_reopened'}:
+        reason = {'changes_requested': 'revision', 'reopened': 'reopened',
+                  'review_reopened': 'review_reopened'}[transition]
+    elif lane == 'review' and outcome == 'review_requested':
+        reason = 'review_handoff'
+    elif outcome == 'rate_limited':
+        reason = 'quota_retry'
+    elif outcome in {'crashed', 'timed_out', 'reclaimed', 'spawn_failed', 'protocol_violation'}:
+        reason = 'recovery'
+    return {'reason': reason, 'previous_run_id': previous['id'] if previous else None,
+            'previous_outcome': outcome, 'authorization_inferred': False}
+
+
+def claim_evidence(conn, task_id, lane, run_id):
+    previous = conn.execute('SELECT id,outcome FROM task_runs WHERE task_id=? AND id<? '
+                            'ORDER BY id DESC LIMIT 1', (task_id, run_id)).fetchone()
+    transition = None
+    current = conn.execute("SELECT id FROM task_events WHERE task_id=? AND run_id=? AND kind='claimed' ORDER BY id DESC LIMIT 1", (task_id, run_id)).fetchone()
+    upper = current['id'] if current else 9223372036854775807
+    if previous:
+        # Only explicit transitions since the previous claim are evidence. Comments do not authorize work.
+        claim = conn.execute("SELECT id FROM task_events WHERE task_id=? AND kind='claimed' AND run_id=? "
+                             'ORDER BY id DESC LIMIT 1', (task_id, previous['id'])).fetchone()
+        if claim:
+            event = conn.execute("SELECT kind FROM task_events WHERE task_id=? AND id>? AND id<? "
+                                 "AND kind IN ('changes_requested','reopened','review_reopened') "
+                                 'ORDER BY id DESC LIMIT 1', (task_id, claim['id'], upper)).fetchone()
+            transition = event['kind'] if event else None
+    return classify_attempt(lane, dict(previous) if previous else None, transition)
+
+
+def claim_and_open_run(
+    conn, task_id: str, source_status: str, lock: str, expires: int, now: int,
+    *, event_extra: dict | None = None,
+) -> int | None:
+    """CAS ``source_status -> running``, open a run row, emit ``claimed``; None
+    when the CAS lost. Caller holds the txn."""
+    from hermes_cli import kanban_db as kb
+    task = kb.get_task(conn, task_id)
+    if task and task.status == source_status and task.claim_lock is None:
+        from hermes_cli.kanban_role_flow import validate_task
+        validate_task(conn, task)
+    cur = conn.execute(
+        f"""
+        UPDATE tasks
+           SET status        = 'running',
+               claim_lock    = ?,
+               claim_expires = ?,
+               started_at    = COALESCE(started_at, ?)
+         WHERE id = ?
+           AND status = '{source_status}'
+           AND claim_lock IS NULL
+        """,
+        (lock, expires, now, task_id),
+    )
+    if cur.rowcount != 1:
+        return None
+    trow = conn.execute(
+        "SELECT assignee, max_runtime_seconds, current_step_key "
+        "FROM tasks WHERE id = ?", (task_id,),
+    ).fetchone()
+    run_cur = conn.execute(
+        """
+        INSERT INTO task_runs (
+            task_id, profile, step_key, status,
+            claim_lock, claim_expires, max_runtime_seconds,
+            started_at
+        ) VALUES (?, ?, ?, 'running', ?, ?, ?, ?)
+        """,
+        (
+            task_id, trow["assignee"] if trow else None, trow["current_step_key"] if trow else None,
+            lock, expires, trow["max_runtime_seconds"] if trow else None, now,
+        ),
+    )
+    run_id = run_cur.lastrowid
+    attempt = claim_evidence(conn, task_id, source_status, run_id)
+    from hermes_cli.kanban_run_inputs import brief_pin
+    pin = brief_pin(conn, task_id)
+    conn.execute("UPDATE tasks SET current_run_id = ? WHERE id = ?", (run_id, task_id))
+    kb._append_event(
+        conn, task_id, "claimed",
+        {"lock": lock, "expires": expires, "run_id": run_id, "attempt": attempt, **(event_extra or {}), "brief_pin": pin}, run_id=run_id,
+    )
+    return run_id
+
