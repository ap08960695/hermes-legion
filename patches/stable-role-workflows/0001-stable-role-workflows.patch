+# local patch 05: an orchestrator calling kanban_show on a long-lived card used to receive 25-140k chars
+# (all comments, all runs, worker_context). Orchestrators now get a compact view unless full=true.
+_SHOW_COMPACT_COMMENTS, _SHOW_COMPACT_COMMENT_CHARS = 12, 1200
+_SHOW_COMPACT_EVENTS, _SHOW_COMPACT_RUNS = 15, 3
+
+
+def _compact_show_payload(payload: dict) -> dict:
+    """Trim a kanban_show payload for orchestrator reading. Pure function (selfcheck-able)."""
+    out = dict(payload)
+    comments = list(out.get("comments") or [])
+    total = len(comments)
+    kept = []
+    for c in comments[-_SHOW_COMPACT_COMMENTS:]:
+        c = dict(c)
+        body = c.get("body")
+        if isinstance(body, str) and len(body) > _SHOW_COMPACT_COMMENT_CHARS:
+            c["body"] = body[:_SHOW_COMPACT_COMMENT_CHARS] + f"... [truncated {len(body) - _SHOW_COMPACT_COMMENT_CHARS} chars]"
+        kept.append(c)
+    out["comments"] = kept
+    events = [e for e in (out.get("events") or []) if (e or {}).get("kind") != "heartbeat"]
+    out["events"] = events[-_SHOW_COMPACT_EVENTS:]
+    runs = list(out.get("runs") or [])
+    out["runs"] = runs[-_SHOW_COMPACT_RUNS:]
+    out.pop("worker_context", None)
+    out["compact_view"] = {
+        "comments_total": total, "comments_shown": len(kept),
+        "runs_total": len(runs), "runs_shown": len(out["runs"]),
+        "note": "Compact orchestrator view (latest items only). Call kanban_show(task_id, full=true) only if you truly need the full history.",
+    }
+    return out
+
+
+def _summary_show_payload(payload: dict) -> dict:
+    """Ultra-compact status view (summary=true): one screen per card instead of a history dump. Pure function."""
+    task = dict(payload.get("task") or {})
+    keep = {k: task.get(k) for k in ("id", "title", "status", "assignee", "max_runtime_seconds", "workspace_kind", "workspace_path", "priority") if k in task}
+    comments = list(payload.get("comments") or [])[-3:]
+    events = [e for e in (payload.get("events") or []) if (e or {}).get("kind") not in ("heartbeat", "commented")]
+    last_fail = next((e for e in reversed(events) if e.get("kind") in ("gave_up", "crashed", "timed_out", "blocked")), None)
+    last_done = next((e for e in reversed(events) if e.get("kind") == "completed"), None)
+    def clip(v, n):
+        v = v if isinstance(v, str) else json.dumps(v, ensure_ascii=False, default=str)
+        return v if len(v) <= n else v[:n] + "..."
+    return {
+        "task": keep, "parents": payload.get("parents"), "children": payload.get("children"),
+        "unsatisfied_parents": payload.get("unsatisfied_parents"),
+        "last_comments": [{"author": c.get("author"), "body": clip(c.get("body") or "", 300)} for c in comments],
+        "last_failure": ({"kind": last_fail.get("kind"), "payload": clip(last_fail.get("payload"), 400)} if last_fail else None),
+        "last_completion": ({"payload": clip(last_done.get("payload"), 700)} if last_done else None),
+        "runs": len(payload.get("runs") or []),
+        "note": "summary view; call kanban_show(task_id) for the compact history or full=true for everything.",
+    }
+
+
+# local patch 06: default max_runtime by card type, and an oversize hint at create time.
+def _default_runtime_seconds(assignee: str, title: str, body: str) -> int:
+    a, text = (assignee or "").lower(), f"{title or ''} {body or ''}".lower()
+    heavy = any(k in text for k in ("candidate", "รีวิว", "review", "qa", "ทดสอบ", "visual", "contract", "สัญญา", "e2e", "deploy"))
+    if a.startswith(("reviewer", "tester")) or a == "antigravity":
+        return 1800
+    if a.startswith(("developer", "devops")):
+        return 1800
+    if a.startswith(("analyst", "researcher")):
+        return 1800 if heavy else 1200
+    return 1800 if heavy else 1200
+
