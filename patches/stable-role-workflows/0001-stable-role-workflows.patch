--- /dev/null
+++ b/hermes_cli/kanban_completion_advisory.py
@@ -0,0 +1,29 @@
+"""Advisory completion checks. No lifecycle denial, model judge or evidence promotion."""
+
+_PLACEHOLDERS = {'tbd', 'todo', 'pending', 'not run', 'not_run', 'n/a'}
+
+
+def annotate(metadata, summary=None):
+    source = metadata if isinstance(metadata, dict) else {}
+    warnings = []
+    if isinstance(summary, str) and summary.strip().lower() in _PLACEHOLDERS:
+        warnings.append('placeholder_completion_summary')
+    verification = source.get('verification')
+    if isinstance(verification, dict):
+        status = verification.get('status')
+        if status in {'prepared', 'not_run', 'planned'}:
+            warnings.append('verification_not_observed')
+        checks = verification.get('checks')
+        if isinstance(checks, list):
+            for check in checks[:32]:
+                if not isinstance(check, dict):
+                    continue
+                if check.get('status') == 'skipped' and not check.get('reason'):
+                    warnings.append('skipped_check_without_reason')
+                if isinstance(check.get('log'), str) and check['log'].strip().lower() in _PLACEHOLDERS:
+                    warnings.append('placeholder_evidence_reference')
+    if not warnings:
+        return metadata
+    return {**source, 'completion_advisory': {'version': 1, 'warnings': sorted(set(warnings)),
+            'mode': 'advisory', 'verified': False,
+            'note': 'Review declared evidence; this check neither verifies execution nor changes existing gates.'}}
