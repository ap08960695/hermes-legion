+"""Native three-profile role loop; only the HTTP model peer is scripted locally."""
+from collections import Counter
+from contextlib import closing
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import threading
+
+from local_recovery_probe import daemon
+
+
+PLAN = {'version': 1, 'role': 'developer', 'constraints': ['Only the synthetic workspace may change.'],
+        'steps': [{'id': 'result', 'instructions': 'Write result.json with sum 5 and read it back.',
+                   'acceptance': ['The artifact is valid JSON with sum equal to 5.'],
+                   'write_scope': ['result.json']}]}
+
+
+def response_tool(name, arguments, index):
+    return {'role': 'assistant', 'content': None, 'tool_calls': [{'index': 0, 'id': f'call-{index}',
+        'type': 'function', 'function': {'name': name, 'arguments': json.dumps(arguments)}}]}
+
+
+class Model(BaseHTTPRequestHandler):
+    def log_message(self, *_args):
+        pass
+
+    def do_POST(self):
+        body = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
+        model = body.get('model')
+        if body.get('messages'):
+            self.server.requests.append(body)
+        calls = sum(r.get('model') == model for r in self.server.requests) - 1
+        sequence = {
+            'role-think': [('kanban_complete', {'summary': 'Bounded plan ready', 'metadata': {'role_plan': PLAN}})],
+            'role-action': [('write_file', {'path': 'result.json', 'content': '{"sum":5}\n'}),
+                            ('read_file', {'path': 'result.json'}),
+                            ('kanban_request_review', {'summary': 'Written and read back', 'reviewer': 'role-reviewer'})],
+            'role-review': [('read_file', {'path': 'result.json'}),
+                            ('kanban_complete', {'summary': 'Independent artifact review passed'})],
+        }.get(model, [])
+        if calls < len(sequence):
+            name, arguments = sequence[calls]
+            message, finish = response_tool(name, arguments, calls), 'tool_calls'
+        else:
+            message, finish = {'role': 'assistant', 'content': 'Unexpected extra turn'}, 'stop'
+        payload = json.dumps({'id': 'role-fixture', 'choices': [
+            {'index': 0, 'message': message, 'finish_reason': finish}],
+            'usage': {'prompt_tokens': 10, 'completion_tokens': 5, 'total_tokens': 15}}).encode()
+        kind = 'application/json'
+        if body.get('stream'):
+            payload = ('data: ' + json.dumps({'id': 'role-fixture', 'choices': [
+                {'index': 0, 'delta': message, 'finish_reason': finish}]}) + '\n\ndata: [DONE]\n\n').encode()
+            kind = 'text/event-stream'
+        self.send_response(200)
+        self.send_header('Content-Type', kind)
+        self.send_header('Content-Length', str(len(payload)))
+        self.end_headers()
+        self.wfile.write(payload)
+
+
+def configure(home, url):
+    from hermes_cli.config import atomic_config_write
+
+    base = {'gateway': {'multiplex_profiles': True},
+            'model': {'provider': 'custom', 'default': 'no-default-turn', 'base_url': url, 'api_key': 'loopback-only'},
+            'platform_toolsets': {'cli': ['file', 'kanban']}, 'terminal': {'backend': 'local'},
+            'agent': {'api_max_retries': 0, 'max_turns': 5}, 'fallback_providers': [],
+            'auxiliary': {'title_generation': {'enabled': False}}, 'kanban': {'dispatch_in_gateway': False}}
+    atomic_config_write(home / 'config.yaml', base)
+    for name, model, mode, peer in [('role-thinker', 'role-think', 'think', 'role-actor'),
+                                    ('role-actor', 'role-action', 'action', 'role-thinker'),
+                                    ('role-reviewer', 'role-review', None, None)]:
+        path = home / 'profiles' / name
+        path.mkdir(parents=True)
+        cfg = {**base, 'model': {**base['model'], 'default': model}}
+        if mode:
+            cfg['bot_workflow'] = {'role': 'developer', 'mode': mode, 'family': 'gpt', 'counterpart': peer}
+        atomic_config_write(path / 'config.yaml', cfg)
+        if mode is None:
+            skill = path / 'skills' / 'sdlc-review'
+            skill.mkdir(parents=True)
+            (skill / 'SKILL.md').write_text('---\nname: sdlc-review\ndescription: Synthetic review\n---\nRead the artifact and verify its sum.\n')
+
+
+def run_step(conn, task_id, children):
+    from hermes_cli import kanban_db as kb, kanban_db_dispatch as dispatch
+    from gateway.session_kanban import worker_result
+
+    before = len(children)
+    launched = dispatch.dispatch_once(conn, board='roles', max_spawn=1, max_in_progress=1,
+                                       failure_limit=1, reconcile_orphans=False)
+    assert [row[0] for row in launched.spawned] == [task_id], launched
+    assert len(children) == before + 1
+    task = kb.get_task(conn, task_id)
+    params = {'task_id': task_id, 'run_id': task.current_run_id, 'claim_lock': task.claim_lock}
+    child = children[-1]
+    assert child.wait(timeout=65) == 0, f'Worker failed: {task_id}'
+    result = worker_result(kb.kanban_db_path(board='roles'), params)
+    assert result.get('exit_code') == 0, result
+    run = kb.get_run(conn, params['run_id'])
+    assert run.ended_at and run.outcome in ('completed', 'review_requested'), run
+    return {'task': task_id, 'run': run.id, 'profile': run.profile, 'outcome': run.outcome}
+
+
+def main():
+    root = Path(__file__).resolve().parents[3]
+    home = Path(os.environ['HERMES_HOME'])
+    home.mkdir(parents=True)
+    Path(os.environ['HOME']).mkdir(parents=True)
+    os.environ['HERMES_KANBAN_HOME'] = str(home)
+    os.environ['HERMES_KANBAN_BOARD'] = 'roles'
+    peer = ThreadingHTTPServer(('127.0.0.1', 0), Model)
+    peer.requests = []
+    threading.Thread(target=peer.serve_forever, daemon=True).start()
+    configure(home, f'http://127.0.0.1:{peer.server_port}/v1')
+    from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+    from hermes_cli.kanban_role_create import create_planned_task
+    with closing(kbc.connect(board='default')):
+        pass  # The native capacity guard requires every registered board to be readable.
+    kb.create_board('roles')
+    workspace = home / 'workspace'
+    workspace.mkdir()
+    children, receipt = [], {'external_model_calls': 0, 'runs': []}
+    original = subprocess.Popen
+
+    def spawn(*args, **kwargs):
+        child = original(*args, **kwargs)
+        if 'hermes_cli.kanban_worker_client' in args[0]:
+            children.append(child)
+        return child
+
+    try:
+        with daemon(root, home, dict(os.environ), barrier=False), closing(kbc.connect(board='roles')) as conn:
+            subprocess.Popen = spawn
+            think = kb.create_task(conn, title='Plan synthetic result', body='Plan only. Produce the bounded role plan.',
+                                   assignee='role-thinker', workspace_kind='dir', workspace_path=str(workspace),
+                                   max_retries=0, max_runtime_seconds=60)
+            receipt['runs'].append(run_step(conn, think, children))
+            assert kb.get_task(conn, think).status == 'done'
+            assert not (workspace / 'result.json').exists()
+            args = {'title': 'Execute result step', 'assignee': 'role-actor', 'plan_task': think,
+                    'plan_step': 'result', 'workspace_kind': 'dir', 'workspace_path': str(workspace),
+                    'max_retries': 0, 'max_runtime_seconds': 60}
+            action = create_planned_task(conn, **args)
+            assert create_planned_task(conn, **args) == action
+            receipt['runs'].append(run_step(conn, action, children))
+            assert kb.get_task(conn, action).status == 'review'
+            receipt['runs'].append(run_step(conn, action, children))
+            assert kb.get_task(conn, action).status == 'done'
+            assert json.loads((workspace / 'result.json').read_text()) == {'sum': 5}
+            assert create_planned_task(conn, **args) == action
+            receipt['wire_calls'] = dict(Counter(r.get('model') for r in peer.requests))
+            receipt['done'] = True
+            assert receipt['wire_calls'] == {'role-think': 1, 'role-action': 3, 'role-review': 2}, receipt
+    finally:
+        subprocess.Popen = original
+        for child in children:
+            if child.poll() is None:
+                child.kill()
+            child.wait(timeout=10)
+        peer.shutdown()
+        peer.server_close()
+        (home / 'receipt.json').write_text(json.dumps(receipt, indent=2))
+        (home / 'fixture-wire.json').write_text(json.dumps(peer.requests, indent=2))
+        print(json.dumps(receipt))
+
+
+if __name__ == '__main__':
+    main()
