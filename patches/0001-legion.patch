@@ -0,0 +1,104 @@
+"""Native keyring quota is independent of stale legacy token files and never a model turn."""
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+import pytest
+from hermes_cli import account_usage_native_agy as agy
+
+
+def receipt(**overrides):
+    row = dict(
+        status="SUCCESS",
+        num_turns=0,
+        usage=dict(total_tokens=0),
+        command=dict(
+            name="usage",
+            data=dict(
+                groups=[
+                    dict(
+                        name="Gemini",
+                        buckets=[
+                            dict(window="weekly", remaining_fraction=0.75),
+                            dict(window="5h", remaining_fraction=1, disabled=True),
+                        ],
+                    )
+                ]
+            ),
+        ),
+    )
+    return json.dumps(row | overrides)
+
+
+def test_native_mode_uses_real_home_keyring_not_legacy_token(tmp_path, monkeypatch):
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("DBUS_SESSION_BUS_ADDRESS", "fixture-bus")
+    monkeypatch.setenv("GEMINI_API_KEY", "must-not-be-forwarded")
+    calls = []
+
+    def runner(args, **kw):
+        calls.append((args, kw))
+        return SimpleNamespace(returncode=0, stdout=receipt())
+
+    row = agy.collect_native(
+        dict(
+            id="agy",
+            label="AGY",
+            command="/fixture/agy",
+            token_file="/expired/must-not-read",
+        ),
+        runner=runner,
+    )
+    assert row["windows"][0]["used_percent"] == 25 and len(row["windows"]) == 1
+    assert calls[0][0] == ["/fixture/agy", "-p", "/usage", "--output-format", "json"]
+    assert calls[0][1]["env"]["HOME"] == str(tmp_path)
+    assert calls[0][1]["env"]["DBUS_SESSION_BUS_ADDRESS"] == "fixture-bus"
+    assert "GEMINI_API_KEY" not in calls[0][1]["env"]
+    assert not Path(calls[0][1]["cwd"]).exists()
+
+
+@pytest.mark.parametrize(
+    "change",
+    [
+        dict(num_turns=1),
+        dict(command=dict(name="prompt")),
+        dict(usage=dict(total_tokens=1)),
+        dict(status="ERROR"),
+    ],
+)
+def test_refuses_non_metadata_receipts(change):
+    with pytest.raises(ValueError):
+        agy.parse_native_usage(receipt(**change))
+
+
+def test_explicit_refresh_preserves_other_adapters_and_config(tmp_path, monkeypatch):
+    path = tmp_path / "account-usage.json"
+    path.write_text(
+        json.dumps(
+            {
+                "agy_accounts": [
+                    dict(
+                        id="agy",
+                        label="AGY",
+                        command="/fixture/agy",
+                        mode="native-keyring",
+                    )
+                ]
+            }
+        )
+    )
+    before = path.read_bytes()
+    external = tmp_path / "state/account-usage/external.json"
+    external.parent.mkdir(parents=True)
+    external.write_text(json.dumps({"accounts": [dict(provider="other", id="keep")]}))
+    monkeypatch.setattr(
+        agy,
+        "collect_native",
+        lambda s: dict(provider=agy.PROVIDER, id=s["id"], windows=[]),
+    )
+    agy.refresh_native_accounts(tmp_path)
+    assert [r["id"] for r in json.loads(external.read_text())["accounts"]] == [
+        "keep",
+        "agy",
+    ]
+    assert path.read_bytes() == before
