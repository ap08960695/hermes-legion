+"""Damaged optional cache metadata must not fail a whole extract batch."""
+
+import json
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from agent import web_search_registry
+from tools import web_result_cache as cache, web_tools, web_tools_extract, website_policy
+
+
+@pytest.fixture
+def isolated_cache(tmp_path, monkeypatch):
+    monkeypatch.setattr(cache, "_cache_dir", lambda: tmp_path)
+    monkeypatch.setattr(cache, "_web_config", dict)
+    return tmp_path
+
+
+def write_entry(root, url, entry, provider="offline-fixture"):
+    path = root / cache._INDEX_FILENAME
+    index = json.loads(path.read_text()) if path.exists() else {}
+    index[cache._url_digest(url, None, provider)] = entry
+    path.write_text(json.dumps(index))
+
+
+@pytest.mark.parametrize("metadata", [
+    "wrong shape", ["wrong shape"], 42,
+    {"fetched_at": None}, {"fetched_at": "broken"},
+    {"fetched_at": []}, {"fetched_at": {}},
+    {"fetched_at": float("nan")}, {"fetched_at": float("inf")},
+    {"fetched_at": float("-inf")}, {"fetched_at": "NaN"},
+    {"fetched_at": "Infinity"}, {"fetched_at": 10**400},
+])
+def test_bad_entry_is_cache_miss(isolated_cache, metadata):
+    content = isolated_cache / "page.md"
+    content.write_text("old content")
+    if isinstance(metadata, dict):
+        metadata = {**metadata, "file": str(content), "title": "old"}
+    url = "https://example.com/bad"
+    write_entry(isolated_cache, url, metadata)
+    assert cache.extract_cache_get(url, provider="offline-fixture") is None
+
+
+@pytest.mark.parametrize("as_string", [False, True])
+def test_valid_timestamp_still_hits(isolated_cache, as_string):
+    url = "https://example.com/good"
+    content = isolated_cache / "page.md"
+    content.write_text("kept content")
+    timestamp = time.time()
+    write_entry(isolated_cache, url, {
+        "fetched_at": str(timestamp) if as_string else timestamp,
+        "file": str(content), "title": "kept title",
+    })
+    hit = cache.extract_cache_get(url, provider="offline-fixture")
+    assert hit["content"] == "kept content"
+    assert hit["title"] == "kept title"
+
+
+@pytest.mark.parametrize("bad_entry", ["wrong shape", {"fetched_at": "broken"}, {"fetched_at": "NaN"}])
+def test_registry_batch_fetches_only_corrupt_entry(isolated_cache, monkeypatch, bad_entry):
+    good, bad = "https://example.com/good", "https://example.com/bad"
+    cache.extract_cache_put(good, "cached good", provider="offline-fixture")
+    cache.extract_cache_put(bad, "stale bad", provider="offline-fixture")
+    index = json.loads((isolated_cache / cache._INDEX_FILENAME).read_text())
+    if isinstance(bad_entry, dict):
+        bad_entry = {**index[cache._url_digest(bad, None, "offline-fixture")], **bad_entry}
+    write_entry(isolated_cache, bad, bad_entry)
+    calls, checked = [], []
+
+    async def extract(urls, **kwargs):
+        calls.append(list(urls))
+        return [{"url": url, "content": "fresh bad", "title": ""} for url in urls]
+
+    async def safe(url):
+        checked.append(url)
+        return True
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("No fallback or provider switch allowed")
+
+    provider = SimpleNamespace(name="offline-fixture", supports_extract=lambda: True, extract=extract)
+    monkeypatch.setattr(web_tools, "_ensure_web_plugins_loaded", lambda: None)
+    monkeypatch.setattr(web_tools, "_get_extract_backend", lambda: provider.name)
+    monkeypatch.setattr(web_tools, "_load_web_config", lambda: {"keyless_rescue": False})
+    monkeypatch.setattr(web_search_registry, "get_provider", lambda name: provider)
+    monkeypatch.setattr(web_search_registry, "get_active_extract_provider", forbidden)
+    monkeypatch.setattr(web_tools, "async_is_safe_url", safe)
+    monkeypatch.setattr(website_policy, "check_website_access", lambda url: None)
+    monkeypatch.setattr(web_tools_extract, "_rescue_extract", forbidden)
+    result = json.loads(web_tools.registry.dispatch("web_extract", {"urls": [good, bad]}))
+    assert "error" not in result, result
+    assert checked == [good, bad]
+    assert calls == [[bad]]
+    assert [entry["content"] for entry in result["results"]] == ["cached good", "fresh bad"]
+    assert cache.extract_cache_get(bad, provider=provider.name)["content"] == "fresh bad"
