new file mode 100644
--- /dev/null
+++ b/hermes_cli/plugin_code_cache.py
@@ -0,0 +1,91 @@
+"""Reuse immutable plugin code while native imports retain separate module state."""
+
+from functools import lru_cache
+import hashlib
+from importlib.machinery import (
+    BYTECODE_SUFFIXES, EXTENSION_SUFFIXES, SOURCE_SUFFIXES,
+    ExtensionFileLoader, FileFinder, SourceFileLoader, SourcelessFileLoader,
+)
+import os
+import sys
+import threading
+
+
+_MAX_SOURCE_BYTES = 1024 * 1024
+_compile_lock = threading.RLock()
+_finder_lock = threading.RLock()
+_missing = object()
+_native_details = (
+    (ExtensionFileLoader, EXTENSION_SUFFIXES),
+    (SourceFileLoader, SOURCE_SUFFIXES),
+    (SourcelessFileLoader, BYTECODE_SUFFIXES),
+)
+_native_pairs = tuple((suffix, loader) for loader, suffixes in _native_details for suffix in suffixes)
+
+
+@lru_cache(maxsize=128)
+def _compile_verified(path: str, digest: bytes, optimize: int):
+    loader = SourceFileLoader('', path)
+    source = loader.get_data(path)
+    if hashlib.sha256(source).digest() != digest:
+        raise OSError('Plugin source changed during compilation')
+    return loader.source_to_code(source, path, _optimize=optimize)
+
+
+class _SharedSourceLoader(SourceFileLoader):
+    def get_code(self, fullname):
+        path = self.get_filename(fullname)
+        # Reading on hits preserves current access checks and detects edits hidden by .pyc timestamps.
+        source = self.get_data(path)
+        if len(source) > _MAX_SOURCE_BYTES:
+            return self.source_to_code(source, path)
+        digest = hashlib.sha256(source).digest()
+        with _compile_lock:
+            return _compile_verified(path, digest, sys.flags.optimize)
+
+
+class _PluginFileFinder(FileFinder):
+    def __init__(self, path):
+        super().__init__(path, (ExtensionFileLoader, EXTENSION_SUFFIXES),
+                         (_SharedSourceLoader, SOURCE_SUFFIXES),
+                         (SourcelessFileLoader, BYTECODE_SUFFIXES))
+
+    def find_spec(self, fullname, target=None):
+        spec = super().find_spec(fullname, target)
+        if spec is not None:
+            for location in spec.submodule_search_locations or ():
+                prepare_plugin_imports(location)
+        return spec
+
+
+def prepare_plugin_imports(directory):
+    """Use the existing path-importer cache; retain custom importers and normal lazy timing."""
+    path = os.path.abspath(os.fspath(directory))
+    with _finder_lock:
+        previous = sys.path_importer_cache.get(path, _missing)
+        if isinstance(previous, _PluginFileFinder):
+            previous.invalidate_caches()
+            return
+        default = (type(previous) is FileFinder
+                   and tuple(getattr(previous, '_loaders', ())) == _native_pairs)
+        if previous is not _missing and previous is not None and not default:
+            return
+        finder = _PluginFileFinder(path)
+        if sys.path_importer_cache.get(path, _missing) is previous:
+            sys.path_importer_cache[path] = finder
+
+
+def prepare_plugin_spec(spec, directory):
+    """Extend native source loaders only; custom root loaders retain their complete behavior."""
+    loader = spec.loader
+    if type(loader) is not SourceFileLoader or set(vars(loader)) != {'name', 'path'}:
+        return
+    prepare_plugin_imports(directory)
+    spec.loader = _SharedSourceLoader(loader.name, loader.path)
+
+
+def cache_counts():
+    """Scalar observation only: never expose source paths, digests or code constants."""
+    info = _compile_verified.cache_info()
+    return {'hits': info.hits, 'misses': info.misses,
+            'entries': info.currsize, 'max_entries': info.maxsize}
