+def write_export_payload(output: str | Path | None, payload: str | Iterable[str]) -> None:
+    """Stream stdout/special files; stage regular-file bytes through the native atomic writer."""
+    chunks = (payload,) if isinstance(payload, str) else payload
+    if not output or output == "-":
+        sys.stdout.writelines(chunks)
+        return
+    path = Path(output)
+    try:
+        metadata = path.stat()
+    except FileNotFoundError:
+        metadata = None
+    # A hard-linked file must retain inode identity: replacing one name would
+    # leave its other names with stale content, unlike the original writer.
+    if metadata is not None and (not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink > 1):
+        with path.open("w", encoding="utf-8") as stream:
+            stream.writelines(chunks)
+        return
+    # Export must not gain the generic atomic writer's parent-creation or readonly-replacement authority.
+    actual = Path(os.path.realpath(path)) if path.is_symlink() else path
+    if not stat.S_ISDIR(actual.parent.stat().st_mode):
+        raise NotADirectoryError(str(actual.parent))
+    if metadata is not None:
+        fd = os.open(path, os.O_WRONLY | getattr(os, "O_NONBLOCK", 0))
+        os.close(fd)  # Kernel ACL/mode check without truncating the current output.
+    from utils import atomic_write_chunks
+    atomic_write_chunks(path, chunks, fsync_dir=True)
 
 
