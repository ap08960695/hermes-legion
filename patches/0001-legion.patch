@@ -0,0 +1,61 @@
+"""Concurrent identical reads reuse native dedup; no cross-task content cache."""
+from concurrent.futures import ThreadPoolExecutor
+from contextlib import contextmanager
+import json
+import threading
+from types import SimpleNamespace
+
+from tools import file_tools as ft,file_state
+from tools.file_operations_common import ReadResult
+from tools.file_tools_read_tracking import _read_tracker,reset_file_dedup
+
+
+def test_parallel_same_task_reads_issue_one_backend_read(tmp_path,monkeypatch):
+    path=tmp_path/'text.txt';path.write_text('content\n');entered=threading.Event();release=threading.Event();waiting=threading.Event();calls=[]
+    original_lock=file_state.lock_path;count=[]
+    @contextmanager
+    def lock(path):
+        count.append(path)
+        if len(count)==2:waiting.set()
+        with original_lock(path):yield
+    def read(path,offset,limit):
+        calls.append(path);entered.set();assert release.wait(5)
+        return ReadResult(content='1|content',total_lines=1,file_size=8)
+    monkeypatch.setattr(ft,'_get_file_ops',lambda _:SimpleNamespace(env=None,read_file=read))
+    monkeypatch.setattr(file_state,'lock_path',lock)
+    _read_tracker.clear()
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        first=pool.submit(ft.read_file_tool,str(path),1,2000,'same')
+        assert entered.wait(5)
+        second=pool.submit(ft.read_file_tool,str(path),1,2000,'same')
+        try:assert waiting.wait(5)
+        finally:release.set()
+        a,b=json.loads(first.result(timeout=5)),json.loads(second.result(timeout=5))
+    assert len(calls)==1 and a['content']=='1|content' and b['dedup'] is True
+    assert not file_state.get_registry()._path_locks
+
+
+def test_different_tasks_and_compaction_still_receive_real_contents(tmp_path,monkeypatch):
+    path=tmp_path/'text.txt';path.write_text('content\n');calls=[]
+    def read(*args):calls.append(args);return ReadResult(content='1|content',total_lines=1,file_size=8)
+    monkeypatch.setattr(ft,'_get_file_ops',lambda _:SimpleNamespace(env=None,read_file=read))
+    _read_tracker.clear()
+    for task in ('one','two'):
+        assert json.loads(ft.read_file_tool(str(path),task_id=task))['content']=='1|content'
+    reset_file_dedup('one')
+    assert json.loads(ft.read_file_tool(str(path),task_id='one'))['content']=='1|content'
+    assert len(calls)==3
+
+
+def test_changed_file_is_read_again_and_failures_do_not_retry(tmp_path,monkeypatch):
+    path=tmp_path/'text.txt';path.write_text('one');calls=[]
+    def read(*args):calls.append(args);return ReadResult(content=path.read_text(),total_lines=1,file_size=path.stat().st_size)
+    monkeypatch.setattr(ft,'_get_file_ops',lambda _:SimpleNamespace(env=None,read_file=read))
+    _read_tracker.clear();ft.read_file_tool(str(path),task_id='t')
+    path.write_text('changed size')
+    assert json.loads(ft.read_file_tool(str(path),task_id='t'))['content']=='changed size'
+    assert len(calls)==2
+    def broken(*args):calls.append(args);raise OSError('offline transport failure')
+    monkeypatch.setattr(ft,'_get_file_ops',lambda _:SimpleNamespace(env=None,read_file=broken))
+    result=json.loads(ft.read_file_tool(str(path),task_id='other'))
+    assert result.get('error') and len(calls)==3
