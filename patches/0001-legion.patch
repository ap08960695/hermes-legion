+"""Cross-role cache cohorts preserve capability sets and established v1 requests."""
+import copy
+import hashlib
+import json
+import socket
+import pytest
+from agent import shared_prompt_cache as shared
+from agent.transports.codex import ResponsesApiTransport
+
+@pytest.fixture(autouse=True)
+def offline(monkeypatch):
+    def forbidden(*a,**kw):raise AssertionError('network forbidden')
+    monkeypatch.setattr(socket.socket,'connect',forbidden)
+    monkeypatch.setattr(socket.socket,'connect_ex',forbidden)
+
+
+def tool(name):return {'type':'function','function':{'name':name,'description':'help '+name,'parameters':{'type':'object','properties':{'value':{'type':'string','enum':['b','a']}},'required':['value']}}}
+
+
+def prompt(version=2,suffix='private role'):
+    return f'[Hermes common operating rules v{version}]\n\nShared operating rules\n\n[/Hermes common operating rules v{version}]\n\n'+suffix
+
+
+def build(tools,version=2,session='a',**kw):
+    return ResponsesApiTransport().build_kwargs(model='gpt-6.1-sol',messages=[{'role':'system','content':prompt(version,session)},{'role':'user','content':session+' private task'}],tools=tools,session_id=session,cache_scope_id=session,base_url='https://chatgpt.com/backend-api/codex',is_codex_backend=True,**kw)
+
+
+def test_role_tools_no_longer_split_the_shared_prefix_routing_cohort():
+    a=shared.canonical_tools([tool('browser_navigate'),tool('read_file'),tool('terminal')])
+    b=shared.canonical_tools([tool('credential_status'),tool('read_file'),tool('terminal')])
+    ar=build(a,session='a');br=build(b,session='b')
+    assert ar['prompt_cache_key']==br['prompt_cache_key']
+    assert [t['name'] for t in ar['tools'][:2]]==['read_file','terminal']
+    assert ar['tools'][:2]==br['tools'][:2]
+    assert ar['tools']!=br['tools'] and ar['input']!=br['input']
+    assert set(t['name'] for t in ar['tools'])=={'browser_navigate','read_file','terminal'}
+    assert set(t['name'] for t in br['tools'])=={'credential_status','read_file','terminal'}
+
+
+def test_initial_tool_order_owns_copy_and_preserves_schema_and_native_slots():
+    original=[tool('browser_navigate'),{'type':'web_search'},tool('terminal'),tool('read_file')]
+    before=copy.deepcopy(original);after=shared.canonical_tools(original)
+    assert original==before and after[1]==original[1]
+    assert [t.get('function',{}).get('name') for t in after]==['read_file',None,'terminal','browser_navigate']
+    assert after[0]['function']['parameters']['properties']['value']['enum']==['b','a']
+    after[0]['function']['description']='changed'
+    assert original==before
+
+
+def test_v1_restored_request_keeps_exact_previous_key_and_wire_order():
+    tools=[tool('terminal'),tool('read_file')]
+    req=build(tools,version=1)
+    prefix=prompt(1).split('\n\nprivate role')[0]
+    payload=json.dumps(['chatgpt.com','/backend-api/codex','gpt-6.1-sol',prefix,req['tools']],sort_keys=True,ensure_ascii=False,separators=(',',':'))
+    assert req['prompt_cache_key']=='hsp1_'+hashlib.sha256(payload.encode()).hexdigest()[:40]
+    assert [t['name'] for t in req['tools']]==['terminal','read_file']
+
+
+def test_changed_shared_schema_and_model_remain_distinct():
+    a=shared.canonical_tools([tool('read_file'),tool('browser_navigate')])
+    b=copy.deepcopy(a);b[0]['function']['description']='different semantics'
+    assert build(a)['prompt_cache_key']!=build(b)['prompt_cache_key']
+    assert build(a,request_overrides={'model':'other-model'})['prompt_cache_key']!=build(a)['prompt_cache_key']
+
+
+def test_explicit_override_is_authoritative_and_unshared_tools_stay_separate():
+    assert build([tool('read_file')],request_overrides={'prompt_cache_key':'owner'})['prompt_cache_key']=='owner'
+    assert build([tool('browser_navigate')])['prompt_cache_key']!=build([tool('credential_status')])['prompt_cache_key']
+
+
+def test_two_calls_append_history_without_reordering_already_frozen_tools():
+    tools=shared.canonical_tools([tool('browser_navigate'),tool('read_file'),tool('terminal')])
+    a=build(tools);b=build(tools)
+    assert a==b
+    assert build([tool('terminal'),tool('read_file')])['tools'][0]['name']=='terminal'
+
+
+@pytest.mark.parametrize('version',[1,2])
+def test_diagnostics_recognize_both_layouts_and_only_v2_shared_tools(tmp_path,monkeypatch,version):
+    from pathlib import Path
+    from types import SimpleNamespace
+    from agent.cache_cross_bot_diagnostics import fingerprint
+    from hermes_constants import set_hermes_home_override,reset_hermes_home_override
+    monkeypatch.setattr(Path,'home',lambda:tmp_path)
+    home=tmp_path/'hermes';monkeypatch.setenv('HERMES_HOME',str(home))
+    token=set_hermes_home_override(home)
+    try:
+        req=build(shared.canonical_tools([tool('read_file'),tool('browser_navigate')]),version=version)
+        agent=SimpleNamespace(session_id='private',base_url='https://chatgpt.com/backend-api/codex',api_mode='codex_responses',_client_kwargs={})
+        result=fingerprint(agent,req,request_id='private')
+        assert result['fields']['common_prefix']['complete']
+        assert bool(result['fields']['shared_tools'])==(version==2)
+        assert 'private' not in json.dumps(result)
+    finally:reset_hermes_home_override(token)
+
+
+@pytest.mark.parametrize('version',[1,2])
+def test_restored_static_prefix_uses_its_own_layout_without_rebuilding_prompt(monkeypatch,version):
+    from types import SimpleNamespace
+    from agent import system_prompt as sp
+    stored=prompt(version,'private original suffix')
+    agent=SimpleNamespace(_cached_system_prompt=stored,_use_prompt_caching=True,_cached_system_prompt_static=None,_static_rebuild_failed_for=None)
+    calls=[]
+    def build_parts(agent,system_message=None,*,legacy_layout=False,shared_layout_version=2):
+        calls.append((legacy_layout,shared_layout_version))
+        return {'stable':shared.common_prefix(prompt(shared_layout_version))}
+    monkeypatch.setattr(sp,'build_system_prompt_parts',build_parts)
+    sp.reconstruct_static_prefix(agent)
+    assert calls==[(False,version)]
+    assert agent._cached_system_prompt==stored
+    assert agent._cached_system_prompt_static==shared.common_prefix(stored)
