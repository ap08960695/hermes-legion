@@ -0,0 +1,24 @@
+"""Bounded native live-transcript reads; one SQL statement gives one SQLite snapshot."""
+
+
+def get_message_bookends(db, session_id: str, head: int, tail: int) -> tuple[list[dict], int]:
+    if head < 0 or tail < 0:
+        raise ValueError("message bookend counts must be nonnegative")
+    rows = db._read_all("""
+        WITH first_ids AS (
+            SELECT id FROM messages WHERE session_id=? AND active=1 ORDER BY id LIMIT ?
+        ), last_ids AS (
+            SELECT id FROM messages WHERE session_id=? AND active=1 ORDER BY id DESC LIMIT ?
+        ), total AS (
+            SELECT COUNT(*) AS n FROM messages WHERE session_id=? AND active=1
+        )
+        SELECT messages.*, total.n AS window_total FROM total LEFT JOIN messages ON
+            messages.id IN (SELECT id FROM first_ids UNION SELECT id FROM last_ids)
+        ORDER BY messages.id
+        """, (session_id, head, session_id, tail, session_id))
+    count = rows[0]["window_total"]
+    messages = [db._row_to_message_dict(row, warn_context="get_message_bookends", summary_flag=True)
+                for row in rows if row["id"] is not None]
+    for message in messages:
+        message.pop("window_total", None)
+    return messages, count
