+import json
+import pytest
+from hermes_cli.kanban_db_graph import _validate_children_graph
+
+
+def child(scope, parents=()):
+    return {'title': 'fixture', 'parents': list(parents),
+            'body': '```hermes-contract\n'+json.dumps({'version': 1, 'write_scope': scope})+'\n```'}
+
+
+def test_unordered_shared_writes_refused_but_ordered_and_disjoint_allowed():
+    with pytest.raises(ValueError, match='overlap'):
+        _validate_children_graph([child(['src/']), child(['src/core.py'])])
+    _validate_children_graph([child(['src/']), child(['src/core.py'], [0])])
+    _validate_children_graph([child(['src/a.py']), child(['src/b.py'])])
+    _validate_children_graph([{'title': 'legacy'}, {'title': 'legacy'}])
+
+
+def test_scope_cannot_escape_and_transitive_order_counts():
+    with pytest.raises(ValueError, match='write_scope'):
+        _validate_children_graph([child(['../outside'])])
+    _validate_children_graph([child(['src/a.py']), child([], [0]), child(['src/a.py'], [1])])
diff --git a/tests/hermes_cli/test_linux_desktop_bootstrap_alias.py b/tests/hermes_cli/test_linux_desktop_bootstrap_alias.py
new file mode 100644
index 0000000000000000000000000000000000000000..cd24ff4a7390380499c3abe32a0357f4d2a30e58
--- /dev/null
+++ b/tests/hermes_cli/test_linux_desktop_bootstrap_alias.py
@@ -0,0 +1,112 @@
+"""Cold native entry execution through a source-bootstrap shim and symlinked home.
+
+The tiny fixture CLI emits a witness only; it never starts an agent or a GUI.
+Actual owner-entry launch failure and real packaged-app acceptance are separate.
+"""
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import sys
+
+import pytest
+from hermes_cli import linux_desktop_entry as entry
+
+pytestmark = pytest.mark.platforms('linux')
+
+
+def _script(path, text):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text)
+    path.chmod(0o755)
+    return path
+
+
+def _source_tree(path):
+    (path / 'hermes_cli').mkdir(parents=True)
+    (path / 'hermes_cli/__init__.py').write_text('')
+    (path / 'hermes_cli/main.py').write_text(
+        'import json,os,sys\nprint(json.dumps({"argv":sys.argv[1:],"cwd":os.getcwd()}))\n'
+    )
+    release = path / 'apps/desktop/release/linux-unpacked'
+    release.mkdir(parents=True)
+    (release / 'hermes').write_bytes(b'fixture package presence only')
+    python = os.path.abspath(sys._base_executable)
+    bootstrap = 'import runpy,sys;sys.path.insert(0,' + repr(str(path)) + ');runpy.run_module("hermes_cli.main",run_name="__main__",alter_sys=True)'
+    _script(path / '.hermes/bin/hermes', '#!/bin/sh\nexec ' + shlex.quote(python) + ' -I -c ' + shlex.quote(bootstrap) + ' "$@"\n')
+    return path
+
+
+@pytest.mark.parametrize('alias_name', [None, 'home-alias', 'home with spaces'])
+def test_installed_entry_boots_cold_with_source_alias(tmp_path, monkeypatch, alias_name):
+    root = _source_tree(tmp_path / 'physical/source')
+    launch_root = root
+    if alias_name:
+        launch_root = tmp_path / alias_name
+        launch_root.symlink_to(root, target_is_directory=True)
+    home = tmp_path / 'user'
+    wrapper = _script(home / '.local/bin/hermes', '#!/bin/sh\nexec ' + shlex.quote(str(launch_root / '.hermes/bin/hermes')) + ' "$@"\n')
+    monkeypatch.setenv('HOME', str(home))
+    monkeypatch.setattr(Path, 'home', classmethod(lambda cls: home))
+    monkeypatch.setenv('XDG_DATA_HOME', str(tmp_path / 'xdg'))
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path / 'isolated-hermes'))
+    monkeypatch.setattr(entry, '_project_root', lambda: root)
+    monkeypatch.setattr('hermes_cli.relaunch.resolve_hermes_bin', lambda: None)
+    monkeypatch.setattr(entry, 'refresh_desktop_databases', lambda _: [])
+    monkeypatch.setattr(entry, '_launcher_entry_management_enabled', lambda: True)
+    python = os.path.abspath(sys._base_executable)
+    monkeypatch.setattr(entry, '_running_interpreter', lambda: python)
+    monkeypatch.setattr(entry, '_running_interpreter_fallback', lambda: python)
+    installed = entry.install_desktop_entry(root)
+    command = next(line[5:] for line in installed.read_text().splitlines() if line.startswith('Exec='))
+    neutral = tmp_path / 'neutral'
+    neutral.mkdir()
+    cold_env = {'HOME': str(home), 'PATH': '/usr/bin:/bin', 'HERMES_DISABLE_LAZY_INSTALLS': '1'}
+    result = subprocess.run(shlex.split(command), cwd=neutral, env=cold_env, capture_output=True, text=True, timeout=5, check=False)
+    assert result.returncode == 0, result.stderr
+    witness = json.loads(result.stdout)
+    assert witness == {'argv': ['desktop', '--skip-build'], 'cwd': str(neutral)}
+    assert shlex.split(command)[0] == str(wrapper)
+
+
+def test_foreign_symlink_bootstrap_is_not_this_checkout(tmp_path):
+    root = _source_tree(tmp_path / 'checkout')
+    foreign = _source_tree(tmp_path / 'checkout-old')
+    alias = tmp_path / 'foreign-home'
+    alias.symlink_to(foreign, target_is_directory=True)
+    wrapper = _script(tmp_path / 'bin/hermes', '#!/bin/sh\nexec ' + shlex.quote(str(alias / '.hermes/bin/hermes')) + ' "$@"\n')
+    assert entry._wrapper_targets_checkout(wrapper, root) is False
+
+
+@pytest.mark.parametrize('alias_name', [None, 'source alias with spaces'])
+def test_no_durable_wrapper_boots_cold_from_injected_source(tmp_path, monkeypatch, alias_name):
+    root = _source_tree(tmp_path / 'physical/source')
+    launch_root = root
+    if alias_name:
+        launch_root = tmp_path / alias_name
+        launch_root.symlink_to(root, target_is_directory=True)
+    home = tmp_path / 'user'
+    home.mkdir()
+    monkeypatch.setenv('HOME', str(home))
+    monkeypatch.setattr(Path, 'home', classmethod(lambda cls: home))
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path / 'isolated-hermes'))
+    monkeypatch.setenv('XDG_DATA_HOME', str(tmp_path / 'xdg'))
+    monkeypatch.setattr(entry, '_project_root', lambda: launch_root)
+    monkeypatch.setattr('hermes_cli.relaunch.resolve_hermes_bin', lambda: None)
+    monkeypatch.setattr(entry, '_known_wrapper_candidates', list)
+    monkeypatch.setattr(entry, 'refresh_desktop_databases', lambda _: [])
+    monkeypatch.setattr(entry, '_launcher_entry_management_enabled', lambda: True)
+    python = os.path.abspath(sys._base_executable)
+    monkeypatch.setattr(entry, '_running_interpreter', lambda: python)
+    monkeypatch.setattr(entry, '_running_interpreter_fallback', lambda: python)
+    installed = entry.install_desktop_entry(launch_root)
+    assert installed is not None
+    command = next(line[5:] for line in installed.read_text().splitlines() if line.startswith('Exec='))
+    neutral = tmp_path / 'neutral'
+    neutral.mkdir()
+    cold_env = {'HOME': str(home), 'PATH': '/usr/bin:/bin', 'HERMES_DISABLE_LAZY_INSTALLS': '1'}
+    result = subprocess.run(shlex.split(command), cwd=neutral, env=cold_env,
+                            capture_output=True, text=True, timeout=5, check=False)
+    assert result.returncode == 0, result.stderr
+    assert json.loads(result.stdout) == {'argv': ['desktop', '--skip-build'], 'cwd': str(neutral)}
diff --git a/tests/hermes_cli/test_model_options_usage_readonly.py b/tests/hermes_cli/test_model_options_usage_readonly.py
