+import pytest
+from hermes_cli.code_map import scan, select
+
+
+def test_navigation_without_import_and_changed_content(tmp_path):
+    (tmp_path / "pkg").mkdir(); (tmp_path / "tests").mkdir()
+    (tmp_path / "pkg/__init__.py").write_text("")
+    target = tmp_path / "pkg/core.py"
+    target.write_text("raise RuntimeError('must never import')")
+    (tmp_path / "pkg/api.py").write_text("from .core import action")
+    (tmp_path / "tests/test_api.py").write_text("from pkg.api import action")
+    first = scan(tmp_path)
+    assert select(first, ["pkg/core.py"])["selected_tests"] == ["tests/test_api.py"]
+    assert select(first, ["pkg/__init__.py"])["selected_tests"] == ["tests/test_api.py"]
+    target.write_text("# changed")
+    assert scan(tmp_path)["source_hashes"] != first["source_hashes"]
+    assert select(first, ["config.yaml"])["unresolved_changes"] == ["config.yaml"]
+    with pytest.raises(ValueError):
+        select(first, ["../secret.py"])
+
+
+def test_symlinks_and_bad_syntax_do_not_hide_warnings(tmp_path):
+    (tmp_path / "bad.py").write_text("def :")
+    (tmp_path / "external.py").symlink_to(tmp_path / "bad.py")
+    graph = scan(tmp_path)
+    assert "external.py" not in graph["source_hashes"]
+    assert graph["warnings"] == [{"path": "bad.py", "reason": "parse_failed"}]
