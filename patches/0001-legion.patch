+import { Button, Codicon } from '@hermes/plugin-sdk'
+
+import { boardCounts, type BoardView } from './board-view'
+import type { KanbanText } from './i18n'
+import type { KanbanBoard } from './types'
+
+interface OverviewProps {
+  board: KanbanBoard | null | undefined
+  view: BoardView
+  onView: (view: BoardView) => void
+  k: KanbanText
+}
+export function BoardOverview({ board, view, onView, k }: OverviewProps) {
+  const count = boardCounts(board)
+  return (
+    <div className="kanban-overview">
+      <div className="kanban-view-switch" role="group" aria-label={k.workViews}>
+        <Button variant="ghost" aria-pressed={view === 'current'} onClick={() => onView('current')}>
+          <Codicon name="checklist" />
+          {k.currentWork}
+          <span>{count.current}</span>
+        </Button>
+        <Button variant="ghost" aria-pressed={view === 'workflow'} onClick={() => onView('workflow')}>
+          <Codicon name="git-merge" />
+          {k.workflow}
+        </Button>
+        <Button variant="ghost" aria-pressed={view === 'history'} onClick={() => onView('history')}>
+          <Codicon name="history" />
+          {k.taskHistory}
+          <span>{count.history}</span>
+        </Button>
+      </div>
+      <div className="kanban-work-summary" aria-label={k.currentWork}>
+        <span>
+          <Codicon name="pulse" />
+          {k.col.running.label}
+          <b>{count.working}</b>
+        </span>
+        <span>
+          <Codicon name="circle-outline" />
+          {k.col.ready.label}
+          <b>{count.ready}</b>
+        </span>
+        <span>
+          <Codicon name="debug-pause" />
+          {k.col.blocked.label}
+          <b>{count.waiting}</b>
+        </span>
+      </div>
+    </div>
+  )
+}
+
+export function HistoryMore({
+  visible,
+  total,
+  onMore,
+  k
+}: {
+  visible: number
+  total: number
+  onMore: () => void
+  k: KanbanText
+}) {
+  if (visible >= total) return null
+  return (
+    <Button variant="ghost" size="sm" onClick={onMore}>
+      {k.moreHistory(visible, total)}
+    </Button>
+  )
+}
+
+export function EmptyBoardView({
+  view,
+  filtered,
+  onCurrent,
+  onAdd,
+  k
+}: {
+  view: BoardView
+  filtered: boolean
+  onCurrent: () => void
+  onAdd: () => void
+  k: KanbanText
+}) {
+  const history = view === 'history'
+  return (
+    <div className="grid flex-1 place-items-center px-4 text-center">
+      <div className="flex flex-col items-center gap-2">
+        <Codicon className="text-(--ui-text-quaternary)" name={history ? 'history' : 'project'} size="1.25rem" />
+        <p className="text-sm text-(--ui-text-tertiary)">{filtered ? k.noMatch : history ? k.noHistory : k.noTasks}</p>
+        <Button className="mt-0.5" onClick={history ? onCurrent : onAdd} size="sm" variant="outline">
+          <Codicon name={history ? 'arrow-left' : 'add'} size="0.75rem" />
+          {history ? k.backToCurrent : k.newTask}
+        </Button>
+      </div>
+    </div>
+  )
+}
