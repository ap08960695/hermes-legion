@@ -0,0 +1,25 @@
+import type { KanbanBoard, KanbanColumn } from './types'
+
+export type BoardView = 'current' | 'history' | 'workflow'
+export const HISTORY_BATCH = 50
+const HISTORY = new Set(['done', 'archived'])
+
+export function boardForView(board: KanbanBoard | null | undefined, view: BoardView): KanbanBoard | undefined {
+  if (!board) return undefined
+  return { ...board, columns: board.columns.filter(col => HISTORY.has(col.name) === (view === 'history')) }
+}
+
+export function columnTasks(column: KanbanColumn, limit: number) {
+  return HISTORY.has(column.name) ? column.tasks.slice(0, limit) : column.tasks
+}
+
+export function boardCounts(board: KanbanBoard | null | undefined) {
+  const counts = { current: 0, history: 0, working: 0, ready: 0, waiting: 0 }
+  for (const col of board?.columns ?? []) {
+    counts[HISTORY.has(col.name) ? 'history' : 'current'] += col.tasks.length
+    if (col.name === 'running') counts.working += col.tasks.length
+    if (col.name === 'ready') counts.ready += col.tasks.length
+    if (col.name === 'blocked') counts.waiting += col.tasks.length
+  }
+  return counts
+}
