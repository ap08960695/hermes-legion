@@ -0,0 +1,39 @@
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { act, cleanup, fireEvent, render, waitFor } from '@testing-library/react'
+import { atom } from 'nanostores'
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { I18nProvider } from '@/i18n'
+const request = vi.hoisted(() => vi.fn(async (..._args: unknown[]) => ({ accounts: [] })))
+vi.mock('@/store/gateway', () => ({ requestGatewayForAgent: (...args: unknown[]) => request(...args) }))
+vi.mock('@/store/connections', () => ({ $activeConnectionId: atom('local') }))
+vi.mock('@/store/profile', () => ({
+  $activeGatewayProfile: atom('captain'), $profiles: atom([]),
+  normalizeProfileKey: (p: string | null) => p || 'default'
+}))
+import { AccountUsageStatusbar } from './account-usage-statusbar'
+afterEach(cleanup)
+it('opens the quota viewer from the bottom bar, loads cached shared accounts, and refreshes only explicitly', async () => {
+  const f = render(
+    <QueryClientProvider client={new QueryClient()}>
+      <I18nProvider configClient={null} initialLocale="en">
+        <footer>
+          <AccountUsageStatusbar />
+        </footer>
+      </I18nProvider>
+    </QueryClientProvider>
+  )
+  expect(request).not.toHaveBeenCalled()
+  await act(async () => fireEvent.click(f.getByRole('button', { name: 'Account usage' })))
+  await waitFor(() => expect(request).toHaveBeenCalledTimes(1))
+  expect(request.mock.calls[0]?.slice(0, 4)).toEqual([
+    'local',
+    'default',
+    'account.usage',
+    { profile: 'default', refresh: false }
+  ])
+  expect(f.getByRole('region', { name: 'AGY' })).toBeTruthy()
+  await waitFor(() => expect(f.getByRole('button', { name: 'Refresh' }).hasAttribute('disabled')).toBe(false))
+  await act(async () => fireEvent.click(f.getByRole('button', { name: 'Refresh' })))
+  expect(request.mock.calls[1]?.[3]).toEqual({ profile: 'default', refresh: true })
+})
