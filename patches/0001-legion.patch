+def test_actual_agent_turn_persists_on_the_original_session_without_followups(case, monkeypatch):
+    import httpx
+    import requests
+    network = []
+    def forbidden_network(*args, **kwargs):
+        from urllib.parse import urlsplit
+        request = args[1]
+        url = urlsplit(str(request.url))
+        network.append((request.method, url.netloc, url.path))
+        raise AssertionError('offline host acceptance cannot contact any provider')
+    monkeypatch.setattr(httpx.Client, 'send', forbidden_network)
+    monkeypatch.setattr(httpx.AsyncClient, 'send', forbidden_network)
+    monkeypatch.setattr(requests.Session, 'send', forbidden_network)
+    from unittest.mock import MagicMock, patch
+    from tests.agent.test_run_agent import _mock_response
+    from run_agent import AIAgent
+    (case.home / 'config.yaml').write_text('''model:
+  default: fixture/model
+  provider: custom
+  base_url: http://127.0.0.1:9/v1
+  context_length: 128000
+auxiliary:
+  title_generation:
+    enabled: true
+    model_upgrade_enabled: true
+''')
+    seen = []
+    def build(**kw):
+        with patch('agent.process_bootstrap.OpenAI'):
+            agent = AIAgent(api_key='fixture-key', base_url='http://127.0.0.1:9/v1',
+                provider='custom', model='fixture/model', quiet_mode=True, enabled_toolsets=[],
+                session_id=kw['session_id'], session_db=kw['session_db'], platform='desktop',
+                skip_context_files=True, skip_memory=True, fallback_model=None)
+        agent.client = MagicMock()
+        agent.client.chat.completions.create.return_value = _mock_response(content='Receipt inspected.', finish_reason='stop')
+        agent.compression_enabled = False
+        agent.save_trajectories = False
+        agent._cached_system_prompt = 'Retain project gates.'
+        seen.append(agent.client.chat.completions.create)
+        return agent
+    monkeypatch.setattr(_host(), 'build_agent', build)
+    assert _run(case)['state'] == 'settled'
+    from agent.title_generator import wait_for_title_upgrades
+    wait_for_title_upgrades()
+    assert seen[0].call_count == 1
+    # Constructor capability probes may try local GETs; the trap blocks every request.
+    # Any model/auxiliary POST or request outside the fake local endpoint is a failure.
+    assert all(method == 'GET' and host == '127.0.0.1:9' for method, host, _path in network), network
+    assert case.db.get_session_title(KEY) is None
+    rows = case.db.get_messages(KEY)
+    assert rows[-1]['role'] == 'assistant' and rows[-1]['content'] == 'Receipt inspected.'
+    assert len([m for m in rows if m['role'] == 'user']) == 2
+    assert _run(case)['ran'] is False
+    assert seen[0].call_count == 1
