diff --git a/apps/desktop/src/app/artifacts/library-availability.ts b/apps/desktop/src/app/artifacts/library-availability.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/app/artifacts/library-availability.ts
@@ -0,0 +1,71 @@
+import { useEffect, useRef, useState } from 'react'
+import { hermesApiAs } from '@/api/client'
+import { libraryItem, type LibraryItem } from './open-artifact'
+import type { ArtifactRecord } from './artifact-utils'
+export type PreviewState = 'checking' | 'ready' | 'missing' | 'unreadable' | 'unsupported' | 'too_large' | 'unavailable'
+const states = new Set<PreviewState>(['ready', 'missing', 'unreadable', 'unsupported', 'too_large', 'unavailable'])
+const key = (item: LibraryItem) =>
+  JSON.stringify([item.owner.connectionId, item.owner.profile, item.sessionId, item.value])
+/** Visible items only; three bounded batches in flight, no polling or retries. */
+export function useLibraryAvailability(items: readonly ArtifactRecord[]) {
+  const cache = useRef(new Map<string, PreviewState>()),
+    lastItems = useRef<readonly ArtifactRecord[] | null>(null),
+    [revision, setRevision] = useState(0)
+  useEffect(() => {
+    let current = true
+    cache.current.clear()
+    lastItems.current = items
+    const groups = new Map<string, LibraryItem[]>()
+    for (const artifact of items) {
+      if (artifact.kind === 'link') continue
+      const item = 'owner' in artifact ? (artifact as LibraryItem) : libraryItem(artifact)
+      if (cache.current.has(key(item))) continue
+      const group = JSON.stringify([item.owner.connectionId, item.owner.profile, item.sessionId])
+      groups.set(group, [...(groups.get(group) || []), item])
+    }
+    const batches = [...groups.values()].flatMap(group =>
+      Array.from({ length: Math.ceil(group.length / 64) }, (_, i) => group.slice(i * 64, i * 64 + 64))
+    )
+    async function worker() {
+      while (current && batches.length) {
+        const batch = batches.shift()!
+        let response: { files?: { path: string; state: PreviewState }[] } = {}
+        try {
+          response = await hermesApiAs(batch[0].owner, {
+            path: '/api/fs/preview-check',
+            method: 'POST',
+            body: { session_id: batch[0].sessionId, paths: batch.map(item => item.value) }
+          })
+        } catch {
+          /* Fail closed; explicit Refresh checks again. */
+        }
+        if (!current) return
+        for (const item of batch) {
+          const value = Array.isArray(response.files)
+            ? response.files.find(row => row.path === item.value)?.state
+            : undefined
+          cache.current.set(key(item), value && states.has(value) ? value : 'unavailable')
+        }
+        setRevision(n => n + 1)
+      }
+    }
+    void Promise.all(Array.from({ length: Math.min(3, batches.length) }, () => worker()))
+    return () => {
+      current = false
+    }
+  }, [items])
+  void revision
+  return Object.fromEntries(
+    items.map(artifact => {
+      const item = 'owner' in artifact ? (artifact as LibraryItem) : libraryItem(artifact)
+      return [
+        item.id,
+        artifact.kind === 'link'
+          ? 'ready'
+          : lastItems.current === items
+            ? cache.current.get(key(item)) || 'checking'
+            : 'checking'
+      ]
+    })
+  ) as Record<string, PreviewState>
+}
