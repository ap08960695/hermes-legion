+"""New conversations share common guidance while retaining each role's instructions."""
+from unittest.mock import patch
+import pytest
+from agent import system_prompt as sp, shared_prompt_cache as shared
+from tests.agent.test_system_prompt import _make_agent
+
+@pytest.fixture
+def prompt_inputs():
+    with (patch.object(sp, '_coding_parts', return_value=(["Shared coding brief"], [], [])),
+          patch.object(sp, '_post_workspace_parts', return_value=[]),
+          patch.object(sp, '_context_files_part', return_value=[]),
+          patch.object(sp, '_memory_parts', return_value=[]),
+          patch.object(sp, '_active_profile_line', return_value="Synthetic profile"),
+          patch.object(sp, '_timestamp_line', return_value="Synthetic date"),
+          patch.object(sp, '_skills_prompt', return_value="- hermes-agent: Help skill"),
+          patch.object(sp._pb, 'load_soul_md', return_value="Synthetic identity"),
+          patch.object(sp._pb, 'build_environment_hints', return_value="")):
+        yield
+
+def make_agent(names, guidance=""):
+    return _make_agent(valid_tool_names=names, _kanban_worker_guidance=guidance,
+                       _task_completion_guidance=True, _parallel_tool_call_guidance=True,
+                       _execution_guidance=False)
+
+def test_worker_guidance_does_not_split_new_common_prefix(prompt_inputs):
+    worker = sp.build_system_prompt(make_agent(['read_file', 'kanban_show'], 'Synthetic worker lifecycle'))
+    chat = sp.build_system_prompt(make_agent(['read_file', 'kanban_show']))
+    assert shared.common_prefix(worker) == shared.common_prefix(chat)
+    assert 'Synthetic worker lifecycle' not in shared.common_prefix(worker)
+    assert worker.count('Synthetic worker lifecycle') == 1
+    assert 'Synthetic worker lifecycle' not in chat
+
+def test_skill_capability_variant_is_retained_after_the_common_prefix(prompt_inputs):
+    skilled = sp.build_system_prompt(make_agent(['read_file', 'skills_list', 'skill_view']))
+    plain = sp.build_system_prompt(make_agent(['read_file']))
+    assert shared.common_prefix(skilled) == shared.common_prefix(plain)
+    assert shared.common_prefix(skilled) is not None
+    assert sp.HERMES_AGENT_HELP_GUIDANCE in skilled
+    assert sp.HERMES_AGENT_HELP_GUIDANCE not in plain
+    assert sp.HERMES_AGENT_HELP_GUIDANCE_NO_SKILLS in plain
+    assert sp.HERMES_AGENT_HELP_GUIDANCE not in shared.common_prefix(skilled)
+
+def test_v3_prompt_restore_keeps_its_own_role_sensitive_static_bytes(prompt_inputs):
+    agent = make_agent(['read_file', 'kanban_show'], 'Original v3 lifecycle')
+    agent._use_prompt_caching = True
+    parts = sp.build_system_prompt_parts(agent, shared_layout_version=3)
+    stored = '\n\n'.join(p for p in parts.values() if p)
+    agent._cached_system_prompt = stored
+    agent._cached_system_prompt_static = None
+    sp.reconstruct_static_prefix(agent)
+    assert agent._cached_system_prompt == stored
+    assert agent._cached_system_prompt_static == parts['stable']
+    assert shared.layout_version(stored) == 3
+    assert 'Original v3 lifecycle' in shared.common_prefix(stored)
+
+
+def test_surface_and_environment_hints_do_not_split_new_common_prefix(prompt_inputs):
+    with patch.object(sp, '_post_workspace_parts', side_effect=[['Worker surface hint'], ['Chat surface hint']]):
+        worker = sp.build_system_prompt(make_agent(['read_file']))
+        chat = sp.build_system_prompt(make_agent(['read_file']))
+    assert shared.common_prefix(worker) == shared.common_prefix(chat)
+    assert 'Worker surface hint' not in shared.common_prefix(worker)
+    assert worker.count('Worker surface hint') == 1 and 'Worker surface hint' not in chat
+    assert chat.count('Chat surface hint') == 1 and 'Chat surface hint' not in worker
+
+
+def test_new_cache_layout_is_recognized_without_publishing_request_content():
+    from agent.cache_request_diagnostics import fingerprint
+    request = {'instructions': '[Hermes common operating rules v4]\n\nCommon\n\n[/Hermes common operating rules v4]',
+               'prompt_cache_key': 'hsp4_synthetic', 'input': [{'role': 'user', 'content': 'private'}]}
+    row = fingerprint(request, key=b'x' * 32, session_id='private', request_id='private', base_url='https://chatgpt.com')
+    assert row['shared_prefix_used'] and row['shared_key_used']
+    import json
+    assert 'private' not in json.dumps(row) and 'Common' not in json.dumps(row)
