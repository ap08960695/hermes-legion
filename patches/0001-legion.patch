+    assert calls[0][1]["env"]["DBUS_SESSION_BUS_ADDRESS"] == "fixture-bus"
+    assert "GEMINI_API_KEY" not in calls[0][1]["env"]
+    assert not Path(calls[0][1]["cwd"]).exists()
+
+
+@pytest.mark.parametrize(
+    "change",
+    [
+        dict(num_turns=1),
+        dict(command=dict(name="prompt")),
+        dict(usage=dict(total_tokens=1)),
+        dict(status="ERROR"),
+    ],
+)
+def test_refuses_non_metadata_receipts(change):
+    with pytest.raises(ValueError):
+        agy.parse_native_usage(receipt(**change))
+
+
+def test_explicit_refresh_preserves_other_adapters_and_config(tmp_path, monkeypatch):
+    path = tmp_path / "account-usage.json"
+    path.write_text(
+        json.dumps(
+            {
+                "agy_accounts": [
+                    dict(
+                        id="agy",
+                        label="AGY",
+                        command="/fixture/agy",
+                        mode="native-keyring",
+                    )
+                ]
+            }
+        )
+    )
+    before = path.read_bytes()
+    external = tmp_path / "state/account-usage/external.json"
+    external.parent.mkdir(parents=True)
+    external.write_text(json.dumps({"accounts": [dict(provider="other", id="keep")]}))
+    monkeypatch.setattr(
+        agy,
+        "collect_native",
+        lambda s: dict(provider=agy.PROVIDER, id=s["id"], windows=[]),
+    )
+    agy.refresh_native_accounts(tmp_path)
+    assert [r["id"] for r in json.loads(external.read_text())["accounts"]] == [
+        "keep",
+        "agy",
+    ]
+    assert path.read_bytes() == before
