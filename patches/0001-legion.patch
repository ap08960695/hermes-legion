+"""Account reporting must inspect each credential without selecting or refreshing it."""
+
+import argparse
+from datetime import datetime, timedelta, UTC
+import json
+from pathlib import Path
+
+from agent.account_usage import AccountUsageSnapshot, AccountUsageWindow
+from hermes_cli import account_usage_report as report
+from hermes_cli.subcommands.usage import cmd_usage
+
+
+def entry(token, label):
+    return {
+        "id": label,
+        "label": label,
+        "source": "manual",
+        "auth_type": "oauth",
+        "access_token": token,
+    }
+
+
+def test_each_account_has_own_read_only_query(monkeypatch):
+    monkeypatch.setattr(
+        report,
+        "read_credential_pool",
+        lambda: {
+            "anthropic": [entry("private-one", "one"), entry("private-two", "two")]
+        },
+    )
+    calls = []
+
+    def fetch(provider, **kw):
+        calls.append((provider, kw))
+        used = 95 if kw["api_key"] == "private-one" else 5
+        return AccountUsageSnapshot(
+            provider,
+            "test",
+            datetime.now(UTC),
+            windows=(AccountUsageWindow("Week", used),),
+        )
+
+    monkeypatch.setattr(report, "fetch_account_usage", fetch)
+    monkeypatch.setattr(report, "load_external_accounts", lambda *_: [])
+    rows = report.collect_accounts()
+    assert [r["windows"][0]["remaining_percent"] for r in rows] == [5, 95]
+    assert all(k["read_only"] is True for _, k in calls)
+    assert [k["api_key"] for _, k in calls] == ["private-one", "private-two"]
+    assert "private-" not in json.dumps(rows)
+
+
+def test_duplicate_credential_dedupes_without_query_rotation(monkeypatch):
+    monkeypatch.setattr(
+        report,
+        "read_credential_pool",
+        lambda: {
+            "anthropic": [
+                entry("same-private-token", "one"),
+                entry("same-private-token", "alias"),
+            ]
+        },
+    )
+    monkeypatch.setattr(report, "fetch_account_usage", lambda *_a, **_kw: None)
+    monkeypatch.setattr(report, "load_external_accounts", lambda *_: [])
+    rows = report.collect_accounts()
+    assert len(rows) == 1
+    assert rows[0]["state"] == "unknown"
+    assert rows[0]["windows"] == []
+
+
+def test_dead_credential_is_visible_without_fetch(monkeypatch):
+    raw = entry("private-key", "dead")
+    raw["last_status"] = "dead"
+    monkeypatch.setattr(report, "read_credential_pool", lambda: {"anthropic": [raw]})
+    monkeypatch.setattr(
+        report,
+        "fetch_account_usage",
+        lambda *_a, **_k: (_ for _ in ()).throw(AssertionError("dead entry queried")),
+    )
+    monkeypatch.setattr(report, "load_external_accounts", lambda *_: [])
+    assert report.collect_accounts()[0]["state"] == "unavailable"
+
+
+def test_provider_filter_does_not_query_sibling(monkeypatch):
+    monkeypatch.setattr(
+        report,
+        "read_credential_pool",
+        lambda: {
+            "anthropic": [entry("one", "claude")],
+            "openai-codex": [entry("two", "codex")],
+        },
+    )
+    seen = []
+    monkeypatch.setattr(
+        report, "fetch_account_usage", lambda provider, **_k: seen.append(provider)
+    )
+    monkeypatch.setattr(report, "load_external_accounts", lambda *_: [])
+    assert [r["provider"] for r in report.collect_accounts("anthropic")] == [
+        "anthropic"
+    ]
+    assert seen == ["anthropic"]
+
+
+def external(home, rows):
+    p = home / "state/account-usage/external.json"
+    p.parent.mkdir(parents=True)
+    p.write_text(json.dumps({"accounts": rows}))
+    return p
+
+
+def test_external_fresh_rows_are_sanitized_and_scoped(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    external(
+        tmp_path,
+        [
+            {
+                "provider": "agy",
+                "id": "agy-one",
+                "label": "AGY",
+                "fetched_at": datetime.now(UTC).isoformat(),
+                "windows": [
+                    {
+                        "label": "Gemini week",
+                        "used_percent": 27,
+                        "scope": "model",
+                        "resets_at": None,
+                    }
+                ],
+                "access_token": "DO_NOT_LEAK",
+                "raw": {"secret": "DO_NOT_LEAK"},
+            }
+        ],
+    )
+    rows = report.load_external_accounts()
+    assert rows[0]["windows"][0]["remaining_percent"] == 73
+    assert rows[0]["windows"][0]["scope"] == "model"
+    assert "DO_NOT_LEAK" not in json.dumps(rows)
+
+
+def test_stale_external_never_looks_like_live_quota(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    external(
+        tmp_path,
+        [
+            {
+                "provider": "agy",
+                "id": "one",
+                "label": "AGY",
+                "fetched_at": (datetime.now(UTC) - timedelta(hours=2)).isoformat(),
+                "windows": [{"label": "Week", "used_percent": 0}],
+            }
+        ],
+    )
+    row = report.load_external_accounts()[0]
+    assert row["state"] == "unknown" and row["windows"] == [] and row["stale"] is True
+
+
+def test_missing_or_malformed_external_snapshot_is_unavailable(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    assert report.load_external_accounts() == []
+    p = external(tmp_path, [])
+    p.write_text("{bad")
+    assert report.load_external_accounts() == []
+
+
+def test_all_accounts_cli_is_json_without_legacy_selection(monkeypatch, capsys):
+    monkeypatch.setattr(
+        report,
+        "collect_accounts",
+        lambda provider=None: [
+            {"provider": "agy", "label": "AGY", "state": "unknown", "windows": []}
+        ],
+    )
+    assert (
+        cmd_usage(argparse.Namespace(all_accounts=True, provider=None, json=True)) == 0
+    )
+    data = json.loads(capsys.readouterr().out)
+    assert data["accounts"][0]["state"] == "unknown"
+    assert "fetched_at" in data
+
+
+def test_live_alias_takes_precedence_over_dead_alias(monkeypatch):
+    dead = entry("one-account-token", "dead")
+    dead["last_status"] = "dead"
+    live = entry("one-account-token", "live")
+    monkeypatch.setattr(
+        report, "read_credential_pool", lambda: {"anthropic": [dead, live]}
+    )
+    monkeypatch.setattr(report, "load_external_accounts", lambda *_: [])
+    monkeypatch.setattr(
+        report,
+        "fetch_account_usage",
+        lambda *_a, **_k: AccountUsageSnapshot(
+            "anthropic",
+            "test",
+            datetime.now(UTC),
+            windows=(AccountUsageWindow("Week", 10),),
+        ),
+    )
+    row = report.collect_accounts()[0]
+    assert row["label"] == "live" and row["state"] == "ready"
+
+
+def test_invalid_external_windows_do_not_crash_or_claim_zero_used(
+    tmp_path, monkeypatch
+):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    external(
+        tmp_path,
+        [
+            {
+                "provider": "agy",
+                "id": "one",
+                "fetched_at": datetime.now(UTC).isoformat(),
+                "windows": ["bad", {"label": "Week", "used_percent": float("nan")}],
+            }
+        ],
+    )
+    row = report.load_external_accounts()[0]
+    assert row["windows"] == [] and row["state"] == "unknown"
