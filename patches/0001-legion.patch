+"""A restored Fast preference must reach the serialized request without CLI setup."""
+
+import json
+from types import SimpleNamespace
+
+import httpx
+import pytest
+from openai import OpenAI
+
+from agent.fast_mode import effective_request_overrides
+from agent.transports.codex import ResponsesApiTransport
+
+
+@pytest.mark.parametrize("model,tier,overrides,expected", [
+    ("gpt-6.1-sol", "priority", {}, "priority"),
+    ("gpt-6-astra", "ultrafast", {}, "ultrafast"),
+    ("gpt-6.1-sol", "priority", {"service_tier": "default"}, "default"),
+    ("gpt-6.1-sol", None, {}, None),
+])
+def test_restored_tier_reaches_codex_wire(model, tier, overrides, expected):
+    agent = SimpleNamespace(
+        model=model, service_tier=tier, request_overrides=overrides,
+        provider="openai-codex", api_mode="codex_responses",
+        base_url="https://chatgpt.com/backend-api/codex",
+    )
+    bodies = []
+
+    def receive(request):
+        bodies.append(json.loads(request.content))
+        return httpx.Response(200, json={
+            "id": "resp_fixture", "object": "response", "created_at": 0,
+            "model": model, "status": "completed", "output": [],
+        })
+
+    kwargs = ResponsesApiTransport().build_kwargs(
+        model=model, messages=[{"role": "user", "content": "hello"}],
+        instructions="fixture", reasoning_config={"effort": "medium", "enabled": True},
+        provider=agent.provider, base_url=agent.base_url, is_codex_backend=True,
+        request_overrides=effective_request_overrides(agent),
+    )
+    with OpenAI(
+        api_key="fixture", base_url=agent.base_url, max_retries=0,
+        http_client=httpx.Client(transport=httpx.MockTransport(receive)),
+    ) as client:
+        client.responses.create(**kwargs, stream=False)
+    assert bodies[0].get("service_tier") == expected
+    assert bodies[0]["reasoning"]["effort"] == "medium"
+    assert agent.request_overrides == overrides
+    assert agent.service_tier == tier
+
+
+@pytest.mark.parametrize("provider,base_url", [
+    ("openrouter", "https://openrouter.ai/api/v1"),
+    ("openai", "https://proxy.example.com/v1"),
+])
+def test_restored_tier_does_not_inject_fast_into_an_unsupported_route(provider, base_url):
+    agent = SimpleNamespace(
+        model="gpt-6.1-sol", service_tier="priority", provider=provider,
+        base_url=base_url, request_overrides={"temperature": 0.3},
+    )
+    assert effective_request_overrides(agent) == {"temperature": 0.3}
