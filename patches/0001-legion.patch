@@ -0,0 +1,104 @@
+import fs from 'node:fs';
+import vm from 'node:vm';
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+// Execute the complete shipped plugin through its SDK, not extracted source fragments.
+const bundle = fs.readFileSync(new URL('../plugins/kanban/dashboard/dist/index.js', import.meta.url), 'utf8');
+function nodes(value) {
+  if (!value || typeof value !== 'object') return [];
+  if (Array.isArray(value)) return value.flatMap(nodes);
+  return [value, ...nodes(value.children)];
+}
+function component(tree, name) {
+  const node = nodes(tree).find(n => typeof n.type === 'function' && n.type.name === name);
+  assert.ok(node, `rendered ${name}`);
+  return node;
+}
+async function renderHistory(run) {
+  let Page, current, cursor, effects;
+  const stores = new Map();
+  const hooks = {
+    useState(initial) {
+      const store = current, i = cursor++;
+      if (!(i in store)) store[i] = typeof initial === 'function' ? initial() : initial;
+      return [store[i], value => { store[i] = typeof value === 'function' ? value(store[i]) : value; }];
+    },
+    useRef(value) { return hooks.useState(() => ({current: value}))[0]; },
+    useEffect(fn) { effects.push(fn); },
+    useMemo(fn) { return fn(); },
+    useCallback(fn) { return fn; },
+  };
+  const task = {id:'t_test', title:'Offline task', status:'done', assignee:'developer', created_at:100};
+  const sdk = {
+    React: {...hooks, Component:class {}, createElement:(type, props, ...children) => ({type, props:props || {}, children})},
+    hooks, components: {}, utils:{cn:(...x) => x.filter(Boolean).join(' '), timeAgo:() => ''},
+    async fetchJSON(url, options) {
+      assert.ok(!options || !options.method || options.method === 'GET', 'read only fixture');
+      const path = new URL(url, 'http://offline').pathname;
+      if (path.endsWith('/config')) return {};
+      if (path.endsWith('/boards')) return {boards:[{slug:'default'}],current:'default'};
+      if (path.endsWith('/board')) return {columns:[{name:'done',tasks:[task]}],assignees:[],tenants:[]};
+      if (path.endsWith('/tasks/t_test')) return {task,runs:[run],comments:[],events:[],attachments:[]};
+      if (path.endsWith('/home-channels')) return {home_channels:[]};
+      assert.fail(`unexpected request ${path}`);
+    },
+    buildWsUrl: async () => 'ws://offline',
+  };
+  const window = {__HERMES_PLUGIN_SDK__:sdk,__HERMES_PLUGINS__:{register:(_name, fn) => {Page=fn;}},
+    localStorage:{getItem:() => null,setItem:() => {}},addEventListener:() => {},removeEventListener:() => {}};
+  vm.runInNewContext(bundle, {window, URLSearchParams, console,
+    WebSocket:class {close() {}}, setTimeout:() => 0,clearTimeout:() => {}}, {timeout:2000});
+  async function render(type, props={}, runEffects=false) {
+    if (!stores.has(type)) stores.set(type, []);
+    current=stores.get(type);cursor=0;effects=[];
+    const tree=type(props);
+    if (runEffects) {for (const fn of effects) fn(); for(let i=0;i<8;i++) await Promise.resolve();}
+    return tree;
+  }
+  await render(Page,{},true);
+  const page=await render(Page);
+  component(page,'BoardColumns').props.onOpen('t_test');
+  const drawer=component(await render(Page),'TaskDrawer');
+  await render(drawer.type,drawer.props,true);
+  const detail=component(await render(drawer.type,drawer.props),'TaskDetail');
+  const history=component(await render(detail.type,detail.props),'RunHistorySection');
+  const tree=await render(history.type,history.props);
+  const activity=component(tree,'RunActivity');
+  return {header:JSON.stringify(tree),detail:JSON.stringify(await render(activity.type,activity.props))};
+}
+
+test('old run has exact card duration and no invented phase timing', async () => {
+  const result=await renderHistory({id:1,started_at:100,ended_at:428});
+  assert.match(result.header,/5m 28s/);
+  assert.match(result.detail,/Phase timing unavailable/);
+});
+test('completion closing work shares one snapshot total with header and phases', async () => {
+  const run={id:1,started_at:100,ended_at:360,activity:{live:false,phase:'between_calls',
+    observed_at:367,seconds:{model:197,reading:20,tools:44.6,between_calls:2.4},
+    unobserved_start_seconds:3,after_completion_seconds:7}};
+  const result=await renderHistory(run);
+  assert.match(result.header,/วัดได้ 4m 27.0s/);
+  assert.match(result.detail,/รวมที่วัดได้ 267.0s/);
+  assert.match(result.detail,/การ์ดปิดที่ 4m 20s/);
+  assert.match(result.detail,/หลังการ์ดปิด 7.0s/);
+});
+test('active snapshots do not grow when wall time advances', async () => {
+  const run={id:1,started_at:100,activity:{live:true,phase:'model',observed_at:110,
+    seconds:{model:7},unobserved_start_seconds:3}};
+  const result=await renderHistory(run);
+  assert.match(result.header,/วัดได้ 10.0s/);
+  assert.match(result.detail,/ไม่รวมเวลาหลังบันทึก/);
+});
+test('unobserved terminal tail is disclosed, never attributed to model', async () => {
+  const run={id:1,started_at:100,ended_at:120,activity:{live:false,phase:'model',observed_at:110,
+    seconds:{model:7},unobserved_start_seconds:3,unobserved_tail_seconds:10}};
+  const result=await renderHistory(run);
+  assert.match(result.header,/วัดได้ 10.0s/);
+  assert.match(result.detail,/ยังไม่ได้วัด 10.0s/);
+});
+test('fractional carry and hours retain exact minute-second display', async () => {
+  const result=await renderHistory({id:1,started_at:100,ended_at:4000,activity:{live:false,
+    observed_at:3759.96,seconds:{model:3656.96},unobserved_start_seconds:3}});
+  assert.match(result.header,/วัดได้ 1h 1m 0.0s/);
+});
