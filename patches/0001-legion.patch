+
+
+def test_held_routes_do_not_spend_local_attempt_budget(setup, monkeypatch):
+    _, post, response = setup
+    response.status_code = 429
+    response.json.return_value = {"error": {"code": "rate_limit_exceeded"}}
+    assert ps.suggest_prompt("first context") == ""
+    now = ps.time.time()
+    monkeypatch.setattr(ps.time, "time", lambda: now + 61)
+    assert ps.suggest_prompt("different context") == ""
+    assert post.call_count == 1
+    with ps._open_cache() as conn:
+        assert conn.execute("SELECT SUM(cost) FROM calls").fetchone()[0] == 1
