diff --git a/hermes_cli/web_routers/file_preview.py b/hermes_cli/web_routers/file_preview.py
new file mode 100644
--- /dev/null
+++ b/hermes_cli/web_routers/file_preview.py
@@ -0,0 +1,68 @@
+"""Bounded, origin-scoped file preview checks. Returns no file content."""
+import asyncio
+from pathlib import Path
+from typing import Optional,Annotated
+from fastapi import APIRouter, HTTPException, Request
+from pydantic import BaseModel, Field
+from hermes_cli.ssh_workspace_fs import SshWorkspaceFsError
+
+router = APIRouter()
+_PREVIEW_MEDIA_MIMES = frozenset({'application/pdf','image/png','image/jpeg','image/gif','image/webp','image/svg+xml','image/bmp','image/x-icon','image/avif','audio/mpeg','audio/wav','audio/x-wav','audio/ogg','audio/flac','audio/x-flac','audio/mp4','audio/webm','audio/aac','video/mp4','video/webm','video/ogg'})
+
+class PreviewCheck(BaseModel):
+    session_id: str = Field(min_length=1, max_length=512)
+    paths: list[Annotated[str,Field(min_length=1,max_length=8192)]] = Field(max_length=64)
+
+
+def _format_state(path: Path, size: int) -> str:
+    from hermes_cli.web_routers import files
+    from hermes_cli.web_server import _FS_DATA_URL_MAX_BYTES
+    mime = files._fs_mime_type(path).split(';',1)[0]
+    if mime.startswith(('image/', 'audio/', 'video/')) or mime == 'application/pdf':
+        if mime not in _PREVIEW_MEDIA_MIMES:
+            return 'unsupported'
+        return 'ready' if size <= _FS_DATA_URL_MAX_BYTES else 'too_large'
+    if mime.startswith('text/') or path.suffix.lower() in files._FS_PREVIEW_LANGUAGE_BY_EXT:
+        return 'ready' if size <= files._FS_TEXT_SOURCE_MAX_BYTES else 'too_large'
+    return 'unsupported'
+
+
+def _check_path(raw: str, backend, cwd: str, request: Request) -> dict:
+    from hermes_cli.web_routers import files
+    state = 'unavailable'
+    try:
+        if backend is None:
+            target = files._fs_path(raw, cwd=cwd)
+            files._hosted_fs_read_guard(target, request)
+            target, st = files._fs_regular_file(target)
+            state = _format_state(target, st.st_size)
+            if state == 'ready':
+                prefix = files._fs_read_bytes(target, min(st.st_size,4096))
+                if files._fs_mime_type(target).startswith('text/') and files._fs_looks_binary(prefix):
+                    state = 'unsupported'
+        else:
+            if not Path(raw).is_absolute():
+                return {'path':raw,'state':'unavailable'}
+            target, size = backend.inspect_file(raw)
+            if files._is_sensitive_path(Path(target)):
+                return {'path':raw,'state':'unreadable'}
+            state = _format_state(Path(target),size)
+            if state == 'ready':
+                backend.read_bytes(target,max_bytes=files._FS_TEXT_SOURCE_MAX_BYTES,read_limit=4096)
+    except HTTPException as exc:
+        state = {404:'missing',403:'unreadable',413:'too_large'}.get(exc.status_code,'unavailable')
+    except (OSError,ValueError) as exc:
+        state = 'missing' if isinstance(exc,FileNotFoundError) else 'unreadable'
+    except SshWorkspaceFsError as exc:
+        state = {'ENOENT':'missing','EACCES':'unreadable'}.get(exc.code,'unavailable')
+    return {'path':raw,'state':state}
+
+
+@router.post('/api/fs/preview-check')
+async def preview_check(payload: PreviewCheck, request: Request, profile: Optional[str] = None):
+    from hermes_cli.web_routers import files, sessions
+    session = await sessions.get_session_detail(payload.session_id,profile)
+    backend = await asyncio.to_thread(files._fs_backend,profile)
+    def inspect():
+        return [_check_path(path,backend,session.get('cwd') or '',request) for path in payload.paths]
+    return {'files':await asyncio.to_thread(inspect)}
diff --git a/apps/desktop/src/plugins/kanban/workflow-model.ts b/apps/desktop/src/plugins/kanban/workflow-model.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/workflow-model.ts
@@ -0,0 +1,110 @@
+import type { KanbanBoard, KanbanLink, KanbanRun, KanbanTask } from './types'
+
+export const WORKFLOW_NODE_LIMIT = 80
+const TERMINAL = new Set(['done', 'archived'])
+export const NODE_WIDTH = 240,
+  NODE_HEIGHT = 106,
+  COLUMN_GAP = 76,
+  ROW_GAP = 28
+export interface WorkflowNode {
+  task: KanbanTask
+  displayStatus: string
+  rank: number
+  row: number
+}
+
+function includeAncestors(seed: string[], links: KanbanLink[], known: ReadonlyMap<string, unknown>, limit: number) {
+  const ids = new Set(seed.slice(0, limit))
+  const parents = new Map<string, string[]>()
+  for (const link of links) parents.set(link.child_id, [...(parents.get(link.child_id) ?? []), link.parent_id])
+  for (const id of ids) {
+    for (const parent of parents.get(id) ?? []) {
+      if (ids.size < limit && known.has(parent)) ids.add(parent)
+    }
+  }
+  return ids
+}
+
+function dependencyRanks(ids: Set<string>, edges: KanbanLink[]) {
+  const incoming = new Map([...ids].map(id => [id, 0])),
+    children = new Map<string, string[]>()
+  for (const edge of edges) {
+    incoming.set(edge.child_id, (incoming.get(edge.child_id) ?? 0) + 1)
+    children.set(edge.parent_id, [...(children.get(edge.parent_id) ?? []), edge.child_id])
+  }
+  const queue = [...ids].filter(id => incoming.get(id) === 0),
+    ranks = new Map<string, number>()
+  for (const id of queue) {
+    const rank = ranks.get(id) ?? 0
+    for (const child of children.get(id) ?? []) {
+      ranks.set(child, Math.max(ranks.get(child) ?? 0, rank + 1))
+      incoming.set(child, incoming.get(child)! - 1)
+      if (incoming.get(child) === 0) queue.push(child)
+    }
+  }
+  return { ranks, cyclic: queue.length < ids.size }
+}
+
+/** Edges come only from native dependency records; status never invents ordering. */
+export function workflowGraph(board: KanbanBoard, nodeLimit = WORKFLOW_NODE_LIMIT, edgeLimit = 240) {
+  const all = new Map(
+    board.columns.flatMap(col => col.tasks.map(task => [task.id, { task, displayStatus: col.name }] as const))
+  )
+  const active = [...all.values()].filter(node => !TERMINAL.has(node.displayStatus)).map(node => node.task.id)
+  const links = board.links ?? [],
+    ids = includeAncestors(active, links, all, Math.max(0, nodeLimit))
+  const unique = [...new Map(links.map(edge => [`${edge.parent_id}\0${edge.child_id}`, edge])).values()]
+  const visible = unique.filter(edge => ids.has(edge.parent_id) && ids.has(edge.child_id))
+  const { ranks, cyclic } = dependencyRanks(ids, visible),
+    rows = new Map<number, number>()
+  const nodes: WorkflowNode[] = [...ids].map(id => {
+    const rank = ranks.get(id) ?? 0,
+      row = rows.get(rank) ?? 0
+    rows.set(rank, row + 1)
+    return { ...all.get(id)!, rank, row }
+  })
+  return {
+    nodes,
+    edges: visible.slice(0, edgeLimit),
+    linksKnown: Array.isArray(board.links),
+    cyclic,
+    omittedNodes: Math.max(0, active.length - nodes.filter(n => !TERMINAL.has(n.displayStatus)).length),
+    omittedEdges: Math.max(
+      0,
+      unique.filter(e => ids.has(e.parent_id) || ids.has(e.child_id)).length - Math.min(visible.length, edgeLimit)
+    ),
+    width: Math.max(1, ...nodes.map(n => n.rank + 1)) * (NODE_WIDTH + COLUMN_GAP),
+    height: Math.max(1, ...nodes.map(n => n.row + 1)) * (NODE_HEIGHT + ROW_GAP)
+  }
+}
+
+export function orderedBotRuns(runs: readonly KanbanRun[], limit = 30): KanbanRun[] {
+  const time = (run: KanbanRun) => (Number.isFinite(run.started_at) && run.started_at! > 0 ? run.started_at! : Infinity)
+  return [...runs]
+    .sort((a, b) => time(a) - time(b) || String(a.id).localeCompare(String(b.id), undefined, { numeric: true }))
+    .slice(0, limit)
+}
+
+/** Walk backwards through visible native links. A visited set terminates cycles. */
+export function workflowAncestry(selected: string, links: readonly KanbanLink[]) {
+  const nodes = new Set([selected]),
+    edges = new Set<string>()
+  for (const child of nodes)
+    for (const edge of links)
+      if (edge.child_id === child) {
+        nodes.add(edge.parent_id)
+        edges.add(`${edge.parent_id}:${edge.child_id}`)
+      }
+  return { nodes, edges }
+}
+export function workflowIsActive(task: KanbanTask, now = Date.now() / 1000) {
+  const heartbeat = task.last_heartbeat_at
+  return (
+    task.status === 'running' &&
+    Boolean(task.worker_pid && task.worker_pid > 0) &&
+    typeof heartbeat === 'number' &&
+    Number.isFinite(heartbeat) &&
+    now - heartbeat >= 0 &&
+    now - heartbeat <= 120
+  )
+}
