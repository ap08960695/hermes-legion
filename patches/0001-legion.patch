+const contract = {
+  outcome: '',
+  verification: 'Existing check',
+  constraints: 'Keep quota',
+  boundaries: '',
+  stop_when: ''
+}
+
+describe('native goal form', () => {
+  it('saves one revision-bound intent with the exact chosen skills and no implicit start', async () => {
+    const save = vi.fn(async (_id: string, _args: GoalFormArgs) => {})
+    render(
+      <GoalEditor
+        open
