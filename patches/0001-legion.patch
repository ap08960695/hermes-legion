diff --git a/agent/shared_prompt_cache.py b/agent/shared_prompt_cache.py
new file mode 100644
index 0000000000000000000000000000000000000000..aab5a705cd5150764523be80b933c4f2c8b79308
--- /dev/null
+++ b/agent/shared_prompt_cache.py
@@ -0,0 +1,94 @@
+"""Versioned common prefixes; existing v1 conversations retain their exact key.
+
+Cache keys never grant access to another bot's history or tools. Shared leading tool
+schemas are a cache candidate, not proof of a provider breakpoint or cache hit.
+"""
+import hashlib
+import json
+from urllib.parse import urlsplit
+
+HEADER = '[Hermes common operating rules v3]'
+END = '[/Hermes common operating rules v3]'
+V2_HEADER = '[Hermes common operating rules v2]'
+V2_END = '[/Hermes common operating rules v2]'
+LEGACY_HEADER = '[Hermes common operating rules v1]'
+LEGACY_END = '[/Hermes common operating rules v1]'
+
+# Order hints for already-granted, broadly used tools, NOT an enabled-tool registry.
+# Role-specific browser, credential, delegation and dynamic catalog schemas follow.
+_SHARED_TOOL_ORDER = ('read_file', 'search_files', 'terminal', 'process_manage', 'patch',
+                      'write_file', 'skills_list', 'skill_view', 'skill_manage', 'todo_list')
+_SHARED_TOOL_RANK = {name: i for i, name in enumerate(_SHARED_TOOL_ORDER)}
+
+
+def canonical_tools(tools):
+    """New prompt builds only: own schemas, keep native slots and every capability."""
+    if not tools:
+        return tools
+    copied = json.loads(json.dumps(tools, sort_keys=True, ensure_ascii=False))
+    slots = [i for i, t in enumerate(copied)
+             if isinstance(t, dict) and isinstance(t.get('function'), dict) and t.get('type', 'function') == 'function']
+    def rank(tool):
+        name = tool['function'].get('name', '')
+        return (_SHARED_TOOL_RANK.get(name, len(_SHARED_TOOL_RANK)), name)
+    ordered = sorted((copied[i] for i in slots), key=rank)
+    for i, tool in zip(slots, ordered):
+        copied[i] = tool
+    return copied
+
+
+def common_prefix(instructions):
+    """Recognize both persisted layouts without rewriting either."""
+    if not isinstance(instructions, str):
+        return None
+    for header, end_marker in ((HEADER, END), (V2_HEADER, V2_END), (LEGACY_HEADER, LEGACY_END)):
+        if instructions.startswith(header + '\n\n'):
+            end = instructions.find('\n\n' + end_marker)
+            if end >= 0:
+                return instructions[:end + 2 + len(end_marker)]
+    return None
+
+
+def shared_tool_prefix(tools):
+    """Exact leading Responses function schemas; stop at the first non-shared entry."""
+    prefix = []
+    previous = -1
+    for tool in tools or []:
+        if not isinstance(tool, dict) or tool.get('type') != 'function':
+            break
+        rank = _SHARED_TOOL_RANK.get(tool.get('name'), -1)
+        if rank <= previous:
+            break
+        prefix.append(tool)
+        previous = rank
+    return prefix
+
+
+def shared_cache_key(instructions, tools, model, base_url):
+    """Public-prefix cohorts on existing exact OpenAI routes; no TTL/route changes."""
+    url = urlsplit(str(base_url or ''))
+    if url.hostname not in {'api.openai.com', 'chatgpt.com'}:
+        return None
+    if url.hostname == 'chatgpt.com' and not url.path.rstrip('/').endswith('/backend-api/codex'):
+        return None
+    prefix = common_prefix(instructions)
+    if prefix is None:
+        return None
+    legacy = instructions.startswith(LEGACY_HEADER + '\n\n')
+    # V1 includes the entire tool array exactly as before. V2 groups requests by
+    # their actual shared leading schemas; private role tails still go unchanged
+    # on the wire and provider matching still requires an eligible exact prefix.
+    cohort_tools = tools if legacy else (shared_tool_prefix(tools) or tools)
+    payload = json.dumps([url.hostname, url.path, model, prefix, cohort_tools],
+                         sort_keys=True, ensure_ascii=False, separators=(',', ':'))
+    version = layout_version(instructions)
+    return f'hsp{version}_' + hashlib.sha256(payload.encode()).hexdigest()[:40]
+
+
+def layout_version(instructions):
+    if not isinstance(instructions, str):
+        return 0
+    for version, header in ((3, HEADER), (2, V2_HEADER), (1, LEGACY_HEADER)):
+        if instructions.startswith(header + '\n\n'):
+            return version
+    return 0
