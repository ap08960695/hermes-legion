new file mode 100644
index 0000000000000000000000000000000000000000..7972af6c0aececd154b3dfb4d338616e9d472a68
--- /dev/null
+++ b/agent/cache_change_evidence.py
@@ -0,0 +1,57 @@
+"""Explain observed request changes with bounded digests, never prompt bodies."""
+_POLICIES = {
+    'ready_before_wait': '<!-- captain-ready-before-wait-v1 -->',
+    'decision_autonomy': '<!-- captain-decision-autonomy-v1 -->',
+    'execution_reference': 'Captain execution evidence v1',
+}
+
+
+def policy_evidence(request):
+    effective = dict(request)
+    if isinstance(request.get('extra_body'), dict):
+        effective.update(request['extra_body'])
+    value = effective.get('instructions', effective.get('system'))
+    if value is None:
+        value = [m.get('content') for m in effective.get('messages', [])
+                 if isinstance(m, dict) and m.get('role') in {'system', 'developer'}]
+    # Iterative, bounded traversal of text blocks, no copies of the full context.
+    stack, remaining, found = [value], 2 * 1024 * 1024, set()
+    visited = 0
+    while stack and remaining > 0 and visited < 4096:
+        part = stack.pop()
+        visited += 1
+        if isinstance(part, str):
+            text = part[:remaining]
+            remaining -= len(text)
+            found.update(name for name, marker in _POLICIES.items() if marker in text)
+        elif isinstance(part, list):
+            stack.extend(reversed(part[:4096]))
+        elif isinstance(part, dict):
+            stack.append(part.get('text', part.get('content')))
+    return {'markers_present': sorted(found), 'scan_complete': not stack and remaining > 0,
+            'evidence': 'prepared_instruction_marker_only_not_behavior_or_authorization'}
+
+
+def transition(agent, fingerprint):
+    """Agent-local, scope-bound state. Only compact hashes survive a request."""
+    names = ('route', 'instructions', 'tools', 'options', 'history')
+    def value(name):
+        part = fingerprint.get(name, {})
+        return part.get('hash') if part.get('complete') else None
+    scope = (fingerprint.get('key_id'), value('session'))
+    current = {name: value(name) for name in names}
+    prefixes = fingerprint.get('history', {}).get('prefixes', {})
+    current['history_prefixes'] = {k: v for k, v in prefixes.items() if k in {'4096','16384','65536','262144','1048576','4194304'}}
+    previous = getattr(agent, '_cache_change_evidence', None)
+    agent._cache_change_evidence = (scope, current)
+    if previous is None or previous[0] != scope or None in scope:
+        return {'baseline': True, 'changed': [], 'cause_of_cache_miss_proven': False}
+    changed = [name for name in names if current[name] is not None and previous[1].get(name) is not None
+               and current[name] != previous[1][name]]
+    unknown = [name for name in names if current[name] is None or previous[1].get(name) is None]
+    old_prefixes = previous[1].get('history_prefixes', {})
+    equal = [int(k) for k, v in current['history_prefixes'].items() if old_prefixes.get(k) == v]
+    return {'baseline': False, 'changed': changed, 'unknown': unknown,
+            'history_equal_prefix_bytes': max(equal, default=None),
+            'history_change_does_not_imply_prefix_change': True,
+            'cause_of_cache_miss_proven': False}
diff --git a/agent/cache_cross_bot_diagnostics.py b/agent/cache_cross_bot_diagnostics.py
new file mode 100644
index 0000000000000000000000000000000000000000..8afb3638d40ba912eb8c2ef5af4a570e80b08c08
--- /dev/null
+++ b/agent/cache_cross_bot_diagnostics.py
@@ -0,0 +1,116 @@
+"""Same-installation, content-free cache comparisons; never a cache policy change.
+
+Only keyed digests leave this module. Declared account headers are not authenticated
+account proof, and matching request fields never prove the origin of a provider hit.
+"""
+from __future__ import annotations
+
+import hashlib
+import hmac
+import os
+from pathlib import Path
+import stat
+import tempfile
+import time
+
+_MAX_BYTES = 512 * 1024
+_ACCOUNT_HEADERS = ('chatgpt-account-id', 'openai-organization', 'openai-project')
+
+
+def _installation_key(home: Path) -> bytes:
+    from hermes_constants import get_default_hermes_root
+
+    directory = get_default_hermes_root(home=home) / 'telemetry' / 'cache-cross-bot-v1'
+    directory.mkdir(parents=True, mode=0o700, exist_ok=True)
+    info = directory.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o077 or info.st_uid != os.getuid():
+        raise OSError('unsafe diagnostic directory')
+    target = directory / 'fingerprint.key'
+    if not target.exists():
+        # Publish a complete key without replacing another process's winning key.
+        fd, name = tempfile.mkstemp(dir=directory, prefix='.key-')
+        try:
+            with os.fdopen(fd, 'wb') as stream:
+                stream.write(os.urandom(32))
+                stream.flush()
+                os.fsync(stream.fileno())
+            try:
+                os.link(name, target)
+            except FileExistsError:
+                pass
+        finally:
+            os.unlink(name)
+    fd = os.open(target, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
+    with os.fdopen(fd, 'rb') as stream:
+        info = os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077 or info.st_uid != os.getuid():
+            raise OSError('unsafe diagnostic key')
+        key = stream.read(33)
+    if len(key) != 32:
+        raise ValueError('incomplete diagnostic key')
+    return key
+
+
+def _declared_account(agent, request):
+    """Read only non-secret account selectors already staged for the request."""
+    headers = {}
+    defaults = getattr(agent, '_client_kwargs', {}) or {}
+    for source in (defaults.get('default_headers') or {}, request.get('extra_headers') or {}):
+        for name, value in source.items():
+            normalized = str(name).lower()
+            if normalized in _ACCOUNT_HEADERS:
+                headers[normalized] = value
+    # Do not read tokens, credentials, auth files or SDK properties to fill gaps.
+    return {name: value for name, value in headers.items() if isinstance(value, str) and value} or None
+
+
+def fingerprint(agent, request, *, request_id: str) -> dict:
+    from agent.cache_request_diagnostics import _digest
+    from agent.shared_prompt_cache import layout_version, common_prefix, shared_tool_prefix
+    from hermes_constants import get_hermes_home
+
+    home = get_hermes_home()
+    key = _installation_key(home)
+    # Domain separation makes the installation-wide namespace distinct from local logs.
+    key = hmac.new(key, b'hermes-cross-bot-v1', hashlib.sha256).digest()
+    effective = dict(request)
+    if isinstance(request.get('extra_body'), dict):
+        effective.update(request['extra_body'])
+    instructions = effective.get('instructions', effective.get('system'))
+    if instructions is None:
+        instructions = [m for m in effective.get('messages', [])
+                        if isinstance(m, dict) and m.get('role') in {'system', 'developer'}]
+    common = common_prefix(instructions)
+    shared_tools = shared_tool_prefix(effective.get('tools')) if layout_version(instructions) >= 2 else None
+    # Small identity fields are hashed first so large schemas cannot hide the scope.
+    profile = str(home.resolve())
+    session = getattr(agent, 'session_id', None)
+    fields = {
+        'profile': profile,
+        'session': [profile, session] if session else None,
+        'request': request_id or None,
+        'route': [getattr(agent, 'base_url', None), effective.get('model'), getattr(agent, 'api_mode', None)],
+        'declared_account': _declared_account(agent, request),
+        'cache_key': effective.get('prompt_cache_key'),
+        'common_prefix': common,
+        'options': {name: effective.get(name) for name in (
+            'reasoning', 'text', 'tool_choice', 'parallel_tool_calls',
+            'prompt_cache_options', 'prompt_cache_retention',
+            'previous_response_id', 'conversation', 'context_management',
+            'thinking', 'output_config', 'speed', 'service_tier', 'cache_control')},
+        'shared_tools': shared_tools or None,
+        'tools': effective.get('tools'),
+        'instructions': instructions,
+    }
+    budget = [_MAX_BYTES]
+    digests = {name: _digest(key, value, budget, anchors=name in {'tools', 'shared_tools', 'instructions'})
+               if value is not None else None for name, value in fields.items()}
+    return {
+        'version': 1,
+        'scope': 'same_installation',
+        'namespace': hmac.new(key, b'namespace', hashlib.sha256).hexdigest()[:16],
+        'started_at_ns': time.time_ns(),
+        'fields': digests,
+        'complete': all(value is None or value['complete'] for value in digests.values()),
+        'account_evidence': 'declared_headers' if fields['declared_account'] else 'unknown',
+    }
