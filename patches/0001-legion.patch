+++ b/tests/gateway/test_scratch_housekeeping.py
@@ -0,0 +1,54 @@
+"""Scratch retention runs hourly under each served profile, without a startup sweep."""
+import os
+from pathlib import Path
+from types import SimpleNamespace
+import time
+
+import gateway.run as gateway_run
+import gateway.run_delivery_queue_watch as queue_watch
+import hermes_constants_scratch as scratch
+
+
+def test_hourly_tick_cleans_both_scoped_homes_after_the_first_hour(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    homes = [home, home / "profiles" / "worker"]
+    files = []
+    for directory in homes:
+        root = directory / "cache" / "scratch"
+        root.mkdir(parents=True)
+        (directory / "config.yaml").write_text("toolsets: []\n")
+        path = root / "unused.bin"
+        path.write_bytes(b"closed disposable data")
+        old = time.time() - 48 * 3600
+        os.utime(path, (old, old))
+        files.append(path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(scratch, "_active_scratch_paths", lambda _root: set())
+    monkeypatch.setattr(gateway_run, "_multiplex_profile_homes",
+                        lambda _config: [("default", homes[0]), ("worker", homes[1])])
+    monkeypatch.setattr(queue_watch, "DeliveryQueueWatch", lambda *args: None)
+    monkeypatch.setattr(queue_watch, "wait_for_next_tick",
+                        lambda stop, *_args: stop.wait(0))
+
+    def only_scratch_chore(label, callback, *args, **kwargs):
+        if label == "Scratch cache cleanup":
+            callback(*args, **kwargs)
+
+    monkeypatch.setattr(gateway_run, "_housekeeping_chore", only_scratch_chore)
+
+    class StopAfterHour:
+        ticks = 0
+
+        def is_set(self):
+            return self.ticks >= 60
+
+        def wait(self, _timeout):
+            self.ticks += 1
+            if self.ticks < 60:
+                assert all(path.exists() for path in files)
+            return self.is_set()
+
+    runner = SimpleNamespace(config=SimpleNamespace(multiplex_profiles=True))
+    gateway_run._start_gateway_housekeeping(StopAfterHour(), runner=runner, interval=0)
+    assert all(not path.exists() for path in files)
+    assert all((directory / "logs" / "scratch-prune.log").is_file() for directory in homes)
