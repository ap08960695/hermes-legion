index 0000000000000000000000000000000000000000..ed8e77cb68be42045819bb285d00808f8fa0cf23
--- /dev/null
+++ b/tui_gateway/session_kanban_delivery.py
@@ -0,0 +1,91 @@
+"""Recover and submit durable Kanban notifications through the existing TUI worker."""
+from __future__ import annotations
+
+from hermes_cli import kanban_db_tui_delivery as deliveries
+from tui_gateway.session_kanban_lineage import destination_keys
+
+
+def recover(session: dict, fresh: list) -> list:
+    from tui_gateway import server as s
+    from hermes_cli import kanban_db as kb
+    if not session.get('session_key') or session.get('_finalized'):
+        return fresh
+    recovered, seen = [], set()
+    try:
+        boards = kb.list_boards(include_archived=False)
+    except Exception:
+        boards = [kb.read_board_metadata(kb.DEFAULT_BOARD)]
+    for board in boards:
+        slug, path = s._kb_board_key(kb, board)
+        if path in seen:
+            continue
+        seen.add(path)
+        try:
+            pending = deliveries.pending(kb.kanban_db_path(slug), home=deliveries.owner_home(), session_key=None)
+            accepted = destination_keys(session, (text.delivery_ref.session_key for text in pending))
+            recovered.extend(text for text in pending if text.delivery_ref.session_key in accepted)
+        except Exception:
+            s.logger.exception('kanban pending receipt read failed on board %s', slug)
+    # Already prepared fresh rows are also present on disk; identity-based merge preserves events with identical text.
+    return merge(recovered, fresh)[0]
+
+
+def merge(existing: list, incoming: list) -> tuple[list, list]:
+    combined, added = list(existing), []
+    seen = {text.delivery_ref for text in existing if hasattr(text, 'delivery_ref')}
+    for text in incoming:
+        ref = getattr(text, 'delivery_ref', None)
+        if ref is not None and ref in seen:
+            continue
+        if ref is not None:
+            seen.add(ref)
+        combined.append(text)
+        added.append(text)
+    return combined, added
+
+
+def submit(rid: str, sid: str, session: dict, batch: list, *, diagnostic: bool) -> None:
+    """Known refusal is retryable; a started/unknown worker is retained, never replayed."""
+    from tui_gateway import server as s
+    from gateway.warning_notifications import render_notification
+    if not any(hasattr(text, 'delivery_ref') for text in batch):
+        s._notif_submit(rid, sid, session, '\n'.join(batch), 'kanban notification dispatch failed',
+                        **({'display_metadata': {'notification_category': 'diagnostic'}} if diagnostic else {}))
+        return  # Pre-upgrade in-memory buffers keep their existing dispatch contract.
+    claim = deliveries.Claim('', ())
+    prior_thread = session.get('_run_thread')
+    try:
+        with session['history_lock']:
+            if session.get('_turn_cancel_requested'):
+                raise RuntimeError('notification turn was stopped before admission')
+            generation = int(session.get('_queued_prompt_generation', 0))
+        accepted = destination_keys(session, (text.delivery_ref.session_key for text in batch
+                                              if hasattr(text, 'delivery_ref')))
+        batch = [text for text in batch if not hasattr(text, 'delivery_ref') or text.delivery_ref.session_key in accepted]
+        batch, claim = deliveries.claim(batch, home=deliveries.owner_home(), session_key=session['session_key'],
+                                         session_keys=tuple(accepted))
+        if not batch:
+            s._notif_release_turn(session)
+            return
+        render_notification(lambda: s._emit('message.start', sid), platform='tui', diagnostic=diagnostic)
+        kwargs = {'display_metadata': {'notification_category': 'diagnostic'}} if diagnostic else {}
+        kwargs['queued_prompt_generation'] = generation
+        if claim.refs:
+            def terminal(result):
+                state = result.get('status')
+                claim.mark(state if state in deliveries.TERMINAL else 'unknown')
+            kwargs['terminal_callback'] = terminal
+        if s._run_prompt_submit(rid, sid, session, '\n'.join(batch), **kwargs) is False:
+            claim.mark('pending')
