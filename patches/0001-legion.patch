+        result = ops.read_file_raw(str(path))
+        assert result.error and "not a regular file" in result.error
+        assert not result.not_found
+    assert ops._exec.call_count == 0
+
+
+def test_binary_and_image_contract(ops, tmp_path):
+    for name, data in [("nul.dat", b"a\x00b"), ("image.png", b"image"), ("source.zip", b"text")]:
+        path = tmp_path / name
+        path.write_bytes(data)
+        result = ops.read_file_raw(str(path))
+        assert result.is_binary and result.file_size == len(data)
+        assert bool(result.is_image) == (name == "image.png")
