@@ -0,0 +1,278 @@
+import type { ReadableAtom } from 'nanostores'
+import { type RefObject, useEffect, useRef, useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { Codicon } from '@/components/ui/codicon'
+import { Popover, PopoverAnchor, PopoverContent } from '@/components/ui/popover'
+import { Tip } from '@/components/ui/tooltip'
+import type { HermesGateway } from '@/hermes'
+import { useI18n } from '@/i18n'
+import { type ChatMessage, chatMessageText } from '@/lib/chat-messages'
+
+import { composerPlainText } from './rich-editor'
+
+export interface PromptPredictionProps {
+  editorRef: RefObject<HTMLDivElement | null>
+  messages: ReadableAtom<ChatMessage[]>
+  gateway: HermesGateway | null
+  sessionId: string | null
+  busy: boolean
+  blocked: boolean
+  compact?: boolean
+  onAccept: (text: string) => void
+}
+
+function conversation(messages: readonly ChatMessage[]) {
+  const visible = messages.filter(m => !m.hidden && !m.pending && (m.role === 'user' || m.role === 'assistant'))
+  const goal = visible.find(m => m.role === 'user')
+
+  const recent = visible
+    .slice(-6)
+    .map(m => `${m.role}: ${chatMessageText(m).slice(-400)}`)
+    .join('\n')
+
+  return `Original request: ${goal ? chatMessageText(goal).slice(0, 450) : ''}\n${recent.slice(-1150)}`
+}
+
+export function PromptPredictionControls({
+  editorRef,
+  messages,
+  gateway,
+  sessionId,
+  busy,
+  blocked,
+  compact = false,
+  onAccept
+}: PromptPredictionProps) {
+  const { t } = useI18n()
+  const [loading, setLoading] = useState(false)
+  const [empty, setEmpty] = useState(false)
+  const [prediction, setPrediction] = useState<{ text: string; draft: string; context: string } | null>(null)
+  const generation = useRef(0)
+  const composing = useRef(false)
+
+  useEffect(() => {
+    generation.current++
+    setPrediction(null)
+    setLoading(false)
+    setEmpty(false)
+
+    return () => {
+      // eslint-disable-next-line react-hooks/exhaustive-deps -- Invalidate the live request counter on cleanup; this is not a DOM ref.
+      generation.current++
+    }
+  }, [sessionId, gateway, busy, blocked])
+
+  // eslint-disable-next-line no-restricted-syntax -- Native IME event handlers own this ref; the effect only attaches them.
+  useEffect(() => {
+    const editor = editorRef.current
+
+    if (!editor) {
+      return
+    }
+
+    const change = () => {
+      setPrediction(null)
+      setEmpty(false)
+    }
+
+    const start = () => {
+      composing.current = true
+      change()
+    }
+
+    const end = () => {
+      composing.current = false
+      change()
+    }
+
+    const observer = new MutationObserver(change)
+    observer.observe(editor, { childList: true, subtree: true, characterData: true })
+    editor.addEventListener('input', change)
+    editor.addEventListener('compositionstart', start)
+    editor.addEventListener('compositionend', end)
+
+    return () => {
+      observer.disconnect()
+      editor.removeEventListener('input', change)
+      editor.removeEventListener('compositionstart', start)
+      editor.removeEventListener('compositionend', end)
+    }
+  }, [editorRef])
+
+  const accept = () => {
+    const editor = editorRef.current
+
+    if (
+      !prediction ||
+      !editor ||
+      composing.current ||
+      busy ||
+      blocked ||
+      composerPlainText(editor) !== prediction.draft ||
+      conversation(messages.get()) !== prediction.context
+    ) {
+      return
+    }
+
+    onAccept(prediction.text)
+    setPrediction(null)
+  }
+
+  useEffect(() => {
+    const editor = editorRef.current
+
+    if (!editor || !prediction) {
+      return
+    }
+
+    const keydown = (event: KeyboardEvent) => {
+      if (
+        composing.current ||
+        event.isComposing ||
+        event.keyCode === 229 ||
+        event.shiftKey ||
+        event.ctrlKey ||
+        event.metaKey ||
+        event.altKey
+      ) {
+        return
+      }
+
+      if (event.key !== 'Tab' && event.key !== 'Escape') {
+        return
+      }
+
+      if (composerPlainText(editor) !== prediction.draft) {
+        return
+      }
+
+      event.preventDefault()
+      event.stopImmediatePropagation()
+
+      if (event.key === 'Tab') {
+        accept()
+      } else {
+        setPrediction(null)
+      }
+    }
+
+    editor.addEventListener('keydown', keydown, true)
+
+    return () => editor.removeEventListener('keydown', keydown, true)
+  })
+
+  // Deliberately no timer, draft sampler, focus handler or transcript subscription
+  // that generates. Only this explicit user action can spend a prediction call.
+  const request = async () => {
+    const editor = editorRef.current
+
+    if (!gateway || !sessionId || !editor || busy || blocked || loading || composing.current) {
+      return
+    }
+
+    const draft = composerPlainText(editor)
+
+    const context = conversation(messages.get())
+    const ticket = ++generation.current
+    setLoading(true)
+    setPrediction(null)
+    setEmpty(false)
+
+    try {
+      const result = await gateway.request<{ text: string }>(
+        'llm.oneshot',
+        {
+          session_id: sessionId,
+          template: 'prompt_suggestions',
+          input: context,
+          variables: { draft },
+          max_tokens: 128
+        },
+        7000
+      )
+
+      if (
+        ticket !== generation.current ||
+        composing.current ||
+        composerPlainText(editor) !== draft ||
+        conversation(messages.get()) !== context
+      ) {
+        return
+      }
+
+      const text = result.text?.trim()
+
+      if (text && text.startsWith(draft) && text !== draft && text.length <= 180) {
+        setPrediction({ text, draft, context })
+      } else {
+        setEmpty(true)
+      }
+    } catch {
+      if (ticket === generation.current) {
+        setEmpty(true)
+      }
+    } finally {
+      if (ticket === generation.current) {
+        setLoading(false)
+      }
+    }
+  }
+
+  return (
+    <Popover
+      onOpenChange={open => {
+        if (!open) {
+          setPrediction(null)
+          setEmpty(false)
+        }
+      }}
+      open={Boolean(prediction) || empty}
+    >
+      <PopoverAnchor asChild>
+        <span className="inline-flex shrink-0 items-center">
+          <Tip label={t.composer.promptSuggestionHint} placement="control">
+            <Button
+              aria-label={t.composer.suggestPrompt}
+              className="h-(--composer-control-size) gap-1 rounded-md px-2 text-xs font-normal text-(--ui-text-tertiary) hover:bg-(--chrome-action-hover) hover:text-foreground"
+              disabled={busy || blocked || loading || !gateway || !sessionId}
+              onClick={() => void request()}
+              onMouseDown={event => event.preventDefault()}
+              size="xs"
+              type="button"
+              variant="ghost"
+            >
+              <Codicon name={loading ? 'loading' : 'lightbulb'} spinning={loading} />
+              {!compact && t.composer.suggestPrompt}
+            </Button>
+          </Tip>
+        </span>
+      </PopoverAnchor>
+      <PopoverContent
+        align="end"
+        className="w-auto max-w-[min(26rem,calc(100vw-2rem))] p-2"
+        onCloseAutoFocus={event => event.preventDefault()}
+        onOpenAutoFocus={event => event.preventDefault()}
+        side="top"
+      >
+        {prediction ? (
+          <Button
+            className="h-auto whitespace-normal text-left"
+            onClick={accept}
+            onMouseDown={event => event.preventDefault()}
+            size="xs"
+            type="button"
+            variant="text"
+          >
+            <span>{prediction.text}</span>
+            <kbd>Tab</kbd>
+          </Button>
+        ) : (
+          <span className="text-xs text-muted-foreground" role="status">
+            {t.composer.noPromptSuggestion}
+          </span>
+        )}
+      </PopoverContent>
+    </Popover>
+  )
+}
