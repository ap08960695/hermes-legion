new file mode 100644
index 0000000000000000000000000000000000000000..e5549c1d40f23bced4337c03f230505c69dc2f79
--- /dev/null
+++ b/hermes_cli/kanban_db_attention.py
@@ -0,0 +1,87 @@
+"""Supported daily attention producer: eligibility, daily CAS and TUI outbox in one transaction.
+
+This queues a request for an already subscribed stored TUI destination. It never
+opens a session, starts a model, changes task lifecycle or grants worker authority.
+"""
+import json
+import time
+
+from hermes_cli import kanban_attention_guard as policy
+from hermes_cli import kanban_db_connect as kbc, kanban_db_tui_delivery as delivery
+
+TABLE = 'kanban_task_attention'
+
+
+def _ensure_schema(conn) -> None:
+    conn.execute('''CREATE TABLE IF NOT EXISTS kanban_task_attention (
+        project TEXT NOT NULL, day TEXT NOT NULL, task_id TEXT NOT NULL,
+        event_id INTEGER NOT NULL UNIQUE, delivery_id INTEGER NOT NULL UNIQUE,
+        request_sha256 TEXT NOT NULL, snapshot_sha256 TEXT NOT NULL,
+        guard_json TEXT NOT NULL, notifier_profile TEXT NOT NULL, created_at REAL NOT NULL,
+        PRIMARY KEY(project,day,task_id))''')
+
+
+def _receipt(row) -> dict:
+    return {k: row[k] for k in ('day', 'task_id', 'event_id', 'delivery_id', 'created_at')}
+
+
+def _route(conn, task_id: str, session_key: str, *, profile: str | None = None):
+    from hermes_cli.profiles import current_profile_name
+    rows = conn.execute('''SELECT * FROM kanban_notify_subs WHERE task_id=?
+        AND LOWER(platform)='tui' AND chat_id=? AND notifier_profile=?
+        AND delivery_mode IN ('wake','notify+wake')''',
+        (task_id, session_key, profile if profile is not None else current_profile_name('default'))).fetchall()
+    if len(rows) != 1:
+        raise ValueError('attention requires one existing wake route owned by this profile')
+    return dict(rows[0])
+
+
+def request_attention(conn, *, task_id: str, day: str, session_key: str,
+                      guard: dict, message: str, now: float | None = None) -> dict:
+    """Daily idempotency is board/project/day/task, with a pinned payload and destination."""
+    now = time.time() if now is None else now
+    guard = policy.validate_policy(guard)
+    policy.check_day(day, now)
+    if not session_key.strip() or not isinstance(message, str) or not message.strip() or len(message) > 4000:
+        raise ValueError('attention requires a destination and 1..4000 characters of message')
+    identity = policy.digest({'home': delivery.owner_home(), 'session': session_key,
+                              'guard': guard, 'message': message})
+    with kbc.write_txn(conn):
+        _ensure_schema(conn)
+        key = (guard['workspace'], day, task_id)
+        old = conn.execute(f'SELECT * FROM {TABLE} WHERE project=? AND day=? AND task_id=?', key).fetchone()
+        if old:
+            if old['request_sha256'] != identity:
+                raise ValueError('daily attention identity conflict; original request is retained')
+            return _receipt(old)
+        snapshot = policy.eligible_snapshot(conn, task_id, guard)
+        sub = _route(conn, task_id, session_key)
+        event = conn.execute('''INSERT INTO task_events(task_id,kind,payload,created_at)
+            VALUES (?,?,?,?)''', (task_id, 'attention_requested', policy.encode({'day': day}), int(now)))
+        text = delivery.prepare(conn, sub, event.lastrowid,
+                                f'Kanban {task_id}: attention requested for {day} (Bangkok).\n{message}')
+        conn.execute(f'''INSERT INTO {TABLE}
+            (project,day,task_id,event_id,delivery_id,request_sha256,snapshot_sha256,guard_json,notifier_profile,created_at)
+            VALUES (?,?,?,?,?,?,?,?,?,?)''', (*key, event.lastrowid, text.delivery_ref.id, identity,
+                                             snapshot, policy.encode(guard), sub['notifier_profile'], now))
+        return _receipt(conn.execute(f'SELECT * FROM {TABLE} WHERE project=? AND day=? AND task_id=?', key).fetchone())
+
+
+def delivery_is_eligible(conn, delivery_id: int, *, home: str, now: float | None = None) -> bool:
+    """Recheck under the consumer's claim transaction; legacy deliveries keep their contract."""
+    if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", (TABLE,)).fetchone():
+        return True
+    row = conn.execute(f'SELECT * FROM {TABLE} WHERE delivery_id=?', (delivery_id,)).fetchone()
+    if not row:
+        return True
+    try:
+        policy.check_day(row['day'], time.time() if now is None else now)
+        guard = policy.validate_policy(json.loads(row['guard_json']))
+        if policy.eligible_snapshot(conn, row['task_id'], guard) != row['snapshot_sha256']:
+            return False
+        # Reconfiguration to passive or a foreign notifier is not a wake grant.
+        target = conn.execute(f'SELECT session_key,home FROM {delivery.TABLE} WHERE id=?', (delivery_id,)).fetchone()
+        return target['home'] == home and bool(_route(conn, row['task_id'], target['session_key'],
+                                                      profile=row['notifier_profile']))
+    except (ValueError, TypeError, KeyError, json.JSONDecodeError):
+        return False
