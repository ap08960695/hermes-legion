+"""Public operating rules precede identity without rewriting restored prompts."""
+import copy
+import os
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from agent.system_prompt import build_system_prompt_parts, build_system_prompt
+from tests.agent.test_system_prompt import _make_agent
+
+
+def test_different_identities_share_rules_and_keep_own_identity():
+    with patch('agent.prompt_builder.load_soul_md', side_effect=['ROLE ALPHA','ROLE BETA']):
+        a=build_system_prompt_parts(_make_agent())
+        b=build_system_prompt_parts(_make_agent())
+    assert a['stable']==b['stable']
+    assert 'ROLE ALPHA' in a['context'] and 'ROLE BETA' not in a['context']
+    assert 'ROLE BETA' in b['context'] and 'ROLE ALPHA' not in b['context']
+
+
+def test_build_canonicalizes_tools_without_changing_permissions_or_shared_input():
+    tools=[{'type':'function','function':{'name':'z','parameters':{'type':'object'}}},
+           {'type':'function','function':{'name':'a','parameters':{'type':'object'}}}]
+    original=copy.deepcopy(tools)
+    agent=_make_agent(tools=tools)
+    build_system_prompt(agent)
+    assert [t['function']['name'] for t in agent.tools]==['a','z']
+    assert tools==original
+    assert sorted(t['function']['name'] for t in agent.tools)==sorted(t['function']['name'] for t in original)
+
+
+def test_restore_legacy_layout_keeps_original_prompt_tools_and_breakpoint():
+    from agent.system_prompt import reconstruct_static_prefix
+    agent=_make_agent(tools=[{'function':{'name':'z'}},{'function':{'name':'a'}}], _use_prompt_caching=True)
+    with patch('agent.prompt_builder.load_soul_md',return_value='original identity'):
+        parts=build_system_prompt_parts(agent,legacy_layout=True)
+        saved='\n\n'.join(parts[k] for k in ('stable','context','volatile') if parts[k])
+        agent._cached_system_prompt=saved
+        original_tools=copy.deepcopy(agent.tools)
+        reconstruct_static_prefix(agent)
+    assert agent._cached_system_prompt==saved
+    assert agent._cached_system_prompt_static==parts['stable']
+    assert agent.tools==original_tools
