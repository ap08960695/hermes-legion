+@pytest.mark.parametrize('stage,expected', [('build', 'pending'), ('model', 'claimed'), ('settled', 'settled')])
+def test_actual_process_crash_never_replays_ambiguous_work(case, stage, expected):
+    import os
+    from pathlib import Path
+    import subprocess
+    import sys
+    script = '''
+import os,sys
+from pathlib import Path
+from types import SimpleNamespace
+from hermes_cli import kanban_attention_host as host,kanban_db_attention as attention
+attention.time=SimpleNamespace(time=lambda: float(sys.argv[5]))
+class Agent:
+    def run_conversation(self,*args,**kwargs):
+        if sys.argv[4]=='model': os._exit(73)
+        return {'completed':True}
+    def close(self): pass
+def build(**kwargs):
+    if sys.argv[4]=='build': os._exit(73)
+    return Agent()
+host.build_agent=build
+host.run(Path(sys.argv[1]),delivery_id=int(sys.argv[2]),session_key=sys.argv[3])
+os._exit(73)
+'''
+    env = {**os.environ, 'HERMES_TEST_ISOLATION': '1', 'HERMES_DISABLE_LAZY_INSTALLS': '1'}
+    child = subprocess.run([sys.executable, '-c', script, str(kb.kanban_db_path()),
+        str(case.request['delivery_id']), KEY, stage, str(NOW)], cwd=str(Path(__file__).resolve().parents[2]),
+        env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30, check=False)
+    assert child.returncode == 73, child.stderr
+    assert _state(case) == expected
+    if expected != 'pending':
