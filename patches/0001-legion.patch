+"""Native keyring quota is independent of stale legacy token files and never a model turn."""
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+import pytest
+from hermes_cli import account_usage_native_agy as agy
+
+
+def receipt(**overrides):
+    row = dict(
+        status="SUCCESS",
+        num_turns=0,
+        usage=dict(total_tokens=0),
+        command=dict(
+            name="usage",
+            data=dict(
+                groups=[
+                    dict(
+                        name="Gemini",
+                        buckets=[
+                            dict(window="weekly", remaining_fraction=0.75),
+                            dict(window="5h", remaining_fraction=1, disabled=True),
+                        ],
+                    )
+                ]
+            ),
+        ),
+    )
+    return json.dumps(row | overrides)
+
+
+def test_native_mode_uses_real_home_keyring_not_legacy_token(tmp_path, monkeypatch):
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("DBUS_SESSION_BUS_ADDRESS", "fixture-bus")
+    monkeypatch.setenv("GEMINI_API_KEY", "must-not-be-forwarded")
+    calls = []
+
+    def runner(args, **kw):
+        calls.append((args, kw))
+        return SimpleNamespace(returncode=0, stdout=receipt())
+
+    row = agy.collect_native(
+        dict(
+            id="agy",
+            label="AGY",
+            command="/fixture/agy",
+            token_file="/expired/must-not-read",
+        ),
+        runner=runner,
+    )
+    assert row["windows"][0]["used_percent"] == 25 and len(row["windows"]) == 1
+    assert calls[0][0] == ["/fixture/agy", "-p", "/usage", "--output-format", "json"]
