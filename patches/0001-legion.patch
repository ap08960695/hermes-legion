+        def __repr__(self):
+            pytest.fail('Memory diagnostics must not inspect private cached objects')
+
+    marker = 'private-session-prompt-account-marker'
+    runner = SimpleNamespace(_agent_cache={marker: PrivateValue()}, _sessions={marker: PrivateValue()},
+                             _profile_configs={marker: PrivateValue()})
+    monkeypatch.setattr(runtime_memory, '_current_runner', lambda: runner)
+    result = runtime_memory.collect_runtime_memory()
+    assert result['caches'] == {'agents': 1, 'session_states': 1, 'profile_configs': 1}
+    assert marker not in json.dumps(result)
+
+
+def test_unavailable_sqlite_tracking_is_not_reported_as_zero(monkeypatch):
