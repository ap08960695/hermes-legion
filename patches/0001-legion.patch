+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+const io = vi.hoisted(() => ({ api: vi.fn() }))
+vi.mock('@/api/client', async original => ({
+  ...(await original<typeof import('@/api/client')>()),
+  hermesApiAs: io.api
+}))
+import { $apiRequestScope } from '@/api/client'
+import { SessionPickerDialog } from './session-picker'
+const row = (id: string, title: string, profile = 'writer') => ({ id, title, profile, preview: 'Saved message' })
+const page = (sessions: unknown[], offset = 0, total = 1) => ({ sessions, offset, total, limit: 50 })
+const show = (onResume = vi.fn(), open = true) => {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+  return {
+    onResume,
+    ...render(
+      <QueryClientProvider client={client}>
+        <SessionPickerDialog open={open} onOpenChange={() => {}} onResume={onResume} />
+      </QueryClientProvider>
+    )
+  }
+}
+afterEach(() => {
+  cleanup()
+  $apiRequestScope.set({ profile: null, connectionId: null })
+  vi.clearAllMocks()
+})
+it('loads older pages and selects the existing ID with its captured remote profile owner', async () => {
+  $apiRequestScope.set({ connectionId: 'remote-one', profile: 'default' })
+  io.api.mockImplementation(async (_owner, request) =>
+    new URL(request.path, 'http://local').searchParams.get('offset') === '50'
+      ? page([row('older-id', 'Older discussion')], 50, 51)
+      : page([row('new-id', 'Latest discussion')], 0, 51)
+  )
+  const { onResume } = show()
+  await screen.findByText('Latest discussion')
+  fireEvent.click(screen.getByRole('button', { name: 'Load older chats' }))
+  fireEvent.click(await screen.findByRole('option', { name: /Older discussion/ }))
+  expect(onResume).toHaveBeenCalledExactlyOnceWith('older-id', { connectionId: 'remote-one', profile: 'writer' })
+  expect(io.api.mock.calls).toHaveLength(2)
+})
+it('searches title or ID on the server, beyond the initial recent page, only on explicit submission', async () => {
+  io.api.mockImplementation(async (_owner, request) =>
+    new URL(request.path, 'http://local').searchParams.get('q') === 'old-205'
+      ? page([row('old-205', 'Historic notebook')])
+      : page([row('newest', 'Current')])
+  )
+  show()
+  await screen.findByText('Current')
+  fireEvent.change(screen.getByRole('combobox'), { target: { value: 'old-205' } })
+  expect(io.api).toHaveBeenCalledTimes(1)
+  fireEvent.click(screen.getByRole('button', { name: /^Search$/ }))
+  await screen.findByText('Historic notebook')
+  expect(io.api).toHaveBeenCalledTimes(2)
+})
+it('does not poll while closed and distinguishes a failed read from empty history', async () => {
+  io.api.mockRejectedValue(new Error('unavailable'))
+  const closed = show(vi.fn(), false)
+  expect(io.api).not.toHaveBeenCalled()
+  closed.unmount()
+  show()
+  await screen.findByRole('alert')
+  expect(screen.queryByText('No matching chats')).toBeNull()
+  expect(screen.getByRole('button', { name: 'Retry' })).toBeTruthy()
+})
+it('does not reuse another connection history cache or paint a delayed previous owner response', async () => {
+  let finish!: (value: unknown) => void
+  const pending = new Promise(resolve => {
+    finish = resolve
+  })
+  io.api.mockImplementation(async owner =>
+    owner.connectionId === 'one' ? pending : page([row('two-id', 'Second connection')])
+  )
+  $apiRequestScope.set({ connectionId: 'one', profile: 'default' })
+  show()
+  act(() => $apiRequestScope.set({ connectionId: 'two', profile: 'default' }))
+  expect($apiRequestScope.get().connectionId).toBe('two')
+  await waitFor(() => expect(io.api.mock.calls.map(call => call[0].connectionId)).toContain('two'))
+  await screen.findByText('Second connection')
+  finish(page([row('one-id', 'Wrong connection')]))
+  await waitFor(() => expect(screen.queryByText('Wrong connection')).toBeNull())
+})
