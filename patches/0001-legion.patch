@@ -0,0 +1,12 @@
+import { type DroppedFile, extractDroppedFiles, isImagePath } from '../hooks/use-composer-actions'
+
+/** Read native File handles while the paste event still owns its DataTransfer.
+ * Image-only pastes keep the existing blob/screenshot path. Mixed selections
+ * take the file attachment path together so images are not attached twice.
+ * Text paths and URLs are not filesystem selections. */
+export function extractClipboardFiles(clipboard: DataTransfer): DroppedFile[] {
+  const files = extractDroppedFiles(clipboard).filter(candidate => candidate.file)
+  const hasDocument = files.some(({ file }) => file && !file.type.startsWith('image/') && !isImagePath(file.name))
+
+  return hasDocument ? files : []
+}
