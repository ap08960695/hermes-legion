+    assert _state(case) == 'pending'
+
+
+def test_live_owner_is_refused_before_build(case, monkeypatch):
+    from hermes_cli.active_sessions import try_acquire_active_session
+    lease, err = try_acquire_active_session(session_id=KEY, surface='desktop', config={},
+        registry_home=case.home, metadata={'live_session_id': 'other-owner'})
+    assert err is None
+    built, calls, _ = _fake(monkeypatch, case)
+    try:
+        with pytest.raises(RuntimeError, match='owner'): _run(case)
+        assert built == calls == [] and _state(case) == 'pending'
+    finally: lease.release()
+
+
+def test_changed_owner_gate_is_rechecked_after_build(case, monkeypatch):
+    original = None
+    built, calls, closed = _fake(monkeypatch, case)
