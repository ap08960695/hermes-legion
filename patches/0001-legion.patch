+"""Batch extraction, profile boundaries and cache work amplification regressions."""
+import asyncio
+import json
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+from tools import web_result_cache as cache, web_tools_extract as extract
+
+
+@pytest.fixture
+def setup(tmp_path, monkeypatch):
+    monkeypatch.setattr(cache, '_cache_dir', lambda: tmp_path)
+    monkeypatch.setattr(cache, '_web_config', dict)
+    monkeypatch.setattr('tools.website_policy.check_website_access', lambda url: None)
+    monkeypatch.setattr(extract, '_rescue_eligible', lambda provider: False)
+    return tmp_path
+
+
+def provider(calls, reverse=False, omit=None):
+    async def fetch(urls, **kwargs):
+        calls.extend(urls)
+        return [{'url': u, 'content': u, 'error': None} for u in (urls[::-1] if reverse else urls) if u != omit]
+    return SimpleNamespace(name='fixture', extract=fetch)
+
+
+def test_duplicate_urls_fetch_once_and_keep_slots(setup):
+    urls=['https://example.com/a', 'https://example.com/a']
+    calls=[]
+    result=asyncio.run(extract._extract_safe_urls(provider(calls), urls, None))
+    assert calls == urls[:1]
+    assert [r['content'] for r in result] == urls
+    result[0]['content']='mutated'
+    assert result[1]['content'] == urls[1]
+
+
+def test_batch_hits_load_one_index(setup):
+    urls=[f'https://example.com/{i}' for i in range(4)]
+    for u in urls: cache.extract_cache_put(u,u,provider='fixture')
+    calls=[]
+    with patch.object(cache,'_load_index',wraps=cache._load_index) as load:
+        result=asyncio.run(extract._extract_safe_urls(provider(calls),urls,None))
+    assert not calls
+    assert [r['content'] for r in result] == urls
+    assert load.call_count == 1
+
+
+def test_batch_misses_save_one_index(setup):
+    urls=[f'https://example.com/{i}' for i in range(4)]
+    with patch.object(cache,'_save_index',wraps=cache._save_index) as save:
+        asyncio.run(extract._extract_safe_urls(provider([]),urls,None))
+    assert save.call_count == 1
+    assert all(cache.extract_cache_get(u,provider='fixture')['content']==u for u in urls)
+
+
+def test_mixed_cache_short_reversed_results_never_mislabel(setup):
+    a,b,c=[f'https://example.com/{i}' for i in range(3)]
+    cache.extract_cache_put(a,a,provider='fixture')
+    result=asyncio.run(extract._extract_safe_urls(provider([],True,b),[a,b,c],None))
+    assert [r['url'] for r in result] == [a,b,c]
+    assert result[1]['error'] and result[2]['content']==c
+
+
+def test_search_slice_only_copies_selected_results(setup):
+    response={'success':True,'data':{'web':[{'text':'x'*1000} for _ in range(100)]}}
+    with patch.object(cache,'_deep_copy',wraps=cache._deep_copy) as copy:
+        result=cache.slice_search_response(response,3)
+    assert len(copy.call_args.args[0]['data']['web'])==3
+    result['data']['web'][0]['text']='changed'
+    assert response['data']['web'][0]['text']=='x'*1000
+
+
+def test_search_profile_isolation(setup,monkeypatch,tmp_path):
+    memo=cache.SearchMemo()
+    monkeypatch.setenv('HERMES_HOME',str(tmp_path/'a'))
+    memo.store('fixture','same',10,{'success':True,'data':{'web':[{'title':'private-a'}]}})
+    monkeypatch.setenv('HERMES_HOME',str(tmp_path/'b'))
+    assert memo.lookup('fixture','same',10) is None
+    monkeypatch.setenv('HERMES_HOME',str(tmp_path/'a'))
+    assert memo.lookup('fixture','same',10)['data']['web'][0]['title']=='private-a'
+
+
+def test_expiry_does_not_scan_unexpired_values(setup,monkeypatch):
+    class NoSweep(dict):
+        def items(self):
+            raise AssertionError('full expiry sweep')
+    memo=cache.SearchMemo()
+    memo._store=NoSweep()
+    memo.store('fixture','one',10,{'success':True})
+    memo.store('fixture','two',10,{'success':True})
+    assert memo.lookup('fixture','one',10)['success']
+
+
+def test_search_accepts_preceding_memo_api(setup,monkeypatch):
+    from tools import web_tools
+    response={'success':True,'data':{'web':[{'title':str(i)} for i in range(10)]}}
+    legacy=SimpleNamespace(lookup=lambda provider,query,limit:response)
+    monkeypatch.setattr(cache,'search_memo',legacy)
+    result=web_tools._memoized_search(SimpleNamespace(name='fixture'),'query',3)
+    assert len(result['data']['web'])==3 and len(response['data']['web'])==10
+
+
+def test_batch_accepts_preceding_cache_api(setup,monkeypatch):
+    get_many,put_many=cache.extract_cache_get_many,cache.extract_cache_put_many
+    monkeypatch.setattr(cache,'extract_cache_get',lambda u,**kw:get_many([u],**kw).get(u))
+    monkeypatch.setattr(cache,'extract_cache_put',lambda u,c,t='',**kw:put_many([(u,c,t)],**kw))
+    monkeypatch.setattr(cache,'extract_cache_get_many',None)
+    monkeypatch.setattr(cache,'extract_cache_put_many',None)
+    urls=['https://example.com/a','https://example.com/a'];calls=[]
+    result=asyncio.run(extract._extract_safe_urls(provider(calls),urls,None))
+    assert [r['content'] for r in result]==urls and calls==urls[:1]
+
+
+def test_redirect_source_wins_even_when_target_also_requested(setup):
+    a,b='https://example.com/a','https://example.com/b'
+    async def fetch(urls,**kwargs):
+        return [{'url':b,'metadata':{'sourceURL':a},'content':'from a'}]
+    asyncio.run(extract._dispatch_extract(SimpleNamespace(name='fixture',extract=fetch),[a,b],None))
+    assert cache.extract_cache_get(a,provider='fixture')['content']=='from a'
+    assert cache.extract_cache_get(b,provider='fixture') is None
