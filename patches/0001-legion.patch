+"""Persistent memo keeps the existing search semantics across processes/profiles."""
+from tools import web_result_cache as cache
+from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+
+
+def test_separate_memos_reuse_success_without_mutation_and_respect_profiles(tmp_path,monkeypatch):
+    monkeypatch.setattr(cache,'_web_config',dict)
+    a=cache.SearchMemo(); b=cache.SearchMemo()
+    value={'success':True,'data':{'web':[{'title':'result'}]*10}}
+    a.store('fixture','some query',5,value)
+    hit=b.lookup_slice('fixture',' SOME   QUERY ',5)
+    assert hit is not None and len(hit['data']['web'])==5
+    hit['data']['web'][0]['title']='changed'
+    assert b.lookup('fixture','some query',5)['data']['web'][0]['title']=='result'
+    token=set_hermes_home_override(tmp_path/'another')
+    try:
+        assert b.lookup('fixture','some query',5) is None
+    finally:
+        reset_hermes_home_override(token)
+
+
+def test_expired_disabled_and_failed_searches_are_not_reused(monkeypatch):
+    from tools import web_search_disk_cache as disk
+    monkeypatch.setattr(cache,'_web_config',dict)
+    a=cache.SearchMemo(); b=cache.SearchMemo()
+    a.store('fixture','q',5,{'success':False,'error':'no'})
+    assert b.lookup('fixture','q',5) is None
+    a.store('fixture','q',5,{'success':True,'data':{'web':[]}})
+    now=disk.time.time()
+    monkeypatch.setattr(disk.time,'time',lambda:now+1201)
+    assert b.lookup('fixture','q',5) is None
+    monkeypatch.setattr(cache,'cache_enabled',lambda:False)
+    assert a.lookup('fixture','q',5) is None
+
+
+def test_parallel_processes_share_one_vendor_result(tmp_path):
+    import os
+    import subprocess
+    import sys
+    from pathlib import Path
+    code='''
+from tools import web_result_cache as c
+from pathlib import Path
+import sys
+c._web_config=lambda: {}
+m=c.SearchMemo()
+with m.process_flight('offline-fixture','q',5):
+    hit=m.lookup('offline-fixture','q',5)
+    if hit is None:
+        with (Path(sys.argv[1])/'vendor-count').open('a') as f: f.write('call\\n')
+        m.store('offline-fixture','q',5,{'success':True,'data':{'web':[{'title':'same'}]}})
+    assert m.lookup('offline-fixture','q',5)['success']
+'''
+    env={**os.environ,'HERMES_HOME':str(tmp_path/'owner'),'PYTHONPATH':str(Path.cwd())}
+    children=[subprocess.Popen([sys.executable,'-c',code,str(tmp_path)],env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE) for _ in range(4)]
+    for child in children:
+        stdout,stderr=child.communicate(timeout=15)
+        assert child.returncode==0,stderr.decode()
+    assert (tmp_path/'vendor-count').read_text().splitlines()==['call']
+
+
+def test_busy_flight_cannot_call_provider_or_fallback(monkeypatch):
+    import pytest
+    from types import SimpleNamespace
+    from contextlib import contextmanager
+    from tools import web_search_disk_cache as disk, web_tools
+    from tools.cache_file_lock import CacheLockBusy
+    from unittest.mock import Mock
+    @contextmanager
+    def busy(*args):
+        raise CacheLockBusy('already running')
+        yield
+    monkeypatch.setattr(cache,'_web_config',dict)
+    monkeypatch.setattr(disk,'cache_file_lock',busy)
+    provider=SimpleNamespace(name='offline-only',search=Mock())
+    with pytest.raises(CacheLockBusy):
+        web_tools._memoized_search(provider,'new search',5)
+    provider.search.assert_not_called()
