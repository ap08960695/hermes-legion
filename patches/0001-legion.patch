+"""Unrelated cache hits must not wait for a large result's preparation."""
+
+from concurrent.futures import ThreadPoolExecutor
+import json
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from agent import web_search_registry
+from tools import web_result_cache as cache, web_tools
+from tools.registry import registry
+
+
+@pytest.mark.parametrize("preparation", ["copy", "ttl"])
+def test_unrelated_registry_hit_during_store_preparation(monkeypatch, preparation):
+    memo = cache.SearchMemo()
+    monkeypatch.setattr(cache, "_web_config", dict)
+    monkeypatch.setattr(cache, "search_memo", memo)
+    response = {"success": True, "data": {"web": [{"title": "cached"}]}}
+    memo.store("offline-fixture", "ready", 5, response)
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("Cache hit must not call a provider or fallback")
+
+    provider = SimpleNamespace(
+        name="offline-fixture", supports_search=lambda: True, search=forbidden,
+    )
+    monkeypatch.setattr(web_tools, "_ensure_web_plugins_loaded", lambda: None)
+    monkeypatch.setattr(web_tools, "_get_search_backend", lambda: provider.name)
+    monkeypatch.setattr(web_search_registry, "get_provider", lambda name: provider)
+    monkeypatch.setattr(web_tools, "_managed_search_fallback", forbidden)
+    monkeypatch.setattr(web_tools, "_rescue_search", forbidden)
+
+    entered, release, served = threading.Event(), threading.Event(), threading.Event()
+    producer = threading.local()
+    target = "_deep_copy" if preparation == "copy" else "ttl_seconds"
+    original = getattr(cache, target)
+
+    def prepare(*args):
+        if getattr(producer, "active", False):
+            entered.set()
+            assert release.wait(10), "Test did not release preparation"
+        return original(*args)
+
+    monkeypatch.setattr(cache, target, prepare)
+
+    def store():
+        producer.active = True
+        memo.store(provider.name, "large result", 5, response)
+
+    def lookup():
+        result = registry.dispatch("web_search", {"query": "ready", "limit": 5})
+        served.set()
+        return json.loads(result)
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        write = pool.submit(store)
+        try:
+            assert entered.wait(5)
+            read = pool.submit(lookup)
+            independent = served.wait(2)
+        finally:
+            release.set()
+        write.result(timeout=5)
+        result = read.result(timeout=5)
+    assert result["success"]
+    assert result["data"]["web"][0]["title"] == "cached"
+    assert independent, f"Unrelated cached query waited for {preparation}"
+    assert memo.lookup(provider.name, "large result", 5) == response
+
+
+def test_ttl_starts_after_result_preparation(monkeypatch):
+    memo = cache.SearchMemo()
+    monkeypatch.setattr(cache, "_web_config", dict)
+    monkeypatch.setattr(cache, "ttl_seconds", lambda: 10)
+    clock = [0.0]
+    wall_start = cache.time.time()
+    monkeypatch.setattr(cache.time, "time", lambda: wall_start + clock[0])
+    monkeypatch.setattr(cache.time, "monotonic", lambda: clock[0])
+    original = cache._deep_copy
+
+    def prepare(response):
+        clock[0] += 20
+        return original(response)
+
+    monkeypatch.setattr(cache, "_deep_copy", prepare)
+    response = {"success": True, "data": {"web": [{"title": "result"}]}}
+    memo.store("offline-fixture", "query", 5, response)
+    monkeypatch.setattr(cache, "_deep_copy", original)
+    assert memo.lookup("offline-fixture", "query", 5) == response
+    clock[0] += 10
+    assert memo.lookup("offline-fixture", "query", 5) is None
