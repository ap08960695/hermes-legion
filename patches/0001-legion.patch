+"""Only a published compaction may replace the request prefix or its durable tool pin."""
+import copy
+import json
+
+import pytest
+
+from agent.conversation_compression import CompressionCommitFence
+from hermes_state import SessionDB
+from tools.mcp_tool_agent import persist_agent_tool_names
+pytest_plugins = ["tests.agent.test_compression_failed_commit_boundary"]
+
+
+@pytest.fixture
+def prefix_case(case, monkeypatch):
+    agent = case.agent
+    agent._cached_system_prompt = agent._build_system_prompt("trusted original context")
+    case.prompt = agent._cached_system_prompt
+    case.static = agent._cached_system_prompt_static
+    case.tools = copy.deepcopy(agent.tools)
+    assert case.tools
+    case.names = set(agent.valid_tool_names)
+    case.db.update_system_prompt(case.sid, case.prompt)
+    persist_agent_tool_names(agent)
+    case.pin = case.db.get_session(case.sid)["tool_names"]
+    changed = copy.deepcopy(case.tools)
+    changed[0]["function"]["description"] = "Changed tool contract at a real compaction boundary"
+    monkeypatch.setattr("model_tools.get_tool_definitions", lambda **kw: changed)
+    return case
+
+
+@pytest.mark.parametrize("in_place", [True, False], ids=["in-place", "rotation"])
+@pytest.mark.parametrize("surface", ["prompt", "tools", "cold"])
+def test_failed_prefix_publication(prefix_case, in_place, surface):
+    c = prefix_case
+    c.agent.compression_in_place = in_place
+    with c.db._conn:
+        c.db._conn.execute("CREATE TRIGGER refuse_prefix BEFORE INSERT ON messages "
+                "BEGIN SELECT RAISE(ABORT, 'fixture: refuse prefix publication'); END")
+    messages, prompt = c.agent._compress_context(c.messages, "trusted updated context",
+        approx_tokens=120_000, force=True, commit_fence=CompressionCommitFence())
+    assert messages == c.messages
+    if surface == "prompt":
+        assert prompt == c.prompt, "an unchanged transcript must retain its cached system bytes"
+        assert c.agent._cached_system_prompt == c.prompt
+        assert c.agent._cached_system_prompt_static == c.static
+    elif surface == "tools":
+        assert c.agent.tools == c.tools
+        assert c.agent.valid_tool_names == c.names
+    expected_pin = c.pin
+    with SessionDB(c.db.db_path, read_only=True) as cold:
+        row = cold.get_session(c.agent.session_id)
+        assert row["system_prompt"] == c.prompt
+        assert row["tool_names"] == expected_pin
+
+
+@pytest.mark.parametrize("in_place", [True, False], ids=["in-place", "rotation"])
+def test_published_prefix_refreshes_prompt_tools_and_cold_pin(prefix_case, in_place):
+    c = prefix_case
+    c.agent.compression_in_place = in_place
+    messages, prompt = c.agent._compress_context(c.messages, "trusted updated context",
+        approx_tokens=120_000, force=True, commit_fence=CompressionCommitFence())
+    assert len(messages) < len(c.messages)
+    assert prompt != c.prompt and "trusted updated context" in prompt
+    assert c.agent._cached_system_prompt == prompt
+    assert c.agent.tools != c.tools
+    with SessionDB(c.db.db_path, read_only=True) as cold:
+        row = cold.get_session(c.agent.session_id)
+        assert row["system_prompt"] == prompt
+        assert json.loads(row["tool_names"])["tools"] == c.agent.tools
+
+
+@pytest.mark.parametrize("in_place", [True, False], ids=["in-place", "rotation"])
+def test_seeded_gateway_prefix_never_overwrites_live_pin(prefix_case, in_place):
+    c = prefix_case
+    c.agent.compression_in_place = in_place
+    c.agent._retain_seeded_system_prompt = True
+    messages, prompt = c.agent._compress_context(c.messages, "reduced detached gateway context",
+        approx_tokens=120_000, force=True, commit_fence=CompressionCommitFence())
