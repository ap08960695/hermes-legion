+    def change(**kwargs):
+        agent = original(**kwargs)
+        with kbc.connect_closing() as c: kb.add_comment(c, case.tid, 'owner', 'OwnerGATE: pause')
+        return agent
+    monkeypatch.setattr(_host(), 'build_agent', change)
+    assert _run(case)['state'] == 'cancelled'
+    assert len(built) == len(closed) == 1 and calls == []
+
+
+def test_another_consumer_winning_cas_prevents_execution(case, monkeypatch):
+    _fake(monkeypatch, case)
+    original = _host().build_agent
+    def race(**kwargs):
+        agent = original(**kwargs)
+        pending = delivery.pending(kb.kanban_db_path(), home=str(case.home.resolve()), session_key=KEY)
+        texts, claim = delivery.claim(pending, home=str(case.home.resolve()), session_key=KEY)
+        assert len(texts) == 1
+        claim.mark('unknown')
+        return agent
+    monkeypatch.setattr(_host(), 'build_agent', race)
+    assert _run(case) == {'delivery_id': case.request['delivery_id'], 'state': 'unknown', 'ran': False}
+
