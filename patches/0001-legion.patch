+"""Bounded existing-log and SQLite reader; never initializes a board or imports an agent."""
+from contextlib import closing
+import json
+from pathlib import Path
+import sqlite3
+
+_MAX_FILES=32
+_TAIL_BYTES=2*1024*1024
+_MAX_RUNS=10000
+
+
+def read_logs(paths):
+    records=[];coverage=[];invalid=0
+    for path in paths:
+        try:
+            size=path.stat().st_size;offset=max(0,size-_TAIL_BYTES)
+            with path.open('rb') as stream:
+                stream.seek(offset);data=stream.read(_TAIL_BYTES)
+            lines=data.splitlines()[1:] if offset else data.splitlines()
+            count=0
+            for line in lines:
+                if b'CACHE_DIAGNOSTIC ' not in line:continue
+                try:record=json.loads(line.split(b'CACHE_DIAGNOSTIC ',1)[1])
+                except (ValueError,UnicodeDecodeError):invalid+=1;continue
+                if isinstance(record,dict):records.append(record);count+=1
+            coverage.append({'path':str(path),'bytes_sampled':len(data),'tail_cut':bool(offset),'diagnostic_rows':count})
+        except OSError:
+            coverage.append({'path':str(path),'unavailable':True})
+    return records,{'files':coverage,'invalid_json_rows':invalid}
+
+
+def read_board(path,start,end,keys=None):
+    with closing(sqlite3.connect(path.resolve().as_uri()+'?mode=ro',uri=True,timeout=2)) as conn:
+        conn.row_factory=sqlite3.Row;conn.execute('PRAGMA query_only=ON')
+        columns={r['name'] for r in conn.execute('PRAGMA table_info(task_runs)')}
+        if 'worker_started_at' not in columns:return [],{'status':'unsupported_run_identity_schema'}
+        rows=conn.execute('SELECT id,task_id,worker_pid,worker_started_at,started_at,ended_at,outcome '
+                          'FROM task_runs WHERE started_at<? AND (ended_at IS NULL OR ended_at>=?) '
+                          'ORDER BY id DESC LIMIT ?',(end,start,_MAX_RUNS+1)).fetchall()
+        runs=[]
+        for row in rows[:_MAX_RUNS]:
+            run=dict(row);run['board']=str(path);run['attempt_reason']='unknown'
+            from agent.usage_run_binding import run_digest
+            run['bindings']=[(kid,run_digest(key,path,run['task_id'],run['id'])) for kid,key in (keys or {}).items()]
+            event=conn.execute("SELECT payload FROM task_events WHERE task_id=? AND run_id=? AND kind='claimed' ORDER BY id DESC LIMIT 1",(run['task_id'],run['id'])).fetchone()
+            if event and event['payload'] and len(event['payload'])<65536:
+                try:
+                    payload=json.loads(event['payload']);attempt=payload.get('attempt') if isinstance(payload,dict) else None
+                    if isinstance(attempt,dict):run['attempt_reason']=attempt.get('reason','unknown')
+                except (ValueError,TypeError):run['attempt_reason']='unknown'
+            runs.append(run)
+        outcomes=dict(conn.execute('SELECT outcome,COUNT(*) FROM task_runs WHERE started_at>=? AND started_at<? GROUP BY outcome',(start,end)).fetchall())
+        done=conn.execute("SELECT COUNT(DISTINCT task_id) FROM task_runs WHERE outcome='completed' AND ended_at>=? AND ended_at<?",(start,end)).fetchone()[0]
+        return runs,{'status':'read_only','rows_sampled':len(runs),'truncated':len(rows)>_MAX_RUNS,
+                     'started_run_outcomes':{str(k):v for k,v in outcomes.items()},'completed_cards':done}
+
+
+def collect(home,start,end,*,max_log_files=_MAX_FILES):
+    if type(max_log_files) is not int or not 1<=max_log_files<=512:
+        raise ValueError("max_log_files must be an integer within [1,512]")
+    home=Path(home).resolve(strict=True)
+    profiles=sorted(p for p in (home/'profiles').glob('*') if p.is_dir())
+    paths=[p for h in [home,*profiles[:128]] for p in (h/'logs').glob('*.log*') if p.is_file() and p.suffix!='.gz']
+    paths.sort(key=lambda p:p.stat().st_mtime,reverse=True)
+    records,coverage=read_logs(paths[:max_log_files]);coverage.update({'max_log_files':max_log_files,'log_files_found':len(paths),'log_files_omitted':max(0,len(paths)-max_log_files),'profile_dirs_omitted':max(0,len(profiles)-128),'compressed_logs_read':False,'missing_time_spans':'unknown; tails/rotation prevent full-window accounting'})
+    boards=[p for p in [home/'kanban.db',*sorted((home/'kanban/boards').glob('*/kanban.db'))] if p.is_file()]
+    keys,key_coverage=_existing_keys([home,*profiles[:128]])
+    needed={r.get('fingerprint',{}).get('key_id') for r in records if isinstance(r.get('fingerprint'),dict) and isinstance(r['fingerprint'].get('key_id'),str)}
+    keys={kid:key for kid,key in keys.items() if kid in needed}
+    key_coverage['used_for_matching']=len(keys)
+    runs=[];coverage['boards']={};coverage['boards_omitted']=max(0,len(boards)-64)
+    coverage['binding_keys']=key_coverage
+    for path in boards[:64]:
+        try:rows,status=read_board(path,start,end,keys);runs.extend(rows)
+        except sqlite3.Error as exc:status={'status':'unavailable','error_type':type(exc).__name__}
+        coverage['boards'][str(path)]=status
+    return records,runs,coverage
+
+
+def _existing_keys(homes):
+    from agent.usage_run_binding import existing_key,key_id
+    keys={};unavailable=0
+    for home in homes:
+        try:key=existing_key(home)
+        except (OSError,ValueError):unavailable+=1;continue
+        keys[key_id(key)]=key
+    return keys,{'read_only_existing':len(keys),'unavailable':unavailable,'created':0}
