+
+def test_receipt_reads_do_not_create_a_missing_database_or_legacy_schema(tmp_path):
+    missing = tmp_path / 'absent.db'
+    assert _receipts(missing) == []
+    assert not missing.exists()
+    with kbc.connect_closing() as conn:
+        assert not conn.execute("SELECT 1 FROM sqlite_master WHERE name=?", (delivery.TABLE,)).fetchone()
+    assert _receipts(kb.kanban_db_path()) == []
+    with kbc.connect_closing() as conn:
+        assert not conn.execute("SELECT 1 FROM sqlite_master WHERE name=?", (delivery.TABLE,)).fetchone()
+
+
+def test_identical_text_for_distinct_events_retains_distinct_receipts():
+    with kbc.connect_closing() as conn:
+        first, second = _prepared(conn), _prepared(conn)
+    assert first == second
+    assert first.delivery_ref != second.delivery_ref
+    texts, claim = delivery.claim([first, second], home=delivery.owner_home(), session_key=KEY)
+    assert len(texts) == len(claim.refs) == 2
+
+
+def test_symlinked_board_recovery_keeps_the_same_delivery_identity(tmp_path):
+    real = tmp_path / 'real.db'
+    with kbc.connect_closing(real):
+        pass
+    alias = tmp_path / 'alias.db'
+    alias.symlink_to(real)
+    with kbc.connect_closing(alias) as conn:
+        text = _prepared(conn)
+    restored = delivery.pending(real, home=delivery.owner_home(), session_key=KEY)
+    assert len(restored) == 1 and restored[0].delivery_ref == text.delivery_ref
+
+
+def test_terminal_callback_keeps_its_captured_home_when_context_changes(tmp_path):
+    path, home = kb.kanban_db_path(), delivery.owner_home()
+    with kbc.connect_closing(path) as conn:
+        text = _prepared(conn)
+    _, claim = delivery.claim([text], home=home, session_key=KEY)
+    token = set_hermes_home_override(tmp_path / 'unrelated-profile')
+    try:
+        claim.mark('settled')
+    finally:
+        reset_hermes_home_override(token)
+    assert delivery.read_receipts(path, home=home, session_key=KEY)[0]['state'] == 'settled'
+
+
+def test_unsubscribe_cancels_pending_receipts_even_if_the_route_is_recreated():
+    with kbc.connect_closing() as conn:
+        text = _prepared(conn)
+        tid = _receipts(kb.kanban_db_path())[0]['task_id']
+        assert notify.remove_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY)
+        notify.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY)
+    assert _receipts(kb.kanban_db_path())[0]['state'] == 'cancelled'
+    texts, claim = delivery.claim([text], home=delivery.owner_home(), session_key=KEY)
+    assert texts == [] and claim.refs == ()
+
+
+def test_unsubscribe_preserves_an_already_claimed_ambiguous_receipt():
+    with kbc.connect_closing() as conn:
+        text = _prepared(conn)
+    _, claim = delivery.claim([text], home=delivery.owner_home(), session_key=KEY)
+    with kbc.connect_closing() as conn:
+        tid = _receipts(kb.kanban_db_path())[0]['task_id']
+        assert notify.remove_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY)
+    assert _receipts(kb.kanban_db_path())[0]['state'] == 'claimed'
+    claim.mark('settled')
+    assert _receipts(kb.kanban_db_path())[0]['state'] == 'settled'
