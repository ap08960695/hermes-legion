+import { expect, it, vi } from 'vitest'
+import { registerBuiltinActionRunner, runBuiltinAppAction, runPluginAppAction } from './plugin-actions'
+it('runs a native tab action without exposing that action to plugins', () => {
+  const run = vi.fn(() => true),
+    off = registerBuiltinActionRunner(run),
+    warn = vi.spyOn(console, 'warn').mockImplementation(() => {})
+  try {
+    expect(runBuiltinAppAction('session.newTab')).toBe(true)
+    expect(run).toHaveBeenCalledExactlyOnceWith('session.newTab')
+    run.mockClear()
+    expect(runPluginAppAction('example', 'session.newTab').ok).toBe(false)
+    expect(run).not.toHaveBeenCalled()
+  } finally {
+    off()
+    warn.mockRestore()
+  }
+  expect(runBuiltinAppAction('session.newTab')).toBe(false)
+})
