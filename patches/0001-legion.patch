@@ -0,0 +1,75 @@
+import { ZoomableImage } from '@/components/chat/zoomable-image'
+import { ExternalLink } from '@/lib/external-link'
+import { parseAnswerCards } from '@/lib/answer-cards'
+import { Codicon } from '@/components/ui/codicon'
+import { useI18n } from '@/i18n'
+import type { RichFenceProps } from './types'
+
+/** Native answer cards: explicit supplied data, never an executable document. */
+export default function AnswerCards({ code, streaming }: RichFenceProps) {
+  const { t } = useI18n()
+  if (streaming)
+    return (
+      <p role="status" className="text-xs text-muted-foreground">
+        {t.preview.loading}
+      </p>
+    )
+  const cards = parseAnswerCards(code)
+  if (!cards.length) throw new Error('cards: no complete presentation data')
+  return (
+    <div className="not-prose my-5 grid min-w-0 gap-5 text-(--ui-text-primary)" data-slot="answer-cards">
+      {cards.map((card, index) => (
+        <article key={index} className="flex min-w-0 flex-col gap-4 sm:flex-row">
+          {card.images.length === 1 && (
+            <div className="h-32 w-32 shrink-0 overflow-hidden rounded-xl border border-(--ui-stroke-tertiary) bg-(--ui-bg-quinary)">
+              <ZoomableImage
+                loading="lazy"
+                decoding="async"
+                src={card.images[0]}
+                alt={card.title}
+                className="h-32 w-32 object-contain"
+              />
+            </div>
+          )}
+          <div className="min-w-0 flex-1">
+            <h3 className="text-sm font-semibold leading-6">{card.title}</h3>
+            {card.price && <p className="mt-1 text-2xl font-semibold tabular-nums">{card.price}</p>}
+            {card.description && (
+              <p className="mt-2 text-sm leading-6 text-(--ui-text-secondary)">{card.description}</p>
+            )}
+            {card.facts.length > 0 && <p className="mt-2 text-xs text-muted-foreground">{card.facts.join(' · ')}</p>}
+            {card.images.length > 1 && (
+              <div className="mt-3 grid grid-cols-[repeat(auto-fit,minmax(130px,1fr))] gap-2">
+                {card.images.map((image, i) => (
+                  <ZoomableImage
+                    key={i}
+                    loading="lazy"
+                    decoding="async"
+                    src={image}
+                    alt={`${card.title} ${i + 1}`}
+                    className="h-40 w-full rounded-xl border border-(--ui-stroke-tertiary) bg-(--ui-bg-quinary) object-contain"
+                  />
+                ))}
+              </div>
+            )}
+            {card.sources.length > 0 && (
+              <div className="mt-3 flex flex-wrap gap-2">
+                {card.sources.map(source => (
+                  <ExternalLink
+                    key={source.url}
+                    href={source.url}
+                    className="inline-flex items-center gap-1.5 rounded-full bg-(--ui-bg-quaternary) px-2.5 py-1 text-[11px] text-(--ui-text-secondary)"
+                    title={source.url}
+                  >
+                    <Codicon name="globe" size="0.75rem" />
+                    {source.title}
+                  </ExternalLink>
+                ))}
+              </div>
+            )}
+          </div>
+        </article>
+      ))}
+    </div>
+  )
+}
