+def test_current_context_does_not_fall_back_to_another_session(own_session):
+    from hermes_cli import goal_self
+    _, db = own_session
+    with scoped_current_session_id('missing'):
+        with pytest.raises(ValueError, match='session'):
+            goal_self.ensure_current_goal(OBJECTIVE)
