+"""Public daily attention CLI exercises real parser, policy and isolated board."""
+import argparse
+import json
+
+from hermes_cli import kanban, kanban_db as kb, kanban_db_connect as kbc
+from tests.hermes_cli.test_kanban_attention import DAY, KEY, NOW, _fixture
+
+
+def _command(*args):
+    parser = argparse.ArgumentParser()
+    kanban.build_parser(parser.add_subparsers(dest='command'))
+    return kanban.kanban_command(parser.parse_args(['kanban', 'attention-request', *args]))
+
+
+def test_cli_queues_one_existing_task_without_lifecycle_change(tmp_path, capsys, monkeypatch):
+    from hermes_cli import kanban_db_attention as attention
+    monkeypatch.setattr(attention.time, 'time', lambda: NOW)
+    with kbc.connect_closing() as conn:
+        tid, guard = _fixture(conn, tmp_path, status='blocked', typed=True)
+    path = tmp_path / 'trusted-policy.json'
+    path.write_text(json.dumps(guard))
+    args = (tid, '--day', DAY, '--session', KEY, '--guard', str(path), '--message', 'Inspect plan', '--json')
+    assert _command(*args) == 0
+    first = json.loads(capsys.readouterr().out)
+    assert _command(*args) == 0
+    assert json.loads(capsys.readouterr().out) == first
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, tid).status == 'blocked'
+        assert sum(e.kind == 'attention_requested' for e in kb.list_events(conn, tid)) == 1
+
+
+def test_missing_board_is_not_created_by_attention_command(tmp_path, capsys):
+    policy = tmp_path / 'policy.json'
+    policy.write_text('{}')
+    assert not kb.kanban_db_path().exists()
+    assert _command('missing', '--day', DAY, '--session', KEY, '--guard', str(policy),
+                    '--message', 'Inspect plan', '--json') == 1
+    assert not kb.kanban_db_path().exists()
+    assert 'existing board' in capsys.readouterr().err
+
+
+def test_cli_denies_delegated_mutation_before_reading_policy(monkeypatch, capsys):
+    from agent import delegation_context
+    monkeypatch.setattr(delegation_context, 'kanban_path_is_fenced', lambda path: True)
+    assert _command('missing', '--day', DAY, '--session', KEY, '--guard', '/absent/policy.json',
