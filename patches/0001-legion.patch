@@ -0,0 +1,60 @@
+import { Button, Codicon } from '@hermes/plugin-sdk'
+import { useState } from 'react'
+import type { KanbanRun } from './types'
+import { orderedBotRuns } from './workflow-model'
+import { useKanban, Avatar } from './ui'
+
+function runTime(start?: number | null) {
+  if (!start || !Number.isFinite(start)) return null
+  const date = new Date(start * 1000)
+  return Number.isFinite(date.getTime()) ? date : null
+}
+
+/** A claim/run record is evidence of that native attempt, not a model call. */
+export function BotJourney({ runs, assignee }: { runs: readonly KanbanRun[]; assignee?: string | null }) {
+  const k = useKanban(),
+    [limit, setLimit] = useState(30)
+  const ordered = orderedBotRuns(runs, limit)
+  return (
+    <section className="kanban-bot-journey" aria-label={k.botJourney}>
+      <h3>
+        <Codicon name="history" />
+        {k.botJourney}
+        <span>{runs.length}</span>
+      </h3>
+      {ordered.length ? (
+        <ol>
+          {ordered.map((run, index) => {
+            const date = runTime(run.started_at)
+            return (
+              <li key={`${run.id}:${index}`}>
+                <Avatar name={run.profile || '?'} size="1.5rem" />
+                <div>
+                  <strong>{run.profile || k.botJourneyUnknown}</strong>
+                  <small>
+                    #{run.id} · {run.outcome || run.status}
+                  </small>
+                  {date ? (
+                    <time dateTime={date.toISOString()}>{date.toLocaleString()}</time>
+                  ) : (
+                    <small>{k.botRunTimeUnknown}</small>
+                  )}
+                </div>
+              </li>
+            )
+          })}
+        </ol>
+      ) : (
+        <p>{k.botJourneyEmpty}</p>
+      )}
+      {runs.length > limit && (
+        <Button size="sm" variant="ghost" onClick={() => setLimit(n => n + 30)}>
+          {k.botMoreRuns}
+        </Button>
+      )}
+      <p className="kanban-current-assignee">
+        {k.botCurrentAssignee}: {assignee || k.botUnassigned}
+      </p>
+    </section>
+  )
+}
