+"""Byte-exact patch source reads must avoid local shell probes."""
+import hashlib
+import json
+import os
+from unittest.mock import Mock
+
+import pytest
+
+from tools.environments.local import LocalEnvironment
+from tools.file_operations import ShellFileOperations
+
+pytestmark = pytest.mark.platforms("linux", "macos")
+
+
+@pytest.fixture
+def ops(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_NATIVE_FILE_READ", "1")
+    result = ShellFileOperations(LocalEnvironment(cwd=str(tmp_path)), cwd=str(tmp_path))
+    monkeypatch.setattr(result, "_exec", Mock(wraps=result._exec))
+    return result
+
+
+@pytest.mark.parametrize("data", [
+    b"", b"\xef\xbb\xbfhello\r\n", ("ทดสอบ漢字\n" * 200).encode(),
+    b"a" * 1100 + b"\xff\xfe\r\n", b"literal __HERMES_FENCE_ content\x1b[31m\n",
+], ids=["empty", "bom-crlf", "multibyte", "late-invalid-utf8", "literal-escapes"])
+def test_exact_patch_source_without_shell(ops, tmp_path, data):
+    path = tmp_path / "source.txt"
+    path.write_bytes(data)
+    result = ops.read_file_raw(str(path))
+    assert result.error is None and not result.is_binary
+    expected = data[3:] if data.startswith(b"\xef\xbb\xbf") else data
+    assert result.content.encode("utf-8", "surrogateescape") == expected
+    assert result._content_sha256 == hashlib.sha256(data).hexdigest()
+    assert result.file_size == len(data)
+    assert ops._exec.call_count == 0
+
+
+def test_current_cwd_and_symlink(ops, tmp_path):
+    (tmp_path / "source.txt").write_text("old")
+    folder = tmp_path / "next"
+    folder.mkdir()
+    (folder / "source.txt").write_text("new")
+    (folder / "alias.txt").symlink_to(folder / "source.txt")
+    ops.env.cwd = str(folder)
+    assert ops.read_file_raw("alias.txt").content == "new"
+    assert ops._exec.call_count == 0
+
+
+def test_nonregular_files_never_read(ops, tmp_path):
+    pipe = tmp_path / "pipe"
+    os.mkfifo(pipe)
+    dangling = tmp_path / "dangling"
+    dangling.symlink_to(tmp_path / "absent")
+    for path in [pipe, dangling, tmp_path]:
+        result = ops.read_file_raw(str(path))
+        assert result.error and "not a regular file" in result.error
+        assert not result.not_found
+    assert ops._exec.call_count == 0
+
+
+def test_binary_and_image_contract(ops, tmp_path):
+    for name, data in [("nul.dat", b"a\x00b"), ("image.png", b"image"), ("source.zip", b"text")]:
+        path = tmp_path / name
+        path.write_bytes(data)
+        result = ops.read_file_raw(str(path))
+        assert result.is_binary and result.file_size == len(data)
+        assert bool(result.is_image) == (name == "image.png")
+    assert ops._exec.call_count == 0
+
+
+def test_native_opt_out_preserves_shell(ops, tmp_path, monkeypatch):
+    path = tmp_path / "source.txt"
+    path.write_bytes(b"hello\r\n")
+    monkeypatch.setenv("HERMES_NATIVE_FILE_READ", "0")
+    assert ops.read_file_raw(str(path)).content == "hello\r\n"
+    assert ops._exec.call_count > 0
