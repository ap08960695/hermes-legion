+    kanban.build_parser(parser.add_subparsers(dest='command'))
+    return kanban.kanban_command(parser.parse_args(['kanban', 'attention-request', *args]))
+
+
+def test_cli_queues_one_existing_task_without_lifecycle_change(tmp_path, capsys, monkeypatch):
+    from hermes_cli import kanban_db_attention as attention
+    monkeypatch.setattr(attention.time, 'time', lambda: NOW)
+    with kbc.connect_closing() as conn:
+        tid, guard = _fixture(conn, tmp_path, status='blocked', typed=True)
+    path = tmp_path / 'trusted-policy.json'
+    path.write_text(json.dumps(guard))
+    args = (tid, '--day', DAY, '--session', KEY, '--guard', str(path), '--message', 'Inspect plan', '--json')
+    assert _command(*args) == 0
+    first = json.loads(capsys.readouterr().out)
+    assert _command(*args) == 0
+    assert json.loads(capsys.readouterr().out) == first
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, tid).status == 'blocked'
+        assert sum(e.kind == 'attention_requested' for e in kb.list_events(conn, tid)) == 1
