+"""Cache reuse must preserve schema freshness, ranking and caller mutation isolation."""
+import json
+from unittest.mock import patch
+import pytest
+from tools import mcp_schema_cache as mc, tool_search_catalog as cat
+
+
+def test_mcp_reuses_manifest_but_not_returned_objects(tmp_path,monkeypatch):
+    path=tmp_path/'manifest.json'
+    monkeypatch.setattr(mc,'_cache_path',lambda:path)
+    mc.write_cache_entry('a','fp',tools=[{'name':'one'}])
+    # Warm once, then no whole-file parse; return objects remain caller-owned.
+    mc.get_cached_entry('a','fp')
+    with patch.object(mc.json,'loads',wraps=json.loads) as loads:
+        first=mc.get_cached_entry('a','fp');first['tools'][0]['name']='mutated'
+        assert mc.get_cached_entry('a','fp')['tools'][0]['name']=='one'
+    assert loads.call_count==0
+    replacement=tmp_path/'new.json'
+    replacement.write_text(json.dumps({'a':{'fingerprint':'fp','tools':[{'name':'new'}]}}))
+    replacement.replace(path)
+    assert mc.get_cached_entry('a','fp')['tools'][0]['name']=='new'
+
+
+@pytest.mark.parametrize('ttl,written',[(float('nan'),1),(float('inf'),1),(1000,float('nan')),(1000,None)])
+def test_corrupt_mcp_ttl_is_not_an_immortal_hit(tmp_path,monkeypatch,ttl,written):
+    path=tmp_path/'manifest.json';monkeypatch.setattr(mc,'_cache_path',lambda:path)
+    path.write_text(json.dumps({'a':{'fingerprint':'fp','ttl_ms':ttl,'written_at':written}}))
+    assert mc.get_cached_entry('a','fp') is None
+
+
+def defs():
+    return [{'type':'function','function':{'name':f'fixture_{i}','description':'find project issue','parameters':{'type':'object','properties':{'id':{'type':'string'}}}}} for i in range(40)]
+
+
+def test_catalog_reuses_text_tokens_with_fresh_schema(monkeypatch):
+    monkeypatch.setattr(cat,'_classify_source',lambda name:('plugin','fixture'))
+    tools=defs();cat.build_catalog(tools)
+    with patch.object(cat,'_tokenize',wraps=cat._tokenize) as tokenize:
+        entries=cat.build_catalog(tools)
+    assert tokenize.call_count==0
+    tools[0]['function']['parameters']['properties']['id']['type']='integer'
+    assert cat.build_catalog(tools)[0].schema['function']['parameters']['properties']['id']['type']=='integer'
+    tools[0]['function']['description']='changed marker'
+    assert cat.build_catalog(tools)[0]._tokens != entries[0]._tokens
+
+
+def test_batch_reuses_corpus_stats(monkeypatch):
+    from tools import tool_search as search
+    monkeypatch.setattr(search,'_deferrable_in',lambda tools:tools)
+    monkeypatch.setattr(search,'connections_in_scope',lambda tools:False)
+    monkeypatch.setattr(search,'_available_source_summary',lambda catalog:[])
+    monkeypatch.setattr(search,'_record_search_metric',lambda *a,**kw:None)
+    with patch.object(cat,'_corpus_stats',wraps=cat._corpus_stats) as stats:
+        result=json.loads(search.dispatch_tool_search({'queries':['find issue','project issue','fixture_1']},current_tool_defs=defs()))
+    assert len(result['results'])==3
+    assert stats.call_count==1
+
+
+def test_prepared_validation_reuses_schema_and_detects_mutation(monkeypatch):
+    from tools import tool_search_validation as validation
+    from tools.registry import registry
+    import model_tools
+    params={'type':'object','properties':{'x':{'type':'string'}}}
+    monkeypatch.setattr(registry,'get_schema',lambda name:{'parameters':params})
+    monkeypatch.setattr(model_tools,'coerce_tool_args',lambda name,args:args)
+    # Validate both arguments every time; only schema preparation can be shared.
+    assert validation.validate_deferred_call_args('fixture',{'x':'text'}) is None
+    with patch.object(validation,'_schema_for_local_validation',wraps=validation._schema_for_local_validation) as prepare:
+        error=json.loads(validation.validate_deferred_call_args('fixture',{'x':3}))
+    assert error['constraint']=='type' and prepare.call_count==0
+    params['properties']['x']['type']='integer'
+    assert validation.validate_deferred_call_args('fixture',{'x':3}) is None
+    assert validation.validate_deferred_call_args('fixture',{'x':'text'}) is not None
+    params['properties']['x']={'$ref':'https://example.com/never-fetch'}
+    assert validation.validate_deferred_call_args('fixture',{'x':3}) is None
+
+
+def test_mcp_profile_switch_and_ttl_still_checked(tmp_path,monkeypatch):
+    a,b=tmp_path/'a.json',tmp_path/'b.json'
+    monkeypatch.setattr(mc,'_cache_path',lambda:a)
+    monkeypatch.setattr(mc.time,'time',lambda:10)
+    mc.write_cache_entry('s','same',tools=[{'name':'A'}],ttl_ms=1000)
+    assert mc.get_cached_entry('s','same')['tools'][0]['name']=='A'
+    monkeypatch.setattr(mc,'_cache_path',lambda:b)
+    assert mc.get_cached_entry('s','same') is None
+    monkeypatch.setattr(mc,'_cache_path',lambda:a)
+    monkeypatch.setattr(mc.time,'time',lambda:12)
+    assert mc.get_cached_entry('s','same') is None
