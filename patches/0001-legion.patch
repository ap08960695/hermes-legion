diff --git a/hermes_cli/account_usage_native_agy.py b/hermes_cli/account_usage_native_agy.py
new file mode 100644
index 0000000000000000000000000000000000000000..a2d1f40354c466e167560c11ae7387472b43c38a
--- /dev/null
+++ b/hermes_cli/account_usage_native_agy.py
@@ -0,0 +1,138 @@
+"""Read current AGY keyring sessions using the native metadata-only /usage command."""
+
+from datetime import datetime, UTC
+import json
+import math
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+PROVIDER = "antigravity-subscription-directsdk"
+
+
+def parse_native_usage(text):
+    doc = json.loads(text)
+    command = doc.get("command") or {}
+    usage = doc.get("usage") or {}
+    if (
+        doc.get("status") != "SUCCESS"
+        or command.get("name") != "usage"
+        or doc.get("num_turns") != 0
+        or usage.get("total_tokens") != 0
+        or any(value != 0 for value in usage.values())
+    ):
+        raise ValueError("Not a zero-turn native usage receipt")
+    groups = (command.get("data") or {}).get("groups")
+    if not isinstance(groups, list):
+        raise ValueError("Missing native quota groups")
+    windows = []
+    for group in groups:
+        if not isinstance(group, dict):
+            continue
+        for bucket in group.get("buckets") or []:
+            frac = bucket.get("remaining_fraction")
+            if (
+                bucket.get("disabled") is True
+                or isinstance(frac, bool)
+                or not isinstance(frac, (int, float))
+                or not math.isfinite(frac)
+                or not 0 <= frac <= 1
+            ):
+                continue
+            windows.append(
+                dict(
+                    label=f"{group.get('name', 'Quota')} / {bucket.get('window', 'window')}",
+                    used_percent=round((1 - frac) * 100, 6),
+                    scope="model",
+                    resets_at=bucket.get("reset_time") or None,
+                )
+            )
+    return windows
+
+
+def collect_native(source, *, runner=subprocess.run):
+    row = dict(
+        provider=PROVIDER,
+        id=source["id"],
+        label=source["label"],
+        fetched_at=datetime.now(UTC).isoformat(),
+        windows=[],
+        reason=None,
+    )
+    # The official CLI owns the OS keyring. Never read/copy the obsolete community
+    # CLI token file or substitute another account, API key, prompt or paid fallback.
+    names = (
+        "HOME",
+        "USERPROFILE",
+        "PATH",
+        "LANG",
+        "LC_ALL",
+        "DBUS_SESSION_BUS_ADDRESS",
+        "XDG_RUNTIME_DIR",
+        "DISPLAY",
+        "WAYLAND_DISPLAY",
+        "XAUTHORITY",
+        "SSL_CERT_FILE",
+        "SSL_CERT_DIR",
+        "HTTPS_PROXY",
+        "HTTP_PROXY",
+        "NO_PROXY",
+    )
+    env = {k: os.environ[k] for k in names if k in os.environ}
+    env["AGY_CLI_DISABLE_AUTO_UPDATE"] = "1"
+    try:
+        with tempfile.TemporaryDirectory(prefix="hermes-agy-metadata-") as cwd:
+            result = runner(
+                [source["command"], "-p", "/usage", "--output-format", "json"],
+                cwd=cwd,
+                env=env,
+                capture_output=True,
+                text=True,
+                timeout=20,
+            )
+        if result.returncode:
+            row["reason"] = (
+                "Native AGY usage unavailable; no inference fallback was attempted."
+            )
+        else:
+            row["windows"] = parse_native_usage(result.stdout)
+            if not row["windows"]:
+                row["reason"] = "Native AGY returned no active quota buckets."
+    except (OSError, subprocess.TimeoutExpired, ValueError, TypeError, AttributeError):
+        row["reason"] = (
+            "Native AGY metadata could not be read; no inference fallback was attempted."
+        )
+    return row
+
+
+def refresh_native_accounts(home):
+    """Refresh explicitly configured native accounts; preserve unrelated adapter observations."""
+    home = Path(home)
+    try:
+        config = json.loads((home / "account-usage.json").read_text())
+    except (OSError, ValueError):
+        return
+    sources = [
+        s for s in config.get("agy_accounts", []) if s.get("mode") == "native-keyring"
+    ]
+    if not sources:
+        return
+    path = home / "state/account-usage/external.json"
+    try:
+        prior = json.loads(path.read_text()).get("accounts", [])
+    except (OSError, ValueError):
+        prior = []
+    ids = {s["id"] for s in sources}
+    rows = [r for r in prior if r.get("provider") != PROVIDER or r.get("id") not in ids]
+    rows.extend(collect_native(s) for s in sources)
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    with tempfile.NamedTemporaryFile(
+        mode="w", prefix=".native-", dir=path.parent, delete=False
+    ) as f:
+        pending = Path(f.name)
+        json.dump({"accounts": rows}, f)
+    try:
+        os.replace(pending, path)
+    finally:
+        pending.unlink(missing_ok=True)
