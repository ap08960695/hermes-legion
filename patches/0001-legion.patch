+        identity = dict(task_id=tid, platform='tui', chat_id='captain-session', thread_id='')
+        texts, _ = _kb_prepare_sub(kb, conn, sub, 'default', identity)
+        assert texts == []
+        # Other observer is processed by the identical production preparation path.
+        sub = next(s for s in kbn.list_notify_subs(conn, tid) if s['chat_id'] == 'other-session')
+        identity['chat_id'] = 'other-session'
+        texts, _ = _kb_prepare_sub(kb, conn, sub, 'default', identity)
+        assert len(texts) == 1
