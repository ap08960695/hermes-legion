@@ -0,0 +1,36 @@
+"""Terra's configured reasoning depth must survive the Codex request boundary."""
+
+import pytest
+
+from agent.transports.codex import ResponsesApiTransport
+
+
+@pytest.mark.parametrize("model", ["gpt-6.1-terra", "openai/gpt-6.1-terra", "gpt-6.1-terra-2026-10-26"])
+def test_terra_preserves_max_on_codex_wire(model):
+    request = ResponsesApiTransport().build_kwargs(
+        model=model,
+        messages=[{"role": "user", "content": "Check a synthetic result."}],
+        tools=[],
+        provider="openai-codex",
+        base_url="https://chatgpt.com/backend-api/codex",
+        reasoning_config={"enabled": True, "effort": "max"},
+    )
+    assert request["reasoning"]["effort"] == "max"
+
+
+@pytest.mark.parametrize("model,effort,expected", [
+    ("gpt-6.1-terra", "high", "high"),
+    ("gpt-6.1-terra", "none", "none"),
+    ("gpt-5.5", "max", "xhigh"),
+    ("gpt-6.1-sol", "max", "max"),
+])
+def test_sibling_depth_contracts(model, effort, expected):
+    request = ResponsesApiTransport().build_kwargs(
+        model=model,
+        messages=[{"role": "user", "content": "Check a synthetic result."}],
+        tools=[],
+        provider="openai-codex",
+        base_url="https://chatgpt.com/backend-api/codex",
+        reasoning_config={"enabled": effort != "none", "effort": effort},
+    )
+    assert request["reasoning"]["effort"] == expected
