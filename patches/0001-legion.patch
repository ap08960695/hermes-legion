+def test_corrupt_goal_is_not_interpreted_as_absent(own_session):
+    from hermes_cli import goal_self
+    _, db = own_session
+    db.set_meta('goal:self', '{invalid')
+    with pytest.raises(ValueError, match='goal state'):
+        goal_self.ensure_current_goal(OBJECTIVE)
+    assert db.get_meta('goal:self') == '{invalid'
+
