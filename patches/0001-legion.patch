+def test_missing_database_is_not_initialized(tmp_path, monkeypatch):
+    from hermes_cli import goal_self
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    with scoped_current_session_id('missing'):
+        with pytest.raises(ValueError, match='existing'):
+            goal_self.inspect_current_goal()
+    assert not (tmp_path / 'state.db').exists()
