+"""Web workers must finish MCP initialization before sending their first model turn."""
+import pytest
+from agent.transports.codex_app_server_session import CodexAppServerSession
+from agent.transports.codex_app_server import CodexAppServerError
+
+
+class Client:
+    def __init__(self, tools, server='hermes-tools'):
+        self.server = server
+        self.calls = []
+        self.tools = tools
+    def initialize(self, **kwargs): pass
+    def request(self, method, params, **kwargs):
+        self.calls.append(method)
+        if method == 'thread/start': return {'thread': {'id': 't-public'}}
+        if method == 'mcpServerStatus/list':
+            return {'data': [{'name':self.server, 'tools':{name:{} for name in self.tools}}]}
+        raise AssertionError(method)
+
+
+@pytest.mark.parametrize('ready', [True, False])
+def test_web_worker_gates_first_turn_on_managed_handoff_tools(monkeypatch, tmp_path, ready):
+    monkeypatch.setenv('HERMES_KANBAN_TASK', 't-public')
+    monkeypatch.delenv('HERMES_DELEGATED_CHILD_CONTEXT', raising=False)
+    client = Client(['kanban_show','kanban_complete','kanban_block'] if ready else ['skills_list'])
+    session = CodexAppServerSession(cwd=str(tmp_path), model='chatgpt-web/gpt-6-sol',
+                                   client_factory=lambda **kw: client)
+    if ready:
+        assert session.ensure_started() == 't-public'
+        assert session.ensure_started() == 't-public'
+    else:
+        with pytest.raises(CodexAppServerError, match='Kanban MCP'):
+            session.ensure_started()
+    assert client.calls == ['thread/start', 'mcpServerStatus/list']
+
+
+def test_regular_model_does_not_pay_web_startup_barrier(monkeypatch, tmp_path):
+    monkeypatch.setenv('HERMES_KANBAN_TASK', 't-public')
+    client = Client([])
+    session = CodexAppServerSession(cwd=str(tmp_path), model='gpt-6.1-sol',client_factory=lambda **kw: client)
+    assert session.ensure_started() == 't-public'
+    assert client.calls == ['thread/start']
