+"""Wire-only status policy. A quiet refusal never authorizes a new turn."""
+from gateway.config import Platform
+
+
+def quiet_pause_notice(runner, event, source) -> bool:
+    if getattr(event, '_heartbeat_session_id', None):
+        return True
+    if source.platform != Platform.SLACK:
+        return False
+    adapter = runner._delivery_adapter_for(source)
+    return adapter is not None and adapter.config.extra.get('system_status_notifications', True) is False
