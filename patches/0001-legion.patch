index 0000000000000000000000000000000000000000..6ed3629dc708ca39149108e8448822165302bceb
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_attention.py
@@ -0,0 +1,227 @@
+"""Daily attention is atomic, opt-in, state-preserving and fail-closed."""
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import asdict
+from datetime import UTC, datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_notify as notify
+from hermes_cli import kanban_db_tui_delivery as delivery
+
+DAY = '2026-10-18'
+NOW = datetime(2026, 10, 18, 0, tzinfo=UTC).timestamp()  # 07:00 Bangkok
+KEY = 'attention-fixture'
+BODY = 'Review the existing plan. Preserve rights, review and publication gates.'
+REASON = 'Captain: review daily plan 2026-10-18'
+
+
+@pytest.fixture(autouse=True)
+def _clock(monkeypatch):
+    from hermes_cli import kanban_db_attention
+    monkeypatch.setattr(kanban_db_attention, 'time', SimpleNamespace(time=lambda: NOW))
+
+
+def _fixture(conn, tmp_path, *, status='todo', typed=False):
+    workspace = str(tmp_path.resolve())
+    tid = kb.create_task(conn, title='daily plan', body=BODY,
+                         initial_status='blocked' if status == 'blocked' else 'running',
+                         created_by='morning-fixture', workspace_kind='dir', workspace_path=workspace,
+                         idempotency_key=f'morning-fixture:{DAY}')
+    if status == 'todo':
+        with kbc.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='todo' WHERE id=?", (tid,))
+    if typed:
+        kb.add_comment(conn, tid, 'fixture-cli', REASON)
+        assert kb.block_task(conn, tid, reason=REASON, kind='needs_input')
+    notify.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY,
+                          notifier_profile='default', delivery_mode='notify+wake')
+    guard = dict(version=1, workspace=workspace, created_by='morning-fixture',
+                 idempotency_key=f'morning-fixture:{DAY}', body_sha256=hashlib.sha256(BODY.encode()).hexdigest(),
+                 initial_block_reason=REASON, initial_comment_author='fixture-cli')
+    return tid, guard
+
+
+def _request(conn, tid, guard, **kwargs):
+    from hermes_cli.kanban_db_attention import request_attention
+    return request_attention(conn, task_id=tid, day=DAY, session_key=KEY, guard=guard,
+                             message='Inspect this existing plan; do not bypass any gate.',
+                             now=kwargs.pop('now', NOW), **kwargs)
+
+
+@pytest.mark.parametrize('status,typed', [('todo', False), ('ready', False),
+                                        ('blocked', False), ('blocked', True)])
+def test_daily_request_preserves_task_and_has_one_atomic_receipt(tmp_path, status, typed):
+    with kbc.connect_closing() as conn:
+        tid, guard = _fixture(conn, tmp_path, status=status, typed=typed)
+        before = asdict(kb.get_task(conn, tid))
+        first = _request(conn, tid, guard)
+        second = _request(conn, tid, guard)
+        assert first == second
+        assert asdict(kb.get_task(conn, tid)) == before
+        events = [e for e in kb.list_events(conn, tid) if e.kind == 'attention_requested']
+        assert len(events) == 1 and events[0].id == first['event_id']
+    pending = delivery.pending(kb.kanban_db_path(), home=delivery.owner_home(), session_key=KEY)
+    assert len(pending) == 1 and pending[0].delivery_ref.id == first['delivery_id']
+    texts, claim = delivery.claim(pending, home=delivery.owner_home(), session_key=KEY)
+    assert len(texts) == 1
+    claim.mark('settled')
+    assert delivery.pending(kb.kanban_db_path(), home=delivery.owner_home(), session_key=KEY) == []
+
+
+@pytest.mark.parametrize('stamp', [NOW - 1, NOW - 7 * 3600 - 1, NOW + 24 * 3600])
+def test_wrong_day_or_before_seven_emits_nothing(tmp_path, stamp):
+    with kbc.connect_closing() as conn:
+        tid, guard = _fixture(conn, tmp_path)
+        events = kb.list_events(conn, tid)
+        with pytest.raises(ValueError, match='Bangkok'):
+            _request(conn, tid, guard, now=stamp)
+        assert kb.list_events(conn, tid) == events
+
+
+@pytest.mark.parametrize('change', ['owner-comment', 'body', 'assignee', 'running', 'review', 'done',
+                                  'archived', 'dependency-block', 'foreign-workspace', 'forged-body-hash'])
+def test_eligibility_rejects_unknown_activity_and_gates(tmp_path, change):
+    with kbc.connect_closing() as conn:
+        tid, guard = _fixture(conn, tmp_path)
+        if change == 'owner-comment':
+            kb.add_comment(conn, tid, 'owner', 'OwnerGATE: pause until I answer')
+        elif change in ('foreign-workspace', 'forged-body-hash'):
+            key, value = {'foreign-workspace': ('workspace', str(tmp_path / 'another')),
+                          'forged-body-hash': ('body_sha256', '0' * 64)}[change]
+            guard[key] = value
+        else:
+            # External edits are an I/O boundary: the guard must not rely only on well-behaved mutators.
+            edits = {'body': "body='OwnerGATE: paused'", 'assignee': "assignee='other-worker'",
+                     'dependency-block': "status='blocked',block_kind='dependency'",
+                     **{state: f"status='{state}'" for state in ('running', 'review', 'done', 'archived')}}
+            with kbc.write_txn(conn):
+                conn.execute(f'UPDATE tasks SET {edits[change]} WHERE id=?', (tid,))
+        before = kb.list_events(conn, tid)
+        with pytest.raises(ValueError, match='eligib|guard'):
+            _request(conn, tid, guard)
+        assert kb.list_events(conn, tid) == before
+
+
+def test_owner_comment_after_enqueue_cancels_before_worker_claim(tmp_path):
+    with kbc.connect_closing() as conn:
+        tid, guard = _fixture(conn, tmp_path)
+        _request(conn, tid, guard)
+        kb.add_comment(conn, tid, 'owner', 'Pause this work')
+    pending = delivery.pending(kb.kanban_db_path(), home=delivery.owner_home(), session_key=KEY)
+    texts, claim = delivery.claim(pending, home=delivery.owner_home(), session_key=KEY)
+    assert texts == [] and claim.refs == ()
+    assert delivery.read_receipts(kb.kanban_db_path(), home=delivery.owner_home(),
+                                  session_key=KEY)[0]['state'] == 'cancelled'
+
+
+def test_late_caller_cannot_retarget_or_change_the_daily_request(tmp_path):
+    from hermes_cli.kanban_db_attention import request_attention
+    with kbc.connect_closing() as conn:
+        tid, guard = _fixture(conn, tmp_path)
+        receipt = _request(conn, tid, guard)
+        with pytest.raises(ValueError, match='identity|conflict'):
+            request_attention(conn, task_id=tid, day=DAY, session_key='different', guard=guard,
+                              message='different work', now=NOW)
+        assert _request(conn, tid, guard) == receipt
+
+
+def test_route_requires_explicit_wake_and_matching_profile(tmp_path):
+    with kbc.connect_closing() as conn:
+        tid, guard = _fixture(conn, tmp_path)
+        notify.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY, delivery_mode='notify')
+        with pytest.raises(ValueError, match='route'):
+            _request(conn, tid, guard)
+
+
+def test_two_producers_share_the_same_day_receipt(tmp_path):
+    path = kb.kanban_db_path()
+    with kbc.connect_closing(path) as conn:
+        tid, guard = _fixture(conn, tmp_path)
+    barrier = threading.Barrier(2, timeout=5)
+
+    def run(_):
+        with kbc.connect_closing(path) as conn:
+            barrier.wait()
+            return _request(conn, tid, guard)
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(run, range(2)))
+    assert results[0] == results[1]
+    assert len(delivery.pending(path, home=delivery.owner_home(), session_key=KEY)) == 1
+
+
+def test_prepare_failure_rolls_back_daily_receipt_and_event(tmp_path, monkeypatch):
+    def fail(*args, **kwargs):
+        raise RuntimeError('failed before atomic commit')
+    with kbc.connect_closing() as conn:
+        tid, guard = _fixture(conn, tmp_path)
+        before = kb.list_events(conn, tid)
+        with monkeypatch.context() as patch:
+            patch.setattr(delivery, 'prepare', fail)
+            with pytest.raises(RuntimeError, match='atomic commit'):
+                _request(conn, tid, guard)
+        assert kb.list_events(conn, tid) == before
+        assert _request(conn, tid, guard)['event_id'] > before[-1].id
+
+
+@pytest.mark.parametrize('boundary', ['before-commit', 'after-commit'])
+def test_process_exit_preserves_atomic_daily_request(tmp_path, boundary):
+    path = kb.kanban_db_path()
+    with kbc.connect_closing(path) as conn:
+        tid, guard = _fixture(conn, tmp_path)
+        before = kb.list_events(conn, tid)
+    code = '''
+import json, os, sys
+from pathlib import Path
+from hermes_cli import kanban_db_connect as kbc, kanban_db_tui_delivery as delivery
+from hermes_cli.kanban_db_attention import request_attention
+path, tid, day, key, policy, now, boundary = sys.argv[1:]
+if boundary == 'before-commit':
+    original = delivery.prepare
+    def prepare(*args, **kwargs):
+        original(*args, **kwargs)
+        os._exit(27)
+    delivery.prepare = prepare
+with kbc.connect_closing(Path(path)) as conn:
+    request_attention(conn, task_id=tid, day=day, session_key=key, guard=json.loads(policy),
+                      message='Inspect this existing plan; do not bypass any gate.', now=float(now))
+os._exit(27)
+'''
+    root = Path(__file__).resolve().parents[2]
+    env = {**os.environ, 'PYTHONPATH': str(root), 'HERMES_DISABLE_LAZY_INSTALLS': '1'}
+    child = subprocess.run([sys.executable, '-c', code, str(path), tid, DAY, KEY, json.dumps(guard),
+                            str(NOW), boundary], env=env, cwd=root, capture_output=True, timeout=30, check=False)
+    assert child.returncode == 27, child.stderr.decode(errors='replace')[-1000:]
+    with kbc.connect_closing(path) as conn:
+        if boundary == 'before-commit':
+            assert kb.list_events(conn, tid) == before
+        first = _request(conn, tid, guard)
+        assert _request(conn, tid, guard) == first
+        assert sum(e.kind == 'attention_requested' for e in kb.list_events(conn, tid)) == 1
+    assert len(delivery.pending(path, home=delivery.owner_home(), session_key=KEY)) == 1
+
+
+@pytest.mark.parametrize('change', ['assigned', 'done', 'body', 'passive-route', 'foreign-profile'])
+def test_request_is_rechecked_at_consumer_claim(tmp_path, change):
+    with kbc.connect_closing() as conn:
+        tid, guard = _fixture(conn, tmp_path)
+        _request(conn, tid, guard)
+        edits = {
+            'assigned': "UPDATE tasks SET assignee='another' WHERE id=?",
+            'done': "UPDATE tasks SET status='done' WHERE id=?",
+            'body': "UPDATE tasks SET body='OwnerGATE hold' WHERE id=?",
+            'passive-route': "UPDATE kanban_notify_subs SET delivery_mode='notify' WHERE task_id=?",
+            'foreign-profile': "UPDATE kanban_notify_subs SET notifier_profile='foreign' WHERE task_id=?",
+        }
+        with kbc.write_txn(conn):
+            conn.execute(edits[change], (tid,))
+    texts = delivery.pending(kb.kanban_db_path(), home=delivery.owner_home(), session_key=KEY)
+    assert delivery.claim(texts, home=delivery.owner_home(), session_key=KEY)[0] == []
