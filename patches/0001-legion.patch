+def test_competing_self_goals_commit_only_one_native_state(own_session, monkeypatch):
+    from hermes_cli import goal_self
+    _, db = own_session
+    read = db.get_meta
+    barrier = threading.Barrier(2)
+    entered = threading.local()
+
+    def simultaneous(key):
+        value = read(key)
+        if key == 'goal:self' and value is None and not getattr(entered, 'once', False):
+            entered.once = True
+            barrier.wait(timeout=10)
+        return value
+
+    monkeypatch.setattr(db, 'get_meta', simultaneous)
+
+    def ensure(text):
+        with scoped_current_session_id('self'):
+            return goal_self.ensure_current_goal(text)
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(ensure, [OBJECTIVE, OBJECTIVE.replace('approved artifact', 'approved report')]))
+    assert sorted(result['created'] for result in results) == [False, True]
+    assert goals.load_goal('self').goal in ['Deliver the approved artifact', 'Deliver the approved report']
+
+
+def test_status_and_show_are_read_only_and_avoid_transcript_reads(own_session, monkeypatch):
+    from hermes_cli import goal_self
+    from hermes_state import SessionDB
+    _, db = own_session
+    goal_self.ensure_current_goal(OBJECTIVE)
+    before = db.get_meta('goal:self')
+
+    def forbidden(*args, **kwargs):
+        pytest.fail('Goal status must not open a writer or materialize transcript/prompt data')
+
+    monkeypatch.setattr(SessionDB, 'get_session', forbidden)
+    monkeypatch.setattr(SessionDB, '_execute_write', forbidden)
+    status = goal_self.inspect_current_goal()
+    assert status['status'] == 'active' and 'goal' not in status
+    shown = goal_self.inspect_current_goal(include_goal=True)
+    assert shown['goal'] == 'Deliver the approved artifact'
+    assert db.get_meta('goal:self') == before
+
