@@ -0,0 +1,312 @@
+"""Native self-goals preserve profile/session scope, owner state and turn limits."""
+
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import json
+from pathlib import Path
+import queue
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import goals
+from gateway.session_context import scoped_current_session_id
+
+OBJECTIVE = ('Deliver the approved artifact\n'
+             'outcome: The artifact exists and all requested checks pass\n'
+             'verification: Inspect the artifact and run the offline test suite\n'
+             'constraints: Keep current quotas, permissions and provider settings\n'
+             'boundaries: The assigned working directory')
+
+
+@pytest.fixture
+def own_session(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    home = tmp_path / 'owner'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_SESSION_ID', 'self')
+    (home / 'config.yaml').write_text('goals:\n  max_turns: 7\n  allow_self_management: true\n')
+    goals._DB_CACHE.clear()
+    db = goals._get_session_db()
+    assert db is not None
+    db.create_session('self', source='cli')
+    db.create_session('other', source='cli')
+    with scoped_current_session_id('self'):
+        yield home, db
+    goals._DB_CACHE.clear()
+
+
+def _parse(argv):
+    from hermes_cli.subcommands.sessions import build_sessions_parser
+    parser = argparse.ArgumentParser()
+    build_sessions_parser(parser.add_subparsers(dest='command'), cmd_sessions=lambda args: None)
+    return parser.parse_args(argv)
+
+
+def test_native_goal_subcommand_is_available_without_starting_a_chat(own_session, capsys):
+    args = _parse(['goal', 'status'])
+    assert args.func(args) == 0
+    result = json.loads(capsys.readouterr().out)
+    assert result['session_id'] == 'self' and result['goal_present'] is False
+
+
+def test_ensure_creates_native_contract_once_without_judge_or_budget_change(own_session, monkeypatch):
+    from hermes_cli import goal_self
+    home, db = own_session
+    config = (home / 'config.yaml').read_bytes()
+
+    def forbidden(*args, **kwargs):
+        pytest.fail('Setting a self-goal must not request inference')
+
+    monkeypatch.setattr(goals, 'judge_goal', forbidden)
+    first = goal_self.ensure_current_goal(OBJECTIVE)
+    raw = db.get_meta('goal:self')
+    state = goals.load_goal('self')
+    assert first['created'] is True and first['status'] == 'active'
+    assert state.goal == 'Deliver the approved artifact'
+    assert state.max_turns == 7 and state.turns_used == 0
+    assert state.contract.outcome == 'The artifact exists and all requested checks pass'
+    assert state.contract.verification == 'Inspect the artifact and run the offline test suite'
+    assert goal_self.ensure_current_goal(OBJECTIVE)['created'] is False
+    assert db.get_meta('goal:self') == raw
+    assert db.get_meta('goal:other') is None
+    assert (home / 'config.yaml').read_bytes() == config
+
+
+@pytest.mark.parametrize('status', ['active', 'paused', 'cleared'])
+def test_existing_owner_state_is_not_replaced_or_resumed(own_session, status):
+    from hermes_cli import goal_self
+    _, db = own_session
+    state = goals.GoalState(goal='Existing owner objective', status=status, max_turns=11, turns_used=4)
+    db.set_meta('goal:self', state.to_json())
+    before = db.get_meta('goal:self')
+    result = goal_self.ensure_current_goal(OBJECTIVE)
+    assert result['created'] is False and result['status'] == status
+    assert db.get_meta('goal:self') == before
+
+
+def test_a_completed_identical_goal_is_not_reopened(own_session):
+    from hermes_cli import goal_self
+    _, db = own_session
+    goal_self.ensure_current_goal(OBJECTIVE)
+    state = goals.load_goal('self')
+    state.status = 'done'
+    db.set_meta('goal:self', state.to_json())
+    before = db.get_meta('goal:self')
+    assert goal_self.ensure_current_goal(OBJECTIVE)['status'] == 'done'
+    assert db.get_meta('goal:self') == before
+
+
+def test_a_new_request_after_completion_uses_the_existing_profile_cap(own_session):
+    from hermes_cli import goal_self
+    _, db = own_session
+    state = goals.GoalState(goal='Previous completed objective', status='done', max_turns=11, turns_used=4)
+    db.set_meta('goal:self', state.to_json())
+    assert goal_self.ensure_current_goal(OBJECTIVE)['created'] is True
+    current = goals.load_goal('self')
+    assert current.max_turns == 7 and current.turns_used == 0
+
+
+def test_a_closed_session_is_not_reopened(own_session):
+    from hermes_cli import goal_self
+    _, db = own_session
+    db._write_rowcount('UPDATE sessions SET ended_at=? WHERE id=?', (1, 'self'))
+    with pytest.raises(ValueError, match='closed'):
+        goal_self.ensure_current_goal(OBJECTIVE)
+    assert db.get_meta('goal:self') is None
+
+
+def test_an_explicitly_cleared_context_does_not_fall_back_to_stale_environment(own_session):
+    from hermes_cli import goal_self
+    with scoped_current_session_id(''):
+        with pytest.raises(ValueError, match='bound'):
+            goal_self.inspect_current_goal()
+
+
+def test_stdin_is_bounded_before_any_goal_write(own_session, monkeypatch, capsys):
+    from hermes_cli import goal_self
+    import io
+    _, db = own_session
+    monkeypatch.setattr(goal_self.sys, 'stdin', io.StringIO('x' * 20_000))
+    args = _parse(['goal', 'ensure'])
+    assert args.func(args) == 1
+    assert json.loads(capsys.readouterr().err)['retry_safe'] is False
+    assert db.get_meta('goal:self') is None
+
+
+@pytest.mark.parametrize('override', ['--session-id', '--max-turns'])
+def test_the_cli_has_no_foreign_session_or_budget_override(override):
+    with pytest.raises(SystemExit):
+        _parse(['goal', 'ensure', OBJECTIVE, override, 'other'])
+
+
+def test_a_committed_goal_with_lost_readback_is_not_reported_as_unchanged(own_session, monkeypatch, capsys):
+    _, db = own_session
+    original = db.get_meta
+    count = 0
+
+    def lose_readback(key):
+        nonlocal count
+        count += 1
+        if count == 2:
+            raise OSError('fixture lost the write receipt')
+        return original(key)
+
+    monkeypatch.setattr(db, 'get_meta', lose_readback)
+    args = _parse(['goal', 'ensure', OBJECTIVE])
+    assert args.func(args) == 1
+    error = json.loads(capsys.readouterr().err)
+    assert error.get('outcome') == 'unproven' and error.get('retry_safe') is False
+    assert original('goal:self') is not None
+
+
+def test_disabled_profile_refuses_creation(own_session):
+    from hermes_cli import goal_self
+    home, db = own_session
+    (home / 'config.yaml').write_text('goals:\n  max_turns: 7\n  allow_self_management: false\n')
+    with pytest.raises(ValueError, match='disabled'):
+        goal_self.ensure_current_goal(OBJECTIVE)
+    assert db.get_meta('goal:self') is None
+
+
+@pytest.mark.parametrize('goal', ['Vague request', 'outcome: Something exists'])
+def test_self_goal_requires_outcome_and_verification(own_session, goal):
+    from hermes_cli import goal_self
+    _, db = own_session
+    with pytest.raises(ValueError, match='outcome.*verification'):
+        goal_self.ensure_current_goal(goal)
+    assert db.get_meta('goal:self') is None
+
+
+@pytest.mark.parametrize('marker', ['HERMES_KANBAN_RUN_ID', 'HERMES_DELEGATED_CHILD_CONTEXT'])
+def test_worker_cannot_extend_its_work_with_a_new_session_goal(own_session, monkeypatch, marker):
+    from hermes_cli import goal_self
+    _, db = own_session
+    monkeypatch.setenv(marker, '1')
+    with pytest.raises(ValueError, match='worker'):
