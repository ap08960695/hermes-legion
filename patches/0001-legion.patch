+"""Native lifecycle regression tests; no model calls or live board changes."""
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+from hermes_cli import kanban_db as kb,kanban_db_connect as kbc,kanban_db_dispatch as dispatch
+from hermes_cli import kanban_task_contract as contract
+
+
+@pytest.fixture
+def board(tmp_path,monkeypatch):
+    monkeypatch.setenv('HERMES_HOME',str(tmp_path))
+    monkeypatch.setenv('HERMES_KANBAN_HOME',str(tmp_path))
+    monkeypatch.setenv('HERMES_KANBAN_DB',str(tmp_path/'board.db'))
+    monkeypatch.setattr(Path,'home',lambda:tmp_path)
+    kb.init_db()
+    conn=kbc.connect()
+    yield conn
+    conn.close()
+
+
+def make(board,tmp_path,body='original brief'):
+    return kb.create_task(board,title='offline',body=body,assignee='analyst',workspace_kind='dir',workspace_path=str(tmp_path))
+
+
+def pinned_body():
+    return '```hermes-contract\n'+json.dumps({'version':1,'inputs':{'input.txt':hashlib.sha256(b'original').hexdigest()}})+'\n```'
+
+
+@pytest.mark.parametrize('action',['complete','review'])
+def test_changed_brief_cannot_publish_result_from_old_run(board,tmp_path,action):
+    tid=make(board,tmp_path);run=kb.claim_task(board,tid)
+    with kb.write_txn(board):board.execute('UPDATE tasks SET body=? WHERE id=?',('new brief',tid))
+    with pytest.raises(ValueError,match='brief changed'):
+        if action=='complete':kb.complete_task(board,tid,summary='old result',expected_run_id=run.current_run_id)
+        else:kb.request_review(board,tid,summary='old result',expected_run_id=run.current_run_id)
+    assert kb.get_task(board,tid).status=='running'
+    assert kb.get_task(board,tid).current_run_id==run.current_run_id
+
+
+def test_declared_input_without_tests_is_still_validated(board,tmp_path):
+    (tmp_path/'input.txt').write_text('changed')
+    tid=make(board,tmp_path,pinned_body())
+    with pytest.raises(ValueError,match='hash mismatch'):kb.complete_task(board,tid,summary='stale')
+    assert kb.get_task(board,tid).status=='ready'
+
+
+def test_preflight_parks_known_bad_inputs_without_worker_or_retry_loop(board,tmp_path,monkeypatch):
+    (tmp_path/'input.txt').write_text('changed');tid=make(board,tmp_path,pinned_body())
+    monkeypatch.setattr(dispatch,'_profile_exists_fn',lambda:lambda _:True)
+    spawns=[]
+    for _ in range(2):dispatch.dispatch_once(board,spawn_fn=lambda *a,**kw:spawns.append(a),reconcile_orphans=False)
+    task=kb.get_task(board,tid)
+    assert not spawns and task.block_kind=='capability' and task.status!='running'
+    assert task.consecutive_failures==0 and len(kb.list_runs(board,tid))==1
+
+
+def test_preflight_dry_run_and_unclaimed_legacy_are_preserved(board,tmp_path,monkeypatch):
+    (tmp_path/'input.txt').write_text('changed');tid=make(board,tmp_path,pinned_body())
+    monkeypatch.setattr(dispatch,'_profile_exists_fn',lambda:lambda _:True)
+    before=[e.id for e in kb.list_events(board,tid)]
+    result=dispatch.dispatch_once(board,dry_run=True,reconcile_orphans=False)
+    assert result.respawn_guarded and kb.get_task(board,tid).status=='ready'
+    assert before==[e.id for e in kb.list_events(board,tid)]
+    legacy=make(board,tmp_path)
+    assert kb.complete_task(board,legacy,summary='legacy success')
+
+
+@pytest.mark.parametrize('action',['complete','review'])
+def test_commit_rechecks_brief_changed_after_outer_validation(board,tmp_path,monkeypatch,action):
+    tid=make(board,tmp_path);run=kb.claim_task(board,tid)
+    original=contract.validate_handoff
+    def changed(*args,**kwargs):
+        result=original(*args,**kwargs)
+        with kb.write_txn(board):board.execute('UPDATE tasks SET body=? WHERE id=?',('raced brief',tid))
+        return result
+    monkeypatch.setattr(contract,'validate_handoff',changed)
+    with pytest.raises(ValueError,match='brief changed'):
+        if action=='complete':kb.complete_task(board,tid,summary='old',expected_run_id=run.current_run_id)
+        else:kb.request_review(board,tid,summary='old',expected_run_id=run.current_run_id)
+    assert kb.get_task(board,tid).status=='running'
+
+
+def test_native_claim_pin_does_not_freeze_later_workspace_allocation(board,tmp_path):
+    tid=kb.create_task(board,title='offline',body='same brief',assignee='analyst')
+    run=kb.claim_task(board,tid)
+    with kb.write_txn(board):board.execute('UPDATE tasks SET workspace_path=? WHERE id=?',(str(tmp_path),tid))
+    assert kb.complete_task(board,tid,summary='finished',expected_run_id=run.current_run_id)
+
+
+def test_legacy_claim_without_pin_remains_compatible(board,tmp_path):
+    tid=make(board,tmp_path);run=kb.claim_task(board,tid)
+    with kb.write_txn(board):
+        event=board.execute("SELECT id,payload FROM task_events WHERE task_id=? AND kind='claimed' ORDER BY id DESC LIMIT 1",(tid,)).fetchone()
+        payload=json.loads(event['payload']);payload.pop('brief_pin')
+        board.execute('UPDATE task_events SET payload=? WHERE id=?',(json.dumps(payload),event['id']))
+        board.execute('UPDATE tasks SET body=? WHERE id=?',('legacy changed brief',tid))
+    assert kb.complete_task(board,tid,summary='legacy result',expected_run_id=run.current_run_id)
