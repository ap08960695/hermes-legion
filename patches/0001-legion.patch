+            shared_layout_version=layout_version(stored) or 2)["stable"]
         if static and stored.startswith(static):
             agent._cached_system_prompt_static = static
             agent._static_rebuild_failed_for = None
diff --git a/agent/cache_request_diagnostics.py b/agent/cache_request_diagnostics.py
new file mode 100644
--- /dev/null
+++ b/agent/cache_request_diagnostics.py
@@ -0,0 +1,174 @@
+"""Content-free fingerprints for the existing provider request log.
+
+Observe the prepared request after transport preflight, not the server's hidden prefix or
+SDK wire serialization. HMACs are profile-local and survive resume; nothing here changes
+cache policy, request data, compaction or routing. Fail-open diagnostics never retry calls.
+"""
+from __future__ import annotations
+
+from contextlib import suppress
+import hashlib
+import hmac
+import json
+import logging
+import os
+import stat
+import time
+
+logger = logging.getLogger('agent.conversation_loop')
+_MAX_BYTES = 8 * 1024 * 1024
+_ANCHORS = (4096, 16384, 65536, 262144, 1048576, 4194304)
+_ENCODER = json.JSONEncoder(ensure_ascii=True, sort_keys=True, separators=(',', ':'), allow_nan=False)
+
+
+def _profile_key() -> bytes:
+    from hermes_constants import get_hermes_home
+
+    directory = get_hermes_home() / 'telemetry' / 'cache-diagnostics'
+    directory.mkdir(parents=True, mode=0o700, exist_ok=True)
+    path = directory / 'fingerprint.key'
+    # Exclusive creation makes simultaneous sessions share one key, without replacing it.
+    try:
+        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+    except FileExistsError:
+        pass
+    else:
+        with os.fdopen(fd, 'wb') as stream:
+            stream.write(os.urandom(32))
+    fd = os.open(path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
+    with os.fdopen(fd, 'rb') as stream:
+        info = os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077:
+            raise ValueError('unsafe diagnostic key permissions')
+        key = stream.read(33)
+    if len(key) != 32:
+        raise ValueError('incomplete diagnostic key')
+    return key
+
+
+def _digest(key: bytes, value, budget: list[int], *, anchors: bool = False) -> dict:
+    digest = hmac.new(key, digestmod=hashlib.sha256)
+    count, prefixes = 0, {}
+    for text in _ENCODER.iterencode(value):
+        data = text.encode('ascii')
+        if len(data) > budget[0]:
+            return {'complete': False, 'bytes_hashed': count, 'prefixes': prefixes}
+        budget[0] -= len(data)
+        offset = 0
+        for boundary in _ANCHORS if anchors else ():
+            if count < boundary <= count + len(data):
+                end = boundary - count
+                digest.update(data[offset:end])
+                prefixes[str(boundary)] = digest.hexdigest()
+                offset = end
+        digest.update(data[offset:])
+        count += len(data)
+    result = {'complete': True, 'bytes_hashed': count, 'hash': digest.hexdigest()}
+    if anchors:
+        result['prefixes'] = prefixes
+    return result
+
+
+def fingerprint(request: dict, *, key: bytes, session_id: str, request_id: str, base_url: str) -> dict:
+    """Bounded canonical-JSON hashes. Dictionary ordering is normalized; list order is retained."""
+    budget = [_MAX_BYTES]
+    extra = request.get('extra_body')
+    # SDK extra_body overrides these values; do not hash headers, credentials or unrelated fields.
+    effective = dict(request)
+    if isinstance(extra, dict):
+        effective.update(extra)
+    fields = {
+        'route': [base_url, effective.get('model')],
+        'session': session_id, 'request': request_id,
+        'instructions': effective.get('instructions', effective.get('system', [
+            m for m in effective.get('messages', []) if isinstance(m, dict) and m.get('role') in {'system', 'developer'}])),
+        'tools': effective.get('tools'),
+        'options': {name: effective.get(name) for name in (
+            'reasoning', 'text', 'tool_choice', 'parallel_tool_calls',
+            'prompt_cache_key', 'prompt_cache_options', 'prompt_cache_retention',
+            'previous_response_id', 'conversation', 'context_management',
+            'thinking', 'output_config', 'speed', 'service_tier', 'cache_control')},
+    }
+    result = {name: _digest(key, value, budget, anchors=name in {'instructions', 'tools'}) for name, value in fields.items()}
+    history = effective.get('input', effective.get('messages'))
+    result['history'] = _digest(key, history, budget, anchors=True)
+    result['input_items'] = len(history) if isinstance(history, list) else None
+    from agent.shared_prompt_cache import common_prefix
+    instruction = fields['instructions']
+    if isinstance(instruction, list) and instruction and isinstance(instruction[0], dict):
+        instruction = instruction[0].get('text', instruction[0].get('content'))
+    result['shared_prefix_used'] = common_prefix(instruction) is not None
+    result['shared_key_used'] = str(effective.get('prompt_cache_key') or '').startswith(('hsp1_', 'hsp2_', 'hsp3_', 'hsp4_'))
+    result['key_id'] = hmac.new(key, b'hermes-cache-diagnostics-v1', hashlib.sha256).hexdigest()[:16]
+    result['complete'] = all(result[name]['complete'] for name in (*fields, 'history'))
+    return result
+
+
+def _field(value, name):
+    return value.get(name) if isinstance(value, dict) else getattr(value, name, None)
+
+
+def _count(value):
+    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 0 else None
+
+
+def _usage(response) -> dict:
+    usage = _field(response, 'usage')
+    read = _count(_field(usage, 'cache_read_input_tokens'))
+    written = _count(_field(usage, 'cache_creation_input_tokens'))
+    if read is not None or written is not None:
+        # Anthropic input_tokens excludes both cache reads and writes.
+        uncached = _count(_field(usage, 'input_tokens'))
+        total = sum((uncached, read, written)) if all(v is not None for v in (uncached, read, written)) else None
+        return {'input_tokens': total, 'cached_tokens': read, 'cache_write_tokens': written}
+    total = _count(_field(usage, 'input_tokens'))
+    details = _field(usage, 'input_tokens_details')
+    if total is None:
+        total = _count(_field(usage, 'prompt_tokens'))
+        details = _field(usage, 'prompt_tokens_details')
+    return {'input_tokens': total, 'cached_tokens': _count(_field(details, 'cached_tokens')),
+            'cache_write_tokens': _count(_field(details, 'cache_write_tokens'))}
+
+
+def _emit(snapshot, response, *, status: str, started: float, preparation_ms: float) -> None:
+    # Never format exception text, response content, request bodies, credentials or raw identifiers.
+    with suppress(Exception):
+        row = {'version': 1, 'stage': 'prepared_after_transport_preflight',
+               'implementation': 'cache-sharing-v1', 'status': status, 'process_id': os.getpid(), 'fingerprint': snapshot,
+               'usage': _usage(response), 'elapsed_ms': round((time.perf_counter()-started)*1000, 3),
+               'preparation_ms': round(preparation_ms, 3)}
+        logger.info('CACHE_DIAGNOSTIC %s', json.dumps(row, separators=(',', ':')))
+
+
+def observe_call(agent, request: dict, next_call, *, request_id: str):
+    """Return/raise the downstream result unchanged, exactly once, even if diagnostics fail."""
+    if (getattr(agent, 'api_mode', '') not in {'codex_responses', 'anthropic_messages', 'chat_completions'}
+            or not logger.isEnabledFor(logging.INFO)):
+        return next_call(request)
+    before = time.perf_counter()
+    snapshot = {'complete': False, 'unavailable': True}
+    with suppress(Exception):
+        key = _profile_key()
+        snapshot = fingerprint(request, key=key, session_id=getattr(agent, 'session_id', '') or '',
+                               request_id=request_id, base_url=getattr(agent, 'base_url', '') or '')
+        snapshot['api_mode'] = agent.api_mode
+    with suppress(Exception):
+        from agent.usage_run_binding import snapshot as run_snapshot
+        snapshot['task_run'] = run_snapshot(key)
+    snapshot['cross_bot'] = {'version': 1, 'unavailable': True}
+    with suppress(Exception):
+        from agent.cache_cross_bot_diagnostics import fingerprint as cross_bot_fingerprint
+        snapshot['cross_bot'] = cross_bot_fingerprint(agent, request, request_id=request_id)
+    with suppress(Exception):
+        from agent.cache_change_evidence import policy_evidence, transition
+        snapshot['policy'] = policy_evidence(request)
+        snapshot['transition'] = transition(agent, snapshot)
+    preparation_ms = (time.perf_counter() - before) * 1000
+    started = time.perf_counter()
+    try:
+        response = next_call(request)
+    except BaseException:
+        _emit(snapshot, None, status='failed_or_interrupted', started=started, preparation_ms=preparation_ms)
+        raise
+    _emit(snapshot, response, status='returned', started=started, preparation_ms=preparation_ms)
+    return response
