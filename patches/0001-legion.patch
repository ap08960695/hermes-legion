@@ -0,0 +1,131 @@
+"""Opening telemetry must not seed auth or resolve a runtime credential.
+
+Persisted pools are inspected as snapshots; each account has exactly one readonly
+refresh route. These tests use real auth stores with a newly available env key.
+"""
+
+import json
+import time
+import hashlib
+from datetime import UTC, datetime
+from pathlib import Path
+from unittest.mock import Mock
+
+import pytest
+import httpx
+
+from agent import account_usage, account_usage_cache
+from hermes_cli.inventory import _apply_limits, _apply_usage
+
+
+@pytest.fixture
+def pooled_home(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("OPENROUTER_API_KEY", "new-env-key")
+    (tmp_path / "config.yaml").write_text("auth:\n  adopt_external_logins: false\n")
+    reset = time.time() + 3600
+    rows = [
+        {"id": name, "label": name, "auth_type": "api_key", "source": "manual",
+         "access_token": token, "priority": index, "last_status": "exhausted",
+         "last_status_at": time.time(), "last_error_code": 429,
+         "last_error_reset_at": reset}
+        for index, (name, token) in enumerate((("a", "first-key"), ("b", "second-key")))
+    ]
+    auth = tmp_path / "auth.json"
+    auth.write_text(json.dumps({"version": 1, "credential_pool": {"openrouter": rows}}))
+    legacy, entries = Mock(), Mock()
+    monkeypatch.setattr(account_usage_cache, "refresh_account_usage_async", legacy)
+    monkeypatch.setattr(account_usage_cache, "refresh_account_usage_entries_async", entries)
+    return auth, legacy, entries
+
+
+@pytest.mark.parametrize("reader", [_apply_limits, _apply_usage], ids=["limits", "usage"])
+def test_picker_telemetry_does_not_seed_or_rewrite_persisted_auth(pooled_home, reader):
+    auth, _, _ = pooled_home
+    before, mtime = auth.read_bytes(), auth.stat().st_mtime_ns
+    row = {"slug": "openrouter", "models": ["m"], "authenticated": True}
+    reader([row])
+    assert auth.read_bytes() == before, "reading picker telemetry rewrote auth.json"
+    assert auth.stat().st_mtime_ns == mtime
+    if reader is _apply_limits:
+        assert row["limit"]["scope"] == "account"
+    else:
+        assert len(row["usage"]["accounts"]) == 2
+
+
+@pytest.mark.parametrize("pool_size", [1, 2])
+def test_pooled_usage_does_not_also_refresh_a_provider_wide_runtime_credential(pooled_home, pool_size):
+    auth, legacy, entries = pooled_home
+    data = json.loads(auth.read_text())
+    data["credential_pool"]["openrouter"] = data["credential_pool"]["openrouter"][:pool_size]
+    auth.write_text(json.dumps(data))
+    row = {"slug": "openrouter", "models": ["m"], "authenticated": True}
+    _apply_usage([row])
+    assert not [provider for call in legacy.call_args_list for provider in call.args[0]]
+    requests = entries.call_args.args[0]
+    expected = {"first-key", "second-key"} if pool_size == 2 else {"first-key"}
+    assert {request["api_key"] for request in requests} == expected
+
+
+def test_legacy_background_usage_also_uses_readonly_fetch(monkeypatch):
+    monkeypatch.setenv("OPENROUTER_API_KEY", "explicit-env-key")
+    fetch = Mock()
+    monkeypatch.setattr(account_usage, "fetch_account_usage", fetch)
+    account_usage_cache._refresh_legacy("openrouter", account_usage_cache._key("openrouter"))
+    fetch.assert_called_once_with("openrouter", api_key="explicit-env-key", read_only=True)
+
+
+@pytest.mark.parametrize("provider", ["openai-codex", "anthropic"])
+def test_legacy_refresh_does_not_invoke_a_native_oauth_runtime_resolver(monkeypatch, provider):
+    fetch = Mock()
+    monkeypatch.setattr(account_usage, "fetch_account_usage", fetch)
+    account_usage_cache._refresh_legacy(provider, account_usage_cache._key(provider))
+    fetch.assert_not_called()
+
+
+def test_single_pool_refresh_keeps_credential_and_updates_the_existing_chip(pooled_home, monkeypatch):
+    auth, _, queued = pooled_home
+    data = json.loads(auth.read_text())
+    data["credential_pool"]["openrouter"] = data["credential_pool"]["openrouter"][:1]
+    auth.write_text(json.dumps(data))
+    before = auth.read_bytes()
+    authorizations = []
+
+    def get(client, url, **kwargs):
+        authorizations.append(kwargs["headers"]["Authorization"])
+        payload = ({"total_credits": 100, "total_usage": 25} if url.endswith("/credits")
+                   else {"limit": 100, "usage": 25, "limit_remaining": 75})
+        return httpx.Response(200, json={"data": payload}, request=httpx.Request("GET", url))
+
+    monkeypatch.setattr(httpx.Client, "get", get)
+    row = {"slug": "openrouter", "models": ["m"], "authenticated": True}
+    _apply_usage([row])
+    account_usage_cache._refresh_entries(queued.call_args.args[0])
+    _apply_usage([row])
+    assert authorizations and set(authorizations) == {"Bearer first-key"}
+    assert row["usage"]["windows"][0]["used_percent"] == 25.0
+    assert "accounts" not in row["usage"]
+    assert auth.read_bytes() == before
+
+
+def test_same_token_at_distinct_routes_keeps_separate_usage_and_ui_ids(pooled_home):
+    from agent.account_usage import AccountUsageSnapshot, AccountUsageWindow
+
+    auth, _, _ = pooled_home
+    data = json.loads(auth.read_text())
+    identity = 'fp:' + hashlib.sha256(b'first-key').hexdigest()[:16]
+    routes = ('https://first.example/v1', 'https://second.example/v1')
+    for entry, route, used in zip(data['credential_pool']['openrouter'], routes, (20, 80)):
+        entry.update(access_token='first-key', base_url=route, last_status='ok')
+        snapshot = AccountUsageSnapshot(
+            provider='openrouter', source='fixture', fetched_at=datetime.now(UTC),
+            windows=(AccountUsageWindow(label='quota', used_percent=used),),
+        )
+        account_usage_cache.remember_account_usage('openrouter', snapshot, identity_id=identity, base_url=route)
+    auth.write_text(json.dumps(data))
+    row = {'slug': 'openrouter', 'models': ['m'], 'authenticated': True}
+    _apply_usage([row])
+    accounts = row['usage']['accounts']
+    assert [a['windows'][0]['used_percent'] for a in accounts] == [20, 80]
+    assert len({a['id'] for a in accounts}) == 2
