@@ -0,0 +1,93 @@
+"""Read-only work overview for predictive prompts."""
+
+from contextlib import closing
+import json
+from pathlib import Path
+import sqlite3
+
+from hermes_constants import get_default_hermes_root, get_hermes_home
+
+
+def _session_goal(home, session_key):
+    path = home / "state.db"
+    if not path.exists() or not session_key:
+        return ""
+    with closing(
+        sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=0.2)
+    ) as conn:
+        row = conn.execute(
+            "SELECT value FROM state_meta WHERE key=?", ("goal:" + session_key,)
+        ).fetchone()
+        if not row:
+            return ""
+        data = json.loads(row[0])
+        return f"Goal [{data.get('status', 'unknown')}]: {str(data.get('goal', ''))[:600]}\nCriteria: {str(data.get('subgoals', []))[:400]}\nHold: {str(data.get('paused_reason') or data.get('waiting_reason') or '')[:250]}"
+
+
+def _board_overview(path, session_key, cwd):
+    with closing(
+        sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=0.2)
+    ) as conn:
+        conn.row_factory = sqlite3.Row
+        rows = conn.execute(
+            """SELECT id,title,status,body,result,block_kind FROM tasks
+            WHERE (session_id=? OR workspace_path=?) AND status!='archived'
+            ORDER BY (status='done'),created_at DESC LIMIT 18""",
+            (session_key, cwd),
+        ).fetchall()
+        lines = []
+        done_count = 0
+        for row in rows:
+            if row["status"] == "done":
+                done_count += 1
+                if done_count > 4:
+                    continue
+            parents = [
+                r[0]
+                for r in conn.execute(
+                    "SELECT parent_id FROM task_links WHERE child_id=?", (row["id"],)
+                )
+            ]
+            detail = (
+                row["body"]
+                if row["status"] in {"blocked", "triage", "scheduled"}
+                else row["result"]
+                if row["status"] == "done"
+                else ""
+            )
+            lines.append(
+                f"{row['id']} [{row['status']}/{row['block_kind'] or ''}] {row['title'][:150]}; depends={','.join(parents)}; {str(detail or '')[:200]}"
+            )
+        return "\n".join(lines)
+
+
+def work_overview(session_key: str, cwd: str) -> str:
+    home = get_hermes_home()
+    root = get_default_hermes_root(home=home)
+    parts = []
+    try:
+        if goal := _session_goal(home, session_key):
+            parts.append(goal)
+    except (OSError, sqlite3.Error, ValueError, TypeError):
+        pass  # An unavailable board/goal is omitted, never presented as finished.
+    project = Path(cwd).expanduser() if cwd else None
+    # Generic home/root composers must not mix unrelated projects into an offer.
+    if (
+        project
+        and project.is_absolute()
+        and project not in {Path("/"), Path.home(), home, root}
+    ):
+        paths = [root / "kanban.db"]
+        paths.extend(
+            p.parent / "kanban.db"
+            for p in (root / "kanban" / "boards").glob("*/board.json")
+        )
+        for path in paths[:12]:
+            if not path.exists():
+                continue
+            try:
+                if text := _board_overview(path, session_key, str(project)):
+                    parts.append(text)
+            except (OSError, sqlite3.Error):
+                continue
+    return "\n".join(parts)[:2200]
