+    try:
+        assert delivery.owner_home() != own
+        assert delivery.pending(kb.kanban_db_path(), home=delivery.owner_home(), session_key=KEY) == []
+        texts, claim = delivery.claim([text], home=delivery.owner_home(), session_key=KEY)
