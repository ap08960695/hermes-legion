+import { describe, expect, it } from 'vitest'
+import { cacheEvidence } from './cache-stats'
+describe('provider cache evidence', () => {
+  it('keeps an absent or impossible measurement unknown', () => {
+    for (const value of [null, undefined, NaN, Infinity, -1])
+      expect(cacheEvidence({ total_cache_read: value as number, total_input: 100 }).reads).toBeNull()
+    expect(cacheEvidence({ total_cache_read: 200, total_input: 100 })).toEqual({ reads: 200, percent: null })
+  })
+  it('distinguishes known zero, no input, and a measured fraction', () => {
+    expect(cacheEvidence({ total_cache_read: 0, total_input: 100 })).toEqual({ reads: 0, percent: 0 })
+    expect(cacheEvidence({ total_cache_read: 0, total_input: 0 }).percent).toBeNull()
+    expect(cacheEvidence({ total_cache_read: 75, total_input: 100 })).toEqual({ reads: 75, percent: 75 })
+  })
+})
