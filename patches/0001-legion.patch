+"""Native update-pause admission, with an opt-in idle-only request path."""
+
+import os
+import threading
+import time
+
+
+def _idle_update_blocker(runner):
+    try:
+        if (runner._active_work_count() > 0 or runner._running_cron_job_count() > 0
+                or runner._api_server_hook('active_agent_work_count') > 0):
+            return 'active_work'
+        if runner._scale_to_zero_has_live_background_work():
+            return 'background_work'
+    except Exception:
+        return 'observation_unavailable'
+    return None
+
+
+def make_pause_handler(runner, loop, *, only_if_idle=False):
+    """Check idle state and request restart on the same Gateway event-loop turn."""
+    def handler(params=None):
+        try:
+            from hermes_cli.gateway import _get_restart_drain_timeout
+            drain = float(_get_restart_drain_timeout())
+        except Exception:
+            drain = 30.0
+        result = {'pausing': False, 'already_stopping': False,
+                  'pid': os.getpid(), 'drain_timeout': drain}
+        done, cancelled = threading.Event(), threading.Event()
+        deadline = (params or {}).get('deadline_ns') if only_if_idle else None
+        if only_if_idle:
+            result['idle_only'] = True
+            if type(deadline) is not int or deadline <= time.monotonic_ns():
+                return {**result, 'reason': 'expired'}
+        wait = min(5.0, max(0.0, (deadline - time.monotonic_ns()) / 1e9)) if only_if_idle else 5.0
+
+        def expired():
+            return only_if_idle and (cancelled.is_set() or time.monotonic_ns() >= deadline)
+
+        def request():
+            try:
+                if expired():
+                    result['reason'] = 'expired'
+                    return
+                if only_if_idle:
+                    blocker = _idle_update_blocker(runner)
+                    if blocker:
+                        result.update(busy=True, reason=blocker)
+                        return
+                    if expired():
+                        result['reason'] = 'expired'
+                        return
+                accepted = runner.request_restart(detached=False, via_service=True)
+                result.update(pausing=bool(accepted), already_stopping=not accepted)
+            finally:
+                done.set()
+
+        loop.call_soon_threadsafe(request)
+        if not done.wait(timeout=wait) and only_if_idle:
+            # Do not leave a queued callback armed after its caller's deadline.
+            cancelled.set()
+            return {**result, 'reason': 'expired'}
+        return dict(result)
+
+    return handler
