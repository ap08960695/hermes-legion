@@ -0,0 +1,73 @@
+"""Real local datagrams plus native commit/rollback semantics; never spawn a worker."""
+import asyncio
+import tempfile
+import shutil
+from pathlib import Path
+
+import pytest
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli import kanban_dispatch_wake as wake
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home=Path(tempfile.mkdtemp(prefix='hwk-'))
+    monkeypatch.setattr(Path,'home',lambda:tmp_path)
+    monkeypatch.setenv('HERMES_HOME',str(home));monkeypatch.setenv('HERMES_KANBAN_HOME',str(home))
+    monkeypatch.delenv('HERMES_KANBAN_DB',raising=False)
+    conn=kbc.connect()
+    yield conn,home
+    conn.close()
+    shutil.rmtree(home)
+
+
+def test_hints_only_after_outer_commit_and_not_after_rollback(board,monkeypatch):
+    conn,_=board;seen=[]
+    monkeypatch.setattr(wake,'notify_dispatcher',lambda:seen.append(conn.in_transaction))
+    with kb.write_txn(conn):
+        kb.create_task(conn,title='ready',assignee='test')
+        assert seen==[]
+    assert seen==[False]
+    seen.clear()
+    with pytest.raises(RuntimeError):
+        with kb.write_txn(conn):
+            kb.create_task(conn,title='rolled back')
+            raise RuntimeError('rollback')
+    assert seen==[]
+
+
+def test_nested_rollback_and_comments_do_not_wake(board,monkeypatch):
+    conn,_=board;seen=[]
+    monkeypatch.setattr(wake,'notify_dispatcher',lambda:seen.append(1))
+    with kb.write_txn(conn):
+        try:
+            with kb.write_txn(conn,allow_nested=True):
+                kb.create_task(conn,title='rollback inner')
+                raise ValueError('undo')
+        except ValueError:pass
+    assert seen==[]
+    tid=kb.create_task(conn,title='real');seen.clear()
+    kb.add_comment(conn,tid,author='tester',body='ordinary progress')
+    assert seen==[]
+
+
+@pytest.mark.platforms('linux','macos')
+@pytest.mark.asyncio
+async def test_native_commit_wakes_receiver_and_bursts_coalesce(board):
+    conn,home=board
+    with wake.DispatchWakeReceiver(home) as receiver:
+        assert receiver.sock is not None
+        for _ in range(6):kb.create_task(conn,title='offline ready')
+        await asyncio.wait_for(receiver.event.wait(),5)
+        receiver.last_tick-=2
+        assert await asyncio.wait_for(receiver.wait(10,lambda:True),5)=='event'
+        assert not receiver.event.is_set()
+    assert not wake.wake_path(home).exists()
+
+
+@pytest.mark.asyncio
+async def test_no_listener_still_has_periodic_fallback(board):
+    wake.notify_dispatcher()  # no exception, no retry
+    with wake.DispatchWakeReceiver(board[1],enabled=False) as receiver:
+        assert await receiver.wait(0,lambda:True)=='periodic'
+        assert await receiver.wait(10,lambda:False)=='stopped'
