diff --git a/apps/desktop/src/lib/answer-cards.ts b/apps/desktop/src/lib/answer-cards.ts
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/lib/answer-cards.ts
@@ -0,0 +1,59 @@
+/** Explicit, bounded presentation data. No inferred facts, network calls or HTML. */
+export interface AnswerCard {
+  title: string
+  price?: string
+  description?: string
+  images: string[]
+  sources: { title: string; url: string }[]
+  facts: string[]
+}
+const text = (value: unknown, max = 600) =>
+  typeof value === 'string' ? value.trim().slice(0, max) || undefined : undefined
+function url(value: unknown, image = false): string | undefined {
+  const raw = text(value, 4096)
+  if (!raw) return
+  if (image && /^data:image\/(?:png|jpeg|webp|gif);base64,[a-z0-9+/=]+$/i.test(raw)) return raw
+  try {
+    const parsed = new URL(raw)
+    if (['https:', 'http:'].includes(parsed.protocol) && !parsed.username && !parsed.password) return parsed.href
+  } catch {
+    /* Invalid model-authored URLs stay inert. */
+  }
+}
+function card(raw: unknown): AnswerCard[] {
+  if (!raw || typeof raw !== 'object') return []
+  const value = raw as Record<string, unknown>,
+    title = text(value.title)
+  if (!title) return []
+  return [
+    {
+      title,
+      price: text(value.price),
+      description: text(value.description),
+      images: (Array.isArray(value.images) ? value.images : [])
+        .slice(0, 6)
+        .map(x => url(x, true))
+        .filter((x): x is string => Boolean(x)),
+      facts: (Array.isArray(value.facts) ? value.facts : [])
+        .slice(0, 12)
+        .map(x => text(x, 120))
+        .filter((x): x is string => Boolean(x)),
+      sources: (Array.isArray(value.sources) ? value.sources : []).slice(0, 8).flatMap(source => {
+        if (!source || typeof source !== 'object') return []
+        const link = source as Record<string, unknown>,
+          target = url(link.url)
+        return target ? [{ url: target, title: text(link.title, 120) || new URL(target).hostname }] : []
+      })
+    }
+  ]
+}
+export function parseAnswerCards(code: string): AnswerCard[] {
+  if (code.length > 256000) return []
+  try {
+    const value = JSON.parse(code)
+    const rows = Array.isArray(value) ? value : Array.isArray(value?.cards) ? value.cards : []
+    return rows.slice(0, 16).flatMap(card)
+  } catch {
+    return []
+  }
+}
