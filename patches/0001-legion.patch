+"""Native SQLite publication and cold restore must agree after abrupt process exit."""
+import copy
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+from agent.context_compressor import SUMMARY_PREFIX
+from agent.conversation_compression import CompressionCommitFence
+from agent.conversation_loop import _restore_or_build_system_prompt
+from hermes_state import SessionDB
+from tests.agent.test_compression_rotation_state import _build_agent_with_db, _seed_bulk_head
+from tools.mcp_tool_agent import persist_agent_tool_names
+
+PARENT = "atomic-prefix-parent"
+
+
+def _no_http(*args, **kwargs):
+    raise AssertionError("HTTP send forbidden in isolated prefix publication test")
+
+
+def _trap_http(monkeypatch=None):
+    import httpx
+    import requests
+    set_attribute = monkeypatch.setattr if monkeypatch else setattr
+    set_attribute(httpx.Client, "send", _no_http)
+    set_attribute(httpx.AsyncClient, "send", _no_http)
+    set_attribute(requests.sessions.Session, "request", _no_http)
+
+
+def _worker(home, in_place, seeded, stage):
+    _trap_http()
+    home = Path(home)
+    db = SessionDB(home / "state.db")
+    db.create_session(PARENT, source="cli")
+    _seed_bulk_head(db, PARENT)
+    agent = _build_agent_with_db(db, PARENT, platform="cli")
+    agent._compression_feasibility_checked = True
+    agent.compression_in_place = in_place
+    agent._cached_system_prompt = agent._build_system_prompt("trusted original prefix")
+    db.update_system_prompt(PARENT, agent._cached_system_prompt)
+    persist_agent_tool_names(agent)
+    original = copy.deepcopy(agent.tools)
+    changed = copy.deepcopy(original)
+    changed[0]["function"]["description"] = "Updated contract from the compaction catalog"
+    import model_tools
+    model_tools.get_tool_definitions = lambda **kw: copy.deepcopy(changed)
+    agent._retain_seeded_system_prompt = seeded
+    agent.context_compressor.compress.return_value = [
+        {"role": "user", "content": SUMMARY_PREFIX + "Earlier turns retained."},
+        {"role": "assistant", "content": "persisted answer"},
+    ]
+    messages = db.get_messages_as_conversation(PARENT)
+    (home / "expected.json").write_text(json.dumps({"original_tools": original, "fresh_tools": changed,
+        "original_prompt": agent._cached_system_prompt, "original_messages": messages}))
+    method = "_insert_message_rows" if stage == "before_commit" else (
+        "archive_and_compact" if in_place else "publish_compression_child")
+    native = getattr(db, method)
+    def crash_after_native(*args, **kwargs):
+        native(*args, **kwargs)
+        os._exit(73)
+    setattr(db, method, crash_after_native)
+    agent._compress_context(messages, "trusted updated prefix", approx_tokens=120_000,
+        force=True, commit_fence=CompressionCommitFence())
+    raise AssertionError("crash seam was not reached")
+
+
+@pytest.mark.parametrize("in_place", [True, False], ids=["in-place", "rotation"])
+@pytest.mark.parametrize("seeded", [False, True], ids=["refresh", "seeded-gateway"])
+@pytest.mark.parametrize("stage", ["before_commit", "after_commit"])
+def test_crash_restores_one_coherent_native_prefix(tmp_path, monkeypatch, in_place, seeded, stage):
+    _trap_http(monkeypatch)
+    home = tmp_path / "home" / ".hermes"
+    home.mkdir(parents=True)
+    env = {**os.environ, "HOME": str(tmp_path / "fake-user"), "HERMES_HOME": str(home),
+        "HERMES_RUNTIME_DIR": str(home / "runtime"), "HERMES_KANBAN_HOME": str(home),
+        "XDG_CONFIG_HOME": str(home.parent / ".config"), "XDG_CACHE_HOME": str(home.parent / ".cache"),
+        "HERMES_TEST_ISOLATION": "1", "HERMES_DISABLE_LAZY_INSTALLS": "1"}
+    script = "from tests.agent.test_compression_prefix_atomicity import _worker; import sys; _worker(sys.argv[1], sys.argv[2]=='1', sys.argv[3]=='1', sys.argv[4])"
+    child = subprocess.run([sys.executable, "-c", script, str(home), str(int(in_place)), str(int(seeded)), stage],
+        cwd=Path(__file__).resolve().parents[2], env=env, stdin=subprocess.DEVNULL,
+        capture_output=True, text=True, timeout=45, check=False)
+    assert child.returncode == 73, child.stderr
+    expected = json.loads((home / "expected.json").read_text())
+    committed = stage == "after_commit"
+    refreshed = committed and not seeded
+    tools = expected["fresh_tools"] if refreshed else expected["original_tools"]
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path / "fake-user")
+    monkeypatch.setattr("model_tools.get_tool_definitions", lambda **kw: copy.deepcopy(expected["fresh_tools"]))
+    with SessionDB(home / "state.db") as db:
+        tip = db.get_compression_tip(PARENT)
+        row = db.get_session(tip)
+        history = db.get_messages_as_conversation(tip)
+        assert (len(history) < len(expected["original_messages"])) is committed
+        assert (tip != PARENT) is (committed and not in_place)
+        if not committed:
+            assert history == expected["original_messages"]
+        agent = _build_agent_with_db(db, tip, platform="cli")
+        try:
+            _restore_or_build_system_prompt(agent, "trusted updated prefix", history)
+            expected_prompt = row["system_prompt"] if refreshed else expected["original_prompt"]
+            observed = {
+                "stored_prompt": ("trusted updated prefix" in row["system_prompt"]) if refreshed else row["system_prompt"] == expected_prompt,
+                "stored_tools": json.loads(row["tool_names"])["tools"] == tools,
+                "native_restored_prompt": agent._cached_system_prompt == expected_prompt,
+                "native_restored_tools": agent.tools == tools,
+            }
+            assert observed == dict.fromkeys(observed, True)
+        finally:
+            agent.close()
