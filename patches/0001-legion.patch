+"""Idle-only update requests preserve live scripts and refuse unknown observations."""
+
+import asyncio
+import shlex
+import socket
+import sys
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.control_socket import GatewayControlServer, pause_gateway_for_update
+from gateway.run import _start_gateway_start_control_socket
+from gateway.run_shutdown import GatewayShutdownMixin
+
+
+@pytest.fixture(autouse=True)
+def control_home(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+
+
+class IdleRunner(GatewayShutdownMixin):
+    def __init__(self):
+        self._background_tasks = set()
+        self.config = SimpleNamespace(multiplex_profiles=False)
+        self.restarts = []
+
+    def _active_work_count(self):
+        return 0
+
+    def _running_cron_job_count(self):
+        return 0
+
+    def _api_server_hook(self, name):
+        return 0
+
+    def request_restart(self, **kwargs):
+        self.restarts.append(kwargs)
+        return True
+
+
+@pytest.mark.parametrize('probe', ['delegations', 'processes'])
+def test_unknown_background_observation_keeps_gateway_awake(monkeypatch, probe):
+    from tools import async_delegation, process_registry
+
+    def unavailable():
+        raise OSError('fixture observation refusal')
+
+    target = async_delegation if probe == 'delegations' else process_registry.process_registry
+    monkeypatch.setattr(target, 'active_count' if probe == 'delegations' else 'has_any_active', unavailable)
+    assert IdleRunner()._scale_to_zero_has_live_background_work() is True
+
+
+def _request(tmp_path, runner, *, only_if_idle):
+    async def scenario():
+        server = await _start_gateway_start_control_socket(runner)
+        assert server is not None
+        try:
+            return await asyncio.to_thread(
+                pause_gateway_for_update, tmp_path, timeout=5,
+                **({'only_if_idle': True} if only_if_idle else {}),
+            )
+        finally:
+            await server.stop()
+
+    return asyncio.run(scenario())
+
+
+@pytest.mark.platforms('posix')
+def test_idle_request_refuses_live_native_process_then_script_resumes(tmp_path, monkeypatch):
+    from tools import process_registry as processes
+
+    monkeypatch.setattr(processes, '_systemd_run_user_scope_available', lambda: False)
+    registry = processes.ProcessRegistry()
+    monkeypatch.setattr(processes, 'process_registry', registry)
+    runner = IdleRunner()
+    with socket.socket() as listener:
+        listener.bind(('127.0.0.1', 0))
+        listener.listen()
+        listener.settimeout(10)
+        code = ('import socket; s=socket.create_connection(("127.0.0.1", '
+                f'{listener.getsockname()[1]})); s.sendall(b"ready"); '
+                'assert s.recv(1)==b"x"; s.sendall(b"done"); print("finished", flush=True)')
+        session = registry.spawn_local(shlex.join([sys.executable, '-c', code]), cwd=str(tmp_path))
+        try:
+            with listener.accept()[0] as connection:
+                connection.settimeout(10)
+                assert connection.recv(5) == b'ready'
+                assert registry.has_any_active()
+                result = _request(tmp_path, runner, only_if_idle=True)
+                assert result['pausing'] is False and result['idle_only'] is True
+                assert result['reason'] == 'background_work'
+                assert runner.restarts == []
+                assert session.process.poll() is None
+                connection.sendall(b'x')
+                assert connection.recv(4) == b'done'
+            result = registry.wait(session.id, timeout=10)
+            assert result['exit_code'] == 0 and 'finished' in result['output']
+        finally:
+            registry.kill_all(source='test-cleanup')
+
+
+@pytest.mark.parametrize('busy', [False, True])
+@pytest.mark.platforms('posix')
+def test_idle_request_distinguishes_clean_and_active_agent_work(tmp_path, monkeypatch, busy):
+    runner = IdleRunner()
+    monkeypatch.setattr(runner, '_active_work_count', lambda: int(busy))
+    result = _request(tmp_path, runner, only_if_idle=True)
+    assert result['idle_only'] is True and result['pausing'] is (not busy)
+    assert len(runner.restarts) == (0 if busy else 1)
+
+
+@pytest.mark.platforms('posix')
+def test_explicit_legacy_pause_keeps_its_drain_contract(tmp_path, monkeypatch):
+    runner = IdleRunner()
+    monkeypatch.setattr(runner, '_active_work_count', lambda: 1)
+    result = _request(tmp_path, runner, only_if_idle=False)
+    assert result['pausing'] is True
+    assert runner.restarts == [{'detached': False, 'via_service': True}]
+
+
+@pytest.mark.parametrize('probe', ['_running_cron_job_count', '_api_server_hook'])
+@pytest.mark.platforms('posix')
+def test_idle_request_refuses_unreadable_work_source(tmp_path, monkeypatch, probe):
+    runner = IdleRunner()
+
+    def unavailable(*args):
+        raise OSError('fixture unavailable work source')
+
+    monkeypatch.setattr(runner, probe, unavailable)
+    result = _request(tmp_path, runner, only_if_idle=True)
+    assert result['pausing'] is False and result['reason'] == 'observation_unavailable'
+    assert runner.restarts == []
+
+
+@pytest.mark.platforms('posix')
+def test_strict_client_does_not_fall_back_to_old_server(tmp_path):
+    calls = []
+
+    async def scenario():
+        def legacy():
+            calls.append('legacy shutdown requested')
+            return {'pausing': True}
+
+        server = GatewayControlServer(tmp_path, verb_handlers={'pause-for-update': legacy})
+        assert await server.start()
+        try:
+            return await asyncio.to_thread(pause_gateway_for_update, tmp_path, only_if_idle=True)
+        finally:
+            await server.stop()
+
+    assert asyncio.run(scenario()) is None
+    assert calls == []
+
+
+def test_expired_queued_request_cannot_restart_later(monkeypatch):
+    from gateway.run_update_control import make_pause_handler
+
+    callbacks = []
+    loop = SimpleNamespace(call_soon_threadsafe=callbacks.append)
+    runner = IdleRunner()
+    monkeypatch.setattr('threading.Event.wait', lambda self, timeout=None: False)
+    handler = make_pause_handler(runner, loop, only_if_idle=True)
+    result = handler({'deadline_ns': time.monotonic_ns() + 1_000_000_000})
+    assert result['pausing'] is False and result['reason'] == 'expired'
+    for callback in callbacks:
+        callback()
+    assert runner.restarts == []
