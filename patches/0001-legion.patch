--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/management.ts
@@ -0,0 +1,15 @@
+import { atom } from 'nanostores'
+/** UI intent only. Creating a bot or group still requires the native dialog confirmation. */
+export const $botManagementOpen = atom(false)
+let returnToCards = false
+export const $botDialogIntent = atom<'bot' | 'group' | null>(null)
+export function requestBotManagement(kind: 'bot' | 'group') {
+  returnToCards = !$botManagementOpen.get()
+  $botManagementOpen.set(true)
+  $botDialogIntent.set(kind)
+}
+
+export function finishBotManagementDialog(keepManagement = false) {
+  if (returnToCards && !keepManagement) $botManagementOpen.set(false)
+  returnToCards = false
+}
