@@ -0,0 +1,133 @@
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { cleanup, render, screen, fireEvent } from '@testing-library/react'
+import { beforeEach, afterEach, expect, it, vi } from 'vitest'
+// eslint-disable-next-line no-restricted-imports
+import { registerPluginLocales } from '@/i18n/plugin-i18n'
+import { KANBAN_LOCALES } from './i18n'
+import { WorkflowView } from './workflow-view'
+import type * as Api from './api'
+const io = vi.hoisted(() => ({ read: vi.fn(), write: vi.fn() }))
+vi.mock('./api', async original => ({
+  ...(await original<typeof Api>()),
+  routedToScope: () => true,
+  fetchTask: io.read,
+  patchTask: io.write,
+  createTask: io.write
+}))
+let dispose = () => {}
+let client: QueryClient
+beforeEach(() => {
+  dispose = registerPluginLocales('kanban', KANBAN_LOCALES)
+  client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+  io.read.mockResolvedValue({
+    task: { id: 'first', title: 'Research the example', status: 'blocked', assignee: 'reviewer' },
+    runs: [{ id: 1, profile: 'researcher', status: 'done', started_at: 10 }],
+    events: [],
+    comments: [],
+    links: { parents: [], children: [] }
+  })
+})
+afterEach(() => {
+  cleanup()
+  client.clear()
+  dispose()
+  vi.clearAllMocks()
+})
+const board = {
+  columns: [
+    {
+      name: 'blocked',
+      tasks: [
+        { id: 'first', title: 'Research the example', status: 'blocked', assignee: 'reviewer' },
+        { id: 'next', title: 'Review the example', status: 'blocked' }
+      ]
+    }
+  ],
+  links: [{ parent_id: 'first', child_id: 'next' }],
+  assignees: [],
+  tenants: [],
+  now: 1,
+  latest_event_id: 1
+}
+it('selects a real node and shows bot history inside Workflow without opening a card or writing', async () => {
+  const open = vi.fn()
+  render(
+    <QueryClientProvider client={client}>
+      <WorkflowView board={board} onOpen={open} />
+    </QueryClientProvider>
+  )
+  expect(io.read).not.toHaveBeenCalled()
+  fireEvent.click(screen.getByRole('button', { name: /Research the example/ }))
+  expect(await screen.findByText('researcher')).toBeTruthy()
+  expect(screen.getByText('Currently assigned: reviewer')).toBeTruthy()
+  expect(open).not.toHaveBeenCalled()
+  expect(io.write).not.toHaveBeenCalled()
+  fireEvent.click(screen.getByRole('button', { name: 'Open card' }))
+  expect(open).toHaveBeenCalledWith('first')
+})
+it('reports missing dependency capability without fabricating a line', () => {
+  const old = { ...board, links: undefined }
+  render(
+    <QueryClientProvider client={client}>
+      <WorkflowView board={old} onOpen={() => {}} />
+    </QueryClientProvider>
+  )
+  expect(screen.getByText('Dependency links are unavailable from this backend')).toBeTruthy()
+  expect(screen.queryAllByTestId('workflow-edge')).toHaveLength(0)
+})
+
+it('fits a tall graph within both viewport dimensions and can focus a selected card', async () => {
+  const tall = {
+    ...board,
+    columns: [
+      {
+        name: 'blocked',
+        tasks: Array.from({ length: 17 }, (_, n) => ({ id: 'task-' + n, title: 'Card ' + n, status: 'blocked' }))
+      }
+    ],
+    links: []
+  }
+  const view = render(
+    <QueryClientProvider client={client}>
+      <WorkflowView board={tall} onOpen={vi.fn()} />
+    </QueryClientProvider>
+  )
+  const viewport = view.container.querySelector('.kanban-workflow-viewport') as HTMLElement
+  Object.defineProperties(viewport, { clientWidth: { value: 800 }, clientHeight: { value: 480 } })
+  viewport.scrollTo = vi.fn()
+  fireEvent.click(screen.getByRole('button', { name: 'Fit graph' }))
+  const canvas = view.container.querySelector('.kanban-workflow-canvas') as HTMLElement
+  const scale = Number(canvas.style.transform.match(/scale\(([^)]+)\)/)![1])
