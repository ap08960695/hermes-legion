diff --git a/agent/conversation_compression_prompt.py b/agent/conversation_compression_prompt.py
new file mode 100644
index 0000000000000000000000000000000000000000..7fd1220cef061764631715492753fea676f84f3f
--- /dev/null
+++ b/agent/conversation_compression_prompt.py
@@ -0,0 +1,178 @@
+"""Refresh request-prefix state only when a compaction actually publishes its transcript.
+
+Prompt construction may read current memories/plugins before SQLite publication.
+Keep those candidate bytes reversible and publish the durable tool pin with the
+transcript; accepted memory-provider writes are outside this scope.
+"""
+from __future__ import annotations
+
+import copy
+import contextlib
+import logging
+from typing import Any
+
+logger = logging.getLogger("agent.conversation_compression")
+
+
+def _refresh_agent_tool_definitions(agent, *, persist: bool = True) -> bool:
+    """Rebuild agent.tools at the compaction commit boundary (the only moment config reaches a forever-session's
+    frozen tool schemas; the prompt cache is already invalid). Returns True when tools were added."""
+    from tools.mcp_tool_agent import refresh_agent_mcp_tools
+    added = refresh_agent_mcp_tools(agent, content_aware=True, persist=persist)
+    if added:
+        logger.info("Compaction tool refresh added tools: %s", sorted(added))
+    return bool(added)
+
+
+def _rebuild_system_prompt_at_boundary(agent: Any, system_message: str, *, persist_tools: bool = True) -> str:
+    """Refresh tool schemas and rebuild the system prompt at the commit boundary."""
+    if getattr(agent, "_retain_seeded_system_prompt", False) is True:
+        # Gateway hygiene / gateway /compress run a detached agent with a reduced toolset and no live
+        # surface: its builder output drops the skills index, external provider blocks and tool guidance,
+        # and the commit below would persist that over the live session's snapshot (restored verbatim by
+        # the next fresh agent). Keep the seeded bytes; the live agent's own compaction propagates updates.
+        # Returning here also deliberately skips _refresh_agent_tool_definitions: its MCP refresh persists
+        # the agent's tool names, which would overwrite the session's saved tools[] with the memory-only set.
+        if agent._cached_system_prompt:
+            from agent.system_prompt import reconstruct_static_prefix
+            reconstruct_static_prefix(agent, system_message=system_message, log_label="compression seeded-prompt")
+        return agent._cached_system_prompt
+    cached_system_prompt = agent._cached_system_prompt
+    agent._invalidate_system_prompt()
+
+    # Refresh dynamic tool schemas at the same admitted-commit boundary that rebuilds the system prompt
+    # (maintainer-directed, #95681 arc): forever-sessions (Bot Mode chats, gateway channels) never
+    # restart, so compaction is the ONLY point where a config change — image model swap, delegation
+    # depth, code_execution mode — can reach agent.tools. The prompt cache is already broken here, so
+    # the refresh is free; when nothing changed the snapshot is byte-equal and we keep the existing list
+    # object (identity matters to provider-side tool-block caching on some backends).
+    try:
+        _refresh_agent_tool_definitions(agent, persist=persist_tools)
+    except Exception:
+        logger.warning(
+            "compaction tool-definition refresh failed; keeping the session's existing tool snapshot", exc_info=True
+        )
+
+    # ALWAYS rebuild the prompt here: keeping old bytes meant prompt-builder changes
+    # never reached long sessions. Equal bytes keep KV; preserve object identity.
+    # ALWAYS rebuild the prompt at the admitted-commit boundary (maintainer-directed, #95681 arc). The
+    # previous "keep-prompt" containment branch put the OLD bytes back whenever the reloaded memory blocks
+    # were already embedded — which meant prompt-builder changes (guidance diets, new blocks, renames) NEVER
+    # reached a long-lived session. The cache argument for keeping bytes was hollow: when nothing changed,
+    # the rebuild is byte-identical and local KV prefixes survive on equality; when something changed, the
+    # cache was stale by definition and propagation is the point. Preserve OBJECT identity on byte-equality
+    # for backends that key on it.
+    rebuilt_system_prompt = agent._build_system_prompt(system_message)
+    if cached_system_prompt is not None and rebuilt_system_prompt == cached_system_prompt:
+        new_system_prompt = agent._cached_system_prompt = cached_system_prompt
+        from agent.system_prompt import reconstruct_static_prefix
+        reconstruct_static_prefix(agent, system_message=system_message, log_label="compression keep-prompt")
+    else:
+        new_system_prompt = agent._cached_system_prompt = rebuilt_system_prompt
+        if cached_system_prompt is not None:
+            # The rebuild itself stays mandatory; only the first drift per session is INFO — a long session
+            # compacting many times logged this on every compact (19x/day in #112420).
+            log = logger.debug if getattr(agent, "_compaction_prompt_drift_logged", False) is True else logger.info
+            log(
+                "Compaction rebuilt a drifted system prompt (session=%s, %d -> %d chars): builder output changed "
+                "since the stored snapshot (update, config change, or memory/skills growth)",
+                agent.session_id or "none", len(cached_system_prompt), len(new_system_prompt),
+            )
+            agent._compaction_prompt_drift_logged = True
+    return new_system_prompt
+
+
+_MISSING = object()
+_PREFIX_FIELDS = (
+    "_cached_system_prompt", "_cached_system_prompt_static", "_static_rebuild_failed_for",
+    "_plugin_system_prompt_sections_snapshot", "_plugin_system_prompt_sections_previous",
+    "_compaction_prompt_drift_logged", "_frozen_workspace_snapshot",
+    "_auto_load_skills_result", "_auto_load_skills_resolved", "_bot_chat_timeless_prompt",
+)
+_TOOL_FIELDS = ("tools", "valid_tool_names", "_tool_snapshot_generation", "_context_engine_tool_names")
+
+
+@contextlib.contextmanager
+def compaction_tool_publication(agent: Any, prefix_snapshot: dict | None):
+    """Order the native commit and session handoff against explicit tool publishers.
+
+    The caller holds this only for SQLite publication and the child-ID swap,
+    never prompt construction, memory extraction, model calls or metadata hooks.
+    A reload acknowledged after staging owns the latest schema bytes.
+    """
+    from tools.mcp_tool_agent import _agent_tool_lock
+    with _agent_tool_lock(agent):
+        snapshot = dict(prefix_snapshot) if prefix_snapshot is not None else None
+        if snapshot is not None and "tool_pin" in snapshot:
+            snapshot["tool_pin"] = {**snapshot["tool_pin"], "tools": copy.deepcopy(agent.tools or [])}
+        yield snapshot
+
+
+class CompactionPromptRefresh:
+    """Rollback uncommitted prefix state without reverting provider writes or attempt telemetry."""
+
+    def __init__(self, agent: Any):
+        self.agent = agent
+        self.previous = {name: getattr(agent, name, _MISSING) for name in (*_PREFIX_FIELDS, *_TOOL_FIELDS)}
+        names = self.previous["_context_engine_tool_names"]
+        if isinstance(names, set):
+            self.previous["_context_engine_tool_names"] = names.copy()
+        self.store = getattr(agent, "_memory_store", None)
+        snapshot = getattr(self.store, "_system_prompt_snapshot", _MISSING) if self.store else _MISSING
+        self.memory_prefix = copy.deepcopy(snapshot) if snapshot is not _MISSING else _MISSING
+        self.accepted = False
+        self.pin_revision = getattr(agent, "_tool_pin_revision", 0)
+        self.prepared_tools = self.previous["tools"]
+        self.prompt = None
+        self.system_message = ""
+
+    def __enter__(self):
+        return self
+
+    def rebuild(self, system_message: str) -> str:
+        self.system_message = system_message
+        try:
+            self.prompt = _rebuild_system_prompt_at_boundary(self.agent, system_message, persist_tools=False)
+            return self.prompt
+        finally:
+            self.prepared_tools = getattr(self.agent, "tools", _MISSING)
+
+    def for_commit(self, system_prompt: str) -> dict:
+        """Freeze the candidate's prefix; seeded agents inherit the live session's tools."""
+        snapshot = {"system_prompt": system_prompt}
+        if getattr(self.agent, "_retain_seeded_system_prompt", False) is not True:
+            from tools.mcp_tool_agent import tool_pin_version
+            snapshot["tool_pin"] = {"version": tool_pin_version(), "tools": copy.deepcopy(self.prepared_tools or [])}
+        return snapshot
+
+    def accept_if_applied(self, commit: Any) -> None:
+        self.accepted = commit.applied()
+
+    def _restore(self, fields) -> None:
+        for name in fields:
+            value = self.previous[name]
+            if value is _MISSING:
+                self.agent.__dict__.pop(name, None)
+            else:
+                setattr(self.agent, name, value)
+
+    def __exit__(self, exc_type, exc, tb):
+        if self.accepted:
+            return False
+        self._restore(_PREFIX_FIELDS)
+        # Do not overwrite a later explicit MCP publication that replaced our candidate.
+        from tools.mcp_tool_agent import _agent_tool_lock
+        with _agent_tool_lock(self.agent):
+            if (getattr(self.agent, "tools", _MISSING) is self.prepared_tools
+                    and getattr(self.agent, "_tool_pin_revision", 0) == self.pin_revision):
+                self._restore(_TOOL_FIELDS)
+        if self.memory_prefix is not _MISSING:
+            self.store._system_prompt_snapshot = self.memory_prefix
+        cached = getattr(self.agent, "_cached_system_prompt", None)
+        if cached is not None:
+            self.prompt = cached
+        elif exc_type is None:
+            self.prompt = self.agent._build_system_prompt(self.system_message)
+        else:
+            self.prompt = self.system_message
+        return False
