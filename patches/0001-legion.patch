+"""Activity fields must describe the projected compression tip, not its ended parent."""
+import time
+import pytest
+from agent.session_activity import ActivityProvenance
+from hermes_state import SessionDB
+
+
+@pytest.mark.parametrize("compact", [False, True])
+@pytest.mark.parametrize("ended", [False, True])
+def test_activity_snapshot_follows_projected_tip(tmp_path, compact, ended):
+    with SessionDB(db_path=tmp_path / "state.db") as db:
+        db.create_session("root", "kanban")
+        db.touch_session_activity("root", ts=time.time() + 1, description="Compressing old context",
+                                  provenance=ActivityProvenance.AGENT_COMPRESSION)
+        db.end_session("root", "compression")
+        db.create_session("tip", "kanban", parent_session_id="root")
+        db.touch_session_activity("tip", ts=time.time() + 2, description="Reading test results")
+        if ended:
+            db.end_session("tip", "completed")
+        tip = db.get_session("tip")
+        rows = db.list_sessions_rich(source="kanban", order_by_last_active=True, compact_rows=compact)
+        assert len(rows) == 1
+        row = rows[0]
+        assert row["id"] == "tip"
+        assert row["last_activity_description"] == "Reading test results"
+        assert row["last_activity_provenance"] == "unknown"
+        assert row["last_activity_at"] == tip["last_activity_at"]
+        assert (row["ended_at"] is not None) is ended
