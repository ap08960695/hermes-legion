@@ -0,0 +1,120 @@
+"""Attribution must not turn incomplete observations into proven waste."""
+from copy import deepcopy
+import json
+from hermes_cli.usage_attribution import analyze
+
+
+def event(at=100,status='returned',usage=None):
+    field=lambda n:{'complete':True,'hash':f'{n:064x}'}
+    return {'process_id':42,'status':status,'usage':usage if usage is not None else {'input_tokens':100,'cached_tokens':80},
+            'fingerprint':{'key_id':'a'*16,**{k:field(n) for n,k in enumerate(('session','route','instructions','tools','options','history'),1)},
+              'cross_bot':{'namespace':'b'*16,'started_at_ns':int(at*1e9),'fields':{'profile':field(8),'request':field(9)}}}}
+
+
+def test_identical_request_id_different_attempts_not_collapsed():
+    a=event();b=event(101);result=analyze([a,deepcopy(a),b],[],90,110)
+    assert result['observed_attempts']==2 and result['duplicate_log_copies']==1
+    assert result['matching_logged_fields']['extra_attempts']==1
+    assert result['known_input_tokens']==200
+    assert result['proven_wasted_tokens'] is None
+
+
+def test_failed_unknown_usage_and_missing_history_never_become_zero_cost_or_duplicate():
+    a=event(status='failed_or_interrupted',usage={});b=event(101)
+    b['fingerprint']['history']['complete']=False
+    result=analyze([a,b],[],90,110)
+    assert result['unknown_usage_attempts']==1
+    assert result['matching_logged_fields']['extra_attempts']==0
+    assert result['failed_or_interrupted_attempts']==1
+
+
+def test_unique_pid_time_match_is_only_correlation_and_ambiguity_stays_unknown():
+    run={'board':'test','id':1,'task_id':'t_a','worker_pid':42,'worker_started_at':95,'started_at':94,'ended_at':105,'outcome':'completed','attempt_reason':'recovery'}
+    result=analyze([event()],[run],90,110)
+    assert result['run_correlation']['matched_attempts']==1
+    assert result['run_correlation']['by_reason']['recovery']['input_tokens']==100
+    assert result['run_correlation']['completed_card_input_tokens_per_card']==100
+    other={**run,'id':2}
+    assert analyze([event()],[run,other],90,110)['run_correlation']['matched_attempts']==0
+
+
+def test_scope_window_and_export_privacy():
+    a=event();b=event(101);b['fingerprint']['session']['hash']='c'*64
+    a['prompt']='PRIVATE_SENTINEL'
+    result=analyze([a,b,event(500)],[],90,110)
+    assert result['observed_attempts']==2 and result['matching_logged_fields']['extra_attempts']==0
+    assert 'PRIVATE_SENTINEL' not in json.dumps(result)
+
+
+def test_read_only_board_and_malformed_reason(tmp_path):
+    import sqlite3
+    import pytest
+    from hermes_cli.usage_attribution_sources import read_board
+    path=tmp_path/'board.db'
+    with pytest.raises(sqlite3.OperationalError):read_board(path,90,110)
+    assert not path.exists()
+    with sqlite3.connect(path) as db:
+        db.execute('CREATE TABLE task_runs(id,task_id,worker_pid,worker_started_at,started_at,ended_at,outcome)')
+        db.execute("INSERT INTO task_runs VALUES(1,'t_a',42,95,94,105,'completed')")
+        db.execute('CREATE TABLE task_events(id,task_id,run_id,kind,payload)')
+        db.execute("INSERT INTO task_events VALUES(1,'t_a',1,'claimed',?)",(json.dumps({'attempt':{'reason':[]},'secret':'PRIVATE_SENTINEL'}),))
+    before=path.read_bytes()
+    runs,coverage=read_board(path,90,110)
+    result=analyze([event()],runs,90,110)
+    assert result['run_correlation']['by_reason']['unknown']['attempts']==1
+    assert coverage['completed_cards']==1 and path.read_bytes()==before
+    assert 'PRIVATE_SENTINEL' not in json.dumps(result)
+
+
+def test_rotation_dedup_and_malformed_log(tmp_path):
+    from hermes_cli.usage_attribution_sources import read_logs
+    paths=[tmp_path/'a.log',tmp_path/'a.log.1']
+    for path in paths:path.write_text('CACHE_DIAGNOSTIC '+json.dumps(event())+'\nCACHE_DIAGNOSTIC {broken\n')
+    records,coverage=read_logs(paths)
+    result=analyze(records,[],90,110)
+    assert result['observed_attempts']==1 and result['duplicate_log_copies']==1
+    assert coverage['invalid_json_rows']==2
+
+
+def test_bound_run_matches_without_pid_and_cannot_fall_back_to_wrong_run(tmp_path):
+    from agent.usage_run_binding import run_digest,key_id
+    key=b'k'*32;board=tmp_path/'board.db'
+    row=event();row['fingerprint']['key_id']=key_id(key)
+    row['fingerprint']['task_run']={'complete':True,'hash':run_digest(key,board,'t_a',7)}
+    run={'board':str(board),'id':7,'task_id':'t_a','worker_pid':None,'worker_started_at':None,'started_at':94,'ended_at':105,'outcome':'completed','attempt_reason':'revision',
+         'bindings':[(key_id(key),run_digest(key,board,'t_a',7))]}
+    result=analyze([row],[run],90,110)['run_correlation']
+    assert result['bound_attempts']==1 and result['legacy_pid_correlated_attempts']==0
+    assert result['by_reason']['revision']['input_tokens']==100
+    assert result['by_native_outcome']['completed']['input_tokens']==100
+    wrong={**run,'worker_pid':42,'worker_started_at':95,'bindings':[]}
+    assert analyze([row],[wrong],90,110)['run_correlation']['matched_attempts']==0
+    assert analyze([row],[{**run,'ended_at':99}],90,110)['run_correlation']['matched_attempts']==0
+    row['fingerprint']['key_id']=key_id(b'x'*32)
+    assert analyze([row],[run],90,110)['run_correlation']['matched_attempts']==0
+
+
+def test_collector_connects_existing_key_log_and_native_board_read_only(tmp_path):
+    import sqlite3
+    from agent.usage_run_binding import run_digest,key_id
+    from hermes_cli.usage_attribution_sources import collect
+    home=tmp_path/'home';directory=home/'telemetry/cache-diagnostics';directory.mkdir(parents=True)
+    key=b'k'*32;path=directory/'fingerprint.key';path.write_bytes(key);path.chmod(0o600)
+    board=home/'kanban.db'
+    with sqlite3.connect(board) as db:
+        db.execute('CREATE TABLE task_runs(id,task_id,worker_pid,worker_started_at,started_at,ended_at,outcome)')
+        db.execute("INSERT INTO task_runs VALUES(7,'t_a',NULL,NULL,94,105,'completed')")
+        db.execute('CREATE TABLE task_events(id,task_id,run_id,kind,payload)')
+        db.execute("INSERT INTO task_events VALUES(1,'t_a',7,'claimed',?)",(json.dumps({'attempt':{'reason':'review_handoff'},'lock':'PRIVATE_LOCK'}),))
+    row=event();row['fingerprint']['key_id']=key_id(key)
+    row['fingerprint']['task_run']={'complete':True,'hash':run_digest(key,board,'t_a',7)}
+    logs=home/'logs';logs.mkdir();(logs/'agent.log').write_text('CACHE_DIAGNOSTIC '+json.dumps(row)+'\n')
+    before=board.read_bytes();raw,runs,coverage=collect(home,90,110)
+    result=analyze(raw,runs,90,110)
+    assert result['run_correlation']['bound_attempts']==1
+    assert result['run_correlation']['by_reason']['review_handoff']['input_tokens']==100
+    assert board.read_bytes()==before and path.read_bytes()==key and coverage['binding_keys']['created']==0
+    assert 'PRIVATE_LOCK' not in json.dumps(result)
+    path.unlink();raw,runs,coverage=collect(home,90,110)
+    assert not path.exists() and coverage['binding_keys']['unavailable']==1
+    assert analyze(raw,runs,90,110)['run_correlation']['bound_attempts']==0
diff --git a/tests/hermes_state/test_compaction_prefix_snapshot.py b/tests/hermes_state/test_compaction_prefix_snapshot.py
new file mode 100644
index 0000000000000000000000000000000000000000..64c9835869e795fcc74d5a4049a4cdd87c1184f6
--- /dev/null
+++ b/tests/hermes_state/test_compaction_prefix_snapshot.py
@@ -0,0 +1,76 @@
+"""Native prefix snapshots obey transcript transaction and lease boundaries."""
+import json
+import sqlite3
+
+import pytest
+
+from hermes_state import SessionDB, SessionCompressionInProgressError
+from hermes_state_errors import CompressionSessionBusyError
+
+
+@pytest.fixture(params=[True, False], ids=["in-place", "rotation"])
+def publication(tmp_path, request):
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session("parent", source="cli")
+    db.append_message("parent", "user", "original input")
+    db.append_message("parent", "assistant", "original answer")
+    db.update_system_prompt("parent", "original prefix")
+    db.update_session_tool_names("parent", {"version": "fixture", "tools": [{"name": "old"}]})
+    assert db.try_acquire_compression_lock("parent", "owner")
+    yield db, request.param
+    db.close()
+
+
+def _publish(db, in_place, *, holder="owner", **kwargs):
+    messages = [{"role": "user", "content": "folded context"}]
+    if in_place:
+        db.archive_and_compact("parent", messages, lock_holder=holder, **kwargs)
+        return "parent"
+    db.publish_compression_child(parent_session_id="parent", child_session_id="child", source="cli",
+        messages=messages, system_prompt="legacy child prefix", compression_lock_holder=holder, **kwargs)
+    return "child"
+
+
+def _unchanged(db, messages, prefix, pin):
+    assert db.get_messages_as_conversation("parent") == messages
+    row = db.get_session("parent")
+    assert row["ended_at"] is None and row["system_prompt"] == prefix and row["tool_names"] == pin
+    assert db.get_session("child") is None
+
+
+def test_lost_lease_cannot_publish_candidate_prefix(publication):
+    db, in_place = publication
+    before, row = db.get_messages_as_conversation("parent"), db.get_session("parent")
+    with pytest.raises((SessionCompressionInProgressError, CompressionSessionBusyError)):
+        _publish(db, in_place, holder="different-worker", prefix_snapshot={"system_prompt": "stale prefix",
+            "tool_pin": {"version": "fixture", "tools": [{"name": "stale"}]}})
+    _unchanged(db, before, row["system_prompt"], row["tool_names"])
+
+
+def test_prefix_storage_failure_aborts_the_whole_publication(publication):
+    db, in_place = publication
+    before, row = db.get_messages_as_conversation("parent"), db.get_session("parent")
+    with db._conn:
+        db._conn.execute("CREATE TRIGGER refuse_prefix BEFORE UPDATE OF tool_names ON sessions "
+            "BEGIN SELECT RAISE(ABORT, 'fixture: refuse staged prefix'); END")
+    with pytest.raises(sqlite3.IntegrityError, match="refuse staged prefix"):
+        _publish(db, in_place, prefix_snapshot={"system_prompt": "candidate prefix",
+            "tool_pin": {"version": "fixture", "tools": [{"name": "new"}]}})
+    _unchanged(db, before, row["system_prompt"], row["tool_names"])
+
+
+def test_omitted_tool_pin_retains_live_schemas(publication):
+    db, in_place = publication
+    pin = db.get_session("parent")["tool_names"]
+    sid = _publish(db, in_place, prefix_snapshot={"system_prompt": "refreshed prefix"})
+    row = db.get_session(sid)
+    assert row["system_prompt"] == "refreshed prefix" and row["tool_names"] == pin
+
+
+def test_legacy_publication_without_snapshot_keeps_its_contract(publication):
+    db, in_place = publication
+    pin = db.get_session("parent")["tool_names"]
+    sid = _publish(db, in_place)
+    row = db.get_session(sid)
+    assert row["system_prompt"] == ("original prefix" if in_place else "legacy child prefix")
+    assert json.loads(row["tool_names"]) == json.loads(pin)
