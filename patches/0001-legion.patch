+"""Native constructor boundary preserves stored picks and cannot activate paid fallbacks."""
+import json
+from types import SimpleNamespace
+
+from hermes_constants import get_hermes_home
+
+
+def test_native_constructor_restores_model_effort_tier_and_disables_fallback(monkeypatch, tmp_path):
+    import run_agent
+    from hermes_cli.kanban_attention_runtime import build_agent
+    from tui_gateway import server
+    home = get_hermes_home()
+    (home / '.env').write_text('NVIDIA_API_KEY=fixture-profile-key\n')
+    (home / 'config.yaml').write_text('''model:
+  default: ambient-model
+  provider: nvidia
+fallback_providers:
+  - provider: openrouter
+    model: paid-model-that-must-not-be-used
+reasoning_effort: low
+agent:
+  max_turns: 7
+  disabled_toolsets: [terminal]
+''')
+    seen = []
+    monkeypatch.setattr(run_agent, 'AIAgent', lambda **kwargs: seen.append(kwargs) or SimpleNamespace())
+    marker = object()
+    row = {'model': 'saved-model', 'source': 'desktop', 'model_config': json.dumps({
+        'provider': 'nvidia', 'reasoning_config': {'effort': 'high'}, 'service_tier': 'priority'})}
+    with server._session_profile_runtime_scope({'profile_home': str(home)}):
+        build_agent(session_id='stored-session', row=row, cwd=str(tmp_path), session_db=marker)
+    assert len(seen) == 1
+    kw = seen[0]
+    assert kw['model'] == 'saved-model' and kw['provider'] == 'nvidia'
+    assert kw['reasoning_config'] == {'effort': 'high'} and kw['service_tier'] == 'priority'
+    assert kw['session_id'] == 'stored-session' and kw['session_db'] is marker
+    assert kw['cwd'] == str(tmp_path) and kw['fallback_model'] is None
+    assert kw['max_iterations'] == 7 and kw['disabled_toolsets'] == ['terminal']
+    assert kw['api_key'] == 'fixture-profile-key'
+
+
+def test_primary_auth_failure_does_not_resolve_a_fallback(monkeypatch, tmp_path):
+    import pytest
+    import run_agent
+    from hermes_cli import runtime_provider
+    from hermes_cli.kanban_attention_runtime import build_agent
+    from tui_gateway import server
+    home = get_hermes_home()
+    (home / 'config.yaml').write_text('''model:
+  default: ambient-model
+  provider: nvidia
+fallback_providers:
+  - provider: openrouter
+    model: forbidden-paid-fallback
+''')
+    calls, builds = [], []
+    def refuse(**kwargs):
+        calls.append(kwargs['requested'])
+        raise RuntimeError('primary auth unavailable')
+    monkeypatch.setattr(runtime_provider, 'resolve_runtime_provider', refuse)
+    monkeypatch.setattr(run_agent, 'AIAgent', lambda **kw: builds.append(kw))
+    row = {'model': 'saved-model', 'source': 'desktop', 'model_config': json.dumps({'provider': 'nvidia'})}
+    with server._session_profile_runtime_scope({'profile_home': str(home)}):
+        with pytest.raises(RuntimeError, match='primary auth unavailable'):
+            build_agent(session_id='stored-session', row=row, cwd=str(tmp_path), session_db=object())
+    assert calls == ['nvidia'] and builds == []
