+def test_ordinary_lifecycle_receipt_cannot_open_a_closed_session(case, monkeypatch):
+    built, calls, _ = _fake(monkeypatch, case)
+    with kbc.connect_closing() as c:
+        c.execute('DELETE FROM kanban_task_attention')
+        c.commit()
