new file mode 100644
index 0000000000000000000000000000000000000000..1401abe9bfe48d1d71832393e366836f67931ea8
--- /dev/null
+++ b/tools/shared_document_cache.py
@@ -0,0 +1,69 @@
+"""Bounded, same-owner document conversion cache across bots and processes.
+
+Callers must first read the entire source through their authorized file backend. The key
+requires those exact bytes: a path or an earlier permission check cannot retrieve a hit.
+Only deterministic stdlib converters are shared; no OCR, external service, or live DB.
+Redaction, pagination and per-task read receipts always run in the caller afterwards.
+"""
+import hashlib
+import json
+import logging
+import os
+from pathlib import Path
+import stat
+
+logger = logging.getLogger(__name__)
+_VERSION = 'stdlib-document-v1'
+
+
+def _root():
+    from hermes_constants import get_default_hermes_root, get_hermes_home
+    # Explicit served home prevents the launch profile selecting another installation.
+    root = get_default_hermes_root(home=get_hermes_home()) / 'cache' / 'shared-documents-v1'
+    root.mkdir(mode=0o700, parents=True, exist_ok=True)
+    info=root.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o077 or info.st_uid != os.getuid():
+        raise OSError('unsafe shared document cache')
+    return root
+
+
+from tools.cache_file_lock import cache_file_lock as _lock
+from tools.derived_cache import _read, _store
+
+
+
+
+def extract_shared(data: bytes, path: str, convert):
+    """Return a conversion; cache failures cannot retry a converter or hide its error."""
+    if os.name != 'posix' or Path(path).suffix.lower() not in {'.docx','.xlsx','.ipynb'}:
+        return convert(data,path)
+    # Path affects notebook display text; include it for every converter for consistency.
+    key=hashlib.sha256(json.dumps([_VERSION,path],ensure_ascii=True).encode()+b'\0'+data).hexdigest()
+    result=None; converted=False
+    try:
+        root=_root()
+        with _lock(root,key):
+            target=root/(key+'.txt')
+            try:
+                hit=_read(target)
+            except (OSError,UnicodeError):
+                hit=None
+            if hit is not None:
+                logger.info('SHARED_DOCUMENT_CACHE hit source_bytes=%d',len(data))
+                return hit
+            # Mark before calling: a conversion error must propagate, never run twice.
+            converted=True
+            result=convert(data,path)
+            from tools.cache_file_lock import CacheLockBusy
+            try:
+                _store(root,target,result)
+            except CacheLockBusy:
+                return result
+            logger.info('SHARED_DOCUMENT_CACHE miss source_bytes=%d',len(data))
+            return result
+    except (OSError, UnicodeError):
+        if converted:
+            if result is None:
+                raise
+            return result
+        return convert(data,path)
