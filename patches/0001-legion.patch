+_UNCLOSED_DCS = re.compile(r"\x1b[PX^_]")
+_UNCLOSED_OSC = re.compile(r"\x1b\]")
+_UNCLOSED_C1_OSC = re.compile(r"\x9d")
+
+
+def _strip_unterminated_strings(text: str) -> str:
+    # After the final possible terminator, these branches of the general regex
+    # can never match. Remove their single-byte fallback directly, avoiding an
+    # unsuccessful scan of the entire remaining suffix for EACH introducer.
+    st = text.rfind("\x1b\\")
+    boundaries = (
+        (_UNCLOSED_DCS, st + 2 if st >= 0 else 0),
+        (_UNCLOSED_OSC, max(st + 2 if st >= 0 else 0, text.rfind("\x07") + 1)),
+    )
+    # Work from right to left so suffix edits cannot invalidate earlier offsets.
+    for pattern, start in sorted(boundaries, key=lambda item: item[1], reverse=True):
+        if pattern.search(text, start):
+            text = text[:start] + pattern.sub("", text[start:])
+    start = max(text.rfind("\x07"), text.rfind("\x9c")) + 1
+    if _UNCLOSED_C1_OSC.search(text, start):
+        text = text[:start] + _UNCLOSED_C1_OSC.sub("", text[start:])
+    return text
+
+
 def strip_ansi(text: str) -> str:
@@ -49,3 +73,3 @@ def strip_ansi(text: str) -> str:
         return text
-    return _ANSI_ESCAPE_RE.sub("", text)
