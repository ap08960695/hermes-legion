+import type { ReactNode } from 'react'
+import { Button } from '@/components/ui/button'
+import { Codicon } from '@/components/ui/codicon'
+import { Dialog, DialogContent, DialogTitle } from '@/components/ui/dialog'
+import type { SessionControlSnapshot } from '@/store/session-control'
+
+import { workStatus, type WorkEvidence } from './model'
+
+interface WorkPanelProps {
+  open: boolean
+  sessionId: string | null
+  controlPanel?: ReactNode
+  control: SessionControlSnapshot | null
+  evidence: WorkEvidence
+  unread: readonly { id: string; title: string }[]
+  t: (key: string) => string
+  onClose: () => void
+  onGoal: () => void
+  onLibrary: () => void
+  onRuns: () => void
+  onChat: (id?: string) => void
+}
+export function WorkPanel({
+  open,
+  sessionId,
+  control,
+  controlPanel,
+  evidence,
+  unread,
+  t,
+  onClose,
+  onGoal,
+  onLibrary,
+  onRuns,
+  onChat
+}: WorkPanelProps) {
+  const status = workStatus(evidence)
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={value => {
+        if (!value) onClose()
+      }}
+    >
+      <DialogContent aria-describedby="hermes-focus-work-hint" bodyClassName="hermes-focus-work">
+        <DialogTitle>{t('summary')}</DialogTitle>
+        <p id="hermes-focus-work-hint">{t('returnHint')}</p>
+        <article>
+          <h3>
+            <Codicon name={status.kind === 'input' ? 'question' : status.kind === 'done' ? 'pass' : 'pulse'} />
+            {t(`states.${status.kind}`)}
+          </h3>
+          {sessionId ? (
+            <>
+              <p>
+                {t('source')}: {sessionId}
+              </p>
+              {control?.updated_at ? (
+                <p>
+                  {t('updated')}: {new Date(control.updated_at * 1000).toLocaleString()}
+                </p>
+              ) : null}
+              {status.reason && <p>{status.reason}</p>}
+              {status.target && (
+                <p>
+                  {t('target')}: {status.target}
+                </p>
+              )}
+              {control?.goal?.wait_barrier?.type === 'until' && (
+                <p>{new Date(control.goal.wait_barrier.until_at * 1000).toLocaleString()}</p>
+              )}
+              {status.kind === 'input' && <p>{t('needDecision')}</p>}
+              <Button variant="text" onClick={() => onChat()}>
+                {t('openChat')}
+              </Button>
+            </>
+          ) : (
+            <p>{t('noSession')}</p>
+          )}
+        </article>
+        <article>
+          <h3>
+            <Codicon name="target" />
+            {t('goal')}
+          </h3>
+          <p>{control ? control.goal?.title || t('noGoal') : t('unknown')}</p>
+          {control?.goal?.contract.verification && (
+            <p>
+              {t('verification')}: {control.goal.contract.verification}
+            </p>
+          )}
+          <Button variant="text" disabled={!sessionId} onClick={onGoal}>
+            {t('configure')}
+          </Button>
+        </article>
+        {controlPanel}
+        <article>
+          <h3>
+            <Codicon name="folder-library" />
+            {t('outputs')}
+          </h3>
+          <p>{t('outputEvidence')}</p>
+          <Button variant="text" onClick={onLibrary}>
+            {t('openLibrary')}
+          </Button>
+        </article>
+        <article>
+          <h3>
+            <Codicon name="checklist" />
+            {t('unread')} · {unread.length}
+          </h3>
+          {unread.length ? (
+            unread.map(row => (
+              <Button key={row.id} variant="text" onClick={() => onChat(row.id)}>
+                {row.title || row.id}
+              </Button>
+            ))
+          ) : (
+            <p>{t('noEvidence')}</p>
+          )}
+          <div>
+            <Button variant="text" onClick={onRuns}>
+              {t('openRuns')}
+            </Button>
+          </div>
+        </article>
+      </DialogContent>
+    </Dialog>
+  )
+}
