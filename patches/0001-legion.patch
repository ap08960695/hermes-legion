+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+
+            aria-label={t('all')}
+            aria-expanded={allOpen}
+            onClick={() => {
+              setQuery('')
+              setAllOpen(true)
+            }}
+          >
+            <Codicon name="extensions" />
+            <span>{t('all')}</span>
+          </Button>
+        </div>
+        <div className="hermes-focus-utilities">
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+            aria-label={t('chatHistory')}
+            aria-current={path === '/history' || path === '/projects' ? 'page' : undefined}
+            onClick={onSessions}
+          >
+            <Codicon name="history" />
+            <span>{t('history')}</span>
+          </Button>
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+            aria-label={t('summary')}
+
+            onClick={() => onTarget({ panel: 'work' })}
+          >
+            <Codicon name="bell" />
+            <span>{t('summary')}</span>
+          </Button>
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+            aria-label={t('search')}
+
+            onClick={onSearch}
+          >
+            <Codicon name="search" />
+            <span>{t('search')}</span>
+          </Button>
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+            aria-label={t(mode === 'simple' ? 'workspace' : 'focus')}
+
+            onClick={() => onMode(mode === 'simple' ? 'advanced' : 'simple')}
+          >
+            <Codicon name={mode === 'simple' ? 'layout' : 'layout-centered'} />
+            <span>{t(mode === 'simple' ? 'workspaceShort' : 'focus')}</span>
+          </Button>
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+            aria-label={t('settings')}
+            aria-current={path === '/settings' ? 'page' : undefined}
+
+            onClick={() => onTarget({ path: '/settings' })}
+          >
+            <Codicon name="settings-gear" />
+            <span>{t('settings')}</span>
+          </Button>
+        </div>
+      </nav>
+      <FocusNavigationContext.Provider value={true}>
+        <div className="hermes-focus-content">
+          {scopeControl}
+          {children}
+        </div>
+      </FocusNavigationContext.Provider>
+      <Dialog open={allOpen} onOpenChange={setAllOpen}>
+        <DialogContent aria-describedby={undefined} bodyClassName="hermes-focus-features">
+          <DialogTitle>{t('all')}</DialogTitle>
+          <SearchField
+            aria-label={t('searchFeatures')}
+            placeholder={t('searchFeatures')}
+            value={query}
+            onChange={setQuery}
+          />
+          {(['work', 'team', 'system'] as const).map(group => {
+            const rows = matches.filter(feature => feature.group === group)
+            return rows.length ? (
+              <section key={group}>
+                <h3>{t(`groups.${group}`)}</h3>
+                <div className="hermes-focus-feature-grid">
+                  {rows.map(feature => (
+                    <Button
+                      key={feature.id}
+                      variant="ghost"
+
+                      onClick={() => {
+                        setAllOpen(false)
+                        if (feature.path) onTarget({ path: feature.path })
+                        else if (feature.pane) onTarget({ pane: feature.pane })
+                        else if (feature.panel) onTarget({ panel: feature.panel })
+                        else if (feature.statusbar) onTarget({ statusbar: true })
+                      }}
+                    >
+                      <Codicon name={feature.codicon} />
+                      <span>{label(feature)}</span>
+                    </Button>
+                  ))}
+                </div>
+              </section>
+            ) : null
+          })}
+          {!matches.length && <p role="status">{t('noFeatures')}</p>}
+        </DialogContent>
+      </Dialog>
+    </div>
+  )
+}
