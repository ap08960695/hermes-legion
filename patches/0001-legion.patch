+import { useNavigate } from 'react-router'
+import { useStore } from '@nanostores/react'
+import { Button } from '@/components/ui/button'
+import { Codicon } from '@/components/ui/codicon'
+import { $activeConnectionId, $connectionsRegistry, $pendingConnectionId } from '@/store/connections'
+import { $gatewayState } from '@/store/session'
+import { navigateToWorkspacePage } from '../routes'
+import { ConnectionSwitcher } from '../chat/sidebar/connection-switcher'
+import { InlineProfileSelector } from './profile-selector'
+import { useParityCopy } from './parity-copy'
+import './context-bar.css'
+
+/** Visible context, from the existing native stores. No polling or action on mount. */
+export function ScopeControl() {
+  const t = useParityCopy(),
+    navigate = useNavigate()
+  const connection = useStore($activeConnectionId),
+    registry = useStore($connectionsRegistry)
+  const pending = useStore($pendingConnectionId),
+    state = useStore($gatewayState)
+  const active = registry?.connections.find(row => row.id === connection)
+  const label = active?.label || (connection === 'local' ? t('local') : t('unknownDevice'))
+  const status = pending || state === 'connecting' ? 'connecting' : state === 'open' ? 'connected' : 'disconnected'
+  const manageConnections = () => navigateToWorkspacePage(navigate, '/settings?tab=gateway')
+  return (
+    <section className="hermes-context-bar" aria-label={t('context')}>
+      <div className="hermes-context-field">
+        <span className="hermes-context-label">{t('device')}</span>
+        {(registry?.connections.length || 0) > 1 ? (
+          <ConnectionSwitcher onConnect={manageConnections} />
+        ) : (
+          <div className="hermes-context-device">
+            <Codicon name={active?.kind === 'ssh' || active?.kind === 'remote' ? 'remote' : 'device-desktop'} />
+            <span>{label}</span>
+            <Button variant="ghost" size="icon-xs" aria-label={t('manageDevices')} onClick={manageConnections}>
+              <Codicon name="settings-gear" />
+            </Button>
+          </div>
+        )}
+      </div>
+      <div className="hermes-context-field hermes-context-profile">
+        <span className="hermes-context-label">{t('profileForNew')}</span>
+        <InlineProfileSelector
+          busy={Boolean(pending)}
+          onManage={() => navigateToWorkspacePage(navigate, '/profiles')}
+        />
+      </div>
+      <span className="hermes-context-status" data-state={status} role="status">
+        <Codicon
+          name={status === 'connecting' ? 'sync~spin' : status === 'connected' ? 'pass-filled' : 'debug-disconnect'}
+        />
+        {t(status)}
+      </span>
+    </section>
+  )
+}
