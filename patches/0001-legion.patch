+"""A closed-session host admits exactly one real receipt, never a general resume."""
+from dataclasses import asdict
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_constants import get_hermes_home
+from hermes_state import SessionDB
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_tui_delivery as delivery
+from hermes_cli import kanban_db_attention as attention
+from tests.hermes_cli.test_kanban_attention import KEY, DAY, NOW, _fixture, _request
+
+
+@pytest.fixture
+def case(tmp_path, monkeypatch):
+    monkeypatch.setattr(attention, 'time', SimpleNamespace(time=lambda: NOW))
+    home = get_hermes_home()
+    db = SessionDB(home / 'state.db')
+    db.create_session(KEY, source='desktop', model='saved-model', model_config={
+        'provider': 'openai-codex', 'reasoning_config': {'effort': 'high'}, 'service_tier': 'priority'})
+    db.update_session_cwd(KEY, str(tmp_path))
+    db.append_message(KEY, 'user', 'Remember the whole project, keep its gates.')
+    db.append_message(KEY, 'assistant', 'Project context retained.')
+    db.end_session(KEY, 'tui_close')
+    with kbc.connect_closing() as c:
+        tid, guard = _fixture(c, tmp_path)
+        request = _request(c, tid, guard)
+        before = asdict(kb.get_task(c, tid))
+    yield SimpleNamespace(home=home, db=db, tid=tid, guard=guard, request=request, before=before, cwd=str(tmp_path))
+    db.close()
+
+
+def _host():
+    from hermes_cli import kanban_attention_host
+    return kanban_attention_host
+
+
+def _state(case):
+    rows = delivery.read_receipts(kb.kanban_db_path(), home=str(case.home.resolve()), session_key=KEY)
+    return next(r['state'] for r in rows if r['id'] == case.request['delivery_id'])
+
+
+def _fake(monkeypatch, case, *, result=None, action=None):
+    built, calls, closed = [], [], []
+    def factory(**kwargs):
+        built.append(kwargs)
+        class Agent:
+            session_id = kwargs['session_id']
+            def run_conversation(self, prompt, *, conversation_history):
+                calls.append((prompt, conversation_history))
+                if action:
+                    action()
+                return result if result is not None else {'completed': True, 'final_response': 'Inspected the plan.'}
+            def close(self):
+                closed.append(True)
+        return Agent()
+    monkeypatch.setattr(_host(), 'build_agent', factory)
+    return built, calls, closed
+
+
+def _run(case):
+    return _host().run(kb.kanban_db_path(), delivery_id=case.request['delivery_id'], session_key=KEY)
+
+
+def test_one_receipt_preserves_task_and_stored_context(case, monkeypatch):
+    built, calls, closed = _fake(monkeypatch, case)
+    out = _run(case)
+    assert out['state'] == 'settled' and out['ran'] is True
+    assert len(built) == len(calls) == len(closed) == 1
+    assert built[0]['row']['model'] == 'saved-model'
+    assert json.loads(built[0]['row']['model_config'])['reasoning_config'] == {'effort': 'high'}
+    assert built[0]['cwd'] == case.cwd
+    assert 'Inspect this existing plan' in calls[0][0]
+    assert [m['content'] for m in calls[0][1]] == [
+        'Remember the whole project, keep its gates.', 'Project context retained.']
+    with kbc.connect_closing() as c:
+        assert asdict(kb.get_task(c, case.tid)) == case.before
+    assert _run(case)['ran'] is False and len(calls) == 1
+
+
+@pytest.mark.parametrize('result,state', [
+    ({'completed': False, 'partial': True, 'final_response': 'half'}, 'failed'),
+    ({'error': 'provider unavailable', 'failed': True}, 'failed'),
+    ({'interrupted': True}, 'cancelled'),
+    ({}, 'unknown'),
+    (None, 'unknown'),
+])
+def test_incomplete_turn_is_not_a_success(case, monkeypatch, result, state):
+    if result is None:
+        def ambiguous(): raise RuntimeError('worker outcome lost')
+        _fake(monkeypatch, case, action=ambiguous)
+        with pytest.raises(RuntimeError): _run(case)
+    else:
+        _fake(monkeypatch, case, result=result)
+        assert _run(case)['state'] == state
+    assert _state(case) == state
+    assert _run(case)['ran'] is False
+
+
+def test_failed_build_leaves_pending(case, monkeypatch):
+    def failed(**kwargs): raise RuntimeError('no configured provider')
+    monkeypatch.setattr(_host(), 'build_agent', failed)
