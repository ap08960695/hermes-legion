+import { useStore } from '@nanostores/react'
+import { useState } from 'react'
+
+import { ScopedAccountUsage } from '@/app/settings/account-usage-panel'
+import { Popover, PopoverContent, PopoverTrigger } from '@/components/ui/popover'
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select'
+import { useI18n } from '@/i18n'
+import { BarChart3 } from '@/lib/icons'
+import { $activeConnectionId } from '@/store/connections'
+import { $activeGatewayProfile, normalizeProfileKey } from '@/store/profile'
+
+export function AccountUsageStatusbar() {
+  const { t } = useI18n()
+  const activeProfile = normalizeProfileKey(useStore($activeGatewayProfile))
+  const [profile, setProfile] = useState('default')
+  const connectionId = useStore($activeConnectionId)
+  const [open, setOpen] = useState(false)
+  const label = t.settings.providers.usage.title
+
+  return (
+    <Popover onOpenChange={setOpen} open={open}>
+      <PopoverTrigger asChild>
+        <button
+          aria-label={label}
+          className="inline-flex h-full items-center gap-1 px-1.5 text-[0.6875rem] text-(--ui-text-tertiary) hover:bg-(--chrome-action-hover) hover:text-foreground"
+          type="button"
+        >
+          <BarChart3 className="size-3" />
+          <span>{label}</span>
+        </button>
+      </PopoverTrigger>
+      <PopoverContent
+        align="end"
+        className="max-h-[min(38rem,85vh)] w-[min(50rem,calc(100vw-1rem))] overflow-y-auto p-5"
+        side="top"
+      >
+        {open && (
+          <ScopedAccountUsage
+            connectionId={connectionId}
+            key={JSON.stringify([connectionId, profile])}
+            profile={profile}
+            profileControl={
+              <Select onValueChange={setProfile} value={profile}>
+                <SelectTrigger aria-label={t.settings.profileScope.appliesTo} className="w-32" size="sm">
+                  <SelectValue />
+                </SelectTrigger>
+                <SelectContent>
+                  <SelectItem value="default">default</SelectItem>
+                  {activeProfile !== 'default' && <SelectItem value={activeProfile}>{activeProfile}</SelectItem>}
+                </SelectContent>
+              </Select>
+            }
+          />
+        )}
+      </PopoverContent>
+    </Popover>
+  )
+}
+
+export function renderAccountUsageStatusbar() {
+  return <AccountUsageStatusbar />
+}
