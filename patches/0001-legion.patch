index 0000000000000000000000000000000000000000..c14b082fdc26a0193aaa399a5dc69415824b7247
--- /dev/null
+++ b/agent/compression_main_context.py
@@ -0,0 +1,227 @@
+"""Compression-only borrowing of the main SDK; no credential selection or refresh.
+
+Process-local opaque authority, never config/JSON/CLI-wallet metadata. Main owns
+SDK and auth lifecycle. A new main SDK/native scope epoch creates a new reference; old refs
+stop. Compression never refreshes, rotates, or retries a failed account itself.
+"""
+from threading import RLock
+import weakref
+
+
+class CompressionMainContextStopped(RuntimeError):
+    def __init__(self):
+        # Deliberately no upstream text/status/cause: native legacy predicates
+        # cannot reinterpret identity loss as authority for paid rescue.
+        super().__init__('Selected main compression context is unavailable.')
+
+
+class _MainSDKScope:
+    """Nonsecret process-local epoch at supported native SDK mutation boundaries."""
+    def __init__(self):
+        self.lock=RLock()
+        self.epoch=object()
+        self._pending_mutations=set()
+
+    @property
+    def pending(self):
+        # All tickets must resolve. A newer mutation finishing cannot release
+        # an earlier native mutation still writing this SDK outside the lock.
+        with self.lock:
+            return bool(self._pending_mutations)
+
+
+def seal_main_sdk(sdk):
+    # Called only by the native main factory after authenticated SDK creation.
+    sdk._hermes_compression_scope=_MainSDKScope()
+    return sdk
+
+
+def begin_main_scope_mutation(owner):
+    sdk=getattr(owner,'client',None)
+    state=getattr(sdk,'_hermes_compression_scope',None)
+    if not isinstance(state,_MainSDKScope):
+        return None
+    # A borrowing compression call holds this same SDK lock. Mutation cannot
+    # change its wire auth/header scope between validation and dispatch.
+    with state.lock:
+        epoch=object()
+        state.epoch=epoch
+        state._pending_mutations.add(epoch)
+        return state,epoch
+
+
+def complete_main_scope_mutation(ticket):
+    if ticket is None:
+        return
+    state,epoch=ticket
+    with state.lock:
+        # Resolve only this operation, even if another operation began later.
+        # Repeated completion is harmless and never releases another ticket.
+        state._pending_mutations.discard(epoch)
+
+
+class MainCompressionContext:
+    __slots__ = ('_owner','_sdk','_state','_epoch','_pool','_entry','_entry_id','_home','_main_model','_lock','_cache')
+
+    def __init__(self, owner, sdk, pool, entry, home):
+        self._owner=weakref.ref(owner)
+        self._sdk=sdk
+        self._state=sdk._hermes_compression_scope
+        self._epoch=self._state.epoch
+        self._pool=pool
+        self._entry=entry
+        self._entry_id=entry.id
+        self._home=home
+        self._main_model=owner.model
+        self._lock=RLock()
+        self._cache={}
+
+    def __setattr__(self,name,value):
+        if hasattr(self,name):
+            raise AttributeError('Main compression context reference is immutable')
+        object.__setattr__(self,name,value)
+
+    def __repr__(self):
+        return '<opaque main compression context>'
+
+    def __reduce__(self):
+        raise TypeError('Main compression context is process-local')
+
+    def validate(self):
+        from hermes_constants import hermes_home_key
+        owner=self._owner()
+        if (getattr(self._sdk,'_hermes_compression_scope',None) is not self._state
+            or self._state.epoch is not self._epoch or self._state.pending
+            or getattr(self._sdk,'max_retries',None)!=0):
+            raise CompressionMainContextStopped()
+        if (owner is None or hermes_home_key()!=self._home
+            or owner.provider!='openai-codex' or owner.api_mode!='codex_responses'
+            or owner.model!=self._main_model or owner.client is not self._sdk
+            or getattr(owner,'_credential_pool',None) is not self._pool
+            or getattr(owner,'_credential_pool_entry_id',None)!=self._entry_id
+            or self._entry.id!=self._entry_id):
+            raise CompressionMainContextStopped()
+        closed=getattr(self._sdk,'is_closed',False)
+        if (closed() if callable(closed) else closed) is True:
+            raise CompressionMainContextStopped()
+        # Read only an already loaded entry identity/status. No current()/select(),
+        # disk sync, key equality, JWT decode or proactive refresh.
+        with self._pool._lock:
+            current=self._pool._find(lambda e:e.id==self._entry_id)
+            # Native success/usage bookkeeping replaces entry records even
+            # without changing the selected credential. SDK identity and its native scope epoch are
+            # the generation fence; entry id/status is the revocation fence.
+            if current is None or current.last_status not in (None,'ok'):
+                raise CompressionMainContextStopped()
+
+    def auxiliary(self, model, async_mode=False):
+        # Native LCM and built-in compression use synchronous call_llm. Do not
+        # add a worker/executor ownership contract for an unrelated async lane.
+        if async_mode:
+            raise CompressionMainContextStopped()
+        from agent.auxiliary_client import CodexAuxiliaryClient, _CodexCompletionsAdapter, _ChatShim
+        with self._lock:
+            self.validate()
+            key=(model,async_mode)
+            if key in self._cache and not self._cache[key]._closed:
+                return self._cache[key]
+            # Cache is owned by the bound context, not the global pool-current
+            # cache. One selected compression model; replace prior wrappers.
+            self._cache.clear()
+            authority=self
+            native=_CodexCompletionsAdapter(self._sdk,model,owns_client=False)
+            class Completion:
+                def create(self,**kwargs):
+                    with authority._state.lock:
+                        return self._create_locked(**kwargs)
+                def _create_locked(self,**kwargs):
+                    authority.validate()
+                    if client._closed:
+                        raise CompressionMainContextStopped()
+                    from agent.auxiliary_client import _get_auxiliary_task_config
+                    cfg=_get_auxiliary_task_config('compression')
+                    if (cfg.get('same_main_context') is not True or
+                        cfg.get('provider')!='openai-codex' or cfg.get('model')!=model):
+                        raise CompressionMainContextStopped()
+                    if (kwargs.get('model',model)!=model or kwargs.get('stream')
+                        or kwargs.get('extra_headers') or kwargs.get('api_key')
+                        or kwargs.get('base_url')):
+                        raise CompressionMainContextStopped()
+                    try:
+                        response=native.create(**kwargs)
+                    except Exception:
+                        raise CompressionMainContextStopped() from None
+                    authority.validate()
+                    return response
+            class Borrowed(CodexAuxiliaryClient):
+                _main_compression_context_bound=True
+                def __init__(self):
+                    # Do not call native __init__: it copies real_client.api_key.
+                    self._real_client=authority._sdk
+                    self._closed=False
+                    self.api_key=''
+                    self.base_url=str(authority._sdk.base_url)
+                    self.chat=_ChatShim(Completion())
+                def close(self):
+                    # Main owns shared SDK lifetime, including cache retirement.
+                    self._closed=True
+            client=Borrowed()
+            self._cache[key]=client
+            return client
+
+
+def capture_main_compression_context(owner):
+    """Called after turn main-runtime restoration; SDK itself is account authority.
+
+Entry metadata is only a revocation/generation fence, not a decoded identity
+claim. If native bookkeeping is missing or changed, do not probe/repair it.
+"""
+    from hermes_constants import hermes_home_key
+    try:
+        if owner.provider!='openai-codex' or owner.api_mode!='codex_responses':
+            return None
+        sdk=owner.client
+        state=getattr(sdk,'_hermes_compression_scope',None)
+        if not isinstance(state,_MainSDKScope) or state.pending:
+            return None
+        pool=owner._credential_pool
+        entry_id=owner._credential_pool_entry_id
+        if not isinstance(entry_id,str) or not entry_id or sdk is None or pool is None:
+            return None
+        # Responses-only; never start an app-server/CLI worker as a substitute.
+        if not hasattr(sdk,'responses'):
+            return None
+        with pool._lock:
+            entry=pool._find(lambda e:e.id==entry_id)
+            if entry is None or entry.last_status not in (None,'ok'):
+                return None
+        old=getattr(owner,'_compression_main_context',None)
+        if isinstance(old,MainCompressionContext):
+            try:
+                old.validate()
+                return old
+            except CompressionMainContextStopped:
+                pass
+        ref=MainCompressionContext(owner,sdk,pool,entry,hermes_home_key())
+        ref.validate()
+        owner._compression_main_context=ref
+        return ref
+    except Exception:
+        return None
+
+
+def current_main_compression_context():
+    from agent.auxiliary_client import _RUNTIME_MAIN_CONTEXT
+    runtime=_RUNTIME_MAIN_CONTEXT.get()
+    return runtime.get('compression_context') if isinstance(runtime,dict) else None
+
+
+def resolve_bound_compression(runtime, model, *, async_mode=False):
+    from agent.auxiliary_client import _get_auxiliary_task_config
+    cfg=_get_auxiliary_task_config('compression')
+    ref=runtime.get('compression_context')
+    if (not isinstance(ref,MainCompressionContext)
+        or runtime.get('provider')!='openai-codex'
+        or not model or cfg.get('provider')!='openai-codex' or cfg.get('model')!=model):
+        raise CompressionMainContextStopped()
+    return ref.auxiliary(model,async_mode),model
