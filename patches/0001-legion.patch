+"""Compression carries native goal/heartbeat/loop state without loss or duplication."""
+
+from concurrent.futures import ThreadPoolExecutor
+import json
+from pathlib import Path
+import threading
+
+import pytest
+
+from hermes_cli import goals, heartbeat, loops
+
+
+@pytest.fixture(params=['goal', 'heartbeat', 'loop'])
+def control(request, tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    home = tmp_path / 'owner'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    goals._DB_CACHE.clear()
+    db = goals._get_session_db()
+    assert db is not None
+    kind = request.param
+    if kind == 'goal':
+        state = goals.GoalState(goal='Finish the approved artifact', max_turns=7, turns_used=3)
+        migrate = goals.migrate_goal_to_session
+    elif kind == 'heartbeat':
+        state = heartbeat.HeartbeatState(prompt='Track approved work', interval_seconds=600, fire_count=3)
+        migrate = heartbeat.migrate_heartbeat_to_session
+    else:
+        state = loops.LoopState(prompt='Track approved work', max_ticks=7, ticks_fired=3,
+                                next_due_at=12345, awaiting_response=True)
+        migrate = loops.migrate_loop_to_session
+    old, new = kind + ':parent', kind + ':child'
+    raw = state.to_json()
+    db.set_meta(old, raw)
+    yield db, old, new, raw, migrate
+    goals._DB_CACHE.clear()
+
+
+def _reject(db, key):
+    for verb in ['INSERT', 'UPDATE']:
+        db._write_sql(
+            f'CREATE TRIGGER refuse_{verb.lower()} BEFORE {verb} ON state_meta WHEN NEW.key = '
+            + "'" + key + "' BEGIN SELECT RAISE(ABORT, 'fixture refused metadata write'); END"
+        )
+
+
+def test_failed_child_write_keeps_the_parent_and_reports_failure(control):
+    db, old, new, raw, migrate = control
+    _reject(db, new)
+    result = migrate('parent', 'child')
+    assert db.get_meta(old) == raw
+    assert db.get_meta(new) is None
+    assert result is False
+
+
+def test_failed_parent_archive_rolls_back_the_child_copy(control):
+    db, old, new, raw, migrate = control
+    _reject(db, old)
+    assert migrate('parent', 'child') is False
+    assert db.get_meta(old) == raw
+    assert db.get_meta(new) is None
+
+
+@pytest.mark.parametrize('destination', ['{invalid', '{"status":"cleared"}'])
+def test_any_existing_child_metadata_is_preserved(control, destination):
+    db, old, new, raw, migrate = control
+    db.set_meta(new, destination)
+    assert migrate('parent', 'child') is False
+    assert db.get_meta(old) == raw
+    assert db.get_meta(new) == destination
+
+
+@pytest.mark.parametrize('status', ['active', 'paused', 'done'])
+def test_committed_transfer_preserves_the_exact_child_state_and_only_clears_parent(control, status):
+    db, old, new, raw, migrate = control
+    data = json.loads(raw)
+    data.update(status=status, future_extension={'checkpoint': 'keep'})
+    raw = json.dumps(data)
+    db.set_meta(old, raw)
+    assert migrate('parent', 'child') is True
+    assert db.get_meta(new) == raw
+    data['status'] = 'cleared'
+    assert json.loads(db.get_meta(old)) == data
+    assert migrate('parent', 'child') is False
+    assert db.get_meta(new) == raw
+
+
+def test_cleared_source_is_not_revived(control):
+    db, old, new, raw, migrate = control
+    data = json.loads(raw)
+    data['status'] = 'cleared'
+    raw = json.dumps(data)
+    db.set_meta(old, raw)
+    assert migrate('parent', 'child') is False
+    assert db.get_meta(old) == raw and db.get_meta(new) is None
+
+
+def test_competing_continuations_do_not_duplicate_the_control(control, monkeypatch):
+    db, old, _new, raw, migrate = control
+    write = db._execute_write
+    barrier = threading.Barrier(2)
+    entered = threading.local()
+
+    def simultaneous(fn, *args, **kwargs):
+        if not getattr(entered, 'once', False):
+            entered.once = True
+            barrier.wait(timeout=10)
+        return write(fn, *args, **kwargs)
+
+    monkeypatch.setattr(db, '_execute_write', simultaneous)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(lambda child: migrate('parent', child), ['child', 'other-child']))
+    assert sorted(results) == [False, True]
+    prefix = old.split(':')[0] + ':'
+    children = [db.get_meta(prefix + sid) for sid in ['child', 'other-child']]
+    assert sum(value is not None for value in children) == 1
+    assert raw in children
+    assert json.loads(db.get_meta(old))['status'] == 'cleared'
+
+
+def test_profile_binding_does_not_move_another_profiles_state(control, tmp_path, monkeypatch):
+    original_db, old, new, raw, migrate = control
+    other_home = tmp_path / 'other-profile'
+    other_home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(other_home))
+    other_db = goals._get_session_db()
+    assert other_db is not original_db
+    data = json.loads(raw)
+    data['status'] = 'paused'
+    other_raw = json.dumps(data)
+    other_db.set_meta(old, other_raw)
+    assert migrate('parent', 'child') is True
+    assert other_db.get_meta(new) == other_raw
+    assert original_db.get_meta(old) == raw and original_db.get_meta(new) is None
