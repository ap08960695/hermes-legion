new file mode 100644
index 0000000000000000000000000000000000000000..5afd434cbe6d95fa9ce102da5b03e93594e452bc
--- /dev/null
+++ b/hermes_cli/account_usage_report.py
@@ -0,0 +1,199 @@
+"""Read-only per-account quota report, plus sanitized external adapter snapshots."""
+
+from __future__ import annotations
+
+from datetime import datetime, UTC
+import hashlib
+import json
+import math
+
+from agent.account_usage import fetch_account_usage
+from agent.account_usage_cache import (
+    _identity_id_for,
+    cached_account_usage,
+    snapshot_is_stale,
+)
+from agent.credential_pool import PooledCredential, STATUS_DEAD
+from hermes_cli.auth import read_credential_pool
+from hermes_constants import get_hermes_home
+
+STALE_SECONDS = 900
+DEFAULT_PROVIDERS = ("anthropic", "openai-codex")
+
+
+def _windows(raw):
+    result = []
+    for window in raw:
+        if not isinstance(window, dict):
+            continue
+        used = window.get("used_percent")
+        if (
+            isinstance(used, bool)
+            or not isinstance(used, (int, float))
+            or not math.isfinite(used)
+        ):
+            continue
+        used = max(0.0, min(100.0, used))
+        result.append(
+            {
+                "label": str(window.get("label") or "Quota"),
+                "used_percent": used,
+                "remaining_percent": round(100 - used, 2),
+                "resets_at": window.get("resets_at"),
+                "scope": "model" if window.get("scope") == "model" else "account",
+            }
+        )
+    return result
+
+
+def _state(windows):
+    if not windows:
+        return "unknown"
+    return (
+        "limited"
+        if any(w["scope"] == "account" and w["used_percent"] >= 100 for w in windows)
+        else "ready"
+    )
+
+
+def _entry_report(provider, entry, identity, *, refresh=True):
+    from hermes_cli.inventory import _pool_entry_route_base_url
+
+    row = {
+        "provider": provider,
+        "id": hashlib.sha256(identity.encode()).hexdigest()[:16],
+        "label": entry.label or entry.id,
+        "state": "unknown",
+        "windows": [],
+        "fetched_at": None,
+        "stale": False,
+        "reason": None,
+    }
+    if entry.last_status == STATUS_DEAD:
+        row.update(
+            state="unavailable",
+            reason="Credential is marked unavailable; it was not queried.",
+        )
+        return row
+    if not entry.runtime_api_key:
+        row["reason"] = "No persisted credential is available; no account was selected."
+        return row
+    route = _pool_entry_route_base_url(provider, entry)
+    snapshot = (
+        fetch_account_usage(
+            provider,
+            base_url=route,
+            api_key=entry.runtime_api_key,
+            read_only=True,
+            identity_id=identity,
+        )
+        if refresh
+        else cached_account_usage(provider, identity_id=identity, base_url=route)
+    )
+    if snapshot is None:
+        row["reason"] = "Usage unavailable; no refresh or account rotation attempted."
+        return row
+    row["fetched_at"] = snapshot.fetched_at.isoformat()
+    if snapshot_is_stale(snapshot):
+        row.update(
+            stale=True, reason="The previous usage reading is stale. Refresh usage."
+        )
+        return row
+    row["windows"] = _windows(
+        [
+            {
+                "label": w.label,
+                "used_percent": w.used_percent,
+                "scope": w.scope,
+                "resets_at": w.reset_at.isoformat() if w.reset_at else None,
+            }
+            for w in snapshot.windows
+        ]
+    )
+    row["state"] = _state(row["windows"])
+    row["reason"] = snapshot.unavailable_reason
+    return row
+
+
+def collect_accounts(provider=None, *, refresh=True, refresh_external=True):
+    """Inspect persisted rows, never load_pool/select/refresh/rotate a credential."""
+    from hermes_cli.inventory import _pool_entry_host
+
+    if refresh and refresh_external and provider in (None, "antigravity-subscription-directsdk"):
+        from hermes_cli.account_usage_native_agy import refresh_native_accounts
+
+        refresh_native_accounts(get_hermes_home())
+
+    pools = read_credential_pool()
+    providers = (provider,) if provider else DEFAULT_PROVIDERS
+    rows, seen = [], set()
+    for slug in providers:
+        for raw in sorted(
+            pools.get(slug, []), key=lambda r: r.get("last_status") == STATUS_DEAD
+        ):
+            entry = PooledCredential.from_dict(slug, raw)
+            identity = _identity_id_for(slug, entry)
+            host = _pool_entry_host(slug, entry)
+            key = (slug, host, identity)
+            if key in seen:
+                continue
+            seen.add(key)
+            row = _entry_report(slug, entry, identity, refresh=refresh)
+            row["id"] = hashlib.sha256(json.dumps(key).encode()).hexdigest()[:16]
+            rows.append(row)
+    rows.extend(load_external_accounts(provider))
+    return sorted(rows, key=lambda r: (r["provider"], r["label"]))
+
+
+def _external_row(raw, now):
+    if not isinstance(raw, dict) or not raw.get("provider") or not raw.get("id"):
+        return None
+    stamp = raw.get("fetched_at")
+    try:
+        age = (now - datetime.fromisoformat(stamp)).total_seconds()
+        stale = age < 0 or age > STALE_SECONDS
+    except (ValueError, TypeError, AttributeError):
+        stale = True
+    windows = _windows(raw.get("windows") or []) if not stale else []
+    return {
+        "provider": str(raw["provider"]),
+        "id": str(raw["id"]),
+        "label": str(raw.get("label") or raw["id"]),
+        "state": _state(windows),
+        "windows": windows,
+        "fetched_at": stamp if isinstance(stamp, str) else None,
+        "stale": stale,
+        "reason": "External observation is stale or has no timestamp."
+        if stale
+        else raw.get("reason"),
+    }
+
+
+def load_external_accounts(provider=None):
+    """External integrations publish only quota observations, never credentials."""
+    path = get_hermes_home() / "state/account-usage/external.json"
+    try:
+        doc = json.loads(path.read_text())
+    except (OSError, ValueError):
+        return []
+    if not isinstance(doc, dict) or not isinstance(doc.get("accounts"), list):
+        return []
+    now = datetime.now(UTC)
+    rows = [_external_row(raw, now) for raw in doc["accounts"]]
+    return [
+        row for row in rows if row and (not provider or row["provider"] == provider)
+    ]
+
+
+def render_accounts(rows):
+    lines = ["Account usage (per login; unknown is not zero usage)"]
+    for row in rows:
+        lines.append(f"\n{row['provider']} / {row['label']} [{row['state']}]")
+        for window in row["windows"]:
+            reset = f"; resets {window['resets_at']}" if window["resets_at"] else ""
+            lines.append(
+                f"  {window['label']}: {window['remaining_percent']:g}% remaining{reset}"
+            )
+        if not row["windows"]:
+            lines.append("  " + (row.get("reason") or "Usage is unknown."))
+    return "\n".join(lines)
