+def test_failed_claim_release_still_closes_agent_and_releases_owned_lease(case, monkeypatch):
+    import sqlite3
+    from hermes_cli.active_sessions import active_session_registry_snapshot
+    _built, calls, closed = _fake(monkeypatch, case)
+    def reopen_failure(*a, **kw): raise RuntimeError('state store unavailable')
+    original = delivery.Claim.mark
+    def release_failure(self, state):
+        if state == 'pending' and self.refs:
+            raise sqlite3.OperationalError('board unavailable during known-unstarted release')
+        return original(self, state)
+    monkeypatch.setattr(SessionDB, 'reopen_session', reopen_failure)
+    monkeypatch.setattr(delivery.Claim, 'mark', release_failure)
+    with pytest.raises(sqlite3.OperationalError): _run(case)
+    assert calls == [] and closed == [True]
