+from hermes_state import SessionDB
+from tools.session_search_tool import _get_session_meta, session_search
+
+
+@pytest.fixture
+def archive(tmp_path):
+    path = tmp_path / "state.db"
+    with SessionDB(path) as db:
+        db.create_session("archive", source="cli", model="offline-test-route",
+                          system_prompt="Synthetic context. " * 32768,
+                          model_config={"private_fixture": "x" * 32768})
+        db.set_session_title("archive", "Quarterly archive review")
+        db.append_message("archive", role="user", content="Remember the deployment checklist")
+        db.append_message("archive", role="assistant", content="Use the verified checklist")
+        db.end_session("archive", "cli_exit")
+        yield db, path
+
+
+def deny_context_reads(action, table, column, *_):
+    if action == sqlite3.SQLITE_READ and (
+        (table == "system_prompts" and column == "prompt")
+        or (table == "sessions" and column in {"system_prompt", "tool_names"})
+    ):
+        return sqlite3.SQLITE_DENY
+    return sqlite3.SQLITE_OK
+
+
+@pytest.mark.parametrize("read_only", [False, True])
+def test_native_search_keeps_metadata_when_context_reads_are_denied(archive, read_only):
+    writer, path = archive
+    db = SessionDB(path, read_only=True) if read_only else writer
+    with db._read_ctx() as connection:
+        connection.set_authorizer(deny_context_reads)
+    try:
+        result = json.loads(session_search(query="Quarterly archive review", db=db))
+        assert result["success"]
+        entry = next(row for row in result["results"] if row["matched_role"] == "session_title")
+        assert entry["source"] == "cli" and entry["model"] == "offline-test-route"
+        assert entry["title"] == "Quarterly archive review"
+        assert entry["messages"][0]["content"] == "Remember the deployment checklist"
+    finally:
+        with db._read_ctx() as connection:
+            connection.set_authorizer(None)
+        if read_only:
+            db.close()
+
+
+def test_native_metadata_is_small_fresh_and_missing_is_none(archive):
+    db, _ = archive
+    assert db.get_session_metadata("absent") is None
+    meta = db.get_session_metadata("archive")
+    assert set(meta) == {"id", "source", "model", "title", "parent_session_id",
+                         "started_at", "ended_at", "end_reason"}
+    assert meta["end_reason"] == "cli_exit" and meta["parent_session_id"] is None
+    db.set_session_title("archive", "Updated archive")
+    assert db.get_session_metadata("archive")["title"] == "Updated archive"
+    assert meta["title"] == "Quarterly archive review"
+
+
+def test_search_metadata_supports_an_older_adapter_without_extension(archive):
+    db, _ = archive
+
+    class LegacyAdapter:
+        def __getattr__(self, name):
+            if name == "get_session_metadata":
+                raise AttributeError(name)
+            return getattr(db, name)
+
+    assert _get_session_meta(LegacyAdapter(), "archive")["title"] == "Quarterly archive review"
+
+
+def test_failed_present_metadata_api_does_not_retry_full_context(archive, monkeypatch):
+    db, _ = archive
+
+    def refused(*args, **kwargs):
+        raise OSError("Synthetic metadata read failure")
+
+    def full_context_must_not_run(*args, **kwargs):
+        pytest.fail("A failed metadata read must not retry the full context reader")
+
