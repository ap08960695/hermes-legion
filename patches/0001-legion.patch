+from pathlib import Path
+import pytest
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli.kanban_task_contract import lane_rows
+
+
+@pytest.fixture
+def board(tmp_path,monkeypatch):
