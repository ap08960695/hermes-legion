@@ -0,0 +1,83 @@
+"""Immutable policy for the existing native agent-browser command path."""
+from dataclasses import dataclass
+from pathlib import Path
+import re
+from urllib.parse import urlsplit
+
+IMAGES_JS = "JSON.stringify([...document.images].map(img => ({src: img.src, alt: img.alt || '', width: img.naturalWidth, height: img.naturalHeight})).filter(img => img.src && !img.src.startsWith('data:')))"
+_ENV_KEYS = frozenset({'PATH', 'LANG', 'LC_ALL', 'LC_CTYPE', 'SYSTEMROOT', 'WINDIR', 'COMSPEC', 'PATHEXT'})
+
+@dataclass(frozen=True)
+class IsolatedBrowserInvocation:
+    profile_home: str
+    task_id: str
+    session_name: str
+    root: str
+    agent_browser: str
+    chromium: str
+    base_env: tuple = ()
+    trusted_spki: tuple = ()   # local patch 14: SHA-256 SPKI pins (base64) of private roots, e.g. GSB SIT/UAT
+
+    def __post_init__(self):
+        for value in (self.profile_home, self.root, self.agent_browser, self.chromium):
+            if not isinstance(value, str) or not Path(value).is_absolute() or '..' in Path(value).parts:
+                raise PermissionError('Absolute owner-supplied paths required')
+        if not self.task_id or not re.fullmatch(r'rg_[a-zA-Z0-9_]+', self.session_name):
+            raise PermissionError('Owned task/session identity required')
+        if type(self.base_env) is not tuple or any(type(item) is not tuple or len(item) != 2 or
+                not all(isinstance(part, str) for part in item) for item in self.base_env):
+            raise PermissionError('Immutable environment required')
+        object.__setattr__(self, 'base_env', tuple((k, v) for k, v in self.base_env if k in _ENV_KEYS))
+        if type(self.trusted_spki) is not tuple or any(
+                not isinstance(pin, str) or not re.fullmatch(r'[A-Za-z0-9+/]{43}=', pin) for pin in self.trusted_spki):
+            raise PermissionError('trusted_spki must be base64 SHA-256 SPKI pins')
+
+    @property
+    def socket_dir(self):
+        return self.root + '/socket'
+
+    def environment(self):
+        env = dict(self.base_env)
+        home = str(Path(self.root) / 'home')
+        env.update(HOME=home, USERPROFILE=home, APPDATA=home, LOCALAPPDATA=home,
+                   XDG_CONFIG_HOME=home, XDG_DATA_HOME=home, XDG_CACHE_HOME=home,
+                   TMPDIR=self.root, TMP=self.root, TEMP=self.root,
+                   HERMES_HOME=self.profile_home, AGENT_BROWSER_SESSION=self.session_name,
+                   AGENT_BROWSER_SOCKET_DIR=self.socket_dir,
+                   AGENT_BROWSER_PROFILE=str(Path(self.root) / 'profile'),
+                   AGENT_BROWSER_CONFIG=str(Path(self.root) / 'config.json'),
+                   AGENT_BROWSER_EXECUTABLE_PATH=self.chromium,
+                   AGENT_BROWSER_HEADED='false', AGENT_BROWSER_AUTO_CONNECT='false',
+                   AGENT_BROWSER_IGNORE_HTTPS_ERRORS='false',
+                   AGENT_BROWSER_ARGS=('--ignore-certificate-errors-spki-list=' + ','.join(self.trusted_spki)
+                                       if self.trusted_spki else ''),
+                   NODE_TLS_REJECT_UNAUTHORIZED='1', AGENT_BROWSER_IDLE_TIMEOUT_MS='60000')
+        return env
+
+    def validate(self, home, task_id):
+        if str(home) != self.profile_home or task_id != self.task_id:
+            raise PermissionError('Cross-profile/task isolated browser invocation')
+
+
+def validate_command(command, args):
+    if not isinstance(args, list) or any(not isinstance(a, str) or len(a) > 16000 for a in args):
+        raise PermissionError('Invalid ordinary browser arguments')
+    simple = {'back': ([],), 'close': ([],), 'snapshot': ([], ['-c']),
+              'console': ([], ['--clear']), 'errors': ([], ['--clear']),
+              'scroll': (['up'], ['down']), 'dialog': (['accept'], ['dismiss'])}
+    if command in simple and args in simple[command]:
+        return
+    if command == 'dialog' and len(args) == 2 and args[0] == 'accept':
+        return
+    if command == 'eval' and args == [IMAGES_JS]:
+        return
+    if command == 'open' and len(args) == 1:
+        url = urlsplit(args[0])
+        if url.scheme in {'https', 'http'} and url.hostname and not url.username and not url.password and not any(
+                ord(c) < 33 or ord(c) == 127 or c == '\\' for c in args[0]):
+            return
+    if command in {'click', 'fill'} and len(args) == (1 if command == 'click' else 2) and re.fullmatch(r'@e[0-9]+', args[0]):
+        return
+    if command == 'press' and len(args) == 1 and 0 < len(args[0]) <= 64 and not args[0].startswith('-'):
+        return
+    raise PermissionError('Unsupported or unsafe browser command')
