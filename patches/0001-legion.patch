@@ -0,0 +1,113 @@
+"""Subscription-only small-model routes for prompt prediction; no key/API fallback."""
+
+import httpx
+
+
+def subscription_credential(provider: str) -> str:
+    from agent.credential_pool import PooledCredential
+    from agent.anthropic_credentials import _is_oauth_token
+    from hermes_cli.auth import read_credential_pool
+
+    for row in read_credential_pool().get(provider, []):
+        if row.get("last_status") == "dead":
+            continue
+        entry = PooledCredential.from_dict(provider, row)
+        key = entry.runtime_api_key
+        oauth = (
+            _is_oauth_token(key)
+            if provider == "anthropic"
+            else entry.auth_type == "oauth" and key.startswith("eyJ")
+        )
+        if oauth:
+            return key
+    return ""
+
+
+def _completed(text):
+    return {"choices": [{"finish_reason": "stop", "message": {"content": text}}]}
+
+
+def _claude(model, credential, instructions, user_input, timeout):
+    from hermes_cli.prompt_suggestion_http import request_payload
+    from agent.anthropic_adapter import (
+        build_anthropic_kwargs,
+        _common_betas_for_base_url,
+        _OAUTH_ONLY_BETAS,
+    )
+
+    base = "https://api.anthropic.com"
+    body = build_anthropic_kwargs(
+        model=model,
+        messages=[
+            {"role": "system", "content": instructions},
+            {"role": "user", "content": user_input},
+        ],
+        tools=None,
+        max_tokens=128,
+        reasoning_config={"enabled": False},
+        is_oauth=True,
+        base_url=base,
+    )
+    headers = {
+        "Authorization": "Bearer " + credential,
+        "anthropic-version": "2023-06-01",
+        "anthropic-beta": ",".join(
+            _common_betas_for_base_url(base) + _OAUTH_ONLY_BETAS
+        ),
+        "User-Agent": "HermesAgent/prompt-suggestions",
+    }
+    headers.update(body.pop("extra_headers", {}))
+    body.update(body.pop("extra_body", {}))
+    status, data = request_payload(
+        base + "/v1/messages", headers=headers, payload=body, timeout=timeout
+    )
+    if status != 200:
+        return None, 900 if status in {401, 403, 429} else 60
+    if data.get("stop_reason") != "end_turn":
+        return None, 60
+    return _completed(
+        "".join(p.get("text", "") for p in data.get("content", []) if p.get("type") == "text")
+    ), 0
+
+
+def _gpt(model, credential, instructions, user_input, timeout):
+    from agent.codex_headers import codex_cloudflare_headers
+    from hermes_cli.prompt_suggestion_http import request_payload
+
+    base = "https://chatgpt.com/backend-api/codex"
+    headers = {
+        **codex_cloudflare_headers(credential, base_url=base),
+        "Authorization": "Bearer " + credential,
+    }
+    body = {
+        "model": model,
+        "instructions": instructions,
+        "input": [
+            {"role": "user", "content": [{"type": "input_text", "text": user_input}]}
+        ],
+        "reasoning": {"effort": "low"},
+        "text": {"verbosity": "low"},
+        "stream": True,
+        "store": False,
+    }
+    status, text = request_payload(
+        base + "/responses", headers=headers, payload=body, timeout=timeout, stream_text=True
+    )
+    if status != 200:
+        return None, 900 if status in {401, 403, 429} else 60
+    return (_completed(text), 0) if text is not None else (None, 60)
+
+
+def query_subscription(provider, model, credential, instructions, user_input, timeout):
+    # The endpoint and model are fixed; arbitrary paid API routes are unreachable.
+    handlers = {
+        ("anthropic", "claude-haiku-5-5"): _claude,
+        ("openai-codex", "gpt-6-luna"): _gpt,
+    }
+    handler = handlers.get((provider, model))
+    if handler is None:
+        return None, 900
+    try:
+        return handler(model, credential, instructions, user_input, timeout)
+    except (httpx.RequestError, TimeoutError, ValueError, TypeError, ImportError):
+        return None, 60
