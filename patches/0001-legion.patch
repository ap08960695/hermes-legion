+"""Committed native events wake the existing gateway loop without an extra worker."""
+import asyncio
+import shutil
+import tempfile
+from pathlib import Path
+
+import pytest
+
+from gateway import kanban_watchers as watchers
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_dispatch as kbd
+
+
+@pytest.mark.platforms('linux', 'macos')
+@pytest.mark.asyncio
+async def test_native_ready_commit_triggers_existing_loop_before_periodic_timeout(tmp_path, monkeypatch):
+    home = Path(tempfile.mkdtemp(prefix='hgw-'))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(home))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    conn = kbc.connect()
+    runner = watchers.GatewayKanbanWatchersMixin()
+    runner._running = True
+    ticks = []
+
+    class Dispatcher:
+        def __init__(self, *args):
+            pass
+
+        def tick_once(self):
+            ticks.append(1)
+            if len(ticks) == 1:
+                kb.create_task(conn, title='local event fixture')
+            else:
+                runner._running = False
+            return []
+
+        def ready_nonempty(self):
+            return False
+
+    async def inline(fn, *args, **kwargs):
+        return fn(*args, **kwargs)
+
+    original_sleep = asyncio.sleep
+
+    async def skip_boot_delay(delay):
+        if delay != 5:
+            await original_sleep(delay)
+
+    monkeypatch.setattr(runner, '_kanban_dispatcher_boot', lambda: (lambda: {}, kb, {'dispatch_interval_seconds': 30}))
+    monkeypatch.setattr(runner, '_owns_kanban_dispatcher_lock', lambda: True)
+    monkeypatch.setattr(watchers, '_KanbanDispatcher', Dispatcher)
+    monkeypatch.setattr(watchers, '_kanban_dispatch_allowed', lambda: True)
+    monkeypatch.setattr(watchers, '_resolve_auto_decompose_settings', lambda _: (False, 0))
+    monkeypatch.setattr(watchers, '_to_thread_process_service', inline)
+    monkeypatch.setattr(kbd, 'reap_worker_zombies', lambda: [])
+    monkeypatch.setattr(asyncio, 'sleep', skip_boot_delay)
+    try:
+        await asyncio.wait_for(runner._kanban_dispatcher_watcher(), 5)
+        assert len(ticks) == 2
+        assert not (home / 'kanban' / '.dispatcher.wake.sock').exists()
+    finally:
+        conn.close()
+        shutil.rmtree(home)
