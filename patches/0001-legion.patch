+import { Button } from '@/components/ui/button'
+import { SidebarSessionSkeletons } from './section-states'
+import { useFocusCopy } from '@/app/focus/copy'
+export function SessionSearchFeedback({ failed, onRetry }: { failed: boolean; onRetry: () => void }) {
+  const t = useFocusCopy()
+  if (!failed) return null
+  return (
+    <div role="alert" className="px-2 py-2 text-xs text-(--ui-text-tertiary)">
+      <p>{t('sessionSearchError')}</p>
+      <Button size="sm" variant="ghost" onClick={onRetry}>
+        {t('retrySearch')}
+      </Button>
+    </div>
+  )
+}
+
+export function SessionSearchEmptyState({
+  pending,
+  failed,
+  noMatch
+}: {
+  pending: boolean
+  failed: boolean
+  noMatch: string
+}) {
+  if (pending) return <SidebarSessionSkeletons />
+  if (failed) return null
+  return (
+    <div className="wrap-anywhere grid min-h-24 place-items-center rounded-lg px-2 text-center text-xs text-(--ui-text-tertiary)">
+      {noMatch}
+    </div>
+  )
+}
