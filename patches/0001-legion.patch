-"""Scratch-dir retention: idle detection plus the reaping an idle tree needs before it goes.
+"""Scratch retention preserves active and resumable work, even when its mtime is old.
 
-Deleting an idle ``cache/scratch/<entry>`` is not enough on its own: a lane's e2e run leaves
-headless browsers whose cwd was inside the tree (they survived for days with a ``(deleted)``
-cwd), and a repo whose linked worktree lived in the tree keeps a dangling registration until
-someone runs ``git worktree prune``. Both are reaped here, right before ``rmtree``.
+Explicit process/worktree reaping helpers remain available for operator-directed
+cleanup; automatic age-based retention never signals a process.
 """
 from __future__ import annotations
 
@@ -26,6 +24,9 @@ _GIT_FILE_MAX_DEPTH = 4
 # fixed rotation as tool_calls.log.
 _PRUNE_LOG_MAX_BYTES = 5 * 1024 * 1024
 _PRUNE_LOG_BACKUPS = 3
+_RESUME_MARKERS = frozenset({".git", ".keep", "pyvenv.cfg", ".venv", "venv",
+                             "package.json", "pyproject.toml", "Cargo.toml"})
+_RESUME_SCAN_MAX_ENTRIES = 4096
 # Paths and process names go in with %r: a control character (a newline in a legal POSIX name)
 # is written escaped, so it cannot split a record or forge one.
 
@@ -128,6 +129,84 @@ def _under(path: str, root: str) -> bool:
     return path == root or path.startswith(root.rstrip(os.sep) + os.sep)
 
 
+def _resumable_entry(entry: Path) -> bool:
+    """Keep worktrees, environments and explicit keep markers. Incomplete scans keep data."""
+    try:
+        if entry.is_symlink() or entry.name in _RESUME_MARKERS:
+            return True
+        if not entry.is_dir():
+            return False
+        stack = [(entry, 0)]
+        seen = 0
+        while stack:
+            current, depth = stack.pop()
+            with os.scandir(current) as children:
+                for child in children:
+                    if child.name in _RESUME_MARKERS:
+                        return True
+                    seen += 1
+                    if seen > _RESUME_SCAN_MAX_ENTRIES:
+                        return True
+                    if child.is_dir(follow_symlinks=False):
+                        if depth >= _GIT_FILE_MAX_DEPTH:
+                            return True
+                        stack.append((Path(child.path), depth + 1))
+    except OSError:
+        return True
+    return False
+
+
+def _active_scratch_paths(root: Path) -> set[str] | None:
+    """Same-user process paths under root; None means ownership could not be observed.
+
+    Include this process and ancestors: age must not remove the caller's cwd.
+    Unknown ownership defers deletion, rather than treating a failed probe as idle.
+    """
+    try:
+        import psutil
+    except ImportError:
+        logger.debug("scratch prune deferred: process inspector is unavailable")
+        return None
+    try:
+        root_path = os.path.realpath(root)
+        uid = os.getuid() if hasattr(os, "getuid") else None
+        username = psutil.Process().username() if uid is None else None
+        active: set[str] = set()
+        for proc in psutil.process_iter():
+            try:
+                if uid is not None:
+                    if proc.uids().real != uid:
+                        continue
+                elif proc.username() != username:
+                    continue
+                if proc.status() == psutil.STATUS_ZOMBIE:
+                    continue
+                cwd = proc.cwd()
+                paths = [cwd, proc.exe(), *(f.path for f in proc.open_files())]
+                for arg in proc.cmdline():
+                    value = arg.split("=", 1)[-1] if arg.startswith("-") and "=" in arg else arg
+                    if os.path.isabs(value):
+                        paths.append(value)
+                    elif root_path in arg:
