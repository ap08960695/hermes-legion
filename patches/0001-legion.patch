+"""Content-free native run attribution at the actual diagnostic boundary."""
+import json
+import logging
+from types import SimpleNamespace
+
+import pytest
+
+
+def pin(monkeypatch, tmp_path):
+    board=tmp_path/'board.db'
+    monkeypatch.setenv('HERMES_KANBAN_DB',str(board))
+    monkeypatch.setenv('HERMES_KANBAN_TASK','t_1234abcd')
+    monkeypatch.setenv('HERMES_KANBAN_RUN_ID','7')
+    monkeypatch.setenv('HERMES_KANBAN_CLAIM_LOCK','PRIVATE_CLAIM')
+    monkeypatch.delenv('HERMES_DELEGATED_CHILD_CONTEXT',raising=False)
+    return board
+
+
+def test_binding_is_scoped_and_contains_no_identifiers(monkeypatch,tmp_path):
+    from agent.usage_run_binding import snapshot,run_digest
+    board=pin(monkeypatch,tmp_path)
+    row=snapshot(b'k'*32)
+    assert row['hash']==run_digest(b'k'*32,board,'t_1234abcd',7)
+    assert row['complete'] is True
+    assert all(value not in json.dumps(row) for value in ('t_1234abcd','PRIVATE_CLAIM',str(board)))
+    assert row['hash']!=run_digest(b'x'*32,board,'t_1234abcd',7)
+    assert row['hash']!=run_digest(b'k'*32,board,'t_1234abcd',8)
+    assert row['hash']!=run_digest(b'k'*32,tmp_path/'other.db','t_1234abcd',7)
+
+
+def test_child_cron_and_malformed_identity_are_unbound(monkeypatch,tmp_path):
+    from agent.usage_run_binding import snapshot
+    from agent.delegation_context import non_dispatcher_owned_context,delegated_child_context
+    pin(monkeypatch,tmp_path)
+    for context in (non_dispatcher_owned_context(),delegated_child_context()):
+        with context:assert snapshot(b'k'*32)['status']=='not_dispatcher_owned'
+    monkeypatch.setenv('HERMES_KANBAN_RUN_ID','7 SECRET')
+    assert snapshot(b'k'*32)['status']=='unbound'
+    monkeypatch.setenv('HERMES_KANBAN_RUN_ID','7')
+    monkeypatch.setenv('HERMES_KANBAN_DB','relative.db')
+    assert snapshot(b'k'*32)['status']=='unbound'
+
+
+def test_real_observer_binds_before_call_and_preserves_failure(monkeypatch,tmp_path,caplog):
+    from agent import cache_request_diagnostics as diag
+    from agent.usage_run_binding import run_digest
+    board=pin(monkeypatch,tmp_path)
+    monkeypatch.setattr(diag,'_profile_key',lambda:b'k'*32)
+    failure=RuntimeError('PRIVATE_FAILURE');calls=[]
+    def send(request):
+        calls.append(request)
+        monkeypatch.setenv('HERMES_KANBAN_RUN_ID','8')
+        raise failure
+    agent=SimpleNamespace(api_mode='chat_completions',session_id='PRIVATE_SESSION',base_url='PRIVATE_URL')
+    request={'model':'offline','messages':[{'role':'user','content':'PRIVATE_PROMPT'}]}
+    with caplog.at_level(logging.INFO),pytest.raises(RuntimeError) as exc:
+        diag.observe_call(agent,request,send,request_id='PRIVATE_REQUEST')
+    rows=[json.loads(r.message.split('CACHE_DIAGNOSTIC ',1)[1]) for r in caplog.records if r.message.startswith('CACHE_DIAGNOSTIC ')]
+    assert exc.value is failure and len(calls)==1 and len(rows)==1
+    assert rows[0]['fingerprint']['task_run']['hash']==run_digest(b'k'*32,board,'t_1234abcd',7)
+    assert 'PRIVATE_' not in json.dumps(rows)
+
+
+def test_binding_failure_cannot_retry_transport(monkeypatch,tmp_path,caplog):
+    from agent import cache_request_diagnostics as diag,usage_run_binding
+    pin(monkeypatch,tmp_path)
+    def broken(key):raise ValueError('PRIVATE_BINDING_FAILURE')
+    monkeypatch.setattr(usage_run_binding,'snapshot',broken)
+    calls=[];answer=object()
+    def send(request):calls.append(request);return answer
+    with caplog.at_level(logging.INFO):
+        assert diag.observe_call(SimpleNamespace(api_mode='chat_completions',session_id='',base_url=''),{},send,request_id='r') is answer
+    assert len(calls)==1 and 'PRIVATE_BINDING_FAILURE' not in caplog.text
