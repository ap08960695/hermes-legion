+++ b/tui_gateway/session_kanban_lineage.py
@@ -0,0 +1,76 @@
+"""Resolve notification destinations in the owning store, without retargeting receipts."""
+from __future__ import annotations
+
+import contextlib
+from pathlib import Path
+import sqlite3
+
+
+@contextlib.contextmanager
+def _reader(session: dict):
+    from tui_gateway import server as s
+    if not session.get('profile_home'):
+        yield s._get_db()
+        return
+    from hermes_state import SessionDB
+    path = Path(session['profile_home']) / 'state.db'
+    if not path.is_file():
+        yield None
+        return
+    # Routing is a read, not a resume. Opening a full profile writer runs schema /
+    # housekeeping work on every poll and needlessly contends with the active agent.
+    with contextlib.closing(SessionDB(path, read_only=True)) as db:
+        yield db
+
+
+def destination_keys(session: dict, candidates) -> set[str]:
+    """Only the selected compression tip may consume an ancestor's work.
+
+    The canonical store resolver excludes branches/delegates/resets. Missing legacy
+    stores retain exact-key delivery only; lookup errors never broaden authority.
+    """
+    from tui_gateway import server as s
+    current = str(session.get('session_key') or '')
+    wanted = {str(key) for key in candidates if key}
+    exact = wanted & {current}
+    if not current or not wanted:
+        return set()
+    try:
+        with _reader(session) as db:
+            if db is None or not callable(getattr(db, 'get_compression_tip', None)):
+                return exact
+            reader = getattr(db, 'get_session_metadata', None)
+            if not callable(reader):
+                reader = db.get_session
+            if not reader(current):
+                return exact
+            if db.get_compression_tip(current) != current:
+                return set()  # A stale parent runtime must leave work for the continuation.
+            return {key for key in wanted if key == current
+                    or reader(key) and db.get_compression_tip(key) == current}
+    except (OSError, sqlite3.Error, RuntimeError, ValueError):
+        s.logger.exception('Kanban destination lineage could not be verified')
+        return set()
+
+
+def subscriptions(session: dict, rows: list[dict]) -> list[dict]:
+    """Legacy exact keys keep their contract; ancestor routes need a stamped owner."""
+    from hermes_cli.profiles import current_profile_name
+    current = str(session.get('session_key') or '')
+    profile = current_profile_name('default')
+    candidates = [row for row in rows if (row.get('platform') or '').lower() == 'tui'
+                  and (row.get('chat_id') == current or row.get('notifier_profile') == profile)]
+    accepted = destination_keys(session, (row.get('chat_id') for row in candidates))
+    return [row for row in candidates if row.get('chat_id') in accepted]
+
+
+def has_destination(path: Path, session: dict) -> bool:
+    """A foreign session must never open a board writable just to discover no route."""
+    if not path.is_file():
+        return False
+    with contextlib.closing(sqlite3.connect(path.resolve().as_uri() + '?mode=ro', uri=True)) as conn:
+        conn.row_factory = sqlite3.Row
+        if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='kanban_notify_subs'").fetchone():
+            return False
+        rows = [dict(row) for row in conn.execute("SELECT * FROM kanban_notify_subs WHERE LOWER(platform)='tui'")]
+    return bool(subscriptions(session, rows))
