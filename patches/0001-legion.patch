new file mode 100644
index 0000000000000000000000000000000000000000..af15d905c7e8b2cc526192fcf6b940cb8f9fde12
--- /dev/null
+++ b/agent/usage_run_binding.py
@@ -0,0 +1,42 @@
+"""Content-free run binding using existing dispatcher pins and diagnostic keys.
+
+This is observational provenance, never claim authority or permission to retry work.
+"""
+import hashlib
+import hmac
+import json
+import os
+from pathlib import Path
+import re
+import stat
+
+
+def key_id(key):
+    return hmac.new(key,b'hermes-cache-diagnostics-v1',hashlib.sha256).hexdigest()[:16]
+
+
+def run_digest(key,board,task,run):
+    data=json.dumps(['kanban-usage-v1',str(Path(board).resolve()),task,int(run)],separators=(',',':')).encode()
+    return hmac.new(key,data,hashlib.sha256).hexdigest()
+
+
+def snapshot(key):
+    from agent.delegation_context import is_dispatcher_owned_worker_context,owned_kanban_task
+    if not is_dispatcher_owned_worker_context():return {'complete':False,'status':'not_dispatcher_owned'}
+    task=owned_kanban_task();run=os.environ.get('HERMES_KANBAN_RUN_ID','');board=os.environ.get('HERMES_KANBAN_DB','')
+    if not (re.fullmatch(r't_[a-zA-Z0-9_-]{1,128}',task) and re.fullmatch(r'[1-9][0-9]{0,18}',run) and board and Path(board).is_absolute()):
+        return {'complete':False,'status':'unbound'}
+    return {'version':1,'complete':True,'status':'dispatcher_pinned','hash':run_digest(key,board,task,run)}
+
+
+def existing_key(home):
+    """Read a safe existing key only: never mkdir, create, rotate or expose its bytes."""
+    path=Path(home)/'telemetry/cache-diagnostics/fingerprint.key'
+    fd=os.open(path,os.O_RDONLY|getattr(os,'O_NOFOLLOW',0)|getattr(os,'O_NONBLOCK',0))
+    with os.fdopen(fd,'rb') as stream:
+        info=os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_mode&0o077 or info.st_uid!=os.getuid():
+            raise ValueError('unsafe existing diagnostic key')
+        key=stream.read(33)
+    if len(key)!=32:raise ValueError('incomplete existing diagnostic key')
+    return key
