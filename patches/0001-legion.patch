+"""Local document bytes need no shell; bounded reads must remain safe."""
+import base64
+import os
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from tools.file_operations import ShellFileOperations
+from tools.file_operations_common import ExecuteResult
+from tools.environments.local import LocalEnvironment
+
+pytestmark = pytest.mark.platforms('linux', 'macos')
+
+
+@pytest.fixture
+def ops(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_NATIVE_FILE_READ', '1')
+    result = ShellFileOperations(LocalEnvironment(cwd=str(tmp_path)), cwd=str(tmp_path))
+    monkeypatch.setattr(result, '_exec', Mock(wraps=result._exec))
+    return result
+
+
+@pytest.mark.parametrize('content', [b'', bytes(range(256)), b'header\x00\xff\n' * 1000], ids=['empty', 'all-bytes', 'binary-lines'])
+def test_exact_local_bytes_without_shell(ops, tmp_path, content):
+    path = tmp_path / 'document.bin'
+    path.write_bytes(content)
+    result = ops.read_file_bytes(str(path), max_bytes=len(content))
+    assert result.error is None
+    assert base64.b64decode(result.base64_content, validate=True) == content
+    assert result.file_size == len(content)
+    assert result.is_binary
+    assert ops._exec.call_count == 0
+
+
+def test_live_cwd(ops, tmp_path):
+    (tmp_path / 'same.bin').write_bytes(b'old')
+    other = tmp_path / 'next'; other.mkdir()
+    (other / 'same.bin').write_bytes(b'new')
+    ops.env.cwd = str(other)
+    result = ops.read_file_bytes('same.bin')
+    assert base64.b64decode(result.base64_content) == b'new'
+    assert ops._exec.call_count == 0
+
+
+def test_cap_is_enforced(ops, tmp_path):
+    path = tmp_path / 'large.bin'; path.write_bytes(b'12345')
+    result = ops.read_file_bytes(str(path), max_bytes=4)
+    assert 'too large' in result.error.lower()
+    assert result.base64_content is None
+    assert ops._exec.call_count == 0
+
+
+def test_missing_and_non_regular(ops, tmp_path):
+    absent = ops.read_file_bytes(str(tmp_path / 'absent'))
+    assert absent.not_found and absent.error
+    for path in [tmp_path, tmp_path / 'pipe', tmp_path / 'dangling']:
+        if path.name == 'pipe': os.mkfifo(path)
+        if path.name == 'dangling': path.symlink_to(tmp_path / 'absent')
+        result = ops.read_file_bytes(str(path))
+        assert result.error and not result.not_found
+        assert result.base64_content is None
+    assert ops._exec.call_count == 0
+
+
+def test_native_opt_out_keeps_shell(ops, tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_NATIVE_FILE_READ', '0')
+    path = tmp_path / 'document.bin'; path.write_bytes(b'payload')
+    result = ops.read_file_bytes(str(path))
+    assert base64.b64decode(result.base64_content) == b'payload'
+    assert ops._exec.call_count > 0
+
+
+def test_remote_backend_never_reads_host_file(tmp_path, monkeypatch):
+    path = tmp_path / 'same.bin'; path.write_bytes(b'HOST')
+    remote = ShellFileOperations(SimpleNamespace(cwd=str(tmp_path)))
+    monkeypatch.setattr(remote, '_probe_regular_file', lambda path: (6, 'ok'))
+    monkeypatch.setattr(remote, '_exec', lambda command: ExecuteResult(stdout=base64.b64encode(b'REMOTE').decode(), exit_code=0))
+    assert base64.b64decode(remote.read_file_bytes(str(path)).base64_content) == b'REMOTE'
+
+
+def test_growth_after_stat_still_obeys_cap(ops, tmp_path, monkeypatch):
+    path = tmp_path / 'growing.bin'; path.write_bytes(b'12345')
+    original = os.fstat
+    def grow(fd):
+        result = original(fd)
+        with path.open('ab') as output: output.write(b'X' * 20)
+        return result
+    monkeypatch.setattr(os, 'fstat', grow)
+    result = ops.read_file_bytes(str(path), max_bytes=10)
+    assert result.error and 'too large' in result.error.lower()
+    assert result.base64_content is None
+
+
+def test_unreadable_returns_error_without_shell_retry(ops, tmp_path, monkeypatch):
+    path = tmp_path / 'private.bin'; path.write_bytes(b'content')
+    def denied(*args, **kwargs): raise PermissionError('fixture access denied')
+    monkeypatch.setattr(os, 'open', denied)
+    result = ops.read_file_bytes(str(path))
+    assert result.error and result.base64_content is None
+    assert ops._exec.call_count == 0
+
+
+def test_missing_working_directory_is_not_reported_as_missing_file(ops, tmp_path):
+    path = tmp_path / 'exists.bin'; path.write_bytes(b'content')
+    ops.env.cwd = str(tmp_path / 'removed-workspace')
+    result = ops.read_file_bytes(str(path))
+    assert result.error and 'environment unavailable' in result.error.lower()
+    assert not result.not_found and result.base64_content is None
+    assert ops._exec.call_count == 0
+
+
+def test_regular_symlink_still_follows_target(ops, tmp_path):
+    path = tmp_path / 'target.bin'; path.write_bytes(b'original bytes')
+    link = tmp_path / 'link.bin'; link.symlink_to(path)
+    result = ops.read_file_bytes(str(link))
+    assert base64.b64decode(result.base64_content) == b'original bytes'
+    assert ops._exec.call_count == 0
