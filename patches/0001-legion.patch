+               HERMES_SESSION_THREAD_ID='thread-a')
+    with kbc.connect() as conn:
+        for thread in ('thread-a', 'thread-b'):
+            kbn.add_notify_sub(conn, task_id=tid, platform='slack', chat_id='channel',
+                               thread_id=thread, notifier_profile='captain', delivery_mode='notify+wake')
+    assert json.loads(kt._handle_block({'task_id': tid, 'reason': 'self'}))['ok']
+    with kbc.connect() as conn:
+        # An independent external outcome in the same batch must survive suppression.
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, 'blocked', {'reason': 'worker later asks for help'})
+        args = dict(task_id=tid, platform='slack', chat_id='channel', kinds=['blocked'])
+        own = kbn.claim_unseen_events_for_sub(conn, thread_id='thread-a', **args)[2]
+        other = kbn.claim_unseen_events_for_sub(conn, thread_id='thread-b', **args)[2]
