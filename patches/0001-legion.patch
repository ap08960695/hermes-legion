+"""Repeated extracted pages must not re-convert or re-enter model context."""
+import json
+import zipfile
+from unittest.mock import Mock
+
+import pytest
+
+from tools import file_tools as ft, read_extract
+from tools.file_tools_read_tracking import reset_file_dedup
+
+
+def write_document(path, text):
+    if path.suffix == '.ipynb':
+        path.write_text(json.dumps({'cells': [{'cell_type': 'markdown', 'source': text}],
+                                    'metadata': {}, 'nbformat': 4, 'nbformat_minor': 5}))
+    else:
+        with zipfile.ZipFile(path, 'w') as archive:
+            archive.writestr('word/document.xml',
+                '<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">'
+                '<w:body><w:p><w:r><w:t>' + text + '</w:t></w:r></w:p></w:body></w:document>')
+
+
+@pytest.fixture
+def document(tmp_path, monkeypatch):
+    path = tmp_path / 'report.docx'
