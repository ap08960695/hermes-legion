+import { act, cleanup, renderHook } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import { useServerSessionSearch } from './use-server-session-search'
+const io = vi.hoisted(() => ({ search: vi.fn() }))
+vi.mock('@/hermes', async original => ({ ...(await original<typeof import('@/hermes')>()), searchSessions: io.search }))
+afterEach(() => {
+  cleanup()
+  vi.useRealTimers()
+  io.search.mockReset()
+})
+const hit = { id: 'old-hit', title: 'Earlier query', source: 'cli' }
+async function tick() {
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(201)
+  })
+}
+it('retires previous query and profile hits immediately and reports failure without retrying', async () => {
+  vi.useFakeTimers()
+  io.search.mockResolvedValueOnce({ results: [hit] }).mockRejectedValue(new Error('Offline test'))
+  const { result, rerender } = renderHook(({ query, profile }) => useServerSessionSearch(query, profile), {
+    initialProps: { query: 'earlier', profile: 'default' }
+  })
+  await tick()
+  expect(result.current.serverMatches).toEqual([hit])
+  rerender({ query: 'later', profile: 'default' })
+  expect(result.current.serverMatches).toEqual([])
+  expect(result.current.searchPending).toBe(true)
+  await tick()
+  expect(result.current.searchError).toBe(true)
+  expect(result.current.serverMatches).toEqual([])
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(30000)
+  })
+  expect(io.search).toHaveBeenCalledTimes(2)
+  rerender({ query: 'earlier', profile: 'other' })
+  expect(result.current.serverMatches).toEqual([])
+  expect(result.current.searchError).toBe(false)
+  await tick()
+  expect(io.search).toHaveBeenLastCalledWith('earlier', 'other')
+})
+it('ignores late responses and makes one new request on explicit retry', async () => {
+  vi.useFakeTimers()
+  let finish!: (value: unknown) => void
+  io.search
+    .mockReturnValueOnce(
+      new Promise(resolve => {
+        finish = resolve
+      })
+    )
+    .mockRejectedValueOnce(new Error('Offline test'))
+    .mockResolvedValueOnce({ results: [hit] })
+  const { result, rerender } = renderHook(({ query }) => useServerSessionSearch(query, 'default'), {
+    initialProps: { query: 'old' }
+  })
+  await tick()
+  rerender({ query: 'new' })
+  await tick()
+  await act(async () => {
+    finish({ results: [hit] })
+  })
+  expect(result.current.serverMatches).toEqual([])
+  expect(result.current.searchError).toBe(true)
+  act(() => result.current.retrySearch())
+  await tick()
+  expect(io.search).toHaveBeenCalledTimes(3)
+  expect(result.current.searchError).toBe(false)
+  expect(result.current.serverMatches).toEqual([hit])
+  rerender({ query: '' })
+  expect(result.current.serverMatches).toEqual([])
+  expect(result.current.searchPending).toBe(false)
+  await tick()
+  expect(io.search).toHaveBeenCalledTimes(3)
+})
