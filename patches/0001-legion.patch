+import { useNavigate } from 'react-router'
+import type { ReactNode } from 'react'
+import { CommandGroup, CommandItem, CommandList } from '@/components/ui/command'
+import { Codicon } from '@/components/ui/codicon'
+import { closeCommandPalette } from '@/store/command-palette'
+import { useFocusCopy } from '../focus/copy'
+
+export function SavedChatSearch({ query }: { query: string }) {
+  const navigate = useNavigate(),
+    t = useFocusCopy()
+  if (!query.trim()) return null
+  return (
+    <CommandGroup>
+      <CommandItem
+        value="search-all-saved-chats"
+        onSelect={() => {
+          closeCommandPalette()
+          navigate('/history?search=' + encodeURIComponent(query.trim()))
+        }}
+      >
+        <Codicon name="search" />
+        <span>
+          {t('searchAllChats')} · {query.trim()}
+        </span>
+      </CommandItem>
+    </CommandGroup>
+  )
+}
+
+export function SavedChatList({ query, children }: { query: string; children: ReactNode }) {
+  return (
+    <CommandList className="dt-portal-scrollbar max-h-[min(20rem,56vh)]">
+      <SavedChatSearch query={query} />
+      {children}
+    </CommandList>
+  )
+}
