+def test_foreign_profile_cannot_open_same_receipt(case, monkeypatch, tmp_path):
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    built, calls, _ = _fake(monkeypatch, case)
+    token = set_hermes_home_override(tmp_path / 'other-home')
+    try:
+        with pytest.raises(ValueError): _run(case)
+    finally: reset_hermes_home_override(token)
+    assert built == calls == []
