+"""The public receipt viewer must stay read-only, including on a fresh home."""
+import argparse
+import json
+
+from hermes_cli import kanban, kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli import kanban_db_tui_delivery as delivery
+from hermes_cli import kanban_db_notify as notify
+
+
+def _command(*args):
+    parser = argparse.ArgumentParser()
+    kanban.build_parser(parser.add_subparsers(dest='command'))
+    return kanban.kanban_command(parser.parse_args(['kanban', 'notify-receipts', *args]))
+
+
+def _forbid_init(*args, **kwargs):
+    raise AssertionError('A read-only receipt command must not initialize a board')
+
+
+def test_missing_receipts_do_not_create_a_board(monkeypatch, capsys):
+    path = kb.kanban_db_path()
+    assert not path.exists()
+    monkeypatch.setattr(kb, 'init_db', _forbid_init)
+    assert _command('--session', 'fixture', '--json') == 0
+    assert json.loads(capsys.readouterr().out)['receipts'] == []
+    assert not path.exists()
+
+
+def test_receipt_viewer_omits_private_payload_and_claim_token(monkeypatch, capsys):
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title='receipt viewer fixture')
+        event = kb.list_events(conn, tid)[-1]
+        notify.add_notify_sub(conn, task_id=tid, platform='tui', chat_id='fixture')
+        with kbc.write_txn(conn):
+            text = delivery.prepare(conn, {'task_id': tid, 'chat_id': 'fixture'}, event.id, 'private notification body')
+    _, claim = delivery.claim([text], home=delivery.owner_home(), session_key='fixture')
+    monkeypatch.setattr(kb, 'init_db', _forbid_init)
+    assert _command('--session', 'fixture', '--json') == 0
+    output = capsys.readouterr().out
+    receipts = json.loads(output)['receipts']
+    assert len(receipts) == 1 and receipts[0]['state'] == 'claimed'
+    assert receipts[0]['auto_retry'] is False
+    assert 'private notification body' not in output and claim.token not in output
+    assert _command('--session', 'another', '--json') == 0
+    assert json.loads(capsys.readouterr().out)['receipts'] == []
