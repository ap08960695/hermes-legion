+import { expect, it } from 'vitest'
+import { parseAnswerCards } from './answer-cards'
+it('keeps only authored values and safe links without inventing prices or fetching metadata', () => {
+  const cards = parseAnswerCards(
+    JSON.stringify({
+      cards: [
+        {
+          title: 'Example computer',
+          price: '100 units',
+          description: 'Supplied description',
+          images: ['https://example.com/image.png', 'javascript:bad()'],
+          sources: [
+            { title: 'Example store', url: 'https://example.com/item' },
+            { title: 'bad', url: 'javascript:bad()' }
+          ]
+        },
+        { title: 'No price' }
+      ]
+    })
+  )
+  expect(cards[0].price).toBe('100 units')
+  expect(cards[0].images).toHaveLength(1)
+  expect(cards[0].sources).toHaveLength(1)
+  expect(cards[1].price).toBeUndefined()
+})
+it('refuses malformed or oversized payloads and bounds item and image counts', () => {
+  expect(parseAnswerCards('partial')).toEqual([])
+  expect(parseAnswerCards('x'.repeat(256001))).toEqual([])
+  const cards = parseAnswerCards(
+    JSON.stringify({
+      cards: Array.from({ length: 50 }, () => ({ title: 'Example', images: Array(30).fill('https://example.com/img') }))
+    })
+  )
+  expect(cards).toHaveLength(16)
+  expect(cards[0].images).toHaveLength(6)
+})
