+++ b/apps/desktop/src/app/focus/goal-editor.tsx
@@ -0,0 +1,249 @@
+import { useId, useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { Dialog, DialogContent, DialogTitle } from '@/components/ui/dialog'
+import { Input } from '@/components/ui/input'
+import { SearchField } from '@/components/ui/search-field'
+import { Textarea } from '@/components/ui/textarea'
+import type { SessionControlGoalContract } from '@/store/session-control'
+
+export interface GoalFormArgs {
+  title: string
+  contract: SessionControlGoalContract
+  expected_revision: string
+}
+interface GoalFormState {
+  title: string
+  contract: SessionControlGoalContract
+  skills: string[]
+}
+interface GoalEditorProps {
+  open: boolean
+  sessionId: string
+  sessionLabel?: string
+  revision: string
+  goal: { title: string; status: string; contract: SessionControlGoalContract } | null
+  skills: readonly { name: string; enabled: boolean }[]
+  skillsLoading?: boolean
+  skillsError?: boolean
+  busy: boolean
+  t: (key: string) => string
+  onSave: (sessionId: string, args: GoalFormArgs) => Promise<void>
+  onClose: () => void
+}
+const SKILL_MARKER = '\n\nPreferred installed skills: '
+function draftFor(goal: GoalEditorProps['goal'], t: GoalEditorProps['t']): GoalFormState {
+  const contract = goal
+    ? { ...goal.contract }
+    : { outcome: '', verification: '', constraints: '', boundaries: t('routine'), stop_when: t('material') }
+  let skills: string[] = []
+  const marker = contract.constraints.lastIndexOf(SKILL_MARKER)
+  if (marker >= 0) {
+    try {
+      const parsed: unknown = JSON.parse(contract.constraints.slice(marker + SKILL_MARKER.length))
+      if (Array.isArray(parsed) && parsed.every(item => typeof item === 'string')) {
+        skills = [...new Set(parsed)]
+        contract.constraints = contract.constraints.slice(0, marker)
+      }
+    } catch {
+      /* A user's prose that resembles the marker remains ordinary prose. */
+    }
+  }
+  return { title: goal?.title ?? '', contract, skills }
+}
+
+/** One pinned session/revision; background snapshots never overwrite an owner's draft. */
+export function GoalEditor({
+  open,
+  sessionId,
+  sessionLabel,
+  revision,
+  goal,
+  skills,
+  skillsLoading,
+  skillsError,
+  busy,
+  t,
+  onSave,
+  onClose
+}: GoalEditorProps) {
+  const [draft, setDraft] = useState(() => draftFor(goal, t))
+  const [baseRevision, setBaseRevision] = useState(revision)
+  const [pending, setPending] = useState(false)
+  const [error, setError] = useState('')
+  const [skillSearch, setSkillSearch] = useState('')
+  const hint = useId(),
+    formId = useId()
+  const blocked =
+    pending || busy || goal?.status === 'done' || !draft.title.trim() || !draft.contract.verification.trim()
+  const setField = (field: keyof SessionControlGoalContract, value: string) =>
+    setDraft(prev => ({ ...prev, contract: { ...prev.contract, [field]: value } }))
+  const selectedNames = new Set(draft.skills)
+  const choices = [
+    ...skills.filter(skill => skill.enabled),
+    ...draft.skills
+      .filter(name => !skills.some(skill => skill.name === name && skill.enabled))
+      .map(name => ({ name, enabled: false }))
+  ]
+  const matchingSkills = choices.filter(skill =>
+    skill.name.toLocaleLowerCase().includes(skillSearch.trim().toLocaleLowerCase())
+  )
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={value => {
+        if (!value && !pending) onClose()
+      }}
+    >
+      <DialogContent aria-describedby={hint} bodyClassName="hermes-focus-goal">
+        <DialogTitle>{t('configure')}</DialogTitle>
+        <p id={hint} className="text-xs text-muted-foreground">
+          {t('quota')}
+        </p>
+        <p className="text-xs text-muted-foreground break-all">
+          {t('source')}: <span title={sessionId}>{sessionLabel || sessionId}</span>
+        </p>
+        <form
+          id={formId}
+          onKeyDown={event => {
+            if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
+              event.preventDefault()
+              event.stopPropagation()
+            }
+          }}
+          onSubmit={async event => {
+            event.preventDefault()
+            if (blocked) return
+            setPending(true)
+            setError('')
+            const selected = [...new Set(draft.skills)]
+            const contract = {
+              ...draft.contract,
+              constraints: draft.contract.constraints + (selected.length ? SKILL_MARKER + JSON.stringify(selected) : '')
+            }
+            try {
+              await onSave(sessionId, { title: draft.title.trim(), contract, expected_revision: baseRevision })
+            } catch (failure) {
+              setError(failure instanceof Error ? failure.message : t('saveFailed'))
+            } finally {
+              setPending(false)
+            }
+          }}
+        >
+          <fieldset disabled={pending}>
+            <label>
+              <span>{t('title')} *</span>
+              <Input
+                required
+                aria-label={t('title')}
+                maxLength={4000}
+                value={draft.title}
+                onChange={event => setDraft(prev => ({ ...prev, title: event.target.value }))}
+              />
+            </label>
+            {(['verification', 'boundaries'] as const).map(field => (
+              <label key={field}>
+                <span>
+                  {t(field)}
+                  {field === 'verification' ? ' *' : ''}
+                </span>
+                <Textarea
+                  aria-required={field === 'verification'}
+                  aria-label={t(field)}
+                  maxLength={16000}
+                  rows={2}
+                  value={draft.contract[field]}
+                  onChange={event => setField(field, event.target.value)}
+                />
+              </label>
+            ))}
+            <fieldset>
+              <legend>{t('skills')}</legend>
+              <p>{t('skillsHint')}</p>
+              {skillsLoading ? (
+                <p role="status">{t('loading')}</p>
+              ) : skillsError ? (
+                <p role="status">{t('skillError')}</p>
+              ) : !choices.length ? (
+                <p>{t('noSkills')}</p>
+              ) : null}
+              <div className="hermes-focus-skill-search">
+                <SearchField
+                  aria-label={t('searchSkills')}
+                  placeholder={t('searchSkills')}
+                  value={skillSearch}
+                  onChange={setSkillSearch}
+                  onKeyDown={event => {
+                    if (event.key === 'Enter') event.preventDefault()
+                  }}
+                />
+                <span role="status">
+                  {t('selectedSkills')}: {draft.skills.length}
+                </span>
+              </div>
+              {!matchingSkills.length && choices.length > 0 && <p role="status">{t('noSkillMatches')}</p>}
+              <div className="hermes-focus-skill-grid">
+                {matchingSkills.map(skill => (
+                  <label key={skill.name}>
+                    <input
+                      type="checkbox"
+                      aria-label={skill.name}
+                      checked={selectedNames.has(skill.name)}
+                      disabled={!skill.enabled && !selectedNames.has(skill.name)}
+                      onChange={event =>
+                        setDraft(prev => ({
+                          ...prev,
+                          skills: event.target.checked
+                            ? [...prev.skills, skill.name]
+                            : prev.skills.filter(name => name !== skill.name)
+                        }))
+                      }
+                    />
+                    <span title={skill.name}>{skill.name.replaceAll(/[-_]/g, ' ')}</span>
+                  </label>
+                ))}
+              </div>
+            </fieldset>
+            <details>
+              <summary>{t('moreConditions')}</summary>
+              <div className="hermes-focus-more-conditions">
+                {(['outcome', 'constraints', 'stop_when'] as const).map(field => (
+                  <label key={field}>
+                    <span>{t(field)}</span>
+                    <Textarea
+                      aria-label={t(field)}
+                      maxLength={16000}
+                      rows={2}
+                      value={draft.contract[field]}
+                      onChange={event => setField(field, event.target.value)}
+                    />
+                  </label>
+                ))}
+              </div>
+            </details>
+          </fieldset>
+        </form>
+        {busy && <p role="status">{t('busy')}</p>}
+        {goal?.status === 'done' && <p role="status">{t('completeGoal')}</p>}
+        {error && <p role="alert">{error}</p>}
+        <div className="hermes-focus-goal-footer">
+          <Button
+            variant="ghost"
+            disabled={pending}
+            onClick={() => {
+              setDraft(draftFor(goal, t))
+              setBaseRevision(revision)
+              setError('')
+              onClose()
+            }}
+          >
+            {t('cancel')}
+          </Button>
+          <Button type="submit" form={formId} disabled={blocked}>
+            {t('save')}
+          </Button>
+        </div>
+      </DialogContent>
+    </Dialog>
+  )
+}
