+import { useContext, useEffect } from 'react'
+import { ContribWiringContext } from '../contrib/context'
+import { SessionControlSections } from '../chat/composer/status-stack/session-control'
+import { $sessionControlBySession, refreshSessionControl } from '@/store/session-control'
+import { useStoreSelector } from '@/lib/use-session-slice'
+import { useParityCopy } from './parity-copy'
+/** Target identity rides every native control/submit, including after focus changes. */
+export function FocusControlPanel({ sessionId }: { sessionId: string }) {
+  const entry = useStoreSelector($sessionControlBySession, rows => rows[sessionId])
+  const api = useContext(ContribWiringContext),
+    t = useParityCopy()
+  useEffect(() => {
+    void refreshSessionControl(sessionId)
+  }, [sessionId])
+  const submit = api?.actions?.onSubmit
+  if (!entry) return <p role="status">{t('unknown')}</p>
+  return (
+    <section aria-label={t('controls')}>
+      <h3>{t('controls')}</h3>
+      {!entry.snapshot ? <p>{t('unknown')}</p> : !entry.snapshot.goal && !entry.snapshot.loop && !entry.snapshot.heartbeat ? <p>{t('noControls')}</p> : null}
+      <SessionControlSections
+        sessionId={sessionId}
+        entry={entry}
+        onSubmit={submit ? (value, options) => submit(value, { ...options, sessionId }) : undefined}
+      />
+    </section>
+  )
+}
