+
+
+def test_title_resolution_keeps_canonical_bot_and_numbered_rules_without_context(archive):
+    db, _ = archive
+    db.create_session("continuation", source="cli")
+    db.set_session_title("continuation", "Quarterly archive review #2")
+    db._conn.execute("UPDATE sessions SET started_at=started_at+10 WHERE id='continuation'")
+    db.create_session("bot", source="cli")
+    db.set_session_title("bot", db.CANONICAL_BOT_CHAT_TITLE)
+    db.create_session("bot-sibling", source="cli")
+    db.set_session_title("bot-sibling", db.CANONICAL_BOT_CHAT_TITLE + " #2")
