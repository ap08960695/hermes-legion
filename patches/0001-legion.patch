@@ -0,0 +1,165 @@
+"""Local shared pages/files. Bot CLI access is read-only and membership-scoped."""
+from __future__ import annotations
+import argparse
+import base64
+import contextlib
+import hashlib
+import json
+import os
+from pathlib import Path
+import sqlite3
+import time
+import uuid
+
+MAX_FILE_BYTES = 8 * 1024 * 1024
+MAX_PAGE_BYTES = 1024 * 1024
+
+class SpaceConflict(ValueError):
+    pass
+
+class SpaceDenied(PermissionError):
+    pass
+
+class Spaces:
+    def __init__(self, home: Path | None = None):
+        from hermes_constants import get_default_hermes_root
+        self.path = (home or get_default_hermes_root()).resolve() / 'spaces' / 'catalog.db'
+
+    @contextlib.contextmanager
+    def connection(self, write=False):
+        if not write and not self.path.exists():
+            yield None
+            return
+        if write:
+            self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+            conn = sqlite3.connect(self.path, timeout=.5)
+        else:
+            conn = sqlite3.connect(self.path.as_uri()+'?mode=ro', uri=True, timeout=.5)
+        conn.row_factory = sqlite3.Row
+        try:
+            if write:
+                os.chmod(self.path, 0o600)
+                conn.executescript("""PRAGMA journal_mode=WAL;
+                CREATE TABLE IF NOT EXISTS spaces(id TEXT PRIMARY KEY,title TEXT NOT NULL,members TEXT NOT NULL,revision INTEGER NOT NULL,updated REAL NOT NULL);
+                CREATE TABLE IF NOT EXISTS items(id TEXT PRIMARY KEY,space_id TEXT NOT NULL,title TEXT NOT NULL,kind TEXT NOT NULL,mime TEXT NOT NULL,data BLOB NOT NULL,revision INTEGER NOT NULL,deleted INTEGER NOT NULL DEFAULT 0,updated REAL NOT NULL);""")
+                conn.execute('BEGIN IMMEDIATE')
+            yield conn
+            if write:
+                conn.commit()
+        except BaseException:
+            if write:
+                conn.rollback()
+            raise
+        finally:
+            conn.close()
+
+    @staticmethod
+    def space(conn, space_id, actor=None):
+        row=conn.execute('SELECT * FROM spaces WHERE id=?',(space_id,)).fetchone() if conn else None
+        if not row:raise KeyError('Space not found')
+        value=dict(row);value['members']=json.loads(value['members'])
+        if actor is not None and actor not in value['members']:raise SpaceDenied('This bot is not a member of the Space')
+        return value
+
+    def list(self, actor=None):
+        with self.connection() as conn:
+            if conn is None:return []
+            rows=conn.execute('SELECT id FROM spaces ORDER BY updated DESC LIMIT 500').fetchall()
+            result=[]
+            for row in rows:
+                value=self.space(conn,row['id'])
+                if actor is None or actor in value['members']:result.append(value)
+            return result
+
+    def create(self,title,members):
+        title=title.strip()
+        if not title or len(title)>200:raise ValueError('Space title must contain 1 to 200 characters')
+        if len(members)>64:raise ValueError('Too many members')
+        sid=uuid.uuid4().hex
+        with self.connection(True) as conn:
+            conn.execute('INSERT INTO spaces VALUES(?,?,?,?,?)',(sid,title,json.dumps(sorted(set(members))),1,time.time()))
+            return self.space(conn,sid)
+
+    def members(self,sid,members,revision):
+        if len(members)>64:raise ValueError('Too many members')
+        with self.connection(True) as conn:
+            self.space(conn,sid)
+            changed=conn.execute('UPDATE spaces SET members=?,revision=revision+1,updated=? WHERE id=? AND revision=?',(json.dumps(sorted(set(members))),time.time(),sid,revision)).rowcount
+            if not changed:raise SpaceConflict('Space changed; refresh before saving')
+            return self.space(conn,sid)
+
+    def items(self,sid,actor=None,trash=False):
+        with self.connection() as conn:
+            self.space(conn,sid,actor)
+            if actor is not None:trash=False
+            return [dict(row) for row in conn.execute('SELECT id,space_id,title,kind,mime,length(data) AS byte_size,revision,deleted,updated FROM items WHERE space_id=? AND deleted=? ORDER BY updated DESC LIMIT 1000',(sid,int(trash)))]
+
+    def catalog_items(self):
+        """Owner metadata browser; bot CLI remains membership-scoped."""
+        with self.connection() as conn:
+            if conn is None:return []
+            return [dict(row) for row in conn.execute('SELECT i.id,i.space_id,i.title,i.kind,i.mime,length(i.data) AS byte_size,i.revision,i.deleted,i.updated,s.title AS collection_title FROM items i JOIN spaces s ON s.id=i.space_id WHERE i.deleted=0 ORDER BY i.updated DESC LIMIT 1000')]
+
+    def add(self,sid,title,data,kind='file',mime='application/octet-stream'):
+        if not title.strip() or len(title)>200:raise ValueError('Item title must contain 1 to 200 characters')
+        if kind not in ('page','file'):raise ValueError('Invalid item kind')
+        if len(data)>(MAX_PAGE_BYTES if kind=='page' else MAX_FILE_BYTES):raise ValueError('Item exceeds the Space size limit')
+        iid=uuid.uuid4().hex
+        with self.connection(True) as conn:
+            self.space(conn,sid)
+            conn.execute('INSERT INTO items VALUES(?,?,?,?,?,?,1,0,?)',(iid,sid,title,kind,mime,data,time.time()))
+        return self.read(sid,iid)
+
+    def read(self,sid,iid,actor=None):
+        with self.connection() as conn:
+            self.space(conn,sid,actor)
+            row=conn.execute('SELECT * FROM items WHERE id=? AND space_id=? AND deleted=0',(iid,sid)).fetchone()
+            if not row:raise KeyError('Item not found')
+            value=dict(row);value['data']=bytes(value['data']);return value
+
+    def save_page(self,sid,iid,title,text,revision):
+        data=text.encode()
+        if not title.strip() or len(title)>200 or len(data)>MAX_PAGE_BYTES:raise ValueError('Page exceeds its limits')
+        with self.connection(True) as conn:
+            self.space(conn,sid)
+            count=conn.execute("UPDATE items SET title=?,data=?,revision=revision+1,updated=? WHERE id=? AND space_id=? AND revision=? AND kind='page' AND deleted=0",(title,data,time.time(),iid,sid,revision)).rowcount
+            if not count:raise SpaceConflict('Page changed; refresh before saving')
+        return self.read(sid,iid)
+
+    def remove(self,sid,iid,revision,deleted=True):
+        with self.connection(True) as conn:
+            self.space(conn,sid)
+            count=conn.execute('UPDATE items SET deleted=?,revision=revision+1,updated=? WHERE id=? AND space_id=? AND revision=?',(int(deleted),time.time(),iid,sid,revision)).rowcount
+            if not count:raise SpaceConflict('Item changed; refresh before changing it')
+        return {'id':iid,'revision':revision+1,'deleted':deleted}
+
+
+def main(argv=None):
+    from hermes_cli.profiles import current_profile_name
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('command',choices=['list','items','read','export'])
+    parser.add_argument('space_id',nargs='?');parser.add_argument('item_id',nargs='?')
+    parser.add_argument('--offset',type=int,default=0);parser.add_argument('--limit',type=int)
+    parser.add_argument('--output',type=Path)
+    args=parser.parse_args(argv);store=Spaces();actor=current_profile_name(default='default')
+    try:
+        if args.command in ('list','items'):
+            rows=store.list(actor) if args.command=='list' else store.items(args.space_id,actor)
+            offset=max(0,args.offset);limit=min(200,max(1,args.limit or 50))
+            result={'spaces' if args.command=='list' else 'items':rows[offset:offset+limit],'next_offset':offset+limit if offset+limit<len(rows) else None}
+        else:
+            item=store.read(args.space_id,args.item_id,actor);data=item.pop('data');item['sha256']=hashlib.sha256(data).hexdigest()
+            if args.command=='export':
+                if args.output is None:raise ValueError('--output is required; binary content is never dumped into context')
+                with args.output.open('xb') as handle:handle.write(data)
+                result={**item,'output':str(args.output),'byte_size':len(data)}
+            else:
+                if item['kind']!='page' and not item['mime'].startswith('text/'):raise ValueError('Use export for non-text files')
+                content=data.decode('utf-8');offset=max(0,args.offset);limit=min(32000,max(1,args.limit or 8000));chunk=content[offset:offset+limit]
+                result={**item,'text':chunk,'offset':offset,'next_offset':offset+len(chunk) if offset+len(chunk)<len(content) else None}
+        print(json.dumps(result,ensure_ascii=False));return 0
+    except (KeyError,ValueError,OSError) as exc:
+        parser.exit(1,str(exc)+'\n')
+
+if __name__=='__main__':
+    raise SystemExit(main())
diff --git a/hermes_cli/web_routers/spaces.py b/hermes_cli/web_routers/spaces.py
new file mode 100644
--- /dev/null
+++ b/hermes_cli/web_routers/spaces.py
@@ -0,0 +1,106 @@
+"""Authenticated Desktop owner operations for local shared Spaces."""
+import asyncio
+import base64
+import binascii
+from pathlib import Path
+import sqlite3
+from fastapi import APIRouter,HTTPException
+from pydantic import BaseModel,Field
+from hermes_cli.spaces import Spaces,SpaceConflict,SpaceDenied,MAX_FILE_BYTES
+
+router=APIRouter(prefix='/api/spaces')
+
+class CreateSpace(BaseModel):
+    title:str=Field(min_length=1,max_length=200)
+    members:list[str]=Field(default_factory=list,max_length=64)
+class Members(BaseModel):
+    members:list[str]=Field(max_length=64)
+    revision:int=Field(ge=1)
+class Page(BaseModel):
+    title:str=Field(min_length=1,max_length=200)
+    text:str=Field(max_length=1024*1024)
+class Upload(BaseModel):
+    filename:str=Field(min_length=1,max_length=200)
+    data_url:str=Field(max_length=12*1024*1024)
+class Change(BaseModel):
+    revision:int=Field(ge=1)
+    deleted:bool|None=None
+    title:str|None=Field(default=None,max_length=200)
+    text:str|None=Field(default=None,max_length=1024*1024)
+
+
+def _call(fn,*args,**kwargs):
+    try:return fn(*args,**kwargs)
+    except KeyError as exc:raise HTTPException(404,'Space or item not found') from exc
+    except SpaceDenied as exc:raise HTTPException(403,str(exc)) from exc
+    except SpaceConflict as exc:raise HTTPException(409,str(exc)) from exc
+    except ValueError as exc:raise HTTPException(400,str(exc)) from exc
+    except sqlite3.OperationalError as exc:raise HTTPException(409,'Space storage is busy; retry after refreshing') from exc
+
+
+def _members(values):
+    from hermes_cli.profiles import profile_exists
+    if any(not profile_exists(value) for value in values):raise HTTPException(400,'Select existing bots on this connection')
+    return values
+
+
+def _space(sid):
+    store=Spaces()
+    with store.connection() as conn:return store.space(conn,sid)
+
+
+def _items(sid,trash):
+    from hermes_cli.web_routers.file_preview import _format_state
+    rows=Spaces().catalog_items() if sid is None else Spaces().items(sid,trash=trash)
+    for row in rows:row['preview_state']='ready' if row['kind']=='page' else _format_state(Path(row['title']),row['byte_size'])
+    return rows
+
+
+def _item(sid,iid):
+    from hermes_cli.web_routers.files import _fs_looks_binary
+    from hermes_cli.web_routers.file_preview import _format_state
+    row=Spaces().read(sid,iid);data=row.pop('data');row['byte_size']=len(data)
+    if row['kind']=='page':row['text']=data.decode();return row
+    state=_format_state(Path(row['title']),len(data));row['preview_state']=state
+    if state!='ready':return row
+    row['preview']={'path':row['title'],'text':data[:512*1024].decode('utf-8',errors='replace'),'byteSize':len(data),'mimeType':row['mime'],'binary':_fs_looks_binary(data[:4096]),'truncated':len(data)>512*1024,'language':'text'}
+    if row['mime'].startswith(('image/','audio/','video/')) or row['mime']=='application/pdf':row['preview']['dataUrl']='data:'+row['mime']+';base64,'+base64.b64encode(data).decode()
+    return row
+
+
+def _upload(sid,payload):
+    from hermes_cli.web_routers.files import _is_sensitive_filename,_fs_mime_type
+    if _is_sensitive_filename(payload.filename):raise ValueError('Credential files cannot be shared')
+    if '/' in payload.filename or '\\' in payload.filename:raise ValueError('Use a filename, not a path')
+    header,sep,content=payload.data_url.partition(',')
+    if not sep or not header.startswith('data:') or not header.endswith(';base64'):raise ValueError('Invalid file upload')
+    try:data=base64.b64decode(content,validate=True)
+    except (ValueError,binascii.Error) as exc:raise ValueError('Invalid file upload') from exc
+    if len(data)>MAX_FILE_BYTES:raise ValueError('Space files are limited to 8 MB')
+    row=Spaces().add(sid,payload.filename,data,mime=_fs_mime_type(Path(payload.filename)));row.pop('data');return row
+
+
+@router.get('')
+async def list_spaces():return {'spaces':await asyncio.to_thread(_call,Spaces().list)}
+@router.post('')
+async def create_space(payload:CreateSpace):return await asyncio.to_thread(_call,Spaces().create,payload.title,_members(payload.members))
+@router.get('/all-items')
+async def catalog_items():return {'items':await asyncio.to_thread(_call,_items,None,False)}
+@router.get('/{sid}')
+async def space_detail(sid:str):return await asyncio.to_thread(_call,_space,sid)
+@router.patch('/{sid}')
+async def change_members(sid:str,payload:Members):return await asyncio.to_thread(_call,Spaces().members,sid,_members(payload.members),payload.revision)
+@router.get('/{sid}/items')
+async def list_items(sid:str,trash:bool=False):return {'items':await asyncio.to_thread(_call,_items,sid,trash)}
+@router.post('/{sid}/pages')
+async def create_page(sid:str,payload:Page):
+    row=await asyncio.to_thread(_call,Spaces().add,sid,payload.title,payload.text.encode(),'page','text/markdown');row.pop('data');return row
+@router.post('/{sid}/files')
+async def import_file(sid:str,payload:Upload):return await asyncio.to_thread(_call,_upload,sid,payload)
+@router.get('/{sid}/items/{iid}')
+async def item_detail(sid:str,iid:str):return await asyncio.to_thread(_call,_item,sid,iid)
+@router.patch('/{sid}/items/{iid}')
+async def change_item(sid:str,iid:str,payload:Change):
+    if payload.deleted is not None:return await asyncio.to_thread(_call,Spaces().remove,sid,iid,payload.revision,payload.deleted)
+    if payload.title is None or payload.text is None:raise HTTPException(400,'Title and text are required')
+    row=await asyncio.to_thread(_call,Spaces().save_page,sid,iid,payload.title,payload.text,payload.revision);row.pop('data');return row
