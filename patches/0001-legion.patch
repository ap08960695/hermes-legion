+def _cli(cached):
+    from hermes_cli.cli_loops_mixin import CLILoopsMixin
+    cli = CLILoopsMixin.__new__(CLILoopsMixin)
+    cli.session_id = 'self'
+    cli._goal_manager = cached
+    cli.agent = SimpleNamespace(session_id='self')
+    cli._last_turn_interrupted = False
+    cli._pending_input = queue.Queue()
+    cli.conversation_history = [{'role': 'assistant', 'content': 'The next authorized step remains.'}]
+    return cli
+
+
+def test_cli_post_turn_adopts_the_goal_created_during_its_tool_call(own_session, monkeypatch):
+    cached = goals.GoalManager('self')
+    assert not cached.is_active()
+    goals.GoalManager('self').set('Finish the assigned artifact')
+    cli = _cli(cached)
+
+    def continue_goal(manager, *args, **kwargs):
+        return {'should_continue': True, 'continuation_prompt': manager.next_continuation_prompt()}
+
+    monkeypatch.setattr(goals.GoalManager, 'evaluate_after_turn', continue_goal)
+    cli._maybe_continue_goal_after_turn()
+    assert not cli._pending_input.empty()
+    assert 'Finish the assigned artifact' in cli._pending_input.get_nowait()
+    assert cached.is_active()
+
+
+@pytest.mark.parametrize('unreadable', [False, True])
+def test_cli_post_turn_does_not_judge_stale_or_unreadable_goal_state(own_session, monkeypatch, unreadable):
+    _, db = own_session
+    cached = goals.GoalManager('self')
+    cached.set('Existing owner work')
+    cli = _cli(cached)
+    if unreadable:
+        def refused(key):
+            raise OSError('fixture cannot observe goal state')
+        monkeypatch.setattr(db, 'get_meta', refused)
+    else:
+        goals.GoalManager('self').pause('user-paused')
+
+    def forbidden(*args, **kwargs):
+        pytest.fail('A stale or unreadable goal must not spend a judge/model call')
+
+    monkeypatch.setattr(goals.GoalManager, 'evaluate_after_turn', forbidden)
+    cli._maybe_continue_goal_after_turn()
+    assert cli._pending_input.empty()
+    assert cached.state is not None
