+    usage = shutil.disk_usage(root)
+    monkeypatch.setattr(shutil, 'disk_usage', lambda path: usage._replace(
+        total=16 * 1024**3, used=6 * 1024**3, free=10 * 1024**3,
+    ))
+    return root
+
+
+@pytest.mark.parametrize('measurement', ['full', 'unknown'])
+def test_pressure_keeps_previous_hit_and_returns_new_conversion(cache_root, monkeypatch, measurement):
+    extract = shared_document_cache.extract_shared
+    assert extract(b'previous', 'previous.docx', lambda data, path: data.decode()) == 'previous'
+    before = {path.name: path.read_bytes() for path in cache_root.glob('*.txt')}
+    monkeypatch.setattr(derived_cache, '_MAX_ENTRIES', 1)
+    usage = shutil.disk_usage(cache_root)
+
+    def pressure(path):
+        if measurement == 'unknown':
+            raise OSError('volume is not observable')
+        return usage._replace(used=usage.total, free=0)
+
+    monkeypatch.setattr(shutil, 'disk_usage', pressure)
+    assert extract(b'new result', 'new.docx', lambda data, path: data.decode()) == 'new result'
+    assert {path.name: path.read_bytes() for path in cache_root.glob('*.txt')} == before
+
+    def no_reconversion(data, path):
+        pytest.fail('A failed optional write must not discard the previous hit')
+
+    assert extract(b'previous', 'previous.docx', no_reconversion) == 'previous'
+    assert not list(cache_root.glob('write-*'))
