@@ -0,0 +1,77 @@
+"""Queued memory writes must observe the transcript at submission time."""
+import copy
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from agent.memory_manager import MemoryManager
+
+
+@pytest.mark.parametrize("boundary", [False, True])
+def test_queued_memory_write_keeps_its_own_transcript(boundary):
+    manager = MemoryManager()
+    started, release = threading.Event(), threading.Event()
+    seen = []
+    provider = SimpleNamespace(
+        name="builtin", get_tool_schemas=list, shutdown=lambda: None,
+        sync_turn=lambda user, answer, **kw: seen.append(copy.deepcopy(kw["messages"])),
+        on_session_end=lambda messages: seen.append(copy.deepcopy(messages)),
+        on_session_switch=lambda *args, **kwargs: None,
+    )
+    manager.add_provider(provider)
+
+    def block():
+        started.set()
+        assert release.wait(5)
+
+    manager._submit_background(block)
+    messages = [{"role": "user", "content": [{"type": "text", "text": "original"}]}]
+    expected = copy.deepcopy(messages)
+    try:
+        assert started.wait(2)
+        if boundary:
+            manager.commit_session_boundary_async(messages, new_session_id="next")
+        else:
+            manager.sync_all("original", "answer", session_id="old", messages=messages)
+        messages[0]["content"][0]["text"] = "edited during the next turn"
+        messages.append({"role": "user", "content": "next turn"})
+    finally:
+        release.set()
+        assert manager.flush_pending(timeout=5)
+        manager.shutdown_all()
+    assert seen == [expected]
+
+
+def test_memory_provider_cannot_modify_the_live_transcript():
+    manager = MemoryManager()
+    messages = [{"role": "user", "content": [{"type": "text", "text": "keep"}]}]
+
+    def sync(user, answer, **kwargs):
+        kwargs["messages"][0]["content"][0]["text"] = "provider edit"
+
+    manager.add_provider(SimpleNamespace(name="builtin", get_tool_schemas=list,
+                                         sync_turn=sync, shutdown=lambda: None))
+    try:
+        manager.sync_all("keep", "answer", session_id="old", messages=messages)
+        assert manager.flush_pending(timeout=5)
+    finally:
+        manager.shutdown_all()
+    assert messages[0]["content"][0]["text"] == "keep"
+
+
+def test_failed_checkpoint_cannot_modify_the_uncompressed_transcript():
+    manager = MemoryManager()
+    messages = [{"role": "user", "content": [{"type": "text", "text": "keep before compact"}]}]
+
+    def checkpoint(incoming, **kwargs):
+        incoming[0]["content"][0]["text"] = "provider edit before failure"
+        raise RuntimeError("checkpoint unavailable")
+
+    manager.add_provider(SimpleNamespace(
+        name="builtin", get_tool_schemas=list, on_pre_compress=checkpoint,
+        pre_compress_checkpoint_api_version=2,
+    ))
+    with pytest.raises(RuntimeError, match="checkpoint unavailable"):
+        manager.on_pre_compress(messages, evidence_messages=messages, require_checkpoint=True)
+    assert messages[0]["content"][0]["text"] == "keep before compact"
