+"""A damaged full extract index must not prevent caching unrelated new pages."""
+
+import json
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from agent import web_search_registry
+from tools import web_result_cache as cache, web_tools, web_tools_extract, website_policy
+
+
+@pytest.fixture
+def full_index(tmp_path, monkeypatch):
+    monkeypatch.setattr(cache, "_cache_dir", lambda: tmp_path)
+    monkeypatch.setattr(cache, "_web_config", dict)
+    monkeypatch.setattr(cache, "_INDEX_MAX_ENTRIES", 3)
+    return tmp_path / cache._INDEX_FILENAME
+
+
+@pytest.mark.parametrize("damaged", [
+    None, "wrong shape", ["wrong shape"],
+    {"fetched_at": None}, {"fetched_at": "broken"},
+    {"fetched_at": []}, {"fetched_at": 10**400},
+    {"fetched_at": float("nan")}, {"fetched_at": float("inf")},
+], ids=["null", "string", "list", "null-time", "bad-time", "list-time", "overflow", "nan", "inf"])
+def test_full_index_evicts_bad_metadata_and_keeps_new_page(full_index, damaged):
+    now = time.time()
+    full_index.write_text(json.dumps({
+        "bad": damaged, "old": {"fetched_at": now - 20},
+        "recent": {"fetched_at": now - 10},
+    }))
+    url = "https://example.com/new"
+    cache.extract_cache_put(url, "new page", provider="offline-fixture")
+    hit = cache.extract_cache_get(url, provider="offline-fixture")
+    assert hit is not None and hit["content"] == "new page"
+    saved = json.loads(full_index.read_text())
+    assert len(saved) == 3 and "bad" not in saved
+    assert {"old", "recent"} <= saved.keys()
+
+
+def test_eviction_sorts_numeric_strings_as_timestamps(full_index):
+    cache._save_index({
+        "old": {"fetched_at": 8}, "string-newest": {"fetched_at": "12"},
+        "numeric-middle": {"fetched_at": 10}, "string-middle": {"fetched_at": "9"},
+    })
+    saved = json.loads(full_index.read_text())
+    assert set(saved) == {"string-newest", "numeric-middle", "string-middle"}
+    assert saved["string-newest"]["fetched_at"] == "12"
+
+
+def test_registry_second_extract_reuses_new_page_with_full_damaged_index(full_index, monkeypatch):
+    now = time.time()
+    full_index.write_text(json.dumps({
+        "bad": "wrong shape", "old": {"fetched_at": now - 20},
+        "recent": {"fetched_at": now - 10},
+    }))
+    url = "https://example.com/new"
+    calls, checked = [], []
+
+    async def extract(urls, **kwargs):
+        calls.append(list(urls))
+        return [{"url": item, "content": "fresh page", "title": ""} for item in urls]
+
+    async def safe(item):
+        checked.append(item)
+        return True
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("No fallback or provider switch allowed")
+
+    provider = SimpleNamespace(name="offline-fixture", supports_extract=lambda: True, extract=extract)
+    monkeypatch.setattr(web_tools, "_ensure_web_plugins_loaded", lambda: None)
+    monkeypatch.setattr(web_tools, "_get_extract_backend", lambda: provider.name)
+    monkeypatch.setattr(web_tools, "_load_web_config", lambda: {"keyless_rescue": False})
+    monkeypatch.setattr(web_search_registry, "get_provider", lambda name: provider)
+    monkeypatch.setattr(web_search_registry, "get_active_extract_provider", forbidden)
+    monkeypatch.setattr(web_tools, "async_is_safe_url", safe)
+    monkeypatch.setattr(website_policy, "check_website_access", lambda item: None)
+    monkeypatch.setattr(web_tools_extract, "_rescue_extract", forbidden)
+    for _ in range(2):
+        result = json.loads(web_tools.registry.dispatch("web_extract", {"urls": [url]}))
+        assert result["results"][0]["content"] == "fresh page"
+    assert checked == [url, url]  # Cache hits must still pass the normal safety gate.
+    assert calls == [[url]], "A successful extraction should be reusable on the next call"
