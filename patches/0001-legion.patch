+def iter_jsonl_chunks(records: Iterable[dict[str, Any]]) -> Iterator[str]:
+    """Preserve legacy JSONL bytes with allocation bounded by one serialized record."""
+    for record in records:
+        yield json.dumps(record, ensure_ascii=False)
+        yield "\n"
