+"""Cross-role cache cohorts preserve capability sets and established v1 requests."""
+import copy
+import hashlib
+import json
+import socket
+import pytest
+from agent import shared_prompt_cache as shared
+from agent.transports.codex import ResponsesApiTransport
+
+@pytest.fixture(autouse=True)
+def offline(monkeypatch):
+    def forbidden(*a,**kw):raise AssertionError('network forbidden')
+    monkeypatch.setattr(socket.socket,'connect',forbidden)
+    monkeypatch.setattr(socket.socket,'connect_ex',forbidden)
+
+
+def tool(name):return {'type':'function','function':{'name':name,'description':'help '+name,'parameters':{'type':'object','properties':{'value':{'type':'string','enum':['b','a']}},'required':['value']}}}
+
+
+def prompt(version=2,suffix='private role'):
+    return f'[Hermes common operating rules v{version}]\n\nShared operating rules\n\n[/Hermes common operating rules v{version}]\n\n'+suffix
+
+
+def build(tools,version=2,session='a',**kw):
+    return ResponsesApiTransport().build_kwargs(model='gpt-6.1-sol',messages=[{'role':'system','content':prompt(version,session)},{'role':'user','content':session+' private task'}],tools=tools,session_id=session,cache_scope_id=session,base_url='https://chatgpt.com/backend-api/codex',is_codex_backend=True,**kw)
+
+
+def test_role_tools_no_longer_split_the_shared_prefix_routing_cohort():
+    a=shared.canonical_tools([tool('browser_navigate'),tool('read_file'),tool('terminal')])
+    b=shared.canonical_tools([tool('credential_status'),tool('read_file'),tool('terminal')])
+    ar=build(a,session='a');br=build(b,session='b')
+    assert ar['prompt_cache_key']==br['prompt_cache_key']
+    assert [t['name'] for t in ar['tools'][:2]]==['read_file','terminal']
+    assert ar['tools'][:2]==br['tools'][:2]
+    assert ar['tools']!=br['tools'] and ar['input']!=br['input']
+    assert set(t['name'] for t in ar['tools'])=={'browser_navigate','read_file','terminal'}
+    assert set(t['name'] for t in br['tools'])=={'credential_status','read_file','terminal'}
