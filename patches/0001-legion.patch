+"""Concurrent identical searches keep one flight despite unrelated query churn."""
+import threading
+import gc
+import weakref
+import json
+from concurrent.futures import ThreadPoolExecutor
+from contextlib import contextmanager
+from types import SimpleNamespace
+
+import pytest
+
+from tools import web_result_cache as cache, web_tools
+
+
+@pytest.fixture
+def memo(monkeypatch):
+    monkeypatch.setattr(cache, "_web_config", dict)
+    result = cache.SearchMemo()
+    monkeypatch.setattr(cache, "search_memo", result)
+    return result
+
+
+@pytest.mark.parametrize("held", [False, True], ids=["reserved", "held"])
+def test_query_churn_preserves_exclusion_for_existing_caller(memo, held):
+    reserved = memo.flight_lock("fixture", "same query", 5)
+    if held:
+        reserved.acquire()
+    try:
+        for index in range(300):
+            with memo.flight_lock("fixture", f"other {index}", 5):
+                pass
+        if not held:
+            reserved.acquire()
+        other = memo.flight_lock("fixture", " SAME  QUERY ", 8)
+        acquired = other.acquire(blocking=False)
+        if acquired:
+            other.release()
+        assert not acquired, "An existing caller must exclude the same normalized query"
+    finally:
+        reserved.release()
+
+
+@pytest.mark.parametrize("dispatch", ["memo", "registry"])
+def test_memoized_search_preacquire_race_calls_provider_once(memo, monkeypatch, dispatch):
+    reserved = threading.Event()
+    resume_first = threading.Event()
+    provider_entered = threading.Event()
+    first_attempted = threading.Event()
+    first_done = threading.Event()
+    local = threading.local()
+    acquired_without_wait = []
+    calls = []
+    factory = memo.flight_lock
+
+    @contextmanager
+    def scheduled_lock(provider, query, limit):
+        lock = factory(provider, query, limit)
+        if not getattr(local, "delay", False):
+            with lock:
+                yield
+            return
+        reserved.set()
+        assert resume_first.wait(5)
+        acquired = lock.acquire(blocking=False)
+        acquired_without_wait.append(acquired)
+        first_attempted.set()
+        if not acquired:
+            assert lock.acquire(timeout=5)
+        try:
+            yield
+        finally:
+            lock.release()
+
+    def search(query, limit):
+        calls.append((query, limit))
+        if len(calls) == 1:
+            provider_entered.set()
+            assert first_attempted.wait(5)
+            # If the stale reservation became a different lock, let its duplicate
+            # finish before storing this response. No timing-based race window.
+            if acquired_without_wait[0]:
+                assert first_done.wait(5)
+        return {"success": True, "data": {"web": [{"title": "fixture"}] * limit}}
+
+    monkeypatch.setattr(memo, "flight_lock", scheduled_lock)
+    provider = SimpleNamespace(name="offline-fixture", search=search, supports_search=lambda: True)
+
+    if dispatch == "registry":
+        from agent import web_search_registry
+        from tools.registry import registry
+
+        monkeypatch.setattr(web_tools, "_ensure_web_plugins_loaded", lambda: None)
+        monkeypatch.setattr(web_tools, "_get_search_backend", lambda: provider.name)
+        monkeypatch.setattr(web_search_registry, "get_provider", lambda name: provider)
+
+    def request(limit):
+        if dispatch == "registry":
+            return json.loads(registry.dispatch(
+                "web_search", {"query": "same query", "limit": limit}, task_id="offline-race"))
+        return web_tools._memoized_search(provider, "same query", limit)
+
+    def first():
+        local.delay = True
+        try:
+            return request(5)
+        finally:
+            first_done.set()
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        a = pool.submit(first)
+        try:
+            assert reserved.wait(5)
+            for index in range(300):
+                with factory(provider.name, f"other {index}", 5):
+                    pass
+            b = pool.submit(request, 8)
+            assert provider_entered.wait(5)
+            resume_first.set()
+            results = [a.result(timeout=10), b.result(timeout=10)]
+        finally:
+            resume_first.set()
+            first_attempted.set()
+            first_done.set()
+    assert all(result["success"] for result in results)
+    assert [len(result["data"]["web"]) for result in results] == [5, 8]
+    assert len(calls) == 1, "Concurrent same-query searches must share one provider call"
+
+
+def test_unrelated_queries_and_providers_do_not_block(memo):
+    with memo.flight_lock("fixture", "one", 5):
+        for provider, query, limit in [
+            ("fixture", "two", 5), ("other-provider", "one", 5), ("fixture", "one", 20),
+        ]:
+            lock = memo.flight_lock(provider, query, limit)
+            assert lock.acquire(blocking=False)
+            lock.release()
+
+
+def test_completed_queries_release_lock_memory(memo):
+    refs = []
+    for index in range(600):
+        lock = memo.flight_lock("fixture", f"completed {index}", 5)
+        with lock:
+            refs.append(weakref.ref(lock))
+    del lock
+    gc.collect()
+    assert all(ref() is None for ref in refs), "Completed flights must not accumulate locks"
