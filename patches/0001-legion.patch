+
+
+def test_failed_conversion_does_not_cache_success(document):
+    path, spy = document
+    path.write_bytes(b'broken archive')
+    assert 'extraction failed' in read(path)['error']
+    assert 'extraction failed' in read(path)['error']
+    write_document(path, 'Repaired report')
+    assert 'Repaired report' in read(path)['content']
+    assert spy.call_count == 3
+
+
+def test_change_during_conversion_is_not_cached(document):
+    path, spy = document
+    # The spy wraps the real converter; replace its side effect, not the converter.
+    real = spy._mock_wraps
+    def convert(data, filename):
