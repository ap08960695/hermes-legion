+++ b/tools/web_search_disk_cache.py
@@ -0,0 +1,84 @@
+"""Profile-local persistent search results; reuse across bot processes, never profiles.
+
+Provider/account authorization and request selection stay in the existing search path.
+No new requests, fallbacks, or TTLs. A miss/error preserves the native vendor behavior.
+"""
+from contextlib import contextmanager
+import hashlib
+import json
+import logging
+import os
+from pathlib import Path
+import stat
+import time
+
+from tools.cache_file_lock import CacheLockBusy, cache_file_lock
+from tools.derived_cache import _read, _store
+
+
+logger = logging.getLogger(__name__)
+
+
+def _root():
+    from hermes_constants import get_hermes_home
+    root=get_hermes_home()/'cache'/'web-search-v1'
+    root.mkdir(mode=0o700,parents=True,exist_ok=True)
+    info=root.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o077 or info.st_uid!=os.getuid():
+        raise OSError('unsafe search cache')
+    return root
+
+
+def _key(key):
+    # The source memo key includes profile, backend, normalized query and bucket.
+    from tools.web_result_cache import _web_config
+    return hashlib.sha256(json.dumps([key,_web_config()],sort_keys=True,default=str).encode()).hexdigest()
+
+
+def lookup(key, ttl):
+    if os.name!='posix':
+        return None
+    try:
+        text=_read(_root()/(_key(key)+'.txt'))
+        value=json.loads(text) if text is not None else {}
+        if 0<=time.time()-value.get('at',0)<ttl and value.get('response',{}).get('success'):
+            logger.info('SHARED_WEB_SEARCH_CACHE hit')
+            return value['response']
+    except (OSError, ValueError, TypeError, AttributeError):
+        pass
+    return None
+
+
+def store(key,response):
+    if os.name!='posix':
+        return
+    try:
+        root=_root()
+        _store(root,root/(_key(key)+'.txt'),json.dumps({'at':time.time(),'response':response},ensure_ascii=True))
+    except (OSError, ValueError, TypeError, CacheLockBusy):
+        pass
+
+
+@contextmanager
+def flight(key):
+    if os.name!='posix':
+        yield
+        return
+    # Acquire failures degrade to the existing thread-local flight; exceptions from
+    # the vendor body propagate once, never re-enter it.
+    from contextlib import ExitStack
+    with ExitStack() as stack:
+        try:
+            stack.enter_context(cache_file_lock(_root(),_key(key)))
+        except OSError:
+            pass
+        yield
+
+
+def clear():
+    if os.name=='posix':
+        try:
+            for path in _root().glob('*.txt'):
+                path.unlink(missing_ok=True)
+        except OSError:
+            pass
