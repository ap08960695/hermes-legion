new file mode 100644
index 0000000000000000000000000000000000000000..6677f514d19e9aae410bff8037bcdcdd275e0b16
--- /dev/null
+++ b/hermes_state_prefix.py
@@ -0,0 +1,25 @@
+"""Transaction-local request-prefix publication for native session compaction."""
+from __future__ import annotations
+
+import json
+
+
+def apply_compaction_prefix(db, conn, session_id: str, snapshot: dict | None) -> None:
+    """Publish provided prompt/pin fields on the transcript's existing write connection.
+
+    Omitted fields retain their stored bytes (seeded gateway compaction must not
+    replace the live tools pin with its reduced detached toolset).
+    """
+    if snapshot is None:
+        return
+    columns, values = [], []
+    if "system_prompt" in snapshot:
+        columns.extend(["system_prompt_hash = ?", "system_prompt = NULL"])
+        values.append(db._store_system_prompt(conn, snapshot["system_prompt"]))
+    if "tool_pin" in snapshot:
+        pin = snapshot["tool_pin"]
+        columns.append("tool_names = ?")
+        values.append(db._store_system_prompt(conn, json.dumps(pin) if pin is not None else None))
+    if columns:
+        conn.execute(f"UPDATE sessions SET {', '.join(columns)} WHERE id = ?", (*values, session_id))
+        db._delete_unreferenced_system_prompts(conn)
