@@ -0,0 +1,29 @@
+"""Close concurrent native-read dedup races with the existing file-state lock.
+
+Every caller still runs its own guards and bookkeeping. No contents are shared
+between tasks, no completed result is cached here, and different paths stay parallel.
+"""
+from functools import wraps
+from pathlib import Path
+from tools.file_operations_common import DEFAULT_READ_LIMIT
+
+
+def serialized_read(function):
+    @wraps(function)
+    def call(path,offset=1,limit=DEFAULT_READ_LIMIT,task_id='default'):
+        from tools import file_tools as ft,file_state
+        resolved=None
+        try:
+            # Preserve the raw namespace/device checks before any path resolution or backend access.
+            if not ft.get_nt_namespace_error(path,verb='Read'):
+                base=None if Path(path).expanduser().is_absolute() else ft._resolve_base_dir(task_id)
+                if not ft._is_blocked_device(path,base_dir=base):
+                    target=ft._resolve_path_for_task(path,task_id)
+                    if ft._file_ops_uses_host_paths(ft._get_file_ops(task_id)) and ft._special_file_kind(target) is None:
+                        resolved=str(target)
+        except (OSError,ValueError,TypeError,RuntimeError):
+            resolved=None  # Let the original tool return its own refusal; never retry its body.
+        if resolved is None:return function(path,offset,limit,task_id)
+        with file_state.lock_path(resolved):
+            return function(path,offset,limit,task_id)
+    return call
