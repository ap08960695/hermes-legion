+        <I18nProvider configClient={null} initialLocale="en">
+          <Composer onAttachDroppedItems={onAttachDroppedItems} />
+        </I18nProvider>
+      </MemoryRouter>
+    </AssistantRuntimeProvider>
+  )
+}
+
+function Composer({ onAttachDroppedItems }: { onAttachDroppedItems?: (files: unknown[]) => boolean }) {
+  const actions = useComposerActions({
+    activeSessionId: null,
+    currentCwd: '/tmp',
+    requestGateway: async () => {
+      throw new Error('Attaching must not submit a prompt')
+    }
+  })
+
+  return (
+    <ChatBar
+      busy={false}
+      disabled={false}
+      gateway={null}
+      onAttachDroppedItems={onAttachDroppedItems ?? actions.attachDroppedItems}
+      onCancel={vi.fn()}
+      onSubmit={vi.fn(async () => true)}
+      state={state}
+    />
+  )
+}
+
+/** Focus `editor` and fire the paste event a ⌘V into the composer produces. */
+function pasteInto(editor: HTMLElement, files: File[], text = '') {
+  // jsdom does not implement isContentEditable, so the app's window-level paste
+  // router would treat this target as page chrome and insert through the
+  // composer bus instead of the editor's own handler. Pin it.
+  Object.defineProperty(editor, 'isContentEditable', { configurable: true, value: true })
+  editor.focus()
+
+  const event = new Event('paste', { bubbles: true, cancelable: true }) as ClipboardEvent
+
+  Object.defineProperty(event, 'clipboardData', {
+    value: {
+      getData: (type: string) => (type === 'text' || type === 'text/plain' ? text : ''),
+      files: { length: files.length, item: (i: number) => files[i] ?? null },
+      items: files.map(file => ({ kind: 'file', type: file.type, getAsFile: () => file }))
+    }
+  })
+
+  act(() => {
+    fireEvent(editor, event)
+  })
+
+  return event
+}
+
+describe('file-manager paste into the real composer', () => {
+  it.each([
+    ['report.pdf', 'application/pdf'],
+    ['notes.txt', 'text/plain'],
+    ['archive.zip', 'application/zip']
+  ])('attaches %s using its native path', (name, type) => {
+    const file = new File(['fixture'], name, { type })
+    vi.stubGlobal('hermesDesktop', { getPathForFile: () => `/tmp/${name}` })
+    const attach = vi.fn(() => true)
+    const { container } = render(<Harness onAttachDroppedItems={attach} />)
+    const editor = container.querySelector<HTMLElement>(`[data-slot="${RICH_INPUT_SLOT}"]`)!
+    const event = pasteInto(editor, [file])
+    expect(attach).toHaveBeenCalledExactlyOnceWith([{ file, path: `/tmp/${name}` }])
+    expect(composerPlainText(editor)).toBe('')
+    expect(event.defaultPrevented).toBe(true)
+  })
+
+  it('creates real file attachments through the existing composer actions without sending', () => {
+    const files = [
+      new File(['pdf'], 'report.pdf', { type: 'application/pdf' }),
+      new File(['text'], 'notes.txt', { type: 'text/plain' })
+    ]
+
+    vi.stubGlobal('hermesDesktop', { getPathForFile: (file: File) => `/tmp/${file.name}` })
+    const { container } = render(<Harness />)
+    const editor = container.querySelector<HTMLElement>(`[data-slot="${RICH_INPUT_SLOT}"]`)!
+
+    pasteInto(editor, files)
+
+    expect(mainComposerScope.$attachments.get().map(({ kind, path, label }) => ({ kind, path, label }))).toEqual([
+      { kind: 'file', path: '/tmp/report.pdf', label: 'report.pdf' },
+      { kind: 'file', path: '/tmp/notes.txt', label: 'notes.txt' }
+    ])
+  })
+
+  it('attaches mixed files once without replacing existing draft text', () => {
+    const files = [
+      new File(['pdf'], 'a.pdf', { type: 'application/pdf' }),
+      new File(['png'], 'b.png', { type: 'image/png' })
+    ]
+
+    vi.stubGlobal('hermesDesktop', { getPathForFile: (file: File) => `/tmp/${file.name}` })
+    const attach = vi.fn(() => true)
+    const { container } = render(<Harness onAttachDroppedItems={attach} />)
+    const editor = container.querySelector<HTMLElement>(`[data-slot="${RICH_INPUT_SLOT}"]`)!
+    pasteInto(editor, [], 'keep this instruction')
+    pasteInto(editor, files)
+    expect(attach).toHaveBeenCalledExactlyOnceWith(files.map(file => ({ file, path: `/tmp/${file.name}` })))
+    expect(composerPlainText(editor)).toContain('keep this instruction')
+  })
+})
