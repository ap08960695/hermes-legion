@@ -0,0 +1,236 @@
+"""Kanban work must follow only its owning compression continuation, never forks."""
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_notify as notify
+from hermes_cli import kanban_db_tui_delivery as delivery
+from hermes_constants import get_hermes_home
+from hermes_state import SessionDB
+from tui_gateway import server
+
+ROOT = 'kanban-compression-root'
+TIP = 'kanban-compression-tip'
+
+
+@pytest.fixture
+def state(monkeypatch):
+    db = SessionDB(get_hermes_home() / 'state.db')
+    db.create_session(ROOT, source='desktop')
+    db.append_message(ROOT, role='user', content='Continue this project with existing gates.')
+    monkeypatch.setattr(server, '_get_db', lambda: db)
+    yield db
+    db.close()
+
+
+def _rotate(db):
+    assert db.try_acquire_compression_lock(ROOT, 'test-rotation')
+    db.publish_compression_child(parent_session_id=ROOT, child_session_id=TIP, source='desktop',
+        messages=[{'role': 'user', 'content': 'Compacted project context'},
+                  {'role': 'assistant', 'content': 'Continue preserving all gates.'}],
+        compression_lock_holder='test-rotation', require_compression_lease=True)
+    assert db.get_compression_tip(ROOT) == TIP
+
+
+def _task():
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title='same project result')
+        notify.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=ROOT,
+                              notifier_profile='default', delivery_mode='notify+wake')
+        assert kb.block_task(conn, tid, reason='Read the result; retain gates', kind='needs_input')
+    return tid
+
+
+def _record(key=TIP):
+    return {'session_key': key, 'history_lock': threading.RLock(), 'history': [], 'running': False}
+
+
+def _boundary(monkeypatch):
+    accepted = []
+    monkeypatch.setattr(server, '_emit', lambda *a, **kw: None)
+
+    def submit(rid, sid, record, text, **kwargs):
+        accepted.append((record['session_key'], text))
+        kwargs['terminal_callback']({'status': 'settled', 'text': 'fixture complete'})
+        return True
+
+    monkeypatch.setattr(server, '_run_prompt_submit', submit)
+    return accepted
+
+
+@pytest.mark.parametrize('already_prepared', [False, True])
+def test_rotated_or_cold_resumed_tip_receives_ancestor_work_once(state, monkeypatch, already_prepared):
+    tid = _task()
+    if already_prepared:
+        assert len(server._collect_kanban_notifications(_record(ROOT))) == 1
+    _rotate(state)
+    accepted = _boundary(monkeypatch)
+    record = _record()
+    server._notif_poll_kanban('tip-runtime', record)
+    assert len(accepted) == 1 and accepted[0][0] == TIP and tid in accepted[0][1]
+    record['running'] = False
+    server._notif_poll_kanban('tip-runtime', record)
+    assert len(accepted) == 1
+    rows = delivery.read_receipts(kb.kanban_db_path(), home=delivery.owner_home(), session_key=ROOT)
+    assert len(rows) == 1 and rows[0]['state'] == 'settled'
+    assert delivery.read_receipts(kb.kanban_db_path(), home=delivery.owner_home(), session_key=TIP) == []
+
+
+def test_buffer_prepared_before_rotation_is_not_dropped(state, monkeypatch):
+    tid = _task()
+    texts = server._collect_kanban_notifications(_record(ROOT))
+    _rotate(state)
+    accepted = _boundary(monkeypatch)
+    record = _record()
+    record['_kanban_pending'] = texts
+    server._notif_poll_kanban('tip-runtime', record)
+    assert len(accepted) == 1 and tid in accepted[0][1]
+
+
+def test_stale_parent_cannot_steal_from_the_continuation(state, monkeypatch):
+    _task()
+    _rotate(state)
+    accepted = _boundary(monkeypatch)
+    server._notif_poll_kanban('stale-root', _record(ROOT))
+    assert accepted == []
+    server._notif_poll_kanban('tip-runtime', _record())
+    assert len(accepted) == 1 and accepted[0][0] == TIP
+
+
+@pytest.mark.parametrize('marker', ['_branched_from', '_delegate_from'])
+def test_explicit_branch_does_not_inherit_ancestor_work(state, monkeypatch, marker):
+    _task()
+    _rotate(state)
+    state.create_session('fork', source='desktop', parent_session_id=ROOT,
+                         model_config={marker: ROOT})
+    accepted = _boundary(monkeypatch)
+    server._notif_poll_kanban('fork-runtime', _record('fork'))
+    assert accepted == []
+    server._notif_poll_kanban('tip-runtime', _record())
+    assert len(accepted) == 1
+
+
+def test_claimed_ancestor_receipt_is_never_replayed(state, monkeypatch):
+    _task()
+    texts = server._collect_kanban_notifications(_record(ROOT))
+    claimed, _ = delivery.claim(texts, home=delivery.owner_home(), session_key=ROOT)
+    assert len(claimed) == 1
+    _rotate(state)
+    accepted = _boundary(monkeypatch)
+    server._notif_poll_kanban('tip-runtime', _record())
+    assert accepted == []
+
+
+@pytest.mark.parametrize('owner_hold', [False, True])
+def test_daily_attention_retains_its_original_receipt_and_gate_after_rotation(state, monkeypatch, tmp_path, owner_hold):
+    from hermes_cli import kanban_db_attention as attention
+    from tests.hermes_cli.test_kanban_attention import _fixture, DAY, NOW
+    monkeypatch.setattr(attention, 'time', SimpleNamespace(time=lambda: NOW))
+    with kbc.connect_closing() as conn:
+        tid, guard = _fixture(conn, tmp_path, status='blocked', typed=True)
+        notify.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=ROOT,
+                              notifier_profile='default', delivery_mode='notify+wake')
+        receipt = attention.request_attention(conn, task_id=tid, day=DAY, session_key=ROOT,
+                                              guard=guard, message='Inspect the plan, preserve all gates.', now=NOW)
+        if owner_hold:
+            kb.add_comment(conn, tid, 'owner', 'OwnerGATE: wait for my answer')
+    _rotate(state)
+    accepted = _boundary(monkeypatch)
+    server._notif_poll_kanban('tip-runtime', _record())
+    assert len(accepted) == (0 if owner_hold else 1)
+    rows = delivery.read_receipts(kb.kanban_db_path(), home=delivery.owner_home(), session_key=ROOT)
+    assert len(rows) == 1 and rows[0]['id'] == receipt['delivery_id']
+    assert rows[0]['state'] == ('cancelled' if owner_hold else 'settled')
+
+
+def test_unsubscribed_ancestor_receipt_is_not_revived_by_rotation(state, monkeypatch):
+    tid = _task()
+    assert len(server._collect_kanban_notifications(_record(ROOT))) == 1
+    with kbc.connect_closing() as conn:
+        assert notify.remove_notify_sub(conn, task_id=tid, platform='tui', chat_id=ROOT)
+        notify.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=ROOT, notifier_profile='default')
+    _rotate(state)
+    accepted = _boundary(monkeypatch)
+    server._notif_poll_kanban('tip-runtime', _record())
+    assert accepted == []
+
+
+def test_same_ids_in_another_profile_do_not_inherit_the_route(state, monkeypatch, tmp_path):
+    _task()
+    _rotate(state)
+    board = kb.kanban_db_path()
+    monkeypatch.setenv('HERMES_KANBAN_DB', str(board))
+    home = tmp_path / 'profiles' / 'another-profile'
+    home.mkdir(parents=True)
+    other = SessionDB(home / 'state.db')
+    try:
+        other.create_session(ROOT, source='desktop')
+        _rotate(other)
+        accepted = _boundary(monkeypatch)
+        record = _record()
+        record['profile_home'] = str(home)
+        server._notif_poll_kanban('other-profile-runtime', record)
+        assert accepted == []
+        server._notif_poll_kanban('tip-runtime', _record())
+        assert len(accepted) == 1
+    finally:
+        other.close()
+
+
+def test_stop_keeps_rotated_work_pending_until_the_next_user_prompt(state, monkeypatch):
+    _task()
+    _rotate(state)
+    accepted = _boundary(monkeypatch)
+    record = _record()
+    record['_turn_cancel_requested'] = True
+    server._notif_poll_kanban('tip-runtime', record)
+    assert accepted == []
+    rows = delivery.read_receipts(kb.kanban_db_path(), home=delivery.owner_home(), session_key=ROOT)
+    assert len(rows) == 1 and rows[0]['state'] == 'pending'
+    record['_turn_cancel_requested'] = False  # The existing user-prompt admission clears this latch.
+    server._notif_poll_kanban('tip-runtime', record)
+    assert len(accepted) == 1
+
+
+def test_lineage_read_failure_holds_work_for_a_later_poll(state, monkeypatch):
+    _task()
+    _rotate(state)
+    accepted = _boundary(monkeypatch)
+    original = state.get_compression_tip
+
+    def unavailable(key):
+        raise RuntimeError('fixture state store unavailable')
+
+    monkeypatch.setattr(state, 'get_compression_tip', unavailable)
+    server._notif_poll_kanban('tip-runtime', _record())
+    assert accepted == []
+    monkeypatch.setattr(state, 'get_compression_tip', original)
+    server._notif_poll_kanban('tip-runtime', _record())
+    assert len(accepted) == 1
+
+
+def test_multiple_compactions_preserve_the_original_notification_identity(state, monkeypatch):
+    _task()
+    _rotate(state)
+    assert state.try_acquire_compression_lock(TIP, 'second-rotation')
+    state.publish_compression_child(parent_session_id=TIP, child_session_id='second-tip', source='desktop',
+        messages=[{'role': 'user', 'content': 'Second compacted context'}],
+        compression_lock_holder='second-rotation', require_compression_lease=True)
+    assert state.get_compression_tip(ROOT) == 'second-tip'
+    accepted = _boundary(monkeypatch)
+    server._notif_poll_kanban('new-tip-runtime', _record('second-tip'))
+    assert len(accepted) == 1 and accepted[0][0] == 'second-tip'
+
+
+def test_named_profile_lineage_lookup_never_acquires_a_writer(state, monkeypatch):
+    from tui_gateway.session_kanban_lineage import destination_keys
+    _rotate(state)
+
+    def refuse_writer(*args, **kwargs):
+        raise AssertionError('notification routing must not acquire a writer')
+
+    monkeypatch.setattr('hermes_state_registry.acquire', refuse_writer)
+    record = _record()
+    record['profile_home'] = str(get_hermes_home())
+    assert destination_keys(record, [ROOT]) == {ROOT}
diff --git a/tests/tui_gateway/test_kanban_delivery_recovery.py b/tests/tui_gateway/test_kanban_delivery_recovery.py
new file mode 100644
index 0000000000000000000000000000000000000000..87c88b88072ab673ba5025aa1726585bb9feb795
--- /dev/null
+++ b/tests/tui_gateway/test_kanban_delivery_recovery.py
@@ -0,0 +1,186 @@
+"""Disk/process boundaries around Kanban delivery, with no model invocation."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import threading
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_notify as kbn
+from tui_gateway import server
+
+KEY = 'durable-fixture-session'
+
+
+def _blocked():
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title='survive a process exit')
+        kbn.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY,
+                           delivery_mode='notify+wake')
+        assert kb.block_task(conn, tid, kind='needs_input', reason='fixture decision')
+    return tid
+
+
+def _session():
+    return {'session_key': KEY, 'history_lock': threading.RLock(), 'running': False, 'history': []}
+
+
+def _exit_child(boundary):
+    code = '''
+import os, threading
+from tui_gateway import server
+session = {'session_key': 'durable-fixture-session', 'history_lock': threading.RLock(),
+           'running': False, 'history': []}
+boundary = os.environ['FIXTURE_BOUNDARY']
+if boundary == 'precommit':
+    server._format_kanban_event_text = lambda *a: os._exit(23)
+if boundary in ('prepared', 'precommit'):
+    assert server._collect_kanban_notifications(session)
+    os._exit(23)
+def emit(event, *args, **kwargs):
+    if boundary == 'ui' and event == 'status.update': os._exit(23)
+server._emit = emit
+server._run_prompt_submit = lambda *a, **kw: os._exit(23)
+server._notif_poll_kanban('fixture-sid', session)
+raise AssertionError('the intended crash boundary was not reached')
+'''
+    env = dict(os.environ, FIXTURE_BOUNDARY=boundary)
+    assert Path(env['HERMES_HOME']).resolve() != (Path.home() / '.hermes').resolve()
+    result = subprocess.run([sys.executable, '-c', code], env=env,
+                            capture_output=True, text=True, timeout=30, check=False)
+    assert result.returncode == 23, result.stderr[-1500:]
+
+
+def _poll(monkeypatch, session=None, *, emitter=None):
+    accepted = []
+    monkeypatch.setattr(server, '_emit', emitter or (lambda *a, **kw: None))
+
+    def submit(rid, sid, record, text, **kwargs):
+        accepted.append(text)
+        if callback := kwargs.get('terminal_callback'):
+            callback({'status': 'settled', 'text': 'fixture completion'})
+        return True
+
+    monkeypatch.setattr(server, '_run_prompt_submit', submit)
+    record = session if session is not None else _session()
+    server._notif_poll_kanban('fixture-sid', record)
+    return accepted, record
+
+
+@pytest.mark.parametrize('boundary', ['precommit', 'prepared', 'ui'])
+def test_process_exit_before_worker_admission_recovers_once(monkeypatch, boundary):
+    tid = _blocked()
+    _exit_child(boundary)
+    accepted, record = _poll(monkeypatch)
+    assert len(accepted) == 1 and tid in accepted[0]
+    record['running'] = False
+    server._notif_poll_kanban('fixture-sid', record)
+    assert len(accepted) == 1
+
+
+def test_claim_crash_retains_an_inspectable_receipt_and_never_auto_replays(monkeypatch):
+    _blocked()
+    _exit_child('claimed')
+    accepted, _ = _poll(monkeypatch)
+    assert accepted == [], 'a crash at admission may already have started the turn'
+    with kbc.connect_closing() as conn:
+        assert conn.execute("SELECT name FROM sqlite_master WHERE name='kanban_tui_deliveries'").fetchone()
+        rows = conn.execute('SELECT state FROM kanban_tui_deliveries').fetchall()
+    assert len(rows) == 1 and rows[0]['state'] == 'claimed'
+
+
+def test_new_session_record_recovers_a_discarded_ui_buffer(monkeypatch):
+    tid = _blocked()
+    old = _session()
+    old['_turn_cancel_requested'] = True
+    server._notif_poll_kanban('old-sid', old)
+    assert tid in '\n'.join(old.get('_kanban_pending') or [])
+    accepted, _ = _poll(monkeypatch)
+    assert len(accepted) == 1 and tid in accepted[0]
+
+
+def test_recovered_pending_does_not_cross_destination(monkeypatch):
+    tid = _blocked()
+    _exit_child('prepared')
+    other = _session()
+    other['session_key'] = 'someone-else'
+    accepted, _ = _poll(monkeypatch, other)
+    assert accepted == []
+    accepted, _ = _poll(monkeypatch)
+    assert len(accepted) == 1 and tid in accepted[0]
+
+
+def test_repeated_busy_polls_buffer_and_render_the_pending_event_once(monkeypatch):
+    _blocked()
+    record = _session()
+    record['running'] = True
+    rendered = []
+    monkeypatch.setattr(server, '_emit', lambda event, *a, **kw: rendered.append(event))
+    for _ in range(4):
+        server._notif_poll_kanban('busy-sid', record)
+    assert len(record['_kanban_pending']) == 1
+    assert rendered.count('status.update') == 1
+
+
+def test_two_buffered_consumers_do_not_replay_a_settled_event(monkeypatch):
+    _blocked()
+    first, second = _session(), _session()
+    for record in (first, second):
+        record['_turn_cancel_requested'] = True
+        server._notif_poll_kanban('fixture-sid', record)
+    assert len(first['_kanban_pending']) == len(second['_kanban_pending']) == 1
+    first['_turn_cancel_requested'] = second['_turn_cancel_requested'] = False
+    accepted, _ = _poll(monkeypatch, first)
+    assert len(accepted) == 1
+    events = []
+    accepted, _ = _poll(monkeypatch, second, emitter=lambda event, *a, **kw: events.append(event))
+    assert accepted == []
+    assert 'message.start' not in events, 'a stale buffer must not start a phantom assistant message'
+
+
+def test_started_worker_exception_is_not_retried_and_running_is_not_cleared(monkeypatch):
+    _blocked()
+    record = _session()
+    monkeypatch.setattr(server, '_emit', lambda *a, **kw: None)
+    def started(rid, sid, session, text, **kwargs):
+        session['_run_thread'] = threading.current_thread()
+        raise RuntimeError('exception after the worker started')
+    monkeypatch.setattr(server, '_run_prompt_submit', started)
+    server._notif_poll_kanban('fixture-sid', record)
+    assert record['running'] is True
+    accepted, _ = _poll(monkeypatch)
+    assert accepted == []
+    with kbc.connect_closing() as conn:
+        assert conn.execute('SELECT state FROM kanban_tui_deliveries').fetchone()['state'] == 'unknown'
+
+
+def test_stop_during_admission_is_rejected_by_the_real_generation_gate(monkeypatch):
+    _blocked()
+    record = _session()
+    record.update(agent=object(), inflight_turn={'status': 'running'})
+    accepted = []
+    monkeypatch.setattr(server, '_ensure_active_session_slot', lambda *a, **kw: None)
+
+    def emit(event, *args, **kwargs):
+        if event == 'message.start':
+            record['_turn_cancel_requested'] = True
+            record['_queued_prompt_generation'] = 1
+
+    def submit(rid, sid, session, text, **kwargs):
+        admitted = server._admit_prompt_turn(sid, session, text, None,
+                                             kwargs.get('queued_prompt_generation'), None,
+                                             kwargs.get('display_metadata'))
+        if admitted is None:
+            return False
+        accepted.append(text)
+        kwargs['terminal_callback']({'status': 'settled'})
+        return True
+
+    monkeypatch.setattr(server, '_emit', emit)
+    monkeypatch.setattr(server, '_run_prompt_submit', submit)
+    server._notif_poll_kanban('fixture-sid', record)
+    assert accepted == [], 'Stop between claim and worker admission must not start work'
+    assert record['running'] is False
+    with kbc.connect_closing() as conn:
+        assert conn.execute('SELECT state FROM kanban_tui_deliveries').fetchone()['state'] == 'pending'
diff --git a/tests/tui_gateway/test_kanban_notification_preparation.py b/tests/tui_gateway/test_kanban_notification_preparation.py
