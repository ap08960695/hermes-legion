+import { useStore } from '@nanostores/react'
+import { useQuery } from '@tanstack/react-query'
+import { useEffect, useState, type ReactNode } from 'react'
+import { useLocation, useNavigate } from 'react-router'
+
+import {
+  $collapsedTreeSides,
+  $activeTreeGroup,
+  $layoutTree,
+  $paneVisible,
+  noteActiveTreeGroup,
+  restoreTreePane
+} from '@/components/pane-shell/tree/store'
+import { findGroupOfPane } from '@/components/pane-shell/tree/model'
+import { SessionPickerDialog } from '@/components/session-picker'
+import { Dialog, DialogContent, DialogTitle } from '@/components/ui/dialog'
+import { useContributions } from '@/contrib'
+import { getSkills } from '@/hermes'
+import { useStoreSelector } from '@/lib/use-session-slice'
+import { runBuiltinAppAction } from '@/lib/keybinds/plugin-actions'
+import { openCommandPalette } from '@/store/command-palette'
+import { $interfaceMode, setInterfaceMode } from '@/store/interface-mode'
+import { $sidebarOpen, setSidebarOpen, sidebarSide } from '@/store/layout'
+import { notify } from '@/store/notifications'
+import { $providerWaitSessions } from '@/store/provider-wait'
+import { $sessions, $unreadFinishedSessionIds } from '@/store/session'
+import { $sessionControlBySession, refreshSessionControl, runSessionControlAction } from '@/store/session-control'
+import { $focusedStoredSessionId } from '@/store/session-focus'
+import {
+  $focusedRuntimeId,
+  $sessionStates,
+  knownOwnerForSession,
+  storedSessionIdForRuntimeId
+} from '@/store/session-states'
+import { isSecondaryWindow } from '@/store/windows'
+
+import { openSessionFromPicker } from '../open-session'
+import {
+  contributedRoutes,
+  navigateToWorkspacePage,
+  ROUTES_AREA,
+  routeSessionId,
+  sessionRoute,
+  SIDEBAR_NAV_AREA,
+  type SidebarNavContribution
+} from '../routes'
+import { useFocusCopy } from './copy'
+import { FocusFrame } from './frame'
+import { GoalEditor, type GoalFormArgs } from './goal-editor'
+import { resolvePrimaryTarget, type FocusTarget, type PrimarySection } from './model'
+import { initializeFocusPresentation } from './rollout'
+import { WorkPanel } from './work-panel'
+import { ScopeControl } from './scope-panel'
+import { FocusControlPanel } from './control-panel'
+import { useParityCopy } from './parity-copy'
+import { $statusbarVisible } from '@/store/statusbar-prefs'
+import { $pluginRecords } from '@/contrib/plugins-store'
+import { completeFeatureCatalog } from './catalog'
+
+function OwnedGoalEditor({
+  sessionId,
+  open,
+  onClose,
+  onSaved
+}: {
+  sessionId: string
+  open: boolean
+  onClose: () => void
+  onSaved: () => void
+}) {
+  const t = useFocusCopy()
+  const entry = useStoreSelector($sessionControlBySession, entries => entries[sessionId])
+  const busy = useStoreSelector($sessionStates, states =>
+    Boolean(states[sessionId]?.busy || states[sessionId]?.needsInput)
+  )
+  const sessionLabel = useStoreSelector(
+    $sessions,
+    rows => rows.find(row => row.id === storedSessionIdForRuntimeId(sessionId))?.title || ''
+  )
+  const owner = knownOwnerForSession(sessionId)
+  const skills = useQuery({
+    queryKey: ['focus-goal-skills', owner],
+    queryFn: () => {
+      if (!owner) throw new Error(t('noSession'))
+      return getSkills(owner)
+    },
+    enabled: open && Boolean(owner),
+    staleTime: 60_000,
+    retry: false,
+    refetchOnWindowFocus: false
+  })
+  const save = async (id: string, args: GoalFormArgs) => {
+    await runSessionControlAction(id, 'goal.configure', args)
+    notify({ message: t('saved') })
+    onSaved()
+  }
+  if (!entry?.snapshot)
+    return (
+      <Dialog
+        open={open}
+        onOpenChange={value => {
+          if (!value) onClose()
+        }}
+      >
+        <DialogContent aria-describedby={undefined}>
+          <DialogTitle>{t('configure')}</DialogTitle>
+          <p role="status">{entry?.error || (entry?.capability === 'unsupported' ? t('unknown') : t('loading'))}</p>
+        </DialogContent>
+      </Dialog>
+    )
+  return (
+    <GoalEditor
+      open={open}
+      sessionId={sessionId}
+      sessionLabel={sessionLabel}
+      revision={entry.snapshot.revision}
+      goal={entry.snapshot.goal}
+      busy={busy || Boolean(entry.pendingAction)}
+      skills={skills.data ?? []}
+      skillsLoading={skills.isLoading}
+      skillsError={skills.isError}
+      t={t}
+      onSave={save}
+      onClose={onClose}
+    />
+  )
+}
+
+function LiveWorkPanel({
+  sessionId,
+  storedId,
+  ...props
+}: Omit<Parameters<typeof WorkPanel>[0], 'control' | 'evidence' | 'unread'> & { storedId: string | null }) {
+  const control = useStoreSelector($sessionControlBySession, entries =>
+    sessionId ? (entries[sessionId]?.snapshot ?? null) : null
+  )
+  const known = useStoreSelector($sessionStates, states => Boolean(sessionId && states[sessionId]))
+  const busy = useStoreSelector($sessionStates, states => Boolean(sessionId && states[sessionId]?.turnLive))
+  const needsInput = useStoreSelector($sessionStates, states => Boolean(sessionId && states[sessionId]?.needsInput))
+  const providerWait = useStoreSelector($providerWaitSessions, entries => (sessionId ? entries[sessionId] : ''))
+  const unread = useStore($unreadFinishedSessionIds),
+    sessions = useStore($sessions)
+  return (
+    <WorkPanel
+      {...props}
+      sessionId={sessionId}
+      control={control}
+      controlPanel={sessionId ? <FocusControlPanel sessionId={sessionId} /> : null}
+      evidence={{
+        known: known || Boolean(control),
+        busy,
+        needsInput,
+        providerWait,
+        finished: Boolean(storedId && unread.includes(storedId)),
+        goal: control?.goal
+      }}
+      unread={unread.map(id => ({ id, title: sessions.find(row => row.id === id)?.title || id }))}
+    />
+  )
+}
+
+/** Uses the native stores and route/pane owners; no new polling or agent loop. */
+export function FocusDesktop({ children }: { children: ReactNode }) {
+  const mode = useStore($interfaceMode)
+  const botsVisible = useStore($paneVisible('hermes-bots:pane'))
+  const tree = useStore($layoutTree),
+    activeGroup = useStore($activeTreeGroup)
+  const botsGroup = tree ? findGroupOfPane(tree, 'hermes-bots:pane') : null
+  const botsFocused = botsVisible && Boolean(botsGroup && botsGroup.id === activeGroup)
+  const t = useFocusCopy(),
+    navigate = useNavigate(),
+    location = useLocation()
+  const routes = useContributions(ROUTES_AREA),
+    nav = useContributions(SIDEBAR_NAV_AREA),
+    panes = useContributions('panes')
+  const focusedStored = useStore($focusedStoredSessionId),
+    focusedRuntime = useStore($focusedRuntimeId)
+  const parity = useParityCopy()
+  const pluginRecords = useStore($pluginRecords)
+  const statusLeft = useContributions('statusBar.left'),
+    statusRight = useContributions('statusBar.right')
+  const [pickerOpen, setPickerOpen] = useState(false)
+  const [workOpen, setWorkOpen] = useState(false)
+  useEffect(() => {
+    if (isSecondaryWindow()) return
+    const close = () => {
+      if ($sidebarOpen.get() || !$collapsedTreeSides.get().has(sidebarSide())) setSidebarOpen(false)
+    }
+    close()
+    const offOpen = $sidebarOpen.listen(close)
+    const offSide = $collapsedTreeSides.listen(close)
+    return () => {
+      offOpen()
+      offSide()
+    }
+  }, [mode])
+  const [goalEditor, setGoalEditor] = useState<{ sessionId: string; open: boolean } | null>(null)
+  const [emptyGoalOpen, setEmptyGoalOpen] = useState(false)
+  useEffect(() => {
+    if (!isSecondaryWindow()) initializeFocusPresentation(() => setSidebarOpen(false))
+  }, [])
+  const features = completeFeatureCatalog(
+    nav,
+    contributedRoutes(routes),
+    panes,
+    Object.values(pluginRecords),
+    [...statusLeft, ...statusRight],
+    parity
+  )
+  const openGoal = () => {
+    setWorkOpen(false)
+    if (!focusedRuntime) {
+      setEmptyGoalOpen(true)
+      return
+    }
+    setGoalEditor(current =>
+      current?.sessionId === focusedRuntime ? { ...current, open: true } : { sessionId: focusedRuntime, open: true }
+    )
+    void refreshSessionControl(focusedRuntime)
+  }
+  const openChat = (
+    id = focusedStored ?? undefined,
+    owner?: import('@/store/session-request-router').SessionOwnerRoute
+  ) => {
+    noteActiveTreeGroup(null)
+    setWorkOpen(false)
+    if (id) {
+      if (owner) openSessionFromPicker(id, navigate, 'in-place', owner)
+      else openSessionFromPicker(id, navigate)
+    } else restoreTreePane('sessions')
+  }
+  const target = (destination: FocusTarget) => {
+    if ('path' in destination) {
+      noteActiveTreeGroup(null)
+      const sessionId = routeSessionId(destination.path)
+      if (sessionId) openChat(sessionId)
+      else {
+        setSidebarOpen(false)
+        navigateToWorkspacePage(navigate, destination.path)
+      }
+    } else if ('pane' in destination) {
+      if (destination.pane === 'sessions') {
+        setPickerOpen(true)
+        return
+      }
+      restoreTreePane(destination.pane)
+      const current = $layoutTree.get()
+      noteActiveTreeGroup(current ? (findGroupOfPane(current, destination.pane)?.id ?? null) : null)
+    } else if ('statusbar' in destination) $statusbarVisible.set(true)
+    else if (destination.panel === 'goal') openGoal()
+    else setWorkOpen(true)
+  }
+  const primary = (section: PrimarySection) =>
+    target(
+      resolvePrimaryTarget(
+        section,
+        focusedStored ? sessionRoute(focusedStored) : null,
+        contributedRoutes(routes).map(route => route.path),
+        panes.map(pane => pane.id)
+      )
+    )
+  const active: PrimarySection | undefined = ['/hub', '/spaces', '/artifacts'].includes(location.pathname)
+    ? 'hub'
+    : location.pathname === '/bots' || botsFocused
+      ? 'bots'
+      : ['/agents', '/kanban'].includes(location.pathname)
+        ? 'tasks'
+        : routeSessionId(location.pathname) || location.pathname === '/'
+          ? 'chat'
+          : undefined
+  if (isSecondaryWindow()) return children
+  return (
+    <FocusFrame
+      mode={mode}
+      t={t}
+      features={features}
+      active={active}
+      path={location.pathname}
+      onNewChat={() => {
+        if (!runBuiltinAppAction('session.newTab')) target({ path: '/' })
+      }}
+      onMode={setInterfaceMode}
+      scopeControl={<ScopeControl />}
+      onSessions={() => target({ path: '/history' })}
+      onTarget={target}
+      onPrimary={primary}
+      onSearch={openCommandPalette}
+    >
+      {children}
+      <SessionPickerDialog
+        open={pickerOpen}
+        onOpenChange={setPickerOpen}
+        activeStoredSessionId={focusedStored}
+        onResume={(id, owner) => {
+          setPickerOpen(false)
+          openChat(id, owner)
+        }}
+      />
+      {workOpen && (
+        <LiveWorkPanel
+          open
+          sessionId={focusedRuntime}
+          storedId={focusedStored}
+          t={t}
+          onClose={() => setWorkOpen(false)}
+          onGoal={openGoal}
+          onLibrary={() => {
+            setWorkOpen(false)
+            primary('hub')
+          }}
+          onRuns={() => {
+            setWorkOpen(false)
+            target({ path: '/agents' })
+          }}
+          onChat={openChat}
+        />
+      )}
+      {goalEditor && (
+        <OwnedGoalEditor
+          key={goalEditor.sessionId}
+          sessionId={goalEditor.sessionId}
+          open={goalEditor.open}
+          onClose={() => setGoalEditor(current => current && { ...current, open: false })}
+          onSaved={() => setGoalEditor(null)}
+        />
+      )}
+      <Dialog open={emptyGoalOpen} onOpenChange={setEmptyGoalOpen}>
+        <DialogContent aria-describedby={undefined}>
+          <DialogTitle>{t('goal')}</DialogTitle>
+          <p>{t('noSession')}</p>
+        </DialogContent>
+      </Dialog>
+    </FocusFrame>
+  )
+}
