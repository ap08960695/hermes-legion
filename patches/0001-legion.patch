+"""Opt-in, bounded native dependency reads for the Desktop Workflow view."""
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+
+@pytest.fixture
+def client(tmp_path, monkeypatch):
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(home))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    kb.init_db()
+    source = Path(__file__).resolve().parents[2] / 'plugins/kanban/dashboard/plugin_api.py'
+    spec = importlib.util.spec_from_file_location('kanban_workflow_read_test', source)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+    app = FastAPI()
+    app.include_router(module.router, prefix='/api/plugins/kanban')
+    with kbc.connect_closing() as conn:
+        parent = kb.create_task(conn, title='Plan example', initial_status='blocked', tenant='one')
+        child = kb.create_task(conn, title='Review example', parents=[parent], initial_status='blocked', tenant='two')
+    return TestClient(app), parent, child, module
+
+def test_default_board_has_no_extra_graph_payload(client):
+    http, _, _, _ = client
+    response = http.get('/api/plugins/kanban/board')
+    assert response.status_code == 200
+    assert 'links' not in response.json()
+
+def test_workflow_reads_exact_native_direction_without_writes(client):
+    http, parent, child, _ = client
+    before = http.get('/api/plugins/kanban/board').json()
+    response = http.get('/api/plugins/kanban/board?include_links=true')
+    assert response.status_code == 200
+    data = response.json()
+    assert data['links'] == [{'parent_id': parent, 'child_id': child}]
+    assert data['links_truncated'] is False
+    assert data['latest_event_id'] == before['latest_event_id']
+    assert data['columns'] == before['columns']
+
+def test_filtered_board_never_exports_other_tenant_identifiers(client):
+    http, parent, child, _ = client
+    data = http.get('/api/plugins/kanban/board?include_links=true&tenant=two').json()
+    assert data['links'] == []
+    assert data['links_external'] == 1
+    assert parent not in str(data['links'])
+    assert any(t['id'] == child for col in data['columns'] for t in col['tasks'])
+
+def test_link_payload_is_bounded_and_reports_truncation(client, monkeypatch):
+    http, _, _, module = client
+    monkeypatch.setattr(module, '_WORKFLOW_LINK_LIMIT', 0)
+    data = http.get('/api/plugins/kanban/board?include_links=true').json()
+    assert data['links'] == []
+    assert data['links_total'] == 1
+    assert data['links_truncated'] is True
