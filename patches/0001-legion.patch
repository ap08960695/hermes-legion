+"""Resume selection and backup preflight need IDs before loading any session context."""
+import json
+import sqlite3
+
+import pytest
+
+import hermes_state
+from hermes_constants import get_hermes_home
+from hermes_state import SessionDB
+
+
+@pytest.fixture
+def store():
+    db = SessionDB(get_hermes_home() / 'state.db')
+    for index, (sid, source, workspace) in enumerate([
+        ('local-cli', 'cli', '/workspace/repo_%'),
+        ('local-oneshot', 'oneshot', '/workspace/repo_%'),
+        ('other-cli', 'cli', '/workspace/other'),
+        ('other-tui', 'tui', '/workspace/other'),
+    ]):
+        db.create_session(sid, source=source, cwd=workspace, git_repo_root=workspace,
+                          system_prompt='Synthetic context. ' * 32768,
+                          model_config={'fixture': 'kept'})
+        db.update_session_tool_names(sid, ['terminal'])
+        db._conn.execute('UPDATE sessions SET started_at=? WHERE id=?', (1_700_000_000 + index, sid))
+    db._conn.commit()
+    yield db
+    with db._read_ctx() as connection:
+        connection.set_authorizer(None)
+    db.close()
+
+
+def deny_context(action, table, column, *_):
+    if action == sqlite3.SQLITE_READ and (
+        table == 'system_prompts' and column == 'prompt'
+        or table == 'sessions' and column in {'system_prompt', 'tool_names', 'model_config'}
+    ):
+        return sqlite3.SQLITE_DENY
+    return sqlite3.SQLITE_OK
+
+
+def guarded_factory(monkeypatch):
+    class GuardedDB(SessionDB):
+        def __init__(self, *args, **kwargs):
+            super().__init__(*args, **kwargs)
+            with self._read_ctx() as connection:
+                connection.set_authorizer(deny_context)
+
+    monkeypatch.setattr(hermes_state, 'SessionDB', GuardedDB)
+
+
+@pytest.mark.parametrize('read_only', [False, True])
+def test_ids_only_keeps_native_order_filters_and_page_without_context(store, read_only):
+    db = SessionDB(store.db_path, read_only=True) if read_only else store
+    options = {'source': ['cli', 'oneshot'], 'workspace_key': '/workspace/repo_%', 'limit': 1, 'offset': 1}
+    expected = [{key: row[key] for key in ['id', 'last_active']} for row in db.search_sessions(**options)]
+    with db._read_ctx() as connection:
+        connection.set_authorizer(deny_context)
+    try:
+        assert db.search_sessions(**options, ids_only=True) == expected
+        assert db.search_sessions(source='absent', ids_only=True) == []
+    finally:
+        with db._read_ctx() as connection:
+            connection.set_authorizer(None)
+        if read_only:
+            db.close()
+
+
+@pytest.mark.parametrize('workspace, expected', [('/workspace/repo_%', 'local-oneshot'), ('/missing', 'other-cli')])
+def test_native_mru_selection_works_without_context(store, monkeypatch, workspace, expected):
+    from hermes_cli import main
+    guarded_factory(monkeypatch)
+    monkeypatch.setattr(main, '_resolve_workspace_key', lambda: workspace)
+    assert main._resolve_last_session('cli') == expected
+
+
+@pytest.mark.parametrize('surface', ['console', 'cli'])
+def test_native_export_guard_rejects_before_context_or_output(store, monkeypatch, tmp_path, capsys, surface):
+    for index in range(3):
+        store.append_message('local-cli', role='user', content=f'fixture message {index}')
+    monkeypatch.setattr(hermes_state, 'resolved_max_export_messages', lambda: 2)
+    guarded_factory(monkeypatch)
+    output = tmp_path / 'existing.jsonl'
+    output.write_text('keep existing output\n')
+    if surface == 'console':
+        from hermes_cli.console_engine import HermesConsoleEngine
+        result = HermesConsoleEngine().execute(f'sessions export {output}', confirmed=True)
+        assert result.status == 'error'
+        text = result.output
+    else:
+        from hermes_cli._parser import build_top_level_parser
+        from hermes_cli.sessions_cmd import cmd_sessions
+        from hermes_cli.subcommands.sessions import build_sessions_parser
+        parser, subparsers, _ = build_top_level_parser()
+        build_sessions_parser(subparsers, cmd_sessions=cmd_sessions)
+        args = parser.parse_args(['sessions', 'export', str(output)])
+        args.func(args)
+        text = capsys.readouterr().out
+    assert 'local-cli' in text and 'max_export_messages' in text
+    assert output.read_text() == 'keep existing output\n'
+
+
+def test_default_rows_and_successful_backup_keep_full_context(store, monkeypatch, tmp_path):
+    from hermes_cli.console_engine import HermesConsoleEngine
+    before = {row['id']: row for row in store.export_all(include_inactive=True)}
+    for row in before.values():
+        assert row['system_prompt'] == 'Synthetic context. ' * 32768
+        assert json.loads(row['model_config']) == {'fixture': 'kept'}
+        assert row['tool_names']
+    output = tmp_path / 'backup.jsonl'
+    result = HermesConsoleEngine().execute(f'sessions export {output}', confirmed=True)
+    assert result.status == 'ok', result.output
+    after = {row['id']: row for row in map(json.loads, output.read_text().splitlines())}
+    assert after == before
+
+
+def test_disabled_console_export_guard_does_not_enumerate_ids(store, monkeypatch, tmp_path):
+    from hermes_cli.console_engine import HermesConsoleEngine
+    monkeypatch.setattr(hermes_state, 'resolved_max_export_messages', lambda: 0)
+    original = SessionDB.search_sessions
+
+    def reject_guard_lookup(self, *args, **kwargs):
+        if kwargs.get('ids_only'):
+            pytest.fail('A disabled export guard must not enumerate session IDs')
+        return original(self, *args, **kwargs)
+
+    monkeypatch.setattr(SessionDB, 'search_sessions', reject_guard_lookup)
+    output = tmp_path / 'unrestricted-backup.jsonl'
+    result = HermesConsoleEngine().execute(f'sessions export {output}', confirmed=True)
+    assert result.status == 'ok', result.output
+    assert {json.loads(line)['id'] for line in output.read_text().splitlines()} == {
+        'local-cli', 'local-oneshot', 'other-cli', 'other-tui',
+    }
