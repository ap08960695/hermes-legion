+def test_descriptor_stays_bound_to_classified_file(ops, tmp_path, monkeypatch):
+    path = tmp_path / "source.txt"
+    path.write_bytes(b"original\n")
+    replacement = tmp_path / "replacement"
+    replacement.write_bytes(b"new\x00binary")
+    original_fstat = os.fstat
+
+    def replace_after_open(fd):
+        info = original_fstat(fd)
+        os.replace(replacement, path)
+        return info
+
+    monkeypatch.setattr(os, "fstat", replace_after_open)
+    result = ops.read_file_raw(str(path))
+    assert result.content == "original\n"
+    assert result._content_sha256 == hashlib.sha256(b"original\n").hexdigest()
+    assert path.read_bytes() == b"new\x00binary"
+    assert ops._exec.call_count == 0
+
+
+def test_permission_error_never_falls_back_or_claims_absence(ops, tmp_path, monkeypatch):
+    def denied(*args, **kwargs):
+        raise PermissionError("fixture access denied")
+
+    monkeypatch.setattr(os, "open", denied)
+    result = ops.read_file_raw(str(tmp_path / "private"))
+    assert result.error and "fixture access denied" in result.error
+    assert not result.not_found and not result.content
+    assert ops._exec.call_count == 0
+
+
+def test_registry_patch_preserves_bytes_and_conflict_guard(ops, tmp_path, monkeypatch):
+    from tools import file_tools as ft
+    from tools.registry import registry
+
+    monkeypatch.setattr(ft, "_get_file_ops", lambda task_id: ops)
+    target = tmp_path / "notes.txt"
+    before = b"\xef\xbb\xbfold line\r\n" + b"a" * 1100 + b"\xff\r\n"
+    target.write_bytes(before)
+    raw_calls = []
+    original = ops.read_file_raw
+
+    def observed(path):
+        count = ops._exec.call_count
+        result = original(path)
+        raw_calls.append(ops._exec.call_count - count)
+        return result
+
+    monkeypatch.setattr(ops, "read_file_raw", observed)
+    patch = f"*** Begin Patch\n*** Update File: {target}\n@@\n-old line\n+new line\n*** End Patch"
+    result = json.loads(registry.dispatch("patch", {"mode": "patch", "patch": patch}, task_id="raw-native-integration"))
+    assert result.get("success"), result
+    assert target.read_bytes() == before.replace(b"old line", b"new line")
+    assert raw_calls and not any(raw_calls)
+    # A stale edit is refused rather than overwriting an external writer.
+    external = before.replace(b"old line", b"external change")
+    target.write_bytes(external)
+    result = json.loads(registry.dispatch("patch", {"mode": "patch", "patch": patch}, task_id="raw-native-integration"))
+    assert not result.get("success")
+    assert target.read_bytes() == external
