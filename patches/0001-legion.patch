+"""Ordinary page text must survive image cleanup without altering its content."""
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from agent import web_search_registry
+from tools import web_tools, web_tools_extract, web_tools_truncate, website_policy
+
+
+@pytest.mark.parametrize("text", [
+    "", "Plain text\nwith tabs\tand CRLF\r\n",
+    "![alt](https://example.com/image.png)",
+    "![unfinished " * 1000,
+    "ตัวอย่างภาษาไทย 😀\n`data:image` is a prefix, not an image.",
+    "![icon](DATA:IMAGE/png;base64,AAAA)",
+    "(data:image/png;charset=utf-8,hello)",
+    "data:image/ is mentioned here without an encoded payload",
+], ids=["empty", "whitespace", "remote-image", "unfinished-markdown", "thai", "case", "non-base64", "literal-prefix"])
+def test_plain_or_non_base64_text_is_unchanged(text):
+    assert web_tools_truncate.convert_base64_images_to_links(text) == text
+
+
+@pytest.mark.parametrize("text, expected", [
+    ("![ภาพ](data:image/png;base64,AAAA)", "[IMAGE: ภาพ]"),
+    ("( data:image/png;base64,AAAA)", "[IMAGE]"),
+    ("prefix data:image/jpeg;base64,AAAA suffix", "prefix [IMAGE] suffix"),
+    ("![a](data:image/png;base64,AA\nAA) then ![b](https://example.com/x)",
+     "[IMAGE: a] then ![b](https://example.com/x)"),
+])
+def test_encoded_image_cleanup_still_removes_payload(text, expected):
+    assert web_tools_truncate.convert_base64_images_to_links(text) == expected
+
+
+@pytest.mark.parametrize("body, expected", [
+    ("บทความ\n![image](https://example.com/image.png)\n![unfinished",
+     "บทความ\n![image](https://example.com/image.png)\n![unfinished"),
+    ("before ![cat](data:image/png;base64,AAAA) after", "before [IMAGE: cat] after"),
+], ids=["plain-page", "embedded-image"])
+def test_registry_extract_keeps_page_content_contract(monkeypatch, body, expected):
+    async def extract(urls, **kwargs):
+        return [{"url": url, "content": body, "title": ""} for url in urls]
+
+    async def safe(url):
+        return True
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("No fallback or alternate provider")
+
+    provider = SimpleNamespace(name="offline-fixture", supports_extract=lambda: True, extract=extract)
+    monkeypatch.setattr(web_tools, "_ensure_web_plugins_loaded", lambda: None)
+    monkeypatch.setattr(web_tools, "_get_extract_backend", lambda: provider.name)
+    monkeypatch.setattr(web_tools, "_load_web_config", lambda: {"cache_enabled": False, "keyless_rescue": False})
+    monkeypatch.setattr(web_search_registry, "get_provider", lambda name: provider)
+    monkeypatch.setattr(web_search_registry, "get_active_extract_provider", forbidden)
+    monkeypatch.setattr(web_tools, "async_is_safe_url", safe)
+    monkeypatch.setattr(website_policy, "check_website_access", lambda url: None)
+    monkeypatch.setattr(web_tools_extract, "_rescue_extract", forbidden)
+    result = json.loads(web_tools.registry.dispatch("web_extract", {"urls": ["https://example.com/page"]}))
+    assert result["results"][0]["content"] == expected
+    assert result["results"][0]["error"] is None
