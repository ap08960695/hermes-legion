+"""Native parent brief keeps decision references, canonical evidence remains intact."""
+from pathlib import Path
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+
+
+def test_long_parent_handoff_keeps_decisions_and_recovery(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path,'home',lambda:tmp_path)
+    monkeypatch.setenv('HERMES_HOME',str(tmp_path/'.hermes'))
+    monkeypatch.setenv('HERMES_KANBAN_HOME',str(tmp_path/'.hermes'))
+    with kbc.connect_closing() as c:
+        parent=kb.create_task(c,title='upstream',workspace_kind='dir',workspace_path=str(tmp_path))
+        summary='Decision: retain approval gate. '+('large supporting detail '*1000)
+        metadata={'blob':'debug '*3000,'decisions':['KEEP_GATE'], 'remaining':['OWNER_APPROVAL_REQUIRED']}
+        assert kb.complete_task(c,parent,summary=summary,metadata=metadata)
+        child=kb.create_task(c,title='downstream',parents=[parent])
+        brief=kb.build_worker_context(c,child)
+        assert 'KEEP_GATE' in brief and 'OWNER_APPROVAL_REQUIRED' in brief
+        assert 'full=true' in brief and parent in brief
+        assert len(brief)<3000
+        run=kb.list_runs(c,parent)[-1]
+        assert run.summary==summary and run.metadata['blob']==metadata['blob']
+
+
+def test_legacy_parent_result_and_nonterminal_parent(tmp_path,monkeypatch):
+    monkeypatch.setattr(Path,'home',lambda:tmp_path)
+    monkeypatch.setenv('HERMES_HOME',str(tmp_path/'.hermes'))
+    monkeypatch.setenv('HERMES_KANBAN_HOME',str(tmp_path/'.hermes'))
+    with kbc.connect_closing() as c:
+        parent=kb.create_task(c,title='legacy'); child=kb.create_task(c,title='child',parents=[parent])
+        assert '## Parent task results' not in kb.build_worker_context(c,child)
+        c.execute("UPDATE tasks SET status='done',result='legacy safe result' WHERE id=?",(parent,));c.commit()
+        assert 'legacy safe result' in kb.build_worker_context(c,child)
