+              {error ? (
+                <ErrorState title={error} />
+              ) : (
+                <p className="py-16 text-center text-muted-foreground">{t.choose}</p>
+              )}
+            </>
+          )}
+        </main>
+      </div>
+      {access && (
+        <MembersForm
+          owner={owner}
+          space={access === 'edit' ? space : null}
+          onClose={() => setAccess(null)}
+          onSaved={id => {
+            if (id) setSelected(id)
+            refresh()
+          }}
+        />
+      )}
+      {editing !== undefined && space && (
+        <PageEditor
+          owner={owner}
+          space={space}
+          item={editing}
+          onClose={() => setEditing(undefined)}
+          onSaved={refresh}
+        />
+      )}
+      <Dialog
+        open={Boolean(opened)}
+        onOpenChange={open => {
+          if (!open) setOpened(null)
+        }}
+      >
+        <DialogContent className="w-[min(1000px,94vw)] max-w-none" aria-describedby={undefined}>
+          <DialogTitle>{opened?.title}</DialogTitle>
+          <div className="h-[65vh] min-h-0 overflow-auto">
+            {opened?.kind === 'page' ? (
+              <>
+                <Button
+                  size="sm"
+                  variant="ghost"
+                  onClick={() => {
+                    setEditing(opened)
+                    setOpened(null)
+                  }}
+                >
+                  {t.edit}
+                </Button>
+                <MarkdownTextContent text={opened.text || ''} isRunning={false} />
+              </>
+            ) : opened?.preview ? (
+              <ArtifactFileContent file={opened.preview} label={opened.title} />
+            ) : null}
+          </div>
+        </DialogContent>
+      </Dialog>
+      <Dialog
+        open={Boolean(removing)}
+        onOpenChange={open => {
+          if (!open && !busy) setRemoving(null)
+        }}
+      >
+        <DialogContent aria-describedby={undefined}>
+          <DialogTitle>
+            {t.remove}: {removing?.title}
+          </DialogTitle>
+          <p className="text-sm">{t.confirm}</p>
+          <div className="flex justify-end gap-2">
+            <Button variant="ghost" disabled={busy} onClick={() => setRemoving(null)}>
+              {t.cancel}
+            </Button>
+            <Button disabled={busy} onClick={() => removing && void remove(removing, true)}>
+              {t.remove}
+            </Button>
+          </div>
+        </DialogContent>
+      </Dialog>
+    </section>
+  )
+}
+
+function HubSearchEmptyState({
+  loading,
+  title,
+  search,
+  filter,
+  onClear,
+  onSearchAll
+}: {
+  loading: boolean
+  title: string
+  search: string
+  filter: string
+  onClear: () => void
+  onSearchAll: () => void
+}) {
+  const t = copy(useI18n().locale),
+    filtered = Boolean(search.trim() || filter !== 'all')
+  if (loading) return null
+  return (
+    <div className="py-10 text-center text-sm text-muted-foreground" role="status">
+      <p>{filtered ? `${t.noMatches} ${title}` : t.empty}</p>
+      {filtered && (
+        <Button className="mt-3" variant="ghost" onClick={onClear}>
+          {t.clearSearch}
+        </Button>
+      )}
+      {search.trim() && (
+        <Button className="mt-3" variant="ghost" onClick={onSearchAll}>
+          {t.searchAll}
+        </Button>
+      )}
+    </div>
+  )
+}
+
+function memberLabel(profile: Profile) {
+  return profile.title || profile.bot_title || profile.display_name || profile.name
+}
+function DiscardPageDraft({
+  open,
+  t,
+  onKeep,
+  onDiscard
+}: {
+  open: boolean
+  t: ReturnType<typeof copy>
+  onKeep: () => void
+  onDiscard: () => void
+}) {
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={value => {
+        if (!value) onKeep()
+      }}
+    >
+      <DialogContent aria-describedby={undefined}>
+        <DialogTitle>{t.unsavedTitle}</DialogTitle>
+        <p className="text-sm text-muted-foreground">{t.unsavedHint}</p>
+        <div className="flex justify-end gap-2">
+          <Button variant="ghost" onClick={onKeep}>
+            {t.keepEditing}
+          </Button>
+          <Button variant="destructive" onClick={onDiscard}>
+            {t.discard}
+          </Button>
+        </div>
+      </DialogContent>
+    </Dialog>
+  )
+}
+
+function HubItemsLoading({ pending }: { pending: boolean }) {
+  const t = copy(useI18n().locale)
+  return pending ? (
+    <p role="status" className="py-6 text-sm text-muted-foreground">
+      {t.loadingItems}
+    </p>
+  ) : null
+}
