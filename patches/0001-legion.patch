@@ -0,0 +1,33 @@
+import { compactNumber } from '@hermes/shared'
+import type { AnalyticsTotals } from '@/types/hermes'
+import { useParityCopy } from '../focus/parity-copy'
+const finiteCount = (value: unknown): value is number =>
+  typeof value === 'number' && Number.isFinite(value) && value >= 0
+export function cacheEvidence(totals: Pick<AnalyticsTotals, 'total_cache_read' | 'total_input'>) {
+  const reads = finiteCount(totals.total_cache_read) ? totals.total_cache_read : null
+  const input = finiteCount(totals.total_input) ? totals.total_input : null
+  return {
+    reads,
+    percent: reads !== null && input !== null && input > 0 && reads <= input ? (reads / input) * 100 : null
+  }
+}
+/** Reuses the existing scoped analytics response; unknown never becomes zero. */
+export function CacheUsageStats({ totals }: { totals: AnalyticsTotals }) {
+  const t = useParityCopy(),
+    value = cacheEvidence(totals)
+  return (
+    <section aria-label={t('cacheReads')} className="py-2">
+      <div className="flex flex-wrap gap-8">
+        <div>
+          <p className="text-xs text-muted-foreground">{t('cacheReads')}</p>
+          <strong>{value.reads === null ? t('unknown') : compactNumber(value.reads)}</strong>
+        </div>
+        <div>
+          <p className="text-xs text-muted-foreground">{t('cacheShare')}</p>
+          <strong>{value.percent === null ? t('unknown') : value.percent.toFixed(1) + '%'}</strong>
+        </div>
+      </div>
+      <p className="mt-2 text-xs text-muted-foreground">{t('cacheHint')}</p>
+    </section>
+  )
+}
