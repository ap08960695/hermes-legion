+
+def test_intentional_abstention_does_not_spend_fallback_quota(setup):
+    _, post, response = setup
+    response.json.return_value = {
+        "choices": [{"finish_reason": "stop", "message": {"content": "[]"}}]
+    }
+    assert ps.suggest_prompt("user: ambiguous\nassistant: waiting for owner") == ""
