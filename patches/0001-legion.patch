+"""A closed executor does not prove the memory writes it accepted have finished."""
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from agent import memory_manager as memory_module
+from agent.memory_manager import MemoryManager
+
+
+@pytest.mark.parametrize('shutdown', ['manager', 'executor'])
+def test_flush_waits_for_the_accepted_write_after_executor_closes(monkeypatch, shutdown):
+    started, release, finished = threading.Event(), threading.Event(), threading.Event()
+    manager = MemoryManager()
+
+    def sync(*args, **kwargs):
+        started.set()
+        assert release.wait(5), 'fixture write was never released'
+        finished.set()
+
+    manager.add_provider(SimpleNamespace(name='builtin', get_tool_schemas=list,
+                                         sync_turn=sync, shutdown=lambda: None))
+    monkeypatch.setattr(memory_module, '_SYNC_DRAIN_TIMEOUT_S', 0)
+    try:
+        manager.sync_all('old-session turn', 'answer', session_id='old')
+        assert started.wait(2)
+        if shutdown == 'manager':
+            manager.shutdown_all()
+            assert manager.shutdown_drain_state['active_tasks'] == 1
+        else:
+            manager._sync_executor.shutdown(wait=False)
+        assert not finished.is_set()
+        assert manager.flush_pending(timeout=0) is False, 'closed is not a completed write'
+    finally:
+        release.set()
+        assert finished.wait(2)
+        assert manager.flush_pending(timeout=2) is True
+        if shutdown == 'executor':
+            manager.shutdown_all()
