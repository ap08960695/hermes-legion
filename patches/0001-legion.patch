+import json
+from unittest.mock import MagicMock, Mock
+
+import pytest
+import requests
+
+from hermes_cli import prompt_suggestions as ps
+from hermes_cli.config import atomic_config_write
+from tests.hermes_cli.prompt_suggestion_http_fake import install_http_mock
+
+
+@pytest.fixture
+def setup(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    atomic_config_write(
+        tmp_path / "config.yaml", {"display": {"prompt_suggestions": {"enabled": True}}}
+    )
+    # Only the provider HTTP boundary is doubled; routing/cache/limits are real.
+    monkeypatch.setattr(
+        "hermes_cli.auth.read_credential_pool",
+        lambda: {
+            "nvidia": [
+                {
+                    "id": "test",
+                    "auth_type": "api_key",
+                    "access_token": "unit-test-nim-key",
+                    "last_status": "ok",
+                }
+            ]
+        },
+    )
+    response = MagicMock(status_code=200)
+    response.__enter__.return_value = response
+    response.json.return_value = {
+        "choices": [
+            {
+                "finish_reason": "stop",
+                "message": {"content": '["ทดสอบเปิด session เดิมจาก Desktop"]'},
+            }
+        ]
+    }
+    post = Mock(return_value=response)
+    monkeypatch.setattr(requests, "post", post)
+    install_http_mock(monkeypatch, post)
+    return tmp_path, post, response
+
+
+def test_predicts_new_prompt_from_result_instead_of_recalling_user_history(setup):
+    _, post, _ = setup
+    assert (
+        ps.suggest_prompt(
+            "user: แก้ compact\nassistant: แก้แล้ว ยังไม่ได้ทดสอบ resume", scope="session-a"
+        )
+        == "ทดสอบเปิด session เดิมจาก Desktop"
+    )
+    payload = post.call_args.kwargs["json"]
+    assert "resume" in payload["messages"][-1]["content"]
+    assert payload["model"] == "openai/gpt-oss-20b"
+    assert payload["max_tokens"] <= 128
+    assert "tools" not in payload
+    assert post.call_count == 1
+
+
+def test_off_is_no_model_call_and_no_quota_probe(setup):
+    home, post, _ = setup
+    atomic_config_write(
+        home / "config.yaml", {"display": {"prompt_suggestions": {"enabled": False}}}
+    )
+    assert ps.suggest_prompt("user: hello\nassistant: ready") == ""
+    post.assert_not_called()
+
+
+def test_cache_and_shared_budget_avoid_duplicate_calls_across_scopes(setup):
+    home, post, _ = setup
+    context = "user: แก้ compact\nassistant: แก้แล้ว"
+    first = ps.suggest_prompt(context, scope="session-a")
+    assert first
+    assert ps.suggest_prompt(context, scope="session-a") == first
+    assert ps.suggest_prompt(context + " new", scope="session-b") == ""
+    assert post.call_count == 1
+    assert not any(
+        "unit-test-nim-key" in p.read_bytes().decode("utf8", "ignore")
+        for p in home.rglob("*.sqlite3")
+    )
+
+
+def test_timeouts_and_quota_errors_never_fall_back_or_retry_per_keystroke(setup):
+    _, post, _ = setup
+    post.side_effect = requests.Timeout()
+    assert ps.suggest_prompt("user: first\nassistant: result") == ""
+    assert ps.suggest_prompt("user: next\nassistant: result") == ""
+    assert (
+        post.call_count == 2
+    )  # one primary + one allowed small NIM failover, then hold
+
+
+@pytest.mark.parametrize(
+    "content,reason",
+    [
+        ('["partial"]', "length"),
+        ("not json", "stop"),
+        ('["repeat old unrelated text"]', "stop"),
+        ('["ทดสอบ\\nคำสั่ง"]', "stop"),
+    ],
+)
+def test_rejects_truncation_invalid_json_and_completions_that_replace_draft(
+    setup, content, reason
+):
+    _, _, response = setup
+    response.json.return_value = {
+        "choices": [{"finish_reason": reason, "message": {"content": content}}]
+    }
+    assert (
+        ps.suggest_prompt("user: แก้ compact\nassistant: แก้แล้ว", draft="ช่วยตรวจ") == ""
+    )
+
+
+def test_context_is_bounded_and_redacted_before_leaving_process(setup):
+    _, post, response = setup
+    response.json.return_value = {
+        "choices": [{"finish_reason": "stop", "message": {"content": '["ทดสอบต่อ"]'}}]
+    }
+    ps.suggest_prompt(
+        "x" * 12000
+        + ('\nuser: api_key=' + ("sk-" + "ant-unit-test-" + "X" * 32) + '\nassistant: ทำเสร็จ')    )
+    payload = json.dumps(post.call_args.kwargs["json"], ensure_ascii=False)
+    assert len(payload) < 6500
+    assert "sk-testabcdefgh" not in payload
+
+
+def test_prediction_template_cannot_use_main_model_or_aux_fallback(setup, monkeypatch):
+    from agent.oneshot import run_oneshot
+
+    fallback = Mock(side_effect=AssertionError("expensive ladder was called"))
+    monkeypatch.setattr("agent.oneshot.call_llm", fallback)
+    assert run_oneshot(
+        template="prompt_suggestions",
+        user_input="user: compact\nassistant: ยังไม่ได้ทดสอบ resume",
+        variables={"scope": "a"},
+        main_runtime={"provider": "anthropic", "model": "expensive"},
+    )
+    fallback.assert_not_called()
+
+
+def test_model_quota_fails_over_to_small_nim_model_once(setup):
+    _, post, response = setup
+    limited = MagicMock(status_code=429)
+    limited.__enter__.return_value = limited
+    limited.json.return_value = {"error": {"code": "model_quota_exceeded"}}
+    post.side_effect = [limited, response]
+    assert ps.suggest_prompt("user: compact\nassistant: need resume test")
+    assert post.call_count == 2
+    assert [c.kwargs["json"]["model"] for c in post.call_args_list] == [
+        "openai/gpt-oss-20b",
+        "google/diffusiongemma-26b-a4b-it",
+    ]
+    assert all(
+        c.args[0] == "https://integrate.api.nvidia.com/v1/chat/completions"
+        for c in post.call_args_list
+    )
+
+
+def test_account_quota_holds_without_hopping_same_account_models(setup):
+    _, post, response = setup
+    response.status_code = 429
+    response.json.return_value = {"error": {"code": "rate_limit_exceeded"}}
+    assert ps.suggest_prompt("user: compact\nassistant: need resume test") == ""
+    assert post.call_count == 1
+    assert ps.suggest_prompt("user: changed\nassistant: need resume test") == ""
+    assert post.call_count == 1
+
+
+def test_fallback_counts_against_request_budget(setup):
+    home, post, response = setup
+    atomic_config_write(
+        home / "config.yaml",
+        {"display": {"prompt_suggestions": {"enabled": True, "hourly_calls": 1}}},
+    )
+    response.status_code = 503
+    assert ps.suggest_prompt("user: compact\nassistant: need resume test") == ""
+    assert post.call_count == 1
+
+
+def test_nim_account_exhaustion_can_continue_on_subscription_without_trying_another_nim_model(
+    setup, monkeypatch
+):
+    _, post, response = setup
+    response.status_code = 429
+    response.json.return_value = {"error": {"code": "rate_limit_exceeded"}}
+    monkeypatch.setattr(
+        "hermes_cli.prompt_suggestion_fallbacks.subscription_credential",
+        lambda provider: "unit-oauth",
+    )
+    native = Mock(
+        return_value=(
+            {
+                "choices": [
+                    {
+                        "finish_reason": "stop",
+                        "message": {"content": '["ทดสอบภาพรวมงานค้าง"]'},
+                    }
+                ]
+            },
+            0,
+        )
+    )
+    monkeypatch.setattr(
+        "hermes_cli.prompt_suggestion_fallbacks.query_subscription", native
+    )
+    assert (
+        ps.suggest_prompt("user: ภาพรวมงาน\nassistant: มีงานค้าง") == "ทดสอบภาพรวมงานค้าง"
+    )
+    assert post.call_count == 1
+    assert native.call_args.args[:2] == ("anthropic", "claude-haiku-5-5")
+
+
+def test_claude_failure_continues_on_small_gpt_and_charges_both_attempts(
+    setup, monkeypatch
+):
+    _, post, response = setup
+    response.status_code = 401
+    monkeypatch.setattr(
+        "hermes_cli.prompt_suggestion_fallbacks.subscription_credential",
+        lambda provider: "unit-oauth",
+    )
+    native = Mock(
+        side_effect=[
+            (None, 900),
+            (
+                {
+                    "choices": [
+                        {
+                            "finish_reason": "stop",
+                            "message": {"content": '["ตรวจ acceptance ที่ยังค้าง"]'},
+                        }
+                    ]
+                },
+                0,
+            ),
+        ]
+    )
+    monkeypatch.setattr(
+        "hermes_cli.prompt_suggestion_fallbacks.query_subscription", native
+    )
+    assert (
+        ps.suggest_prompt("user: ภาพรวมงาน\nassistant: มีงานค้าง")
+        == "ตรวจ acceptance ที่ยังค้าง"
+    )
+    assert post.call_count == 1
+    assert [c.args[:2] for c in native.call_args_list] == [
+        ("anthropic", "claude-haiku-5-5"),
+        ("openai-codex", "gpt-6-luna"),
+    ]
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        {
+            "choices": [
+                {"finish_reason": "length", "message": {"content": '["partial"]'}}
+            ]
+        },
+        {"choices": [{"finish_reason": "stop", "message": {"content": "not JSON"}}]},
+        {"choices": ["invalid choice"]},
+    ],
+)
+def test_invalid_or_truncated_output_uses_bounded_small_model_fallback(setup, bad):
+    _, post, good = setup
+    broken = MagicMock(status_code=200)
+    broken.__enter__.return_value = broken
+    broken.json.return_value = bad
+    post.side_effect = [broken, good]
+    assert ps.suggest_prompt("user: compact\nassistant: need resume test")
