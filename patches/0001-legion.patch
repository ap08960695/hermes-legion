@@ -0,0 +1,53 @@
+"""Trusted routine blocks must accept the native CLI's exact audited comment."""
+import argparse
+from dataclasses import asdict
+import hashlib
+import io
+from contextlib import redirect_stdout, redirect_stderr
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban, kanban_db as kb, kanban_db_attention as attention
+from hermes_cli import kanban_db_connect as kbc, kanban_db_notify as notify
+from hermes_cli.kanban_parser import build_parser
+from tests.hermes_cli.test_kanban_attention import DAY, NOW, KEY, BODY, REASON
+
+
+def invoke(*args):
+    parser = argparse.ArgumentParser()
+    build_parser(parser.add_subparsers(dest='command'))
+    with redirect_stdout(io.StringIO()), redirect_stderr(io.StringIO()):
+        return kanban.kanban_command(parser.parse_args(['kanban', *args]))
+
+
+@pytest.mark.parametrize('tamper', [None, 'owner', 'changed-reason', 'extra-comment'])
+def test_native_classify_then_daily_attention(tmp_path, monkeypatch, tamper):
+    monkeypatch.setattr(attention, 'time', SimpleNamespace(time=lambda: NOW))
+    monkeypatch.setattr(kanban, '_profile_author', lambda: 'default')
+    with kbc.connect_closing() as c:
+        tid = kb.create_task(c, title='routine template', body=BODY, initial_status='blocked',
+            created_by='morning-fixture', idempotency_key=f'morning-fixture:{DAY}',
+            workspace_kind='dir', workspace_path=str(tmp_path))
+    assert invoke('block', tid, '--kind', 'needs_input', REASON) == 0
+    with kbc.connect_closing() as c:
+        comment = kb.list_comments(c, tid)[0]
+        assert (comment.author, comment.body) == ('default', f'BLOCKED: {REASON}')
+        notify.add_notify_sub(c, task_id=tid, platform='tui', chat_id=KEY,
+            notifier_profile='default', delivery_mode='notify+wake')
+        guard = dict(version=1, workspace=str(tmp_path), created_by='morning-fixture',
+            idempotency_key=f'morning-fixture:{DAY}', body_sha256=hashlib.sha256(BODY.encode()).hexdigest(),
+            initial_block_reason=REASON, initial_comment_author='default')
+        if tamper:
+            kb.add_comment(c, tid, 'owner' if tamper == 'owner' else 'default',
+                'BLOCKED: pause' if tamper != 'extra-comment' else f'BLOCKED: {REASON}')
+        before = asdict(kb.get_task(c, tid))
+        def request():
+            return attention.request_attention(c, task_id=tid, day=DAY, session_key=KEY,
+                guard=guard, message='Inspect this existing plan; keep gates.')
+        if tamper:
+            with pytest.raises(ValueError): request()
+        else:
+            one = request()
+            assert one == request()
+        assert asdict(kb.get_task(c, tid)) == before
