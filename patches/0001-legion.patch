+def test_parallel_callers_do_not_leak_origin():
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+    from hermes_cli.kanban_event_origin import attributed_payload, event_origin
+    barrier = Barrier(2)
+
+    def emit(chat):
+        with event_origin('task', {'chat_id': chat}):
+            barrier.wait(timeout=5)
+            return attributed_payload('task', {})['_notification_origin']['chat_id']
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        first = pool.submit(emit, 'a')
+        second = pool.submit(emit, 'b')
+        assert (first.result(timeout=5), second.result(timeout=5)) == ('a', 'b')
+    assert attributed_payload('task', None) is None
