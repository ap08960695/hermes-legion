+"""Self-originated card transitions must not wake their caller again."""
+import json
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_notify as kbn
+from tools import kanban_tools as kt
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    for name in ('HERMES_KANBAN_TASK', 'HERMES_KANBAN_RUN_ID'):
+        monkeypatch.delenv(name, raising=False)
+    env = {'HERMES_SESSION_KEY': 'captain-session', 'HERMES_SESSION_PROFILE': 'captain'}
+    monkeypatch.setattr('gateway.session_context.get_session_env', lambda k, default='': env.get(k, default))
+    monkeypatch.setattr(kt, '_live_tui_session_key', lambda key, profile: key)
+    kb.init_db()
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title='pause probe', assignee='developer')
+        for chat in ('captain-session', 'other-session'):
+            kbn.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=chat,
+                               notifier_profile='captain', delivery_mode='notify+wake')
+    return tid, env
+
+
+def claim(conn, tid, chat='captain-session'):
+    return kbn.claim_unseen_events_for_sub(conn, task_id=tid, platform='tui', chat_id=chat,
+                                         kinds=['blocked'])
+
+
+def test_captain_block_does_not_wake_self_but_other_observer_receives(board):
+    tid, _ = board
+    assert json.loads(kt._handle_block({'task_id': tid, 'reason': 'pause for review'}))['ok']
+    with kbc.connect() as conn:
+        old, new, events = claim(conn, tid)
+        assert events == [], 'Captain already received the tool result; do not wake it again'
+        assert new > old, 'self event must be consumed, not scanned again forever'
+        assert claim(conn, tid) == (new, new, [])
+        assert len(claim(conn, tid, 'other-session')[2]) == 1
+        assert conn.execute("SELECT COUNT(*) FROM task_events WHERE task_id=? AND kind='blocked'", (tid,)).fetchone()[0] == 1
+        assert len(kbn.list_notify_subs(conn, tid)) == 2
