@@ -0,0 +1,147 @@
+"""Managed reassignment must recognize installed custom roles without weakening fences."""
+import json
+import socket
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(home))
+    monkeypatch.setenv("HERMES_PROFILE", "orchestra-captain")
+    for key in ("HERMES_KANBAN_DB", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_TASK", "HERMES_KANBAN_RUN_ID"):
+        monkeypatch.delenv(key, raising=False)
+
+    def no_network(*args, **kwargs):
+        pytest.fail("Reassignment must not contact a provider or network")
+
+    monkeypatch.setattr(socket.socket, "connect", no_network)
+    monkeypatch.setattr(socket, "create_connection", no_network)
+    names = ("crafter-media-gpt", "voice-custom", "reviewer-gpt", "developer-gpt", "tester-gpt")
+    for name in names:
+        profile = home / "profiles" / name
+        profile.mkdir(parents=True)
+        (profile / "config.yaml").write_text("toolsets: [file, kanban]\n")
+        (profile / "profile.yaml").write_text("display_name: Fixture\n")
+    status = {name: {"status": "active"} for name in names}
+    (home / "bot-status.json").write_text(json.dumps({"bots": status}))
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect_closing
+    from hermes_cli.profiles import profile_exists
+    from tools import kanban_tools  # register real production handlers
+    from tools.registry import registry
+
+    assert all(profile_exists(name) for name in names)
+    with connect_closing() as conn:
+        tid = kb.create_task(conn, title="bound local reassignment", assignee="reviewer-gpt", initial_status="blocked")
+    return home, status, tid, kb, connect_closing, registry
+
+
+@pytest.mark.parametrize("target", ["crafter-media-gpt", "voice-custom"])
+def test_installed_active_role_can_receive_cross_role_handoff(board, target):
+    _home, _status, tid, kb, connect, registry = board
+    result = json.loads(registry.dispatch("kanban_reassign", {
+        "task_id": tid, "profile": target, "reason": "Owner assigned this installed role for one scoped correction"}))
+    assert result.get("ok"), result
+    with connect() as conn:
+        task = kb.get_task(conn, tid)
+        assert task.assignee == target
+        assert task.status == "blocked", "ordinary needs-input must not be auto-unblocked"
+        assert task.current_run_id is None and task.claim_lock is None
+        assert any("Owner assigned" in c.body for c in kb.list_comments(conn, tid))
+
+
+def test_installed_custom_role_still_requires_cross_role_reason(board):
+    _home, _status, tid, kb, connect, registry = board
+    result = json.loads(registry.dispatch("kanban_reassign", {"task_id": tid, "profile": "crafter-media-gpt"}))
+    assert "requires a reason" in result.get("error", ""), result
+    with connect() as conn:
+        assert kb.get_task(conn, tid).assignee == "reviewer-gpt"
+
+
+def test_installed_custom_role_still_obeys_active_status(board):
+    home, status, tid, kb, connect, registry = board
+    status["crafter-media-gpt"] = {"status": "paused", "reason": "owner hold"}
+    (home / "bot-status.json").write_text(json.dumps({"bots": status}))
+    result = json.loads(registry.dispatch("kanban_reassign", {"task_id": tid, "profile": "crafter-media-gpt", "reason": "cross-role"}))
+    assert "paused" in result.get("error", ""), result
+    with connect() as conn:
+        assert kb.get_task(conn, tid).assignee == "reviewer-gpt"
+
+
+@pytest.mark.parametrize("target", ["missing-custom", "../escape"])
+def test_status_entry_alone_does_not_register_a_profile(board, target):
+    home, status, tid, kb, connect, registry = board
+    status[target] = {"status": "active"}
+    (home / "bot-status.json").write_text(json.dumps({"bots": status}))
+    result = json.loads(registry.dispatch("kanban_reassign", {"task_id": tid, "profile": target, "reason": "cross-role"}))
+    assert "unknown target role profile" in result.get("error", ""), result
+    with connect() as conn:
+        assert kb.get_task(conn, tid).assignee == "reviewer-gpt"
+
+
+def test_healthy_running_owner_is_not_interrupted(board):
+    _home, _status, tid, kb, connect, registry = board
+    with connect() as conn:
+        assert kb.unblock_task(conn, tid)
+        owner = kb.claim_task(conn, tid, claimer="fixture-original-owner")
+        assert owner is not None
+    result = json.loads(registry.dispatch("kanban_reassign", {"task_id": tid, "profile": "developer-gpt", "reason": "cross-role"}))
+    assert "not interrupting" in result.get("error", ""), result
+    with connect() as conn:
+        task = kb.get_task(conn, tid)
+        assert task.current_run_id == owner.current_run_id
+        assert task.claim_lock == owner.claim_lock and task.assignee == "reviewer-gpt"
+
+
+def test_terminal_card_cannot_be_reassigned(board):
+    _home, _status, tid, kb, connect, registry = board
+    with connect() as conn:
+        assert kb.complete_task(conn, tid, result="fixture complete")
+    result = json.loads(registry.dispatch("kanban_reassign", {"task_id": tid, "profile": "developer-gpt", "reason": "cross-role"}))
+    assert "is done" in result.get("error", ""), result
+    with connect() as conn:
+        task = kb.get_task(conn, tid)
+        assert task.status == "done" and task.assignee == "reviewer-gpt"
+
+
+def test_dispatcher_worker_cannot_use_reassignment_surface(board, monkeypatch):
+    _home, _status, tid, kb, connect, registry = board
+    monkeypatch.setenv("HERMES_KANBAN_TASK", tid)
+    result = json.loads(registry.dispatch("kanban_reassign", {"task_id": tid, "profile": "developer-gpt", "reason": "cross-role"}))
+    assert "orchestrator-only" in result.get("error", ""), result
+    with connect() as conn:
+        assert kb.get_task(conn, tid).assignee == "reviewer-gpt"
+
+
+def test_tombstoned_custom_profile_remains_ineligible(board):
+    home, _status, tid, kb, connect, registry = board
+    from hermes_constants import mark_named_profile_deleted
+    from hermes_cli.profiles import profile_exists
+
+    mark_named_profile_deleted(home / "profiles" / "voice-custom")
+    assert not profile_exists("voice-custom")
+    result = json.loads(registry.dispatch("kanban_reassign", {"task_id": tid, "profile": "voice-custom", "reason": "cross-role"}))
+    assert "unknown target role profile" in result.get("error", ""), result
+    with connect() as conn:
+        assert kb.get_task(conn, tid).assignee == "reviewer-gpt"
+
+
+def test_existing_same_family_role_needs_no_cross_role_reason(board):
+    home, status, tid, kb, connect, registry = board
+    target = "reviewer-agy-claude"
+    profile = home / "profiles" / target
+    profile.mkdir()
+    (profile / "config.yaml").write_text("toolsets: [file, kanban]\n")
+    status[target] = {"status": "active"}
+    (home / "bot-status.json").write_text(json.dumps({"bots": status}))
+    result = json.loads(registry.dispatch("kanban_reassign", {"task_id": tid, "profile": target}))
+    assert result.get("ok"), result
+    with connect() as conn:
+        assert kb.get_task(conn, tid).assignee == target
diff --git a/tests/tools/test_kanban_run_activity.py b/tests/tools/test_kanban_run_activity.py
