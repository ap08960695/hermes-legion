@@ -0,0 +1,59 @@
+"""Per-task model planning depth must reach the real worker invocation."""
+import json
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / 'home'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(home))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    for key in ('HERMES_KANBAN_TASK', 'HERMES_KANBAN_DB', 'HERMES_KANBAN_BOARD', 'HERMES_KANBAN_RUN_ID'):
+        monkeypatch.delenv(key, raising=False)
+    from hermes_cli import kanban_db as kb
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    return kb
+
+
+@pytest.mark.parametrize('model', ['gpt-6.1-sol', 'gpt-6.1-terra'])
+def test_explicit_reasoning_reaches_native_worker_argv(board, monkeypatch, model):
+    from tools import kanban_tools
+    from tools.registry import registry
+    from hermes_cli import kanban_db_connect as kbc, kanban_db_dispatch as dispatcher
+
+    result = json.loads(registry.dispatch('kanban_create', {
+        'title': 'Synthetic planning', 'assignee': 'default', 'workspace_kind': 'scratch',
+        'model': model, 'provider': 'openai-codex', 'reasoning_effort': 'HIGH'}))
+    assert result.get('ok'), result
+    assert result['model_override'] == model
+    assert result['provider_override'] == 'openai-codex'
+    assert result['reasoning_effort'] == 'high'
+    with kbc.connect_closing() as conn:
+        task = board.get_task(conn, result['task_id'])
+    monkeypatch.setattr(dispatcher, '_resolve_hermes_argv', lambda: ['hermes'])
+    monkeypatch.setattr(dispatcher, '_resolve_worker_cli_toolsets', lambda home: [])
+    argv = dispatcher._worker_argv(task, 'default', None)
+    assert argv[argv.index('-m') + 1] == model
+    assert argv[argv.index('--provider') + 1] == 'openai-codex'
+    assert argv[argv.index('--reasoning') + 1] == 'high'
+
+
+def test_invalid_effort_fails_without_creating_a_card_and_omission_inherits(board):
+    from tools import kanban_tools
+    from tools.registry import registry
+    from hermes_cli import kanban_db_connect as kbc
+
+    bad = json.loads(registry.dispatch('kanban_create', {
+        'title': 'Invalid synthetic depth', 'assignee': 'default', 'reasoning_effort': 'strongest'}))
+    assert bad.get('error') and 'reasoning_effort' in bad['error']
+    with kbc.connect_closing() as conn:
+        assert not board.list_tasks(conn)
+    ok = json.loads(registry.dispatch('kanban_create', {'title': 'Inherit', 'assignee': 'default'}))
+    assert ok.get('ok') and ok['reasoning_effort'] is None
+    with kbc.connect_closing() as conn:
+        assert board.get_task(conn, ok['task_id']).reasoning_effort is None
