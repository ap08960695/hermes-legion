+function copy(locale: string) {
+  return locale === 'th' ? th : en
+}
+interface Profile {
+  name: string
+  title?: string
+  bot_title?: string
+  display_name?: string
+  description?: string
+}
+function MembersForm({
+  owner,
+  space,
+  onClose,
+  onSaved
+}: {
+  owner: ResolvedOwner
+  space: Space | null
+  onClose: () => void
+  onSaved: (id?: string) => void
+}) {
+  const t = copy(useI18n().locale),
+    [title, setTitle] = useState(space?.title || ''),
+    [members, setMembers] = useState(space?.members || []),
+    [profiles, setProfiles] = useState<Profile[]>([]),
+    [memberSearch, setMemberSearch] = useState(''),
+    [profilesLoading, setProfilesLoading] = useState(true),
+    [profilesFailed, setProfilesFailed] = useState(false),
+    [profileAttempt, setProfileAttempt] = useState(0),
+    [error, setError] = useState(''),
+    [busy, setBusy] = useState(false)
+  useEffect(() => {
+    let current = true
+    setProfilesLoading(true)
+    setProfilesFailed(false)
+    void hermesApiAs<{ profiles: Profile[] }>(owner, { path: '/api/profiles' })
+      .then(value => {
+        if (current) setProfiles(value.profiles || [])
+      })
+      .catch(() => {
+        if (current) setProfilesFailed(true)
+      })
+      .finally(() => {
+        if (current) setProfilesLoading(false)
+      })
+    return () => {
+      current = false
+    }
+  }, [owner, profileAttempt])
+  const save = async () => {
+    if (profilesLoading || profilesFailed || busy) return
+    setBusy(true)
+    setError('')
+    try {
+      const saved = await request<Space>(
+        owner,
+        space ? '/' + space.id : '',
+        space ? 'PATCH' : 'POST',
+        space ? { members, revision: space.revision } : { title, members }
+      )
+      onSaved(saved.id)
+      onClose()
+    } catch (e) {
+      setError(String(e))
+    } finally {
+      setBusy(false)
+    }
+  }
+  const options = [
+    ...profiles,
+    ...members.filter(name => !profiles.some(profile => profile.name === name)).map(name => ({ name }))
+  ]
+  const shown = options.filter(profile =>
+    `${memberLabel(profile)} ${profile.name}`.toLocaleLowerCase().includes(memberSearch.trim().toLocaleLowerCase())
+  )
+  return (
+    <Dialog
+      open
+      onOpenChange={open => {
+        if (!open && !busy) onClose()
+      }}
+    >
+      <DialogContent aria-describedby={undefined}>
+        <DialogTitle>{space ? t.access : t.create}</DialogTitle>
+        {!space && (
+          <label className="text-xs">
+            {t.name}
+            <input
+              className="mt-2 w-full rounded-md border border-(--ui-stroke-tertiary) bg-background p-2"
+              disabled={busy}
+              value={title}
+              maxLength={200}
+              onChange={e => setTitle(e.target.value)}
+            />
+          </label>
+        )}
+        <SearchField
+          aria-label={t.searchMembers}
+          placeholder={t.searchMembers}
+          value={memberSearch}
+          onChange={setMemberSearch}
+        />
+        <p className="text-xs text-muted-foreground" role="status">
+          {t.selectedMembers}: {members.length}
+        </p>
+        {profilesLoading && <p role="status">{t.loadingProfiles}</p>}
+        {profilesFailed && (
+          <div role="alert">
+            <p>{t.profilesFailed}</p>
+            <Button variant="ghost" onClick={() => setProfileAttempt(n => n + 1)}>
+              {t.retry}
+            </Button>
+          </div>
+        )}
+        <fieldset disabled={busy || profilesLoading || profilesFailed} className="max-h-64 overflow-auto">
+          <legend className="mb-2 text-xs text-muted-foreground">{t.members}</legend>
+          {shown.map(profile => (
+            <label key={profile.name} className="flex items-center gap-2 py-2 text-sm">
+              <input
+                type="checkbox"
+                checked={members.includes(profile.name)}
+                onChange={e =>
+                  setMembers(
+                    e.target.checked ? [...members, profile.name] : members.filter(name => name !== profile.name)
+                  )
+                }
+              />
+              <span>
+                <span className="block">{memberLabel(profile)}</span>
+                <span className="block text-xs text-muted-foreground">
+                  @{profile.name}
+                  {!profilesLoading && !profilesFailed && !profiles.some(row => row.name === profile.name)
+                    ? ` · ${t.unreportedMember}`
+                    : ''}
+                </span>
+              </span>
+            </label>
+          ))}
+        </fieldset>
+        {!shown.length && !profilesLoading && !profilesFailed && <p role="status">{t.noMemberMatches}</p>}
+        {error && (
+          <p role="alert" className="text-sm text-red-500">
+            {error}
+          </p>
+        )}
+        <div className="flex justify-end gap-2">
+          <Button variant="ghost" disabled={busy} onClick={onClose}>
+            {t.cancel}
+          </Button>
+          <Button
+            disabled={busy || profilesLoading || profilesFailed || (!space && !title.trim())}
+            onClick={() => void save()}
+          >
+            {busy ? t.working : t.save}
+          </Button>
+        </div>
+      </DialogContent>
+    </Dialog>
+  )
+}
+function PageEditor({
+  owner,
+  space,
+  item,
+  onClose,
+  onSaved
+}: {
+  owner: ResolvedOwner
+  space: Space
+  item: SpaceItem | null
+  onClose: () => void
+  onSaved: () => void
+}) {
+  const t = copy(useI18n().locale),
+    [title, setTitle] = useState(item?.title || ''),
+    [text, setText] = useState(item?.text || ''),
+    [error, setError] = useState(''),
+    [busy, setBusy] = useState(false),
+    [discarding, setDiscarding] = useState(false)
+  const requestClose = () => {
+    if (busy) return
+    if (title !== (item?.title || '') || text !== (item?.text || '')) setDiscarding(true)
+    else onClose()
+  }
+  const save = async () => {
+    setBusy(true)
+    setError('')
+    try {
+      await request(owner, `/${space.id}/` + (item ? 'items/' + item.id : 'pages'), item ? 'PATCH' : 'POST', {
+        title,
+        text,
+        ...(item ? { revision: item.revision } : {})
+      })
+      onSaved()
+      onClose()
+    } catch (e) {
+      setError(String(e))
+    } finally {
+      setBusy(false)
+    }
+  }
+  return (
+    <Dialog
+      open
+      onOpenChange={open => {
+        if (!open) requestClose()
+      }}
+    >
+      <DialogContent className="w-[min(960px,94vw)] max-w-none" aria-describedby={undefined}>
+        <DialogTitle>{item ? t.edit : t.newPage}</DialogTitle>
+        <label className="text-xs">
+          {t.name}
+          <input
+            className="mt-1 w-full rounded-md border border-(--ui-stroke-tertiary) bg-background p-2"
+            disabled={busy}
+            value={title}
+            maxLength={200}
+            onChange={e => setTitle(e.target.value)}
+          />
+        </label>
+        <label className="text-xs">
+          {t.text}
+          <textarea
+            className="mt-1 h-[45vh] w-full resize-y rounded-md border border-(--ui-stroke-tertiary) bg-background p-3 font-mono text-xs"
+            disabled={busy}
+            value={text}
+            maxLength={1024 * 1024}
+            onChange={e => setText(e.target.value)}
+          />
+        </label>
+        {error && (
+          <p role="alert" className="text-sm text-red-500">
+            {error}
+          </p>
+        )}
+        <div className="flex justify-end gap-2">
+          <Button variant="ghost" disabled={busy} onClick={requestClose}>
+            {t.cancel}
+          </Button>
+          <Button disabled={busy || !title.trim()} onClick={() => void save()}>
+            {busy ? t.working : t.save}
+          </Button>
+        </div>
+        <DiscardPageDraft open={discarding} t={t} onKeep={() => setDiscarding(false)} onDiscard={onClose} />
+      </DialogContent>
+    </Dialog>
+  )
+}
+function hubItems(items: SpaceItem[], filter: string, search: string) {
+  return items.filter(item => {
+    const matchesType =
+      filter === 'all' ||
+      filter === 'trash' ||
+      (filter === 'pages' && item.kind === 'page') ||
+      (filter === 'files' && item.kind === 'file') ||
+      (filter === 'images' && item.mime.startsWith('image/'))
+    return matchesType && item.title.toLowerCase().includes(search.trim().toLowerCase())
+  })
+}
+function ChatFiles({
+  selected,
+  filter,
+  search,
+  revision
+}: {
+  selected: string
+  filter: string
+  search: string
+  revision: number
+}) {
+  const t = copy(useI18n().locale)
+  if (!['all', 'chats'].includes(selected) || ['pages', 'trash'].includes(filter)) return null
+  const kind = ({ files: 'file', images: 'image', links: 'link' } as const)[filter as 'files'] || 'all'
+  return (
+    <section className="mt-6" aria-label={t.fromChats}>
+      <h3 className="mb-3 text-sm font-semibold">{t.fromChats}</h3>
+      <ArtifactsView embedded searchText={search} typeFilter={kind} refreshKey={revision} className="min-h-40" />
+    </section>
+  )
+}
+function HubHeading({ space, selected }: { space: Space | null; selected: string }) {
+  const t = copy(useI18n().locale)
+  return (
+    <div>
+      <h2 className="text-lg font-semibold">{space?.title || (selected === 'chats' ? t.fromChats : t.allItems)}</h2>
+      <p className="mt-1 text-xs text-muted-foreground">
+        {space ? (space.members.length ? space.members.join(' · ') : t.private) : t.hint}
+      </p>
+    </div>
+  )
+}
+export function SpacesPage() {
+  const scope = useStore($apiRequestScope),
+    owner = useMemo(() => resolveOwnerNow(), [scope.connectionId, scope.profile])
+  return <SpaceWorkspace key={JSON.stringify(owner)} owner={owner} />
+}
+function SpaceWorkspace({ owner }: { owner: ResolvedOwner }) {
+  const t = copy(useI18n().locale),
+    [spaces, setSpaces] = useState<Space[]>([]),
+    [selected, setSelected] = useState<string>('all'),
+    [items, setItems] = useState<SpaceItem[]>([]),
+    [itemsLoading, setItemsLoading] = useState(true),
+    [opened, setOpened] = useState<SpaceItem | null>(null),
+    [filter, setFilter] = useState('all'),
+    [search, setSearch] = useState(''),
+    [error, setError] = useState(''),
+    [busy, setBusy] = useState(false),
+    [revision, setRevision] = useState(0),
+    [access, setAccess] = useState<'create' | 'edit' | null>(null),
+    [editing, setEditing] = useState<SpaceItem | null | undefined>(undefined),
+    [removing, setRemoving] = useState<SpaceItem | null>(null)
+  const viewContext = useRef('')
+  const viewRequest = useRef(0)
+  viewContext.current = JSON.stringify([selected, filter, revision])
+  useEffect(
+    () => () => {
+      viewRequest.current++
+    },
+    []
+  )
+  const trash = filter === 'trash'
+  const space = spaces.find(row => row.id === selected) || null
+  const refresh = () => {
+    setRevision(n => n + 1)
+    setOpened(null)
+  }
+  useEffect(() => {
+    let current = true
+    void request<{ spaces: Space[] }>(owner, '')
+      .then(value => {
+        if (current) {
+          setSpaces(value.spaces)
+          setSelected(id => id || 'all')
+        }
+      })
+      .catch(e => {
+        if (current) setError(String(e))
+      })
+    return () => {
+      current = false
+    }
+  }, [owner, revision])
+  useEffect(() => {
+    let current = true
+    setItems([])
+    setOpened(null)
+    setError('')
+    setItemsLoading(selected !== 'chats')
+    if (selected === 'chats') return
+    void request<{ items: SpaceItem[] }>(owner, selected === 'all' ? '/all-items' : `/${selected}/items?trash=${trash}`)
+      .then(value => {
+        if (current) setItems(value.items)
+      })
+      .catch(e => {
+        if (current) setError(String(e))
+      })
+      .finally(() => {
+        if (current) setItemsLoading(false)
+      })
+    return () => {
+      current = false
+    }
+  }, [owner, selected, trash, revision])
+  const view = async (item: SpaceItem) => {
+    if (item.kind === 'file' && item.preview_state !== 'ready') return
+    const context = viewContext.current
+    const requestId = ++viewRequest.current
+    setError('')
+    try {
+      const value = await request<SpaceItem>(owner, `/${item.space_id}/items/${item.id}`)
+      if (viewContext.current === context && viewRequest.current === requestId) setOpened(value)
+    } catch (e) {
+      if (viewContext.current === context && viewRequest.current === requestId) setError(String(e))
+    }
+  }
+  const upload = async () => {
+    if (!space || !window.hermesDesktop) return
+    setBusy(true)
+    setError('')
+    try {
+      const paths = await window.hermesDesktop.selectPaths({ multiple: true, directories: false, title: t.addFiles })
+      for (const path of paths.slice(0, 16)) {
+        const name = path.split(/[\\/]/).pop() || ''
+        if (/^(?:\.env(?:\..*)?|auth\.json|credentials|config\.yaml)$/i.test(name))
+          throw new Error('Credential files cannot be shared')
+        const info = await window.hermesDesktop.readFileText(path)
+        if ('error' in info) throw new Error(info.error)
+        if (typeof info.byteSize !== 'number' || info.byteSize > 8 * 1024 * 1024)
+          throw new Error('Space files are limited to 8 MB')
+        const data = await window.hermesDesktop.readFileDataUrl(path)
+        if (typeof data !== 'string') throw new Error(data.error)
+        await request(owner, `/${space.id}/files`, 'POST', { filename: name, data_url: data })
+      }
+      refresh()
+    } catch (e) {
+      setError(String(e))
+    } finally {
+      setBusy(false)
+    }
+  }
+  const remove = async (item: SpaceItem, deleted: boolean) => {
+    setBusy(true)
+    try {
+      await request(owner, `/${item.space_id}/items/${item.id}`, 'PATCH', { revision: item.revision, deleted })
+      setRemoving(null)
+      refresh()
+    } catch (e) {
+      setError(String(e))
+    } finally {
+      setBusy(false)
+    }
+  }
+  const shown = hubItems(items, filter, search)
+  return (
+    <section className="flex h-full min-h-0 flex-col bg-background text-(--ui-text-primary)">
+      <header className="flex flex-wrap items-center justify-between gap-3 border-b border-(--ui-stroke-tertiary) px-6 py-5">
+        <div>
+          <h1 className="text-xl font-semibold">{t.title}</h1>
+          <p className="mt-1 text-xs text-muted-foreground">{t.hint}</p>
+        </div>
+        <div className="flex gap-2">
+          <Button variant="ghost" size="sm" onClick={refresh}>
+            <Codicon name="refresh" />
+            {t.refresh}
+          </Button>
+          <Button size="sm" onClick={() => setAccess('create')}>
+            <Codicon name="add" />
+            {t.create}
+          </Button>
+        </div>
+      </header>
+      <div className="flex min-h-0 flex-1 flex-col md:flex-row">
+        <aside className="flex gap-1 overflow-auto border-b border-(--ui-stroke-tertiary) p-3 md:w-52 md:shrink-0 md:flex-col md:border-r md:border-b-0">
+          <Button
+            variant={selected === 'all' ? 'secondary' : 'ghost'}
+            className="shrink-0 justify-start"
+            onClick={() => {
+              setSelected('all')
+              setFilter('all')
+            }}
+          >
+            <Codicon name="files" />
+            {t.allItems}
+          </Button>
+          <Button
+            variant={selected === 'chats' ? 'secondary' : 'ghost'}
+            className="shrink-0 justify-start"
+            onClick={() => {
+              setSelected('chats')
+              setFilter('all')
+            }}
+          >
+            <Codicon name="comment-discussion" />
+            {t.fromChats}
+          </Button>
+          <p className="px-2 pt-4 pb-2 text-xs text-muted-foreground">{t.collections}</p>
+          {spaces.map(row => (
+            <Button
+              key={row.id}
+              className="shrink-0 justify-start"
+              variant={selected === row.id ? 'secondary' : 'ghost'}
+              onClick={() => {
+                setSelected(row.id)
+                setFilter('all')
+              }}
+            >
+              <Codicon name="library" />
+              {row.title}
+            </Button>
+          ))}
+        </aside>
+        <main className="min-h-0 min-w-0 flex-1 overflow-auto p-5">
+          {selected ? (
+            <>
+              <div className="flex flex-wrap items-center justify-between gap-2">
+                <HubHeading space={space} selected={selected} />
+                {space && (
+                  <div className="flex gap-2">
+                    <CopyButton
+                      label={t.botReference}
+                      text={`Shared Space: ${space.title} (${space.id}). Read on demand using the existing terminal: python -m hermes_cli.spaces items ${space.id}; python -m hermes_cli.spaces read ${space.id} ITEM_ID --limit 8000. Export needed binary files with --output inside your workspace. Reuse unchanged revisions; do not include the entire Space in every prompt.`}
+                    />
+                    <Button size="icon-sm" variant="ghost" aria-label={t.access} onClick={() => setAccess('edit')}>
+                      <Codicon name="organization" />
+                    </Button>
+                    <Button size="sm" variant="outline" disabled={busy} onClick={() => void upload()}>
+                      <Codicon name="cloud-upload" />
+                      {t.addFiles}
+                    </Button>
+                    <Button size="sm" onClick={() => setEditing(null)}>
+                      <Codicon name="new-file" />
+                      {t.newPage}
+                    </Button>
+                  </div>
+                )}
+              </div>
+              <div className="my-5 flex flex-wrap gap-2">
+                <input
+                  className="min-w-40 flex-1 rounded-md border border-(--ui-stroke-tertiary) bg-background px-3 py-2 text-sm"
+                  aria-label={t.search}
+                  placeholder={space ? `${t.search} · ${space.title}` : t.search}
+                  value={search}
+                  onChange={e => setSearch(e.target.value)}
+                />
+                <div className="flex gap-1">
+                  {(['all', 'pages', 'files', 'images', 'links', ...(space ? ['trash' as const] : [])] as const).map(
+                    value => (
+                      <Button
+                        key={value}
+                        size="sm"
+                        variant={filter === value ? 'secondary' : 'ghost'}
+                        onClick={() => setFilter(value)}
+                      >
+                        {t[value]}
+                      </Button>
+                    )
+                  )}
+                </div>
+              </div>
+              <HubItemsLoading pending={itemsLoading} />
+              {error && <ErrorState title={error} />}
+              <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
+                {shown.map(item => (
+                  <article
+                    key={item.id}
+                    className="rounded-xl border border-(--ui-stroke-tertiary) bg-(--ui-bg-elevated) p-4"
+                  >
+                    <div className="flex items-start justify-between gap-2">
+                      <button
+                        type="button"
+                        disabled={filter === 'trash' || (item.kind === 'file' && item.preview_state !== 'ready')}
+                        className="min-w-0 text-left disabled:opacity-60"
+                        onClick={() => void view(item)}
+                      >
+                        <Codicon name={item.kind === 'page' ? 'file-text' : 'file'} />
+                        <h3 className="mt-3 truncate text-sm font-semibold">{item.title}</h3>
+                        {selected === 'all' && (
+                          <p className="mt-1 text-xs text-muted-foreground">{item.collection_title}</p>
+                        )}
+                      </button>
+                      <Button
+                        size="icon-sm"
+                        variant="ghost"
+                        aria-label={filter === 'trash' ? t.restore : t.remove}
+                        disabled={busy}
+                        onClick={() => (filter === 'trash' ? void remove(item, false) : setRemoving(item))}
+                      >
+                        <Codicon name={filter === 'trash' ? 'discard' : 'trash'} />
+                      </Button>
+                    </div>
+                    <p className="mt-3 text-[11px] text-muted-foreground">
+                      {item.kind === 'page' ? t.pages : t.files} · {item.byte_size.toLocaleString()} B · v
+                      {item.revision}
+                    </p>
+                    {item.kind === 'file' && item.preview_state !== 'ready' && (
+                      <p className="mt-2 text-xs text-muted-foreground">{t.preview}</p>
+                    )}
+                  </article>
+                ))}
+              </div>
+              <ChatFiles selected={selected} filter={filter} search={search} revision={revision} />
+              {!shown.length && !error && space && (
+                <HubSearchEmptyState
+                  loading={itemsLoading}
+                  title={space.title}
+                  search={search}
+                  filter={filter}
+                  onClear={() => {
+                    setSearch('')
+                    setFilter('all')
