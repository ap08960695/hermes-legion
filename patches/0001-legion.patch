+    assert keys[0]==keys[2] and keys[0]!=keys[1]
+    assert (tmp_path/'a/telemetry/cache-diagnostics/fingerprint.key').stat().st_mode & 0o777==0o600
+    kw={'session_id':'same','request_id':'a','base_url':'https://chatgpt.com'}
+    assert fingerprint(request(),key=keys[0],**kw)['history']!=fingerprint(request(),key=keys[1],**kw)['history']
+
+
+def test_missing_usage_is_unknown_not_zero(monkeypatch,caplog):
+    with caplog.at_level(logging.INFO):
+        invoke(monkeypatch,request(),lambda _:SimpleNamespace(usage=SimpleNamespace(input_tokens=10)))
+    assert records(caplog)[0]['usage']['cached_tokens'] is None
+
+
+def test_diagnostic_failure_cannot_retry_or_hide_provider_failure(monkeypatch,caplog):
+    import pytest
+    from agent import cache_request_diagnostics as diag
+    def broken(): raise OSError('SECRET must not be logged')
