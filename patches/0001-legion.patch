--- /dev/null
+++ b/tests/agent/test_context_reference_growing_files.py
@@ -0,0 +1,96 @@
+"""A file growing after stat must not bypass context-preview read budgets."""
+import asyncio
+from pathlib import Path
+
+from agent.context_references import _file_metadata, preprocess_context_references_async
+
+
+class _CountedFile:
+    def __init__(self, stream, stats, key):
+        self.stream, self.stats, self.key = stream, stats, key
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *args):
+        return self.stream.__exit__(*args)
+
+    def __getattr__(self, name):
+        return getattr(self.stream, name)
+
+    def read(self, *args, **kwargs):
+        data = self.stream.read(*args, **kwargs)
+        self.stats[self.key] += len(data)
+        return data
+
+
+def _grow_on_open(monkeypatch, path, *, metadata=False):
+    """Real append at the stat/open boundary, with actual consumed bytes counted."""
+    original_open = Path.open
+    stats = {"text_chars": 0, "binary_bytes": 0, "binary_opens": 0, "grew": False}
+
+    def open_file(current, mode="r", *args, **kwargs):
+        if current != path:
+            return original_open(current, mode, *args, **kwargs)
+        binary = "b" in mode
+        if binary:
+            stats["binary_opens"] += 1
+        trigger = stats["binary_opens"] == 2 if metadata else not binary
+        if trigger and not stats["grew"]:
+            with original_open(path, "ab") as writer:
+                chunk = b"x" * 65536
+                for _ in range(128):
+                    writer.write(chunk)
+            stats["grew"] = True
+        stream = original_open(current, mode, *args, **kwargs)
+        return _CountedFile(stream, stats, "binary_bytes" if binary else "text_chars")
+
+    monkeypatch.setattr(Path, "open", open_file)
+    return stats
+
+
+def test_growing_attachment_reads_only_inline_budget(tmp_path, monkeypatch):
+    path = tmp_path / "growing.txt"
+    path.write_text("small\n")
+    stats = _grow_on_open(monkeypatch, path)
+    result = asyncio.run(preprocess_context_references_async(
+        "Inspect @file:growing.txt", cwd=tmp_path, context_length=1024))
+    assert stats["grew"]
+    assert result.message.startswith("Inspect @file:growing.txt")
+    assert "too large to inline safely" in result.message
+    assert not result.blocked
+    assert stats["text_chars"] <= 2049
+
+
+def test_growing_folder_entry_does_not_scan_to_eof(tmp_path, monkeypatch):
+    path = tmp_path / "growing.txt"
+    path.write_text("small\n")
+    stats = _grow_on_open(monkeypatch, path, metadata=True)
+    result = _file_metadata(path)
+    assert stats["grew"]
+    assert result == f"{path.stat().st_size} bytes"
+    assert stats["binary_bytes"] <= 4 * 1024 * 1024 + 4097
+
+
+def test_small_bom_and_unicode_attachment_keeps_complete_text(tmp_path):
+    path = tmp_path / "small.txt"
+    path.write_text("First line\nUnicode: café 世界\n", encoding="utf-8-sig")
+    result = asyncio.run(preprocess_context_references_async(
+        "Inspect @file:small.txt", cwd=tmp_path, context_length=4000))
+    assert "First line\nUnicode: café 世界\n" in result.message
+    assert "\ufeff" not in result.message
+    assert not result.blocked
+
+
+def test_small_folder_entry_still_reports_line_count(tmp_path):
+    path = tmp_path / "small.txt"
+    path.write_text("first\nsecond")
+    assert _file_metadata(path) == "2 lines"
+
+
+def test_metadata_file_exactly_at_read_limit_is_not_truncated(tmp_path):
+    path = tmp_path / "boundary.txt"
+    with path.open("wb") as stream:
+        for _ in range(64):
+            stream.write(b"x" * 65536)
+    assert _file_metadata(path) == "1 lines"
