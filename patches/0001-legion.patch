+from pathlib import Path
+import pytest
+from hermes_cli.spaces import Spaces,SpaceDenied,SpaceConflict
+
+def test_shared_members_read_the_same_version_nonmembers_cannot_read(tmp_path):
+    store=Spaces(tmp_path);space=store.create('Example project',['writer','reviewer'])
+    page=store.add(space['id'],'Brief',b'# Shared brief','page','text/markdown')
+    assert store.read(space['id'],page['id'],'writer')['data']==store.read(space['id'],page['id'],'reviewer')['data']
+    assert store.list('other')==[]
+    with pytest.raises(SpaceDenied):store.read(space['id'],page['id'],'other')
+    updated=store.save_page(space['id'],page['id'],'Brief','Updated',page['revision'])
+    assert store.read(space['id'],page['id'],'reviewer')['revision']==updated['revision']
+    with pytest.raises(SpaceConflict):store.save_page(space['id'],page['id'],'Brief','stale',page['revision'])
+
+def test_removal_is_recoverable_and_never_changes_the_original_file(tmp_path):
+    original=tmp_path/'source.txt';original.write_bytes(b'original bytes')
+    store=Spaces(tmp_path);space=store.create('Files',['writer']);item=store.add(space['id'],'source.txt',original.read_bytes(),mime='text/plain')
+    removed=store.remove(space['id'],item['id'],item['revision'])
+    assert store.items(space['id'],'writer')==[]
+    with pytest.raises(KeyError):store.read(space['id'],item['id'],'writer')
+    assert original.read_bytes()==b'original bytes'
+    store.remove(space['id'],item['id'],removed['revision'],False)
+    assert store.read(space['id'],item['id'],'writer')['data']==original.read_bytes()
+
+def test_private_empty_default_and_membership_revocation(tmp_path):
+    store=Spaces(tmp_path);assert store.list()==[];assert not store.path.exists()
+    space=store.create('Private',[]);page=store.add(space['id'],'Notes',b'private','page','text/markdown')
+    assert store.list('writer')==[]
+    allowed=store.members(space['id'],['writer'],space['revision']);assert store.read(space['id'],page['id'],'writer')['data']==b'private'
+    store.members(space['id'],[],allowed['revision'])
+    with pytest.raises(SpaceDenied):store.read(space['id'],page['id'],'writer')
+
+
+def test_owner_api_import_remove_restore_and_optimistic_conflict(tmp_path,monkeypatch):
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+    from hermes_cli.web_routers import spaces as routes
+    import base64
+    store=Spaces(tmp_path)
+    monkeypatch.setattr(routes,'Spaces',lambda:store)
+    monkeypatch.setattr(routes,'_members',lambda values:values)
+    app=FastAPI();app.include_router(routes.router);client=TestClient(app)
+    space=client.post('/api/spaces',json={'title':'Shared','members':['writer','reviewer']}).json()
+    sid=space['id']
+    page=client.post(f'/api/spaces/{sid}/pages',json={'title':'Plan','text':'Shared plan'}).json()
+    file=client.post(f'/api/spaces/{sid}/files',json={'filename':'example.txt','data_url':'data:text/plain;base64,'+base64.b64encode(b'Shared file bytes').decode()}).json()
+    assert client.get(f'/api/spaces/{sid}/items/{file["id"]}').json()['preview']['text']=='Shared file bytes'
+    assert store.read(sid,page['id'],'writer')['data']==store.read(sid,page['id'],'reviewer')['data']
+    change=client.patch(f'/api/spaces/{sid}/items/{file["id"]}',json={'revision':1,'deleted':True})
+    assert change.status_code==200
+    assert client.get(f'/api/spaces/{sid}/items/{file["id"]}').status_code==404
+    assert client.patch(f'/api/spaces/{sid}/items/{file["id"]}',json={'revision':1,'deleted':False}).status_code==409
+    assert client.patch(f'/api/spaces/{sid}/items/{file["id"]}',json={'revision':2,'deleted':False}).status_code==200
+    assert store.read(sid,file['id'],'writer')['data']==b'Shared file bytes'
+
+
+def test_bot_cli_is_bounded_read_only_and_never_overwrites_an_existing_export(tmp_path,monkeypatch,capsys):
+    from hermes_cli import spaces,profiles
+    store=Spaces(tmp_path);space=store.create('CLI',['writer']);page=store.add(space['id'],'Plan',b'x'*20000,'page','text/markdown')
+    monkeypatch.setattr(spaces,'Spaces',lambda:store)
+    monkeypatch.setattr(profiles,'get_active_profile_name',lambda:'writer')
+    assert spaces.main(['read',space['id'],page['id']])==0
+    import json
+    output=json.loads(capsys.readouterr().out);assert len(output['text'])==8000;assert output['next_offset']==8000
+    target=tmp_path/'export.md'
+    assert spaces.main(['export',space['id'],page['id'],'--output',str(target)])==0
+    assert target.read_bytes()==b'x'*20000
+    with pytest.raises(SystemExit):spaces.main(['export',space['id'],page['id'],'--output',str(target)])
+    assert target.read_bytes()==b'x'*20000
+
+
+def test_native_profile_homes_share_one_store_and_cli_membership(tmp_path,monkeypatch,capsys):
+    from hermes_cli import spaces
+    from hermes_constants import get_default_hermes_root
+    import json
+    root=tmp_path/'isolated-hermes';root.mkdir()
+    for name in ['writer','reviewer','other']:(root/'profiles'/name).mkdir(parents=True)
+    monkeypatch.delenv('HERMES_PROFILE_NAME',raising=False)
+    monkeypatch.delenv('HERMES_PROFILE',raising=False)
+    monkeypatch.setenv('HERMES_HOME',str(root))
+    store=spaces.Spaces();space=store.create('Shared',['writer','reviewer']);page=store.add(space['id'],'Plan',b'One source version','page','text/markdown')
+    hashes=[]
+    for name in ['writer','reviewer']:
+        monkeypatch.setenv('HERMES_HOME',str(root/'profiles'/name))
+        assert spaces.Spaces().path==store.path
+        assert spaces.main(['read',space['id'],page['id']])==0
+        result=json.loads(capsys.readouterr().out);hashes.append(result['sha256']);assert result['text']=='One source version'
+    assert hashes[0]==hashes[1]
+    monkeypatch.setenv('HERMES_HOME',str(root/'profiles'/'other'))
+    with pytest.raises(SystemExit):spaces.main(['read',space['id'],page['id']])
+
+
+def test_owner_catalog_is_bounded_metadata_not_content_or_bot_permission(tmp_path,monkeypatch):
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+    from hermes_cli.web_routers import spaces as routes
+    store=Spaces(tmp_path);one=store.create('First',['writer']);two=store.create('Second',[])
+    page=store.add(one['id'],'Shared note',b'private content','page','text/markdown')
+    hidden=store.add(two['id'],'Removed',b'removed content','page','text/markdown');store.remove(two['id'],hidden['id'],1)
+    monkeypatch.setattr(routes,'Spaces',lambda:store)
+    app=FastAPI();app.include_router(routes.router);client=TestClient(app)
+    response=client.get('/api/spaces/all-items');assert response.status_code==200
+    rows=response.json()['items'];assert len(rows)==1 and rows[0]['id']==page['id'] and rows[0]['collection_title']=='First'
+    assert 'data' not in rows[0] and 'text' not in rows[0] and 'private content' not in response.text
+    with pytest.raises(SpaceDenied):store.read(one['id'],page['id'],'other')
