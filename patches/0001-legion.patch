+        onSave={save}
+        onClose={vi.fn()}
+      />
+    )
+    fireEvent.change(screen.getByLabelText('title'), { target: { value: 'Finish the UI' } })
+    fireEvent.change(screen.getByLabelText('verification'), { target: { value: 'Tests pass' } })
+    fireEvent.click(screen.getByRole('checkbox', { name: 'offline-review' }))
+    fireEvent.click(screen.getByRole('button', { name: 'save' }))
+    await waitFor(() => expect(save).toHaveBeenCalledTimes(1))
+    expect(save.mock.calls[0]).toEqual([
+      'original-runtime',
+      expect.objectContaining({
+        expected_revision: 'rev-1',
+        title: 'Finish the UI',
+        contract: expect.objectContaining({
+          verification: 'Tests pass',
+          constraints: expect.stringContaining('offline-review')
+        })
+      })
+    ])
+  })
+  it('preserves edits on a refused save and never saves while busy or whitespace-only', async () => {
+    const save = vi.fn(async (_id: string, _args: GoalFormArgs) => {
+      throw new Error('State changed')
+    })
+    const props = {
+      open: true,
+      sessionId: 'original-runtime',
+      revision: 'rev-1',
+      goal: { title: 'Original', status: 'active' as const, contract },
+      skills: [],
+      t,
+      onSave: save,
+      onClose: vi.fn()
+    }
+    const view = render(<GoalEditor {...props} busy />)
+    expect((screen.getByRole('button', { name: 'save' }) as HTMLButtonElement).disabled).toBe(true)
+    fireEvent.change(screen.getByLabelText('title'), { target: { value: 'Owner draft' } })
+    view.rerender(<GoalEditor {...props} busy={false} revision="newer" />)
+    fireEvent.click(screen.getByRole('button', { name: 'save' }))
+    await screen.findByRole('alert')
+    expect((screen.getByLabelText('title') as HTMLInputElement).value).toBe('Owner draft')
+    expect(save.mock.calls[0][1].expected_revision).toBe('rev-1')
+    fireEvent.change(screen.getByLabelText('title'), { target: { value: '   ' } })
+    expect((screen.getByRole('button', { name: 'save' }) as HTMLButtonElement).disabled).toBe(true)
+  })
+  it('contains Ctrl+Enter inside the editor and retains a draft after Escape', () => {
+    const save = vi.fn(async (_id: string, _args: GoalFormArgs) => {}),
+      close = vi.fn(),
+      composerKey = vi.fn()
+    const props = {
+      sessionId: 'original-runtime',
+      revision: 'rev-1',
+      goal: null,
+      busy: false,
+      skills: [],
+      t,
+      onSave: save,
+      onClose: close
+    }
+    const view = render(
+      <div onKeyDown={composerKey}>
+        <GoalEditor {...props} open />
