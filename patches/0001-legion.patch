+"""Read-only observed usage attribution: python -m hermes_cli.usage_attribution --home PATH.
+
+Matching logged fields and failed calls are investigation signals, never proof of waste.
+"""
+import argparse
+from collections import Counter, defaultdict
+import json
+import math
+from pathlib import Path
+import re
+import time
+
+_REASONS={'initial','revision','reopened','review_reopened','review_handoff','quota_retry','recovery','unknown'}
+
+
+def mapping(value):
+    return value if isinstance(value,dict) else {}
+
+
+def number(value):
+    return isinstance(value,(int,float)) and not isinstance(value,bool) and math.isfinite(value) and value>=0
+
+
+def digest(value):
+    value=mapping(value)
+    text=value.get('hash')
+    return text if value.get('complete') is True and isinstance(text,str) and re.fullmatch('[0-9a-f]{64}',text) else None
+
+
+def normalize(raw,start,end):
+    raw=mapping(raw);fp=mapping(raw.get('fingerprint'));cross=mapping(fp.get('cross_bot'));fields=mapping(cross.get('fields'))
+    stamp=cross.get('started_at_ns');pid=raw.get('process_id');namespace=cross.get('namespace')
+    if not number(stamp) or not number(pid) or not isinstance(namespace,str) or not re.fullmatch('[0-9a-f]{16}',namespace):return None
+    at=stamp/1e9
+    profile,request=digest(fields.get('profile')),digest(fields.get('request'))
+    if not start<=at<end or not profile or not request:return None
+    values=tuple(digest(fp.get(k)) for k in ('session','route','instructions','tools','options','history'))
+    key=fp.get('key_id');key=key if isinstance(key,str) and re.fullmatch('[0-9a-f]{16}',key) else None
+    signature=(namespace,profile,key,*values) if all(values) and isinstance(key,str) and re.fullmatch('[0-9a-f]{16}',key) else None
+    usage=mapping(raw.get('usage'));total=usage.get('input_tokens');cached=usage.get('cached_tokens')
+    total=total if type(total) is int and total>=0 else None
+    cached=cached if type(cached) is int and total is not None and 0<=cached<=total else None
+    status=raw.get('status') if raw.get('status') in ('returned','failed_or_interrupted') else 'unknown'
+    return {'identity':(namespace,profile,pid,stamp,request),'signature':signature,'at':at,'pid':pid,'status':status,'input':total,'cached':cached,'binding':digest(fp.get('task_run')),'key_id':key,'has_binding': 'task_run' in fp}
+
+
+def correlate(records,runs,end):
+    by_pid=defaultdict(list);by_binding=defaultdict(list)
+    for run in runs:
+        if number(run.get('worker_pid')):by_pid[run['worker_pid']].append(run)
+        for binding in run.get('bindings',[]):by_binding[binding].append(run)
+    reasons={};outcomes={};matched=0;ambiguous=0;completed={};exact=0;legacy=0
+    for record in records:
+        if record['has_binding']:
+            candidates=[r for r in by_binding[(record['key_id'],record['binding'])] if _run_contains(r,record['at'],end)] if record['binding'] else []
+        else:
+            candidates=[r for r in by_pid[record['pid']] if _contains(r,record['at'],end)]
+        if len(candidates)!=1:
+            ambiguous+=len(candidates)>1
+            continue
+        run=candidates[0];matched+=1;exact+=record['has_binding'];legacy+=not record['has_binding']
+        _add_reason(reasons,run,record)
+        _add_outcome(outcomes,run,record)
+        if run.get('outcome')=='completed':
+            key=(run['board'],run['task_id']);value=completed.setdefault(key,{'tokens':0,'known':False})
+            value['tokens']+=record['input'] or 0;value['known']|=record['input'] is not None
+    known=[r['tokens'] for r in completed.values() if r['known']]
+    return {'evidence':'dispatcher-pinned HMAC binding validated against native run/time; legacy PID correlation reported separately',
+            'matched_attempts':matched,'bound_attempts':exact,'legacy_pid_correlated_attempts':legacy,
+            'binding_present_attempts':sum(r['binding'] is not None for r in records),
+            'ambiguous_attempts':ambiguous,'unmatched_attempts':len(records)-matched,
+            'by_reason':reasons,'by_native_outcome':outcomes,'completed_cards_with_known_sample':len(known),
+            'completed_card_input_tokens_per_card':sum(known)/len(known) if known else None}
+
+
+def _add_reason(reasons,run,record):
+    reason=run.get('attempt_reason')
+    reason=reason if isinstance(reason,str) and reason in _REASONS else 'unknown'
+    row=reasons.setdefault(reason,{'attempts':0,'input_tokens':0,'unknown_usage_attempts':0})
+    row['attempts']+=1;row['input_tokens']+=record['input'] or 0;row['unknown_usage_attempts']+=record['input'] is None
+
+
+
+def _add_outcome(outcomes,run,record):
+    outcome=run.get('outcome')
+    allowed={'completed','blocked','review_requested','rate_limited','crashed','timed_out','reclaimed','spawn_failed','protocol_violation','cancelled','interrupted'}
+    outcome=outcome if isinstance(outcome,str) and outcome in allowed else 'running_or_unknown'
+    row=outcomes.setdefault(outcome,{'attempts':0,'input_tokens':0,'cached_tokens':0,'unknown_usage_attempts':0})
+    row['attempts']+=1;row['input_tokens']+=record['input'] or 0;row['cached_tokens']+=record['cached'] or 0
+    row['unknown_usage_attempts']+=record['input'] is None
+
+def _run_contains(run,at,end):
+    start=run.get('started_at');stop=run.get('ended_at')
+    stop=end if stop is None else stop
+    return all(number(v) for v in (start,stop)) and start<=at<=stop
+
+
+def _contains(run,at,end):
+    start=run.get('started_at');created=run.get('worker_started_at');stop=run.get('ended_at')
+    stop=end if stop is None else stop
+    return all(number(v) for v in (start,created,stop)) and max(start,created)<=at<=stop
+
+
+def analyze(raw_records,runs,start,end):
+    if not number(start) or not number(end) or end<=start:raise ValueError('invalid observation window')
+    unique={};copies=0;unusable=0
+    for raw in raw_records:
+        row=normalize(raw,start,end)
+        if row is None:unusable+=1;continue
+        if row['identity'] in unique:copies+=1;continue
+        unique[row['identity']]=row
+    rows=sorted(unique.values(),key=lambda x:x['at']);groups=defaultdict(list)
+    for row in rows:
+        if row['signature'] is not None:groups[row['signature']].append(row)
+    extras=[r for group in groups.values() for r in group[1:]]
+    total=sum(r['input'] for r in rows if r['input'] is not None)
+    return {'window_start':start,'window_end':end,'window_hours':(end-start)/3600,
+            'observed_attempts':len(rows),'duplicate_log_copies':copies,'unusable_or_outside_window':unusable,
+            'status_counts':dict(Counter(r['status'] for r in rows)),
+            'failed_or_interrupted_attempts':sum(r['status']=='failed_or_interrupted' for r in rows),
+            'known_input_tokens':total,'known_cached_tokens':sum(r['cached'] or 0 for r in rows),
+            'unknown_usage_attempts':sum(r['input'] is None for r in rows),
+            'unknown_cached_usage_attempts':sum(r['cached'] is None for r in rows),
+            'per_24h_input_tokens_observed_scaled':total*86400/(end-start),
+            'per_24h_attempts_observed_scaled':len(rows)*86400/(end-start),
+            'matching_logged_fields':{'extra_attempts':len(extras),'known_input_tokens':sum(r['input'] or 0 for r in extras),
+                                     'unknown_usage_attempts':sum(r['input'] is None for r in extras),
+                                     'proven_duplicate_work':False},
+            'run_correlation':correlate(rows,runs,end),'proven_wasted_tokens':None,
+            'read_redundancy_cost':None,'cancelled_work_cost':None,
+            'first_observed_start':rows[0]['at'] if rows else None,'last_observed_start':rows[-1]['at'] if rows else None,
+            'limits':['Only logged preparation fields match, not complete SDK wire bytes; intentional repeats remain possible.',
+                      'Failures/interruption cannot be separated by this logger; missing usage is unknown, never zero.',
+                      'Read arguments and cancellation cause are unavailable; native attempt reasons do not establish waste or authorize suppression.',
+                      'Cached input is still usage; neither cache hits nor recovery attempts are inherently waste.',
+                      'Totals and per-completed-card samples have incomplete log coverage and are lower bounds, not causal savings.']}
+
+
+def main():
+    from hermes_cli.usage_attribution_sources import collect
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--home',type=Path,required=True);parser.add_argument('--hours',type=float,default=24)
+    parser.add_argument("--max-log-files",type=int,default=32,help="Maximum recent uncompressed logs to read (1-512; default 32, up to 2 MiB per file)")
+    args=parser.parse_args()
+    if not 1<=args.max_log_files<=512:parser.error("--max-log-files must be within [1,512]")
+    if not 0<args.hours<=168:parser.error('--hours must be within (0,168]')
+    end=time.time();start=end-args.hours*3600
+    records,runs,coverage=collect(args.home,start,end,max_log_files=args.max_log_files)
+    print(json.dumps({**analyze(records,runs,start,end),'coverage':coverage,'model_calls':0,'runtime_mutations':0},indent=2))
+
+
+if __name__=='__main__':main()
