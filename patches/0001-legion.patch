+"""New public-prefix groups reuse keys; legacy and foreign routes remain isolated."""
+from agent.transports.codex import ResponsesApiTransport
+from agent.shared_prompt_cache import HEADER, END
+
+
+def build(sid, text, url='https://chatgpt.com/backend-api/codex', **extra):
+    return ResponsesApiTransport().build_kwargs(model='gpt-6.1-sol',
+        messages=[{'role':'system','content':text},{'role':'user','content':'task'}],
+        tools=[{'type':'function','function':{'name':'read_file','parameters':{'type':'object'}}}],
+        session_id=sid,cache_scope_id=sid,base_url=url,is_codex_backend=url.startswith('https://chatgpt.com'),**extra)
+
+
+def test_same_common_prefix_shares_routing_without_private_history_merging():
+    common=HEADER+'\n\ncommon rules\n\n'+END
+    a=build('session-a',common+'\n\nRole A private context')
+    b=build('session-b',common+'\n\nRole B private context')
+    assert a['prompt_cache_key']==b['prompt_cache_key']
+    assert a['instructions']!=b['instructions']
+    assert 'Role B' not in a['instructions'] and 'Role A' not in b['instructions']
+    c=build('session-c',common.replace('common rules','changed rules'))
+    assert a['prompt_cache_key']!=c['prompt_cache_key']
+
+
+def test_legacy_and_unknown_endpoints_keep_session_scopes():
+    assert build('a','legacy')['prompt_cache_key']!=build('b','legacy')['prompt_cache_key']
+    text=HEADER+'\n\ncommon\n\n'+END
+    url='https://private-relay.example/v1'
+    assert build('a',text,url)['prompt_cache_key']!=build('b',text,url)['prompt_cache_key']
+    a=build('a',text,request_overrides={'prompt_cache_key':'owner-explicit'})
+    assert a['prompt_cache_key']=='owner-explicit'
