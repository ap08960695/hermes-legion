+"""Read-only public viewer for TUI delivery receipts; never initializes a board."""
+import json
+
+from hermes_cli import kanban_db as kb, kanban_db_tui_delivery as delivery
+
+
+def command(args) -> int:
+    rows = delivery.read_receipts(kb.kanban_db_path(), home=delivery.owner_home(), session_key=args.session)
+    fields = ('id', 'task_id', 'event_id', 'state', 'created_at', 'updated_at')
+    receipts = [{**{key: row[key] for key in fields}, 'auto_retry': row['state'] == 'pending'} for row in rows]
+    note = ('Claimed/admitted/unknown receipts are not replayed automatically and do not prove successful execution. '
+            'No receipt does not prove delivery.')
+    if args.json:
+        print(json.dumps({'session_key': args.session, 'receipts': receipts, 'note': note}))
+    else:
+        for row in receipts:
+            print(f"{row['id']}  {row['task_id']}  event={row['event_id']}  {row['state']}")
+        print(note)
+    return 0
