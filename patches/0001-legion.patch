+  text: 'เนื้อหา Markdown',
+  access: 'จัดการบอตสมาชิก',
+  private: 'ส่วนตัว · ยังไม่มีบอตสมาชิก',
+  preview: 'ยังไม่รองรับการแสดงผล',
