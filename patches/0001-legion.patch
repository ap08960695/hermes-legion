+"""Cold Gateway runtime settings, initialized from native profile configuration."""
+
+
+def initialize_runtime_settings(runner):
+    """Load ephemeral per-call config (prefill, reasoning, busy modes, timeouts, routing)."""
+    from gateway.run import _load_gateway_config
+    from gateway.runtime_memory import start_requested_profiler
+
+    config = _load_gateway_config()
+    start_requested_profiler(config)
+    runner._prefill_messages = runner._load_prefill_messages()
+    runner._reasoning_config = runner._load_reasoning_config()
+    runner._service_tier = runner._load_service_tier()
+    runner._show_reasoning = runner._load_show_reasoning()
+    runner._busy_input_mode = runner._load_busy_input_mode()
+    runner._busy_text_mode = runner._load_busy_text_mode()
+    # Secondary-profile busy modes snapshotted at multiplex startup; handlers never reread config.
+    runner._busy_input_modes_by_profile: dict[str, str] = {}
+    runner._busy_text_modes_by_profile: dict[str, str] = {}
+    runner._busy_text_timing = runner._busy_text_timing_from_config(config)
+    runner._busy_text_timing_by_profile: dict[str, tuple[float, float]] = {}
+    runner._human_delay = runner._human_delay_from_config(config)
+    runner._human_delay_by_profile: dict[str, Optional[tuple[int, int]]] = {}
+    runner._restart_drain_timeout = runner._load_restart_drain_timeout()
+    # Live launchd ``ExitTimeOut`` for this job (None when not launchd-owned). Read once at
+    # boot — launchd fixes it at load — and applied only to signal-driven stops, which are the
+    # only stops launchd times. See _load_launchd_exit_timeout().
+    runner._stop_requested_by_signal = False
+    runner._launchd_exit_timeout_s = runner._load_launchd_exit_timeout(runner._restart_drain_timeout)
+    runner._restart_after_turn_timeout = runner._load_restart_after_turn_timeout()
+    runner._cron_drain_timeout = runner._load_cron_drain_timeout()
+    runner._signal_interrupt_grace_timeout = runner._load_signal_interrupt_grace_timeout()
+    runner._provider_routing = runner._load_provider_routing()
+    runner._fallback_model = runner._load_fallback_model()
