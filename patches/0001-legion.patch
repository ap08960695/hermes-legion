@@ -0,0 +1,248 @@
+from dataclasses import replace
+import importlib.util
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_dispatch as dispatch
+from hermes_cli import kanban_run_activity as activity
+
+
+@pytest.fixture
+def owned(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setenv('HERMES_KANBAN_BOARD', 'default')
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setattr(activity, '_RECORDER', None)
+    from hermes_cli import kanban_db_connect as kbc
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(tmp_path))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    conn = kbc.connect()
+    task = kb.create_task(conn, title='offline timing', assignee='developer')
+    task = kb.claim_task(conn, task, claimer=kb._host_prefix() + 'offline')
+    assert dispatch.adopt_worker_pid(conn, task.id, task.current_run_id, os.getpid())
+    run = kb.get_run(conn, task.current_run_id)
+    monkeypatch.setenv('HERMES_KANBAN_CLAIM_LOCK', run.claim_lock)
+    yield conn, run
+    conn.close()
+
+
+def test_native_registration_and_exclusive_wall_time(owned, monkeypatch):
+    conn, run = owned
+    clock = [100.0]
+    monkeypatch.setattr(activity.time, 'monotonic', lambda: clock[0])
+    activity.register(conn, run.task_id, run.id)
+    recorder = activity._RECORDER
+    assert recorder is not None
+    with activity.phase('model', 'session'):
+        clock[0] += 2
+    with activity.phase('reading', 'session'):
+        clock[0] += 3
+        with activity.phase('tools', 'session'):
+            clock[0] += 4
+        clock[0] += 1
+    result = activity.read_activity(run, 'default')
+    assert result['live'] is True
+    assert result['seconds']['model'] == 2
+    assert result['seconds']['reading'] == 4
+    assert result['seconds']['parallel'] == 4
+    assert sum(result['seconds'].values()) == 10
+    assert result['counts'] == {'model': 1, 'reading': 1, 'tools': 1}
+    assert 'session' not in json.dumps(result)
+
+
+def test_foreign_claim_delegated_child_and_session_do_not_record(owned, monkeypatch):
+    conn, run = owned
+    monkeypatch.setenv('HERMES_KANBAN_CLAIM_LOCK', 'foreign')
+    activity.register(conn, run.task_id, run.id)
+    assert activity._RECORDER is None
+    monkeypatch.setenv('HERMES_KANBAN_CLAIM_LOCK', run.claim_lock)
+    activity.register(conn, run.task_id, run.id)
+    with activity.phase('reading', 'parent'):
+        pass
+    with activity.phase('model', 'child', delegated=True):
+        pass
+    with activity.phase('model', 'other'):
+        pass
+    assert activity._RECORDER.data['counts'] == {'reading': 1}
+
+
+def test_tool_seam_failure_preserves_execution_and_closes_phase(owned):
+    from agent.tool_executor import _run_with_activity_heartbeat
+    conn, run = owned
+    activity.register(conn, run.task_id, run.id)
+    agent = SimpleNamespace(session_id='session', is_subagent=False, _touch_activity=lambda *args: None)
+    calls = []
+    def fail():
+        calls.append(1)
+        raise RuntimeError('offline tool failure')
+    with pytest.raises(RuntimeError, match='offline tool failure'):
+        _run_with_activity_heartbeat(agent, 'terminal', fail, {'command': 'pytest tests/unit'})
+    data = activity.read_activity(run, 'default')
+    assert calls == [1] and data['phase'] == 'between_calls'
+    assert data['counts']['verification'] == 1
+    assert 'pytest' not in json.dumps(data)
+
+
+def test_telemetry_io_failure_never_retries_operation(owned, monkeypatch):
+    conn, run = owned
+    activity.register(conn, run.task_id, run.id)
+    monkeypatch.setattr(activity._RECORDER, 'write', lambda: (_ for _ in ()).throw(OSError('full disk')))
+    calls = []
+    with activity.phase('tools', 's'):
+        calls.append(1)
+    assert calls == [1]
+
+
+def test_corrupt_wrong_run_and_closed_runs(owned):
+    conn, run = owned
+    assert activity.read_activity(run, 'default') is None
+    activity.register(conn, run.task_id, run.id)
+    assert activity.read_activity(replace(run, worker_pid=99999999), 'default') is None
+    ended = activity.read_activity(replace(run, ended_at=run.started_at+10), 'default')
+    assert ended['live'] is False
+    path = activity.activity_path(run, 'default')
+    path.write_text('x' * 17000)
+    assert activity.read_activity(run, 'default') is None
+    path.write_text('{}')
+    assert activity.read_activity(run, 'default') is None
+
+
+def test_task_detail_returns_real_native_run_activity(owned):
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+    conn, run = owned
+    activity.register(conn, run.task_id, run.id)
+    with activity.phase('reading', 'session'):
+        pass
+    path = Path(__file__).resolve().parents[2] / 'plugins/kanban/dashboard/plugin_api.py'
+    spec = importlib.util.spec_from_file_location('activity_plugin_test', path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    app = FastAPI()
+    app.include_router(module.router)
+    response = TestClient(app).get('/tasks/' + run.task_id)
+    assert response.status_code == 200, response.text
+    data = response.json()['runs'][-1]['activity']
+    assert data['run_id'] == run.id and data['counts']['reading'] == 1
+
+
+def test_model_phase_at_actual_request_edge_without_network(owned, monkeypatch):
+    from tests.agent.test_cache_request_diagnostics import invoke
+    conn, run = owned
+    activity.register(conn, run.task_id, run.id)
+    calls = []
+    def fake_provider(request):
+        calls.append(1)
