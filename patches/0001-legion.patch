+"""Profile location and config-change polls must use the same owner as config.get full."""
+import os
+from tui_gateway import server
+
+
+def test_profile_path_and_mtime_follow_live_session_owner(tmp_path, monkeypatch):
+    launch, owner = tmp_path/'launch', tmp_path/'owner'
+    for home, stamp in [(launch, 100), (owner, 200)]:
+        home.mkdir()
+        (home/'config.yaml').write_text('display:\n  busy_input_mode: queue\n')
+        os.utime(home/'config.yaml', (stamp, stamp))
+    monkeypatch.setattr(server, '_hermes_home', launch)
+    monkeypatch.setenv('HERMES_HOME', str(launch))
+    monkeypatch.setitem(server._sessions, 'owner-session', {'profile_home': str(owner)})
+    location = server._methods['config.get']('location', {'key':'profile','session_id':'owner-session'})
+    mtime = server._methods['config.get']('mtime', {'key':'mtime','session_id':'owner-session'})
+    assert location['result']['home'] == str(owner)
+    assert mtime['result']['mtime'] == 200
+    launch_location = server._methods['config.get']('launch', {'key':'profile'})
+    assert launch_location['result']['home'] == str(launch)
