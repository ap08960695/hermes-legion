+import { hermesApiAs, type ResolvedOwner } from '@/api/client'
+import { stampRowsWithOwningConnection } from '@/lib/session-owner-stamp'
+import type { PaginatedSessions } from '@/types/hermes'
+
+export interface HistoryPage extends PaginatedSessions {
+  has_more?: boolean
+}
+export async function readHistory(
+  owner: ResolvedOwner,
+  query: string,
+  archived: boolean,
+  offset: number
+): Promise<HistoryPage> {
+  const params = new URLSearchParams({
+    limit: '50',
+    offset: String(offset),
+    min_messages: '1',
+    archived: archived ? 'include' : 'exclude',
+    order: 'recent',
+    profile: 'all',
+    ...(query ? { q: query } : {})
+  })
+  const page = await hermesApiAs<HistoryPage>(owner, { path: '/api/profiles/sessions?' + params, timeoutMs: 60000 })
+  return { ...page, sessions: stampRowsWithOwningConnection(page.sessions, owner.connectionId) }
+}
+export function nextHistoryOffset(page: HistoryPage): number | undefined {
+  const more = page.has_more ?? page.offset + page.limit < page.total
+  return more ? page.offset + page.limit : undefined
+}
