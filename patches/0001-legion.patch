+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_dispatch as kd
+from tests.hermes_cli.test_kanban_host_cap import _park_in_review
+
+
+def test_failed_review_admission_releases_slot_to_untried_ready_task(all_assignees_spawnable, monkeypatch):
+    import hermes_cli.config as cfg
+    monkeypatch.setattr(cfg,'load_config',lambda *a,**k:{'kanban':{'review_dispatch':True}})
+    monkeypatch.setattr(kd,'_memory_pressure_level',lambda:'ok')
+    calls=[]
+    with kbc.connect_closing() as conn:
+        ready=kb.create_task(conn,title='independent ready task',assignee='alice')
+        review=_park_in_review(conn,'review','reviewer')
+        original = kd._kbw.resolve_workspace
+        def resolve(task, **kwargs):
+            if task.id == review:
+                raise RuntimeError('fixture workspace failure before any spawn')
+            return original(task, **kwargs)
+        monkeypatch.setattr(kd._kbw, 'resolve_workspace', resolve)
+        def spawn(task,workspace):
+            calls.append(task.id)
+        result=kd.dispatch_once(conn,spawn_fn=spawn,max_spawn=1)
+        assert calls==[ready]
+        assert [r[0] for r in result.spawned]==[ready]
+        assert kb.get_task(conn,ready).status=='running'
+        assert sum(r.status=='running' for r in kb.list_runs(conn,review))==0
+
+
+def test_ambiguous_failed_spawn_does_not_reuse_reserved_slot(all_assignees_spawnable, monkeypatch):
+    import hermes_cli.config as cfg
+    monkeypatch.setattr(cfg, 'load_config', lambda *a, **k: {'kanban': {'review_dispatch': True}})
+    monkeypatch.setattr(kd, '_memory_pressure_level', lambda: 'ok')
+    calls = []
+    with kbc.connect_closing() as conn:
+        ready = kb.create_task(conn, title='ready', assignee='alice')
+        review = _park_in_review(conn, 'review', 'reviewer')
+        def spawn(task, workspace):
+            calls.append(task.id)
+            raise RuntimeError('unknown whether process started')
+        result = kd.dispatch_once(conn, spawn_fn=spawn, max_spawn=1)
+        assert calls == [review]
+        assert result.spawned == []
+        assert kb.get_task(conn, ready).status == 'ready'
