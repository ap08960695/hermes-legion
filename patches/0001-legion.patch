@@ -0,0 +1,48 @@
+import DOMPurify from 'dompurify'
+import { hermesApiAs, resolveOwnerNow, type ResolvedOwner } from '@/api/client'
+import type { HermesReadFileTextResult, HermesReadDirResult } from '@/global'
+import type { ArtifactRecord } from './artifact-utils'
+
+export type LibraryItem = ArtifactRecord & { owner: ResolvedOwner; initialFile?: LibraryFile }
+export interface LibraryFile extends HermesReadFileTextResult {
+  dataUrl?: string
+}
+export const libraryItem = (
+  artifact: ArtifactRecord,
+  owner = resolveOwnerNow({ profile: artifact.profile, connectionId: artifact.connectionId })
+): LibraryItem => ({ ...artifact, owner: { ...owner, profile: artifact.profile || owner.profile } })
+const dataMime = /^(image\/[-+.\w]+|audio\/[-+.\w]+|video\/[-+.\w]+|application\/pdf)$/i
+
+export async function readLibraryFile(path: string, owner: ResolvedOwner, sessionId: string): Promise<LibraryFile> {
+  const file = await hermesApiAs<HermesReadFileTextResult>(owner, {
+    path: '/api/fs/read-text?path=' + encodeURIComponent(path) + '&session_id=' + encodeURIComponent(sessionId)
+  })
+  if (!file || typeof file.path !== 'string' || typeof file.text !== 'string') throw new Error('Invalid file response')
+  const mime = (file.mimeType || '').split(';')[0].trim().toLowerCase()
+  if (!dataMime.test(mime)) return file
+  const result = await hermesApiAs<string | { dataUrl?: string }>(owner, {
+    path: `/api/fs/read-data-url?path=${encodeURIComponent(file.path)}&session_id=${encodeURIComponent(sessionId)}`
+  })
+  const dataUrl = typeof result === 'string' ? result : result?.dataUrl
+  const header = dataUrl?.slice(0, dataUrl.indexOf(','))
+  const responseMime = header?.split(';')[0]?.slice(5).toLowerCase()
+  if (!header?.toLowerCase().startsWith('data:') || !header.toLowerCase().endsWith(';base64') || responseMime !== mime)
+    throw new Error('Unsupported file preview data')
+  return { ...file, dataUrl }
+}
+
+export async function readLibraryDirectory(path: string, owner: ResolvedOwner): Promise<HermesReadDirResult> {
+  const result = await hermesApiAs<HermesReadDirResult>(owner, {
+    path: '/api/fs/list?path=' + encodeURIComponent(path)
+  })
+  if (result.error) throw new Error(result.error)
+  return result
+}
+
+/** Opaque sandbox plus CSP: local HTML cannot execute or fetch external resources. */
+export function libraryHtmlDocument(text: string) {
+  return (
+    "<!doctype html><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; img-src data: blob:; style-src 'unsafe-inline'; media-src data: blob:; base-uri 'none'; form-action 'none'\">" +
+    DOMPurify.sanitize(text)
+  )
+}
