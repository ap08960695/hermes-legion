+++ b/tests/tools/test_process_result_recovery_cost.py
@@ -0,0 +1,95 @@
+"""Recovered results must remain truthful and cheap across compression lineage."""
+import time
+
+import pytest
+
+from gateway.session_context import scoped_current_session_id
+from hermes_state import SessionDB
+from tools.process_registry import ProcessRegistry, ProcessSession
+from tools.process_registry_results import load_completed_results, save_completed_result
+
+
+@pytest.mark.parametrize('action', ['poll', 'wait', 'read_log'])
+def test_missing_recovered_pid_does_not_report_collected_completion(action):
+    registry = ProcessRegistry()
+    session = ProcessSession(
+        id='proc_missing_scoped', command='previous-process', task_id='old-task',
+        started_at=time.time(), pid=2**31 - 1, pid_scope='host', detached=True,
+        host_start_time=1, notify_on_complete=True,
+        systemd_unit='hermes-test-recovered.scope',
+    )
+    registry._running[session.id] = session
+    kwargs = {'timeout': 1} if action == 'wait' else {}
+    result = getattr(registry, action)(session.id, **kwargs)
+    assert result['status'] == 'not_found', result
+    assert not registry.is_completion_consumed(session.id)
+    assert registry.completion_queue.empty()
+    # Retain scope custody for explicit cleanup; an unavailable result isn't a kill.
+    assert registry._finished[session.id].systemd_unit == session.systemd_unit
+
+
+def test_retained_results_share_lineage_reads_without_cross_session_cache(monkeypatch):
+    with SessionDB() as db:
+        db.create_session('original-owner', 'cli')
+        db.end_session('original-owner', end_reason='compression')
+        db.create_session('current-owner', 'cli', parent_session_id='original-owner')
+        db.create_session('stranger', 'cli')
+    for n in range(24):
+        save_completed_result(ProcessSession(
+            id=f'proc_{n:012x}', command='finished-job', task_id='task',
+            parent_session_id='original-owner' if n < 20 else 'stranger',
+            started_at=time.time(), exited=True, exit_code=n, output_buffer=f'result-{n}',
+        ))
+    import hermes_state
+    real_db = hermes_state.SessionDB
+    opened, looked_up = [], []
+    real_tip = real_db.get_compression_tip
+
+    def open_readonly(*args, **kwargs):
+        opened.append(kwargs.get('read_only'))
+        return real_db(*args, **kwargs)
+
+    def tip(db, parent):
+        looked_up.append(parent)
+        return real_tip(db, parent)
+
+    monkeypatch.setattr(hermes_state, 'SessionDB', open_readonly)
+    monkeypatch.setattr(real_db, 'get_compression_tip', tip)
+    with scoped_current_session_id('current-owner'):
+        start = time.perf_counter()
+        results = load_completed_results()
+        elapsed = time.perf_counter() - start
+    assert len(results) == 20
+    assert results['proc_000000000013'].exit_code == 19
+    assert all(s._completion_event.is_set() for s in results.values())
+    print(f'RECOVERY_COST receipts=24 db_opens={len(opened)} lineage_reads={len(looked_up)} elapsed_ms={elapsed*1000:.3f}')
+    assert opened == [True], 'one readonly DB handle per result batch, not per receipt'
+    assert sorted(looked_up) == ['original-owner', 'stranger']
+    with scoped_current_session_id('stranger'):
+        other = load_completed_results()
+    assert len(other) == 4
+    assert not results.keys() & other.keys()
+    # A later compression must invalidate the old owner's view without a restart.
+    with real_db() as db:
+        db.end_session('current-owner', end_reason='compression')
+        db.create_session('next-owner', 'cli', parent_session_id='current-owner')
+    with scoped_current_session_id('current-owner'):
+        assert load_completed_results() == {}
+    with scoped_current_session_id('next-owner'):
+        assert load_completed_results().keys() == results.keys()
+
+
+def test_direct_owner_results_need_no_database(monkeypatch):
+    save_completed_result(ProcessSession(
+        id='proc_direct', command='done', task_id='task',
+        parent_session_id='direct-owner', exited=True, exit_code=0,
+        started_at=time.time(), output_buffer='finished',
+    ))
+    import hermes_state
+
+    def forbidden_db(*args, **kwargs):
+        raise AssertionError('direct owner must not open a lineage database')
+
+    monkeypatch.setattr(hermes_state, 'SessionDB', forbidden_db)
+    with scoped_current_session_id('direct-owner'):
+        assert load_completed_results()['proc_direct'].output_buffer == 'finished'
