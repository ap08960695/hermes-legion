diff --git a/apps/desktop/src/plugins/hermes-bots/desktop-characters.tsx b/apps/desktop/src/plugins/hermes-bots/desktop-characters.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..8f67e131ab5daf94d817d198527fbbcc377a533f
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/desktop-characters.tsx
@@ -0,0 +1,131 @@
+import { host, useQuery, useValue } from '@hermes/plugin-sdk'
+import { useEffect, useId } from 'react'
+
+// eslint-disable-next-line no-restricted-imports -- the built-in publisher reads the shell setting.
+import { boundedCharacterSprite } from '@/lib/pet-character-sprite'
+// eslint-disable-next-line no-restricted-imports -- reuse the platform atlas variant.
+import { isMacPlatform } from '@/lib/platform'
+// eslint-disable-next-line no-restricted-imports -- the built-in publisher reads the shell setting.
+import { $characterExtraActor, characterScope, type CharacterSize } from '@/store/character-settings'
+
+import { $focusedBotOwner, focusedRosterOwner } from './bot-state'
+import { $characterSpriteRefresh } from './character-sprites'
+import { $botAttention, $botMeta, botAttentionHint, botRosterKey, botSelectionKey, botSourceStatus } from './data'
+import { displayName } from './labels'
+import { MonitorCharacters } from './monitor-characters'
+import { botRosterMeta } from './routing'
+import { botWorkingMood, useTurnBusy } from './row-helpers'
+import type { RosterRow } from './types'
+
+const characterAnchor = () => document.querySelector('[data-characters-switch]')?.getBoundingClientRect() ?? new DOMRect()
+
+function characterGateway(connectionId: string, profile: string, signal?: AbortSignal) {
+  const gateway = host.getGateway()
+  const current = () => !signal?.aborted && host.state.gateway.get() === 'open' &&
+    host.state.connectionId.get() === connectionId &&
+    host.state.profile.get() === profile && host.getGateway() === gateway
+
+  if (!gateway || !current()) {throw new Error('Characters gateway changed')}
+
+  return { gateway, current }
+}
+
+export async function readCharacterRoster(connectionId: string, profile: string, signal?: AbortSignal) {
+  const { gateway, current } = characterGateway(connectionId, profile, signal)
+  const now = Date.now()
+  const { profiles } = await gateway.request<{ profiles?: RosterRow[] }>('profiles.list', {}, 8_000, signal)
+
+  if (!current()) {throw new Error('Characters gateway changed')}
+
+  const rows = Array.isArray(profiles) ? profiles.flatMap<RosterRow>(row => {
+    if (typeof row?.name !== 'string' || !row.name || row.ghost || row.remoteSource ||
+        (row.connectionId && row.connectionId !== connectionId)) {return []}
+
+    // Direct profiles.list replies omit the reachability added by the merged roster.
+    return [{ ...row, connectionId, connectionKind: connectionId === 'local' ? 'local' : 'remote',
+      route: undefined, sourceScoped: true, sourceReachable: row.sourceReachable ?? true }]
+  }) : []
+
+  return { profiles: rows, now }
+}
+
+export async function readDefaultCharacterSprite(connectionId: string, profile: string, signal?: AbortSignal) {
+  const { gateway, current } = characterGateway(connectionId, profile, signal)
+  const gallery = await gateway.request<{ active?: string; pets?: { slug?: string; installed?: boolean }[] }>(
+    'pet.gallery', { localOnly: true }, 8_000, signal
+  )
+
+  if (!current()) {throw new Error('Characters gateway changed')}
+  const installed = (Array.isArray(gallery?.pets) ? gallery.pets : [])
+    .filter(pet => pet?.installed === true && typeof pet.slug === 'string' && pet.slug.length > 0 && pet.slug.length <= 128)
+  const slug = (installed.find(pet => pet.slug === gallery.active) ?? installed[0])?.slug
+
+  if (!slug) {return null}
+  const request = (params: { slug: string; variant?: 'half' }) => gateway.request<{ slug?: string }>('pet.sprite', params, 8_000, signal)
+  const sprite = await (isMacPlatform() ? request({ slug, variant: 'half' }).catch((error: unknown) => {
+    if (!current() || !String((error as Error | null)?.message).startsWith('invalid params for pet.sprite: variant:')) {throw error}
+
+    return request({ slug })
+  }) : request({ slug }))
+
+  if (!current()) {throw new Error('Characters gateway changed')}
+
+  return sprite?.slug === slug ? boundedCharacterSprite(sprite) : null
+}
+
+export function DesktopCharacters({ connectionId, profile, size }: { connectionId: string; profile: string; size: CharacterSize }) {
+  const meta = useValue($botMeta)
+  const attention = useValue($botAttention)
+  const focused = focusedRosterOwner(useValue($focusedBotOwner))
+  const busy = useTurnBusy()
+  const includeSixth = useValue($characterExtraActor)
+  // A remount after reconnect waits for a new roster even before the old cache is collected.
+  const mountId = useId()
+  const roster = useQuery({
+    queryKey: ['desktop-characters', connectionId, profile, mountId],
+    queryFn: ({ signal }) => readCharacterRoster(connectionId, profile, signal),
+    refetchInterval: 5_000,
+    staleTime: 0,
+    gcTime: 0,
+    retry: false
+  })
+
+  const { refetch } = roster
+
+  useEffect(() => window.hermesDesktop?.characterMenu?.onRefresh((scope, manual) => {
+    if (host.state.gateway.get() === 'open' && scope === characterScope(connectionId, profile) &&
+        scope === characterScope(host.state.connectionId.get(), host.state.profile.get())) {
+      if (manual === true) {$characterSpriteRefresh.set({ connectionId, profile })}
+      void refetch({ cancelRefetch: false })
+    }
+  }), [connectionId, profile, refetch])
+
+  const now = roster.data?.now ?? 0
+  let needsDefault = false
+  const rows = (roster.data?.profiles ?? []).flatMap(bot => {
+    const info = botRosterMeta(bot, meta) || bot.ui_meta?.['hermes-bots']
+
+    if (info?.hidden) {return []}
+    const assigned = info && Object.prototype.hasOwnProperty.call(info, 'character') ? info.character : bot.ui_meta?.['hermes-bots']?.character
+
+    needsDefault ||= assigned == null
+    const issue = attention[botSelectionKey(bot)] || attention[botRosterKey(bot)]
+
+    return [{ bot, name: displayName(bot, info), source: botSourceStatus(bot),
+      working: botWorkingMood(bot, focused, busy, connectionId, now) !== 'idle', needsAttention: Boolean(issue),
+      attentionHint: issue ? botAttentionHint(issue.reason) : '' }]
+  })
+
+  const fallback = useQuery({
+    queryKey: ['desktop-character-default', connectionId, profile, mountId],
+    queryFn: ({ signal }) => readDefaultCharacterSprite(connectionId, profile, signal),
+    enabled: needsDefault && !roster.isError,
+    staleTime: Infinity,
+    gcTime: 0,
+    refetchOnWindowFocus: false,
+    refetchOnReconnect: false,
+    retry: false
+  })
+
+  return <MonitorCharacters active anchor={characterAnchor} defaultSprite={fallback.data ?? undefined} includeSixth={includeSixth} independent now={now} refreshOwner={{ connectionId, profile }} rows={rows} size={size} stale={!roster.data || roster.isError} />
+}
