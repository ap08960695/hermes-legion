+  vi.spyOn(host, 'openSession').mockRejectedValue(new Error('Chat navigation forbidden'))
+  vi.spyOn(host, 'newChat').mockImplementation(() => { throw new Error('Draft creation forbidden') })
+  vi.spyOn(host, 'traceIdentityChange').mockReturnValue(undefined)
+  vi.spyOn(host, 'profileRoutes').mockResolvedValue([route])
+  vi.spyOn(host, 'agents').mockResolvedValue({ agents: [
+    { connectionId: 'local', connectionKind: 'local', connectionLabel: 'Polling local', profile: 'writer', handle: 'writer-local' },
+    { connectionId: 'foreign-fixture', connectionKind: 'remote', connectionLabel: 'Foreign unavailable', profile: 'writer', handle: 'writer-foreign' }
+  ], sources: [
+    { connectionId: 'local', kind: 'local', label: 'Polling local', reachable: true },
+    { connectionId: 'foreign-fixture', kind: 'remote', label: 'Foreign unavailable', reachable: false }
+  ] })
+})
+
+afterEach(() => {
+  cleanup()
+  client.clear()
+  dispose()
+  $botManagementOpen.set(false)
+  $botAttention.set({})
+  $botMeta.set({})
+  $lastRoster.set([])
+  indexAliasRoutes([])
+  vi.restoreAllMocks()
+})
+
+it('automatically settles a visible Monitor worker into its source-scoped canonical report', async () => {
+  const now = Date.now() / 1000
+
+  const report: BotDelegationReport = { delegation_id: 'polling-delegation', task_index: 0,
+    status: 'completed', completed_at: now + 1, goal: 'Polling task report', summary: 'Polling stored result', error: '' }
+
+  const active = { profiles: [{ name: 'writer', display_name: 'Writer',
+    canonical_session: { id: 'named-parent', preview: 'Canonical polling parent', delegation_reports: [] },
+    last_session: { id: 'unrelated-side', preview: 'Unrelated side preview' },
+    worker_sessions: [{ id: 'polling-child', title: 'Polling child task', last_activity_description: 'Waiting for model',
+      last_active: now, started_at: now - 30, iteration: 2, max_iterations: 8 }] }] }
+
+  const terminal = { profiles: [{ ...active.profiles[0],
+    canonical_session: { ...active.profiles[0].canonical_session, delegation_reports: [report] },
+    worker_sessions: [{ ...active.profiles[0].worker_sessions[0], ended_at: now + 1 }] }] }
+
+  const original = JSON.stringify(active)
+  const requests: number[] = []
+  vi.spyOn(host, 'requestProfile').mockImplementation(async (owner, method, params) => {
+    expect(owner).toEqual(route)
+    expect(method).toBe('profiles.list')
+    expect(params).toEqual({})
+    requests.push(Date.now())
+
+    return requests.length === 1 ? active : terminal
+  })
+
+  render(<QueryClientProvider client={client}><BotsWorkspace /></QueryClientProvider>)
+  fireEvent.click(screen.getByRole('button', { name: 'Monitor' }))
+  const worker = await screen.findByText('Polling child task')
+  const workerRow = within(worker.closest('tr')!)
+  expect(workerRow.getByText('Working')).toBeTruthy()
+  expect(workerRow.getByText('step 2/8')).toBeTruthy()
+  expect(workerRow.getByText('30s')).toBeTruthy()
+  expect(screen.queryByText('Unrelated side preview')).toBeNull()
+  expect(requests).toHaveLength(1)
+  const foreignRow = within(screen.getByText('Foreign unavailable').closest('tr')!)
