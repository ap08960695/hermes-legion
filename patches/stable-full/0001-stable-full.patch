+import { execFileSync, type spawn, spawnSync } from 'node:child_process'
+import { EventEmitter } from 'node:events'
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { PassThrough } from 'node:stream'
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { macosSysroot, xcrunClangArgv } from '../scripts/macos-sysroot.mjs'
+
+import { createPdfRaster } from './pdf-raster'
+
+const pdf = Buffer.from('%PDF-fixture')
+const png = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jP1sAAAAASUVORK5CYII=', 'base64')
+
+class FakeChild extends EventEmitter {
+  stdin = new PassThrough()
+  stdout = new PassThrough()
+  kill = vi.fn()
+}
+
+describe('PDF raster supervisor', () => {
+  let root: string
+  let appPath: string
+  let binary: string
+  let policy: string
+  let child: FakeChild
+  let launch: ReturnType<typeof vi.fn>
+
+  function raster(platform: NodeJS.Platform = 'darwin') {
+    return createPdfRaster(appPath, { platform, spawnHelper: launch as unknown as typeof spawn, timeoutMs: 50 })
+  }
+
+  beforeEach(() => {
+    root = mkdtempSync(join(tmpdir(), 'raster-test-'))
+    appPath = join(root, 'app.asar')
+    const native = join(root, 'app.asar.unpacked', 'dist', 'native')
+    mkdirSync(native, { recursive: true })
+    binary = join(native, 'pdf-raster')
+    policy = join(native, 'pdf-raster.sb')
+    writeFileSync(binary, '', { mode: 0o700 })
+    writeFileSync(policy, '')
+    child = new FakeChild()
+    launch = vi.fn(() => child)
+  })
+
+  afterEach(() => {
+    vi.useRealTimers()
+    rmSync(root, { recursive: true, force: true })
+  })
+
+  it('runs the packaged helper in the sandbox and accepts output only after clean close', async () => {
+    const readInput = vi.fn()
+    child.stdin.on('data', readInput)
+    const render = raster()
+    const pending = render(pdf)
+    expect(launch).toHaveBeenCalledWith('/usr/bin/sandbox-exec', [
+      '-D', 'RASTER_BIN=' + binary, '-f', policy, binary,
+    ], { env: {}, stdio: ['pipe', 'pipe', 'ignore'] })
+    expect(readInput).toHaveBeenCalledExactlyOnceWith(pdf)
+    child.stdout.write(png.subarray(0, 20))
+    child.stdout.write(png.subarray(20))
+    child.emit('exit', 0)
+    await expect(render(pdf)).resolves.toBeUndefined()
+    child.emit('close', 0)
+    await expect(pending).resolves.toEqual(png)
+  })
+
+  it('declines unsupported, oversized, malformed, cancelled and unstaged input without spawning', async () => {
+    await expect(raster('linux')(pdf)).resolves.toBeUndefined()
+    const render = raster()
+    await expect(render(Buffer.concat([pdf, Buffer.alloc(512 * 1024)]))).resolves.toBeUndefined()
+    await expect(render(Buffer.from('wrong format'))).resolves.toBeUndefined()
+    await expect(render(pdf, AbortSignal.abort())).resolves.toBeUndefined()
+    rmSync(policy)
+    await expect(render(pdf)).resolves.toBeUndefined()
+    expect(launch).not.toHaveBeenCalled()
+  })
+
+  it.each(['timeout', 'overflow', 'stdin error', 'spawn error'])(
+    'kills on %s and holds its slot through close', async (event) => {
+      vi.useFakeTimers()
+      const render = raster()
+      const pending = render(pdf)
+      child.stdout.write(png)
+
+      switch (event) {
+        case 'timeout': await vi.advanceTimersByTimeAsync(50);
+
+ break
+
+        case 'overflow': child.stdout.write(Buffer.alloc(128 * 1024));
+
+ break
+
+        case 'stdin error': child.stdin.emit('error', new Error('closed pipe'));
+
+ break
+
+        case 'spawn error': child.emit('error', new Error('spawn failed'));
+
+ break
+      }
+
+      expect(child.kill).toHaveBeenCalledExactlyOnceWith('SIGKILL')
+      await expect(render(pdf)).resolves.toBeUndefined()
+      expect(launch).toHaveBeenCalledTimes(1)
+      child.emit('close', 0)
+      await expect(pending).resolves.toBeUndefined()
+
+      child = new FakeChild()
+      const retry = render(pdf)
+      child.stdout.write(png)
+      child.emit('close', 0)
+      await expect(retry).resolves.toEqual(png)
+      expect(launch).toHaveBeenCalledTimes(2)
+    },
+  )
+
+  it('discards truncation, oversized dimensions and nonzero exits', async () => {
+    const render = raster()
+    const tooWide = Buffer.from(png)
+    tooWide.writeUInt32BE(641, 16)
+
+    for (const [image, code] of [[png.subarray(0, 29), 0], [tooWide, 0], [png, 3]] as const) {
+      child = new FakeChild()
+      const pending = render(pdf)
+      child.stdout.write(image)
+      child.emit('close', code)
+      await expect(pending).resolves.toBeUndefined()
+    }
+  })
+
+  it('renders the latest valid snapshot after a cancelled helper closes', async () => {
+    const render = raster()
+    const first = new AbortController()
+    const nextInput = Buffer.from('%PDF-next fixture')
+    const nextPage = Buffer.from(png)
+    nextPage.writeUInt32BE(2, 16)
+    const nextChild = new FakeChild()
+    const nextRead = vi.fn()
+    nextChild.stdin.on('data', nextRead)
+    let live = 0
+    let peak = 0
+    launch.mockReset().mockImplementationOnce(() => track(child)).mockImplementationOnce(() => track(nextChild))
+
+    function track(helper: FakeChild) {
+      peak = Math.max(peak, ++live)
+      helper.once('close', () => { live-- })
+
+      return helper
+    }
+
+    const a = render(pdf, first.signal)
+    first.abort()
+    expect(child.kill).toHaveBeenCalledExactlyOnceWith('SIGKILL')
+    const superseded = render(Buffer.from('%PDF-superseded fixture'))
+    const b = render(nextInput)
+    await expect(render(Buffer.from('malformed'))).resolves.toBeUndefined()
+    await expect(superseded).resolves.toBeUndefined()
+    expect(launch).toHaveBeenCalledTimes(1)
+
+    child.stdout.write(png)
+    child.emit('close', 0)
+    await expect(a).resolves.toBeUndefined()
+    expect(launch).toHaveBeenCalledTimes(2)
+    expect(nextRead).toHaveBeenCalledExactlyOnceWith(nextInput)
+    expect(peak).toBe(1)
+    nextChild.stdout.write(nextPage)
+    nextChild.emit('close', 0)
+    await expect(b).resolves.toEqual(nextPage)
+    expect(live).toBe(0)
+  })
+
+  it('drops the latest waiting snapshot when its caller cancels', async () => {
+    vi.useFakeTimers()
+    const render = raster()
+    const first = new AbortController()
+    const next = new AbortController()
+    const a = render(pdf, first.signal)
+    first.abort()
+    const settled = vi.fn()
+    const b = render(Buffer.from('%PDF-next fixture'), next.signal).then(settled)
+    await vi.advanceTimersByTimeAsync(0)
+    expect(settled).not.toHaveBeenCalled()
+    next.abort()
+    await b
+    expect(settled).toHaveBeenCalledExactlyOnceWith(undefined)
+
+    child.emit('close', 0)
+    await expect(a).resolves.toBeUndefined()
+    expect(launch).toHaveBeenCalledTimes(1)
+  })
+
+  it('releases the slot after a synchronous launch failure', async () => {
+    const render = raster()
+    launch.mockImplementationOnce(() => { throw new Error('launch failed') })
+    await expect(render(pdf)).resolves.toBeUndefined()
+    const pending = render(pdf)
+    child.stdout.write(png)
+    child.emit('close', 0)
+    await expect(pending).resolves.toEqual(png)
+  })
+})
+
+it.skipIf(process.platform !== 'darwin')('stops the native PDF parser while a controlled allocation exceeds its budget', () => {
+  const root = mkdtempSync(join(tmpdir(), 'raster-memory-test-'))
+
+  try {
+    const binary = join(root, 'pdf-raster-memory')
+    const source = join(import.meta.dirname, 'native', 'pdf-raster-memory.test.c')
+    execFileSync('xcrun', [
+      ...xcrunClangArgv(macosSysroot()), '-O2', '-Wall', '-Wextra', '-Werror', '-mmacosx-version-min=13.0',
+      '-framework', 'CoreFoundation', '-framework', 'CoreGraphics', '-framework', 'ImageIO', source, '-o', binary,
+    ])
+    const result = spawnSync(binary, [], { input: pdf, encoding: 'utf8', env: {}, timeout: 2500 })
+
+    expect(result.error).toBeUndefined()
+    expect(result.status).toBe(9)
+    expect(result.stdout).toBe('')
+    expect(result.stderr).toContain('pressure-start')
+    expect(result.stderr).not.toContain('pressure-return')
+  } finally {
+    rmSync(root, { recursive: true, force: true })
+  }
+}, 30_000)
diff --git a/apps/desktop/electron/pdf-raster.ts b/apps/desktop/electron/pdf-raster.ts
new file mode 100644
index 0000000000000000000000000000000000000000..69595a89989d84c3f8e7e0def2559df814b8edfc
--- /dev/null
+++ b/apps/desktop/electron/pdf-raster.ts
@@ -0,0 +1,127 @@
+import { spawn } from 'node:child_process'
+import { lstatSync, realpathSync } from 'node:fs'
+import { isAbsolute, join } from 'node:path'
+
+const inputLimit = 512 * 1024
+const outputLimit = 128 * 1024
+const maxEdge = 640
+const pdfHeader = Buffer.from('%PDF-')
+const pngHeader = Buffer.from('89504e470d0a1a0a0000000d49484452', 'hex')
+const pngEnd = Buffer.from('0000000049454e44ae426082', 'hex')
+
+type RasterOptions = {
+  platform?: NodeJS.Platform
+  spawnHelper?: typeof spawn
+  timeoutMs?: number
+}
+
+function boundedPng(bytes: Buffer) {
+  if (bytes.length < 45 || !bytes.subarray(0, 16).equals(pngHeader) || !bytes.subarray(-12).equals(pngEnd)) {
+    return false
+  }
+
+  const width = bytes.readUInt32BE(16)
+  const height = bytes.readUInt32BE(20)
+
+  return width > 0 && height > 0 && width <= maxEdge && height <= maxEdge
+}
+
+// The main process owns one supervisor. The caller supplies only an authorized snapshot.
+export function createPdfRaster(appPath: string, {
+  platform = process.platform, spawnHelper = spawn, timeoutMs = 2500,
+}: RasterOptions = {}) {
+  const native = join(appPath.replace(/app\.asar$/, 'app.asar.unpacked'), 'dist', 'native')
+  const stagedBinary = join(native, 'pdf-raster')
+  const policy = join(native, 'pdf-raster.sb')
+  let active: { signal?: AbortSignal } | undefined
+  let waiting: { cancel: () => void; start: () => void } | undefined
+
+  async function render(input: Buffer, signal?: AbortSignal): Promise<Buffer | undefined> {
+    if (signal?.aborted) {return}
+
+    try {
+      const stat = lstatSync(stagedBinary)
+
+      if (!stat.isFile() || (stat.mode & 0o111) === 0 || !lstatSync(policy).isFile()) {return}
+      const binary = realpathSync(stagedBinary)
+      const child = spawnHelper('/usr/bin/sandbox-exec', [
+        '-D', 'RASTER_BIN=' + binary, '-f', policy, binary,
+      ], { env: {}, stdio: ['pipe', 'pipe', 'ignore'] })
+      active = { signal }
+
+      return new Promise((resolve) => {
+        const chunks: Buffer[] = []
+        let length = 0
+        let failed = false
+
+        const stop = () => {
+          if (failed) {return}
+          failed = true
+          chunks.length = 0
+          child.kill('SIGKILL')
+        }
+
+        const timeout = setTimeout(stop, timeoutMs)
+        signal?.addEventListener('abort', stop, { once: true })
+        child.on('error', stop)
+        child.stdin.on('error', stop)
+        child.stdout.on('error', stop)
+        child.stdout.on('data', (chunk: Buffer) => {
+          if (failed) {return}
+          length += chunk.length
+
+          if (length > outputLimit) {
+            stop()
+
+            return
+          }
+
+          chunks.push(chunk)
+        })
+        // An exit or error can precede stream closure and buffered output.
+        child.once('close', (code) => {
+          clearTimeout(timeout)
+          signal?.removeEventListener('abort', stop)
+          active = undefined
+          const bytes = !failed && code === 0 ? Buffer.concat(chunks, length) : undefined
+          resolve(bytes && boundedPng(bytes) ? bytes : undefined)
+          waiting?.start()
+        })
+
+        if (signal?.aborted) {stop()}
+        else {child.stdin.end(input)}
+      })
+    } catch {
+      return undefined
+    }
+  }
+
+  return async (input: Buffer, signal?: AbortSignal): Promise<Buffer | undefined> => {
+    if (platform !== 'darwin' || signal?.aborted || !isAbsolute(appPath) ||
+      input.length > inputLimit || !input.subarray(0, pdfHeader.length).equals(pdfHeader)) {return}
+    if (!active) {return render(input, signal)}
+    if (!active.signal?.aborted) {return}
+
+    // The old helper owns the slot until close. Keep one replacement snapshot.
+    waiting?.cancel()
+
+    return new Promise((resolve) => {
+      const clear = () => {
+        waiting = undefined
+        signal?.removeEventListener('abort', cancel)
+      }
+      const cancel = () => {
+        clear()
+        resolve(undefined)
+      }
+      waiting = {
+        cancel,
+        start: () => {
+          clear()
+          resolve(render(input, signal))
+        },
+      }
+      signal?.addEventListener('abort', cancel, { once: true })
+    })
+  }
+}
