+import { cleanup, render, screen, waitFor, fireEvent } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import { LibraryFilePreview } from './artifact-preview'
+import { libraryHtmlDocument } from './open-artifact'
+const io = vi.hoisted(() => ({ read: vi.fn(), list: vi.fn() }))
+vi.mock('./open-artifact', async original => ({
+  ...(await original<typeof import('./open-artifact')>()),
+  readLibraryFile: io.read,
+  readLibraryDirectory: io.list
+}))
+vi.mock('./library-availability', () => ({
+  useLibraryAvailability: (items: { id: string }[]) => Object.fromEntries(items.map(item => [item.id, 'ready']))
+}))
+vi.mock('@/components/chat/code-editor', () => ({
+  CodeEditor: ({ initialValue }: { initialValue: string }) => <pre>{initialValue}</pre>
+}))
+afterEach(async () => {
+  cleanup()
+  await new Promise(resolve => setTimeout(resolve, 0))
+  vi.clearAllMocks()
+})
+const item = {
+  id: 'example',
+  kind: 'file' as const,
+  value: '/work/notes.md',
+  href: 'file:///work/notes.md',
+  label: 'notes.md',
+  sessionId: 'original',
+  profile: 'writer',
+  sessionTitle: 'Example',
+  timestamp: 1,
+  owner: { connectionId: 'origin', profile: 'writer' }
+}
+it('opens text and browses its folder in Hermes without an external program', async () => {
+  io.read.mockResolvedValue({ path: '/work/notes.md', text: 'Read this within Hermes', mimeType: 'text/plain' })
+  io.list.mockResolvedValue({ entries: [{ path: '/work/other.md', name: 'other.md', isDirectory: false }] })
+  const external = vi.fn()
+  vi.stubGlobal('hermesDesktop', { openExternal: external })
+  render(<LibraryFilePreview item={item} onClose={() => {}} />)
+  expect(await screen.findByText('Read this within Hermes')).toBeTruthy()
+  fireEvent.click(screen.getByRole('button', { name: 'Browse containing folder' }))
+  fireEvent.click(await screen.findByRole('button', { name: 'other.md' }))
+  await waitFor(() => expect(io.read).toHaveBeenLastCalledWith('/work/other.md', item.owner, item.sessionId))
+  expect(external).not.toHaveBeenCalled()
+  vi.unstubAllGlobals()
+})
+it('removes executable HTML and denies outside resource loading in the embedded document', () => {
+  const html = libraryHtmlDocument(
+    '<h1>Report</h1><script>window.bad=true</script><img src="https://example.invalid/private">'
+  )
+  expect(html).toContain('default-src')
+  expect(html).toContain('none')
+  expect(html).not.toContain('<script>')
+  expect(html).not.toContain('window.bad')
+})
+it('ignores a file read that settles after the preview closes', async () => {
+  let finish!: (x: unknown) => void
+  io.read.mockImplementationOnce(
+    () =>
+      new Promise(resolve => {
+        finish = resolve
+      })
+  )
+  const view = render(<LibraryFilePreview item={item} onClose={() => {}} />)
+  view.unmount()
+  finish({ path: '/work/notes.md', text: 'late file', mimeType: 'text/plain' })
+  await Promise.resolve()
+  expect(screen.queryByText('late file')).toBeNull()
+})
+
+it('returns to Hub at the root and walks back through folder history', async () => {
+  io.read.mockImplementation(async (path: string) => ({ path, text: path, mimeType: 'text/plain' }))
+  io.list.mockResolvedValue({ entries: [{ path: '/work/other.md', name: 'other.md', isDirectory: false }] })
+  const close = vi.fn()
+  render(<LibraryFilePreview item={item} onClose={close} />)
+  await screen.findByText('/work/notes.md', { selector: 'p,pre' })
+  fireEvent.click(screen.getByRole('button', { name: 'Back' }))
+  expect(close).toHaveBeenCalledTimes(1)
+  fireEvent.click(screen.getByRole('button', { name: 'Browse containing folder' }))
+  fireEvent.click(await screen.findByRole('button', { name: 'other.md' }))
+  await waitFor(() => expect(io.read).toHaveBeenLastCalledWith('/work/other.md', item.owner, item.sessionId))
+  fireEvent.click(screen.getByRole('button', { name: 'Back' }))
+  expect(await screen.findByRole('button', { name: 'other.md' })).toBeTruthy()
+  fireEvent.click(screen.getByRole('button', { name: 'Back' }))
+  await waitFor(() => expect(io.read).toHaveBeenLastCalledWith(item.value, item.owner, item.sessionId))
+  expect(close).toHaveBeenCalledTimes(1)
