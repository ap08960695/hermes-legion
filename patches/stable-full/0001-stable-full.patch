+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it } from 'vitest'
+
+import AnswerCards from './cards-embed'
+afterEach(cleanup)
+it('renders supplied title, price and source as native content without raw HTML execution', () => {
+  const code = JSON.stringify({
+    cards: [
+      {
+        title: 'Example computer',
+        price: '100 units',
+        description: 'Supplied description',
+        sources: [{ title: 'Example source', url: 'https://example.com/item' }]
+      }
+    ]
+  })
+  render(<AnswerCards code={code} streaming={false} />)
+  expect(screen.getByRole('heading', { name: 'Example computer' })).toBeTruthy()
+  expect(screen.getByText('100 units')).toBeTruthy()
+  expect(screen.getByRole('link', { name: /Example source/ }).getAttribute('href')).toBe('https://example.com/item')
+})
+
+it('requires fresh consent when an external image URL changes on the same host', () => {
+  const source = (filename: string) => `https://images.example.invalid/${filename}.png`
+  const card = (filename: string) => JSON.stringify({ cards: [{ title: 'Report', images: [source(filename)] }] })
+  const { rerender } = render(<AnswerCards code={card('original')} />)
+  const preview = () =>
+    screen.getByRole('button', {
+      name: 'Preview anyway',
+      description: /Report.*Images \(1\).*images\.example\.invalid/
+    })
+
+  expect(screen.queryByRole('img')).toBeNull()
+  fireEvent.click(preview())
+  expect(screen.getByRole('img', { name: 'Report' }).getAttribute('src')).toBe(source('original'))
+
+  rerender(<AnswerCards code={card('updated')} />)
+  expect(screen.queryByRole('img')).toBeNull()
+  fireEvent.click(preview())
+  expect(screen.getByRole('img', { name: 'Report' }).getAttribute('src')).toBe(source('updated'))
+})
