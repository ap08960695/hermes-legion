diff --git a/agent/auxiliary_codex_reasoning.py b/agent/auxiliary_codex_reasoning.py
new file mode 100644
index 0000000000000000000000000000000000000000..565fdb8e48243a71f65d6c85910f5cf5a62a865e
--- /dev/null
+++ b/agent/auxiliary_codex_reasoning.py
@@ -0,0 +1,22 @@
+"""Translate auxiliary chat reasoning controls onto their actual Responses wire."""
+
+
+def responses_reasoning(kwargs, model, host, *, is_codex_backend, is_xai):
+    from agent.reasoning_effort import clamp_effort
+    from agent.transports.codex import _codex_efforts_for_route
+
+    extra = kwargs.get('extra_body') or {}
+    config = extra.get('reasoning')
+    if not isinstance(config, dict):
+        config = kwargs.get('reasoning')
+    if not isinstance(config, dict):
+        effort = kwargs.get('reasoning_effort', extra.get('reasoning_effort'))
+        if effort is None:
+            return None
+        config = {'enabled': effort != 'none', 'effort': effort}
+    supported = _codex_efforts_for_route(model, host, is_codex_backend=is_codex_backend)
+    if config.get('enabled') is False:
+        return {'effort': 'none'} if 'none' in supported and not is_xai else None
+    if not supported:
+        return None
+    return {'effort': clamp_effort(config.get('effort') or 'medium', supported), 'summary': 'auto'}
