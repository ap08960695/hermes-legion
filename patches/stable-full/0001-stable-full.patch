diff --git a/hermes_cli/code_map.py b/hermes_cli/code_map.py
new file mode 100644
index 0000000000000000000000000000000000000000..0f6d65d5b1700bffb60085b1e3c54e9d4cf1a512
--- /dev/null
+++ b/hermes_cli/code_map.py
@@ -0,0 +1,112 @@
+"""Read-only Python import navigation: python -m hermes_cli.code_map --repo . --changed file.py.
+
+No target module is imported. Suggestions never replace required regressions.
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+from collections import defaultdict, deque
+import hashlib
+import json
+import os
+from pathlib import Path
+
+_EXCLUDED = {'.git', '.venv', 'node_modules', '__pycache__', 'vendor', 'build', 'dist'}
+_MAX_FILES, _MAX_BYTES = 12000, 128 * 1024 * 1024
+
+
+def scan(root):
+    root = Path(root).resolve(strict=True)
+    modules, records, imports, warnings = {}, {}, {}, []
+    budget = _MAX_BYTES
+    for directory, dirs, files in os.walk(root, followlinks=False):
+        dirs[:] = sorted(d for d in dirs if d not in _EXCLUDED and not (Path(directory)/d).is_symlink())
+        for name in sorted(files):
+            path = Path(directory)/name
+            if path.suffix != '.py' or path.is_symlink():
+                continue
+            if len(records) >= _MAX_FILES or path.stat().st_size > budget:
+                raise ValueError('code map scan budget exceeded; choose a smaller repository')
+            with path.open('rb') as source:
+                data = source.read(budget + 1)
+            if len(data) > budget:
+                raise ValueError('code map scan budget exceeded during read')
+            budget -= len(data)
+            relative = path.relative_to(root).as_posix()
+            module = relative[:-3].replace('/', '.')
+            module = module.removesuffix('.__init__')
+            modules[module] = relative
+            records[relative] = hashlib.sha256(data).hexdigest()
+            try:
+                package = module.split('.') if relative.endswith('/__init__.py') else module.split('.')[:-1]
+                imports[relative] = _source_imports(data, package)
+            except (SyntaxError, ValueError):
+                warnings.append({'path': relative, 'reason': 'parse_failed'})
+    reverse = defaultdict(set)
+    for relative, names in imports.items():
+        for imported in names:
+            parts = imported.split('.')
+            # Include package initializers and the longest resolvable module prefix.
+            for length in range(1, len(parts)+1):
+                target = modules.get('.'.join(parts[:length]))
+                if target and target != relative:
+                    reverse[target].add(relative)
+    return {'version': 1, 'root': str(root), 'source_hashes': records,
+            'reverse_imports': {k: sorted(v) for k, v in sorted(reverse.items())}, 'warnings': warnings}
+
+
+def _source_imports(data, package):
+    # Drop each AST before reading the next file; only import names survive.
+    return sorted({name for node in ast.walk(ast.parse(data)) for name in _imports(node, package)})
+
+
+def _imports(node, package):
+    if isinstance(node, ast.Import):
+        return [a.name for a in node.names]
+    if not isinstance(node, ast.ImportFrom):
+        return []
+    base = package[:len(package)-node.level+1] if node.level else []
+    if node.module:
+        base += node.module.split('.')
+    return ['.'.join(base), *['.'.join([*base, a.name]) for a in node.names if a.name != '*']]
+
+
+def select(graph, changed):
+    root = Path(graph['root'])
+    seeds, unknown = set(), []
+    for raw in changed:
+        path = (root/raw).resolve()
+        if not path.is_relative_to(root):
+            raise ValueError('changed path escapes repository')
+        name = path.relative_to(root).as_posix()
+        if name in graph['source_hashes']:
+            seeds.add(name)
+        else:
+            unknown.append(name)
+    queue = deque(sorted(seeds)); reached = set(seeds)
+    while queue:
+        for name in graph['reverse_imports'].get(queue.popleft(), []):
+            if name not in reached:
+                reached.add(name); queue.append(name)
+    tests = sorted(n for n in reached if Path(n).name.startswith('test') and {'test', 'tests'} & set(Path(n).parts[:-1]))
+    return {'changed': sorted(seeds), 'selected_tests': tests, 'reached_files': sorted(reached),
+            'unresolved_changes': unknown, 'warnings': graph['warnings'],
+            'claim': 'static navigation only; no test executed',
+            'blind_spots': ['dynamic imports', 'subprocess/CLI', 'non-Python/config changes', 'deleted files', 'runtime sys.path changes'],
+            'required_regressions_unchanged': True}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--repo', default='.')
+    parser.add_argument('--changed', nargs='+', required=True)
+    args = parser.parse_args()
+    graph = scan(args.repo)
+    result = select(graph, args.changed)
+    result['source_fingerprint'] = hashlib.sha256(json.dumps(graph['source_hashes'], sort_keys=True).encode()).hexdigest()
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == '__main__':
+    main()
