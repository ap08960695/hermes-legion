+"""Read-only discovery/status for agent-desktop; not a runtime provider."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from platform import machine
+import re
+import shlex
+import shutil
+import subprocess
+from sys import platform as _PLATFORM
+
+from hermes_cli._subprocess_compat import bounded_probe_run, resolve_node_command
+from hermes_cli.config import load_config_readonly
+
+_SOURCE_ROOT = Path(__file__).resolve().parents[2]
+_MACHINE = machine().lower()
+_HOMEBREW_PREFIXES = (Path('/opt/homebrew'), Path('/usr/local'), Path('/home/linuxbrew/.linuxbrew'))
+
+
+def _environment():
+    from tools.environments.local import hermes_subprocess_env
+    return hermes_subprocess_env(inherit_credentials=False)
+
+
+def _executable(path):
+    try:
+        path = Path(path).expanduser().resolve()
+        if _PLATFORM == 'win32' and path.suffix.lower() != '.exe':
+            return None
+        if path.is_file() and (_PLATFORM == 'win32' or os.access(path, os.X_OK)):
+            return str(path)
+    except (OSError, RuntimeError):
+        pass
+    return None
+
+
+def _prefix_candidates(prefix, name):
+    prefix = Path(prefix).expanduser()
+    names = [name]
+    if _PLATFORM == 'win32':
+        arch = {'amd64': 'x64', 'x86_64': 'x64', 'x64': 'x64', 'arm64': 'arm64', 'aarch64': 'arm64'}.get(_MACHINE)
+        if arch:
+            names.append(f'agent-desktop-win32-{arch}.exe')
+    directories = (prefix / 'bin', prefix / 'node_modules/agent-desktop/bin',
+                   prefix / 'lib/node_modules/agent-desktop/bin', prefix)
+    return tuple(directory / item for directory in directories for item in names)
+
+
+def resolve_agent_desktop(*, probe_npm: bool = True) -> str | None:
+    """An explicit path is authoritative; discovery never installs or selects a provider."""
+    config = load_config_readonly()
+    if config is None:
+        config = {}
+    if not isinstance(config, dict):
+        raise ValueError('Invalid computer-use config')
+    section = config.get('computer_use')
+    if section is None:
+        section = {}
+    if not isinstance(section, dict):
+        raise ValueError('Invalid computer-use config')
+    settings = section.get('agent_desktop')
+    if settings is None:
+        settings = {}
+    if not isinstance(settings, dict):
+        raise ValueError('Invalid agent-desktop config')
+    explicit = settings.get('path')
+    if explicit is not None and not isinstance(explicit, str):
+        raise ValueError('Invalid agent-desktop path')
+    name = 'agent-desktop.exe' if _PLATFORM == 'win32' else 'agent-desktop'
+    if explicit and explicit.strip():
+        path = Path(explicit.strip()).expanduser()
+        candidates = (path / name, path / 'bin' / name) if path.is_dir() else (path,)
+        matches = {value for candidate in candidates if (value := _executable(candidate))}
+        if len(matches) != 1:
+            raise ValueError('Missing or ambiguous agent-desktop path')
+        return matches.pop()
+    if found := shutil.which('agent-desktop'):
+        if resolved := _executable(found):
+            return resolved
+        if _PLATFORM == 'win32':
+            directory = Path(found).parent
+            for prefix in (directory, directory.parent.parent):
+                for candidate in _prefix_candidates(prefix, name):
+                    if resolved := _executable(candidate):
+                        return resolved
+    cwd = Path.cwd()
+    for root in (cwd, *cwd.parents, _SOURCE_ROOT):
+        for candidate in (root / 'node_modules/agent-desktop/bin' / name,
+                          root / 'node_modules/.bin' / name):
+            if found := _executable(candidate):
+                return found
+    prefixes = [os.environ.get(key, '') for key in ('NPM_CONFIG_PREFIX', 'npm_config_prefix', 'HOMEBREW_PREFIX')]
+    if _PLATFORM == 'win32':
+        if os.environ.get('APPDATA'):
+            prefixes.append(str(Path(os.environ['APPDATA']) / 'npm'))
+    else:
+        prefixes.extend(_HOMEBREW_PREFIXES)
+    for prefix in prefixes:
+        if prefix:
+            for candidate in _prefix_candidates(prefix, name):
+                if found := _executable(candidate):
+                    return found
+    if probe_npm and shutil.which('npm'):
+        result = bounded_probe_run(resolve_node_command('npm', ['prefix', '-g']), timeout=3, env=_environment())
+        if result is not None and result.returncode == 0:
+            prefix = result.stdout.strip()
+            if len(prefix) <= 4096 and len(prefix.splitlines()) == 1 and Path(prefix).is_absolute():
+                for candidate in _prefix_candidates(prefix, name):
+                    if found := _executable(candidate):
+                        return found
+    return None
+
+
+def print_agent_desktop_status() -> int:
+    """Print allowlisted status facts only; never echo external error/output payloads."""
+    try:
+        binary = resolve_agent_desktop()
+    except Exception:
+        print('agent-desktop: check computer_use.agent_desktop.path (one executable or extracted release directory).')
+        return 2
+    if not binary:
+        print('agent-desktop: not installed or not found.')
+        print('  Install agent-desktop, add it to PATH or set computer_use.agent_desktop.path; keep its helper beside it.')
+        return 1
+    try:
+        result = bounded_probe_run([binary, 'status'], timeout=10, env=_environment())
+        if result is None or result.returncode != 0 or len(result.stdout) > 65536:
+            raise ValueError('Status probe failed')
+        envelope = json.loads(result.stdout)
+        if not isinstance(envelope, dict) or envelope.get('ok') is not True or envelope.get('command') != 'status':
+            raise ValueError('Wrong status envelope')
+        data = envelope.get('data')
+        if not isinstance(data, dict) or data.get('platform') not in {'macos', 'windows', 'linux'}:
+            raise ValueError('Wrong status data')
+        permissions = data.get('permissions')
+        if not isinstance(permissions, dict):
+            raise ValueError('Wrong permission data')
+    except Exception:
+        print('agent-desktop: status failed, timed out or returned an invalid response; no desktop operation was verified.')
+        print('  Check the binary and keep the release helper beside it.')
+        return 2
+    version = data.get('version')
+    if not isinstance(version, str) or re.fullmatch(r'[A-Za-z0-9.+_-]{1,80}', version) is None:
+        version = 'unknown'
+    print(f'agent-desktop: {version} at {binary}')
+    print(f'  Platform: {data["platform"]}')
+    states = {}
+    for key, label in [('accessibility', 'Accessibility'), ('screen_recording', 'Screen Recording'), ('automation', 'Automation')]:
+        entry = permissions.get(key)
+        state = entry.get('state') if isinstance(entry, dict) else None
+        states[key] = state if state in ('granted', 'denied', 'unknown', 'not_required', 'unsupported') else 'unknown'
+        print(f'  {label}: {states[key]}')
+    if data['platform'] == 'macos' and states['accessibility'] == 'denied':
+        argv = [binary, 'permissions', '--guide']
+        command = subprocess.list2cmdline(argv) if _PLATFORM == 'win32' else shlex.join(argv)
+        print(f'  Accessibility guide (owner action): {command}')
+    print('  Diagnostics only; snapshot/action support is not verified.')
+    return 0
