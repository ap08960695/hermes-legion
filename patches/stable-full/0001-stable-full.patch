index 0000000000000000000000000000000000000000..6bf9bd510646e5ea3725f11e550ac917baaf024f
--- /dev/null
+++ b/apps/desktop/src/app/pet-overlay/linux-input-region.ts
@@ -0,0 +1,216 @@
+import { petSpritePaintVersion, subscribePetSpritePaint } from '@/lib/pet-sprite-paint'
+
+// X11 needs a window-local input region: forwarding mouse moves through an
+// ignoring overlay is unavailable. Keep this sampling off the Mac renderer.
+const MAX_RECTS = 4096
+
+type Box = { x: number; y: number; width: number; height: number }
+type SpriteShape = { box: Box; viewport: Box; mirrored: boolean; rectangles: number[] }
+
+function sameBox(a: Box, b: Box): boolean {
+  return a.x === b.x && a.y === b.y && a.width === b.width && a.height === b.height
+}
+
+export function appendSpriteRegion(
+  regions: number[],
+  rect: Box,
+  pixels: Pick<ImageData, 'data' | 'width' | 'height'>,
+  viewport: Box,
+  mirrored: boolean
+) {
+  const left = Math.max(viewport.x, Math.ceil(rect.x - 0.5))
+  const right = Math.min(viewport.width, Math.ceil(rect.x + rect.width - 0.5))
+  const top = Math.max(viewport.y, Math.ceil(rect.y - 0.5))
+  const bottom = Math.min(viewport.height, Math.ceil(rect.y + rect.height - 0.5))
+  let previous = new Map<number, number>()
+
+  for (let y = top; y < bottom; y++) {
+    const row = Math.floor((y + 0.5 - rect.y) * pixels.height / rect.height) * pixels.width
+    const runs = new Map<number, number>()
+    let start = left
+
+    for (let x = left; x <= right; x++) {
+      const col = Math.floor((x + 0.5 - rect.x) * pixels.width / rect.width)
+      const offset = row + (mirrored ? pixels.width - 1 - col : col)
+
+      if (x < right && pixels.data[offset * 4 + 3] >= 16) {continue}
+
+      if (start < x) {
+        if (regions.length >= MAX_RECTS * 4) {return}
+        const key = start * 32768 + x
+        const above = previous.get(key)
+        const index = above ?? regions.length
+
+        if (above === undefined) {regions.push(start, y, x - start, 1)}
+        else {regions[above + 3]++}
+
+        runs.set(key, index)
+      }
+
+      start = x + 1
+    }
+
+    previous = runs
+  }
+}
+
+function inputRegion(
+  readPixels: (canvas: HTMLCanvasElement) => ImageData | undefined,
+  shapes: WeakMap<ImageData, SpriteShape>
+): number[] {
+  const dpr = window.devicePixelRatio
+  const viewport = { x: 0, y: 0, width: Math.min(32767, Math.round(window.innerWidth * dpr)),
+    height: Math.min(32767, Math.round(window.innerHeight * dpr)) }
+  const regions: number[] = []
+
+  const deviceBox = (element: Element): Box => {
+    const { x, y, width, height } = element.getBoundingClientRect()
+
+    return { x: x * dpr, y: y * dpr, width: width * dpr, height: height * dpr }
+  }
+
+  // Popovers take precedence if an unusually dense atlas exhausts the budget.
+  for (const panel of document.querySelectorAll('[data-pet-output-target]')) {
+    const box = deviceBox(panel)
+    const x = Math.max(0, Math.floor(box.x)), y = Math.max(0, Math.floor(box.y))
+    const width = Math.min(viewport.width, Math.ceil(box.x + box.width)) - x
+    const height = Math.min(viewport.height, Math.ceil(box.y + box.height)) - y
+
+    if (width > 0 && height > 0 && regions.length < MAX_RECTS * 4) {regions.push(x, y, width, height)}
+  }
+
+  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-pet-caption]:not([data-pet-dropping]) canvas')) {
+    if (!canvas.width || !canvas.height || regions.length >= MAX_RECTS * 4) {continue}
+    const button = canvas.closest('[data-pet-caption]')
+    const box = deviceBox(canvas)
+
+    if (!button || !box.width || !box.height || Number(getComputedStyle(button).opacity) < 0.06) {continue}
+
+    try {
+      const pixels = readPixels(canvas)
+
+      if (!pixels) {continue}
+      const mirrored = button.hasAttribute('data-pet-mirrored')
+      const cached = shapes.get(pixels)
+
+      // At the cap, the original scan can stop before extending a vertical run.
+      if (cached && cached.mirrored === mirrored && sameBox(cached.box, box) && sameBox(cached.viewport, viewport) &&
+          regions.length + cached.rectangles.length < MAX_RECTS * 4) {
+        regions.push(...cached.rectangles)
+
+        continue
+      }
+
+      const start = regions.length
+      appendSpriteRegion(regions, box, pixels, viewport, mirrored)
+
+      if (regions.length < MAX_RECTS * 4) {
+        shapes.set(pixels, { box, viewport, mirrored, rectangles: regions.slice(start) })
+      }
+    } catch {
+      // A canvas without readable pixels contributes no input.
+    }
+  }
+
+  return regions
+}
+
+export function observeLinuxPetInput(send: (regions: number[]) => void): () => void {
+  let previous: number[] = []
+  let frame: number | null = null
+  let lastTime = -Infinity
+  let readFailed = false
+  let canRetry = true
+  const shapes = new WeakMap<ImageData, SpriteShape>()
+  const readbacks = new WeakMap<HTMLCanvasElement, { version: number; pixels: ImageData }>()
+
+  const readPixels = (canvas: HTMLCanvasElement) => {
+    const { width, height } = canvas
+    const version = petSpritePaintVersion(canvas)
+    const cached = readbacks.get(canvas)
+
+    if (cached && cached.version === version && cached.pixels.width === width && cached.pixels.height === height) {
+      return cached.pixels
+    }
+
+    try {
+      const pixels = canvas.getContext('2d')?.getImageData(0, 0, width, height)
+
+      if (pixels && version !== undefined) {readbacks.set(canvas, { version, pixels })}
+
+      return pixels
+    } catch {
+      readFailed = true
+    }
+  }
+
+  const schedule = () => {
+    frame ??= requestAnimationFrame(update)
+  }
+
+  const wake = () => {
+    canRetry = true
+    schedule()
+  }
+
+  function update(time: number) {
+    frame = null
+
+    if (time - lastTime < 32) {
+      schedule()
+
+      return
+    }
+
+    lastTime = time
+    readFailed = false
+
+    const regions = inputRegion(readPixels, shapes)
+    const animating = document.getAnimations?.().some(animation => animation.pending || animation.playState === 'running')
+
+    if (animating || (readFailed && canRetry)) {schedule()}
+
+    if (readFailed) {canRetry = false}
+
+    if (regions.length === previous.length && regions.every((part, i) => part === previous[i])) {return}
+    previous = regions
+    send(regions)
+  }
+
+  const changes = new MutationObserver(records => {
+    for (const { target, attributeName } of records) {
+      // Assigning the same width or height also clears the backing store.
+      if (target instanceof HTMLCanvasElement && (attributeName === 'width' || attributeName === 'height')) {
+        readbacks.delete(target)
+      }
+    }
+
+    wake()
+  })
+
+  changes.observe(document.documentElement, { subtree: true, attributes: true, childList: true, characterData: true })
+
+  const hooks = new AbortController()
+  const { signal } = hooks
+
+  const events = ['resize', 'scroll', 'visibilitychange', 'load', 'animationstart', 'animationend', 'animationcancel',
+    'transitionrun', 'transitionend', 'transitioncancel']
+
+  for (const event of events) {window.addEventListener(event, wake, { capture: true, signal })}
+  window.visualViewport?.addEventListener('resize', wake, { signal })
+  window.visualViewport?.addEventListener('scroll', wake, { signal })
+  document.fonts?.addEventListener('loadingdone', wake, { signal })
+
+  const unsubscribePaint = subscribePetSpritePaint(wake)
+
+  wake()
+
+  return () => {
+    hooks.abort()
+    unsubscribePaint()
+    changes.disconnect()
+
+    if (frame !== null) {cancelAnimationFrame(frame)}
+    send([])
+  }
+}
