index 0000000000000000000000000000000000000000..d533dabc91a2d86f3c7942c59522aebb42d933d8
--- /dev/null
+++ b/apps/desktop/src/app/focus/control-panel.tsx
@@ -0,0 +1,156 @@
+import { useContext, useEffect } from 'react'
+import { useNavigate } from 'react-router'
+
+import { AGENTS_ROUTE } from '@/app/routes'
+import { StatusSection } from '@/components/chat/status-section'
+import { useI18n } from '@/i18n'
+import { todoTree } from '@/lib/todos'
+import { useStoreSelector } from '@/lib/use-session-slice'
+import { $sessionControlBySession, refreshSessionControl } from '@/store/session-control'
+import { $retainedSubagentsBySession, $subagentsBySession } from '@/store/subagents'
+import { $retainedTodosBySession, $todosBySession } from '@/store/todos'
+import { openSessionInNewWindow } from '@/store/windows'
+
+import { SessionControlSections } from '../chat/composer/status-stack/session-control'
+import { StatusItemRow } from '../chat/composer/status-stack/status-row'
+import { ContribWiringContext } from '../contrib/context'
+
+import { useFocusCopy } from './copy'
+import { useParityCopy } from './parity-copy'
+
+/** Target identity rides every native control/submit, including after focus changes. */
+export function FocusControlPanel({ sessionId }: { sessionId: string }) {
+  const entry = useStoreSelector($sessionControlBySession, rows => rows[sessionId])
+
+  const api = useContext(ContribWiringContext),
+    t = useParityCopy()
+
+  useEffect(() => {
+    void refreshSessionControl(sessionId)
+  }, [sessionId])
+  const submit = api?.actions?.onSubmit
+
+  if (!entry) {
+    return <p role="status">{t('unknown')}</p>
+  }
+
+  return (
+    <section aria-label={t('controls')}>
+      <h3>{t('controls')}</h3>
+      {!entry.snapshot ? (
+        <p>{t('unknown')}</p>
+      ) : !entry.snapshot.goal && !entry.snapshot.loop && !entry.snapshot.heartbeat ? (
+        <p>{t('noControls')}</p>
+      ) : null}
+      <SessionControlSections
+        entry={entry}
+        onSubmit={submit ? (value, options) => submit(value, { ...options, sessionId }) : undefined}
+        sessionId={sessionId}
+      />
+    </section>
+  )
+}
+
+/** Read only the bound session's received activity; completion stays with native goals. */
+export function FocusActivityPanel({
+  sessionId,
+  parentSessionId
+}: {
+  sessionId: string
+  parentSessionId: string | null
+}) {
+  const { t } = useI18n()
+  const copy = useFocusCopy()
+  const navigate = useNavigate()
+
+  const current =
+    useStoreSelector($todosBySession, rows => (Object.hasOwn(rows, sessionId) ? rows[sessionId] : undefined)) ?? []
+
+  const retained =
+    useStoreSelector($retainedTodosBySession, rows => (Object.hasOwn(rows, sessionId) ? rows[sessionId] : undefined)) ??
+    []
+
+  const liveWorkers =
+    useStoreSelector($subagentsBySession, rows => (Object.hasOwn(rows, sessionId) ? rows[sessionId] : undefined)) ?? []
+
+  const previousWorkers =
+    useStoreSelector($retainedSubagentsBySession, rows =>
+      Object.hasOwn(rows, sessionId) ? rows[sessionId] : undefined
+    ) ?? []
+
+  const workers = [
+    ...liveWorkers,
+    ...previousWorkers.filter(previous => !liveWorkers.some(worker => worker.id === previous.id))
+  ]
+
+  const historical = current.length === 0
+  const todos = historical ? retained : current
+  const done = todos.filter(todo => todo.status === 'completed').length
+
+  return (
+    <section aria-label={copy('latest')}>
+      {!todos.length && !workers.length && <p>{copy('unknown')}</p>}
+      {todos.length > 0 && (
+        <StatusSection
+          defaultCollapsed={false}
+          label={historical ? t.statusStack.previousTodos(done, todos.length) : t.statusStack.todos(done, todos.length)}
+        >
+          {todoTree(todos).map(([todo, depth]) => (
+            <StatusItemRow
+              historical={historical}
+              item={{
+                id: todo.id,
+                type: 'todo',
+                title: todo.content,
+                todoStatus: todo.status,
+                depth,
+                state: !historical && todo.status === 'in_progress' ? 'running' : 'done'
+              }}
+              key={todo.id}
+            />
+          ))}
+        </StatusSection>
+      )}
+      {workers.length > 0 && (
+        <StatusSection defaultCollapsed={false} label={t.statusStack.subagents(workers.length)}>
+          {workers.map(worker => (
+            <div key={worker.id}>
+              <StatusItemRow
+                item={{
+                  id: worker.id,
+                  type: 'subagent',
+                  title: worker.goal,
+                  currentTool: worker.currentTool,
+                  state:
+                    worker.status === 'completed'
+                      ? 'done'
+                      : worker.status === 'failed' || worker.status === 'interrupted'
+                        ? 'failed'
+                        : 'running'
+                }}
+                onOpen={() =>
+                  worker.sessionId
+                    ? void openSessionInNewWindow(worker.sessionId, {
+                        watch: true,
+                        parentSessionId: parentSessionId ?? sessionId
+                      })
+                    : navigate(AGENTS_ROUTE)
+                }
+              />
+              <p className="pl-6 text-xs text-muted-foreground break-words">
+                {
+                  t.agents[
+                    worker.status === 'completed' ? 'done' : worker.status === 'interrupted' ? 'failed' : worker.status
+                  ]
+                }
+              </p>
+              {(worker.summary || worker.stream.at(-1)?.text) && (
+                <p className="pl-6 text-xs break-words">{worker.summary || worker.stream.at(-1)?.text}</p>
+              )}
+            </div>
+          ))}
+        </StatusSection>
+      )}
+    </section>
+  )
+}
