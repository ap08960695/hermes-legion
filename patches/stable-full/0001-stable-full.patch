@@ -0,0 +1,61 @@
+"""Ready-gated demand start keeps empty hosted profiles thread-free."""
+import contextvars
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+from tui_gateway.hosted_room_driver import HostedRoomRuntime
+
+
+def test_armed_runtime_waits_for_work_and_concurrent_wakes_start_one_owner(tmp_path):
+    entered, release = threading.Event(), threading.Event()
+    marker = contextvars.ContextVar('hosted_test_owner', default='wrong')
+    observed = []
+
+    def rooms():
+        observed.append(marker.get())
+        entered.set()
+        assert release.wait(5), 'test must release discovery'
+        return ()
+
+    runtime = HostedRoomRuntime(db_path=tmp_path / 'state.db', rooms=rooms,
+                                turn_lock=lambda _: None, rpc=object())
+    try:
+        runtime.arm()
+        assert not runtime.status()['running'], 'arming an empty profile must allocate no supervisor'
+        token = marker.set('owning-profile')
+        try:
+            # Copy a distinct caller context for each real concurrent producer.
+            contexts = [contextvars.copy_context() for _ in range(16)]
+            with ThreadPoolExecutor(max_workers=4) as pool:
+                list(pool.map(lambda ctx: ctx.run(runtime.wakeup), contexts))
+        finally:
+            marker.reset(token)
+        assert entered.wait(5)
+        assert runtime.status()['running']
+        assert observed == ['owning-profile']
+    finally:
+        release.set()
+        assert runtime.stop(timeout=5)
+    runtime.wakeup()
+    runtime.arm()  # A stale ready snapshot cannot revive a stopped generation.
+    assert not runtime.status()['running']
+    assert runtime.status()['stopping']
+
+
+def test_pre_ready_wake_is_retained_and_explicit_restart_still_works(tmp_path):
+    entered = threading.Event()
+    runtime = HostedRoomRuntime(db_path=tmp_path / 'state.db',
+        rooms=lambda: entered.set() or (), turn_lock=lambda _: None, rpc=object())
+    runtime.wakeup()
+    assert not runtime.status()['running']
+    try:
+        runtime.arm()
+        assert entered.wait(5), 'queued pre-ready wake must be released at readiness'
+    finally:
+        assert runtime.stop(timeout=5)
+    entered.clear()
+    try:
+        runtime.start()
+        assert entered.wait(5), 'explicit TUI restart contract remains supported'
+    finally:
+        assert runtime.stop(timeout=5)
