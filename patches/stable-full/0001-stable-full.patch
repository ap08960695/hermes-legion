@@ -0,0 +1,78 @@
+"""profiles.list ``worker_session`` must satisfy ``ProfileWorkerSession`` (extra="forbid").
+
+Why: the projection emitted ``last_activity_description`` / ``ended_at`` the contract lacked, so every
+roster poll logged a wire-contract violation. It now also carries bounded progress fields (current tool
+name, api-call iteration/cap, start time, token totals) read off the row it already has."""
+
+from __future__ import annotations
+
+import json
+import time
+from pathlib import Path
+
+import pytest
+from pydantic import ValidationError
+
+import tui_gateway.server as srv
+from tui_gateway.contracts.profiles_vault_complete_foreign_subagents import ProfileWorkerSession
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    h = tmp_path / ".hermes"
+    h.mkdir(parents=True)
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(h))
+    return h
+
+
+def test_worker_session_projection_validates_with_progress_fields(home):
+    from hermes_state import SessionDB
+
+    db = SessionDB(db_path=home / "state.db")
+    now = time.time()
+    db.create_session("w1", "kanban")
+    db.append_message("w1", "user", "secret task prompt", timestamp=now)
+    db.touch_session_activity("w1", ts=now + 1, description="executing tool: terminal")
+    with db._lock:
+        db._conn.execute(
+            "UPDATE sessions SET api_call_count = 3, input_tokens = 1200, output_tokens = 340,"
+            " model_config = ? WHERE id = 'w1'", (json.dumps({"max_iterations": 50}),))
+    db.close()
+
+    profiles = srv._methods["profiles.list"](1, {})["result"]["profiles"]
+    worker = next(p for p in profiles if p["name"] == "default")["worker_session"]
+
+    ProfileWorkerSession.model_validate(worker)  # extra="forbid": any unmodelled key raises
+    assert worker["current_tool"] == "terminal"
+    assert (worker["iteration"], worker["max_iterations"]) == (3, 50)
+    assert (worker["input_tokens"], worker["output_tokens"]) == (1200, 340)
+    assert worker["started_at"] and worker["ended_at"] is None
+    assert "secret task prompt" not in str(worker)
+
+
+@pytest.mark.parametrize("desc,tool", [
+    ("executing tool: web_search", "web_search"),
+    ("sequential tool running (30s): terminal", "terminal"),
+    ("tool completed: terminal (1.2s)", None),
+    ("executing 2 tools concurrently: a, b", None),
+    ("", None),
+])
+def test_current_tool_from_description(desc, tool):
+    from agent.session_activity import current_tool_from_description
+
+    assert current_tool_from_description(desc) == tool
+
+
+
+def test_optional_parallel_worker_contract_accepts_old_rows_and_bounds_new_metadata():
+    from tui_gateway.contracts.profiles_vault_complete_foreign_subagents import ProfileRow
+    base = {'name': 'fixture', 'path': '/synthetic/profile'}
+    assert ProfileRow.model_validate(base).name == 'fixture'
+    worker = {'id': 'worker', 'title': 'Observed task', 'last_active': 2000}
+    row = ProfileRow.model_validate({**base, 'worker_sessions': [worker]})
+    assert len(row.worker_sessions) == 1
+    with pytest.raises(ValidationError):
+        ProfileRow.model_validate({**base, 'worker_sessions': [worker] * 21})
+    with pytest.raises(ValidationError):
+        ProfileRow.model_validate({**base, 'worker_sessions': [{**worker, 'system_prompt': 'private'}]})
