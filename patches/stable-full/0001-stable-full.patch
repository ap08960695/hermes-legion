+from hermes_cli import goals, kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli import kanban_db_notify as notify
+from tools.kanban_tools import _resolve_notify_target
+
+
+@pytest.fixture
+def fleet(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(home))
+    for name in ("HERMES_KANBAN_DB", "HERMES_KANBAN_TASK", "HERMES_KANBAN_BOARD"):
+        monkeypatch.delenv(name, raising=False)
+    goals._DB_CACHE.clear()
+    goals._get_session_db()
+    yield home
+    goals._DB_CACHE.clear()
+
+
+def follow(conn, target):
+    task = kb.create_task(conn, title="synthetic pending task", workspace_kind="scratch")
+    notify.add_notify_sub(conn, task_id=task, **target)
+    return task
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("platform,same_id,profile,neighbors", [
+    (Platform.SLACK, False, "default", False),
+    (Platform.LOCAL, False, "default", False),
+    (Platform.SLACK, True, "default", True),
+    (Platform.SLACK, False, "secondary", True),
+])
+async def test_goal_hook_sees_its_real_notification_route(fleet, monkeypatch, platform, same_id, profile, neighbors):
+    stored = "synthetic-history-session"
+    source = SessionSource(platform=platform, chat_id=stored if same_id else "synthetic-chat",
+                           thread_id="synthetic-thread", profile=profile, chat_type="channel")
+    runner = object.__new__(GatewayRunner)
+    runner.config = GatewayConfig(multiplex_profiles=False)
+    runner.adapters = {}
+    runner._defer_goal_status_notice_after_delivery = AsyncMock()
+    context = SessionContext(source=source, connected_platforms=[], home_channels={},
+                             session_key="synthetic-route-key", session_id=stored)
+    with runner._session_env_scope(context):
+        target = _resolve_notify_target()
+    assert target["chat_id"] == source.chat_id and target["notifier_profile"] == profile
+    with kbc.connect_closing() as conn:
+        follow(conn, target)
+        if neighbors:
+            for fields in ({"thread_id": "another-thread"}, {"platform": "telegram"},
+                           {"notifier_profile": "another-profile"}):
+                follow(conn, {**target, **fields})
+    goals.GoalManager(session_id=stored).set("Finish only the original followed task", max_turns=3)
+    counts = []
+
+    def judge(*args, **kwargs):
+        counts.append(kwargs["active_kanban_cards"])
+        return "wait", "Original task pending", False, {"seconds": 900}, False
+
+    monkeypatch.setattr(goals, "judge_goal", judge)
+    try:
+        await runner._post_turn_goal_continuation(session_entry=SimpleNamespace(session_id=stored),
+                                                 source=source, final_response="Pending original work")
+        assert counts == [1]
+        parked = goals.GoalManager(session_id=stored)
+        assert parked.is_waiting()
+        used = parked.state.turns_used
+        # An idle observation is not a second successful model turn.
+        parked.evaluate_after_turn("Passive observation")
+        assert counts == [1] and goals.GoalManager(session_id=stored).state.turns_used == used
+    finally:
+        runner._shutdown_executor(drain_timeout=5)
+
+
+def test_legacy_direct_session_goal_still_counts_its_own_subscriptions(fleet, monkeypatch):
+    stored = "synthetic-legacy-session"
+    with kbc.connect_closing() as conn:
+        follow(conn, {"platform": "tui", "chat_id": stored})
+    manager = goals.GoalManager(session_id=stored)
+    manager.set("Finish the original task", max_turns=3)
+    counts = []
+
+    def judge(*args, **kwargs):
+        counts.append(kwargs["active_kanban_cards"])
+        return "wait", "Pending", False, {"seconds": 900}, False
+
+    monkeypatch.setattr(goals, "judge_goal", judge)
+    assert manager.evaluate_after_turn("Pending")["verdict"] == "wait"
+    assert counts == [1]
+
+
+def test_pinned_runtime_identity_wins_over_source_display_profile(fleet):
+    source = SessionSource(platform=Platform.LOCAL, chat_id="synthetic-local", profile="display-profile")
+    source._identity = RoutingIdentity(transport_profile="default", runtime_profile="actual-owner",
+                                      authorization_home=fleet, runtime_home=fleet / "profiles/actual-owner")
+    runner = object.__new__(GatewayRunner)
+    target = runner._goal_kanban_notification_target(source)
+    assert target["notifier_profile"] == "actual-owner"
+    assert target["platform"] == "local" and target["chat_id"] == "synthetic-local"
+
+
+def test_route_values_are_bound_and_legacy_unowned_rows_keep_their_exact_destination(fleet):
+    target = {"platform": "slack", "chat_id": "synthetic' OR 1=1 --",
+              "thread_id": "one-thread", "notifier_profile": "default"}
+    with kbc.connect_closing() as conn:
+        follow(conn, target)
+        follow(conn, {**target, "notifier_profile": None})
+        follow(conn, {**target, "chat_id": "unrelated"})
+    assert goals.count_active_kanban_cards("history-id", notification_target=target) == 2
+    for field in ("chat_id", "platform", "notifier_profile"):
+        assert goals.count_active_kanban_cards("history-id", notification_target={**target, field: ""}) == 0
