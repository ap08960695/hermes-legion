+"""Desktop relay selectors are routed before strict payload validation, without inference."""
+import asyncio
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.session_controls import AuthorityConnection
+from hermes_state import SessionDB
+from tools.bot_relay import read_remote_roster, relay_root, write_remote_roster
+
+
+@pytest.fixture
+def connections(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    root = tmp_path / '.hermes'
+    root.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(root))
+    homes = [root, root / 'profiles' / 'work']
+    authorities = []
+    for home in homes:
+        home.mkdir(parents=True, exist_ok=True)
+        (home / 'config.yaml').write_text('{}')
+        db = SessionDB(home / 'state.db')
+        authorities.append(SimpleNamespace(profile_id=str(home), instance_id='owner', db=db,
+                                           events={}, sessions={}))
+    runner = SimpleNamespace(session_authorities=authorities)
+    for authority in authorities:
+        authority.runner = runner
+    def connect(*, host=True, capabilities=None):
+        identity = {'user_id': 'owner', 'profile_scope': 'host' if host else 'profile'}
+        if capabilities is not None:
+            identity['capabilities'] = capabilities
+        connection = AuthorityConnection(authorities[0], object(), identity)
+        return connection
+
+    yield homes, connect
+    for authority in authorities:
+        authority.db.close()
+
+
+def call(connection, method, **params):
+    return asyncio.run(connection.dispatch({'id': 1, 'method': method, 'params': params}))
+
+
+@pytest.mark.parametrize('profile,index', [('default', 0), ('work', 1)])
+def test_routed_roster_clear_retires_only_the_selected_homes_peers(connections, profile, index):
+    homes, connect = connections
+    row = {'profile': 'peer', 'handle': 'peer', 'connection_id': 'other'}
+    for home in homes:
+        assert write_remote_roster(home, [row]) == 1
+
+    reply = call(connect(), 'bot_relay.roster.sync', profile=profile, agents=[])
+
+    assert reply.get('result') == {'count': 0}, reply
+    assert read_remote_roster(homes[index]) == []
+    assert read_remote_roster(homes[1 - index])[0]['handle'] == 'peer'
+
+
+@pytest.mark.parametrize('method,params,expected', [
+    ('bot_relay.outbox.drain', {}, {'envelopes': []}),
+    ('bot_relay.reply', {'id': 'f' * 32, 'reply': 'ACK'}, {'ok': True}),
+])
+def test_other_relay_controls_accept_their_own_profile_selector(connections, method, params, expected):
+    homes, connect = connections
+
+    reply = call(connect(), method, profile='default', **params)
+
+    assert reply.get('result') == expected, reply
+    if method == 'bot_relay.reply':
+        saved = json.loads((relay_root(homes[0]) / 'replies' / (params['id'] + '.json')).read_text())
+        assert saved['reply'] == 'ACK'
+
+
+@pytest.mark.parametrize('profile,host,capabilities,extra,reason', [
+    ('work', False, None, {}, 'profile_mismatch'),
+    ('missing', True, None, {}, 'profile_mismatch'),
+    ('default', True, ['session:read'], {}, 'permission_denied'),
+    ('default', True, None, {'unexpected': True}, 'invalid_params'),
+])
+def test_selector_support_keeps_scope_capability_and_payload_fences(connections, profile, host, capabilities,
+                                                                   extra, reason):
+    homes, connect = connections
+
+    reply = call(connect(host=host, capabilities=capabilities), 'bot_relay.roster.sync',
+                 profile=profile, agents=[], **extra)
+
+    assert reply.get('error', {}).get('message') == reason, reply
+    assert all(not relay_root(home).exists() for home in homes)
