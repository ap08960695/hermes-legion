@@ -0,0 +1,318 @@
+import { atom } from 'nanostores'
+
+import { mediaTagValues } from '@/lib/chat-messages/parts'
+import { boundedCharacterSprite, MAX_PREVIEW_CHARACTERS } from '@/lib/pet-character-sprite'
+import { isMacPlatform } from '@/lib/platform'
+import type { PetInfo, PetState } from '@/store/pet'
+import { sanitizePetText } from '@/store/pet-plugin-messages'
+
+import { type CharacterSize, isCharacterSize } from './character-settings'
+
+export interface PetCharacter {
+  id: string
+  name: string
+  source: string
+  detail: string
+  outputId?: string
+  actionsOnly?: true
+  waitingId?: string
+  failure?: { id: string; at: number }
+  completion?: { id: string; at: number }
+  handoff?: { from: string; at: number } | { to: string; at: number; report: readonly [string, number] }
+  sprite?: PetInfo
+  state: PetState
+}
+
+export type WorkerStopStatus = 'requested' | 'refused' | 'unconfirmed'
+type StopWorker = () => Promise<WorkerStopStatus>
+
+interface OutputSource {
+  key: string
+  read?: (pdfPreview?: true) => Promise<string | null | { text: string | null; complete?: boolean; file_preview?: { path: string; token: string } | null }>
+  prepareStop?: () => Promise<StopWorker | undefined>
+  previewFile?: (token: string, pdfPreview?: true) => Promise<PetCharacterFileSnapshot>
+  open?: (stillCurrent: () => boolean) => Promise<void>
+}
+
+export interface PetCharacterOutput {
+  id: string
+  request: number
+  text: string | null
+  unavailable?: true
+  canOpen?: true
+  canStop?: true
+  stopStatus?: WorkerStopStatus
+  canLink?: true
+  deliveredFile?: string
+  canPreviewFile?: true
+  links?: string[]
+}
+
+export interface PetCharacterFileContent {
+  text: string | null
+  png_base64?: string
+}
+
+export type PetCharacterFileSnapshot = PetCharacterFileContent & { pdf_base64?: string }
+
+export interface PetCharacterFile extends PetCharacterFileContent {
+  id: string
+  request: number
+}
+
+export interface PetCharacterPublisher {
+  atlasVariant?: 'half'
+  /** Prepare an immutable bounded atlas snapshot before caching; absent on older shells. */
+  prepareSprite?: (input: unknown) => PetInfo | null
+  update: (characters: (PetCharacter & { output?: OutputSource })[], observedAt?: number, size?: CharacterSize, defaultSprite?: PetInfo) => void
+  dispose: () => void
+}
+
+export interface PetCharacterPreview {
+  characters: PetCharacter[]
+  expiresAt: number
+  size?: CharacterSize
+  defaultSprite?: PetInfo
+}
+
+export const $petCharacterPreview = atom<PetCharacterPreview | null>(null)
+let owner: symbol | null = null
+let nextOutputId = 0
+let outputBindings = new Map<string, OutputSource & { id: string }>()
+let timer: ReturnType<typeof setTimeout> | undefined
+const states = new Set<PetState>(['idle', 'wave', 'run', 'failed', 'review', 'jump', 'waiting'])
+
+
+/** An output address is valid only while the current preview still publishes it. */
+function currentOutputBinding(id: string) {
+  if (($petCharacterPreview.get()?.expiresAt ?? 0) <= Date.now()) {return undefined}
+
+  return [...outputBindings.values()].find(value => value.id === id)
+}
+
+// shortcut: identify one standalone text delivery until the gateway projects structured attachments.
+function deliveredPreviewFile(text: string): { path: string; excerpt: string } | undefined {
+  if (text.length > 600 || /(?:^|\n)[ \t]*(?:`{3,}|~{3,})/.test(text)) {return undefined}
+  const [value, ...other] = mediaTagValues(text)
+
+  if (!value || other.length) {return undefined}
+  const lines = text.split(/\r?\n/)
+  const index = lines.findIndex(line => line.startsWith('MEDIA:') && line.slice(6).trim() === value)
+  const quote = value[0]
+  const quoted = (quote === '"' || quote === "'") && value.endsWith(quote)
+  const path = quoted ? value.slice(1, -1) : value
+
+  if (index < 0 || (!quoted && /\s/u.test(path)) || !/^\/(?!\/)[^"\x60\\\p{C}\p{Zl}\p{Zp}]+\.(?:[Tt][Xx][Tt]|[Mm][Dd]|[Cc][Ss][Vv]|[Pp][Nn][Gg]|[Pp][Dd][Ff])$/u.test(path)) {return undefined}
+  lines.splice(index, 1)
+
+  return { path, excerpt: lines.join('\n') }
+}
+
+export async function readPetCharacterOutput(id: string): Promise<(Pick<PetCharacterOutput, 'text' | 'unavailable' | 'canOpen' | 'canLink' | 'deliveredFile'> & { fileToken?: string; stop?: StopWorker }) | undefined> {
+  const binding = currentOutputBinding(id)
+
+  if (!binding) {return undefined}
+
+  try {
+    if (binding.prepareStop) {
+      const stop = await binding.prepareStop()
+
+      if (currentOutputBinding(id) !== binding) {return undefined}
+
+      return { text: null, stop: stop && (async () => currentOutputBinding(id) === binding ? stop() : 'refused') }
+    }
+
+    let allowPdf = Boolean(binding.previewFile && window.hermesDesktop?.petOverlay && isMacPlatform())
+
+    const reply = await (allowPdf ? binding.read?.(true).catch((error: unknown) => {
+      // Older gateways reject the added parameter. Preserve their existing file previews.
+      if (!error || typeof error !== 'object' || !('message' in error) || error.message !== 'invalid_params') {throw error}
+      allowPdf = false
+
+      return binding.read?.()
+    }) : binding.read?.())
+
+    const raw = typeof reply === 'string' ? reply : reply?.text
+    const complete = typeof reply === 'object' && reply?.complete === true && typeof raw === 'string'
+    const delivery = complete ? deliveredPreviewFile(raw) : undefined
+    const offered = complete ? reply.file_preview : undefined
+
+    const fileToken = delivery && (allowPdf || !/\.pdf$/i.test(delivery.path)) && offered?.path === delivery.path && binding.previewFile &&
+      typeof offered.token === 'string' && /^[0-9]{1,12}\.[0-9a-f]{64}$/.test(offered.token) ? offered.token : undefined
+
+    const excerpt = delivery?.excerpt ?? (typeof raw === 'string' ? raw : '')
+    const text = sanitizePetText(excerpt, 1200) || null
+
+    // Preserve URL spelling and whitespace boundaries from the completed gateway reply.
+    const canLink = complete && excerpt.replace(/[ \t\r\n]+/g, ' ').replace(/^ | $/g, '') === text
+
+    return currentOutputBinding(id) === binding ? {
+      text,
+      ...(canLink ? { canLink: true } : {}),
+      ...(delivery ? { deliveredFile: delivery.path } : {}),
+      ...(fileToken ? { fileToken } : {}),
+      ...(typeof binding.open === 'function' ? { canOpen: true } : {})
+    } : undefined
+  } catch {
+    return currentOutputBinding(id) === binding ? { text: null, unavailable: true } : undefined
+  }
+}
+
+export async function readPetCharacterFile(id: string, token: string, pdf: boolean): Promise<PetCharacterFileSnapshot | undefined> {
+  const binding = currentOutputBinding(id)
+
+  if (!binding?.previewFile) {return undefined}
+  let file: PetCharacterFileSnapshot = { text: null }
+
+  try {
+    const reply = await (pdf ? binding.previewFile(token, true) : binding.previewFile(token))
+
+    if (pdf) {
+      if (reply?.text === null && reply.png_base64 == null && typeof reply.pdf_base64 === 'string') {
+        file = { text: null, pdf_base64: reply.pdf_base64 }
+      }
+    } else if (typeof reply?.text === 'string' && reply.text.length <= 8192) {
+      file = { text: reply.text }
+    } else if (reply?.text === null && typeof reply.png_base64 === 'string') {
+      file = { text: null, png_base64: reply.png_base64 }
+    }
+  } catch {
+    // File absence and a stale gateway ticket share the unavailable state.
+  }
+
+  return currentOutputBinding(id) === binding ? file : undefined
+}
+
+export async function openPetCharacterOutput(id: string, popoverCurrent: () => boolean): Promise<void> {
+  const binding = currentOutputBinding(id)
+
+  if (!popoverCurrent() || typeof binding?.open !== 'function') {return}
+  await binding.open(() => popoverCurrent() && currentOutputBinding(id) === binding)
+}
+
+const CHARACTER_RENEWAL_INTERVAL_MS = 4000
+
+function sameCharacters(previous: PetCharacter[], next: PetCharacter[]): boolean {
+  return previous.length === next.length && next.every(({ sprite, ...actor }, index) => {
+    const { sprite: previousSprite, ...previousActor } = previous[index]
+
+    return sprite === previousSprite && JSON.stringify(actor) === JSON.stringify(previousActor)
+  })
+}
+
+/** One replaceable preview owns the shared overlay; old publishers cannot revive it. */
+export function createPetCharacterPublisher(pluginId: string) {
+  const token = Symbol(pluginId)
+  owner = token
+  clearTimeout(timer)
+  outputBindings.clear()
+  $petCharacterPreview.set({ characters: [], expiresAt: 0 })
+
+  let publishedAt = 0
+
+  const expire = () => {
+    if (owner !== token) {return}
+    outputBindings.clear()
+    $petCharacterPreview.set({ characters: [], expiresAt: 0 })
+  }
+
+  const publish = (snapshot: PetCharacterPreview) => {
+    if (owner !== token) {return}
+    publishedAt = Date.now()
+
+    if (snapshot.expiresAt <= publishedAt) {
+      expire()
+
+      return
+    }
+
+    timer = setTimeout(expire, snapshot.expiresAt - publishedAt)
+    $petCharacterPreview.set(snapshot)
+  }
+
+  return {
+    prepareSprite: boundedCharacterSprite,
+    isCurrent: () => owner === token,
+    update: (input: (PetCharacter & { output?: OutputSource })[], observedAt = Date.now(), size?: CharacterSize, defaultSprite?: PetInfo) => {
+      if (owner !== token) {return}
+      const now = Date.now()
+      const expiresAt = Number.isFinite(observedAt) ? Math.min(now, observedAt) + 15_000 : 0
+      const characters: PetCharacter[] = [], seen = new Set<string>()
+      const bindings = new Map<string, OutputSource & { id: string }>()
+
+      for (const item of (Array.isArray(input) && expiresAt > now ? input : []).slice(0, 20)) {
+        if (!item || typeof item.id !== 'string' || !item.id || item.id.length > 256 || seen.has(item.id)) {continue}
+        const sprite = item.sprite === undefined ? undefined : boundedCharacterSprite(item.sprite)
+
+        if (sprite === null) {continue}
+        seen.add(item.id)
+        const previous = outputBindings.get(item.id)
+        const output = item.output && (previous?.key === item.output.key ? previous : { ...item.output, id: String(++nextOutputId) })
+
+        if (output) {bindings.set(item.id, output)}
+        const event = item.handoff
+        let handoff: PetCharacter['handoff']
+
+        if (event && typeof event === 'object' && Number.isSafeInteger(event.at) && event.at > 0 && event.at <= now) {
+          const peer = 'to' in event ? event.to : event.from
+
+          if (typeof peer === 'string' && peer && peer.length <= 256 && peer !== item.id) {
+            const qualified = JSON.stringify([pluginId, peer])
+
+            if ('to' in event) {
+              const report = event.report
+
+              if (Array.isArray(report) && report.length === 2 && typeof report[0] === 'string' &&
+                  report[0].length > 0 && report[0].length <= 512 && Number.isSafeInteger(report[1]) && report[1] >= 0) {
+                handoff = { to: qualified, at: event.at, report: [report[0], report[1]] }
+              }
+            } else {
+              handoff = { from: qualified, at: event.at }
+            }
+          }
+        }
+
+        const waitingId = item.state === 'waiting' && typeof item.waitingId === 'string' && item.waitingId.length <= 256 ? item.waitingId : undefined
+        const reportCue = item.state === 'failed' ? item.failure : item.state === 'wave' ? item.completion : undefined
+
+        const cue = reportCue && typeof reportCue.id === 'string' && reportCue.id.length > 0 && reportCue.id.length <= 1024 &&
+          Number.isSafeInteger(reportCue.at) && reportCue.at > 0 && reportCue.at <= now ? { id: reportCue.id, at: reportCue.at } : undefined
+
+        characters.push({ ...(output ? { outputId: output.id, ...(output.prepareStop ? { actionsOnly: true as const } : {}) } : {}),
+          ...(waitingId ? { waitingId } : {}), ...(cue ? (item.state === 'failed' ? { failure: cue } : { completion: cue }) : {}),
+          id: JSON.stringify([pluginId, item.id]), name: sanitizePetText(item.name, 80), source: sanitizePetText(item.source, 80),
+          detail: sanitizePetText(item.detail, 160), state: states.has(item.state) ? item.state : 'idle',
+          ...(sprite ? { sprite } : {}), ...(handoff ? { handoff } : {}) })
+
+        if (characters.length === MAX_PREVIEW_CHARACTERS) {break}
+      }
+
+      clearTimeout(timer)
+      outputBindings = bindings
+      const previous = $petCharacterPreview.get()
+      const fallback = characters.some(actor => !actor.sprite) ? boundedCharacterSprite(defaultSprite) : null
+      const snapshot = { characters, expiresAt: characters.length ? expiresAt : 0,
+        ...(isCharacterSize(size) ? { size } : {}), ...(fallback ? { defaultSprite: fallback } : {}) }
+
+      if (previous && previous.size === snapshot.size && previous.defaultSprite === snapshot.defaultSprite && characters.length && expiresAt >= previous.expiresAt) {
+        // Keep a fixed trailing deadline, with headroom before the currently displayed lease expires.
+        const renewAt = Math.min(publishedAt + CHARACTER_RENEWAL_INTERVAL_MS, previous.expiresAt - CHARACTER_RENEWAL_INTERVAL_MS)
+
+        if (renewAt > now && sameCharacters(previous.characters, characters)) {
+          timer = setTimeout(() => publish(snapshot), renewAt - now)
+
+          return
+        }
+      }
+
+      publish(snapshot)
+    },
+    dispose: () => {
+      if (owner !== token) {return}
+      owner = null
+      outputBindings.clear()
+      clearTimeout(timer)
+      $petCharacterPreview.set(null)
+    }
+  }
+}
