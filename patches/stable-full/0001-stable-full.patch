+@pytest.mark.parametrize("metadata", ["absent", "noncallable", "success", "missing", "error"])
+def test_compression_snapshot_keeps_reads_inside_receipt_transaction(db, metadata):
+    from hermes_state_worker_compression import CompressionSnapshot
+
+    _compression_parent(db)
+    db.create_session("child", source="cli", parent_session_id="parent")
+    child = db.get_session("child")
+    db._token_queue.append(("parent", {"input_tokens": 17, "api_call_count": 1}))
+    with db._lock:
