@@ -0,0 +1,174 @@
+"""Creator folder lint is bounded, read-only and compatible with native atlases."""
+import argparse
+import json
+import os
+from pathlib import Path
+
+import pytest
+from PIL import Image, ImageDraw
+
+from hermes_cli.subcommands.pets import build_pets_parser
+
+
+def validate(path):
+    parser = argparse.ArgumentParser()
+    build_pets_parser(parser.add_subparsers())
+    args = parser.parse_args(["pets", "validate", str(path)])
+    return args.func(args)
+
+
+@pytest.fixture
+def pack(tmp_path):
+    root = tmp_path / "creator"
+    root.mkdir()
+    meta = {
+        "schema_version": 1, "format": "hermes-native-atlas", "name": "Lanternling",
+        "author": "Hermes Legion", "licence": "CC0-1.0", "spritesheet": "spritesheet.png",
+    }
+    (root / "manifest.json").write_text(json.dumps(meta))
+    image = Image.new("RGBA", (1536, 1872))
+    draw = ImageDraw.Draw(image)
+    for row in range(9):
+        draw.rectangle((40, row * 208 + 30, 150, row * 208 + 180), fill="teal")
+    image.save(root / "spritesheet.png")
+    return root, meta
+
+
+def test_folder_metadata_and_native_rows_validate_without_writes(pack, capsys):
+    root, _ = pack
+    before = {p.name: p.read_bytes() for p in root.iterdir()}
+    assert validate(root) == 0
+    out = capsys.readouterr()
+    assert "Lanternling" in out.out and "Hermes Legion" in out.out and "CC0-1.0" in out.out
+    assert "1536x1872" in out.out and "running" in out.out
+    assert not out.err
+    assert before == {p.name: p.read_bytes() for p in root.iterdir()}
+
+
+def test_webp_pack_accepts_printable_unicode_metadata_with_utf8_bom(pack, capsys):
+    root, meta = pack
+    meta.update(name="โคมไฟ", author="นักวาด", spritesheet="spritesheet.webp")
+    (root / "manifest.json").write_text(json.dumps(meta, ensure_ascii=False), encoding="utf-8-sig")
+    with Image.open(root / "spritesheet.png") as image:
+        image.save(root / "spritesheet.webp", lossless=True)
+    (root / "spritesheet.png").unlink()
+    assert validate(root) == 0
+    output = capsys.readouterr()
+    assert "โคมไฟ" in output.out and "นักวาด" in output.out and not output.err
+
+
+@pytest.mark.parametrize("field,value", [
+    ("schema_version", 2), ("schema_version", True), ("format", "other"),
+    ("name", ""), ("author", []), ("licence", None), ("author", "x" * 161),
+    ("name", "escape\x1b[31m"), ("licence", "line\nbreak"),
+    ("fps", 15), ("anchor", {"x": 96, "y": 208}), ("animations", {"work": "running"}),
+])
+def test_bad_or_unsupported_metadata_is_rejected(pack, capsys, field, value):
+    root, meta = pack
+    meta[field] = value
+    (root / "manifest.json").write_text(json.dumps(meta))
+    assert validate(root) == 1
+    error = capsys.readouterr().err
+    assert "cannot validate atlas" in error and "\x1b" not in error
+
+
+@pytest.mark.parametrize("value", ["../outside.png", "/tmp/outside.png", "C:\\outside.png", "https://example.invalid/a.png", "sub/spritesheet.png", "animation.gif"])
+def test_declared_asset_cannot_escape_or_select_unsupported_format(pack, capsys, value):
+    root, meta = pack
+    meta["spritesheet"] = value
+    (root / "manifest.json").write_text(json.dumps(meta))
+    assert validate(root) == 1
+    assert "spritesheet.png or spritesheet.webp" in capsys.readouterr().err
+
+
+@pytest.mark.parametrize("target", ["root", "ancestor", "manifest.json", "spritesheet.png"])
+def test_pack_symlinks_are_rejected(pack, tmp_path, capsys, target):
+    root, _ = pack
+    if target in {"root", "ancestor"}:
+        link = tmp_path / "linked"
+        link.symlink_to(root if target == "root" else tmp_path, target_is_directory=True)
+        root = link if target == "root" else link / "creator"
+    else:
+        original = root / target
+        outside = tmp_path / target
+        original.rename(outside)
+        original.symlink_to(outside)
+    assert validate(root) == 1
+    error = capsys.readouterr().err
+    assert ("symlinks" if target in {"root", "ancestor"} else "regular") in error
+
+
+@pytest.mark.parametrize("payload", [b"broken json", b"[]", b" " * (64 * 1024 + 1), b"[" * 1100 + b"]" * 1100, b'{"schema_version":1,"schema_version":2}'])
+def test_invalid_or_oversized_json_fails_cleanly(pack, capsys, payload):
+    root, _ = pack
+    (root / "manifest.json").write_bytes(payload)
+    assert validate(root) == 1
+    assert "cannot validate atlas" in capsys.readouterr().err
+
+
+def test_pack_requires_a_populated_idle_row(pack, capsys):
+    root, _ = pack
+    image = Image.new("RGBA", (1536, 1872))
+    ImageDraw.Draw(image).rectangle((40, 1070, 150, 1220), fill="teal")
+    image.save(root / "spritesheet.png")
+    assert validate(root) == 1
+    assert "populated idle row" in capsys.readouterr().err
+
+
+def test_animated_asset_is_rejected_even_with_png_name(pack, capsys):
+    root, _ = pack
+    with Image.open(root / "spritesheet.png") as image:
+        first = image.copy()
+    second = first.copy()
+    second.putpixel((50, 50), (255, 0, 0, 255))
+    first.save(root / "spritesheet.png", save_all=True, append_images=[second])
+    assert validate(root) == 1
+    assert "static sprite atlas" in capsys.readouterr().err
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("target", ["manifest.json", "spritesheet.png"])
+def test_pack_fifo_is_refused_without_opening_it(pack, capsys, target):
+    root, _ = pack
+    path = root / target
+    path.unlink()
+    os.mkfifo(path)
+    assert validate(root) == 1
+    assert "regular" in capsys.readouterr().err
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("replacement", ["file", "fifo"])
+def test_replacement_during_open_is_refused_without_blocking(pack, monkeypatch, capsys, replacement):
+    from agent.pet import pack as pack_module
+
+    root, _ = pack
+    manifest = root / "manifest.json"
+    real_open = os.open
+    def swap(path, flags, *args, **kwargs):
+        if Path(path) == manifest:
+            manifest.rename(root / "original.json")
+            if replacement == "fifo":
+                os.mkfifo(manifest)
+            else:
+                manifest.write_bytes((root / "original.json").read_bytes())
+        return real_open(path, flags, *args, **kwargs)
+    monkeypatch.setattr(pack_module.os, "open", swap)
+    assert validate(root) == 1
+    assert "changed while opening" in capsys.readouterr().err
+
+
+def test_oversized_asset_is_rejected_before_decode(pack, capsys):
+    root, _ = pack
+    with (root / "spritesheet.png").open("wb") as stream:
+        stream.truncate(16 * 1024 * 1024 + 1)
+    assert validate(root) == 1
+    assert "byte limit" in capsys.readouterr().err
+
+
+def test_standalone_image_symlink_keeps_existing_behavior(pack, tmp_path, capsys):
+    root, _ = pack
+    image = tmp_path / "my-image.png"
+    image.symlink_to(root / "spritesheet.png")
+    assert validate(image) == 0
+    assert "Atlas 1536x1872" in capsys.readouterr().out
