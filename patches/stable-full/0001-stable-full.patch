+"""Compact discovery must not materialize neighbor payloads it never returns."""
+import json
+
+import pytest
+
+from hermes_state import SessionDB
+from tools.registry import registry
+import tools.session_search_tool
+import hermes_state_recall as recall
+
+
+@pytest.mark.parametrize("detail,expected_rows", [("adaptive", 19), ("full", 51)])
+def test_discovery_only_decodes_returned_windows(tmp_path, monkeypatch, detail, expected_rows):
+    with SessionDB(tmp_path / "state.db") as db:
+        anchors = {}
+        for index in range(3):
+            sid = f"archive-{index}"
+            db.create_session(sid, source="cli")
+            for number in range(41):
+                text = f"hydrationneedle code-{index}" if number == 20 else "ordinary context " * 2000
+                mid = db.append_message(sid, role="user", content=text, timestamp=1000 + index * 100 + number)
+                if number == 20:
+                    anchors[sid] = mid
+        decoded = []
+        original = recall._row
+
+        def observe(store, raw, cap):
+            decoded.append(raw["id"])
+            return original(store, raw, cap)
+
+        monkeypatch.setattr(recall, "_row", observe)
+        payload = json.loads(registry.dispatch("session_search", {
+            "query": "hydrationneedle", "limit": 3, "detail": detail}, db=db))
+        assert payload["success"] and len(payload["results"]) == 3
+        assert len(decoded) == expected_rows
+        for rank, hit in enumerate(payload["results"]):
+            assert hit["match_message_id"] == anchors[hit["session_id"]]
+            assert hit["messages_before"] == hit["messages_after"] == 5
+            assert "hydrationneedle" in hit["snippet"]
+            if detail == "adaptive" and rank:
+                assert len(hit["messages"]) == 1
+                assert hit["messages"][0]["id"] == hit["match_message_id"]
+                assert hit["bookend_start"] == hit["bookend_end"] == []
+            else:
+                assert len(hit["messages"]) == 11
+                assert len(hit["bookend_start"]) == len(hit["bookend_end"]) == 3
diff --git a/tests/tools/test_session_search_candidate_starvation.py b/tests/tools/test_session_search_candidate_starvation.py
