+"""Search traffic must not grow retained RAM without bound or lose disk reuse."""
+import sys
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from tools import web_result_cache as cache
+
+
+@pytest.fixture(autouse=True)
+def isolated(monkeypatch):
+    monkeypatch.setattr(cache, "_web_config", dict)
+
+
+def response(text="value"):
+    return {"success": True, "data": {"web": [{"title": text}]}}
+
+
+def test_entry_pressure_releases_cold_memory_but_preserves_disk_hit(monkeypatch):
+    monkeypatch.setattr(cache, "_SEARCH_MAX_ENTRIES", 2, raising=False)
+    memo = cache.SearchMemo()
+    for query in ("hot", "cold"):
+        memo.store("fixture", query, 5, response(query))
+    assert memo.lookup("fixture", "hot", 5) == response("hot")
+    memo.store("fixture", "new", 5, response("new"))
+    assert len(memo._store) == 2
+    assert memo._key("fixture", "cold", 5) not in memo._store
+    assert memo.lookup("fixture", "cold", 5) == response("cold")
+    # A disk hit stays caller-owned and does not re-grow the memory tier.
+    assert len(memo._store) == 2
+
+
+def test_large_results_cannot_accumulate_past_payload_budget(monkeypatch):
+    monkeypatch.setattr(cache, "_SEARCH_MAX_BYTES", 32_000, raising=False)
+    memo = cache.SearchMemo()
+    for i in range(12):
+        memo.store("fixture", str(i), 5, response(str(i) + "x" * 12_000))
+    retained_text = sum(sys.getsizeof(value[1]["data"]["web"][0]["title"])
+                        for value in memo._store.values())
+    assert retained_text <= 32_000
+    assert memo.lookup("fixture", "11", 5)["data"]["web"][0]["title"].startswith("11")
+
+
+def test_oversize_result_keeps_hot_entries_and_remains_readable_on_disk(monkeypatch):
+    monkeypatch.setattr(cache, "_SEARCH_MAX_BYTES", 8_000, raising=False)
+    memo = cache.SearchMemo()
+    memo.store("fixture", "hot", 5, response())
+    memo.store("fixture", "large", 5, response("x" * 20_000))
+    assert memo._key("fixture", "large", 5) not in memo._store
+    assert memo._key("fixture", "hot", 5) in memo._store
+    assert memo.lookup("fixture", "large", 5) == response("x" * 20_000)
+
+
+def test_lookup_releases_other_expired_payloads_without_another_store(monkeypatch):
+    now = [0.0]
+    monkeypatch.setattr(cache.time, "monotonic", lambda: now[0])
+    monkeypatch.setattr(cache, "ttl_seconds", lambda: 10)
+    memo = cache.SearchMemo()
+    memo.store("fixture", "old", 5, response("old"))
+    now[0] = 5
+    memo.store("fixture", "live", 5, response("live"))
+    now[0] = 10
+    assert memo.lookup("fixture", "live", 5) == response("live")
+    assert memo._key("fixture", "old", 5) not in memo._store
+
+
+def test_replacement_and_clear_release_budget(monkeypatch):
+    monkeypatch.setattr(cache, "_SEARCH_MAX_BYTES", 20_000, raising=False)
+    memo = cache.SearchMemo()
+    for _ in range(20):
+        memo.store("fixture", "same", 5, response("x" * 8_000))
+    memo.store("fixture", "second", 5, response("y" * 8_000))
+    assert len(memo._store) == 2
+    memo.clear()
+    memo.store("fixture", "third", 5, response("z" * 8_000))
+    assert memo.lookup("fixture", "third", 5) == response("z" * 8_000)
+
+
+def test_eviction_does_not_replace_reserved_flight_lock(monkeypatch):
+    monkeypatch.setattr(cache, "_SEARCH_MAX_ENTRIES", 1, raising=False)
+    memo = cache.SearchMemo()
+    reserved = memo.flight_lock("fixture", "old", 5)
+    memo.store("fixture", "old", 5, response())
+    memo.store("fixture", "new", 5, response())
+    assert memo.flight_lock("fixture", "old", 5) is reserved
+    assert memo.lookup("fixture", "old", 5) == response()
+
+
+def test_expiry_metadata_does_not_retain_evicted_large_queries(monkeypatch):
+    monkeypatch.setattr(cache, "_SEARCH_MAX_BYTES", 8_000, raising=False)
+    memo = cache.SearchMemo()
+    for i in range(20):
+        memo.store("fixture", str(i) + "q" * 5_000, 5, response())
+    retained_queries = {id(row[2][2]): row[2][2] for row in memo._expiry}
+    assert sum(sys.getsizeof(query) for query in retained_queries.values()) <= 8_000
+
+
+def test_hits_do_not_duplicate_large_query_objects(monkeypatch):
+    monkeypatch.setattr(cache, "_SEARCH_MAX_BYTES", 8_000, raising=False)
+    memo = cache.SearchMemo()
+    memo.store("fixture", "q" * 5_000, 5, response())
+    assert memo.lookup("fixture", "q" * 5_000, 5) == response()
+    keys = [*memo._store, *getattr(memo, "_sizes", {}), *(row[2] for row in memo._expiry)]
+    queries = {id(key[2]): key[2] for key in keys}
+    assert sum(sys.getsizeof(query) for query in queries.values()) <= 8_000
+
+
+def test_registry_reads_evicted_result_without_a_provider_call(monkeypatch):
+    from agent import web_search_registry
+    from tools import web_tools
+    from tools.registry import registry
+
+    monkeypatch.setattr(cache, "_SEARCH_MAX_ENTRIES", 1, raising=False)
+    memo = cache.SearchMemo()
+    monkeypatch.setattr(cache, "search_memo", memo)
+    memo.store("offline-fixture", "cold", 5, response("preserved"))
+    memo.store("offline-fixture", "new", 5, response("new"))
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("An evicted RAM entry with a fresh disk copy must not call a provider")
+
+    provider = SimpleNamespace(name="offline-fixture", supports_search=lambda: True,
+                               search=forbidden)
+    monkeypatch.setattr(web_tools, "_ensure_web_plugins_loaded", lambda: None)
+    monkeypatch.setattr(web_tools, "_get_search_backend", lambda: provider.name)
+    monkeypatch.setattr(web_search_registry, "get_provider", lambda name: provider)
+    monkeypatch.setattr(web_tools, "_managed_search_fallback", forbidden)
+    monkeypatch.setattr(web_tools, "_rescue_search", forbidden)
+    result = json.loads(registry.dispatch("web_search", {"query": "cold", "limit": 5}))
+    assert result == response("preserved")
