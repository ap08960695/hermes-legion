+    def _guarded_fts_rows(self, table: str, match_query: str, order_by_sql: str,
+                          *, limit: int, offset: int, **filters) -> list[dict[str, Any]]:
+        """Filter structured JSON before pagination and supplement escaped Unicode."""
+        if table not in {'messages_fts', 'messages_fts_cjk', 'messages_fts_trigram'}:
+            raise ValueError('unsupported FTS table')
+        columns = {row[1] for row in self._read_all(f'PRAGMA table_info({table})')}
+        if table == 'messages_fts':
+            return self._guarded_base_fts_rows(match_query, order_by_sql, columns,
+                                               limit=limit, offset=offset, **filters)
+        groups: list[tuple[str, list[Any], list[str]]] = []
+        terms: list[str] = []
+        global_specs: list[tuple[str, bool]] = []
+        logical, bound, first = self._compile_like_boolean_query(
+            match_query, stream_structured=True, match_groups=groups, stream_terms=terms,
+            global_specs=global_specs, global_fts_fields=(table, columns))
+        if first is None:
+            return []
+        extra = _structured_fts_query(match_query, table)
+        fold = _escaped_fold_candidates(table, columns, global_specs)
+        if fold:
