+"""Developer tool caches must not rebuild a plugin's dependency generation."""
+from pathlib import Path
+
+import pytest
+
+from pm import workspace
+
+
+@pytest.fixture
+def plugin(tmp_path: Path):
+    root = tmp_path / 'plugin'
+    root.mkdir()
+    (root / 'plugin.yaml').write_text('name: cache-fixture\nversion: 1.0.0\n')
+    (root / 'pyproject.toml').write_text(
+        '[project]\nname="cache-fixture"\nversion="1.0.0"\n'
+        '[build-system]\nrequires=[]\nbuild-backend="backend"\nbackend-path=["build"]\n'
+    )
+    (root / 'build').mkdir()
+    (root / 'build/backend.py').write_text('VALUE = 1\n')
+    return root
+
+
+@pytest.mark.parametrize('cache', ['.pytest_cache/v/cache/nodeids', '.ruff_cache/0.14.0/entry', '.mypy_cache/3.14/data.json'])
+def test_tool_cache_does_not_change_dependency_stamp(plugin, cache):
+    before = workspace.members_stamp([plugin])
+    artifact = plugin / cache
+    artifact.parent.mkdir(parents=True)
+    artifact.write_text('generated tool state\n')
+    assert workspace.members_stamp([plugin]) == before
+
+
+@pytest.mark.parametrize('cache', ['.pytest_cache/v/cache/nodeids', '.ruff_cache/0.14.0/entry', '.mypy_cache/3.14/data.json'])
+def test_tool_cache_is_not_copied_to_build_member(plugin, tmp_path, cache):
+    artifact = plugin / cache
+    artifact.parent.mkdir(parents=True)
+    artifact.write_text('generated tool state\n')
+    root = tmp_path / 'workspace'
+    root.mkdir()
+    member = workspace._workspace_member(plugin, root, identity=plugin)
+    assert not (member / cache).exists()
+    assert (member / 'build/backend.py').read_text() == 'VALUE = 1\n'
+
+
+def test_real_build_inputs_and_hidden_package_data_still_invalidate_stamp(plugin, tmp_path):
+    before = workspace.members_stamp([plugin])
+    (plugin / 'build/backend.py').write_text('VALUE = 2\n')
+    changed = workspace.members_stamp([plugin])
+    assert changed != before
+    data = plugin / '.settings/data.json'
+    data.parent.mkdir()
+    data.write_text('{"shipped": true}\n')
+    assert workspace.members_stamp([plugin]) != changed
+    root = tmp_path / 'workspace'
+    root.mkdir()
+    member = workspace._workspace_member(plugin, root, identity=plugin)
+    assert (member / '.settings/data.json').read_text() == data.read_text()
