 // chip is a concrete profile whose config the page edits.
+// Past this many chips the roster collapses behind a filter + "Show all" toggle
+// (bot fleets can carry 100+ profiles).
+const COLLAPSED_CHIP_LIMIT = 18
+
+/** Chips to render: every filter match when a query is set, else the first
+ *  `limit` (plus the selected profile, so the active chip never hides). */
+export function visibleScopeProfiles<T extends Pick<ProfileInfo, 'bot_title' | 'display_name' | 'name'>>(
+  profiles: T[],
+  { expanded, limit, query, selected }: { expanded: boolean; limit: number; query: string; selected: string }
+): T[] {
+  const needle = query.trim().toLowerCase()
+
+  if (needle) {
+    return profiles.filter(
+      profile =>
+        settingsScopeLabel(profile).toLowerCase().includes(needle) || profile.name.toLowerCase().includes(needle)
+    )
+  }
+
+  if (expanded || profiles.length <= limit) {
+    return profiles
+  }
+
+  return profiles.filter((profile, index) => index < limit || normalizeProfileKey(profile.name) === selected)
+}
