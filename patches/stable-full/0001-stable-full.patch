+    id: `shown-${index + 1}`, title: `Work card ${index + 1}`, status: 'ready'
+  }))
+  const board = { columns: [{ name: 'ready', tasks }], tenants: [], assignees: [], now: 1, latest_event_id: 1 }
+
+  try {
