@@ -0,0 +1,264 @@
+import assert from 'node:assert/strict'
+
+import { afterEach, test, vi } from 'vitest'
+
+import type { HermesApiRequest } from '../../shared/src/api-request'
+
+import { createConfigAutosaveQueue as createQueue } from './config-autosave'
+
+const createConfigAutosaveQueue = (dispatch: (request: HermesApiRequest) => Promise<unknown>) =>
+  createQueue(dispatch, request => ({
+    key: JSON.stringify([request.connectionId ?? '__legacy__', request.profile ?? '__primary__']),
+    send: dispatch
+  }))
+
+afterEach(() => vi.useRealTimers())
+
+const write = (config: Record<string, unknown>, profile = 'alpha'): HermesApiRequest => ({
+  connectionId: 'local', profile, path: '/api/config', method: 'PUT',
+  body: { config }, configAutosave: true
+})
+
+test('native admission keeps the latest sparse edits after the renderer leaves', async () => {
+  vi.useFakeTimers()
+  const disk = { memory: { limit: 2200 }, toolsets: ['terminal'], other: 'untouched' }
+  const requests: HermesApiRequest[] = []
+
+  const queue = createConfigAutosaveQueue(async request => {
+    requests.push(request)
+    Object.assign(disk, (request.body as { config: object }).config)
+
+    return { ok: true }
+  })
+
+  const first = queue.run(write({ memory: { limit: 2300 } }))
+  const last = queue.run(write({ memory: { limit: 2400 }, toolsets: [] }))
+  assert.equal(requests.length, 0)
+  await vi.advanceTimersByTimeAsync(550)
+  await Promise.all([first, last])
+  assert.deepEqual(disk, { memory: { limit: 2400 }, toolsets: [], other: 'untouched' })
+  assert.equal(requests.length, 1)
+  assert.equal(queue.hasPending(), false)
+})
+
+test('a config read flushes and joins older writes on its original owner', async () => {
+  vi.useFakeTimers()
+  const order: string[] = []
+  let release!: () => void
+  const wait = new Promise<void>(resolve => { release = resolve })
+
+  const queue = createConfigAutosaveQueue(async request => {
+    order.push(`${request.profile}:${request.method ?? 'GET'}`)
+
+    if (request.method === 'PUT') { await wait }
+
+    return { ok: true }
+  })
+
+  const save = queue.run(write({ memory: { limit: 2400 } }))
+  const read = queue.run({ connectionId: 'local', profile: 'alpha', path: '/api/config' })
+  await vi.advanceTimersByTimeAsync(0)
+  assert.deepEqual(order, ['alpha:PUT'])
+  release()
+  await Promise.all([save, read])
+  assert.deepEqual(order, ['alpha:PUT', 'alpha:GET'])
+})
+
+test('all owners drain their admitted writes before shutdown', async () => {
+  vi.useFakeTimers()
+  const requests: HermesApiRequest[] = []
+
+  const queue = createConfigAutosaveQueue(async request => { requests.push(request);
+
+ return { ok: true } })
+
+  const alpha = queue.run(write({ enabled: true }))
+  const beta = queue.run(write({ enabled: false }, 'beta'))
+  await queue.flush()
+  await Promise.all([alpha, beta])
+  assert.deepEqual(requests.map(request => request.profile).sort(), ['alpha', 'beta'])
+  assert.equal(queue.hasPending(), false)
+})
+
+test('an in-flight write cannot overtake a rapid revert', async () => {
+  vi.useFakeTimers()
+  let release!: () => void
+  const wait = new Promise<void>(resolve => { release = resolve })
+  let persisted = false
+  let calls = 0
+
+  const queue = createConfigAutosaveQueue(async request => {
+    calls += 1
+
+    if (calls === 1) { await wait }
+    persisted = (request.body as { config: { enabled: boolean } }).config.enabled
+
+    return { ok: true }
+  })
+
+  const on = queue.run(write({ enabled: true }))
+  await vi.advanceTimersByTimeAsync(550)
+  const off = queue.run(write({ enabled: false }))
+  const drained = queue.flush()
+  await Promise.resolve()
+  assert.equal(calls, 1)
+  release()
+  await Promise.all([on, off, drained])
+  assert.equal(persisted, false)
+  assert.equal(calls, 2)
+})
+
+test('failed saves reject without poisoning subsequent owner writes', async () => {
+  vi.useFakeTimers()
+
+  const queue = createConfigAutosaveQueue(vi.fn()
+    .mockRejectedValueOnce(new Error('offline'))
+    .mockResolvedValue({ ok: true }))
+
+  const failure = assert.rejects(queue.run(write({ enabled: true })), /offline/)
+  await vi.advanceTimersByTimeAsync(550)
+  await failure
+  const recovery = queue.run(write({ enabled: false }))
+  await queue.flush()
+  assert.deepEqual(await recovery, { ok: true })
+})
+
+test('a legacy unpinned write remains visible to the quit drain while it is in flight', async () => {
+  let release!: () => void
+  const wait = new Promise<void>(resolve => { release = resolve })
+
+  const queue = createConfigAutosaveQueue(async () => { await wait;
+
+ return { ok: true } })
+
+  const save = queue.run({ ...write({ enabled: true }), connectionId: undefined })
+
+  try {
+    assert.equal(queue.hasPending(), true)
+  } finally {
+    release()
+    await save
+  }
+})
+
+test('an accepted edit that failed cannot be reported as successfully drained', async () => {
+  vi.useFakeTimers()
+  const queue = createConfigAutosaveQueue(async () => { throw new Error('offline') })
+  const failure = assert.rejects(queue.run(write({ enabled: true })), /offline/)
+  await vi.advanceTimersByTimeAsync(550)
+  await failure
+  await assert.rejects(queue.flush(), /offline/)
+})
+
+test('an explicit backend refusal is a failed save, not a successful receipt', async () => {
+  vi.useFakeTimers()
+  const queue = createConfigAutosaveQueue(async () => ({ ok: false }))
+  const failure = assert.rejects(queue.run(write({ enabled: true })))
+  await vi.advanceTimersByTimeAsync(550)
+  await failure
+})
+
+test('profile mutation closes admission before draining existing edits', async () => {
+  vi.useFakeTimers()
+  const order: string[] = []
+
+  const queue = createConfigAutosaveQueue(async () => { order.push('save');
+
+ return { ok: true } })
+
+  const save = queue.run(write({ enabled: true }))
+  const mutation = queue.withMutation(async () => { order.push('delete') })
+  await assert.rejects(queue.run(write({ enabled: false })), /profile update/)
+  await Promise.all([save, mutation])
+  assert.deepEqual(order, ['save', 'delete'])
+})
+
+test('different config endpoint options remain separate ordered writes', async () => {
+  vi.useFakeTimers()
+  const paths: string[] = []
+
+  const queue = createConfigAutosaveQueue(async request => { paths.push(request.path);
+
+ return { ok: true } })
+
+  const first = queue.run({ ...write({ language: 'en' }), path: '/api/config?preserve_language=true' })
+  const second = queue.run(write({ enabled: true }))
+  await queue.flush()
+  await Promise.all([first, second])
+  assert.deepEqual(paths, ['/api/config?preserve_language=true', '/api/config'])
+})
+
+test('a later read cannot hide an earlier rejected edit from the quit drain', async () => {
+  vi.useFakeTimers()
+  let online = false
+  const methods: string[] = []
+
+  const queue = createConfigAutosaveQueue(async request => {
+    methods.push(request.method ?? 'GET')
+
+    if (!online) { throw new Error('offline') }
+
+    return { ok: true }
+  })
+
+  const failure = assert.rejects(queue.run(write({ enabled: true })), /offline/)
+  await vi.advanceTimersByTimeAsync(550)
+  await failure
+  await assert.rejects(queue.run({ ...write({}), method: 'GET' }), /offline/)
+  assert.equal(methods.includes('GET'), false)
+  assert.equal(queue.hasPending(), true)
+  online = true
+  await queue.flush()
+  assert.equal(queue.hasPending(), false)
+})
+
+test('an incompatible edit survives repeated failure of its predecessor after the renderer leaves', async () => {
+  vi.useFakeTimers()
+  let online = false
+  const persisted: unknown[] = []
+
+  const queue = createConfigAutosaveQueue(async request => {
+    if (!online) { throw new Error('offline') }
+    persisted.push(request.body)
+
+    return { ok: true }
+  })
+
+  const first = assert.rejects(queue.run(write({ language: 'en' })), /offline/)
+  await vi.advanceTimersByTimeAsync(550)
+  await first
+
+  const next = assert.rejects(queue.run({
+    ...write({ enabled: true }), path: '/api/config?preserve_language=true'
+  }), /offline/)
+
+  await vi.advanceTimersByTimeAsync(550)
+  await next
+  online = true
+  await queue.flush()
+  assert.deepEqual(persisted, [{ config: { language: 'en' } }, { config: { enabled: true } }])
+})
+
+test('different aliases cannot overtake an in-flight write to their shared backend', async () => {
+  vi.useFakeTimers()
+  let release!: () => void
+  const wait = new Promise<void>(resolve => { release = resolve })
+  const persisted: unknown[] = []
+
+  const queue = createConfigAutosaveQueue(async request => {
+    if (persisted.length === 0) { persisted.push('started'); await wait }
+    persisted.push(request.body)
+
+    return { ok: true }
+  })
+
+  const first = queue.run({ ...write({ enabled: true }), connectionId: undefined })
+  await vi.advanceTimersByTimeAsync(550)
+  const revert = queue.run({ ...write({ enabled: false }), connectionId: 'registry-alias' })
+  const drained = queue.flush()
+  await vi.advanceTimersByTimeAsync(0)
+  assert.deepEqual(persisted, ['started'])
+  release()
+  await Promise.all([first, revert, drained])
+  assert.deepEqual(persisted, ['started', { config: { enabled: true } }, { config: { enabled: false } }])
+})
diff --git a/apps/desktop/electron/config-autosave.ts b/apps/desktop/electron/config-autosave.ts
