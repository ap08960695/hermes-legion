+it('keeps overlap findings and Check focus during a failed recheck without authorizing confirmation', async () => {
+  const { PlannedActionReview } = await import('./planned-action-review')
+  const task = { ...legacyDetail.task, workspace_kind: 'dir', workspace_path: '/fixture/repo' } as const
+  const plan = {
+    actor: 'Developer',
+    steps: [{ id: 'configure', instructions: 'Update configuration.', acceptance: [], write_scope: ['src/config'] }]
+  }
+  const onOpen = vi.fn()
