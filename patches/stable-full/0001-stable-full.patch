+        span = cur.top_object()
+        if span is not None:
+            spans.append(span)
+    elif root == 34:
+        spans.append(cur.string())
+    else:
+        cur.value()
+    cur.ws()
+    if cur.peek() is not None:
+        raise InvalidJSON("trailing JSON")
