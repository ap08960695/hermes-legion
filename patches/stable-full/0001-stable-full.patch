+"""A demoted tail result remains recoverable after the native archive transaction."""
+
+import json
+from unittest.mock import patch
+
+import pytest
+
+from agent.context_compressor import ContextCompressor
+from hermes_state import SessionDB
+from tools.session_search_tool import session_search
+
+
+@pytest.mark.parametrize("covered", [False, True])
+@pytest.mark.parametrize("include_row_ids", [False, True])
+def test_demoted_tail_original_stays_searchable_without_reviving_verbatim_tail(tmp_path, covered, include_row_ids):
+    db = SessionDB(tmp_path / "state.db")
+    sid = "session"
+    db.create_session(sid, source="cli")
+    db.append_message(sid, role="user", content="earlier question")
+    original_tool_ids = []
+    for index in range(8):
+        db.append_message(sid, role="assistant", content=f"action {index}")
+        text = ("recoveryneedle " if index == 0 else "ordinary ") + "x" * 2000
+        original_tool_ids.append(db.append_message(sid, role="tool", tool_name="terminal",
+                                                   tool_call_id=f"call_{index}", content=text))
+    held = db.get_messages_as_conversation(sid, include_row_ids=include_row_ids)
+    compressor = object.__new__(ContextCompressor)
+    compressor._session_id = sid
+    compressor._session_db = db
+    compressor.quiet_mode = True
+    tail = compressor._demote_stale_tail_tools(held[1:], 0)
+    assert "output demoted at compaction" in tail[1]["content"]
+    watermark = db.get_active_message_watermark(sid)
+    covered_ids = [row[0] for row in db._conn.execute(
+        "SELECT id FROM messages WHERE session_id=? AND active=1 ORDER BY id", (sid,))] if covered else None
+    db.archive_and_compact(sid, [{"role": "user", "content": "summary"}, *tail],
+                           watermark=watermark, tail_count=len(tail), covered_ids=covered_ids)
+    assert all("_compaction_tool_recovery" not in m for m in tail)
+
+    flags = {row[0]: (row[1], row[2]) for row in db._conn.execute(
+        "SELECT id,active,compacted FROM messages WHERE id IN (?,?)",
+        (original_tool_ids[0], original_tool_ids[-1]))}
+    result = json.loads(session_search(db=db, query="recoveryneedle", session_id=sid,
+                                       current_session_id=sid))
+    assert flags[original_tool_ids[0]] == (0, 1)
+    assert flags[original_tool_ids[-1]] == (0, 0)
+    assert [row["match_message_id"] for row in result["results"]] == [original_tool_ids[0]]
+    db.close()
+
+
+def test_ambiguous_idless_tool_original_refuses_atomic_archive(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    sid = "session"
+    db.create_session(sid, source="cli")
+    db.append_message(sid, role="user", content="old question")
+    for i in range(8):
+        db.append_message(sid, role="assistant", content=f"action {i}")
+        db.append_message(sid, role="tool", tool_name="terminal",
+                          tool_call_id="duplicate" if i < 2 else f"call_{i}",
+                          content=f"different{i} " + "x" * 2000)
+    held = db.get_messages_as_conversation(sid)
+    compressor = object.__new__(ContextCompressor)
+    compressor._session_db, compressor._session_id, compressor.quiet_mode = db, sid, True
+    tail = compressor._demote_stale_tail_tools(held[1:], 0)
+    before = db._conn.execute("SELECT id,active,compacted,content FROM messages WHERE session_id=? ORDER BY id", (sid,)).fetchall()
+    with pytest.raises(ValueError, match="ambiguous"):
+        db.archive_and_compact(sid, [{"role": "user", "content": "summary"}, *tail],
+                               watermark=db.get_active_message_watermark(sid), tail_count=len(tail))
+    after = db._conn.execute("SELECT id,active,compacted,content FROM messages WHERE session_id=? ORDER BY id", (sid,)).fetchall()
+    assert [tuple(r) for r in after] == [tuple(r) for r in before]
+    db.close()
+
+
+@pytest.mark.parametrize("has_db,has_identity", [(False, True), (True, False)])
+def test_lean_tail_does_not_promise_recovery_without_durable_identity(tmp_path, has_db, has_identity):
+    db = SessionDB(tmp_path / "state.db") if has_db else None
+    compressor = object.__new__(ContextCompressor)
+    compressor._session_db, compressor._session_id, compressor.quiet_mode = db, "session", True
+    original = {"role": "tool", "content": "important " + "x" * 2000}
+    if has_identity:
+        original["tool_call_id"] = "first"
+    messages = [original]
+    for i in range(6):
+        messages.extend([{"role": "assistant", "content": str(i)},
+                         {"role": "tool", "tool_call_id": str(i), "content": "ok"}])
+    assert compressor._demote_stale_tail_tools(messages, 0)[0]["content"] == original["content"]
+    if db:
+        db.close()
+
+
+@pytest.mark.parametrize("covered", [False, True])
+def test_demoted_tool_does_not_revive_a_rewind_or_capture_a_concurrent_append(tmp_path, covered):
+    db = SessionDB(tmp_path / "state.db")
+    sid = "session"
+    db.create_session(sid, source="cli")
+    undone = db.append_message(sid, role="user", content="undo this turn")
+    undone_tool = db.append_message(sid, role="tool", tool_name="terminal", tool_call_id="call_0",
+                                    content="undo-never-find " + "x" * 2000)
+    db.rewind_to_message(sid, undone)
+    db.append_message(sid, role="user", content="new question")
+    original = None
+    for i in range(8):
+        db.append_message(sid, role="assistant", content=f"action {i}")
+        rid = db.append_message(sid, role="tool", tool_name="terminal", tool_call_id=f"call_{i}",
+                                content=("retained-needle " if not i else f"other{i} ") + "x" * 2000)
+        if not i:
+            original = rid
+    held = db.get_messages_as_conversation(sid, include_row_ids=True)
+    watermark = db.get_active_message_watermark(sid)
+    covered_ids = [m["_row_id"] for m in held] if covered else None
+    compressor = object.__new__(ContextCompressor)
+    compressor._session_db, compressor._session_id, compressor.quiet_mode = db, sid, True
+    tail = compressor._demote_stale_tail_tools(held[1:], 0)
+    concurrent = db.append_message(sid, role="user", content="concurrent-append")
+    db.archive_and_compact(sid, [{"role": "user", "content": "summary"}, *tail],
+                           watermark=watermark, tail_count=len(tail), covered_ids=covered_ids)
+    assert tuple(db._conn.execute("SELECT active,compacted FROM messages WHERE id=?", (undone_tool,)).fetchone()) == (0, 0)
+    assert tuple(db._conn.execute("SELECT active,compacted FROM messages WHERE id=?", (original,)).fetchone()) == (0, 1)
+    assert tuple(db._conn.execute("SELECT active,compacted FROM messages WHERE id=?", (concurrent,)).fetchone()) == (0, 0)
+    assert [m["content"] for m in db.get_messages_as_conversation(sid)].count("concurrent-append") == 1
+    hidden = json.loads(session_search(db=db, query="undo-never-find", session_id=sid, current_session_id=sid))
+    assert not hidden["results"]
+    db.close()
+
+
+def test_missing_or_rewound_stub_source_refuses_without_reviving_it(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
