+"""Actual profile RPC dispatch must not leak launch-profile usage or mutate auth."""
+
+from datetime import datetime, UTC
+import json
+
+from hermes_cli import account_usage_report as report
+from tui_gateway import server
+
+
+def test_usage_rpc_reads_exact_profile_without_provider_or_auth_mutation(
+    tmp_path, monkeypatch
+):
+    launch, worker = tmp_path / "launch", tmp_path / "worker"
+    for home, label in [(launch, "launch-only"), (worker, "worker-only")]:
+        home.mkdir()
+        (home / "auth.json").write_text('{"version":1,"credential_pool":{}}')
+        target = home / "state/account-usage/external.json"
+        target.parent.mkdir(parents=True)
+        target.write_text(
+            json.dumps(
+                {
+                    "accounts": [
+                        dict(
+                            provider="agy",
+                            id=label,
+                            label=label,
+                            fetched_at=datetime.now(UTC).isoformat(),
+                            windows=[dict(label="Daily", used_percent=20)],
+                        )
+                    ]
+                }
+            )
+        )
+    before = {home: (home / "auth.json").read_bytes() for home in [launch, worker]}
+    monkeypatch.setenv("HERMES_HOME", str(launch))
+    monkeypatch.setattr(server, "_hermes_home", launch)
+    monkeypatch.setattr(
+        server, "_profile_home", lambda name: worker if name == "code" else None
+    )
+    monkeypatch.setattr(
+        report,
+        "fetch_account_usage",
+        lambda *_a, **_kw: (_ for _ in ()).throw(AssertionError("provider called")),
+    )
+    result = server._methods["account.usage"](
+        "usage-test", {"profile": "code", "refresh": False}
+    )
+    assert result.get("error") is None, result
+    assert [r["label"] for r in result["result"]["accounts"]] == ["worker-only"]
+    assert all(
+        (home / "auth.json").read_bytes() == data for home, data in before.items()
+    )
