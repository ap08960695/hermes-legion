+
+function OwnerPromptRow({ prompt, bot, drafts, isRespondingNow, onOpen, onOpenCard, onRespond, openFailed, openingChat, openingStatus, pending, stale, text }: {
+  prompt: OwnerInboxItem
+  bot: string
+  drafts: Map<string, OwnerReplyDraft>
+  text: Pick<BotsText, 'ownerInbox' | 'workspace'>
+  onOpen: (action: HTMLButtonElement) => void
+  onOpenCard?: () => void
+  isRespondingNow: () => boolean
+  onRespond: (value: string) => Promise<void>
+  openFailed: boolean
+  openingChat: boolean
+  openingStatus: string
+  pending: boolean
+  stale: boolean
+}) {
+  const t = text.ownerInbox
+  const questionId = useId()
+  const key = ownerPromptKey(prompt)
+
+  const [{ answer, selected }, setDraft] = useState<OwnerReplyDraft>(() => drafts.get(key) ?? {
+    answer: '', selected: []
+  })
+
+  const selectedChoices = selected.filter(choice => prompt.choices.includes(choice))
+  const [error, setError] = useState(false)
+  const responseAttempt = useRef(0)
+  const createdAt = prompt.created_at * 1000
+  const openAction = <>
+    <Button aria-disabled={openingChat || stale} className="aria-disabled:cursor-default aria-disabled:opacity-50"
+      onClick={event => onOpen(event.currentTarget)} size="sm" type="button" variant="ghost">{text.workspace.open}</Button>
+    <span className={openingStatus ? "self-center text-sm text-muted-foreground" : "sr-only"} role="status">
+      {openingStatus}
+    </span>
+    {prompt.card && <CopyButton buttonSize="sm" label={t.copyCardId} text={prompt.card} />}
+    {onOpenCard && (
+      <Button aria-disabled={openingChat || stale || undefined} className="aria-disabled:opacity-50"
+        onClick={onOpenCard} size="sm" type="button" variant="secondary">{t.openCard}</Button>
+    )}
+  </>
+
+  function updateDraft(next: OwnerReplyDraft) {
+    if (next.answer || next.selected.length) {
+      drafts.set(key, next)
+    } else {
+      drafts.delete(key)
+    }
+
+    setDraft(next)
+  }
+
+  async function send(value: string) {
+    if (pending || stale || isRespondingNow()) { return }
+    const attempt = ++responseAttempt.current
+    setError(false)
+
+    try {
+      await onRespond(value)
+    } catch {
+      if (attempt === responseAttempt.current) setError(true)
+    }
+  }
+
+  return <li className="min-w-0 space-y-3 rounded-lg border border-(--ui-stroke-tertiary) px-4 py-3" data-owner-prompt-key={key}>
+    <div className="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
+      <div className="min-w-0 break-words text-sm font-semibold">{bot}
+        {bot !== prompt.profile && <span className="ml-2 font-normal text-muted-foreground">{prompt.profile}</span>}
+      </div>
+      <time className="text-xs text-muted-foreground" dateTime={new Date(createdAt).toISOString()}>{relativeTime(createdAt)}</time>
+    </div>
+    {(prompt.card || prompt.goal || prompt.title) && <div className="whitespace-pre-wrap break-words text-xs text-muted-foreground">
+      {[prompt.card && t.card(prompt.card), prompt.card && prompt.card_board && t.cardBoard(prompt.card_board),
+        prompt.goal && t.goal(prompt.goal),
+        !prompt.card && !prompt.goal && prompt.title].filter(Boolean).join(' · ')}
+    </div>}
+    {prompt.kind === 'clarify' ? <form className="grid gap-2" onSubmit={event => {
+      event.preventDefault()
+      const value = answer.trim()
+      const values = value ? [value] : selectedChoices
+
+      if (values.length) { void send(prompt.multi_select ? JSON.stringify(values) : values[0]) }
+    }}>
+      <fieldset className="grid min-w-0 gap-2 wrap-anywhere">
+        <legend className="mb-2 whitespace-pre-wrap text-sm font-medium" id={questionId}>{prompt.question}</legend>
+        {prompt.choices.map((choice, index) => <label className="flex items-start gap-2 text-sm" key={index}>
+          <input aria-disabled={pending || undefined} checked={selected.includes(choice)} className="mt-1" name={questionId}
+            onChange={event => {
+              if (pending) { return }
+              const next = prompt.multi_select
+                ? event.currentTarget.checked ? [...selected, choice] : selected.filter(item => item !== choice)
+                : [choice]
+
+              updateDraft({ answer: '', selected: next })
+            }} type={prompt.multi_select ? 'checkbox' : 'radio'} />
+          <span className="min-w-0">{choice}</span>
+        </label>)}
+        <label className="grid gap-1 text-xs text-muted-foreground">
+          {prompt.choices.length ? t.otherAnswer : t.answer}
+          <input aria-describedby={questionId} className="min-h-9 rounded border border-(--ui-stroke-tertiary) bg-background px-2 text-sm text-foreground"
+            maxLength={16384} onChange={event => updateDraft({ answer: event.currentTarget.value, selected: [] })} readOnly={pending} value={answer} />
+        </label>
+      </fieldset>
+      <div className="flex flex-wrap gap-2">
+        <Button
+          aria-disabled={pending || stale || undefined}
+          className="aria-disabled:opacity-60"
+          disabled={!answer.trim() && !selectedChoices.length}
+          size="sm"
+          type="submit"
+          variant="secondary"
+        >{t.submit}</Button>
+        {openAction}
+      </div>
+    </form> : <>
+      {prompt.description && <p className="whitespace-pre-wrap break-words text-sm">{prompt.description}</p>}
+      <pre className="whitespace-pre-wrap break-words rounded bg-(--ui-bg-quinary) p-2 text-xs">{prompt.command}</pre>
+      <div className="flex flex-wrap gap-2">
+        {!prompt.chat_only && prompt.choices.includes('once') && <Button aria-disabled={pending || stale || undefined} className="aria-disabled:opacity-60" onClick={() => void send('once')} size="sm" variant="secondary">{t.approve}</Button>}
+        {!prompt.chat_only && prompt.choices.includes('deny') && <Button aria-disabled={pending || stale || undefined} className="aria-disabled:opacity-60" onClick={() => void send('deny')} size="sm" variant="ghost">{t.deny}</Button>}
+        {openAction}
+      </div>
+    </>}
+    {pending && <p className="text-sm text-muted-foreground" role="status">{t.sending}</p>}
+    {openFailed && <p className="text-sm text-destructive" ref={revealFocusedError} role="alert">{t.openFailed}</p>}
+    {error && (prompt.kind === 'clarify' || !stale) &&
+      <p className="text-sm text-destructive" ref={revealFocusedError} role="alert">{t.failed}</p>}
+  </li>
+}
