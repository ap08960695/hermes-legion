new file mode 100644
index 0000000000000000000000000000000000000000..493dc80090a2be01dd02b723d93fd1ebddf46719
--- /dev/null
+++ b/tests/test_scratch_active_retention.py
@@ -0,0 +1,227 @@
+"""Automatic scratch retention preserves live and resumable work without signalling it."""
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+import psutil
+import pytest
+
+import hermes_constants_scratch as scratch
+
+
+def _age_tree(entry):
+    old = time.time() - 48 * 3600
+    for base, dirs, files in os.walk(entry):
+        for name in dirs + files:
+            os.utime(Path(base) / name, (old, old), follow_symlinks=False)
+    os.utime(entry, (old, old))
+
+
+def _observe_only(monkeypatch, *pids):
+    # Real kernel-backed processes in a controlled view; unrelated host visibility
+    # is tested separately, rather than making CI depend on the operator's apps.
+    monkeypatch.setattr(psutil, "process_iter", lambda *args, **kwargs:
+                        iter(psutil.Process(pid) for pid in (os.getpid(), *pids)))
+
+
+def _finish(proc):
+    if proc.poll() is None:
+        try:
+            proc.stdin.write("\n")
+            proc.stdin.flush()
+        except BrokenPipeError:
+            pass
+        proc.wait(timeout=10)
+    proc.stdin.close()
+    proc.stdout.close()
+
+
+@pytest.mark.platforms("posix")
+def test_idle_mtime_does_not_authorize_killing_a_live_process(tmp_path, monkeypatch):
+    root = tmp_path / "scratch"
+    entry = root / "working"
+    entry.mkdir(parents=True)
+    (entry / "result.bin").write_bytes(b"resume this work")
+    _age_tree(entry)
+    proc = subprocess.Popen([sys.executable, "-c",
+                             'import sys; print("ready",flush=True); sys.stdin.readline()'],
+                            cwd=entry, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
+    try:
+        assert proc.stdout.readline().strip() == "ready"
+        _observe_only(monkeypatch, proc.pid)
+        assert scratch.prune_idle_entries(root, 24, frozenset()) == 0
+        assert proc.poll() is None
+        assert (entry / "result.bin").read_bytes() == b"resume this work"
+    finally:
+        _finish(proc)
+
+
+@pytest.mark.platforms("posix")
+def test_open_file_is_preserved_even_when_process_cwd_is_elsewhere(tmp_path, monkeypatch):
+    root = tmp_path / "scratch"
+    entry = root / "working"
+    entry.mkdir(parents=True)
+    result = entry / "result.bin"
+    result.write_bytes(b"held by a running task")
+    _age_tree(entry)
+    env = {**os.environ, "STORAGE_TEST_INPUT": str(result)}
+    proc = subprocess.Popen([sys.executable, "-c",
+        'import os,sys; f=open(os.environ["STORAGE_TEST_INPUT"],"rb"); '
+        'print("ready",flush=True); sys.stdin.readline(); f.close()'],
+        cwd=tmp_path, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
+    try:
+        assert proc.stdout.readline().strip() == "ready"
+        _observe_only(monkeypatch, proc.pid)
+        assert scratch.prune_idle_entries(root, 24, frozenset()) == 0
+        assert proc.poll() is None and result.exists()
+    finally:
+        _finish(proc)
+
+
+@pytest.mark.platforms("posix")
+def test_pruner_own_working_directory_is_not_deleted(tmp_path, monkeypatch):
+    root = tmp_path / "scratch"
+    entry = root / "working"
+    entry.mkdir(parents=True)
+    _age_tree(entry)
+    monkeypatch.chdir(entry)
+    _observe_only(monkeypatch)
+    assert scratch.prune_idle_entries(root, 24, frozenset()) == 0
+    assert entry.exists()
+
+
+def test_unknown_process_visibility_retains_old_artifacts(tmp_path, monkeypatch):
+    root = tmp_path / "scratch"
+    root.mkdir()
+    entry = root / "old.bin"
+    entry.write_bytes(b"ownership unknown")
+    old = time.time() - 48 * 3600
+    os.utime(entry, (old, old))
+
+    def unavailable(*args, **kwargs):
+        raise psutil.AccessDenied()
+
+    monkeypatch.setattr(psutil, "process_iter", unavailable)
+    assert scratch.prune_idle_entries(root, 24, frozenset()) == 0
+    assert entry.read_bytes() == b"ownership unknown"
+
+
+def test_git_workspace_and_explicit_keep_marker_survive_idle_age(tmp_path, monkeypatch):
+    root = tmp_path / "scratch"
+    repo = root / "paused" / "repository"
+    repo.mkdir(parents=True)
+    subprocess.run(["git", "init", "-q", str(repo)], check=True)
+    (repo / "notes.txt").write_text("uncommitted work")
+    kept = root / "paused-artifacts"
+    kept.mkdir()
+    (kept / ".keep").write_text("")
+    (kept / "result.bin").write_bytes(b"needed later")
+    _age_tree(root)
+    _observe_only(monkeypatch)
+    assert scratch.prune_idle_entries(root, 24, frozenset()) == 0
+    assert (repo / "notes.txt").read_text() == "uncommitted work"
+    assert (kept / "result.bin").read_bytes() == b"needed later"
+
+
+def test_unused_disposable_artifact_still_expires(tmp_path, monkeypatch):
+    root = tmp_path / "scratch"
+    entry = root / "unused"
+    entry.mkdir(parents=True)
+    (entry / "output.bin").write_bytes(b"disposable")
+    _age_tree(entry)
+    _observe_only(monkeypatch)
+    assert scratch.prune_idle_entries(root, 24, frozenset()) == 1
+    assert not entry.exists()
+
+
+def test_missing_process_inspector_defers_deletion(tmp_path, monkeypatch):
+    import builtins
+
+    root = tmp_path / "scratch"
+    root.mkdir()
+    entry = root / "old.bin"
+    entry.write_bytes(b"keep when ownership cannot be inspected")
+    old = time.time() - 48 * 3600
+    os.utime(entry, (old, old))
+    original_import = builtins.__import__
+
+    def unavailable(name, *args, **kwargs):
+        if name == "psutil":
+            raise ImportError("process inspection unavailable")
+        return original_import(name, *args, **kwargs)
+
+    monkeypatch.setattr(builtins, "__import__", unavailable)
+    assert scratch.prune_idle_entries(root, 24, frozenset()) == 0
+    assert entry.exists()
+
+
+def test_incomplete_workspace_scan_retains_entry_until_it_is_observable(tmp_path, monkeypatch):
+    root = tmp_path / "scratch"
+    entry = root / "old"
+    entry.mkdir(parents=True)
+    (entry / "a.bin").write_bytes(b"a")
+    (entry / "b.bin").write_bytes(b"b")
+    _age_tree(entry)
+    _observe_only(monkeypatch)
+    monkeypatch.setattr(scratch, "_RESUME_SCAN_MAX_ENTRIES", 1)
+    assert scratch.prune_idle_entries(root, 24, frozenset()) == 0
+    assert (entry / "a.bin").read_bytes() == b"a"
+    monkeypatch.setattr(scratch, "_RESUME_SCAN_MAX_ENTRIES", 64)
+    assert scratch.prune_idle_entries(root, 24, frozenset()) == 1
+    assert not entry.exists()
+
+
+def test_fresh_entry_does_not_walk_its_contents(tmp_path, monkeypatch):
+    root = tmp_path / "scratch"
+    entry = root / "fresh"
+    entry.mkdir(parents=True)
+    (entry / "data.bin").write_bytes(b"recent work")
+    real_scandir = os.scandir
+
+    def observed(path):
+        if Path(path) == entry:
+            raise AssertionError("recent scratch entries must skip the recursive scan")
+        return real_scandir(path)
+
+    monkeypatch.setattr(scratch.os, "scandir", observed)
+    assert scratch.prune_idle_entries(root, 24, frozenset()) == 0
+    assert (entry / "data.bin").exists()
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("kind", ["canonical", "symlink", "relative"])
+@pytest.mark.parametrize("option", [False, True])
+def test_command_path_can_be_resumed_through_aliases(tmp_path, monkeypatch, kind, option):
+    root = tmp_path / "scratch"
+    entry = root / "working"
+    entry.mkdir(parents=True)
+    source = entry / "input.bin"
+    source.write_text("resumable input")
+    _age_tree(entry)
+    if kind == "symlink":
+        alias = tmp_path / "alias"
+        alias.symlink_to(root, target_is_directory=True)
+        argument = str(alias / "working" / "input.bin")
+    elif kind == "relative":
+        argument = str(source.relative_to(tmp_path))
+    else:
+        argument = str(source)
+    if option:
+        argument = "--pending=" + argument
+    code = ('import sys; print("ready",flush=True); sys.stdin.readline(); '
+            'print(open(sys.argv[1].split("=",1)[-1]).read(),flush=True)')
+    proc = subprocess.Popen([sys.executable, "-c", code, argument], cwd=tmp_path,
+                            stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
+    try:
+        assert proc.stdout.readline().strip() == "ready"
+        _observe_only(monkeypatch, proc.pid)
+        assert scratch.prune_idle_entries(root, 24, frozenset()) == 0
+        assert source.exists() and proc.poll() is None
+        proc.stdin.write("\n")
+        proc.stdin.flush()
+        assert proc.stdout.readline().strip() == "resumable input"
+        assert proc.wait(timeout=10) == 0
+    finally:
+        _finish(proc)
