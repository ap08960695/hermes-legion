@@ -0,0 +1,240 @@
+"""Compiled plugin code can be shared; module state, scopes and reloads cannot."""
+
+from concurrent.futures import ThreadPoolExecutor
+import gc
+import importlib.machinery
+import os
+from pathlib import Path
+import py_compile
+import shutil
+import sys
+import weakref
+
+import pytest
+
+from hermes_cli.plugins import PluginManager
+
+
+@pytest.fixture
+def plugin_homes(tmp_path, monkeypatch):
+    root = tmp_path / 'bundled'
+    plugin = root / 'code-reuse'
+    plugin.mkdir(parents=True)
+    (plugin / 'plugin.yaml').write_text('name: code-reuse\nkind: backend\nversion: 1.0.0\n')
+    (plugin / '__init__.py').write_text('from .worker import read, bump\ndef register(ctx):\n    pass\n')
+    (plugin / 'worker.py').write_text(
+        'from hermes_constants import get_hermes_home\n'
+        'OWNER = str(get_hermes_home())\nSTATE = []\nVERSION = "one"\n'
+        'def read():\n    return OWNER, len(STATE), VERSION\n'
+        'def bump():\n    STATE.append(1)\n')
+    monkeypatch.setenv('HERMES_BUNDLED_PLUGINS', str(root))
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path / 'launch'))
+    monkeypatch.setattr(Path, 'home', classmethod(lambda cls: tmp_path / 'os-home'))
+    managers = []
+
+    def load(name):
+        home = tmp_path / name
+        home.mkdir(exist_ok=True)
+        manager = PluginManager(scope_key=str(home))
+        manager.discover_and_load()
+        managers.append(manager)
+        loaded = manager._plugins['code-reuse']
+        assert loaded.enabled and not loaded.error
+        return manager, loaded.module, home
+
+    yield plugin, load
+    for manager in reversed(managers):
+        manager.unload()
+
+
+def test_scoped_modules_reuse_code_but_keep_separate_state(plugin_homes):
+    _, load = plugin_homes
+    _, first, home_a = load('a')
+    _, second, home_b = load('b')
+    first.bump()
+    assert first.read() == (str(home_a), 1, 'one')
+    assert second.read() == (str(home_b), 0, 'one')
+    assert first is not second and first.read.__globals__ is not second.read.__globals__
+    assert first.read.__code__ is second.read.__code__, 'Unchanged source was decoded once per profile'
+
+
+def test_initializer_code_is_reused_with_fresh_module_globals(plugin_homes):
+    plugin, load = plugin_homes
+    (plugin / '__init__.py').write_text(
+        'STATE = []\ndef register(ctx):\n    pass\n'
+        'def read():\n    return len(STATE)\ndef bump():\n    STATE.append(1)\n')
+    _, first, _ = load('a')
+    _, second, _ = load('b')
+    first.bump()
+    assert first.read() == 1 and second.read() == 0
+    assert first.read.__code__ is second.read.__code__
+
+
+def test_nested_relative_packages_reuse_code_without_sharing_globals(plugin_homes):
+    plugin, load = plugin_homes
+    nested = plugin / 'nested'
+    nested.mkdir()
+    (nested / '__init__.py').write_text('')
+    (plugin / 'worker.py').replace(nested / 'worker.py')
+    (plugin / '__init__.py').write_text('from .nested.worker import read, bump\ndef register(ctx):\n    pass\n')
+    _, first, _ = load('a')
+    _, second, _ = load('b')
+    first.bump()
+    assert first.read()[1] == 1 and second.read()[1] == 0
+    assert first.read.__code__ is second.read.__code__
+
+
+def test_force_reload_reexecutes_state_while_reusing_unchanged_code(plugin_homes):
+    _, load = plugin_homes
+    manager, first, home = load('a')
+    _, sibling, _ = load('b')
+    first.bump()
+    manager.discover_and_load(force=True)
+    current = manager._plugins['code-reuse'].module
+    assert current is not first and current.read() == (str(home), 0, 'one')
+    assert sibling.read()[1] == 0
+    assert current.read.__code__ is first.read.__code__ is sibling.read.__code__
+
+
+def test_same_size_edit_with_restored_mtime_preserves_running_sibling(plugin_homes):
+    plugin, load = plugin_homes
+    manager_a, first, _ = load('a')
+    manager_b, second, _ = load('b')
+    path = plugin / 'worker.py'
+    previous = path.stat()
+    path.write_text(path.read_text().replace('VERSION = "one"', 'VERSION = "two"'))
+    os.utime(path, ns=(previous.st_atime_ns, previous.st_mtime_ns))
+    manager_a.discover_and_load(force=True)
+    current = manager_a._plugins['code-reuse'].module
+    assert current.read()[2] == 'two'
+    assert first.read()[2] == second.read()[2] == 'one'
+    assert current.read.__code__ is not second.read.__code__
+    manager_b.discover_and_load(force=True)
+    assert manager_b._plugins['code-reuse'].module.read.__code__ is current.read.__code__
+
+
+@pytest.mark.parametrize('custom_finder_type', [False, True])
+def test_custom_source_importers_keep_their_behavior(plugin_homes, monkeypatch, custom_finder_type):
+    plugin, load = plugin_homes
+
+    class CustomLoader(importlib.machinery.SourceFileLoader):
+        def get_code(self, fullname):
+            return compile('def read():\n    return "custom"\ndef bump():\n    pass\n', self.path, 'exec')
+
+    class CustomFinder(importlib.machinery.FileFinder):
+        pass
+
+    finder_type = CustomFinder if custom_finder_type else importlib.machinery.FileFinder
+    finder = finder_type(str(plugin), (CustomLoader, importlib.machinery.SOURCE_SUFFIXES))
+    monkeypatch.setitem(sys.path_importer_cache, str(plugin), finder)
+    _, module, _ = load('a')
+    assert module.read() == 'custom'
+
+
+def test_large_sources_are_not_pinned_in_the_shared_cache(plugin_homes):
+    plugin, load = plugin_homes
+    path = plugin / 'worker.py'
+    path.write_text('#' + 'padding' * 300_000 + '\n' + path.read_text())
+    _, first, _ = load('a')
+    _, second, _ = load('b')
+    assert first.read()[2] == second.read()[2] == 'one'
+    assert first.read.__code__ is not second.read.__code__
+
+
+def test_failed_module_is_removed_and_later_load_reexecutes(plugin_homes):
+    plugin, load = plugin_homes
+    _, first, _ = load('a')
+    path = plugin / 'worker.py'
+    body = path.read_text()
+    path.write_text('raise RuntimeError("synthetic failed module")\n' + body)
+    manager = PluginManager(scope_key=str(plugin.parent / 'failed-home'))
+    manager.discover_and_load()
+    loaded = manager._plugins['code-reuse']
+    assert not loaded.enabled and loaded.error
+    prefix = manager._directory_module_name(loaded.manifest)
+    assert not any(name == prefix or name.startswith(prefix + '.') for name in sys.modules)
+    path.write_text(body)
+    _, recovered, _ = load('recovered')
+    assert recovered.read()[2] == first.read()[2] == 'one'
+
+
+def test_parallel_profile_loads_keep_owners_and_share_code(plugin_homes):
+    _, load = plugin_homes
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        loaded = list(pool.map(load, [f'parallel-{i}' for i in range(8)]))
+    code = loaded[0][1].read.__code__
+    for _, module, home in loaded:
+        assert module.read() == (str(home), 0, 'one')
+        assert module.read.__code__ is code
+    loaded[0][1].bump()
+    assert all(module.read()[1] == 0 for _, module, _ in loaded[1:])
+
+
+def test_cached_code_cannot_bypass_a_current_source_read_failure(plugin_homes, monkeypatch):
+    plugin, load = plugin_homes
+    _, existing, _ = load('a')
+    original = importlib.machinery.SourceFileLoader.get_data
+
+    def denied(loader, path):
+        if Path(path) == plugin / 'worker.py':
+            raise PermissionError('Synthetic source read refusal')
+        return original(loader, path)
+
+    monkeypatch.setattr(importlib.machinery.SourceFileLoader, 'get_data', denied)
+    manager = PluginManager(scope_key=str(plugin.parent / 'denied-home'))
+    manager.discover_and_load()
+    loaded = manager._plugins['code-reuse']
+    assert not loaded.enabled and loaded.error
+    assert existing.read()[2] == 'one'
+
+
+def test_sourceless_siblings_keep_native_import_behavior(plugin_homes):
+    plugin, load = plugin_homes
+    path = plugin / 'worker.py'
+    py_compile.compile(str(path), cfile=str(plugin / 'worker.pyc'), doraise=True)
+    path.unlink()
+    _, first, home_a = load('a')
+    _, second, home_b = load('b')
+    assert first.read() == (str(home_a), 0, 'one')
+    assert second.read() == (str(home_b), 0, 'one')
+
+
+def test_old_compiled_objects_are_released_at_the_reported_cache_bound(tmp_path):
+    from hermes_cli.plugin_code_cache import cache_counts, prepare_plugin_imports
+
+    prepare_plugin_imports(tmp_path)
+    finder = sys.path_importer_cache[str(tmp_path)]
+    path = tmp_path / 'first.py'
+    path.write_text('value = 1\n')
+    code = finder.find_spec('first').loader.get_code('first')
+    reference = weakref.ref(code)
+    del code
+    limit = cache_counts()['max_entries']
+    assert isinstance(limit, int) and limit > 0
+    for index in range(limit):
+        name = f'item_{index}'
+        (tmp_path / (name + '.py')).write_text(f'value = {index}\n')
+        finder.invalidate_caches()
+        finder.find_spec(name).loader.get_code(name)
+    gc.collect()
+    assert cache_counts()['entries'] <= limit
+    assert reference() is None
+
+
+def test_private_profile_plugins_keep_native_imports_outside_the_shared_cache(plugin_homes, tmp_path):
+    from hermes_cli.plugin_code_cache import cache_counts
+
+    plugin, load = plugin_homes
+    before = cache_counts()
+    for name in ['a', 'b']:
+        home = tmp_path / name
+        (home / 'plugins').mkdir(parents=True)
+        shutil.copytree(plugin, home / 'plugins/code-reuse')
+        (home / 'config.yaml').write_text('plugins:\n  enabled:\n    - code-reuse\n')
+    _, first, home_a = load('a')
+    _, second, home_b = load('b')
+    first.bump()
+    assert first.read() == (str(home_a), 1, 'one')
+    assert second.read() == (str(home_b), 0, 'one')
+    assert first.read.__code__ is not second.read.__code__
+    assert cache_counts() == before
