+"""Creator preview visits every canonical activity once and restores the terminal."""
+from types import SimpleNamespace
+
+import pytest
+
+
+@pytest.fixture
+def preview(monkeypatch):
+    import time
+    from agent.pet import render, store
+    from hermes_cli import pets
+
+    frames = []
+    renderer = SimpleNamespace(
+        available=True, mode="unicode", frame_w=192, scale=0.33,
+        frame_count=lambda state: 2,
+        frame=lambda state, index: frames.append((state, index)) or "sprite",
+    )
+    monkeypatch.setattr(pets, "_pet_config", lambda: {})
+    monkeypatch.setattr(store, "resolve_active_pet", lambda slug: SimpleNamespace(
+        spritesheet="unused-test-sheet.png", display_name="Preview"))
+    monkeypatch.setattr(render, "build_renderer", lambda *args, **kwargs: renderer)
+    monkeypatch.setattr(time, "sleep", lambda delay: None)
+    return pets, renderer, frames
+
+
+@pytest.mark.parametrize("state,cycle,expected", [
+    ("", True, ["idle", "wave", "run", "failed", "review", "jump", "waiting"]),
+    ("waiting", False, ["waiting"]),
+    ("review", True, ["review"]),
+    ("", False, ["idle"]),
+])
+def test_preview_once_plays_one_complete_sequence(preview, capsys, state, cycle, expected):
