+"""Bound history materialization before applying the existing status projections."""
+from contextlib import contextmanager
+
+
+@contextmanager
+def _read_snapshot(conn):
+    # Counts and the recent rows must describe the same WAL snapshot. A savepoint
+    # also works on read-only boards and preserves a caller's outer transaction.
+    conn.execute("SAVEPOINT hermes_show_read")
+    try:
+        yield
+    finally:
+        conn.execute("RELEASE hermes_show_read")
+
+
+def _recent(conn, task_id, table, timestamp, convert, limit):
+    rows = conn.execute(
+        f"SELECT * FROM {table} WHERE task_id = ? "
+        f"ORDER BY {timestamp} DESC, id DESC LIMIT ?", (task_id, limit),
+    ).fetchall()
+    return [convert(row) for row in reversed(rows)]
+
+
+def _history(kb, conn, task_id, full):
+    from tools import kanban_tools as tool
+
+    if full:
+        return {
+            "comments": kb.list_comments(conn, task_id),
+            "events": kb.list_events(conn, task_id)[-50:],
+            "runs": kb.list_runs(conn, task_id),
+        }, None
+    specs = {
+        "comments": ("task_comments", "created_at", kb.Comment.from_row, tool._SHOW_COMPACT_COMMENTS),
+        "events": ("task_events", "created_at", kb.Event.from_row, 50),
+        "runs": ("task_runs", "started_at", kb.Run.from_row, tool._SHOW_COMPACT_RUNS),
+    }
+    with _read_snapshot(conn):
+        totals = {
+            name: conn.execute(f"SELECT count(*) FROM {specs[name][0]} WHERE task_id = ?", (task_id,)).fetchone()[0]
+            for name in ("comments", "runs")
+        }
+        history = {
+            name: _recent(conn, task_id, *spec) for name, spec in specs.items()
+        }
+    return history, totals
