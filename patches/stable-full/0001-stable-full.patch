@@ -0,0 +1,350 @@
+"""Bounded native-tokenizer verification for synthetic structured content."""
+import json
+import random
+import sqlite3
+import time
+import tracemalloc
+
+import pytest
+
+from hermes_state_global_recall import GlobalSearch
+
+
+@pytest.fixture
+def conn():
+    db = sqlite3.connect(':memory:')
+    db.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content TEXT)')
+    yield db
+    db.close()
+
+
+def insert(conn, text):
+    raw = '\x00json:' + json.dumps([{'type': 'text', 'text': text}])
+    conn.execute('DELETE FROM messages')
+    conn.execute('INSERT INTO messages VALUES(1, ?)', (raw,))
+
+
+def native_matches(conn, text, query):
+    conn.execute('CREATE VIRTUAL TABLE IF NOT EXISTS oracle USING fts5(body)')
+    conn.execute('DELETE FROM oracle')
+    conn.execute('INSERT INTO oracle VALUES(?)', (text,))
+    return conn.execute('SELECT 1 FROM oracle WHERE oracle MATCH ?', (query,)).fetchone() is not None
+
+
+@pytest.mark.parametrize(('text', 'term', 'prefix', 'native_query'), [
+    ('runway', 'run', False, 'run'),
+    ('runway', 'runw', True, 'runw*'),
+    ('café', 'cafe', False, 'cafe'),
+    ('exact, phrase', 'exact phrase', False, '"exact phrase"'),
+    ('alpha distant phrase', 'alpha phrase', False, '"alpha phrase"'),
+    ('alpha   phrase', 'alpha phrase', False, '"alpha phrase"'),
+    ('a\u0301bc', 'abc', False, 'abc'),
+    ('α\u0301β', 'αβ', False, '"αβ"'),
+    ('x' * 2_000_000 + ' needle', 'x', False, 'x'),
+    ('x' * 2_000_000 + ' needle', 'x', True, 'x*'),
+    ('a' + '\u0301' * 100_000 + ' b', 'a', False, 'a'),
+    ('exact' + ', ' * 1_000_000 + 'phrase', 'exact phrase', False, '"exact phrase"'),
+])
+def test_verifier_matches_native_unicode61_without_hydrating_text(conn, text, term, prefix, native_query):
+    insert(conn, text)
+    expected = native_matches(conn, text, native_query)
+    search = GlobalSearch(conn, [(term, prefix)])
+    tracemalloc.start()
+    try:
+        actual = bool(search.contains(1, term, prefix))
+        _, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+        search.close()
+    assert actual == expected
+    assert peak < 2_000_000
+
+
+def test_multilingual_substring_and_paging_point_to_original_text(conn):
+    text = 'prefix ' + '前置' * 400 + 'ข้อความภาษาไทย' + '后缀' * 500
+    insert(conn, text)
+    search = GlobalSearch(conn, [('ข้อความภาษาไทย', False)])
+    try:
+        assert search.contains(1, 'ข้อความภาษาไทย', False)
+        result = search.excerpt(1, ['ข้อความภาษาไทย'], 256)
+    finally:
+        search.close()
+    assert result['snippet_field'] == 'text' and 'ข้อความภาษาไทย' in result['snippet']
+    assert result['snippet'] == text[result['snippet_offset']:result['snippet_offset'] + 256]
+
+
+def test_only_substring_queries_skip_per_character_tokenization(conn, monkeypatch):
+    from hermes_state_global_recall import _Unicode61
+    insert(conn, 'x' * 2_000_000 + 'ข้อความภาษาไทย')
+    def forbidden(*args, **kwargs):
+        pytest.fail('substring-only searches should use the streaming substring reader')
+    monkeypatch.setattr(_Unicode61, 'classify', forbidden)
+    search = GlobalSearch(conn, [('ข้อความภาษาไทย', False)])
+    try:
+        assert search.contains(1, 'ข้อความภาษาไทย', False)
+    finally:
+        search.close()
+
+
+def test_binary_content_uses_byte_offsets_and_base64(conn):
+    import base64
+    text = 'ไทย🙂\x00' + 'needle' + '\ud800'
+    insert(conn, text)
+    search = GlobalSearch(conn, [('needle', False)])
+    try:
+        assert search.contains(1, 'needle', False)
+        result = search.excerpt(1, ['needle'], 256)
+    finally:
+        search.close()
+    assert result['offset_unit'] == 'bytes' and result['snippet_encoding'] == 'base64'
+    assert base64.b64decode(result['snippet']).decode('utf-8', 'surrogatepass') == text
+
+
+def test_randomized_verifier_agrees_with_sqlite_fts(conn):
+    rng = random.Random(9182)
+    alphabet = list('abAB09 éèßαβ ไทย中文.,-_/\u0301\ue000')
+    for _ in range(180):
+        text = ''.join(rng.choice(alphabet) for _ in range(rng.randrange(1, 200)))
+        term = rng.choice(['a', 'ab', 'cafe', 'αβ', 'a b', '0'])
+        query = '"' + term + '"'
+        insert(conn, text)
+        expected = native_matches(conn, text, query)
+        search = GlobalSearch(conn, [(term, False)], substring_languages=False)
+        try:
+            assert bool(search.contains(1, term, False)) == expected
+        finally:
+            search.close()
+
+
+def test_deadline_raises_and_releases_oracle(conn):
+    insert(conn, 'needle')
+    search = GlobalSearch(conn, [('needle', False)], deadline=time.monotonic()-1)
