+
+  if (method === 'Enter') {
+    fireEvent.keyDown(input, { key: 'Enter' })
+  } else {
+    act(() => screen.getByRole('button', { name: 'Next field' }).focus())
+  }
+
+  expect(onChange).toHaveBeenCalledExactlyOnceWith(['one', 'two'])
+  expect(input.value).toBe('one, two')
+})
