index 0000000000000000000000000000000000000000..4455992455b9a0f634f3013dc282c1b3ec8475b7
--- /dev/null
+++ b/apps/desktop/electron/config-patch-null.test.ts
@@ -0,0 +1,43 @@
+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import { mergeConfigPatch } from '../../shared/src/config-patch'
+
+import { createConfigAutosaveQueue } from './config-autosave'
+
+test('a later null section does not erase an accepted nested settings edit', async () => {
+  const persisted: unknown[] = []
+
+  const dispatch = async (request: { body?: unknown }) => {
+    persisted.push(request.body)
+
+    return { ok: true }
+  }
+
+  const queue = createConfigAutosaveQueue(dispatch, () => ({ key: 'home', send: dispatch }))
+
+  const patches = [
+    { auxiliary: { vision: { model: 'updated-model' } } },
+    { auxiliary: { vision: null } }
+  ]
+
+  const writes = patches.map(config => queue.run({
+    path: '/api/config', method: 'PUT', body: { config }, configAutosave: true
+  }))
+
+  await queue.flush()
+  await Promise.all(writes)
+  // Native PUT ignores null over a mapping. Coalescing must keep the edit it
+  // would have saved before receiving that null section.
+  assert.deepEqual(persisted, [{ config: patches[0] }])
+  assert.equal(queue.hasPending(), false)
+})
+
+test('null preserves mapping sections but still replaces scalar and list leaves', () => {
+  const previous = { empty: {}, section: { enabled: true }, scalar: 'old', list: ['old'] }
+  const result = mergeConfigPatch(previous, { empty: null, section: null, scalar: null, list: null })
+
+  assert.deepEqual(result, { empty: {}, section: { enabled: true }, scalar: null, list: null })
+  assert.deepEqual(previous, { empty: {}, section: { enabled: true }, scalar: 'old', list: ['old'] })
+})
