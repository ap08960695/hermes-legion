+        ready = kb.create_task(conn, title='waiting', assignee='alice')
+        before = list(conn.execute('SELECT id, status, current_run_id, worker_pid FROM tasks ORDER BY id'))
+        event_count = conn.execute('SELECT COUNT(*) FROM task_events').fetchone()[0]
+        estop.engage('fixture pause')
+        spawns = []
+        result = kbd.dispatch_once(conn, spawn_fn=lambda *args, **kwargs: spawns.append(args))
+        after = list(conn.execute('SELECT id, status, current_run_id, worker_pid FROM tasks ORDER BY id'))
+        assert spawns == []
+        assert after == before
+        assert conn.execute('SELECT COUNT(*) FROM task_events').fetchone()[0] == event_count
+        assert result.skipped_paused is True
+        assert kb.get_task(conn, running).status == 'running'
+        assert kb.get_task(conn, ready).status == 'ready'
