index 0000000000000000000000000000000000000000..8c1f067a12cebcb6cab574706f41cd8b755a0743
--- /dev/null
+++ b/apps/desktop/electron/ssh-transport.ts
@@ -0,0 +1,223 @@
+import type { SshStartupPhase } from './ssh-backend-status'
+
+// Electron main owns all profile/window SSH transports. Backend ownership stays profile scoped.
+type Flight = { controller: AbortController; promise: Promise<void> }
+type Transport = { flight?: Flight; closing?: Promise<void>; failures: number; retryAt: number }
+
+const transports = new Map<string, Transport>()
+const queues = new Map<string, { active: number; pending: any[] }>()
+const EXEC_LIMIT = 1
+const PENDING_LIMIT = 256
+
+export function cancelledSshOperation(): Error & { kind: string } {
+  return Object.assign(new Error('SSH operation was cancelled.'), { kind: 'superseded' })
+}
+
+function state(key: string): Transport {
+  let value = transports.get(key)
+
+  if (!value) {
+    value = { failures: 0, retryAt: 0 }
+    transports.set(key, value)
+  }
+
+  return value
+}
+
+export function recordSshFailure(key: string): void {
+  const value = state(key)
+  value.failures = Math.min(value.failures + 1, 6)
+  value.retryAt = performance.now() + Math.min(1000 * 2 ** (value.failures - 1), 30_000)
+}
+
+export function markSshTransportHealthy(key: string): void {
+  const value = transports.get(key)
+
+  if (value) {
+    value.failures = 0
+    value.retryAt = 0
+  }
+}
+
+export function sshTransportRetryAfterMs(key: string): number {
+  return Math.max(0, Math.ceil((transports.get(key)?.retryAt ?? 0) - performance.now()))
+}
+
+export function openSshTransport(key: string, run: (signal: AbortSignal) => Promise<void>): Promise<void> {
+  const value = state(key)
+
+  if (value.flight && !value.flight.controller.signal.aborted) {
+    return value.flight.promise
+  }
+
+  const retryAfterMs = sshTransportRetryAfterMs(key)
+
+  if (retryAfterMs > 0) {
+    return Promise.reject(
+      Object.assign(new Error('SSH reconnect is cooling down; retry shortly.'), {
+        kind: 'reconnect-backoff',
+        retryAfterMs
+      })
+    )
+  }
+
+  const controller = new AbortController()
+  const predecessor = Promise.allSettled([value.closing, value.flight?.promise])
+  const flight: Flight = { controller, promise: null! }
+  flight.promise = predecessor
+    .then(() => {
+      if (controller.signal.aborted) {
+        throw cancelledSshOperation()
+      }
+
+      return run(controller.signal)
+    })
+    .catch(error => {
+      if (error?.kind !== 'superseded' && error?.kind !== 'host-busy') {
+        recordSshFailure(key)
+      }
+
+      throw error
+    })
+    .finally(() => {
+      if (value.flight === flight) {
+        value.flight = undefined
+      }
+    })
+  value.flight = flight
+
+  return flight.promise
+}
+
+export function closeSshTransport(key: string, run: () => Promise<void>): Promise<void> {
+  const value = state(key)
+  const flight = value.flight
+  flight?.controller.abort()
+
+  // Replacement flights wait behind the existing close, so one exit is enough.
+  if (value.closing) {
+    return value.closing
+  }
+
+  const closing = Promise.allSettled([flight?.promise])
+    .then(run)
+    .finally(() => {
+      if (value.closing === closing) {
+        value.closing = undefined
+      }
+
+      if (!value.flight && !value.closing && !value.failures) {
+        transports.delete(key)
+      }
+    })
+
+  value.closing = closing
+
+  return closing
+}
+
+export function waitForSshTransport(promise: Promise<void>, signal?: AbortSignal): Promise<void> {
+  if (!signal) {
+    return promise
+  }
+
+  if (signal.aborted) {
+    return Promise.reject(cancelledSshOperation())
+  }
+
+  return new Promise((resolve, reject) => {
+    const abort = () => reject(cancelledSshOperation())
+    signal.addEventListener('abort', abort, { once: true })
+    promise.then(resolve, reject).finally(() => signal.removeEventListener('abort', abort))
+  })
+}
+
+export function queueSshExec<T>(
+  host: string,
+  signal: AbortSignal,
+  run: () => Promise<T>,
+  report?: (phase: SshStartupPhase) => void
+): Promise<T> {
+  if (signal.aborted) {
+    return Promise.reject(cancelledSshOperation())
+  }
+
+  let queue = queues.get(host)
+
+  if (!queue) {
+    queue = { active: 0, pending: [] }
+    queues.set(host, queue)
+  }
+
+  if (queue.pending.length >= PENDING_LIMIT) {
+    return Promise.reject(Object.assign(
+      new Error('Too many SSH commands are waiting; let the current work finish.'), { kind: 'queue-full' }
+    ))
+  }
+
+  const own = queue
+
+  return new Promise<T>((resolve, reject) => {
+    const drain = () => {
+      while (own.active < EXEC_LIMIT && own.pending.length) {
+        const next = own.pending.shift()
+        next.signal.removeEventListener('abort', next.abort)
+
+        if (next.signal.aborted) {
+          next.reject(cancelledSshOperation())
+
+          continue
+        }
+
+        own.active++
+        Promise.resolve()
+          .then(next.run)
+          .then(next.resolve, next.reject)
+          .finally(() => {
+            own.active--
+            drain()
+          })
+      }
+
+      if (!own.active && !own.pending.length && queues.get(host) === own) {
+        queues.delete(host)
+      }
+    }
+
+    const queued = own.active >= EXEC_LIMIT || own.pending.length > 0
+
+    const entry = {
+      signal,
+      run: () => {
+        if (queued) {
+          report?.('starting')
+        }
+
+        return run()
+      },
+      resolve,
+      reject,
+      abort: () => {}
+    }
+
+    entry.abort = () => {
+      const index = own.pending.indexOf(entry)
+
+      if (index >= 0) {
+        own.pending.splice(index, 1)
+      }
+
+      reject(cancelledSshOperation())
+      drain()
+    }
+
+    signal.addEventListener('abort', entry.abort, { once: true })
+    own.pending.push(entry)
+
+    if (queued) {
+      report?.('queued')
+    }
+
+    drain()
+  })
+}
