new file mode 100644
index 0000000000000000000000000000000000000000..cfd558ab8cc274b91b75a0ebc07d1374694907be
--- /dev/null
+++ b/apps/desktop/src/app/pet-overlay/pet-character-transitions.ts
@@ -0,0 +1,100 @@
+import type { TargetAndTransition } from 'motion/react'
+
+const arrivals = ['drop', 'drop', 'bounce', 'toss', 'walk', 'walk', 'float', 'pop'] as const
+const departures = ['walk', 'walk', 'leap', 'fall', 'yank', 'wave', 'wave', 'roll'] as const
+export type PetArrival = typeof arrivals[number]
+export type PetDeparture = typeof departures[number]
+
+let lastArrival: PetArrival | undefined
+let lastDeparture: PetDeparture | undefined
+
+function choose<T>(weighted: readonly T[], previous: T | undefined): T {
+  const remaining = weighted.filter(choice => choice !== previous)
+
+  return remaining[Math.floor(Math.random() * remaining.length)]
+}
+
+export function nextPetArrival() {
+  lastArrival = choose(arrivals, lastArrival)
+
+  return lastArrival
+}
+
+export function nextPetDeparture() {
+  lastDeparture = choose(departures, lastDeparture)
+
+  return lastDeparture
+}
+
+interface Travel {
+  side: number
+  top: number
+  bottom: number
+}
+
+export const petAtRest = { x: 0, y: 0, rotate: 0, scale: 1, scaleY: 1, opacity: 1 }
+
+export function petArrival(kind: PetArrival, { side, top, bottom }: Travel): TargetAndTransition {
+  const toward = side < 0 ? 1 : -1
+
+  switch (kind) {
+    case 'drop':
+      return {
+        ...petAtRest, y: [top, 0, -20, 0], scaleY: [1, 0.74, 1.05, 1],
+        transition: { duration: 0.92, times: [0, 0.56, 0.77, 1], ease: ['easeIn', 'easeOut', 'easeIn'] }
+      }
+
+    case 'bounce':
+      return {
+        ...petAtRest, y: [bottom, -44, 0, -16, 0],
+        transition: { duration: 0.85, ease: ['easeOut', 'easeIn', 'easeOut', 'easeIn'] }
+      }
+
+    case 'toss':
+      return {
+        ...petAtRest, x: [side, side * 0.4, 14 * toward, -4 * toward, 0],
+        y: [0, -80, -23, 0, 0], rotate: [-220 * toward, -85 * toward, 16 * toward, 0, 0],
+        transition: { duration: 1.08, times: [0, 0.38, 0.7, 0.86, 1], ease: 'linear' }
+      }
+
+    case 'walk':
+      return {
+        ...petAtRest, x: [side, 0], y: [0, -3, 0, -3, 0, -3, 0, -3, 0],
+        transition: { duration: 1.1, ease: 'linear' }
+      }
+
+    case 'float':
+      return {
+        ...petAtRest, x: [-22, 18, -10, 0], y: [top, top * 0.64, top * 0.28, 0], rotate: [-8, 8, -5, 0],
+        transition: { duration: 1.22, ease: 'linear' }
+      }
+
+    case 'pop':
+      return {
+        ...petAtRest, scale: [0.18, 1.17, 0.93, 1], y: [12, -10, 2, 0], opacity: [0, 1, 1, 1],
+        transition: { duration: 0.68, times: [0, 0.34, 0.68, 1], ease: 'easeOut' }
+      }
+  }
+}
+
+export function petDeparture(kind: PetDeparture, { side, top, bottom }: Travel): TargetAndTransition {
+  switch (kind) {
+    case 'walk':
+      return { x: side, y: [null, -3, 0, -3, 0, -3, 0], opacity: [null, 1, 0], transition: { duration: 1.04, ease: 'linear' } }
+
+    case 'leap':
+      return { y: [null, 5, top], scaleY: [null, 0.78, 1.12], opacity: [null, 1, 0], transition: { duration: 0.86, times: [0, 0.24, 1], ease: 'easeIn' } }
+
+    case 'fall':
+      return { y: [null, -12, bottom], rotate: [null, 9, -30], opacity: [null, 1, 0], transition: { duration: 0.7, times: [0, 0.34, 1], ease: 'easeIn' } }
+
+    case 'yank':
+      return { x: [null, side * -0.02, side], y: [null, 0, -36], rotate: [null, 6, -38], opacity: [null, 1, 0], transition: { duration: 0.78, times: [0, 0.35, 1], ease: 'easeIn' } }
+
+    case 'wave':
+      return { rotate: [null, -12, 12, -9, 0], opacity: [null, 1, 1, 0], transition: { duration: 0.94, ease: 'easeInOut' } }
+
+    case 'roll':
+      return { x: side, rotate: side < 0 ? -400 : 400, scale: [null, 0.85, 0.6], opacity: [null, 1, 0], transition: { duration: 0.96, ease: 'easeIn' } }
+  }
+}
