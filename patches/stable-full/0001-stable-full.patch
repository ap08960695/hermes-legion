@@ -0,0 +1,122 @@
+import { Button, DialogContent, DialogDescription, DialogHeader, DialogTitle, EmptyState, Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@hermes/plugin-sdk'
+
+import { type BotsText, useBots } from './i18n'
+import type { BotDelegationReport, RosterRow } from './types'
+
+export interface ReportSnapshot {
+  name: string
+  profile: string
+  source: string
+  at: number
+  retained: boolean
+  reports: BotDelegationReport[]
+}
+
+interface BotMonitorReportsProps {
+  bot: RosterRow
+  onOpen: (snapshot: ReportSnapshot, trigger: HTMLButtonElement) => void
+  name: string
+  now: number
+}
+
+function reportTime(value: number | null | undefined, missing: string) {
+  const date = new Date(typeof value === 'number' ? value * 1000 : NaN)
+
+  return Number.isFinite(date.getTime()) ? date.toLocaleString() : missing
+}
+
+// Select before matching to keep hidden history out of dashboard search.
+export function botRecordedIssue(bot: RosterRow) {
+  const saved = bot.canonical_session?.delegation_reports
+  const report = Array.isArray(saved) ? saved.slice(0, 20).find(item => item.status === 'error' || item.status === 'stalled') : null
+
+  if (!report) {return null}
+
+  const error = report.error.trim()
+
+  return {
+    report, error,
+    goal: report.goal.replace(/\s+/g, ' ').trim().slice(0, 120),
+    excerpt: (error || report.summary).replace(/\s+/g, ' ').trim().slice(0, 160)
+  }
+}
+
+function ReportList({ reports, b }: { reports: BotDelegationReport[]; b: BotsText }) {
+  const m = b.monitor, r = m.reports
+
+  return reports.length === 0 ? <EmptyState title={r.empty} /> : (
+    <ol className="space-y-6">
+      {reports.map((report, index) => (
+        <li className="space-y-2 break-words" key={`${report.delegation_id}:${report.task_index}:${index}`}>
+          <div className="font-medium">{report.goal || m.missing}</div>
+          <div>{r.statuses[report.status] || r.statuses.unknown}</div>
+          <div className="text-xs text-muted-foreground">{r.finished}: {reportTime(report.completed_at, m.missing)}</div>
+          <div className="text-xs text-muted-foreground">{r.summary}</div>
+          <p className="whitespace-pre-wrap">{report.summary || m.missing}</p>
+          {report.error && <>
+            <div className="text-xs text-muted-foreground">{r.error}</div>
+            <p className="whitespace-pre-wrap">{report.error}</p>
+          </>}
+        </li>
+      ))}
+    </ol>
+  )
+}
+
+export function BotMonitorReportContent({ snapshot, filter, onCloseAutoFocus }: {
+  snapshot: ReportSnapshot
+  filter?: { value: string; onChange: (value: string) => void }
+  onCloseAutoFocus?: (event: Event) => void
+}) {
+  const b = useBots(), m = b.monitor, r = m.reports
+
+  return <DialogContent bodyClassName="wrap-anywhere" className="max-w-2xl" data-monitor-report-dialog=""
+    onCloseAutoFocus={onCloseAutoFocus} scrollBodyLabel={filter ? undefined : r.title}>
+    <DialogHeader>
+      <DialogTitle>{r.title} · {snapshot.name}</DialogTitle>
+      <DialogDescription>{filter ? r.scope : r.snapshot}</DialogDescription>
+    </DialogHeader>
+    <div className="space-y-1 text-xs text-muted-foreground">
+      <p>{snapshot.source}</p>
+      <p>{snapshot.profile}</p>
+      {snapshot.retained && <p>{m.retained}</p>}
+      {filter && <p>{r.snapshot}</p>}
+      <p>{reportTime(snapshot.at / 1000, m.missing)}</p>
+    </div>
+    {filter && <Select onValueChange={filter.onChange} value={filter.value}>
+      <SelectTrigger aria-label={r.filter}><SelectValue /></SelectTrigger>
+      <SelectContent>
+        <SelectItem value="all">{r.all}</SelectItem>
+        {(['completed', 'error', 'stalled', 'interrupted', 'unknown'] as const).map(id => (
+          <SelectItem key={id} value={id}>{r.statuses[id]}</SelectItem>
+        ))}
+      </SelectContent>
+    </Select>}
+    <ReportList b={b} reports={filter && filter.value !== 'all'
+      ? snapshot.reports.filter(report => report.status === filter.value) : snapshot.reports} />
+  </DialogContent>
+}
+
+/** Stored reports never activate a source, navigate a chat or change current-work status. */
+export function BotMonitorReports({ bot, name, now, onOpen }: BotMonitorReportsProps) {
+  const b = useBots(), m = b.monitor, r = m.reports
+  const saved = bot.canonical_session?.delegation_reports
+  const reports = Array.isArray(saved) ? saved.slice(0, 20) : null
+  const issue = botRecordedIssue(bot)
+  const source = bot.connectionLabel || bot.connectionId || m.missing
+
+  return reports ? <div className="space-y-2">
+    {issue && <div className="max-w-64 space-y-1 break-words">
+      <div>{r.lastIssue}: {r.statuses[issue.report.status]}</div>
+      <div className="text-xs text-muted-foreground">{reportTime(issue.report.completed_at, m.missing)}</div>
+      <p className="line-clamp-2">{issue.goal || m.missing}</p>
+      {issue.excerpt && <>
+        <div className="text-xs text-muted-foreground">{issue.error ? r.error : r.summary}</div>
+        <p className="line-clamp-2">{issue.excerpt}</p>
+      </>}
+    </div>}
+    <Button aria-haspopup="dialog" aria-label={`${r.recent} · ${name} · ${source}`} onClick={event => {
+      onOpen({ name, profile: bot.name, source, at: now, retained: Boolean(bot.retained), reports }, event.currentTarget)
+    }} size="sm" variant="ghost">{r.recent} ({reports.length})</Button>
+  </div> : r.unavailable
+}
