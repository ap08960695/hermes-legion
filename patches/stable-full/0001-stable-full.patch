+def _process_tick(slug, first_id, entered, release, queue):
+    kbd._profile_exists_fn = lambda: lambda _name: True
+    kbd._system_memory_sample = dict
+    kbd.review_dispatch_enabled = lambda: False
+    original_claim = kb.claim_task
+
+    def synchronized_claim(conn, tid, **kwargs):
+        if tid == first_id:
+            entered.set()
+            if not release.wait(timeout=10):
+                raise RuntimeError('fixture timeout')
+        return original_claim(conn, tid, **kwargs)
+
+    kb.claim_task = synchronized_claim
+    spawns = []
+    try:
+        with kbc.connect_closing(board=slug) as conn:
+            result = kbd.dispatch_once(conn, board=slug, max_in_progress=1,
+                                       spawn_fn=lambda task, workspace, board=None: spawns.append(task.id))
+        queue.put(('ok', len(spawns), result.skipped_capacity_locked))
+    except Exception as exc:
+        queue.put(('error', type(exc).__name__))
+
