+    "_cached_system_prompt", "_cached_system_prompt_static", "_static_rebuild_failed_for",
+    "_plugin_system_prompt_sections_snapshot", "_plugin_system_prompt_sections_previous",
+    "_compaction_prompt_drift_logged", "_frozen_workspace_snapshot",
+    "_auto_load_skills_result", "_auto_load_skills_resolved", "_bot_chat_timeless_prompt",
