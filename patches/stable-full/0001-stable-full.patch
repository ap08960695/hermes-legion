new file mode 100644
index 0000000000000000000000000000000000000000..f1da0b6a53ce1134f8ecb17ba5591182daaedf53
--- /dev/null
+++ b/tools/browser_tool_stop_proof.py
@@ -0,0 +1,105 @@
+"""Bounded stop proof for an owned daemon and its observed descendants.
+
+Only the verified parent receives signals. Unknown identities and surviving
+descendants leave the caller's root/state intact. No native modules are imported.
+"""
+from pathlib import Path
+import time
+
+
+def confirm_owned_stop(probe, close, *, wait_seconds=2.0, clock=None, sleep=None):
+    clock, sleep = clock or time.monotonic, sleep or time.sleep
+    try:
+        pid = probe.pid()
+        known = dict(probe.snapshot(pid))  # capture identities BEFORE close
+        if pid not in known or not known:
+            return False
+        birth = known[pid]
+        try:
+            close()  # acknowledgement is not evidence of termination
+        except Exception:
+            pass
+        started = clock()
+        deadline = started + min(2.0, max(0.0, float(wait_seconds)))
+        term_sent = kill_sent = False
+        while True:
+            parent = probe.state(pid, birth)
+            if parent not in {'alive', 'stopped'}:
+                return False
+            if parent == 'alive':
+                for child, identity in probe.snapshot(pid):
+                    if child in known and known[child] != identity:
+                        return False
+                    known[child] = identity
+            states = [probe.state(child, identity) for child, identity in known.items()]
+            if any(state not in {'alive', 'stopped'} for state in states):
+                return False
+            if all(state == 'stopped' for state in states):
+                return True
+            now = clock()
+            if now >= deadline:
+                return False
+            if parent == 'alive' and not term_sent:
+                if not probe.signal_parent(pid, birth):
+                    return False
+                term_sent = True
+            elif parent == 'alive' and not kill_sent and now - started >= 0.5:
+                if not probe.signal_parent(pid, birth, force=True):
+                    return False
+                kill_sent = True
+            sleep(min(0.05, deadline - now))
+    except Exception:
+        return False
+
+
+class NativeStopProbe:
+    def __init__(self, config, verify, processes=None):
+        if processes is None:
+            import psutil
+            processes = psutil
+        self.config, self.verify, self.processes = config, verify, processes
+        self.root_pid = None
+
+    def pid(self):
+        value = int((Path(self.config.socket_dir) / (self.config.session_name + '.pid')).read_text().strip())
+        if value <= 0:
+            raise ValueError('Invalid owned pid')
+        self.root_pid = value
+        return value
+
+    def snapshot(self, pid):
+        process = self.processes.Process(pid)
+        birth = process.create_time()
+        if pid != self.root_pid or not self.verify(pid, self.config.socket_dir, self.config.session_name):
+            raise PermissionError('Unverified daemon')
+        children = [(child.pid, child.create_time()) for child in process.children(recursive=True)]
+        if (self.processes.Process(pid).create_time() != birth or
+                not self.verify(pid, self.config.socket_dir, self.config.session_name)):
+            raise PermissionError('Daemon identity changed during capture')
+        return [(pid, birth), *children]
+
+    def state(self, pid, birth):
+        try:
+            process = self.processes.Process(pid)
+            if process.create_time() != birth:
+                return 'changed'
+            return 'stopped' if process.status() in {'zombie', 'dead'} else 'alive'
+        except self.processes.NoSuchProcess:
+            return 'stopped'
+        except Exception:
+            return 'unknown'
+
+    def signal_parent(self, pid, birth, force=False):
+        try:
+            process = self.processes.Process(pid)
+            if (pid != self.root_pid or process.create_time() != birth or
+                    not self.verify(pid, self.config.socket_dir, self.config.session_name)):
+                return False
+            # psutil checks process identity again when signalling. Never signal children.
+            if force:
+                process.kill()
+            else:
+                process.terminate()
+            return True
+        except Exception:
+            return False
