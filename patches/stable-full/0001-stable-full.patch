--- /dev/null
+++ b/hermes_cli/update_cmd_preserve.py
@@ -0,0 +1,135 @@
+"""Required source customization restoration using the updater's existing stash and rollback custody."""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import stat
+
+from hermes_cli import update_preservation as _preservation
+
+
+def capture_customization_metadata(git_cmd, root):
+    """Validate local Python before moving anything and retain non-Git file permissions."""
+    from hermes_cli import update_cmd as update
+    from hermes_cli.update_cmd_stash import _git_paths_z
+
+    python_paths = update._restored_python_paths(git_cmd, root)
+    if python_paths is None:
+        raise SystemExit('Cannot inspect local Python changes; the update was not started.')
+    valid, failing, detail = update._validate_python_files_syntax(root, python_paths)
+    if not valid:
+        print(f'Fix local Python before updating: {failing}\n{detail}')
+        raise SystemExit(1)
+    paths = _git_paths_z(git_cmd, ['ls-files', '--cached', '--others', '--exclude-standard', '-z'], root)
+    if paths is None:
+        raise SystemExit('Cannot inspect source permissions; the update was not started.')
+    metadata = {}
+    for name in sorted(paths):
+        path = Path(name)
+        while path != Path('.'):
+            _capture_path(root, path, metadata)
+            path = path.parent
+    from hermes_cli.update_preservation import prepare
+
+    prepare(root, metadata)
+    return metadata
+
+
+def _capture_path(root, relative, metadata):
+    name = relative.as_posix()
+    if relative.is_absolute() or '..' in relative.parts:
+        raise SystemExit('Invalid source path; the update was not started.')
+    if name in metadata:
+        return
+    try:
+        info = (Path(root) / relative).lstat()
+    except FileNotFoundError:
+        return
+    if not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode)):
+        raise SystemExit(f'Cannot preserve this source file type: {name}')
+    metadata[name] = (stat.S_IFMT(info.st_mode), stat.S_IMODE(info.st_mode), info.st_uid, info.st_gid)
+
+
+def restore_customization_metadata(root, metadata):
+    """Restore existing source metadata without following symlinks into other directories."""
+    root = Path(root)
+    for name in sorted(metadata, key=lambda value: len(Path(value).parts), reverse=True):
+        path = root / name
+        if any(parent.is_symlink() for parent in path.parents if parent != root and root in parent.parents):
+            raise OSError(f'Cannot restore source permissions through a symlink: {name}')
+        try:
+            info = path.lstat()
+        except FileNotFoundError:
+            continue
+        kind, mode, uid, gid = metadata[name]
+        if stat.S_IFMT(info.st_mode) != kind:
+            raise OSError(f'Source file type changed during update: {name}')
+        if stat.S_ISLNK(kind):
+            if (info.st_uid, info.st_gid) != (uid, gid):
+                os.chown(path, uid, gid, follow_symlinks=False)
+            continue
+        _restore_open_metadata(path, info, mode, uid, gid)
+
+
+def _restore_open_metadata(path, before, mode, uid, gid):
+    if (stat.S_IMODE(before.st_mode), before.st_uid, before.st_gid) == (mode, uid, gid):
+        return
+    fd = os.open(path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
+    try:
+        current = os.fstat(fd)
+        if (current.st_dev, current.st_ino) != (before.st_dev, before.st_ino):
+            raise OSError(f'Source path changed while restoring permissions: {path.name}')
+        if (current.st_uid, current.st_gid) != (uid, gid):
+            os.fchown(fd, uid, gid)
+        if os.name == 'posix':
+            os.fchmod(fd, mode)
+        elif stat.S_IMODE(current.st_mode) != mode:
+            os.chmod(path, mode)
+    finally:
+        os.close(fd)
+
+
+def restore_preserving_update(git_cmd, root, stash_ref, previous_sha, *, rollback_branch=None,
+                              checkout_move=None, windows_gateway_resume=None, file_metadata=None):
+    """Build the updated code only after all local changes and their index have been restored.
+
+    A conflict restores the previous checkout with the same native rollback gate used for
+    unbootable upstream code. It never retries the update or restarts a runtime on the unpatched tree.
+    """
+    from hermes_cli import update_cmd as update
+
+    try:
+        _preservation.plan_restore(root, stash_ref)
+        if stash_ref is None:
+            restore_customization_metadata(root, file_metadata or {})
+            _preservation.finish(root)
+            return
+        restored = update._restore_stashed_changes(
+            git_cmd, root, stash_ref, prompt_user=False, checkout_move=checkout_move,
+            restore_index=True, file_metadata=file_metadata)
+    except (SystemExit, OSError) as exc:
+        print(f"Could not integrate local source customizations: {exc}")
+        restored = False
+    if restored:
+        _preservation.finish(root)
+        return
+    try:
+        update._roll_back_broken_update(
+            git_cmd, previous_sha, "local source customizations", "The updated source could not retain all local edits.",
+            rollback_branch=rollback_branch, _windows_gateway_resume=windows_gateway_resume,
+            header="Update stopped: local customizations require integration.",
+            stop_class="customizations_conflict", customizations_pending=True)
+    except SystemExit:
+        # A failed or ambiguous rollback must not apply an old stash onto a different tree.
+        if not previous_sha or update._capture_head_sha(git_cmd, root) != previous_sha:
+            raise
+        if not update._commit.tree_whole_at(git_cmd, root, previous_sha):
+            raise
+        if stash_ref is None:
+            restore_customization_metadata(root, file_metadata or {})
+        elif not update._restore_stashed_changes(
+                git_cmd, root, stash_ref, prompt_user=False, checkout_move=checkout_move,
+                restore_index=True, file_metadata=file_metadata):
+            raise SystemExit(1) from None
+        print("Previous source and local customizations restored. The update was not installed.")
+        raise SystemExit(1) from None
