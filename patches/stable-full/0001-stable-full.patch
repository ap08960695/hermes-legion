+"""Search snippets must not send unbounded tokens into recall results."""
+
+import json
+import shutil
+import sqlite3
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from hermes_state import SessionDB
+from tools.session_search_tool import session_search
+
+
+REPO = Path(__file__).resolve().parent.parent.parent
+
+
+@pytest.fixture(scope="session")
+def cjk_so(tmp_path_factory):
+    source = REPO / "native/fts5_cjk/fts5_cjk.c"
+    if not shutil.which("gcc") or not source.exists():
+        pytest.skip("native CJK compiler or source unavailable")
+    path = tmp_path_factory.mktemp("bounded-snippet") / "libfts5_cjk.so"
+    subprocess.run(["gcc", "-shared", "-fPIC", "-O2", f"-I{source.parent / 'vendor'}",
+                    str(source), "-o", str(path)], check=True, capture_output=True)
+    probe = sqlite3.connect(":memory:")
+    try:
+        probe.enable_load_extension(True)
+        probe.load_extension(str(path))
+    finally:
+        probe.close()
+    return path
+
+
+@pytest.fixture
+def db(cjk_so, tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_FTS5_CJK_SO", str(cjk_so))
+    store = SessionDB(tmp_path / "state.db")
+    assert store._fts_cjk_available
+    store.create_session("s", source="cli")
+    yield store
+    store.close()
+
+
+@pytest.mark.parametrize(("query", "term"), [("完成率", "完成"), ("findme", "findme")])
+def test_search_excerpt_after_large_token_is_bounded_and_relevant(db, query, term):
+    filler = "z" * (8 * 1024 * 1024 + 17)
+    expected = db.append_message("s", role="user", content=filler + " 100%完成率 findme")
+    rows = db.search_messages(query, fields=["id", "snippet"])
+    assert len(rows) == 1 and rows[0]["id"] == expected
+    assert len(rows[0]["snippet"]) <= 1000 and term in rows[0]["snippet"]
+
+
+def test_extremely_long_highlight_remains_bounded_and_closed(db):
+    expected = db.append_message("s", role="user", content="needle" + "z" * (8 * 1024 * 1024 + 17))
+    rows = db.search_messages("needle*", fields=["id", "snippet"])
+    assert len(rows) == 1 and rows[0]["id"] == expected
+    snippet = rows[0]["snippet"]
+    assert len(snippet) <= 1000 and "needle" in snippet
+    assert snippet.count(">>>") == 1 and snippet.count("<<<") == 1
+
+
+def test_search_excerpt_uses_real_highlight_when_message_contains_marker_text(db):
+    filler = "z" * (8 * 1024 * 1024 + 17)
+    expected = db.append_message("s", role="user", content=filler + " >>>fake<<< " + "x" * 2000 + " findme")
+    rows = db.search_messages("findme", fields=["id", "snippet"])
+    assert len(rows) == 1 and rows[0]["id"] == expected
+    assert len(rows[0]["snippet"]) <= 1000 and ">>>findme<<<" in rows[0]["snippet"]
+
+
+def test_small_native_snippet_is_preserved(db):
+    db.append_message("s", role="user", content="ordinary text findme with context")
+    with db._read_ctx() as conn:
+        native = conn.execute("SELECT snippet(messages_fts, -1, '>>>', '<<<', '...', 40) "
+                              "FROM messages_fts WHERE messages_fts MATCH ?", ("findme",)).fetchone()[0]
+    rows = db.search_messages("findme", fields=["id", "snippet"])
+    assert len(rows) == 1 and rows[0]["snippet"] == native
+
+
+def test_multiple_large_results_keep_all_matches_and_bounded_snippets(db):
+    filler = "z" * (8 * 1024 * 1024 + 17)
+    expected = {db.append_message("s", role="user", content=filler + f" findme {i}") for i in range(3)}
+    rows = db.search_messages("findme", limit=3, fields=["id", "snippet"])
+    assert {row["id"] for row in rows} == expected
+    assert all(len(row["snippet"]) <= 1000 and "findme" in row["snippet"] for row in rows)
+
+
+def test_session_search_does_not_return_oversized_snippet(db):
+    db.append_message("s", role="user", content="z" * (8 * 1024 * 1024 + 17) + " findme")
+    raw = session_search(query="findme", limit=1, db=db)
+    result = json.loads(raw)
+    assert result["success"] is True and result["count"] == 1
+    assert len(result["results"][0]["snippet"]) <= 1000
+    assert "findme" in result["results"][0]["snippet"] and len(raw) < 25000
