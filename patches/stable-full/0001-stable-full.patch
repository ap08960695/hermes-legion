@@ -0,0 +1,146 @@
+"""Reuse public bundled locale data without sharing mutable profile catalog state."""
+
+from concurrent.futures import ThreadPoolExecutor
+import os
+from pathlib import Path
+import threading
+
+import pytest
+
+from agent import i18n, i18n_layers
+
+
+@pytest.fixture
+def catalogs(tmp_path, monkeypatch):
+    bundled = tmp_path / 'bundled'
+    bundled.mkdir()
+    (bundled / 'en.yaml').write_text('approval:\n  denied: Bundled A\n  granted: Allowed\n')
+    monkeypatch.setenv('HERMES_BUNDLED_LOCALES', str(bundled))
+    i18n_layers._reset_registry_for_tests()
+    i18n.reset_language_cache()
+    yield bundled
+    i18n_layers._reset_registry_for_tests()
+    i18n.reset_language_cache()
+
+
+def observe_bundled_reads(monkeypatch, bundled):
+    original = i18n_layers.parse_locale_file
+    reads = []
+
+    def observed(path):
+        if Path(path).parent == bundled:
+            reads.append(Path(path))
+        return original(path)
+
+    monkeypatch.setattr(i18n_layers, 'parse_locale_file', observed)
+    return reads
+
+
+def test_same_bundle_is_parsed_once_while_profile_overlays_stay_private(catalogs, tmp_path, monkeypatch):
+    reads = observe_bundled_reads(monkeypatch, catalogs)
+    home_a, home_b = tmp_path / 'a', tmp_path / 'b'
+    (home_a / 'locales').mkdir(parents=True)
+    (home_a / 'locales/en.yaml').write_text('approval:\n  denied: Only A\n')
+    first = i18n._load_catalog('en', str(home_a))
+    second = i18n._load_catalog('en', str(home_b))
+    assert first['approval.denied'] == 'Only A'
+    assert second['approval.denied'] == 'Bundled A'
+    assert first['approval.granted'] == second['approval.granted'] == 'Allowed'
+    first['approval.granted'] = 'A changed its own view'
+    assert second['approval.granted'] == 'Allowed'
+    assert len(reads) == 1, 'One unchanged public bundle was parsed for every profile'
+
+
+def test_callers_cannot_mutate_the_cached_bundle(catalogs):
+    first = i18n._load_bundled('en')
+    first['approval.denied'] = 'Changed'
+    first['added'] = 'Only this dictionary'
+    second = i18n._load_bundled('en')
+    assert second['approval.denied'] == 'Bundled A' and 'added' not in second
+
+
+def test_reset_after_overlay_change_reuses_the_unchanged_bundle(catalogs, tmp_path, monkeypatch):
+    reads = observe_bundled_reads(monkeypatch, catalogs)
+    home = tmp_path / 'profile'
+    (home / 'locales').mkdir(parents=True)
+    assert i18n._load_catalog('en', str(home))['approval.denied'] == 'Bundled A'
+    (home / 'locales/en.yaml').write_text('approval:\n  denied: Owner overlay\n')
+    i18n.reset_language_cache()
+    assert i18n._load_catalog('en', str(home))['approval.denied'] == 'Owner overlay'
+    assert len(reads) == 1
+
+
+def test_same_size_edit_with_restored_mtime_is_seen_after_reset(catalogs, tmp_path):
+    path = catalogs / 'en.yaml'
+    before = path.stat()
+    assert i18n._load_catalog('en', str(tmp_path / 'a'))['approval.denied'] == 'Bundled A'
+    path.write_text(path.read_text().replace('Bundled A', 'Bundled B'))
+    os.utime(path, ns=(before.st_atime_ns, before.st_mtime_ns))
+    i18n.reset_language_cache()
+    assert i18n._load_catalog('en', str(tmp_path / 'a'))['approval.denied'] == 'Bundled B'
+
+
+def test_atomic_bundle_replacement_and_packaged_root_change_are_seen(catalogs, tmp_path, monkeypatch):
+    assert i18n._load_bundled('en')['approval.denied'] == 'Bundled A'
+    replacement = tmp_path / 'replacement.yaml'
+    replacement.write_text('approval:\n  denied: Replaced\n')
+    os.replace(replacement, catalogs / 'en.yaml')
+    assert i18n._load_bundled('en')['approval.denied'] == 'Replaced'
+    alternate = tmp_path / 'alternate'
+    alternate.mkdir()
+    (alternate / 'en.yaml').write_text('approval:\n  denied: Other bundle\n')
+    monkeypatch.setenv('HERMES_BUNDLED_LOCALES', str(alternate))
+    assert i18n._load_bundled('en')['approval.denied'] == 'Other bundle'
+
+
+def test_concurrent_cold_profile_reads_parse_one_bundle(catalogs, tmp_path, monkeypatch):
+    original = i18n_layers.parse_locale_file
+    start = threading.Barrier(8)
+    reads = []
+    lock = threading.Lock()
+
+    def observed(path):
+        with lock:
+            reads.append(Path(path))
+        return original(path)
+
+    def read(index):
+        start.wait(timeout=5)
+        return i18n._load_catalog('en', str(tmp_path / str(index)))['approval.denied']
+
+    monkeypatch.setattr(i18n_layers, 'parse_locale_file', observed)
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        results = list(pool.map(read, range(8)))
+    assert results == ['Bundled A'] * 8
+    assert len(reads) == 1
+
+
+def test_failed_parse_is_not_reused_and_missing_bundle_can_appear(catalogs, monkeypatch):
+    original = i18n_layers.parse_locale_file
+    failures = [True]
+
+    def parse(path):
+        if failures and failures.pop():
+            raise OSError('Synthetic unavailable bundle')
+        return original(path)
+
+    monkeypatch.setattr(i18n_layers, 'parse_locale_file', parse)
+    assert i18n._load_bundled('en') == {}
+    assert i18n._load_bundled('en')['approval.denied'] == 'Bundled A'
+    assert i18n._load_bundled('de') == {}
+    (catalogs / 'de.yaml').write_text('approval:\n  denied: Jetzt vorhanden\n')
+    assert i18n._load_bundled('de')['approval.denied'] == 'Jetzt vorhanden'
+
+
+def test_bundle_reuse_remains_bounded_across_packaged_roots(catalogs, tmp_path, monkeypatch):
+    reads = observe_bundled_reads(monkeypatch, catalogs)
+    assert i18n._load_bundled('en')['approval.denied'] == 'Bundled A'
+    for index in range(64):
+        root = tmp_path / f'packaged-{index}'
+        root.mkdir()
+        (root / 'en.yaml').write_text('approval:\n  denied: Another bundle\n')
+        monkeypatch.setenv('HERMES_BUNDLED_LOCALES', str(root))
+        assert i18n._load_bundled('en')['approval.denied'] == 'Another bundle'
+    monkeypatch.setenv('HERMES_BUNDLED_LOCALES', str(catalogs))
+    assert i18n._load_bundled('en')['approval.denied'] == 'Bundled A'
+    assert len(reads) == 2, 'An old bundle remained pinned after many distinct source roots'
diff --git a/tests/agent/test_kanban_terminal_budget.py b/tests/agent/test_kanban_terminal_budget.py
