+  worker_session?: WorkerSession | null
+  /** Bounded observations; absence keeps singular support for older gateways. */
+  worker_sessions?: WorkerSession[] | null
+}
+
+export interface WorkerSession {
+  estimated_cost_usd?: null | number
+  actual_cost_usd?: null | number
+  model?: null | string
+  id?: string
+  source?: string
+  current_tool?: null | string
+  ended_at?: number | null
+  input_tokens?: null | number
+  iteration?: null | number
+  last_active?: number
+  last_activity_description?: string
+  max_iterations?: null | number
+  output_tokens?: null | number
+  started_at?: null | number
+  title?: string
 }
