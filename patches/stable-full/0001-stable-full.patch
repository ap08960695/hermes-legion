+"""Cross-process cache publication and hostile ANSI work amplification."""
+import multiprocessing
+import random
+from pathlib import Path
+
+import pytest
+from tools import ansi_strip, web_result_cache as cache
+
+
+def _cache_writer(directory,prefix,barrier):
+    cache._cache_dir=lambda:Path(directory)
+    cache._web_config=dict
+    for n in range(10):
+        barrier.wait(15)
+        url=f'https://example.com/{prefix}/{n}'
+        cache.extract_cache_put(url,url,provider='fixture')
+
+
+@pytest.mark.platforms('linux')
+def test_parallel_processes_preserve_both_cache_inserts(tmp_path,monkeypatch):
+    ctx=multiprocessing.get_context('spawn');barrier=ctx.Barrier(2)
+    workers=[ctx.Process(target=_cache_writer,args=(str(tmp_path),i,barrier)) for i in range(2)]
+    for p in workers:p.start()
+    try:
+        for p in workers:p.join(30);assert p.exitcode==0
+    finally:
+        for p in workers:
+            if p.is_alive():p.terminate();p.join(5)
+    monkeypatch.setattr(cache,'_cache_dir',lambda:tmp_path)
+    monkeypatch.setattr(cache,'_web_config',dict)
+    assert len(cache._load_index())==20
+    for i in range(2):
+        for n in range(10):
+            u=f'https://example.com/{i}/{n}'
+            assert cache.extract_cache_get(u,provider='fixture')['content']==u
+
+
+def test_ansi_differential_control_strings():
+    rng=random.Random(981)
+    pieces=['\x1b]','\x1bP','\x1bX','\x1b^','\x1b_','\x1b\\','\x07','\x9d','\x9c','abc','ไทย','\n','\x1b[31m','\x1b[0m']
+    for _ in range(1000):
+        text=''.join(rng.choice(pieces) for _ in range(30))
+        assert ansi_strip.strip_ansi(text)==ansi_strip._ANSI_ESCAPE_RE.sub('',text)
+
+
+def test_unterminated_strings_are_removed_before_general_regex(monkeypatch):
+    original=ansi_strip._ANSI_ESCAPE_RE
+    class Guard:
+        def sub(self,replacement,text):
+            assert '\x1b]' not in text
+            return original.sub(replacement,text)
+    monkeypatch.setattr(ansi_strip,'_ANSI_ESCAPE_RE',Guard())
+    assert ansi_strip.strip_ansi('\x1b]x'*1000)=='x'*1000
