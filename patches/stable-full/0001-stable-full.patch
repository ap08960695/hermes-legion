+  expect(screen.queryByText('Unconfirmed current task')).toBeNull()
+  expect((within(screen.getByText('Canonical recovery parent').closest('tr')!).getByRole('button', { name: 'Open chat · Writer' }) as HTMLButtonElement).disabled).toBe(true)
+  release(active)
+  expect(await screen.findByText('Unconfirmed current task')).toBeTruthy()
+  expect(screen.queryByRole('status')).toBeNull()
+  const recovered = within(screen.getByText('Canonical recovery parent').closest('tr')!)
+  expect((recovered.getByRole('button', { name: 'Open chat · Writer' }) as HTMLButtonElement).disabled).toBe(false)
+  expect(JSON.stringify(active)).toBe(original)
+  expect(host.request).not.toHaveBeenCalled()
+  expect(host.ensureAgent).not.toHaveBeenCalled()
+  expect(host.openSession).not.toHaveBeenCalled()
