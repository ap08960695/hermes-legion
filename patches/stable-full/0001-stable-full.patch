+"""Credential cache mutations compose with the upstream reentrant document lock."""
+from agent import model_metadata as metadata
+from agent.model_metadata_cache import locked_context_cache
+
+
+def test_scoped_save_and_invalidation_share_an_existing_document_lock():
+    base = "https://cache-reentrant.example.invalid/v1"
+    metadata.save_context_length("obsolete", base, 65536, api_key="synthetic-a")
+
+    @locked_context_cache
+    def transaction():
+        metadata.save_context_length("current", base, 131072, api_key="synthetic-b")
+        metadata._invalidate_cached_context_length("obsolete", base, api_key="synthetic-a")
+
+    transaction()
+    assert metadata.get_cached_context_length("current", base, api_key="synthetic-b") == 131072
+    assert metadata.get_cached_context_length("obsolete", base, api_key="synthetic-a") is None
+    assert metadata.get_cached_context_length("current", base, api_key="synthetic-a") is None
