@@ -0,0 +1,63 @@
+import { cleanup, renderHook } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+import { $perSessionBrowse, browseBackward, browseForward, isBrowsingHistory } from '@/store/composer-input-history'
+
+import { useComposerPlaceholder } from './use-composer-placeholder'
+
+const copy = vi.hoisted(() => ({
+  composer: {
+    newSessionPlaceholders: ['Start'],
+    followUpPlaceholders: ['Continue']
+  }
+}))
+
+vi.mock('@/i18n', () => ({ useI18n: () => ({ t: copy }) }))
+
+const props = {
+  sessionId: 'runtime-a' as string | null,
+  historyScope: 'same-owner-and-durable-chat'
+}
+
+beforeEach(() => $perSessionBrowse.set({}))
+afterEach(cleanup)
+
+it('preserves browsing through a transient detach and reattach of the same owner and conversation', () => {
+  const view = renderHook(value => useComposerPlaceholder(value), { initialProps: props })
+  browseBackward('runtime-a', 'Keep my original draft', ['Third', 'Second', 'First'])
+  browseBackward('runtime-a', '', ['Third', 'Second', 'First'])
+  view.rerender({ ...props, sessionId: null })
+  expect(isBrowsingHistory('runtime-a')).toBe(true)
+  view.rerender(props)
+  expect(browseForward('runtime-a', ['Only retained question'])).toEqual({
+    text: 'Only retained question',
+    returnedToPresent: false
+  })
+  expect(browseForward('runtime-a', ['Only retained question'])).toEqual({
+    text: 'Keep my original draft',
+    returnedToPresent: true
+  })
+})
+
+it('moves an active cursor to a replacement runtime only for the same durable owner scope', () => {
+  const view = renderHook(value => useComposerPlaceholder(value), { initialProps: props })
+  browseBackward('runtime-a', 'Keep my original draft', ['Earlier question'])
+  view.rerender({ ...props, sessionId: null })
+  view.rerender({ ...props, sessionId: 'runtime-b' })
+  expect(isBrowsingHistory('runtime-a')).toBe(false)
+  expect(browseForward('runtime-b', ['Earlier question'])).toEqual({
+    text: 'Keep my original draft',
+    returnedToPresent: true
+  })
+})
+
+it.each(['another-owner-same-chat', 'same-owner-another-chat'])(
+  'retires old browse state when the actual editor identity changes (%s)',
+  historyScope => {
+    const view = renderHook(value => useComposerPlaceholder(value), { initialProps: props })
+    browseBackward('runtime-a', 'Old private draft', ['Earlier question'])
+    view.rerender({ ...props, historyScope })
+    expect(isBrowsingHistory('runtime-a')).toBe(false)
+    expect(browseForward('runtime-a', ['Other chat question'])).toBeNull()
+  }
+)
