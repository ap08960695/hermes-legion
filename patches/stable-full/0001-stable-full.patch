+import { Button, Codicon, useValue } from '@hermes/plugin-sdk'
+
+import { useBots } from './i18n'
+import { $botManagementOpen, requestBotManagement } from './management'
+
+export function BotWorkspaceActions({ onNavigate }: { onNavigate: () => void }) {
+  const b = useBots(),
+    management = useValue($botManagementOpen)
+
+  return (
+    <div className="flex flex-wrap items-center gap-2">
+      <Button aria-pressed={management} onClick={() => { onNavigate(); $botManagementOpen.set(!management) }} size="sm" variant="ghost">
+        <Codicon name="organization" />
+        {management ? b.workspace.cards : b.workspace.manage}
+      </Button>
+      <Button onClick={() => { onNavigate(); requestBotManagement('group') }} size="sm" variant="outline">
+        <Codicon name="organization" />
+        {b.group.newTitle}
+      </Button>
+      <Button onClick={() => { onNavigate(); requestBotManagement('bot') }} size="sm">
+        <Codicon name="add" />
+        {b.bot.newTitle}
+      </Button>
+    </div>
+  )
+}
diff --git a/apps/desktop/src/plugins/hermes-bots/workspace.test.tsx b/apps/desktop/src/plugins/hermes-bots/workspace.test.tsx
