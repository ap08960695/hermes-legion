+import { hermesApiAs, type ResolvedOwner } from '@/api/client'
+import type { LibraryFile } from '@/app/artifacts/open-artifact'
+export interface Space {
+  id: string
+  title: string
+  members: string[]
+  revision: number
+}
+export interface SpaceItem {
+  id: string
+  space_id: string
+  title: string
+  kind: 'page' | 'file'
+  mime: string
+  revision: number
+  deleted: number
+  byte_size: number
+  collection_title?: string
+  preview_state?: string
+  text?: string
+  preview?: LibraryFile
+}
+export const request = <T>(owner: ResolvedOwner, path: string, method = 'GET', body?: unknown) =>
+  hermesApiAs<T>(owner, { path: '/api/spaces' + path, method, body })
