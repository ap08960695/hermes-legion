+        <DialogTitle onBlur={() => { focusRefreshAfterReconnect.current = false }} ref={heading} tabIndex={-1}>
+          {t.title}
+        </DialogTitle>
+        <DialogDescription>{t.scope}</DialogDescription>
+      </DialogHeader>
