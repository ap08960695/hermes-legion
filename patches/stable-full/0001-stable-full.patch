+"""Repeated built-in attachments should not multiply I/O or context."""
+import asyncio
+
+from agent.context_references import preprocess_context_references_async
+
+
+def test_repeated_url_fetches_once_and_keeps_original_text(tmp_path):
+    calls = []
+    async def fetch(url):
+        calls.append(url)
+        return "unique_payload_" * 200
+    message = "Compare @url:https://example.com/a with @url:https://example.com/a"
+    result = asyncio.run(preprocess_context_references_async(
+        message, cwd=tmp_path, context_length=10000, url_fetcher=fetch))
+    assert calls == ["https://example.com/a"]
+    assert result.message.startswith(message)
+    assert result.message.count("unique_payload_") == 200
+    assert len(result.references) == 2
+    assert not result.blocked
+
+
+def test_duplicate_file_does_not_consume_unique_attachment_slot(tmp_path):
+    (tmp_path / "a.txt").write_text("first_payload")
+    (tmp_path / "b.txt").write_text("last_payload")
+    message = " ".join(["@file:a.txt"] * 16 + ["@file:b.txt"])
+    result = asyncio.run(preprocess_context_references_async(
+        message, cwd=tmp_path, context_length=10000))
+    assert result.message.count("first_payload") == 1
+    assert "last_payload" in result.message
+    assert len(result.references) == 17
+
+
+def test_distinct_file_ranges_remain_distinct(tmp_path):
+    (tmp_path / "a.txt").write_text("first_payload\nsecond_payload\n")
+    result = asyncio.run(preprocess_context_references_async(
+        "@file:a.txt:1-1 @file:a.txt:2-2", cwd=tmp_path, context_length=10000))
+    assert "first_payload" in result.message
+    assert "second_payload" in result.message
+
+
+def test_later_message_reads_new_file_content(tmp_path):
+    path = tmp_path / "a.txt"
+    path.write_text("old_payload")
+    first = asyncio.run(preprocess_context_references_async(
+        "@file:a.txt @file:a.txt", cwd=tmp_path, context_length=10000))
+    path.write_text("new_payload")
+    second = asyncio.run(preprocess_context_references_async(
+        "@file:a.txt @file:a.txt", cwd=tmp_path, context_length=10000))
+    assert first.message.count("old_payload") == 1
+    assert second.message.count("new_payload") == 1
+    assert "old_payload" not in second.message
+
+
+def test_distinct_attachments_still_obey_work_limit(tmp_path):
+    for n in range(17):
+        (tmp_path / f"f{n}.txt").write_text(f"payload_{n:02d}")
+    message = " ".join(f"@file:f{n}.txt" for n in range(17))
+    result = asyncio.run(preprocess_context_references_async(
+        message, cwd=tmp_path, context_length=10000))
+    assert "payload_15" in result.message
+    assert "payload_16" not in result.message
+    assert any("maximum 16" in warning for warning in result.warnings)
