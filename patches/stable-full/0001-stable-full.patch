@@ -0,0 +1,123 @@
+import type { PetInfo } from '@/store/pet'
+
+export const MAX_PREVIEW_CHARACTERS = 6
+
+const maxBytes = 4 * 1024 * 1024
+const validatedSprites = new WeakSet<object>()
+const rowNames = new Set(['idle','wave','run','failed','review','jump','waiting','extra1','extra2','running-right','running-left','waving','jumping','running'])
+const integer = (value: unknown, min: number, max: number): value is number => typeof value === 'number' && Number.isInteger(value) && value >= min && value <= max
+
+function pngSize(bytes: Uint8Array): [number, number] | null {
+  if (bytes.length < 45 || !bytes.subarray(0, 8).every((b, i) => b === [137,80,78,71,13,10,26,10][i])) {return null}
+  const view = new DataView(bytes.buffer), text = (at: number) => String.fromCharCode(...bytes.subarray(at, at + 4))
+
+  if (view.getUint32(8) !== 13 || text(12) !== 'IHDR') {return null}
+
+  for (let at = 8; at + 12 <= bytes.length;) {
+    const length = view.getUint32(at), chunk = text(at + 4)
+
+    if (length > bytes.length - at - 12 || chunk === 'acTL') {return null}
+
+    if (chunk === 'IEND') {return length === 0 && at + 12 === bytes.length ? [view.getUint32(16), view.getUint32(20)] : null}
+    at += length + 12
+  }
+
+  return null
+}
+
+function webpSize(bytes: Uint8Array): [number, number] | null {
+  if (bytes.length < 30) {return null}
+  const view = new DataView(bytes.buffer), text = (at: number) => String.fromCharCode(...bytes.subarray(at, at + 4))
+
+  if (text(0) !== 'RIFF' || text(8) !== 'WEBP' || view.getUint32(4, true) + 8 !== bytes.length) {return null}
+
+  if (text(12) === 'VP8X' && (bytes[20] & 2) === 0) {
+    const uint24 = (at: number) => bytes[at] + (bytes[at + 1] << 8) + (bytes[at + 2] << 16)
+
+    return [uint24(24) + 1, uint24(27) + 1]
+  }
+
+  if (text(12) === 'VP8L' && bytes[20] === 47) {
+    const bits = view.getUint32(21, true)
+
+    return [(bits & 0x3fff) + 1, ((bits >>> 14) & 0x3fff) + 1]
+  }
+
+  if (text(12) === 'VP8 ' && bytes[23] === 157 && bytes[24] === 1 && bytes[25] === 42) {
+    return [view.getUint16(26, true) & 0x3fff, view.getUint16(28, true) & 0x3fff]
+  }
+
+  return null
+}
+
+function spriteBytes(data: unknown): Uint8Array | null {
+  if (typeof data !== 'string' || !data || data.length > Math.ceil(maxBytes / 3) * 4 || data.length % 4 || !/^[A-Za-z0-9+/]*={0,2}$/.test(data)) {return null}
+
+  try {
+    const decoded = atob(data)
+
+    if (decoded.length > maxBytes) {return null}
+
+    // The iterable form of Uint8Array.from stages the decoded string in an array.
+    const bytes = new Uint8Array(decoded.length)
+
+    for (let index = 0; index < decoded.length; index++) {
+      bytes[index] = decoded.charCodeAt(index)
+    }
+
+    return bytes
+  } catch {return null}
+}
+
+function validAnimation(info: PetInfo, columns: number, rows: number): info is PetInfo & { stateRows: string[] } {
+  if (!integer(info.framesPerState, 1, columns) || !integer(info.loopMs, 100, 60_000)) {return false}
+
+  if (!Array.isArray(info.stateRows) || info.stateRows.length !== rows || new Set(info.stateRows).size !== rows || info.stateRows.some(row => !rowNames.has(row))) {return false}
+
+  return [info.framesByState, info.framesByRow].every(counts => counts == null ||
+    (typeof counts === 'object' && !Array.isArray(counts) && Object.keys(counts).length <= 14 &&
+      Object.entries(counts).every(([row, count]) => rowNames.has(row) && integer(count, 0, columns))))
+}
+
+function immutableSprite(info: PetInfo & { stateRows: string[] }, frameW: number, frameH: number): PetInfo {
+  const { motionWeight } = info
+
+  const sprite: PetInfo = { enabled: true, slug: typeof info.slug === 'string' ? info.slug.slice(0, 128) : undefined,
+    displayName: typeof info.displayName === 'string' ? info.displayName.slice(0, 80) : undefined,
+    mime: info.mime, spritesheetBase64: info.spritesheetBase64, frameW, frameH, framesPerState: info.framesPerState,
+    framesByState: info.framesByState ? { ...info.framesByState } : undefined, framesByRow: info.framesByRow ? { ...info.framesByRow } : undefined,
+    stateRows: [...info.stateRows], loopMs: info.loopMs, scale: frameW === 96 ? 0.66 : 0.33,
+    motionWeight: motionWeight === 'light' || motionWeight === 'standard' || motionWeight === 'heavy' ? motionWeight : undefined }
+
+  Object.freeze(sprite.stateRows)
+
+  if (sprite.framesByState) {Object.freeze(sprite.framesByState)}
+
+  if (sprite.framesByRow) {Object.freeze(sprite.framesByRow)}
+  Object.freeze(sprite)
+  validatedSprites.add(sprite)
+
+  return sprite
+}
+
+/** Bound image-header dimensions before decoding; cache only immutable prepared snapshots. */
+export function boundedCharacterSprite(input: unknown): PetInfo | null {
+  if (!input || typeof input !== 'object') {return null}
+
+  if (validatedSprites.has(input)) {return input as PetInfo}
+  const info = input as PetInfo
+  const { frameW, frameH } = info
+
+  if (info.enabled !== true || !((frameW === 192 && frameH === 208) || (frameW === 96 && frameH === 104))) {return null}
+  const bytes = spriteBytes(info.spritesheetBase64)
+
+  if (!bytes) {return null}
+  const size = info.mime === 'image/png' ? pngSize(bytes) : info.mime === 'image/webp' ? webpSize(bytes) : null
+
+  if (!size || size[0] * size[1] > 3_000_000 || size[0] % frameW || size[1] % frameH) {return null}
+  const columns = size[0] / frameW, rows = size[1] / frameH
+
+  if (!integer(columns, 6, 9) || !integer(rows, 8, 9) || !validAnimation(info, columns, rows)) {return null}
+
+  return immutableSprite(info, frameW, frameH)
+}
diff --git a/apps/desktop/src/lib/pet-sprite-paint.ts b/apps/desktop/src/lib/pet-sprite-paint.ts
