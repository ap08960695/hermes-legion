+"""A config signature I/O failure must retain last-good user overrides, not defaults."""
+from pathlib import Path
+
+import pytest
+
+
+@pytest.mark.parametrize('cold', [False, True])
+@pytest.mark.parametrize('error', [PermissionError, OSError])
+def test_signature_failure_recovers_the_owning_user_config(tmp_path, monkeypatch, cold, error):
+    from hermes_cli import config as cfg, config_effective as effective
+    from hermes_cli.config_effective import load_user_config_effective
+    from hermes_constants import get_hermes_home
+
+    home = get_hermes_home()
+    managed = tmp_path / 'managed'
+    managed.mkdir()
+    monkeypatch.setenv('HERMES_MANAGED_DIR', str(managed))
+    path = home / 'config.yaml'
+    path.write_text('agent:\n  reasoning_effort_limits: {gpt-6.1-terra: high}\nsecurity: {fixture: preserve}\n')
+    (managed / 'config.yaml').write_text('display: {skin: managed-fixture}\n')
+    good = load_user_config_effective(path)
+    assert good['agent']['reasoning_effort_limits'] == {'gpt-6.1-terra': 'high'}
+    assert list((home / 'backups/config').glob('*.good.*'))
+    if cold:
+        cfg._RAW_CONFIG_CACHE.clear()
+        effective._EFFECTIVE_CACHE.clear()
+        effective._LAST_GOOD_USER_RAW.clear()
+    native = Path.stat
+
+    def denied(self, *args, **kwargs):
+        if self == path:
+            raise error('fixture config metadata unavailable')
+        return native(self, *args, **kwargs)
+
+    with monkeypatch.context() as fault:
+        fault.setattr(Path, 'stat', denied)
+        assert load_user_config_effective(path) == good
+        with pytest.raises(error):
+            load_user_config_effective(path, fail_closed=True)
+    assert load_user_config_effective(path) == good
+
+
+def test_absent_user_config_keeps_the_native_managed_only_contract(tmp_path, monkeypatch):
+    from hermes_cli.config_effective import load_user_config_effective
+    managed = tmp_path / 'managed'
+    managed.mkdir()
+    monkeypatch.setenv('HERMES_MANAGED_DIR', str(managed))
+    (managed / 'config.yaml').write_text('display: {skin: managed-fixture}\n')
+    assert load_user_config_effective(tmp_path / 'absent.yaml') == {'display': {'skin': 'managed-fixture'}}
