+                                              native_check=('messages_fts', match_query),
+                                              native_match_groups=native_groups, global_specs=specs,
+                                              global_fts_fields=('messages_fts', columns),
+                                              guard_readonly_cjk=bool(self.read_only and self._fts_cjk_available))
