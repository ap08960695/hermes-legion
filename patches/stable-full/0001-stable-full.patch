+"""Bounded read paths keep the native transcript and output contracts."""
+import json
+import random
+import time
+import tracemalloc
+from unittest.mock import patch
+
+import pytest
+from hermes_state import SessionDB
+from tools import read_extract, session_search_tool as sessions
+from tools.process_registry import ProcessRegistry, ProcessSession
+
+
+@pytest.mark.parametrize('count',[0,5,30,100])
+def test_history_deserializes_only_bookends(tmp_path,count):
+    db=SessionDB(tmp_path/'state.db')
+    try:
+        db.create_session('s',source='cli')
+        for n in range(count):
+            content = 'x' * 100_000 if count > 30 and 20 <= n < count - 10 else str(n)
+            db.append_message('s',role='assistant',content=content)
+        tracemalloc.start()
+        try:
+            out=json.loads(sessions.session_search(session_id='s',db=db))
+            _, peak = tracemalloc.get_traced_memory()
+        finally:
+            tracemalloc.stop()
+        assert out['message_count']==count
+        expected=list(range(count)) if count<=30 else list(range(20))+list(range(count-10,count))
+        assert [m['content'] for m in out['messages']]==list(map(str,expected))
+        # Hydrating the seven-megabyte middle would violate the bounded read.
+        assert peak < 3_000_000
+    finally: db.close()
+
+
+def test_discovery_resolves_each_hit_session_once(tmp_path):
+    db=SessionDB(tmp_path/'state.db')
+    try:
+        db.create_session('s',source='cli')
+        for n in range(40): db.append_message('s',role='assistant',content=f'needle {n}')
+        with patch.object(sessions,'_resolve_lineage',wraps=sessions._resolve_lineage) as resolve, patch.object(sessions,'_is_compacted_message',wraps=sessions._is_compacted_message) as compact:
+            out=json.loads(sessions.session_search(query='needle',db=db))
+        assert out['results']
+        assert resolve.call_count<=1
+        assert compact.call_count==0
+    finally: db.close()
+
+
+def test_notebook_output_cap_bounds_join_allocations():
+    cell={'outputs':[{'output_type':'stream','text':'x'*10000} for _ in range(2000)]}
+    tracemalloc.start()
+    out=read_extract._notebook_outputs(cell,'.cells[0].outputs','n.ipynb')
+    _,peak=tracemalloc.get_traced_memory();tracemalloc.stop()
+    total=2000*10000+1999
+    assert out.startswith(('x'*10000)+'\n')
+    assert f'{total-read_extract._MAX_OUTPUT_CHARS:,} output chars truncated' in out
+    assert peak<2_000_000
+
+
+def test_log_page_output_matches_splitlines():
+    rng=random.Random(47)
+    registry=ProcessRegistry()
+    session=ProcessSession(id='pages',command='fixture',task_id='task',started_at=time.time())
+    registry._running[session.id]=session
+    for _ in range(150):
+        text=''.join(rng.choice(['lineไทย','\n','\r','\r\n','\v','\u2028','😀']) for _ in range(20))
+        session.output_buffer=text
+        for offset,limit in [(None,3),(0,2),(3,5),(-3,2),(2,0),(0,-1)]:
+            lines=text.splitlines()
+            # strip_ansi preserves these Unicode/newline separators.
+            expected=lines[-limit:] if offset is None and limit>0 else lines[(offset or 0):(offset or 0)+limit]
+            out=registry.read_log(session.id,offset=offset,limit=limit)
+            assert out['output']=='\n'.join(expected)
+            assert out['total_lines']==len(lines)
+
+
+def test_tail_log_avoids_allocating_all_lines():
+    registry=ProcessRegistry();session=ProcessSession(id='large',command='fixture',task_id='task',started_at=time.time())
+    session.output_buffer='short line\n'*100000;registry._running[session.id]=session
+    tracemalloc.start();out=registry.read_log(session.id,limit=5)
+    _,peak=tracemalloc.get_traced_memory();tracemalloc.stop()
+    assert out['total_lines']==100000 and out['showing']=='5 lines'
+    assert peak<3_000_000
+
+
+def test_native_bookends_active_order_and_empty_edges(tmp_path):
+    db=SessionDB(tmp_path/'state.db')
+    try:
+        db.create_session('s',source='cli')
+        for n in range(40):db.append_message('s',role='assistant',content=str(n))
+        db._conn.execute("UPDATE messages SET active=0, compacted=1 WHERE session_id='s' AND id IN (SELECT id FROM messages WHERE session_id='s' ORDER BY id LIMIT 3)")
+        db._conn.commit()
+        full=db.get_messages('s')
+        for head,tail in [(20,10),(50,50),(0,10),(10,0),(0,0)]:
+            rows,count=db.get_message_bookends('s',head,tail)
+            expected={r['id'] for r in full[:head]+(full[-tail:] if tail else [])}
+            assert rows==[r for r in full if r['id'] in expected]
+            assert count==len(full)
+        assert db.get_message_bookends('missing')==([],0)
+    finally:db.close()
+
+
+def test_log_accepts_preceding_presentation_module(monkeypatch):
+    from tools import process_registry_tool_output as presentation
+    monkeypatch.delattr(presentation,'log_page')
+    reg=ProcessRegistry();s=ProcessSession(id='old',command='fixture',task_id='task',started_at=1)
+    s.output_buffer='a\nb\nc';reg._running[s.id]=s
+    assert reg.read_log(s.id,limit=2)['output']=='b\nc'
+    assert reg.read_log(s.id,offset=0,limit=1)['output']=='a'
