+def test_content_key_streams_bytes_and_detects_same_size_change(image, monkeypatch):
+    import os
+    from pathlib import Path
+    from PIL import Image
+
+    Image.new("RGB", (4, 4), (200, 30, 30)).save(image, compress_level=0)
+    before = image.stat()
+    expected = vt._analysis_cache_key(image, "q", "m", {})
+    assert expected is not None
+    native_read = Path.read_bytes
+
+    def forbid_whole_read(path):
+        if path == image:
+            raise AssertionError("content key must not allocate whole image bytes")
+        return native_read(path)
+
+    monkeypatch.setattr(Path, "read_bytes", forbid_whole_read)
+    assert vt._analysis_cache_key(image, "q", "m", {}) == expected
+    Image.new("RGB", (4, 4), (20, 30, 30)).save(image, compress_level=0)
+    os.utime(image, ns=(before.st_atime_ns, before.st_mtime_ns))
+    assert image.stat().st_size == before.st_size
+    assert image.stat().st_mtime_ns == before.st_mtime_ns
+    changed = vt._analysis_cache_key(image, "q", "m", {})
+    assert changed is not None and changed != expected
+
