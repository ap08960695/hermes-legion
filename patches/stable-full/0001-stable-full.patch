@@ -0,0 +1,75 @@
+"""Quiet sandbox logs should not launch payload readers until bytes arrive."""
+
+import os
+import shlex
+import shutil
+import subprocess
+
+import pytest
+
+from tools.process_registry import ProcessRegistry
+
+
+pytestmark = pytest.mark.platforms("posix")
+
+
+def _read_delta(log, offset, env=None):
+    command = ProcessRegistry._log_delta_command(shlex.quote(str(log)), offset)
+    result = subprocess.run(
+        ["sh", "-c", command], capture_output=True, check=True, timeout=10, env=env
+    )
+    header, _, payload = result.stdout.partition(b"\n")
+    size, used = map(int, header.split())
+    return size, used, payload
+
+
+@pytest.mark.parametrize("content", [b"", b"done\n", "เสร็จ😀".encode()], ids=["empty", "ascii", "utf8"])
+def test_quiet_log_avoids_payload_readers(tmp_path, content):
+    log = tmp_path / "worker's log.txt"
+    log.write_bytes(content)
+    trace = tmp_path / "reads"
+    bin_dir = tmp_path / "bin"
+    bin_dir.mkdir()
+    for name in ("tail", "head", "od"):
+        real = shutil.which(name)
+        assert real
+        wrapper = bin_dir / name
+        wrapper.write_text(
+            "#!/bin/sh\n"
+            f"echo {name} >> {shlex.quote(str(trace))}\n"
+            f"exec {shlex.quote(real)} \"$@\"\n"
+        )
+        wrapper.chmod(0o755)
+    env = {**os.environ, "PATH": f"{bin_dir}{os.pathsep}{os.environ['PATH']}"}
+
+    assert _read_delta(log, len(content), env) == (len(content), len(content), b"")
+    assert not trace.exists(), "Quiet logs must not start payload-reading subprocesses"
+
+    # The same command path must still read fresh output after a quiet interval.
+    log.write_bytes(content + "ใหม่\n".encode())
+    assert _read_delta(log, len(content), env) == (
+        log.stat().st_size, len(content), "ใหม่\n".encode()
+    )
+    assert trace.exists()
+
+
+def test_quiet_then_split_utf8_and_truncation(tmp_path):
+    log = tmp_path / "worker's log.txt"
+    full = "first\nไทยé😀\n".encode()
+    offset = 0
+    received = b""
+    for size in range(len(full) + 1):
+        log.write_bytes(full[:size])
+        end, used, delta = _read_delta(log, offset)
+        assert used == offset
+        delta.decode("utf-8")  # Each backend response must be independently decodable.
+        assert end == offset + len(delta)
+        received += delta
+        offset = end
+        # Re-reading an incomplete UTF-8 tail must not duplicate already sent bytes.
+        assert _read_delta(log, offset) == (end, end, b"")
+    assert received == full
+    log.write_bytes(b"")
+    assert _read_delta(log, offset) == (0, 0, b"")
+    log.write_bytes(b"new\n")
+    assert _read_delta(log, 0) == (4, 0, b"new\n")
