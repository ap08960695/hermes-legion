+"""Local shared pages/files. Bot CLI access is read-only and membership-scoped."""
+from __future__ import annotations
+import argparse
+import base64
+import contextlib
+import hashlib
+import json
+import os
+from pathlib import Path
+import sqlite3
+import time
+import uuid
+
+MAX_FILE_BYTES = 8 * 1024 * 1024
+MAX_PAGE_BYTES = 1024 * 1024
+
+class SpaceConflict(ValueError):
+    pass
+
+class SpaceDenied(PermissionError):
+    pass
+
+class Spaces:
+    def __init__(self, home: Path | None = None):
+        from hermes_constants import get_default_hermes_root
+        self.path = (home or get_default_hermes_root()).resolve() / 'spaces' / 'catalog.db'
+
+    @contextlib.contextmanager
+    def connection(self, write=False):
+        if not write and not self.path.exists():
+            yield None
+            return
+        if write:
+            self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+            conn = sqlite3.connect(self.path, timeout=.5)
+        else:
+            conn = sqlite3.connect(self.path.as_uri()+'?mode=ro', uri=True, timeout=.5)
+        conn.row_factory = sqlite3.Row
+        try:
+            if write:
+                os.chmod(self.path, 0o600)
+                conn.executescript("""PRAGMA journal_mode=WAL;
+                CREATE TABLE IF NOT EXISTS spaces(id TEXT PRIMARY KEY,title TEXT NOT NULL,members TEXT NOT NULL,revision INTEGER NOT NULL,updated REAL NOT NULL);
