+    assert mgr.state.status == 'paused'
+    assert mgr.state.waiting_on_session == 'proc_missing_verified_wait'
+    assert mgr.state.turns_used == 0
+    judge.assert_not_called()
+
+
+def test_registry_strict_probe_distinguishes_missing_and_trigger(home):
+    from tools.process_registry import ProcessSession, process_registry
+    sid = 'proc_strict_verified_wait'
+    session = ProcessSession(id=sid, command='watch', task_id='t', session_key='', cwd='/tmp', started_at=time.time())
+    session.watch_patterns = ['READY']
+    process_registry._running[sid] = session
+    try:
+        assert process_registry.is_session_waiting(sid, strict=True) is True
+        session._watch_hits = 1
+        assert process_registry.is_session_waiting(sid, strict=True) is False
+        assert process_registry.is_session_waiting('proc_missing_verified_wait', strict=True) is None
+        assert process_registry.is_session_waiting('proc_missing_verified_wait') is False
+    finally:
+        process_registry._running.pop(sid, None)
+
+
+def test_registry_refresh_error_is_unknown_in_strict_mode(home, monkeypatch):
