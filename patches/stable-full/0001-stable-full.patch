@@ -0,0 +1,199 @@
+"""Operator inbox for the active gateway's already-running question and approval waiters."""
+
+import asyncio
+from dataclasses import replace
+import sqlite3
+import threading
+from weakref import WeakKeyDictionary
+
+from gateway.session_authorities import owner_scope, serving_authorities
+from gateway.session_contract import SessionRef
+from hermes_constants import profile_name_for_home
+from hermes_state_runtime import RuntimeStoreError, list_session_admissions
+
+_CAPABILITIES = {'clarify': 'session:respond', 'approval': 'session:approve'}
+_watchers = WeakKeyDictionary()
+_watchers_lock = threading.Lock()
+
+
+def _require_operator(connection):
+    if not {'session:operator', 'session:read'} <= connection.actor.capabilities:
+        raise RuntimeStoreError('permission_denied')
+
+
+def _authorities(connection):
+    if connection.host_scoped:
+        yield from serving_authorities(connection.authority.runner)
+    else:
+        yield connection.authority
+
+
+def _changed(connection, events, sid):
+    # Run on the socket's loop, outside the publisher's session lock. Use stream
+    # identity: even an equal session ID in another profile is a different waiter.
+    with _watchers_lock:
+        if connection not in _watchers:
+            return
+    for authority in _authorities(connection):
+        live = authority.sessions.get(sid)
+        if live is not None and live.event_stream is events:
+            connection.transport.write({'jsonrpc': '2.0', 'method': 'event',
+                                        'params': {'type': 'owner_inbox.changed', 'payload': {}}})
+            break
+
+
+def notify(events, sid, kind):
+    """Send a content-free invalidation only to operators watching this session's gateway."""
+    with _watchers_lock:
+        watchers = tuple(_watchers.items())
+    for connection, loop in watchers:
+        if _CAPABILITIES[kind] not in connection.actor.capabilities:
+            continue
+        # The socket may be closing while a model-thread waiter settles.
+        try:
+            loop.call_soon_threadsafe(_changed, connection, events, sid)
+        except RuntimeError:
+            unwatch(connection)
+
+
+def unwatch(connection):
+    with _watchers_lock:
+        _watchers.pop(connection, None)
+
+
+async def stop_watching(connection, ref, params):
+    unwatch(connection)
+    return {'watching': False}
+
+
+def _metadata(authority, sid, generation):
+    from gateway.run import _redact_approval_command
+    from gateway.session_local_close import _local_target
+    from hermes_cli.goals_metadata import read_goal
+
+    with owner_scope(authority):
+        row = authority.db.get_session_list_row(sid)
+        target = _local_target(authority, sid) or sid
+        goal, _ = read_goal(authority.db, authority.db.get_compression_tip(target) or target)
+        for admission in list_session_admissions(authority.db, session_id=sid):
+            if admission['generation'] == generation and admission['status'] == 'started':
+                card = admission['payload'].get('kanban_card_v1')
+                break
