+"""Current RSS fallback is diagnostic-only; existing observations remain authoritative."""
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from gateway.runtime_memory import collect_runtime_memory
+
+
+class RuntimeMemoryRssTests(unittest.TestCase):
+    def test_missing_rss_uses_current_process_and_preserves_unknown_anon(self):
+        process = {'rss_kib': None, 'rss_anon_kib': None, 'thread_count': 7}
+        with patch('hermes_cli.mem_trim.collect_memory_snapshot', return_value=process), patch(
+            'psutil.Process', return_value=SimpleNamespace(
+                memory_info=lambda: SimpleNamespace(rss=123 * 1024))
+        ):
+            result = collect_runtime_memory()
+        self.assertEqual(result['process'], {'rss_kib': 123, 'rss_anon_kib': None, 'thread_count': 7})
+        self.assertNotIn('allocations', result)
+        self.assertFalse(result['sqlite']['reset_highwater'])
+
+    def test_existing_rss_including_zero_never_samples_fallback(self):
+        for rss in (0, 456):
+            with self.subTest(rss=rss), patch(
+                'hermes_cli.mem_trim.collect_memory_snapshot',
+                return_value={'rss_kib': rss, 'rss_anon_kib': 100, 'thread_count': 3}
+            ), patch('psutil.Process', side_effect=AssertionError('unnecessary sampling')):
+                self.assertEqual(collect_runtime_memory()['process']['rss_kib'], rss)
+
+    def test_observation_never_trims_collects_or_opens_a_session_database(self):
+        with patch('hermes_cli.mem_trim.trim_memory', side_effect=AssertionError('trim')), patch(
+            'gc.collect', side_effect=AssertionError('gc')
+        ), patch('sqlite3.connect', side_effect=AssertionError('database')):
+            self.assertNotIn('allocations', collect_runtime_memory())
+
+
+if __name__ == '__main__':
+    unittest.main()
