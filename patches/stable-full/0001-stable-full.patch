index 0000000000000000000000000000000000000000..e1805d095e92ef3f73842773124df8679a7bf657
--- /dev/null
+++ b/tests/hermes_state/test_sql_blob_reader.py
@@ -0,0 +1,118 @@
+"""Byte-window readers preserve binary data, SQLite snapshots and caller state."""
+import sqlite3
+import tracemalloc
+
+import pytest
+
+from hermes_state_blob_reader import SQLiteBlobReader
+
+
+@pytest.mark.parametrize('payload', ['', 'a\x00ภาษาไทย café', b'\xff\x00\x80binary', 'x' * 2_000_000])
+def test_byte_reads_and_seeks_match_source(payload):
+    conn = sqlite3.connect(':memory:')
+    conn.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content)')
+    conn.execute('INSERT INTO messages VALUES(1,?)', (payload,))
+    expected = payload.encode() if isinstance(payload, str) else payload
+    try:
+        with SQLiteBlobReader(conn, 'content', 1) as view:
+            assert len(view) == len(expected)
+            assert view.read(6) == expected[:6]
+            assert view.tell() == min(6, len(expected))
+            view.seek(0)
+            parts = []
+            while part := view.read(65536):
+                parts.append(part)
+            assert b''.join(parts) == expected
+            view.seek(-min(3, len(expected)), 2)
+            assert view.read(10) == expected[len(expected) - min(3, len(expected)):]
+            with pytest.raises(ValueError):
+                view.seek(len(expected) + 1)
+        with pytest.raises(sqlite3.ProgrammingError):
+            view.read(1)
+        view.close()
+        assert conn.execute('SELECT count(*) FROM messages').fetchone()[0] == 1
+    finally:
+        conn.close()
+
+
+def test_anchor_preserves_snapshot_across_concurrent_update(tmp_path):
+    path = tmp_path / 'snapshot.db'
+    writer = sqlite3.connect(path, isolation_level=None)
+    writer.execute('PRAGMA journal_mode=WAL')
+    writer.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content TEXT)')
+    writer.execute("INSERT INTO messages VALUES(1,'old-value')")
+    reader = sqlite3.connect(path.as_uri() + '?mode=ro', uri=True)
+    reader.execute('PRAGMA query_only=ON')
+    try:
+        with SQLiteBlobReader(reader, 'content', 1) as view:
+            assert view.read(4) == b'old-'
+            writer.execute("UPDATE messages SET content='new-value' WHERE id=1")
+            assert view.read() == b'value'
+            view.seek(0)
+            assert view.read() == b'old-value'
+        with SQLiteBlobReader(reader, 'content', 1) as view:
+            assert view.read() == b'new-value'
+        assert reader.total_changes == 0
+        assert not reader.in_transaction
+    finally:
+        reader.close()
+        writer.close()
+
+
+def test_reader_leaves_caller_transaction_and_handler_intact():
+    conn = sqlite3.connect(':memory:')
+    conn.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content TEXT)')
+    conn.execute("INSERT INTO messages VALUES(1,'value')")
+    calls = []
+    conn.set_progress_handler(lambda: calls.append(1) or 0, 1)
+    try:
+        with SQLiteBlobReader(conn, 'content', 1) as view:
+            assert view.read() == b'value'
+        assert conn.in_transaction
+        before = len(calls)
+        conn.execute('SELECT count(*) FROM messages').fetchone()
+        assert len(calls) > before
+        conn.rollback()
+        assert conn.execute('SELECT count(*) FROM messages').fetchone()[0] == 0
+    finally:
+        conn.set_progress_handler(None, 0)
+        conn.close()
+
+
+@pytest.mark.parametrize(('field', 'mid'), [('content; DROP TABLE messages', 1), ('missing', 1)])
+def test_reader_refuses_unknown_columns(field, mid):
+    conn = sqlite3.connect(':memory:')
+    try:
+        with pytest.raises(ValueError):
+            SQLiteBlobReader(conn, field, mid)
+    finally:
+        conn.close()
+
+
+@pytest.mark.parametrize('mid', [1, 2])
+def test_reader_rejects_null_or_missing_fields(mid):
+    conn = sqlite3.connect(':memory:')
+    conn.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content)')
+    conn.execute('INSERT INTO messages VALUES(1,NULL)')
+    try:
+        with pytest.raises(sqlite3.OperationalError):
+            SQLiteBlobReader(conn, 'content', mid)
+    finally:
+        conn.close()
+
+
+def test_large_field_small_windows_keep_python_allocation_bounded():
+    conn = sqlite3.connect(':memory:')
+    conn.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content TEXT)')
+    conn.execute('INSERT INTO messages VALUES(1,?)', ('x' * 2_000_000,))
+    tracemalloc.start()
+    try:
+        with SQLiteBlobReader(conn, 'content', 1) as view:
+            assert view.read(512) == b'x' * 512
+            view.seek(1_500_000)
+            assert view.read(512) == b'x' * 512
+            _, peak = tracemalloc.get_traced_memory()
+            assert peak < 256 * 1024
+    finally:
+        tracemalloc.stop()
+        conn.close()
diff --git a/tests/hermes_state/test_stream_recall.py b/tests/hermes_state/test_stream_recall.py
new file mode 100644
index 0000000000000000000000000000000000000000..3fffa0c5b6ab2a8c017d6fa85a91010e97a1dd83
--- /dev/null
+++ b/tests/hermes_state/test_stream_recall.py
@@ -0,0 +1,288 @@
+"""Streaming structured recall agrees with the native JSON representation."""
+
+import base64
+import json
+import random
+import sqlite3
+import time
+import tracemalloc
+
+import pytest
+
+from hermes_state_stream_recall import (
+    InvalidJSON,
+    Search,
+    UnsupportedJSON,
+    analyze,
+    page,
+    raw_binary_page,
+    raw_json_page,
+    text_spans,
+)
+
+
+@pytest.fixture
+def conn():
+    db = sqlite3.connect(":memory:")
+    db.execute("CREATE TABLE messages(id INTEGER PRIMARY KEY, content TEXT)")
+    yield db
+    db.close()
+
+
+def expected(value):
+    if isinstance(value, str):
+        return value
+    if isinstance(value, dict):
+        return (
+            value.get("text", "")
+            if value.get("type") == "text" and isinstance(value.get("text"), str)
+            else ""
+        )
+    if isinstance(value, list):
+        return "\n".join(
+            part["text"]
+            for part in value
+            if isinstance(part, dict)
+            and part.get("type") == "text"
+            and isinstance(part.get("text"), str)
+        )
+    return ""
+
+
+@pytest.mark.parametrize("chunk_size", [1, 2, 3, 7, 31, 4096])
+def test_structured_projection_and_pages_match_native_json(conn, chunk_size):
+    rng = random.Random(781)
+    alphabet = 'abCD ไทย日本🙂\n\t\x00"\\/'
+    values = [
+        [
+            {"type": "image_url", "image_url": {"url": "A" * 4096}},
+            {"text": "ไทย🙂\x00abc", "type": "text"},
+        ],
+        [
+            {"type": "text", "text": "🙂🙂🙂"},
+            {"type": "image_url", "text": "ignore"},
+            {"type": "text", "text": "last"},
+        ],
+        {"type": "text", "text": 'literal " \\ \n ไทย🙂'},
+        "\x00json:literal text",
+        [],
+        None,
+    ]
+    for _ in range(60):
+        parts = []
+        for _ in range(rng.randrange(0, 7)):
+            text = "".join(rng.choice(alphabet) for _ in range(rng.randrange(0, 60)))
+            part = {"type": rng.choice(["text", "image_url", "other"]), "text": text}
+            part["nested"] = {"type": "text", "text": "hidden nested"}
+            parts.append(
+                part if rng.randrange(4) else rng.choice([None, 3, "not a part"])
+            )
+        values.append(parts)
+    for value in values:
+        for ensure_ascii in (False, True):
+            raw = "\x00json:" + json.dumps(value, ensure_ascii=ensure_ascii)
+            conn.execute("DELETE FROM messages")
+            conn.execute("INSERT INTO messages VALUES(1,?)", (raw,))
+            wanted = expected(value)
+            with conn.blobopen("messages", "content", 1, readonly=True) as blob:
+                spans = text_spans(blob, chunk_size=chunk_size)
+                info = analyze(
+                    blob, spans, ["ไทย", "🙂", "\\", "\n"], chunk_size=chunk_size
+                )
+                for term, found in zip(["ไทย", "🙂", "\\", "\n"], info["positions"]):
+                    pos = wanted.find(term)
+                    assert (found is None) == (pos < 0)
+                    if pos >= 0:
+                        assert found == (pos, len(wanted[:pos].encode()))
+                for offset in (0, 1, 4, 17, max(0, len(wanted) - 1)):
+                    result = page(blob, spans, offset, 7, chunk_size=chunk_size)
+                    if "\x00" in wanted:
+                        assert result["offset_unit"] == "bytes"
+                        assert (
+                            base64.b64decode(result["content"])
+                            == wanted.encode()[offset : offset + 7]
+                        )
+                    else:
+                        assert result["offset_unit"] == "characters"
+                        assert result["content"] == wanted[offset : offset + 7]
+
+
+@pytest.mark.parametrize(
+    "raw",
+    [
+        "\x00json:[",
+        '\x00json:[{"type":"text","text":"bad\\q"}]',
+        '\x00json:[{"type":"text","text":"bad\x00"}]',
+        "\x00json:[1,]",
+    ],
+)
+def test_malformed_json_is_rejected(conn, raw):
+    conn.execute("INSERT INTO messages VALUES(1,?)", (raw,))
+    with (
+        conn.blobopen("messages", "content", 1, readonly=True) as blob,
+        pytest.raises(InvalidJSON),
+    ):
+        text_spans(blob, chunk_size=3)
+
+
+def test_duplicate_keys_follow_python_json_last_key_wins(conn):
+    raw = '\x00json:[{"type":"image", "type":"text", "text":"old", "text":"new"}]'
+    conn.execute("INSERT INTO messages VALUES(1,?)", (raw,))
+    with conn.blobopen("messages", "content", 1, readonly=True) as blob:
+        spans = text_spans(blob, chunk_size=2)
+        assert page(blob, spans, 0, 100, chunk_size=3)["content"] == "new"
+
+
+def test_nested_sql_function_search_ignores_image_payload(conn):
+    raw = "\x00json:" + json.dumps(
+        [
+            {"type": "image_url", "url": "IMAGEPAYLOADMARKER"},
+            {"type": "text", "text": "alpha ไทย beta"},
+        ]
+    )
+    conn.execute("INSERT INTO messages VALUES(1,?)", (raw,))
+    search = Search(conn, ["ไทย", "alpha", "beta", "IMAGEPAYLOADMARKER"])
+    conn.create_function("_stream_match", 2, search.contains)
+    assert (
+        conn.execute("SELECT _stream_match(id, 'ไทย') FROM messages").fetchone()[0] == 1
+    )
+    assert (
+        conn.execute(
+            "SELECT _stream_match(id, 'IMAGEPAYLOADMARKER') FROM messages"
+        ).fetchone()[0]
+        == 0
+    )
+    assert conn.execute(
+        "SELECT _stream_match(id, 'alpha') AND _stream_match(id, 'beta') FROM messages"
+    ).fetchone()[0]
+    hit = search.excerpt(1, ["ไทย"], 512)
+    assert hit["snippet_field"] == "text" and "ไทย" in hit["snippet"]
+    conn.create_function("_stream_match", 2, None)
+
+
+def test_large_image_is_skipped_without_hydrating_it_into_python(conn):
+    raw = "\x00json:" + json.dumps(
+        [
+            {"type": "image_url", "url": "A" * 8_000_000},
+            {"type": "text", "text": "needle"},
+        ]
+    )
+    conn.execute("INSERT INTO messages VALUES(1,?)", (raw,))
+    del raw
+    with conn.blobopen("messages", "content", 1, readonly=True) as blob:
+        tracemalloc.start()
+        try:
+            spans = text_spans(blob)
+            info = analyze(blob, spans, ["needle"])
+            _, peak = tracemalloc.get_traced_memory()
+        finally:
+            tracemalloc.stop()
+    assert info["positions"][0] is not None
+    assert peak < 2_000_000
+
+
+def test_expired_deadline_is_not_reported_as_empty(conn):
+    conn.execute("INSERT INTO messages VALUES(1,?)", ("\x00json:[]",))
+    with (
+        conn.blobopen("messages", "content", 1, readonly=True) as blob,
+        pytest.raises(TimeoutError),
+    ):
+        text_spans(blob, deadline=time.monotonic() - 1)
+
+
+@pytest.mark.parametrize("ensure_ascii", [False, True])
+@pytest.mark.parametrize("chunk_size", [1, 3, 7, 512])
+def test_raw_json_pages_reconstruct_exact_stored_serialization(
+    conn, ensure_ascii, chunk_size
+):
+    raw = json.dumps(
+        [
+            {"type": "text", "text": 'ไทย🙂\x00"\\'},
+            {"type": "image_url", "url": "A" * 100},
+        ],
+        ensure_ascii=ensure_ascii,
+    )
+    conn.execute("INSERT INTO messages VALUES(1,?)", ("\x00json:" + raw,))
+    pieces, offset = [], 0
+    with conn.blobopen("messages", "content", 1, readonly=True) as blob:
+        while offset is not None:
+            result = raw_json_page(blob, offset, 11, chunk_size=chunk_size)
+            pieces.append(result["content"])
+            offset = result["next_offset"]
+    assert "".join(pieces) == raw
+
+
+def test_raw_binary_page_keeps_marker_and_unicode_bytes(conn):
+    original = "\x00json:{badไทย🙂".encode()
+    conn.execute("INSERT INTO messages VALUES(1,?)", (original,))
+    pieces, offset = [], 0
+    with conn.blobopen("messages", "content", 1, readonly=True) as blob:
+        while offset is not None:
+            result = raw_binary_page(blob, offset, 3)
+            pieces.append(base64.b64decode(result["content"]))
+            offset = result["next_offset"]
+    assert b"".join(pieces) == original
+
+
+def test_predicate_cache_drops_spans_and_excerpt_remains_available(conn):
+    value = [{"type": "text", "text": "alpha"}, {"type": "text", "text": "beta"}]
+    for mid in range(1, 71):
+        conn.execute(
+            "INSERT INTO messages VALUES(?,?)", (mid, "\x00json:" + json.dumps(value))
+        )
+    search = Search(conn, ["alpha", "beta"])
+    for mid in range(1, 71):
+        assert search.contains(mid, "alpha")
+        assert search.contains(mid, "beta")
+    assert len(search.cache) == 64
+    assert all(item["spans"] is None for item in search.cache.values())
+    hit = search.excerpt(70, ["beta"], 128)
+    assert hit["snippet_field"] == "text" and "beta" in hit["snippet"]
+
+
+@pytest.mark.parametrize(
+    ("raw", "message"),
+    [
+        ("\x00json:" + "[" * 520 + "null" + "]" * 520, "nesting"),
+        ("\x00json:" + "1" * 1025, "scalar"),
+    ],
+)
+def test_unsupported_json_fails_loudly_instead_of_reporting_no_match(
+    conn, raw, message
+):
+    conn.execute("INSERT INTO messages VALUES(1,?)", (raw,))
+    search = Search(conn, ["needle"])
+    with pytest.raises(UnsupportedJSON, match=message):
+        search.contains(1, "needle")
+
+
+def test_nonstandard_float_values_from_python_json_do_not_hide_text(conn):
+    value = [
+        {"type": "image_url", "values": [float("nan"), float("inf"), -float("inf")]},
+        {"type": "text", "text": "needle"},
+    ]
+    conn.execute("INSERT INTO messages VALUES(1,?)", ("\x00json:" + json.dumps(value),))
+    search = Search(conn, ["needle"])
+    assert search.contains(1, "needle")
+    assert search.excerpt(1, ["needle"], 128)["snippet"] == "needle"
+
+
+def test_unpaired_surrogate_pages_losslessly_as_base64(conn):
+    raw = "\x00json:" + json.dumps([{"type": "text", "text": "alpha\ud800beta"}])
+    conn.execute("INSERT INTO messages VALUES(1,?)", (raw,))
+    search = Search(conn, ["beta"])
+    assert search.contains(1, "beta")
+    hit = search.excerpt(1, ["beta"], 128)
+    assert hit["snippet_encoding"] == "base64" and hit["offset_unit"] == "bytes"
+    assert (
+        base64.b64decode(hit["snippet"]).decode("utf-8", "surrogatepass")
+        == "alpha\ud800beta"
+    )
+    with conn.blobopen("messages", "content", 1, readonly=True) as blob:
+        spans = text_spans(blob)
+        result = page(blob, spans, 0, 128)
+    assert result["encoding"] == "base64" and result["offset_unit"] == "bytes"
+    assert (
+        base64.b64decode(result["content"]).decode("utf-8", "surrogatepass")
+        == "alpha\ud800beta"
+    )
