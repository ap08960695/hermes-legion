diff --git a/gateway/session_bootstrap_io.py b/gateway/session_bootstrap_io.py
new file mode 100644
index 0000000000000000000000000000000000000000..6dd5de7bd1df30dc611f51f2bc5480ac05fad1a3
--- /dev/null
+++ b/gateway/session_bootstrap_io.py
@@ -0,0 +1,31 @@
+"""Keep profile preparation under custody until its physical I/O has settled."""
+import asyncio
+from contextvars import copy_context
+from functools import partial
+
+
+async def profile_store_io(operation, *args, get_executor=None, **kwargs):
+    """Drain even repeated cancellation; Gateway work belongs to its native shutdown pool.
+
+    Shield the executor Future itself: a child Task can also be cancelled during loop teardown,
+    leaving its physical writer running after the profile reservation has been released.
+    Resolve the executor per operation so the native closing fence remains authoritative.
+    """
+    executor = get_executor() if get_executor is not None else None
+    pending = asyncio.get_running_loop().run_in_executor(
+        executor, copy_context().run, partial(operation, *args, **kwargs))
+    cancelled = None
+    try:
+        while not pending.done():
+            try:
+                await asyncio.shield(pending)
+            except asyncio.CancelledError as exc:
+                cancelled = exc
+        result = pending.result()
+    except BaseException:
+        if cancelled is not None:
+            raise cancelled
+        raise
+    if cancelled is not None:
+        raise cancelled
+    return result
diff --git a/gateway/session_bot_file.py b/gateway/session_bot_file.py
new file mode 100644
index 0000000000000000000000000000000000000000..4750b9a338469ab17938e3a176a807cf276f2318
--- /dev/null
+++ b/gateway/session_bot_file.py
@@ -0,0 +1,208 @@
+"""Bounded, click-only file snapshots for the current Bot Chat workspace."""
+from base64 import b64encode
+from contextlib import contextmanager
+import hmac
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import stat
+from threading import Lock
+from time import monotonic
+from unicodedata import category
+
+from agent.file_safety import is_sensitive_managed_path
+
+_TOKEN_KEY = secrets.token_bytes(32)
+_TTL = 30
+_TEXT_BYTES = 8192
+_PNG_BYTES = 128 * 1024
+_PNG_MAX_SIDE = 1024
+_PDF_BYTES = 512 * 1024
+_PDF_OFFERS = {}
+_PDF_OFFER_LIMIT = 64
+_PDF_LOCK = Lock()
+
+
+def preview_supported():
+    from tools.terminal_scope import TerminalPolicyUnavailable, terminal_env
+
+    if os.name != 'posix' or not hasattr(os, 'O_NOFOLLOW') or not hasattr(os, 'O_DIRECTORY'):
+        return False
+    try:
+        return terminal_env('TERMINAL_ENV', 'local') == 'local'
+    except TerminalPolicyUnavailable:
+        return False
+
+
+def workspace_delivery(raw, cwd, profile_id, *, allow_pdf=False):
+    from hermes_constants import get_default_hermes_root
+
+    # shortcut: one literal direct child until the transcript projects structured attachments.
+    lines = raw.splitlines()
+    if not cwd or raw.count('MEDIA:') != 1 or any(line.lstrip().startswith(('```', '~~~')) for line in lines):
+        return None
+    value = next((line[6:].strip(' \t') for line in lines if line.startswith('MEDIA:')), '')
+    if not value:
+        return None
+    if value[0] in ('"', "'") and value[-1] == value[0]:
+        value = value[1:-1]
+    elif any(char.isspace() for char in value):
+        return None
+    suffixes = ('.txt', '.md', '.csv', '.png', '.pdf') if allow_pdf else ('.txt', '.md', '.csv', '.png')
+    if not value.startswith('/') or not value.lower().endswith(suffixes):
+        return None
+    if any(not part or part.startswith('.') for part in value[1:].split('/')):
+        return None
+    if any(char in '"`\\' or category(char)[0] == 'C' or category(char) in ('Zl', 'Zp') for char in value):
+        return None
+    if value.rpartition('/')[0] != cwd or any(part.endswith((' ', '.')) for part in cwd[1:].split('/')):
+        return None
+    path = Path(value)
+    folded = Path(value.casefold())
+    private_roots = (Path(profile_id), get_default_hermes_root())
+    if is_sensitive_managed_path(path) or any(folded.is_relative_to(str(root).casefold()) for root in private_roots):
+        return None
+    return path
+
+
+def preview_candidate(path, binding):
+    if path.suffix.lower() != '.pdf':
+        return path, binding, None
+    try:
+        with _workspace_parent(path) as directory:
+            stamp = _pdf_stamp(os.stat(path.name, dir_fd=directory, follow_symlinks=False))
+    except (OSError, NotImplementedError):
+        return None
+    return (path, binding, stamp) if stamp else None
+
+
+def _token(candidate, expiry):
+    path, binding, stamp = candidate
+    parts = [expiry, str(path), *binding]
+    if stamp:
+        parts.append(stamp)
+    data = json.dumps(parts, separators=(',', ':')).encode()
+    return f'{expiry}.{hmac.digest(_TOKEN_KEY, data, "sha256").hex()}'
+
+
+def issue_preview(candidate):
+    expiry = int(monotonic()) + _TTL
+    token = _token(candidate, expiry)
+    if candidate[2]:
+        offer = f'{expiry}.{secrets.token_hex(32)}'
+        with _PDF_LOCK:
+            if len(_PDF_OFFERS) >= _PDF_OFFER_LIMIT:
+                del _PDF_OFFERS[next(iter(_PDF_OFFERS))]
+            _PDF_OFFERS[offer] = token
+        token = offer
+    return {'path': str(candidate[0]), 'token': token}
+
+
+def read_preview(token, snapshot):
+    if not isinstance(token, str) or not re.fullmatch(r'[0-9]{1,12}\.[0-9a-f]{64}', token):
+        return None
+    expiry = int(token.split('.', 1)[0])
+    if expiry <= monotonic():
+        return None
+    _, candidate = snapshot()
+    if not candidate:
+        return None
+    path, _, stamp = candidate
+    expected = _token(candidate, expiry)
+    if stamp:
+        with _PDF_LOCK:
+            if expiry <= monotonic() or not hmac.compare_digest(_PDF_OFFERS.get(token, ''), expected):
+                return None
+            del _PDF_OFFERS[token]
+    elif not hmac.compare_digest(expected, token):
+        return None
+    result = _read_delivery(path, stamp)
+    if result is None or expiry <= monotonic():
+        return None
+    _, current = snapshot()
+    return result if current == candidate and expiry > monotonic() else None
+
+
+def _static_png(data):
+    from agent.image_eviction_policy import image_dimensions_from_bytes
+
+    if len(data) < 33 or not data.startswith(b'\x89PNG\r\n\x1a\n\x00\x00\x00\x0dIHDR'):
+        return False
+    if not all(0 < side <= _PNG_MAX_SIDE for side in image_dimensions_from_bytes(data)):
+        return False
+
+    # Avoid extra frames or metadata inflation before handing the image to Chromium.
+    offset, saw_image = 33, False
+    while offset + 12 <= len(data):
+        length = int.from_bytes(data[offset:offset + 4], 'big')
+        kind = data[offset + 4:offset + 8]
+        offset += 12 + length
+        if offset > len(data) or kind in (b'IHDR', b'acTL', b'fcTL', b'fdAT', b'iCCP', b'zTXt', b'iTXt'):
+            return False
+        if kind == b'IEND':
+            return saw_image and length == 0 and offset == len(data)
+        saw_image = saw_image or kind == b'IDAT'
+    return False
+
+
+def _read_delivery(path, stamp):
+    if stamp:
+        data = _read_workspace_file(path, _PDF_BYTES, stamp=stamp)
+        return {'text': None, 'pdf_base64': b64encode(data).decode('ascii')} if data and data.startswith(b'%PDF-') else None
+    png = path.suffix.lower() == '.png'
+    data = _read_workspace_file(path, _PNG_BYTES if png else _TEXT_BYTES)
+    if data is None:
+        return None
+    if png:
+        return {'text': None, 'png_base64': b64encode(data).decode('ascii')} if _static_png(data) else None
+    if any(byte < 32 and byte not in (9, 10, 13) for byte in data):
+        return None
+    try:
+        return {'text': data.decode('utf-8')}
+    except UnicodeError:
+        return None
+
+
+def _pdf_stamp(info):
+    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or not 5 <= info.st_size <= _PDF_BYTES:
+        return None
+    return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns
+
+
+@contextmanager
+def _workspace_parent(path):
+    directory_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+    directory = os.open('/', directory_flags)
+    try:
+        for part in path.parent.parts[1:]:
+            child = os.open(part, directory_flags, dir_fd=directory)
+            os.close(directory)
+            directory = child
+        yield directory
+    finally:
+        os.close(directory)
+
+
+def _read_workspace_file(path, limit, *, stamp=None):
+    try:
+        with _workspace_parent(path) as directory:
+            leaf = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
+            try:
+                info = os.fstat(leaf)
+                if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > limit:
+                    return None
+                if stamp and _pdf_stamp(info) != stamp:
+                    return None
+                with os.fdopen(leaf, 'rb', closefd=False) as stream:
+                    data = stream.read(limit + 1)
+                if stamp and (len(data) != info.st_size or _pdf_stamp(os.fstat(leaf)) != stamp):
+                    return None
+            finally:
+                os.close(leaf)
+        if len(data) <= limit:
+            return data
+    except (OSError, NotImplementedError):
+        return None
+    return None
diff --git a/gateway/session_bot_workflow.py b/gateway/session_bot_workflow.py
