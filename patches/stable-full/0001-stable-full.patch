diff --git a/apps/desktop/src/plugins/kanban/reviewed-usage-view.tsx b/apps/desktop/src/plugins/kanban/reviewed-usage-view.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b10cdaf785eaf1f47f3739ee8c8a238987a272f3
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/reviewed-usage-view.tsx
@@ -0,0 +1,214 @@
+import { Button, useQuery } from '@hermes/plugin-sdk'
+import { useCallback, useLayoutEffect, useRef, useState } from 'react'
+
+import { fetchReviewedUsage, fetchUsageRun, reviewedUsageKey, routedToScope } from './api'
+import type { ReviewedUsageEvidence } from './types'
+import { useKanban } from './ui'
+
+const format = new Intl.NumberFormat(undefined, { maximumSignificantDigits: 12 })
+
+function RunEvidence({ board, scope, evidence }: { board: string; scope: string; evidence: ReviewedUsageEvidence }) {
+  const u = useKanban().work.usage
+  const [open, setOpen] = useState(false)
+  const [retrying, setRetrying] = useState(false)
+  const toggleButton = useRef<HTMLButtonElement>(null)
+  const queryKey = ['kanban', 'reviewed-usage-run', scope, board, evidence.run_id] as const
+
+  const { data, isError, fetchStatus, refetch } = useQuery({
+    enabled: query => open && routedToScope(query),
+    queryFn: () => fetchUsageRun(evidence.run_id, board),
+    queryKey,
+    retry: false,
+    staleTime: Infinity
+  })
+  const run = data?.run.task_id === evidence.task_id ? data.run : undefined
+  const busy = retrying || fetchStatus !== 'idle'
+
+  const retry = async (button: HTMLButtonElement) => {
+    if (busy || !routedToScope({ queryKey })) return
+    setRetrying(true)
+    try {
+      const result = await refetch({ cancelRefetch: false })
+      if (result.isSuccess && routedToScope({ queryKey }) && button.ownerDocument.activeElement === button) {
+        toggleButton.current?.focus()
+      }
+    } finally {
+      setRetrying(false)
+    }
+  }
+
+  return (
+    <li>
+      <Button aria-expanded={open} onClick={() => setOpen(value => !value)} ref={toggleButton} size="sm" variant="ghost">
+        {u.run(evidence.run_id)}
+      </Button>
+      <small>{u.sources[evidence.source]}</small>
+      {open && (
+        <>
+          <p role="status">
+            {run
+              ? [run.profile, run.outcome || run.status, run.summary].filter(Boolean).join(' · ')
+              : busy
+                ? u.loading
+                : isError
+                  ? u.runLoadFailed
+                  : data
+                    ? u.missing
+                    : u.loading}
+          </p>
+          {(retrying || isError) && (
+            <Button
+              aria-busy={busy || undefined}
+              aria-disabled={busy || undefined}
+              className="aria-disabled:opacity-60"
+              onClick={event => void retry(event.currentTarget)}
+              size="sm"
+              variant="outline"
+            >
+              {u.retryRun(evidence.run_id)}
+            </Button>
+          )}
+        </>
+      )}
+    </li>
+  )
+}
+
+export function ReviewedUsageView({
+  board,
+  id,
+  review,
+  scope
+}: {
+  board: string
+  id: string
+  review: number
+  scope: string
+}) {
+  const u = useKanban().work.usage
+
+  const heading = useRef<HTMLHeadingElement>(null)
+  const retryOwnedFocus = useRef(false)
+  const rememberRetryFocus = useCallback((button: HTMLButtonElement | null) => {
+    if (!button) return
+
+    return () => {
+      retryOwnedFocus.current = button.ownerDocument.activeElement === button
+    }
+  }, [])
+  const [retryKey, setRetryKey] = useState<string | null>(null)
+  const queryKey = reviewedUsageKey(scope, board, id, review)
+  const key = JSON.stringify(queryKey)
+  const retrying = retryKey === key
+  const { data, isError, fetchStatus, refetch } = useQuery({
+    enabled: query => routedToScope(query),
+    queryFn: () => fetchReviewedUsage(id, board, review),
+    queryKey,
+    retry: false,
+    staleTime: 60_000,
+    refetchOnWindowFocus: false,
+    refetchOnReconnect: false
+  })
+  useLayoutEffect(() => {
+    const title = heading.current
+    const restore = retryOwnedFocus.current
+    retryOwnedFocus.current = false
+    if (!restore || !title || !routedToScope({ queryKey })) return
+
+    const doc = title.ownerDocument
+    if (doc.activeElement === doc.body) title.focus()
+  })
+
+  const busy = retrying || fetchStatus !== 'idle'
+  const retry = async () => {
+    if (busy || !routedToScope({ queryKey })) return
+    setRetryKey(key)
+
+    try {
+      await refetch({ cancelRefetch: false })
+    } finally {
+      setRetryKey(current => current === key ? null : current)
+    }
+  }
+
+  const hasLinkedThink = data?.usage?.stages.some(
+    stage => stage.stage === 'think' && stage.runs.some(run => run.source !== 'unavailable')
+  )
+
+  const amount = (value: number | null) => (value === null ? u.missing : format.format(value))
+
+  return (
+    <section aria-label={u.title} className="kanban-reviewed-usage">
+      <h3 ref={heading} tabIndex={-1}>{u.title}</h3>
+      {!data?.usage && (
+        <p role="status">{busy ? u.loading : isError ? u.loadFailed : data ? u.unavailable : u.loading}</p>
+      )}
+      {data?.usage && isError && <p role="status">{u.refreshFailed}</p>}
+      {(retrying || isError) && (
+        <Button
+          aria-disabled={busy || undefined}
+          className="kanban-usage-retry mt-2 aria-disabled:opacity-60"
+          key={key}
+          onClick={() => void retry()}
+          ref={rememberRetryFocus}
+          size="sm"
+          variant="outline"
+        >
+          {u.retry}
+        </Button>
+      )}
+      {data?.usage && (
+        <>
+          <p>{u.partial}</p>
+          <p>
+            <small>{u.help}</small>
+          </p>
+          {hasLinkedThink && <p className="font-medium">{u.sharedThink}</p>}
+          <div aria-label={u.table} className="kanban-usage-table" role="region" tabIndex={0}>
+            <table>
+              <thead>
+                <tr>
+                  <th scope="col">{u.stage}</th>
+                  <th scope="col">{u.calls}</th>
+                  <th scope="col">{u.input}</th>
+                  <th scope="col">{u.output}</th>
+                  <th scope="col">{u.cost}</th>
+                  <th scope="col">{u.evidence}</th>
+                </tr>
+              </thead>
+              <tbody>
+                {data.usage.stages.map(stage => (
+                  <tr key={stage.stage}>
+                    <th scope="row">{u.stages[stage.stage]}</th>
+                    <td>{amount(stage.api_calls)}</td>
+                    <td>{amount(stage.input_tokens)}</td>
+                    <td>{amount(stage.output_tokens)}</td>
+                    <td>{amount(stage.provider_reported_usd)}</td>
+                    <td>
+                      {stage.runs.length ? (
+                        <ul>
+                          {stage.runs.map(run => (
+                            <RunEvidence
+                              board={board}
+                              evidence={run}
+                              key={JSON.stringify([scope, board, run.task_id, run.run_id])}
+                              scope={scope}
+                            />
+                          ))}
+                        </ul>
+                      ) : (
+                        u.missing
+                      )}
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          {data.usage.limited && <p>{u.limited}</p>}
+          {data.usage.unclassified_runs > 0 && <p>{u.unclassified(data.usage.unclassified_runs)}</p>}
+        </>
+      )}
+    </section>
+  )
+}
