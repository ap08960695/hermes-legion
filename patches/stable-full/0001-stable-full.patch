+"""Bounded, read-only reports from one authorized Bot Chat's preferred compression chain."""
+from contextlib import nullcontext
+import json
+import math
+from pathlib import Path
+import sqlite3
+
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+
+_REPORT_LIMIT = 20
+_STATUS = {
+    'ok': 'completed', 'success': 'completed', 'completed': 'completed',
+    'error': 'error', 'failed': 'error', 'failure': 'error', 'timeout': 'error',
+    'interrupted': 'interrupted', 'stalled': 'stalled', 'unknown': 'unknown',
+}
+
+
+def _object(raw):
+    try:
+        value = json.loads(raw) if raw is not None else None
+    except (ValueError, RecursionError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def _text(value, limit):
+    if not isinstance(value, str):
+        return ''
+    from tools.delegation_redaction import redact_child_text
+
+    return redact_child_text(value).strip()[:limit]
+
+
+def _task_goals(task):
+    goals = task.get('goals')
+    if not isinstance(goals, list):
+        return {0: task.get('goal')}
+    indexes = task.get('task_indexes')
+    indexes = list(range(len(goals))) if indexes is None else indexes
+    if (not isinstance(indexes, list) or len(indexes) != len(goals)
+            or any(type(index) is not int or index < 0 for index in indexes)
+            or len(set(indexes)) != len(indexes)):
+        return {}
+    return dict(zip(indexes, goals))
+
+
+def _task_reports(row):
+    from tools.delegation_redaction import redact_child_result
+
+    task, result = _object(row['task_json']) or {}, _object(row['result_json'])
+    cleaned = redact_child_result(result) if result is not None else {}
+    batch = bool(task.get('is_batch')) or isinstance(cleaned.get('results'), list)
+    entries = cleaned.get('results') if batch else [cleaned]
+    entries = entries if isinstance(entries, list) and entries else [None]
+    goals = _task_goals(task)
+    completed = row['completed_at']
+    completed = (float(completed) if type(completed) in (int, float)
+                 and math.isfinite(completed) and completed >= 0 else None)
+    for entry in entries[:_REPORT_LIMIT]:
+        entry = entry if isinstance(entry, dict) else {}
+        index = entry.get('task_index', None if batch else 0)
+        index = index if type(index) is int and index >= 0 else None
+        fallback = ('unknown' if batch and entry else
+                    row['state'] if entry or row['state'] not in ('completed', 'success', 'ok') else 'unknown')
+        status = _STATUS.get(str(entry.get('status') or fallback).strip().lower(), 'unknown')
+        yield {'delegation_id': row['delegation_id'], 'task_index': index, 'status': status,
+               'completed_at': completed, 'goal': _text(goals.get(index), 256),
+               'summary': _text(entry.get('summary'), 2048), 'error': _text(entry.get('error'), 512)}
+
+
+def canonical_delegation_reports(db, chain, *, conn=None):
+    """Unavailable reads omit the field; an empty readable snapshot is not proof of no failures."""
+    if not chain:
+        return {}
+    placeholders = ','.join('?' for _ in chain)
+    try:
+        with (nullcontext(conn) if conn is not None else db._read_ctx(reopen=False)) as reader:
+            rows = reader.execute(
+                "SELECT substr(delegation_id,1,512) AS delegation_id,state,completed_at,"
+                "CASE WHEN length(task_json)<=16384 THEN task_json END AS task_json,"
+                "CASE WHEN length(result_json)<=65536 THEN result_json END AS result_json "
+                f"FROM async_delegations WHERE parent_session_id IN ({placeholders}) "
+                "AND state NOT IN ('running','finalizing') AND completed_at IS NOT NULL "
+                "ORDER BY completed_at DESC,delegation_id DESC LIMIT 20", chain).fetchall()
+    except sqlite3.Error:
+        return {}
+    if not rows:
+        return {'delegation_reports': []}
+    # Vault values belong to this store's home, not the roster caller's launch profile.
+    token = set_hermes_home_override(Path(db.db_path).absolute().parent)
+    try:
+        reports = []
+        for row in rows:
+            for report in _task_reports(row):
+                reports.append(report)
+                if len(reports) == _REPORT_LIMIT:
+                    return {'delegation_reports': reports}
+        return {'delegation_reports': reports}
+    finally:
+        reset_hermes_home_override(token)
