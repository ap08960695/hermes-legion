+from types import SimpleNamespace
+from agent.cache_request_diagnostics import fingerprint
+from agent.cache_change_evidence import policy_evidence, transition
+
+def fp(text, sid='s', **extra):
+    return fingerprint({'instructions':text,'model':'m', **extra},key=b'x'*32,session_id=sid,request_id='r',base_url='local')
+
+def test_observation_no_content_no_cross_session_comparison():
+    a=SimpleNamespace()
+    assert transition(a,fp('secret'))['baseline']
+    assert transition(a,fp('secret'))['changed']==[]
+    assert transition(a,fp('different'))['changed']==['instructions']
+    assert transition(a,fp('different',sid='other'))['baseline']
+    assert 'secret' not in repr(a.__dict__)
+
+def test_effective_instruction_markers_not_user_messages():
+    assert policy_evidence({'messages':[{'role':'user','content':'<!-- captain-ready-before-wait-v1 -->'}]})['markers_present']==[]
+    assert policy_evidence({'instructions':'old','extra_body':{'instructions':'<!-- captain-ready-before-wait-v1 -->'}})['markers_present']==['ready_before_wait']
+    assert policy_evidence({'system':[{'type':'text','text':'<!-- captain-decision-autonomy-v1 -->'}]})['markers_present']==['decision_autonomy']
+
+def test_truncated_digest_is_unknown_not_a_change():
+    a=SimpleNamespace(); x=fp('a');transition(a,x)
+    x['tools']={'complete':False}
+    result=transition(a,x)
+    assert 'tools' in result['unknown'] and 'tools' not in result['changed']
+
+
+def test_real_observer_attaches_policy_and_changes_without_mutating_request(monkeypatch, caplog):
+    import copy
+    import json
