+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+const io = vi.hoisted(() => ({ read:vi.fn(async(_id:string)=>{}), saved:[] as Array<() => unknown> }))
+vi.mock('@/store/session-control', async original => ({...(await original<object>()), refreshSessionControl:io.read}))
+vi.mock('../chat/composer/status-stack/session-control', () => ({SessionControlSections:({onSubmit,sessionId}: any) => <button onClick={()=>io.saved.push(()=>onSubmit('continue', {sessionId:'wrong-focus'}))}>Capture {sessionId}</button>}))
+import { $sessionControlBySession } from '@/store/session-control'
+import { ContribWiringContext } from '../contrib/context'
+import { FocusControlPanel } from './control-panel'
+afterEach(()=>{cleanup();$sessionControlBySession.set({});vi.clearAllMocks();io.saved=[]})
+it('a delayed native submit remains bound to the original chat after focus changes', async () => {
+ const submit=vi.fn(async()=>true)
+ const entry={snapshot:{goal:null,loop:null,heartbeat:null,revision:'x',updated_at:1},pendingAction:null,error:null}
+ $sessionControlBySession.set({first:entry,second:entry} as never)
+ const wrap=(id:string)=><ContribWiringContext.Provider value={{actions:{onSubmit:submit}} as never}><FocusControlPanel sessionId={id}/></ContribWiringContext.Provider>
+ const view=render(wrap('first'))
+ fireEvent.click(screen.getByRole('button',{name:'Capture first'}))
+ view.rerender(wrap('second'))
+ await io.saved[0]()
+ expect(submit).toHaveBeenCalledWith('continue',{sessionId:'first'})
+ expect(io.read.mock.calls.map(x=>x[0])).toEqual(['first','second'])
+ expect(submit).toHaveBeenCalledTimes(1)
+})
+it('failed hydration stays unknown rather than claiming there are no configured controls',()=>{
+ $sessionControlBySession.set({missing:{snapshot:null,error:'Offline',pendingAction:null}} as never)
+ render(<FocusControlPanel sessionId="missing"/>)
+ expect(screen.getByText('Not reported')).toBeTruthy()
+ expect(screen.queryByText('No goal, loop or heartbeat configured for this chat.')).toBeNull()
+})
