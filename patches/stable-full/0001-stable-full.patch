@@ -0,0 +1,61 @@
+"""A plugin dependency generation belongs to the interpreter's native platform."""
+from pathlib import Path
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tomllib
+
+from packaging.markers import Marker, default_environment
+from packaging.tags import sys_tags
+
+from pm import workspace
+from pm.environment import PythonEnvironment
+from tests.pm._fixtures import _wheel
+
+
+def test_native_plugin_wheel_is_not_rejected_for_an_uninstalled_platform(tmp_path):
+    """Exercise real offline resolution: a foreign core fork must not constrain a native plugin."""
+    wheels = tmp_path / 'wheels'
+    wheels.mkdir()
+    tag = str(next(sys_tags()))
+    metadata = 'native_dep-1.0.dist-info/WHEEL'
+    wheel = _wheel(wheels, 'native_dep', extra={metadata:
+        f'Wheel-Version: 1.0\nRoot-Is-Purelib: false\nTag: {tag}\n'})
+    wheel.rename(wheels / f'native_dep-1.0-{tag}.whl')
+    # No distribution exists for this foreign-only branch. It must never be
+    # resolved by a native installation's private plugin generation.
+    native = default_environment()
+    foreign = 'android' if native['sys_platform'] != 'android' else 'darwin'
+    source = tmp_path / 'core'
+    source.mkdir()
+    manifest = source / 'pyproject.toml'
+    manifest.write_text(
+        '[project]\nname="native-core"\nversion="1"\nrequires-python=">=3.14,<3.15"\n'
+        f'dependencies=["foreign-branch==1.0; sys_platform == \'{foreign}\'"]\n'
+        '[tool.uv]\npackage=false\nno-index=true\nenvironments=["python_version >= \'3.14\'"]\n'
+        f'find-links=[{json.dumps(wheels.as_posix())}]\n')
+    plugin = tmp_path / 'plugin'
+    plugin.mkdir()
+    declaration = plugin / 'plugin.yaml'
+    declaration.write_text('name: native-plugin\npython_dependencies: ["native-dep==1.0"]\n')
+    original = manifest.read_bytes(), declaration.read_bytes()
+    uv = shutil.which('uv')
+    assert uv, 'The canonical test environment must supply the PM toolchain'
+    env = PythonEnvironment(uv=Path(uv), python=Path(sys.executable), destination=tmp_path / 'venv',
+                            cache=tmp_path / 'cache', env=dict(os.environ), offline=True)
+    generated = tmp_path / 'generated'
+    workspace.lock_and_sync([plugin], [], root=generated, source=source, seed_lock=None, environment=env)
+    python = tmp_path / 'venv' / ('Scripts/python.exe' if sys.platform == 'win32' else 'bin/python')
+    probe = subprocess.run([str(python), '-c', 'import native_dep; print(native_dep.__version__)'],
+                           capture_output=True, text=True, check=True, timeout=30)
+    assert probe.stdout.strip() == '1.0'
+    policy = tomllib.loads((generated / 'pyproject.toml').read_text())['tool']['uv']['environments']
+    for clause in policy:
+        marker = Marker(clause)
+        assert marker.evaluate(native)
+        assert not marker.evaluate({**native, 'sys_platform': foreign})
+        assert not marker.evaluate({**native, 'python_version': '3.13'})
+    assert (manifest.read_bytes(), declaration.read_bytes()) == original
+    assert not (source / 'uv.lock').exists()
