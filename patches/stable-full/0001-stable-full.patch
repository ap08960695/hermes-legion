index 0000000000000000000000000000000000000000..b6860dc6c555647a7921fdce81574f69e2b9e549
--- /dev/null
+++ b/apps/desktop/src/app/settings/account-usage-panel.test.tsx
@@ -0,0 +1,159 @@
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { act, cleanup, fireEvent, render, waitFor, within } from '@testing-library/react'
+import { atom, type WritableAtom } from 'nanostores'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+import { I18nProvider } from '@/i18n'
+
+const request = vi.hoisted(() => vi.fn())
+vi.mock('@/store/gateway', () => ({ requestGatewayForAgent: (...args: unknown[]) => request(...args) }))
+vi.mock('@/store/connections', () => ({ $activeConnectionId: atom<string | null>('local') }))
+vi.mock('@/store/settings-scope', () => ({ $settingsScopeProfile: atom('captain') }))
+
+import { $activeConnectionId } from '@/store/connections'
+import { $settingsScopeProfile } from '@/store/settings-scope'
+
+import { AccountUsagePanel } from './account-usage-panel'
+
+const reading = (label: string, provider = 'anthropic', remaining = 65) => ({
+  provider,
+  id: label,
+  label,
+  state: 'ready',
+  stale: false,
+  fetched_at: new Date().toISOString(),
+  windows: [
+    { label: 'Weekly', remaining_percent: remaining, used_percent: 100 - remaining, resets_at: null, scope: 'account' }
+  ]
+})
+
+function mount() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+
+  const view = render(
+    <QueryClientProvider client={client}>
+      <I18nProvider configClient={null} initialLocale="en">
+        <AccountUsagePanel />
+      </I18nProvider>
+    </QueryClientProvider>
+  )
+
+  return { ...view, client }
+}
+
+beforeEach(() => {
+  request.mockReset()
+  ;($activeConnectionId as WritableAtom<string | null>).set('local')
+  ;($settingsScopeProfile as WritableAtom<string>).set('captain')
+})
+afterEach(cleanup)
+
+it('reads cached per-account data on entry, exposes all providers and only probes on Refresh', async () => {
+  request.mockResolvedValue({
+    accounts: [
+      reading('First'),
+      reading('Second', 'anthropic', 5),
+      reading('Codex login', 'openai-codex', 20),
+      {
+        ...reading('AGY login', 'antigravity-subscription-directsdk'),
+        windows: [],
+        state: 'unknown',
+        reason: 'Credential expired'
+      }
+    ]
+  })
+  const f = mount()
+  await f.findByText('First')
+  expect(request).toHaveBeenCalledExactlyOnceWith(
+    'local',
+    'captain',
+    'account.usage',
+    { profile: 'captain', refresh: false },
+    30000,
+    undefined,
+    { spawnPriority: 'foreground' }
+  )
+  expect(
+    within(f.getByRole('region', { name: 'Claude' }))
+      .getAllByRole('progressbar')
+      .map(el => el.getAttribute('aria-valuenow'))
+  ).toEqual(['65', '5'])
+  expect(
+    within(f.getByRole('region', { name: 'Codex' }))
+      .getByRole('progressbar')
+      .getAttribute('aria-valuenow')
+  ).toBe('20')
+  expect(within(f.getByRole('region', { name: 'AGY' })).queryByRole('progressbar')).toBeNull()
+  fireEvent.focus(window)
+  expect(request).toHaveBeenCalledTimes(1)
+  fireEvent.click(f.getByRole('button', { name: 'Refresh' }))
+  await waitFor(() => expect(request).toHaveBeenCalledTimes(2))
+  expect(request.mock.calls[1]?.[3]).toEqual({ profile: 'captain', refresh: true })
+})
+
+it('never renders expired percentages as current quota', async () => {
+  request.mockResolvedValue({
+    accounts: [{ ...reading('Old'), fetched_at: new Date(Date.now() - 901000).toISOString() }]
+  })
+  const f = mount()
+  await f.findByText('Stale reading')
+  expect(f.queryByRole('progressbar')).toBeNull()
+  expect(f.queryByText('Remaining: 65%')).toBeNull()
+})
+
+it('fences a late refresh by both connection and owning profile', async () => {
+  let resolve!: (value: unknown) => void
+  request.mockResolvedValue({ accounts: [reading('Captain')] })
+  const f = mount()
+  await f.findByText('Captain')
+  request.mockImplementationOnce(
+    () =>
+      new Promise(r => {
+        resolve = r
+      })
+  )
+  fireEvent.click(f.getByRole('button', { name: 'Refresh' }))
+  request.mockResolvedValue({ accounts: [reading('Other profile')] })
+  await waitFor(() => expect(request).toHaveBeenCalledTimes(2))
+  act(() => {
+    ;($settingsScopeProfile as WritableAtom<string>).set('worker')
+    ;($activeConnectionId as WritableAtom<string | null>).set('remote')
+  })
+  await f.findByText('Other profile')
+  await act(async () => resolve({ accounts: [reading('Late captain')] }))
+  expect(f.queryByText('Late captain')).toBeNull()
+  expect(request.mock.calls.at(-1)?.slice(0, 2)).toEqual(['remote', 'worker'])
+})
+
+it('keeps a failed request retryable without exposing server error payloads', async () => {
+  request.mockRejectedValue(new Error('private-error-detail'))
+  const f = mount()
+  await f.findByRole('alert')
+  expect(f.queryByText(/private-error/)).toBeNull()
+  request.mockResolvedValue({ accounts: [reading('Recovered')] })
+  fireEvent.click(f.getByRole('button', { name: 'Refresh' }))
+  await f.findByText('Recovered')
+})
+
+it('treats a reading fetched after mount as fresh immediately', async () => {
+  const clock = vi.spyOn(Date, 'now').mockReturnValue(100000)
+  let resolve!: (value: unknown) => void
+  request.mockImplementationOnce(
+    () =>
+      new Promise(r => {
+        resolve = r
+      })
+  )
+  const f = mount()
+
+  try {
+    clock.mockReturnValue(101000)
+    await act(async () =>
+      resolve({ accounts: [{ ...reading('New reading'), fetched_at: new Date(101000).toISOString() }] })
+    )
+    await f.findByRole('progressbar')
+    expect(f.queryByText('Stale reading')).toBeNull()
+  } finally {
+    clock.mockRestore()
+  }
+})
diff --git a/apps/desktop/src/app/settings/account-usage-panel.tsx b/apps/desktop/src/app/settings/account-usage-panel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1414effea6c441cf135fc6528fb16f7b31188c9c
--- /dev/null
+++ b/apps/desktop/src/app/settings/account-usage-panel.tsx
@@ -0,0 +1,227 @@
+import type { AccountUsageResult, AccountUsageRow } from '@hermes/shared'
+import { useStore } from '@nanostores/react'
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
+import { type ReactNode, useEffect, useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { Progress } from '@/components/ui/progress'
+import { Skeleton } from '@/components/ui/skeleton'
+import { Tip } from '@/components/ui/tooltip'
+import { useI18n } from '@/i18n'
+import { BarChart3, RefreshCw } from '@/lib/icons'
+import { fmtFullDateTime, formatAgo, relativeTime } from '@/lib/time'
+import { cn } from '@/lib/utils'
+import { $activeConnectionId } from '@/store/connections'
+import { requestGatewayForAgent } from '@/store/gateway'
+import { $settingsScopeProfile } from '@/store/settings-scope'
+
+import { Pill } from './primitives'
+
+const PROVIDERS = [
+  ['anthropic', 'Claude'],
+  ['openai-codex', 'Codex'],
+  ['agy', 'AGY']
+] as const
+
+const MAX_AGE_MS = 15 * 60 * 1000
+
+function readingIsStale(row: AccountUsageRow, now: number) {
+  const age = now - Date.parse(row.fetched_at ?? '')
+
+  return row.stale || !Number.isFinite(age) || age < 0 || age > MAX_AGE_MS
+}
+
+interface AccountReadingProps {
+  row: AccountUsageRow
+  now: number
+}
+
+function AccountReading({ row, now }: AccountReadingProps) {
+  const { t } = useI18n()
+  const copy = t.settings.providers.usage
+  const stale = readingIsStale(row, now)
+  const known = !stale && row.windows.length > 0
+  const updated = Date.parse(row.fetched_at ?? '')
+
+  return (
+    <div className="min-w-0 space-y-3 py-4" data-account-id={row.id}>
+      <div className="flex flex-wrap items-center justify-between gap-2">
+        <span className="break-all text-xs font-medium text-(--ui-text-secondary)">{row.label}</span>
+        {!known && <Pill tone="warn">{stale && row.fetched_at ? copy.stale : copy.unavailable}</Pill>}
+      </div>
+      {known
+        ? row.windows.map((window, index) => {
+            const reset = Date.parse(window.resets_at ?? '')
+            const low = window.remaining_percent <= 10
+
+            return (
+              <div className="space-y-2" key={`${window.label}:${index}`}>
+                <div className="flex items-end justify-between gap-3">
+                  <span className="min-w-0 text-xs leading-5 text-(--ui-text-secondary)">{window.label}</span>
+                  <span
+                    aria-label={`${copy.remaining}: ${window.remaining_percent}%`}
+                    className={cn(
+                      'shrink-0 text-2xl leading-none font-medium tracking-tight tabular-nums',
+                      low && 'text-destructive'
+                    )}
+                  >
+                    {window.remaining_percent}
+                    <span className="ml-0.5 text-sm text-muted-foreground">%</span>
+                  </span>
+                </div>
+                <Progress
+                  aria-label={`${row.label} · ${window.label} · ${copy.remaining}`}
+                  className={window.remaining_percent === 0 ? 'bg-destructive/10' : undefined}
+                  destructive={low}
+                  size="sm"
+                  value={window.remaining_percent / 100}
+                />
+                {Number.isFinite(reset) && (
+                  <p className="text-[0.6875rem] leading-4 text-muted-foreground">
+                    {copy.resets}{' '}
+                    <Tip label={fmtFullDateTime.format(reset)}>
+                      <time
+                        className="decoration-dotted underline-offset-2 hover:underline"
+                        dateTime={window.resets_at!}
+                        tabIndex={0}
+                      >
+                        {relativeTime(reset, now)}
+                      </time>
+                    </Tip>
+                  </p>
+                )}
+              </div>
+            )
+          })
+        : row.reason && <p className="break-words text-xs leading-relaxed text-muted-foreground">{row.reason}</p>}
+      {Number.isFinite(updated) && (
+        <p className="text-[0.6875rem] leading-4 text-muted-foreground">
+          {copy.updated}{' '}
+          <Tip label={fmtFullDateTime.format(updated)}>
+            <time
+              className="decoration-dotted underline-offset-2 hover:underline"
+              dateTime={row.fetched_at!}
+              tabIndex={0}
+            >
+              {formatAgo(updated, t.agents, now)}
+            </time>
+          </Tip>
+        </p>
+      )}
+    </div>
+  )
+}
+
+export interface ScopedAccountUsageProps {
+  connectionId: string | null
+  profile: string
+  profileControl?: ReactNode
+}
+
+export function ScopedAccountUsage({ connectionId, profile, profileControl }: ScopedAccountUsageProps) {
+  const { t } = useI18n()
+  const copy = t.settings.providers.usage
+  const client = useQueryClient()
+  const [now, setNow] = useState(Date.now)
+
+  // Age visible readings locally; this timer never fetches quotas or invokes a model.
+  useEffect(() => {
+    const timer = window.setInterval(() => setNow(Date.now()), 30000)
+
+    return () => window.clearInterval(timer)
+  }, [])
+  const queryKey = ['account-usage', connectionId, profile]
+
+  const request = (refresh: boolean) =>
+    requestGatewayForAgent<AccountUsageResult>(
+      connectionId,
+      profile,
+      'account.usage',
+      { profile, refresh },
+      30000,
+      undefined,
+      { spawnPriority: 'foreground' }
+    )
+
+  const query = useQuery({
+    queryKey,
+    queryFn: () => request(false),
+    refetchOnWindowFocus: false,
+    refetchOnReconnect: false,
+    retry: false
+  })
+
+  const refresh = useMutation({
+    mutationFn: () => request(true),
+    onSuccess: result => client.setQueryData(queryKey, result)
+  })
+
+  return (
+    <section className="@container">
+      <header className="mb-5 flex flex-wrap items-center justify-between gap-3">
+        <div className="flex items-center gap-2">
+          <BarChart3 className="size-4 text-muted-foreground" />
+          <h2 className="text-sm font-semibold">{copy.title}</h2>
+        </div>
+        <div className="flex items-center gap-2">
+          {profileControl}
+          <Button
+            disabled={query.isFetching || refresh.isPending}
+            onClick={() => refresh.mutate()}
+            size="sm"
+            variant="ghost"
+          >
+            <RefreshCw className={refresh.isPending ? 'animate-spin' : undefined} />
+            {refresh.isPending ? copy.refreshing : copy.refresh}
+          </Button>
+        </div>
+      </header>
+      {(query.isError || refresh.isError) && (
+        <p className="py-2 text-sm text-destructive" role="alert">
+          {copy.loadFailed}
+        </p>
+      )}
+      {query.isPending ? (
+        <Skeleton className="h-24 w-full" />
+      ) : (
+        <div className="grid gap-x-8 gap-y-5 @min-[38rem]:grid-cols-3">
+          {PROVIDERS.map(([slug, name]) => {
+            const rows =
+              query.data?.accounts.filter(
+                row =>
+                  row.provider === slug || (slug === 'agy' && row.provider === 'antigravity-subscription-directsdk')
+              ) ?? []
+
+            return (
+              <section aria-label={name} className="min-w-0" key={slug}>
+                <div className="flex items-baseline justify-between gap-2">
+                  <h3 className="text-base font-semibold tracking-tight">{name}</h3>
+                  <span className="text-[0.6875rem] text-muted-foreground">{copy.remaining}</span>
+                </div>
+                <div className="divide-y divide-border">
+                  {rows.length ? (
+                    rows.map(row => <AccountReading key={row.id} now={Math.max(now, query.dataUpdatedAt)} row={row} />)
+                  ) : (
+                    <p className="py-3 text-xs text-muted-foreground">{copy.noAccounts}</p>
+                  )}
+                </div>
+              </section>
+            )
+          })}
+        </div>
+      )}
+      <p className="mt-1 border-t border-border pt-3 text-[0.6875rem] leading-relaxed text-muted-foreground">
+        {copy.description}
+      </p>
+    </section>
+  )
+}
+
+export function AccountUsagePanel() {
+  const profile = useStore($settingsScopeProfile)
+  const connectionId = useStore($activeConnectionId)
+
+  return (
+    <ScopedAccountUsage connectionId={connectionId} key={JSON.stringify([connectionId, profile])} profile={profile} />
+  )
+}
