+@pytest.mark.platforms("linux", "macos")
+@pytest.mark.parametrize("claim_owner", [False, True])
+def test_root_launch_admission_survives_ensure_timeout(tmp_path, monkeypatch, claim_owner):
+    import select
+    from hermes_cli import gateway_runtime as runtime, gateway_runtime_discovery as discovery
+    from hermes_cli import gateway_runtime_service as service, gateway_runtime_start as start
+
+    root = tmp_path / ".hermes"
+    named = root / "profiles" / "alpha"
+    named.mkdir(parents=True, mode=0o700)
+    (root / "config.yaml").write_text("gateway: {multiplex_profiles: true}\n", encoding="utf-8")
+    monkeypatch.setattr(service, "discover_existing_gateway_service", lambda *a, **k: None)
+    children = []
+    raw_popen = subprocess.Popen
+    child_code = """
+import os
+import sys
+from pathlib import Path
+from hermes_cli.gateway_launch_admission import LAUNCH_FD_ENV, adopt_gateway_launch, release_gateway_launch
+from gateway.runtime_ownership import ProfileOwnership
+fd = int(os.environ[LAUNCH_FD_ENV])
+adopt_gateway_launch()
+assert LAUNCH_FD_ENV not in os.environ and not os.get_inheritable(fd)
+if sys.stdin.readline().strip() == "claim":
+    owner = ProfileOwnership()
+    owner.reserve([Path(sys.argv[1])])
+    release_gateway_launch()
+    print("claimed", flush=True)
+    sys.stdin.readline()
+    owner.close()
+"""
+
+    def spawn(command, **kwargs):
+        if "hermes_cli.main" not in command:
+            return raw_popen(command, **kwargs)
+        assert kwargs["env"]["HERMES_HOME"] == str(root)
+        # Without the admission implementation the baseline stub still blocks,
+        # so its failure comes from a duplicate launch.
+        code = child_code if kwargs.get("pass_fds") else "import sys; sys.stdin.readline()"
+        kwargs.update(stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
+        proc = raw_popen([sys.executable, "-c", code, str(root)], **kwargs)
+        children.append(proc)
+        return proc
+
+    monkeypatch.setattr(start.subprocess, "Popen", spawn)
+    try:
+        assert runtime.ensure_gateway_runtime(root, timeout=0.4).reason_code == "deadline"
+        child = children[0]
+        assert child.poll() is None
+        assert runtime.ensure_gateway_runtime(named, timeout=0.4).reason_code == "deadline"
+        assert children == [child]
+        if not claim_owner:
+            child.stdin.close()
+            assert child.wait(timeout=5) == 0
+            assert runtime.ensure_gateway_runtime(named, timeout=0.4).reason_code == "deadline"
+            assert len(children) == 2
+            return
+
+        child.stdin.write("claim\n")
+        child.stdin.flush()
+        assert select.select([child.stdout], [], [], 5)[0]
+        assert child.stdout.readline().strip() == "claimed"
+        from hermes_cli.gateway_launch_admission import gateway_launch_admission
+        with gateway_launch_admission(root) as fds:
+            assert fds  # Launch lock is free while the live child holds gateway.lock.
+        assert discovery.missing_owner_state(root) == "starting"
+
+        def identify(path, *, timeout):
+            if path == named:
+                raise FileNotFoundError
+            return {"runtime_protocol": 1, "state": "ready", "instance_id": "owner",
+                    "served_profiles": [{"home": str(named), "profile_id": "alpha"}],
+                    "authority_epoch": 1, "api_origin": "http://127.0.0.1:4321", "supervisor": "none",
+                    "capabilities": ["session-authority-v1"]}
+
+        monkeypatch.setattr(discovery, "query_identify", identify)
+        result = runtime.ensure_gateway_runtime(named, timeout=0.5)
+        assert result.state == "ready" and result.endpoint.instance_id == "owner"
+        assert children == [child]
+    finally:
+        for proc in children:
+            if proc.poll() is None:
+                proc.kill()
+            proc.wait(timeout=5)
+            proc.stdin.close()
+            proc.stdout.close()
+
