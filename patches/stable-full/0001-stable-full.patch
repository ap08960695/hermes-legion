+import { draftOwnerKey, OWNED_DRAFT_STORAGE_PREFIX, parseOwnedDraftKey } from './composer-draft-owner'
+import { type ComposerDraftRetry, draftRetry, readDraftRetry, writeDraftRetry } from './composer-draft-retry'
+import type { SessionOwnerScope } from './session-request-router'
+
+const PREFIX = '__new__:retained-send:'
+const ATTACHMENTS_ONLY = '\u0001'
+
+interface RetainedSendMeta {
+  parked?: true
+  labels?: string[]
+  attachmentsOnly?: true
+}
+
+type DraftContents = { text: string; attachments: ComposerAttachment[] }
+export const $retainedSendScopes = atom<Record<string, { scope: string }[]>>({})
+export const retainedSendGroup = (origin: string | null, owner: SessionOwnerScope) =>
+  JSON.stringify([draftOwnerKey(owner) ?? null, origin || freshDraftScope()])
+
+interface RetainedSendScope {
+  origin: string
+  id: string
+  retry: boolean
+  attachmentCount: number
+  meta?: RetainedSendMeta
+}
+export interface RetainedSend extends RetainedSendScope {
+  scope: string
+  text: string
+  attachments: ComposerAttachment[]
+}
+
+function parse(scope: string): RetainedSendScope | undefined {
+  if (!scope.startsWith(PREFIX)) {
+    return undefined
+  }
+
+  try {
+    const value: unknown = JSON.parse(scope.slice(PREFIX.length))
+
+    if (
+      !Array.isArray(value) ||
+      (value.length !== 4 && value.length !== 5) ||
+      typeof value[0] !== 'string' ||
+      typeof value[1] !== 'string' ||
+      typeof value[2] !== 'boolean' ||
+      !Number.isSafeInteger(value[3]) ||
+      value[3] < 0
+    ) {
+      return undefined
+    }
+
+    const meta = value[4]
+    if (
+      meta !== undefined &&
+      (!meta ||
+        typeof meta !== 'object' ||
+        Array.isArray(meta) ||
+        (meta.parked !== undefined && meta.parked !== true) ||
+        (meta.attachmentsOnly !== undefined && meta.attachmentsOnly !== true) ||
+        (meta.labels !== undefined &&
+          (!Array.isArray(meta.labels) || !meta.labels.every((label: unknown) => typeof label === 'string'))))
+    ) {
+      return undefined
+    }
+
+    return { origin: value[0], id: value[1], retry: value[2], attachmentCount: value[3], meta }
+  } catch {
+    return undefined
+  }
+}
+
+function retainedScope({ origin, id, retry, attachmentCount, meta }: RetainedSendScope): string {
+  return (
+    PREFIX + JSON.stringify(meta ? [origin, id, retry, attachmentCount, meta] : [origin, id, retry, attachmentCount])
+  )
+}
+
+function snapshotMeta(text: string, attachments: ComposerAttachment[], parked = false): RetainedSendMeta {
+  return {
+    ...(parked ? { parked: true } : {}),
+    ...(attachments.length ? { labels: attachments.map(file => file.label.slice(0, 200)) } : {}),
+    ...(!text.trim() && attachments.length ? { attachmentsOnly: true } : {})
+  }
+}
+
+function retainedText(text: string, meta?: RetainedSendMeta): string {
+  return meta?.attachmentsOnly ? ATTACHMENTS_ONLY : text
+}
+
+/** Uses the existing owner-isolated, bounded draft store, never an automatic outbox. */
+export function retainRejectedDraft(
+  origin: string,
+  text: string,
+  attachments: ComposerAttachment[],
+  owner: SessionOwnerScope,
+  submissionId?: string
+): boolean {
+  const meta = attachments.length ? snapshotMeta(text, attachments) : undefined
+  const scope = retainedScope({
+    origin,
+    id: submissionId ?? crypto.randomUUID(),
+    retry: Boolean(submissionId),
+    attachmentCount: attachments.length,
+    meta
+  })
+
+  const saved = stashSessionDraft(scope, retainedText(text, meta), attachments, owner, origin)
+  refresh(scope, owner)
+
