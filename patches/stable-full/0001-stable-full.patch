new file mode 100644
index 0000000000000000000000000000000000000000..908b3c6e85eba4d7db5b8de967c328c288c57d3d
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/reconnect-focus.ts
@@ -0,0 +1,136 @@
+import { useLayoutEffect } from 'react'
+
+import { isElementInHiddenPane } from '@/components/pane-shell/pane-visibility'
+import { isReadOnlyRuntimeId } from '@/store/read-only-transcript'
+import { $sessionTiles, type SessionTile } from '@/store/session-states'
+
+import { $floatingComposerOwner } from './floating-state'
+import { claimFloatingComposer } from './floating-target'
+import { EDIT_COMPOSER_ROOT } from './focus'
+import { composerPlainText, placeSelectionAtOffsets, RICH_INPUT_SLOT, selectionOffsetsInEditor } from './rich-editor'
+
+interface PendingFocus {
+  target: string
+  cancel: AbortController
+  from: NonNullable<SessionTile['localReconnect']>
+  owner: SessionTile['ownerRoute']
+  text: string
+  selection: ReturnType<typeof selectionOffsetsInEditor>
+}
+
+const beforeComposition = new WeakMap<HTMLElement, Pick<PendingFocus, 'selection' | 'text'> & { lineBreak?: true }>()
+let pending: PendingFocus | undefined
+
+function readEditorSelection(editor: HTMLElement) {
+  return { selection: selectionOffsetsInEditor(editor), text: composerPlainText(editor) }
+}
+
+export function setSplitReconnectComposition(editor: HTMLElement, composing: boolean) {
+  if (composing) {
+    beforeComposition.set(editor, readEditorSelection(editor))
+  } else {
+    beforeComposition.delete(editor)
+  }
+}
+
+export function markLineBreakComposition(editor: HTMLElement) {
+  const saved = beforeComposition.get(editor) ?? readEditorSelection(editor)
+  if (saved.selection) {
+    beforeComposition.set(editor, { ...saved, lineBreak: true })
+  }
+}
+
+export function finishComposerComposition(editor: HTMLElement, mode: 'ended' | 'abandoned-selection' = 'ended') {
+  const saved = beforeComposition.get(editor)
+  const replacing = Boolean(saved?.lineBreak && saved.selection && saved.selection.anchor !== saved.selection.focus)
+
+  if (mode === 'abandoned-selection' && !replacing) return
+
+  beforeComposition.delete(editor)
+  if (saved?.lineBreak && saved.selection) {
+    return { text: saved.text, selection: saved.selection, replacing }
+  }
+}
+
+export const automaticComposerFocusHeld = () => Boolean(pending)
+
+function releaseFocus(target: string) {
+  if (pending?.target === target) {
+    const saved = pending
+    pending = undefined
+    saved.cancel.abort()
+  }
+}
+
+function watchSplitReconnectFocus(storedSessionId: string) {
+  const target = `tile:${storedSessionId}`
+  const stop = $sessionTiles.listen((tiles, previous) => {
+    const tile = tiles.find(item => item.storedSessionId === storedSessionId)
+    const oldTile = previous.find(item => item.storedSessionId === storedSessionId)
+
+    if (pending?.target === target && (
+      tile?.localReconnect !== pending.from || tile.ownerRoute !== pending.owner ||
+      tile.error || isReadOnlyRuntimeId(tile.runtimeId)
+    )) {
+      releaseFocus(target)
+    }
+
+    const editor = document.activeElement
+    if (
+      tile?.runtimeId || !tile?.localReconnect || tile.localReconnect.runtimeId !== oldTile?.runtimeId ||
+      tile.ownerRoute !== oldTile.ownerRoute || !document.hasFocus() ||
+      !(editor instanceof HTMLElement) || editor.dataset.slot !== RICH_INPUT_SLOT ||
+      editor.closest('[data-composer-target]')?.getAttribute('data-composer-target') !== target ||
+      editor.closest(`[inert], ${EDIT_COMPOSER_ROOT}`) || isElementInHiddenPane(editor)
+    ) {
+      return
+    }
+
+    if (pending) releaseFocus(pending.target)
+    const cancel = new AbortController()
+    const options = { capture: true, signal: cancel.signal }
+    const relinquish = () => cancel.abort()
+    for (const event of ['focusin', 'pointerdown', 'keydown']) {
+      document.addEventListener(event, relinquish, options)
+    }
+    window.addEventListener('blur', relinquish, { signal: cancel.signal })
+    pending = {
+      target, cancel, from: tile.localReconnect, owner: tile.ownerRoute,
+      ...(beforeComposition.get(editor) ?? readEditorSelection(editor))
+    }
+  })
+
+  return () => {
+    stop()
+    releaseFocus(target)
+  }
+}
+
+export function useSplitReconnectFocus(storedSessionId: string) {
+  useLayoutEffect(() => watchSplitReconnectFocus(storedSessionId), [storedSessionId])
+}
+
+export function restoreSplitReconnectFocus(target: string, editor: HTMLElement | null) {
+  const saved = pending
+  if (saved?.target !== target) return
+  const relinquished = saved.cancel.signal.aborted
+  releaseFocus(target)
+
+  if (
+    !editor?.isConnected || relinquished || !document.hasFocus() || document.activeElement !== document.body ||
+    isElementInHiddenPane(editor) || editor.closest('[inert]')
+  ) {
+    return
+  }
+
+  // A remounted surface has a new host id and must claim the router before focusin.
+  const surfaceId = editor.closest<HTMLElement>('[data-composer-owner]')?.dataset.composerOwner
+  if (!surfaceId) return
+  claimFloatingComposer(surfaceId)
+  if ($floatingComposerOwner.get()?.id !== surfaceId) return
+
+  editor.focus({ preventScroll: true })
+  if (document.activeElement === editor && saved.selection && composerPlainText(editor) === saved.text) {
+    placeSelectionAtOffsets(editor, saved.selection)
+  }
+}
