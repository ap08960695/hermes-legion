+"""Expanded diagnostics remain bounded, explicit and read-only."""
+import json
+import sys
+import pytest
+from hermes_cli.usage_attribution import main
+from hermes_cli.usage_attribution_sources import collect
+
+
+def test_expanded_cli_reads_omitted_logs_without_exposing_records(tmp_path, monkeypatch, capsys):
+    logs=tmp_path/"logs";logs.mkdir()
+    for n in range(33):
+        (logs/f"sample{n}.log").write_text('CACHE_DIAGNOSTIC {"private_payload":"DO_NOT_ECHO"}\n')
+    _,_,limited=collect(tmp_path,0,1)
+    assert len(limited["files"])==32 and limited["log_files_omitted"]==1
+    monkeypatch.setattr(sys,"argv",["usage_attribution","--home",str(tmp_path),"--max-log-files","33"])
+    main()
+    output=capsys.readouterr().out;result=json.loads(output)
+    assert len(result["coverage"]["files"])==33
+    assert result["coverage"]["log_files_omitted"]==0
+    assert result["coverage"]["max_log_files"]==33
+    assert "DO_NOT_ECHO" not in output
+    assert not (tmp_path/"kanban.db").exists()
+    assert not (tmp_path/"telemetry").exists()
+
+
+@pytest.mark.parametrize("budget",[0,513,True,1.5])
+def test_invalid_budget_refused_before_reading_home(tmp_path,budget):
+    with pytest.raises(ValueError,match="max_log_files"):
+        collect(tmp_path/"absent",0,1,max_log_files=budget)
diff --git a/tests/hermes_cli/test_usage_cross_profile.py b/tests/hermes_cli/test_usage_cross_profile.py
