@@ -0,0 +1,28 @@
+import { expect, it } from 'vitest'
+
+import { bindWorkStorage, readWorkSelection, saveWorkSelection } from './work-selection'
+it('restores selection per connection and board, and never persists the mutable current-board alias', () => {
+  const values = new Map<string, unknown>()
+
+  const storage = {
+    get: <T>(key: string, fallback: T) => (values.get(key) ?? fallback) as T,
+    set: (key: string, value: unknown) => {
+      values.set(key, value)
+    },
+    remove: (key: string) => {
+      values.delete(key)
+    }
+  }
+
+  const close = bindWorkStorage(storage)
+  saveWorkSelection('local', 'alpha', { view: 'work', taskId: 'one' })
+  expect(readWorkSelection('local', 'alpha')).toEqual({ view: 'work', taskId: 'one' })
+  expect(readWorkSelection('remote', 'alpha').taskId).toBeNull()
+  expect(readWorkSelection('local', 'beta').taskId).toBeNull()
+  saveWorkSelection('local', '', { view: 'work', taskId: 'private' })
+  expect(readWorkSelection('local', '').taskId).toBeNull()
+  close()
+  const reopened = bindWorkStorage(storage)
+  expect(readWorkSelection('local', 'alpha').taskId).toBe('one')
+  reopened()
+})
diff --git a/apps/desktop/src/plugins/kanban/work-selection.ts b/apps/desktop/src/plugins/kanban/work-selection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5ba5f2822ff2cfe06bbf576919d9af086935833b
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/work-selection.ts
@@ -0,0 +1,37 @@
+import type { PluginStorage } from '@hermes/plugin-sdk'
+
+import type { BoardView } from './board-view'
+
+interface WorkSelection {
+  view: BoardView
+  taskId: string | null
+}
+let storage: PluginStorage | null = null
+const key = (scope: string, board: string) => `work-selection.${JSON.stringify([scope, board])}`
+
+export function bindWorkStorage(next: PluginStorage) {
+  storage = next
+
+  return () => {
+    if (storage === next) {storage = null}
+  }
+}
+
+export function readWorkSelection(scope: string, board: string): WorkSelection {
+  const fallback: WorkSelection = { view: 'current', taskId: null }
+
+  if (!board) {return fallback}
+  const value = storage?.get<unknown>(key(scope, board), fallback)
+
+  if (!value || typeof value !== 'object') {return fallback}
+  const saved = value as Partial<WorkSelection>
+
+  return {
+    view: ['current', 'history', 'workflow', 'work'].includes(saved.view ?? '') ? saved.view! : 'current',
+    taskId: typeof saved.taskId === 'string' && saved.taskId.length <= 256 ? saved.taskId : null
+  }
+}
+
+export function saveWorkSelection(scope: string, board: string, value: Partial<WorkSelection>) {
+  if (board) {storage?.set(key(scope, board), { ...readWorkSelection(scope, board), ...value })}
+}
