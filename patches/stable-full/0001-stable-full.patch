+def _cjk_token_boundary(code: int) -> bool:
+    """Match the CJK ranges split by native/fts5_cjk/fts5_cjk.c."""
+    return any(lo <= code <= hi for lo, hi in (
+        (0xAC00, 0xD7A3), (0x1100, 0x11FF), (0x3130, 0x318F),
+        (0xA960, 0xA97F), (0xD7B0, 0xD7FF), (0x4E00, 0x9FFF),
+        (0x3400, 0x4DBF), (0xF900, 0xFAFF), (0x20000, 0x2FA1F),
+        (0x3040, 0x309F), (0x30A0, 0x30FF), (0x31F0, 0x31FF),
+    ))
