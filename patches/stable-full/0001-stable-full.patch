@@ -0,0 +1,76 @@
+"""Byte-exact edit source reads; remote backends keep their shell transport."""
+import hashlib
+import os
+import stat
+
+from tools.file_operations_common import ReadResult, _strip_bom
+
+
+def read_file_raw(ops, path: str) -> ReadResult:
+    from tools.file_operations import describe_binary_file
+
+    if ops._native_read_enabled():
+        return _read_local_raw(ops, path)
+    file_size, status = ops._probe_regular_file(path)
+    if status == "missing":
+        return ops._suggest_similar_files(path)
+    if status == "not_regular":
+        return ops._not_regular_error(path)
+    if status not in ("ok", "bad_size"):
+        return ops._env_unavailable_error(path, status)
+    if ops._is_image(path):
+        return ReadResult(is_image=True, is_binary=True, file_size=file_size)
+    is_binary, sample_bytes = ops._detect_binary(path)
+    if is_binary:
+        return ReadResult(is_binary=True, file_size=file_size, error=describe_binary_file(sample_bytes, file_size))
+    data, failed = ops._read_exact_bytes(path)
+    if data is None:
+        return ReadResult(error=f"Failed to read file: {failed.stdout}")
+    return _text_result(data, file_size)
+
+
+def _text_result(data: bytes, file_size: int) -> ReadResult:
+    # Edits must round-trip undecodable bytes and literal terminal escapes.
+    # Strip only the BOM; write_file probes disk and restores it on write.
+    content, _ = _strip_bom(data.decode("utf-8", "surrogateescape"))
+    return ReadResult(content=content, file_size=file_size,
+                      _content_sha256=hashlib.sha256(data).hexdigest())
+
+
+def _read_local_raw(ops, path: str) -> ReadResult:
+    cwd = getattr(ops.env, "cwd", None) or ops.cwd
+    if not os.path.isdir(cwd):
+        return ops._env_unavailable_error(path)
+    full = path if os.path.isabs(path) else os.path.join(cwd, path)
+    try:
+        # Nonblocking open prevents a substituted FIFO from hanging an edit.
+        # Classification and content come from the same descriptor.
+        fd = os.open(full, os.O_RDONLY | os.O_NONBLOCK)
+        try:
+            info = os.fstat(fd)
+            if not stat.S_ISREG(info.st_mode):
+                return ops._not_regular_error(path)
+            if ops._is_image(path):
+                return ReadResult(is_image=True, is_binary=True, file_size=info.st_size)
+            with os.fdopen(fd, "rb", closefd=False) as stream:
+                return _read_stream(ops, path, stream, info.st_size)
+        finally:
+            os.close(fd)
+    except (FileNotFoundError, NotADirectoryError):
+        if os.path.islink(full):
+            return ops._not_regular_error(path)
+        return ops._suggest_similar_files(path)
+    except OSError as exc:
+        return ReadResult(error=f"Failed to read file: {path}: {exc}")
+
+
+def _read_stream(ops, path, stream, file_size: int) -> ReadResult:
+    from tools.file_operations import describe_binary_file, has_binary_extension
+
+    sample = stream.read(1000)
+    if has_binary_extension(path) or ops._is_likely_binary_bytes(sample):
+        return ReadResult(is_binary=True, file_size=file_size,
+                          error=describe_binary_file(sample, file_size))
+    stream.seek(0)
+    data = stream.read()
+    return _text_result(data, len(data))
