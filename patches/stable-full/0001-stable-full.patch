+} from '@/store/composer-rejected-drafts'
+
+const owner = { connectionId: 'retained-send', profile: 'work' }
+const other = { ...owner, profile: 'other' }
+const target = 'owned-session'
+
+afterEach(() => {
+  vi.restoreAllMocks()
+
+  for (const row of ownedDraftScopes()) {
+    clearSessionDraft(row.scope, row.owner)
+  }
+
+  window.localStorage.clear()
