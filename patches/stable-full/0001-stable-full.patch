+"""Delivery readback is scoped and observational, never a dispatch or approval."""
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli.kanban_delivery_view import delivery_summary
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / 'home'
+    home.mkdir()
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(home))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    conn = kbc.connect()
+    yield conn
+    conn.close()
+
+
+def test_legacy_done_is_not_verified_delivery_and_reads_do_not_mutate(board):
+    tid = kb.create_task(board, title='Return five', body='Give a simple answer', assignee='builder')
+    assert kb.complete_task(board, tid, summary='5')
+    changes = board.total_changes
+    view = delivery_summary(board, tid)
+    assert view['state'] == 'awaiting_verification'
+    assert view['verification']['status'] == 'missing'
+    assert view['objective'] == 'Return five'
+    assert view['latest_summary'] == '5'
+    assert view['owner'] == 'builder'
+    assert board.total_changes == changes
+
+
+@pytest.mark.parametrize(('kind', 'state'), [('needs_input', 'needs_input'), ('dependency', 'needs_input'),
+                                           ('capability', 'waiting'), ('transient', 'waiting')])
+def test_block_reason_is_current_only_while_blocked(board, kind, state):
+    tid = kb.create_task(board, title='Simple card')
+    assert kb.block_task(board, tid, reason='Need the agreed input', kind=kind)
+    view = delivery_summary(board, tid)
+    assert view['state'] == state
+    assert view['blocked_reason'] == 'Need the agreed input'
+    assert kb.unblock_task(board, tid)
+    assert delivery_summary(board, tid)['blocked_reason'] is None
+
+
+def test_dependency_wait_has_native_links_without_invented_goal_ownership(board):
+    parent = kb.create_task(board, title='First')
+    child = kb.create_task(board, title='Second', parents=[parent])
+    view = delivery_summary(board, child)
+    assert view['state'] == 'waiting'
+    assert view['dependencies'] == [{'id': parent, 'title': 'First', 'status': 'ready'}]
+
+
+def test_unknown_task_is_not_looked_up_on_another_board(board, tmp_path):
+    other = kbc.connect(tmp_path / 'other.db')
+    try:
+        tid = kb.create_task(other, title='Private other board')
+        assert delivery_summary(board, tid) is None
+    finally:
+        other.close()
+
+
+def test_malformed_contract_is_visible_without_breaking_task_read(board):
+    tid = kb.create_task(board, title='Invalid contract', body='```hermes-contract\n{bad json}\n```')
+    view = delivery_summary(board, tid)
+    assert view['verification'] == {'status': 'invalid', 'reason': 'invalid_contract'}
+    assert view['criteria'] == []
