+_BACKSLASH_RUN = re.compile(r'\\+')
+_RAW_TOKEN_DELIMITERS = re.compile(r'["{}\[\],: \t\r\n]+')
+_LONG_RAW_TOKEN = re.compile(r'[^"{}\[\],: \t\r\n]{1025}')
+# These ASCII escapes can assemble a nested \\u escape after JSON decoding.
+# Such input is sent to the existing verifier instead of the quick filter.
+_AMBIGUOUS_ASCII_ESCAPE = re.compile(r'\\u00(?:3[0-9]|4[1-6]|5[5c]|6[1-6]|75)', re.I)
+_HEX_DIGITS = frozenset('0123456789abcdefABCDEF')
+_ASCII_LOWER = str.maketrans('ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')
+
+
+def _unicode_fragments(chunks):
+    """Yield decoded fragments and their source offsets in the outer string."""
+    pending = ''
+    base = 0
+
+    def consume(final):
+        nonlocal pending, base
+        while pending:
+            slash = pending.find('\\')
+            if slash < 0:
+                yield pending, base, True
+                base += len(pending)
+                pending = ''
+                return
+            if slash:
+                yield pending[:slash], base, True
+                pending, base = pending[slash:], base + slash
+            run = _BACKSLASH_RUN.match(pending).end()
+            pairs = run - run % 2
+            if pairs:
+                # Paired backslashes escape each other.  Emit them as source
+                # text, even when a run crosses a chunk boundary.
+                yield pending[:pairs], base, True
+                pending, base = pending[pairs:], base + pairs
+            if not pending:
+                return
+            if len(pending) == 1 and not final:
+                return
+            if pending[1:2] != 'u':
+                yield pending[0], base, True
+                pending, base = pending[1:], base + 1
+                continue
+            if len(pending) < 6:
+                if not final:
+                    return
+            elif all(char in _HEX_DIGITS for char in pending[2:6]):
+                first = int(pending[2:6], 16)
+                length = 6
+                if 0xD800 <= first <= 0xDBFF:
+                    tail = pending[6:]
+                    if not final and len(tail) < 6 and '\\u'.startswith(tail[:2]):
+                        return
+                    if (len(tail) >= 6 and tail.startswith('\\u')
+                            and all(char in _HEX_DIGITS for char in tail[2:6])):
+                        second = int(tail[2:6], 16)
+                        if 0xDC00 <= second <= 0xDFFF:
+                            first = 0x10000 + ((first - 0xD800) << 10) + second - 0xDC00
+                            length = 12
+                yield chr(first), base, False
+                pending, base = pending[length:], base + length
+                continue
+            yield pending[0], base, True
+            pending, base = pending[1:], base + 1
+
+    for chunk in chunks:
+        pending += chunk
+        yield from consume(False)
+    yield from consume(True)
+
+
+def _decoded_unicode_escapes(chunks):
+    """Interpret Unicode escapes inside serialized argument strings, incrementally."""
+    for text, _, _ in _unicode_fragments(chunks):
+        yield text
