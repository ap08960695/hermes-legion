+"""Session recall must not resurrect rewound data or return unbounded tool output."""
+
+import base64
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_state import SessionDB
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+from tools.session_search_tool import session_search
+
+
+@pytest.fixture
+def history(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    sid = "target"
+    db.create_session(sid, source="cli")
+    undo = db.append_message(sid, role="user", content="undone-secret-marker")
+    db.rewind_to_message(sid, undo)
+    hidden = db.append_message(sid, role="user", content="hidden-secret-marker", display_kind="hidden")
+    anchor = db.append_message(sid, role="user", content="visible-anchor-needle")
+    body = "begin " + "x" * 9000 + " middle-unique-needle " + "y" * 9000 + " end"
+    large = db.append_message(sid, role="tool", tool_name="terminal", tool_call_id="c1", content=body)
+    try:
+        yield db, sid, undo, hidden, anchor, large, body
+    finally:
+        db.close()
+
+
+def call(db, **kwargs):
+    return json.loads(session_search(db=db, **kwargs))
+
+
+def test_scroll_omits_rewound_and_hidden_neighbors(history):
+    db, sid, undo, hidden, anchor, _, _ = history
+    result = call(db, session_id=sid, around_message_id=anchor, window=5)
+    assert result["success"] is True
+    ids = [m["id"] for m in result["messages"]]
+    assert anchor in ids and undo not in ids and hidden not in ids
+    assert "undone-secret-marker" not in json.dumps(result)
+    assert "hidden-secret-marker" not in json.dumps(result)
+
+
+@pytest.mark.parametrize("which", ["rewound", "hidden"])
+def test_scroll_refuses_invisible_anchor_even_without_current_session(history, which):
+    db, sid, undo, hidden, _, _, _ = history
+    result = call(db, session_id=sid, around_message_id=undo if which == "rewound" else hidden)
+    assert result["success"] is False
+    assert "messages" not in result
+
+
+def test_discovery_hydration_does_not_return_invisible_neighbors(history):
+    db, _, _, _, _, _, _ = history
+    result = call(db, query="visible-anchor-needle", detail="full")
+    assert result["success"] is True and result["results"]
+    payload = json.dumps(result)
+    assert "undone-secret-marker" not in payload
+    assert "hidden-secret-marker" not in payload
+
+
+def test_read_omits_hidden_rows(history):
+    db, sid, _, hidden, _, _, _ = history
+    result = call(db, session_id=sid)
+    assert result["success"] is True
+    assert hidden not in [m["id"] for m in result["messages"]]
+
+
+def test_read_reports_a_database_failure_instead_of_a_missing_session(history, monkeypatch):
+    db, sid, _, _, _, _, _ = history
+    def refused(*args, **kwargs):
+        raise OSError("synthetic read refusal")
+    monkeypatch.setattr(db, "get_recall_bookends", refused)
+    result = call(db, session_id=sid)
+    assert not result["success"]
+    assert "failed to load session" in result["error"]
+    assert "not found" not in result["error"]
+
+
+def test_native_search_context_omits_rewound_and_hidden_neighbors(history):
+    db, _, _, _, _, _, _ = history
+    hits = db.search_messages("visible anchor needle")
+    assert hits
+    payload = json.dumps(hits)
+    assert "undone-secret-marker" not in payload
+    assert "hidden-secret-marker" not in payload
+
+
+def test_scroll_bounds_each_large_message_and_advertises_a_page(history):
+    db, sid, _, _, anchor, large, _ = history
+    result = call(db, session_id=sid, around_message_id=anchor, window=5)
+    item = next(m for m in result["messages"] if m["id"] == large)
+    assert len(item["content"]) <= 4001
+    assert item["content_truncated"] is True
+    assert item["original_content_chars"] > 18000
+    assert len(json.dumps(result)) < 16000
+
+
+def test_message_pages_recover_text_after_the_initial_excerpt(history):
+    db, sid, _, _, _, large, body = history
+    found = call(db, session_id=sid, query="middle-unique-needle")
+    assert found["results"][0]["match_message_id"] == large
+    result = call(db, session_id=sid, around_message_id=large, content_offset=9000, content_limit=1000)
+    assert result["success"] is True and result["mode"] == "message_page"
+    assert result["content"] == body[9000:10000]
+    assert result["next_offset"] == 10000
+
+
+def test_scoped_match_supplies_offset_for_one_targeted_page(history):
+    db, sid, _, _, _, large, body = history
+    found = call(db, session_id=sid, query="middle-unique-needle")
+    match = found["results"][0]
+    result = call(db, session_id=sid, around_message_id=large, content_offset=match["snippet_offset"])
+    assert "middle-unique-needle" in result["content"]
+    assert result["content"] == body[match["snippet_offset"]:match["snippet_offset"] + result["limit"]]
+
+
+def test_unicode_pages_use_character_offsets_without_corruption(history):
+    db, sid, _, _, _, _, _ = history
+    text = "ไทย🙂ก" * 1200 + "last"
+    mid = db.append_message(sid, role="tool", tool_call_id="unicode", content=text)
+    first = call(db, session_id=sid, around_message_id=mid, content_offset=2001, content_limit=1000)
+    assert first["content"] == text[2001:3001]
+    assert first["offset_unit"] == "characters" and first["next_offset"] == 3001
+    end = call(db, session_id=sid, around_message_id=mid, content_offset=len(text) - 4)
+    assert end["content"] == "last" and end["next_offset"] is None
+
+
+def test_large_structured_content_can_be_reassembled_without_unbounded_scroll(history):
+    db, sid, _, _, anchor, _, _ = history
+    value = [{"type": "text", "text": "ไทย🙂" + "z" * 9000}, {"type": "image", "data": "a" * 9000}]
+    mid = db.append_message(sid, role="user", content=value)
+    result = call(db, session_id=sid, around_message_id=anchor, window=5)
+    item = next(m for m in result["messages"] if m["id"] == mid)
+    assert item["content_truncated"] and item["content_encoding"] == "json"
+    assert len(json.dumps(result)) < 16000
+    chunks, offset = [], 0
+    while offset is not None:
+        page = call(db, session_id=sid, around_message_id=mid, content_offset=offset, content_limit=4000)
+        assert page["success"] and page["encoding"] == "json"
+        chunks.append(page["content"])
+        offset = page["next_offset"]
+    assert json.loads("".join(chunks)) == value
+
+
+def test_embedded_nul_pages_are_lossless_base64(history):
+    db, sid, _, _, _, _, _ = history
+    value = "ก่อน\x00หลัง🙂" * 200
+    mid = db.append_message(sid, role="tool", tool_call_id="nul", content=value)
+    chunks, offset = [], 0
+    while offset is not None:
+        page = call(db, session_id=sid, around_message_id=mid, content_offset=offset, content_limit=127)
+        assert page["success"] and page["encoding"] == "base64" and page["offset_unit"] == "bytes"
+        chunks.append(base64.b64decode(page["content"]))
+        offset = page["next_offset"]
+    assert b"".join(chunks).decode("utf-8") == value
+
+
+def test_large_tool_arguments_are_omitted_from_scroll_but_can_be_paged(history):
+    db, sid, _, _, anchor, _, _ = history
+    calls = [{"id": "large", "type": "function", "function": {"name": "terminal", "arguments": "x" * 9000}}]
+    mid = db.append_message(sid, role="assistant", content="calling tool", tool_calls=calls)
+    result = call(db, session_id=sid, around_message_id=anchor, window=5)
+    item = next(m for m in result["messages"] if m["id"] == mid)
+    assert item["tool_calls_truncated"] is True and "tool_calls" not in item
+    chunks, offset = [], 0
+    while offset is not None:
