+  expect(check.getAttribute('aria-busy')).toBe('true')
+  expect(check.getAttribute('aria-disabled')).toBe('true')
+  expect(document.activeElement).toBe(check)
+  expect(path.matches(':disabled')).toBe(true)
+  expect(conflict.isConnected).toBe(true)
+  expect(conflict.matches(':disabled')).toBe(true)
+  expect(proceed.isConnected).toBe(false)
+  expect(screen.getByText('Rechecking declared writes. Showing the last loaded check.')).toBeTruthy()
+
+  await act(async () => fail())
+  expect(await screen.findByText('Fixture check failed')).toBeTruthy()
+  expect(screen.getByText('Could not recheck declared writes. Showing the last loaded check.')).toBeTruthy()
+  expect(conflict.isConnected).toBe(true)
+  expect(screen.queryByRole('button', { name: 'Proceed' })).toBeNull()
+  expect(screen.queryByRole('button', { name: 'Sequence after conflicting cards' })).toBeNull()
+  expect(document.activeElement).toBe(check)
+  expect(check.getAttribute('aria-disabled')).not.toBe('true')
