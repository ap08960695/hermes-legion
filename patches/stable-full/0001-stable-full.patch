+"""Pause controls must not report success when sentinel I/O fails."""
+
+import argparse
+import errno
+import os
+from pathlib import Path
+
+import pytest
+
+from agent import estop
+
+
+@pytest.fixture
+def sentinels(tmp_path, monkeypatch):
+    local = tmp_path / "profile" / "ESTOP"
+    root = tmp_path / "root" / "ESTOP"
+    local.parent.mkdir()
+    root.parent.mkdir()
+    monkeypatch.setattr(estop, "sentinel_path", lambda: local)
+    monkeypatch.setattr(estop, "fleet_sentinel_path", lambda: root)
+    monkeypatch.setattr(estop, "_candidate_sentinel_paths", lambda: [local, root])
+    return local, root
+
+
+def reject_creation(monkeypatch, path, *, reject_touch):
+    original_open = os.open
+    original_write = os.write
+    marker_fds = set()
+
+    def guarded_open(target, *args, **kwargs):
+        is_marker = os.fspath(target) == os.fspath(path)
+        if is_marker and reject_touch:
+            raise PermissionError(errno.EACCES, "simulated creation denial")
+        fd = original_open(target, *args, **kwargs)
+        if is_marker:
+            marker_fds.add(fd)
+        return fd
+
+    def guarded_write(fd, data):
+        if fd in marker_fds and not reject_touch:
+            raise PermissionError(errno.EACCES, "simulated content write denial")
+        return original_write(fd, data)
+
+    monkeypatch.setattr(os, "open", guarded_open)
+    monkeypatch.setattr(os, "write", guarded_write)
+
+
+def reject_removal(monkeypatch, path):
+    original = Path.unlink
+
+    def unlink(target, *args, **kwargs):
+        if target == path:
+            raise PermissionError(errno.EACCES, "simulated unlink denial")
+        return original(target, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "unlink", unlink)
+
+
+class PauseEvent:
+    def __init__(self, args):
+        self.args = args
+
+    def get_command_args(self):
+        return self.args
+
+
+def test_cli_pause_does_not_claim_success_when_creation_fails(sentinels, monkeypatch, capsys):
+    from hermes_cli.subcommands.pause import cmd_pause
+
+    _, root = sentinels
+    reject_creation(monkeypatch, root, reject_touch=True)
+
+    assert cmd_pause(argparse.Namespace(reason="test")) != 0
+    assert "unable to confirm" in capsys.readouterr().err.lower()
+    assert estop.is_engaged() is False
+
+
+def test_cli_pause_reports_the_fleet_sentinel_when_local_is_missing(sentinels, monkeypatch, capsys):
+    from hermes_cli.subcommands.pause import cmd_pause
+
+    local, root = sentinels
+    root.touch()
+    reject_creation(monkeypatch, local, reject_touch=True)
+
+    assert cmd_pause(argparse.Namespace(reason=None)) == 0
+    output = capsys.readouterr().out.lower()
+    assert f"sentinel: {root}".lower() in output
+    assert f"sentinel: {local}".lower() not in output
+    assert not local.exists() and root.exists()
+
+
+@pytest.mark.asyncio
+async def test_gateway_pause_does_not_claim_success_when_creation_fails(sentinels, monkeypatch):
+    from gateway.run import GatewayRunner
+
+    _, root = sentinels
+    reject_creation(monkeypatch, root, reject_touch=True)
+    runner = object.__new__(GatewayRunner)
+
+    reply = await runner._handle_pause_command(PauseEvent("test"))
+    assert "unable to confirm" in reply.lower()
+    assert estop.is_engaged() is False
+
+
+@pytest.mark.parametrize("has_local", [False, True], ids=["root-only", "partial-removal"])
+def test_cli_resume_does_not_claim_success_when_root_remains(sentinels, monkeypatch, capsys, has_local):
+    from hermes_cli.subcommands.pause import cmd_resume
+
+    local, root = sentinels
+    if has_local:
+        local.touch()
+    root.touch()
+    reject_removal(monkeypatch, root)
+
+    assert cmd_resume(argparse.Namespace()) != 0
+    assert "unable to confirm" in capsys.readouterr().err.lower()
+    assert not local.exists()
+    assert root.exists()
+
+
+def test_cli_resume_does_not_claim_success_if_remaining_state_is_unknown(sentinels, monkeypatch, capsys):
+    from hermes_cli.subcommands.pause import cmd_resume
+
+    _, root = sentinels
+    reject_removal(monkeypatch, root)
+    original = Path.lstat
+
+    def lstat(target, *args, **kwargs):
+        if target == root:
+            raise PermissionError(errno.EACCES, "simulated inspection denial")
+        return original(target, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "lstat", lstat)
+    assert cmd_resume(argparse.Namespace()) != 0
+    assert "unable to confirm" in capsys.readouterr().err.lower()
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.skipif(getattr(os, "geteuid", lambda: None)() == 0, reason="root can traverse a mode-000 directory")
+def test_cli_resume_reports_inaccessible_real_directory(sentinels, capsys):
+    from hermes_cli.subcommands.pause import cmd_resume
+
+    _, root = sentinels
+    root.parent.chmod(0)
+    try:
+        assert cmd_resume(argparse.Namespace()) != 0
+        assert "unable to confirm" in capsys.readouterr().err.lower()
+    finally:
+        root.parent.chmod(0o700)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("has_local", [False, True], ids=["root-only", "partial-removal"])
+async def test_gateway_resume_does_not_claim_success_when_root_remains(sentinels, monkeypatch, has_local):
+    from gateway.run import GatewayRunner
+
+    local, root = sentinels
+    if has_local:
+        local.touch()
+    root.touch()
+    reject_removal(monkeypatch, root)
+    runner = object.__new__(GatewayRunner)
+
+    reply = await runner._handle_pause_command(PauseEvent("off"))
+    assert "unable to confirm" in reply.lower()
+    assert not local.exists()
+    assert root.exists()
+
+
+@pytest.mark.asyncio
+async def test_gateway_pause_does_not_invent_unsaved_reason(sentinels, monkeypatch):
+    from gateway.run import GatewayRunner
+
+    _, root = sentinels
+    reject_creation(monkeypatch, root, reject_touch=False)
+    runner = object.__new__(GatewayRunner)
+
+    reply = await runner._handle_pause_command(PauseEvent("unsaved reason"))
+    assert "paused" in reply.lower()
+    assert "unsaved reason" not in reply
+    assert estop.get_state()["reason"] is None
+
+
+@pytest.mark.asyncio
+async def test_gateway_pause_creation_failure_uses_the_selected_language(sentinels, monkeypatch):
+    from agent import i18n
+    from gateway.run import GatewayRunner
+
+    _, root = sentinels
+    reject_creation(monkeypatch, root, reject_touch=True)
+    monkeypatch.setenv("HERMES_LANGUAGE", "de")
+    i18n.reset_language_cache()
+    try:
+        reply = await object.__new__(GatewayRunner)._handle_pause_command(PauseEvent("test"))
+        assert "Pause kann nicht bestätigt werden" in reply
+    finally:
+        i18n.reset_language_cache()
+
+
+@pytest.mark.asyncio
+async def test_gateway_does_not_claim_unknown_state_is_already_paused(sentinels, monkeypatch):
+    from gateway.run import GatewayRunner
+
+    local, root = sentinels
+    original = Path.lstat
+
+    def lstat(target, *args, **kwargs):
+        if target == root:
+            raise PermissionError(errno.EACCES, "simulated inspection denial")
+        return original(target, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "lstat", lstat)
+    runner = object.__new__(GatewayRunner)
+    reply = await runner._handle_pause_command(PauseEvent(""))
+
+    assert "unable to confirm" in reply.lower()
+    assert not local.exists()
