index 0000000000000000000000000000000000000000..71b71b92e0fd355937e54fb30d21e8df0f472367
--- /dev/null
+++ b/apps/desktop/src/store/character-settings.ts
@@ -0,0 +1,74 @@
+import { atom } from 'nanostores'
+
+import type { CharacterSettings, CharacterSize } from '../../electron/character-menu-types'
+
+import { readJson, writeJson } from '@/lib/storage'
+
+export type { CharacterSize }
+export const characterSizes: readonly CharacterSize[] = ['small', 'medium', 'large']
+
+const defaults: CharacterSettings = { enabled: false, size: 'medium' }
+const key = (scope: string) => `hermes:character-settings:${scope}`
+
+export const $characterSettings = atom<Record<string, CharacterSettings>>({})
+export const $characterExtraActor = atom(false)
+
+export const characterScope = (connectionId: string | null, profile: string) => JSON.stringify([connectionId, profile])
+
+function readSettings(scope: string) {
+  return $characterSettings.get()[scope] ?? readJson<Partial<CharacterSettings>>(key(scope))
+}
+
+// An existing Characters record also marks this scope as migrated.
+export function hasCharacterSettings(scope: string): boolean {
+  return Boolean(readSettings(scope))
+}
+
+export function migrateLegacyCharacterSettings(scope: string, legacy?: { enabled?: unknown; scale?: unknown }): boolean {
+  if (hasCharacterSettings(scope)) {return false}
+  const raw = legacy?.scale
+  const scale = typeof raw === 'number' || typeof raw === 'string' ? Number(raw) : NaN
+  const enabled = legacy?.enabled
+
+  setCharacterSettings(scope, {
+    enabled: enabled === true || enabled === 1 ||
+      (typeof enabled === 'string' && ['true', 'on', 'yes', '1'].includes(enabled.trim().toLowerCase())),
+    // Map the former 0.33 default to medium and keep out-of-range values at medium.
+    size: scale < 0.1 || scale > 3 || !Number.isFinite(scale) ? 'medium' : scale < 0.29 ? 'small' : scale > 0.41 ? 'large' : 'medium'
+  })
+
+  return true
+}
+
+export function getCharacterSettings(scope: string): CharacterSettings {
+  const stored = readSettings(scope)
+
+  return {
+    enabled: stored?.enabled === true,
+    size: isCharacterSize(stored?.size) ? stored.size : defaults.size
+  }
+}
+
+export function isCharacterSize(value: unknown): value is CharacterSize {
+  return characterSizes.some(size => size === value)
+}
+
+export function setCharacterSettings(scope: string, change: Partial<CharacterSettings>) {
+  const value = { ...getCharacterSettings(scope), ...change }
+
+  writeJson(key(scope), value)
+  $characterSettings.set({ ...$characterSettings.get(), [scope]: value })
+}
+
+export function dropCharacterSettings(scope: string) {
+  writeJson(key(scope), null)
+  const next = { ...$characterSettings.get() }
+  delete next[scope]
+  $characterSettings.set(next)
+}
+
+export function migrateCharacterSettings(from: string, to: string) {
+  if (!readSettings(from)) {return}
+  setCharacterSettings(to, getCharacterSettings(from))
+  dropCharacterSettings(from)
+}
