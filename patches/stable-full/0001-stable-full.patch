+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import type { ComponentProps } from 'react'
+import { afterEach, expect, it, vi } from 'vitest'
+
+import {
+  adoptGoneSessionDraft,
+  announceGoneSessionDraft,
+  clearSessionDraft,
+  stashSessionDraft,
+  takeSessionDraft
+} from '@/store/composer'
+
+import { ownedDraftKey } from '@/store/composer-draft-owner'
+
+import { ComposerDraftRecovery } from './draft-recovery'
+import { RestoredDraftNotice } from './restored-draft-notice'
+import { UnassignedDraftNotice } from './unassigned-draft-notice'
+
+vi.mock('@/i18n', () => ({
+  useI18n: () => ({
+    t: {
+      composer: {
+        unassignedDraftNotice: 'An unassigned draft is available',
+        unassignedDraftRestore: 'Restore draft',
+        unassignedDraftRestoreFailed: 'Could not restore the saved draft. Your current draft is unchanged.',
+        restoredDraftNotice: 'Restored draft',
+        restoredDraftUndo: 'Undo',
+        restoredDraftUndoFailed: 'Could not save the draft back to its original chat. Your draft is still here.'
+      },
+      common: { close: 'Close' }
+    }
+  })
+}))
+
+const owner = { connectionId: 'draft-source', profile: 'work' }
+const other = { connectionId: 'other-source', profile: 'work' }
+const id = 'recovery-ui-history'
+
+afterEach(() => {
+  cleanup()
+  clearSessionDraft(id)
+
+  for (const scope of [owner, other]) {
+    clearSessionDraft(id, scope)
+    clearSessionDraft(null, scope)
+  }
+})
+
+it('offers old draft recovery without showing its text and copies only after a click', () => {
+  stashSessionDraft(id, 'Private old words', [])
+  const restored = vi.fn()
+  render(<UnassignedDraftNotice canRestore={() => true} empty onRestored={restored} owner={owner} scope={id} />)
+  expect(screen.queryByText('Private old words')).toBeNull()
+  expect(takeSessionDraft(id, owner).text).toBe('')
+  fireEvent.click(screen.getByRole('button', { name: 'Restore draft' }))
+  expect(restored).toHaveBeenCalledWith('Private old words', [])
+  expect(takeSessionDraft(id, owner).text).toBe('Private old words')
+  expect(takeSessionDraft(id).text).toBe('Private old words')
+  expect(takeSessionDraft(id, other).text).toBe('')
+})
+
+it('refuses recovery if a newly typed editor is no longer empty, and dismissing keeps the original', () => {
+  stashSessionDraft(id, 'Keep old words', [])
+  const restored = vi.fn()
+  render(<UnassignedDraftNotice canRestore={() => false} empty onRestored={restored} owner={owner} scope={id} />)
+  fireEvent.click(screen.getByRole('button', { name: 'Restore draft' }))
+  expect(restored).not.toHaveBeenCalled()
+  expect(takeSessionDraft(id, owner).text).toBe('')
+  fireEvent.click(screen.getByRole('button', { name: 'Close' }))
+  expect(takeSessionDraft(id).text).toBe('Keep old words')
+})
+
+it('never renders or consumes another owner restored-draft notice', () => {
+  stashSessionDraft(id, 'Gone original words', [], owner)
+  announceGoneSessionDraft(id, owner)
+  adoptGoneSessionDraft(owner)
+
+  const view = render(
+    <RestoredDraftNotice freshDraft onUndone={() => {}} owner={other} readLiveText={() => 'Gone original words'} />
+  )
+
+  expect(screen.queryByText('Restored draft')).toBeNull()
+  view.rerender(
+    <RestoredDraftNotice freshDraft onUndone={() => {}} owner={owner} readLiveText={() => 'Gone original words'} />
+  )
+  expect(screen.getByText('Restored draft')).toBeTruthy()
+})
+
+it('returns focus to the same composer after a successful explicit restore', () => {
+  stashSessionDraft(id, 'Recovered fixture text', [])
+  let editor!: HTMLTextAreaElement
+  type Draft = ComponentProps<typeof ComposerDraftRecovery>['draft']
+  const draft: Partial<Draft> = {
+    getDraftRetry: () => undefined,
+    hasText: false,
+    loadIntoComposer: (text: string) => { editor.value = text },
+    requestMainFocus: vi.fn(() => editor.focus()),
+    syncDraftFromEditor: () => editor.value
+  }
+  render(
+    <>
+      <textarea aria-label="Other pane" />
+      <ComposerDraftRecovery disabled={false} draft={draft as Draft} owner={owner} scope={id} />
+      <textarea aria-label="Current message" />
+    </>
+  )
+
+  editor = screen.getByRole<HTMLTextAreaElement>('textbox', { name: 'Current message' })
+  const restore = screen.getByRole('button', { name: 'Restore draft' })
+  restore.focus()
+  editor.value = 'Newer typing'
+  fireEvent.click(restore)
+  expect(editor.value).toBe('Newer typing')
+  expect(draft.requestMainFocus).not.toHaveBeenCalled()
+  expect(document.activeElement).toBe(restore)
+
+  editor.value = ''
+  fireEvent.click(restore)
+  expect(editor.value).toBe('Recovered fixture text')
+  expect(screen.queryByRole('button', { name: 'Restore draft' })).toBeNull()
+  expect(document.activeElement).toBe(editor)
+  expect(draft.requestMainFocus).toHaveBeenCalledOnce()
+})
+
+it.each([false, true])('reports only a failed Undo save (edited=%s)', edited => {
+  const text = 'Fixture restored text'
+  stashSessionDraft(id, text, [], owner)
+  announceGoneSessionDraft(id, owner)
+  expect(adoptGoneSessionDraft(owner)).toBe(true)
+  const original = ownedDraftKey(id, owner)
+  const save = Storage.prototype.setItem
+  const blocked = vi.spyOn(Storage.prototype, 'setItem').mockImplementation(function (this: Storage, key, value) {
+    if (key === original) throw new DOMException('Fixture storage full', 'QuotaExceededError')
+    save.call(this, key, value)
+  })
+  const clearEditor = vi.fn()
+
+  try {
+    render(<RestoredDraftNotice freshDraft onUndone={clearEditor} owner={owner}
+      readLiveText={() => edited ? 'Newer words' : text} />)
+    const undo = screen.getByRole('button', { name: 'Undo' })
+    undo.focus()
+    fireEvent.click(undo)
+    expect(clearEditor).not.toHaveBeenCalled()
+    expect(takeSessionDraft(null, owner).text).toBe(text)
+    if (edited) {
+      expect(screen.queryByRole('alert')).toBeNull()
+      expect(screen.queryByRole('button', { name: 'Undo' })).toBeNull()
+      return
+    }
+
+    expect(screen.getByRole('alert').textContent).toContain('Your draft is still here.')
+    expect(document.activeElement).toBe(undo)
+    blocked.mockRestore()
+    fireEvent.click(undo)
+    expect(clearEditor).toHaveBeenCalledOnce()
+    expect(takeSessionDraft(id, owner).text).toBe(text)
+    expect(screen.queryByRole('alert')).toBeNull()
+  } finally {
+    blocked.mockRestore()
+  }
+})
+
+it.each(['write denied', 'other window saved first'])('keeps recovery available when %s', failure => {
+  const text = 'Original saved words'
+  const newer = JSON.stringify({ text: 'Newer words from the other window', updatedAt: 5 })
+  stashSessionDraft(id, text, [])
+  const destination = ownedDraftKey(id, owner)!
+  const denied = failure === 'write denied'
+  if (!denied) localStorage.setItem(destination, newer)
+  const originalSet = Storage.prototype.setItem
+  const write = vi.spyOn(Storage.prototype, 'setItem').mockImplementation(function (this: Storage, key, value) {
+    if (denied && key === destination) throw new DOMException('Fixture storage full', 'QuotaExceededError')
+    originalSet.call(this, key, value)
+  })
+  const restored = vi.fn()
+  const notice = (route: typeof owner) => (
+    <UnassignedDraftNotice canRestore={() => true} empty onRestored={restored} owner={route} scope={id} />
+  )
+
+  try {
+    const view = render(notice(owner))
+    const retry = screen.getByRole('button', { name: 'Restore draft' })
+    retry.focus()
+    fireEvent.click(retry)
+    expect(restored).not.toHaveBeenCalled()
+    expect(screen.getByRole('alert').textContent).toBe('Could not restore the saved draft. Your current draft is unchanged.')
+    expect(document.activeElement).toBe(retry)
+    expect(takeSessionDraft(id, owner).text).toBe('')
+    expect(takeSessionDraft(id).text).toBe(text)
+    expect(localStorage.getItem(destination)).toBe(denied ? null : newer)
+
+    view.rerender(notice(other))
+    expect(screen.queryByRole('alert')).toBeNull()
+    view.rerender(notice(owner))
+
+    write.mockRestore()
+    if (!denied) localStorage.removeItem(destination)
+    fireEvent.click(retry)
+    expect(restored).toHaveBeenCalledExactlyOnceWith(text, [])
+    expect(screen.queryByRole('alert')).toBeNull()
+    expect(takeSessionDraft(id).text).toBe(text)
+    expect(JSON.parse(localStorage.getItem(destination)!).text).toBe(text)
+  } finally {
+    write.mockRestore()
+    localStorage.removeItem(destination)
+  }
+})
