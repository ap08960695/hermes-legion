diff --git a/apps/desktop/src/app/chat/composer/draft-recovery.tsx b/apps/desktop/src/app/chat/composer/draft-recovery.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d16697fb66483d9be85869f920824e6530c7ec4b
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/draft-recovery.tsx
@@ -0,0 +1,82 @@
+import { useStore } from '@nanostores/react'
+
+import { useStoreSelector } from '@/lib/use-session-slice'
+import { freshDraftScope, isFreshDraftScope } from '@/store/composer'
+import { draftOwnerKey } from '@/store/composer-draft-owner'
+import { missingRecoveredFiles } from '@/store/composer-draft-retry'
+import { $perSessionBrowse, isBrowsingHistory } from '@/store/composer-input-history'
+import type { SessionOwnerScope } from '@/store/session-request-router'
+
+import type { useComposerDraft } from './hooks/use-composer-draft'
+import { RestoredDraftNotice } from './restored-draft-notice'
+import { RecoveryFiles, RetainedSendNotice } from './retained-send-notice'
+import { useComposerScope } from './scope'
+import { UnassignedDraftNotice } from './unassigned-draft-notice'
+
+interface ComposerDraftRecoveryProps {
+  disabled: boolean
+  draft: ReturnType<typeof useComposerDraft>
+  scope: string | null
+  owner: SessionOwnerScope
+  sessionId?: string | null
+}
+
+/** Both recovery paths follow the editor owner without putting draft text in shell state. */
+export function ComposerDraftRecovery({ disabled, draft, scope, owner, sessionId }: ComposerDraftRecoveryProps) {
+  const composer = useComposerScope()
+  const attachments = useStore(composer.attachments.$attachments)
+  const browsingHistory = useStoreSelector(
+    $perSessionBrowse,
+    states => sessionId != null && (states[sessionId]?.cursor ?? -1) >= 0
+  )
+
+  return (
+    <>
+      <UnassignedDraftNotice
+        canRestore={() =>
+          !draft.getDraftRetry()?.recovery &&
+          !draft.syncDraftFromEditor().trim() &&
+          composer.attachments.$attachments.get().length === 0
+        }
+        empty={!draft.recovery && !draft.hasText && attachments.length === 0}
+        onRestored={(text, files) => {
+          draft.loadIntoComposer(text, files)
+          draft.requestMainFocus()
+        }}
+        owner={owner}
+        scope={scope}
+      />
+      <RetainedSendNotice
+        browsingHistory={browsingHistory}
+        disabled={disabled || attachments.some(file => file.uploadState === 'uploading')}
+        occupied={draft.hasText || attachments.length > 0 || Boolean(draft.recovery)}
+        onFocusComposer={draft.requestMainFocus}
+        onRestored={draft.loadRecoveredDraft}
+        owner={owner}
+        scope={scope}
+        readCurrent={() => {
+          const same =
+            (draft.draftScopeRef.current || freshDraftScope()) === (scope || freshDraftScope()) &&
+            draftOwnerKey(draft.draftOwnerRef.current) === draftOwnerKey(owner)
+          const current = composer.attachments.$attachments.get()
+          if (
+            !same ||
+            disabled ||
+            isBrowsingHistory(draft.sessionIdRef.current) ||
+            current.some(file => file.uploadState === 'uploading')
+          )
+            return undefined
+
+          return { text: draft.syncDraftFromEditor(), attachments: current }
+        }}
+      />
+      {draft.recovery && <RecoveryFiles {...missingRecoveredFiles(draft.recovery, attachments)} />}
+      <RestoredDraftNotice
+        freshDraft={scope === null || isFreshDraftScope(scope)}
+        onUndone={draft.clearDraft}
+        owner={owner}
+        readLiveText={draft.syncDraftFromEditor}
+      />
+    </>
+  )
+}
