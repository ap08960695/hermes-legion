+++ b/tests/agent/test_pet_pack_import.py
@@ -0,0 +1,282 @@
+"""New creator imports publish once without replacing any existing store entry."""
+from concurrent.futures import ThreadPoolExecutor
+import errno
+import json
+from pathlib import Path
+from threading import Barrier
+from types import SimpleNamespace
+
+import pytest
+from PIL import Image, ImageDraw
+
+
+def files(root):
+    return {str(p.relative_to(root)): p.read_bytes() for p in root.rglob("*") if p.is_file() and not p.is_symlink()}
+
+
+@pytest.fixture
+def creator(tmp_path, monkeypatch):
+    from agent.pet import store
+
+    home = tmp_path / "profile"
+    home.mkdir()
+    (home / "config.yaml").write_text("display:\n  pet:\n    enabled: false\n    slug: old\n")
+    old = home / "pets/old"
+    old.mkdir(parents=True)
+    (old / "pet.json").write_text('{"id":"old","displayName":"Existing","spritesheetPath":"spritesheet.png"}')
+    (old / "spritesheet.png").write_bytes(b"existing owner bytes")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(store, "get_hermes_home", lambda: home)
+    source = tmp_path / "creator"
+    source.mkdir()
+    meta = {"schema_version": 1, "format": "hermes-native-atlas", "name": "โคมไฟ",
+            "author": "Artist", "licence": "CC0-1.0", "spritesheet": "spritesheet.png"}
+    (source / "manifest.json").write_text(json.dumps(meta))
+    image = Image.new("RGBA", (1536, 1872))
+    draw = ImageDraw.Draw(image)
+    for row in range(9):
+        draw.rectangle((40, row * 208 + 30, 150, row * 208 + 180), fill="teal")
+    image.save(source / "spritesheet.png")
+    return source, home, meta
+
+
+@pytest.mark.platforms("macos", "linux", "windows")
+def test_import_preserves_creator_metadata_and_existing_entries(creator):
+    from agent.pet import importer, store
+
+    source, home, meta = creator
+    before = files(home)
+    (source / "ignored.py").write_text("raise RuntimeError('must never execute')")
+    pet, warnings = importer.import_pack(source, "creator")
+    assert pet == store.load_pet("creator") and pet.exists and not pet.generated
+    assert not warnings and pet.display_name == "โคมไฟ"
+    assert json.loads((pet.directory / "manifest.json").read_text()) == meta
+    assert set(p.name for p in pet.directory.iterdir()) == {"manifest.json", "pet.json", "spritesheet.png"}
+    assert pet.spritesheet.read_bytes() == (source / "spritesheet.png").read_bytes()
+    assert all((home / n).read_bytes() == data for n, data in before.items())
+    assert {p.slug for p in store.installed_pets()} == {"old", "creator"}
+    assert not list((home / "pets").glob(".pet-import-*"))
+
+
+@pytest.mark.platforms("macos", "linux", "windows")
+@pytest.mark.parametrize("weight", ["light", "standard", "heavy"])
+def test_import_preserves_motion_weight(creator, weight):
+    from agent.pet import importer, store
+
+    source, _, meta = creator
+    (source / "manifest.json").write_text(json.dumps({**meta, "motion_weight": weight}))
+    pet, _ = importer.import_pack(source, "creator")
+    assert pet.motion_weight == store.load_pet("creator").motion_weight == weight
+    assert json.loads((pet.directory / "pet.json").read_text())["motionWeight"] == weight
+
+
+@pytest.mark.parametrize("weight", [None, "medium", 1, []])
+def test_invalid_motion_weight_fails_pack_lint(creator, weight):
+    from agent.pet.pack import validate_pack
+
+    source, _, meta = creator
+    (source / "manifest.json").write_text(json.dumps({**meta, "motion_weight": weight}))
+    with pytest.raises(ValueError, match="motion_weight"):
+        validate_pack(source)
+
+
+@pytest.mark.platforms("macos", "linux", "windows")
+def test_webp_import_keeps_native_store_and_renderer_compatibility(creator):
+    from agent.pet import importer, render, store
+
+    source, _, meta = creator
+    with Image.open(source / "spritesheet.png") as image:
+        image.save(source / "spritesheet.webp", lossless=True)
+    meta["spritesheet"] = "spritesheet.webp"
+    (source / "manifest.json").write_text(json.dumps(meta))
+    pet, _ = importer.import_pack(source, "creator")
+    assert store.load_pet("creator").spritesheet == pet.spritesheet
+    assert pet.spritesheet.name == "spritesheet.webp"
+    assert pet.spritesheet.read_bytes() == (source / "spritesheet.webp").read_bytes()
+    assert render.PetRenderer(pet.spritesheet, mode="unicode").frame_count("idle") > 0
+
+
+@pytest.mark.platforms("macos", "linux", "windows")
+@pytest.mark.parametrize("kind", ["file", "empty", "populated"])
+def test_import_never_replaces_existing_entry_even_empty_directory(creator, kind):
+    from agent.pet import importer
+
+    source, home, _ = creator
+    target = home / "pets/occupied"
+    if kind == "file":
+        target.write_bytes(b"keep file")
+    else:
+        target.mkdir()
+        if kind == "populated":
+            (target / "keep").write_bytes(b"keep directory")
+    before = files(home)
+    identity = target.lstat().st_ino
+    with pytest.raises(OSError):
+        importer.import_pack(source, "occupied")
+    assert files(home) == before and target.lstat().st_ino == identity
+    assert not list((home / "pets").glob(".pet-import-*"))
+
+
+@pytest.mark.platforms("macos", "linux")
+@pytest.mark.parametrize("dangling", [False, True])
+def test_import_preserves_destination_symlinks(creator, dangling):
+    from agent.pet import importer
+
+    source, home, _ = creator
+    target = home / "pets/occupied"
+    target.symlink_to(home / ("missing" if dangling else "pets/old"), target_is_directory=True)
+    before = files(home)
+    with pytest.raises(OSError):
+        importer.import_pack(source, "occupied")
+    assert target.is_symlink() and files(home) == before
+    assert not list((home / "pets").glob(".pet-import-*"))
+
+
+@pytest.mark.platforms("macos", "linux", "windows")
+def test_staging_is_invisible_and_uses_exact_loaded_bytes(creator, monkeypatch):
+    from agent.pet import importer, store
+
+    source, home, meta = creator
+    original = (source / "spritesheet.png").read_bytes()
+    publish = importer._publish_new_directory
+    def observe(staged, target):
+        assert {p.slug for p in store.installed_pets()} == {"old"}
+        assert set(p.name for p in staged.iterdir()) == {"pet.json", "manifest.json", "spritesheet.png"}
+        (source / "spritesheet.png").write_bytes(b"source replaced after validation")
+        (source / "manifest.json").write_bytes(b"metadata replaced after validation")
+        return publish(staged, target)
+    monkeypatch.setattr(importer, "_publish_new_directory", observe)
+    pet, _ = importer.import_pack(source, "creator")
+    assert pet.spritesheet.read_bytes() == original
+    assert json.loads((pet.directory / "manifest.json").read_text()) == meta
+    assert not list((home / "pets").glob(".pet-import-*"))
+
+
+@pytest.mark.platforms("macos", "linux", "windows")
+def test_destination_created_at_publication_is_preserved(creator, monkeypatch):
+    from agent.pet import importer
+
+    source, home, _ = creator
+    publish = importer._publish_new_directory
+    identity = []
+    def race(staged, target):
+        target.mkdir()
+        identity.append(target.stat().st_ino)
+        return publish(staged, target)
+    monkeypatch.setattr(importer, "_publish_new_directory", race)
+    with pytest.raises(OSError):
+        importer.import_pack(source, "creator")
+    target = home / "pets/creator"
+    assert target.is_dir() and target.stat().st_ino == identity[0] and not list(target.iterdir())
+    assert not list((home / "pets").glob(".pet-import-*"))
+
+
+@pytest.mark.platforms("macos", "linux", "windows")
+def test_two_importers_have_exactly_one_winner(creator, monkeypatch):
+    from agent.pet import importer, store
+
+    source, home, _ = creator
+    publish = importer._publish_new_directory
+    barrier = Barrier(2)
+    def race(staged, target):
+        barrier.wait(timeout=10)
+        return publish(staged, target)
+    monkeypatch.setattr(importer, "_publish_new_directory", race)
+    def run():
+        try:
+            return importer.import_pack(source, "creator")[0].slug
+        except OSError:
+            return "collision"
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(pool.map(lambda _: run(), range(2)))
+    assert sorted(results) == ["collision", "creator"]
+    assert {p.slug for p in store.installed_pets()} == {"old", "creator"}
+    assert not list((home / "pets").glob(".pet-import-*"))
+
+
+@pytest.mark.parametrize("filename", ["manifest.json", "pet.json", "spritesheet.png"])
+def test_stage_write_failure_preserves_store_and_settings(creator, monkeypatch, filename):
+    from agent.pet import importer
+
+    source, home, _ = creator
+    before = files(home)
+    write = Path.write_bytes
+    def fail(path, data):
+        if path.parent.parent.name.startswith(".pet-import-") and path.name == filename:
+            raise OSError("stage write refused")
+        return write(path, data)
+    monkeypatch.setattr(Path, "write_bytes", fail)
+    with pytest.raises(OSError, match="stage write refused"):
+        importer.import_pack(source, "creator")
+    assert files(home) == before and not (home / "pets/creator").exists()
+    assert not list((home / "pets").glob(".pet-import-*"))
+
+
+def test_publish_failure_preserves_store_and_settings(creator, monkeypatch):
+    from agent.pet import importer
+
+    source, home, _ = creator
+    before = files(home)
+    def fail(*args):
+        raise OSError(errno.ENOTSUP, "no safe publication")
+    monkeypatch.setattr(importer, "_publish_new_directory", fail)
+    with pytest.raises(OSError, match="no safe publication"):
+        importer.import_pack(source, "creator")
+    assert files(home) == before and not list((home / "pets").glob(".pet-import-*"))
+
+
+@pytest.mark.platforms("macos", "linux", "windows")
+@pytest.mark.parametrize("published", [False, True])
+def test_cleanup_error_does_not_change_commit_or_primary_failure(creator, monkeypatch, caplog, published):
+    from agent.pet import importer, store
+
+    source, home, _ = creator
+    before = files(home)
+    cleanup = importer.shutil.rmtree
+    def fail_cleanup(*args, **kwargs):
+        raise OSError("cleanup refused")
+    monkeypatch.setattr(importer.shutil, "rmtree", fail_cleanup)
+    if not published:
+        def fail_publish(*args):
+            raise OSError("publication refused")
+        monkeypatch.setattr(importer, "_publish_new_directory", fail_publish)
+    try:
+        if published:
+            assert importer.import_pack(source, "creator")[0].exists
+            assert store.load_pet("creator").exists
+        else:
+            with pytest.raises(OSError, match="publication refused"):
+                importer.import_pack(source, "creator")
+            assert not (home / "pets/creator").exists()
+        assert "staging cleanup failed" in caplog.text
+    finally:
+        for path in (home / "pets").glob(".pet-import-*"):
+            cleanup(path)
+    assert all((home / n).read_bytes() == data for n, data in before.items())
+
+
+@pytest.mark.platforms("macos", "linux")
+def test_missing_native_capability_has_no_unsafe_rename_fallback(creator, monkeypatch):
+    from agent.pet import importer
+
+    source, home, _ = creator
+    before = files(home)
+    monkeypatch.setattr(importer.ctypes, "CDLL", lambda *args, **kwargs: SimpleNamespace())
+    def forbidden(*args):
+        pytest.fail("must not fall back to overwriting rename")
+    monkeypatch.setattr(importer.os, "rename", forbidden)
+    with pytest.raises(OSError, match="no-replace"):
+        importer.import_pack(source, "creator")
+    assert files(home) == before and not list((home / "pets").glob(".pet-import-*"))
+
+
+@pytest.mark.parametrize("slug", ["", "Name", "../escape", "a/b", "a--b", ".hidden", "x" * 65])
+def test_noncanonical_slug_fails_before_store_access(creator, monkeypatch, slug):
+    from agent.pet import importer, store
+
+    source, _, _ = creator
+    def forbidden():
+        pytest.fail("invalid slug must not touch the store")
+    monkeypatch.setattr(store, "pets_dir", forbidden)
+    with pytest.raises(ValueError, match="slug"):
+        importer.import_pack(source, slug)
