@@ -0,0 +1,26 @@
+"""Lazy skill-name preflight using native traversal and the existing catalog cache."""
+import os
+from pathlib import Path
+
+
+def skills_available_in(directories, skills):
+    """Keep ordinary names without reading bodies; resolve other names in one batch."""
+    from agent.skill_utils import (
+        TIER_EXTERNAL, TIER_LOCAL, iter_skill_index_directories,
+    )
+
+    roots = [(TIER_LOCAL if index == 0 else TIER_EXTERNAL, Path(directory))
+             for index, directory in enumerate(directories)]
+    have = set()
+    for _tier, root in roots:
+        for path, _dirs, files, _info in iter_skill_index_directories(root):
+            if "SKILL.md" in files:
+                have.add(os.path.basename(path))
+    if any(str(name).rstrip("/").split("/")[-1] not in have for name in skills):
+        from tools.skills_tool import _skill_catalog
+
+        have.update(row["load_name"] for row in _skill_catalog(
+            skip_disabled=True, include_hidden=True, roots=roots) if row["load_name"])
+    kept = [name for name in skills if str(name).rstrip("/") in have
+            or str(name).rstrip("/").split("/")[-1] in have]
+    return kept, [name for name in skills if name not in kept]
