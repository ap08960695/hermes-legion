--- /dev/null
+++ b/tests/hermes_cli/test_config_backup_publication.py
@@ -0,0 +1,100 @@
+"""Config recovery sees complete, ordered backups, including rapid and parallel saves."""
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+import itertools
+import threading
+
+from hermes_cli import config_backups as backups
+
+
+def test_distinct_configs_saved_in_one_clock_tick_both_survive(tmp_path, monkeypatch):
+    monkeypatch.setattr(backups.time, 'strftime', lambda fmt: '20260101-000000')
+    path = tmp_path / 'config.yaml'
+    path.write_text('model: first\n')
+    first = backups.backup_config(path, 'good')
+    path.write_text('model: latest\n')
+    second = backups.backup_config(path, 'good')
+    assert second is not None and second != first
+    assert first.read_text() == 'model: first\n'
+    assert backups.load_newest_good_backup(path) == {'model': 'latest'}
+    assert len(backups.list_config_backups(path, 'good')) == 2
+    assert backups.backup_config(path, 'good') is None
+
+
+def test_recovery_cannot_observe_a_partially_copied_good_file(tmp_path, monkeypatch):
+    path = tmp_path / 'config.yaml'
+    path.write_text('model: first\n')
+    monkeypatch.setattr(backups.time, 'strftime', lambda fmt: '20260101-000000')
+    first = backups.backup_config(path, 'good')
+    path.write_text('model: latest\n')
+    monkeypatch.setattr(backups.time, 'strftime', lambda fmt: '20260101-000001')
+    native = backups.shutil.copy2
+    entered, release = threading.Event(), threading.Event()
+
+    def partial(source, target, *args, **kwargs):
+        Path(target).write_text('model: [')
+        entered.set()
+        assert release.wait(8), 'observer must release private file copy'
+        return native(source, target, *args, **kwargs)
+
+    monkeypatch.setattr(backups.shutil, 'copy2', partial)
+    with ThreadPoolExecutor(max_workers=1) as executor:
+        pending = executor.submit(backups.backup_config, path, 'good')
+        try:
+            assert entered.wait(8)
+            during_copy = backups.load_newest_good_backup(path)
+        finally:
+            release.set()
+        assert pending.result(timeout=8) is not None
+    assert during_copy == {'model': 'first'}
+    assert backups.load_newest_good_backup(path) == {'model': 'latest'}
+    assert first.read_text() == 'model: first\n'
+
+
+def test_failed_copy_leaves_the_previous_good_backup_usable(tmp_path, monkeypatch):
+    path = tmp_path / 'config.yaml'
+    path.write_text('model: first\n')
+    monkeypatch.setattr(backups.time, 'strftime', lambda fmt: '20260101-000000')
+    first = backups.backup_config(path, 'good')
+    path.write_text('model: latest\n')
+    monkeypatch.setattr(backups.time, 'strftime', lambda fmt: '20260101-000001')
+
+    def fail(source, target, *args, **kwargs):
+        Path(target).write_text('model: [')
+        raise OSError('fixture copy failed after a partial write')
+
+    monkeypatch.setattr(backups.shutil, 'copy2', fail)
+    assert backups.backup_config(path, 'good') is None
+    assert backups.load_newest_good_backup(path) == {'model': 'first'}
+    root = backups.backups_dir(path)
+    assert list(root.iterdir()) == [first], 'failed publication must remove its private staging file'
+
+
+def test_parallel_publication_retains_only_the_configured_count(tmp_path, monkeypatch):
+    path = tmp_path / 'config.yaml'
+    clock = itertools.count()
+    clock_lock = threading.Lock()
+
+    def stamp(fmt):
+        with clock_lock:
+            return f'20260101-{next(clock):06d}'
+
+    monkeypatch.setattr(backups.time, 'strftime', stamp)
+    path.write_text('model: first\n')
+    backups.backup_config(path, 'good', keep=2)
+    path.write_text('model: latest\n')
+    native = backups.shutil.copy2
+    copying = threading.Barrier(6)
+
+    def synchronized(source, target, *args, **kwargs):
+        copying.wait(timeout=8)
+        return native(source, target, *args, **kwargs)
+
+    monkeypatch.setattr(backups.shutil, 'copy2', synchronized)
+    with ThreadPoolExecutor(max_workers=6) as executor:
+        results = list(executor.map(lambda _: backups.backup_config(path, 'good', keep=2), range(6)))
+    assert all(p is not None for p in results)
+    kept = backups.list_config_backups(path, 'good')
+    assert len(kept) == 2
+    assert all(p.read_text() == 'model: latest\n' for p in kept)
+    assert set(backups.backups_dir(path).iterdir()) == set(kept)
