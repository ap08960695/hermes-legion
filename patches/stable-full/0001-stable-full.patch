+"""Recorded usage projections do not turn storage defaults into known zero cost."""
+import pytest
+
+from agent.session_activity import session_row_progress
+
+
+@pytest.mark.parametrize('status,estimate,reported,expected', [
+    (None, None, None, (None, None)),
+    (None, 0, 0, (None, None)),
+    ('unknown', 0, 0, (None, None)),
+    ('included', 0, 0, (None, None)),
+    ('estimated', 0, 0, (0, None)),
+    ('actual', 0, 0, (None, 0)),
+    ('unknown', 1.25, .7, (1.25, .7)),
+    ('included', .004, .003, (.004, .003)),
+    ('estimated', -1, -2, (None, None)),
+    ('actual', float('nan'), float('inf'), (None, None)),
+    ('estimated', '1.2', '2.3', (None, None)),
+    ('actual', True, False, (None, None)),
+    ('estimated', 10**500, object(), (None, None)),
+])
+def test_recorded_amounts_keep_unknown_zero_and_partial_coverage_distinct(status, estimate, reported, expected):
+    result = session_row_progress({'cost_status': status, 'estimated_cost_usd': estimate,
+                                   'actual_cost_usd': reported})
+    assert (result['estimated_cost_usd'], result['actual_cost_usd']) == expected
+
+
+@pytest.mark.parametrize('model,expected', [(None, None), ('', None), (3, None),
+                                           ('  worker-route  ', 'worker-route'), ('x' * 300, 'x' * 256)])
+def test_recorded_model_is_bounded_without_borrowing_configured_route(model, expected):
+    result = session_row_progress({'model': model, 'model_config': {'model': 'not-the-recorded-model',
+                                                                  'api_key': 'private-config-canary'}})
+    assert result['model'] == expected
+    assert 'private-config-canary' not in str(result)
