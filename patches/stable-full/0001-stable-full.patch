+"""Import is explicit, non-selecting and compatible with the normal pet store."""
+import argparse
+import json
+
+import pytest
+from PIL import Image, ImageDraw
+
+from hermes_cli.subcommands.pets import build_pets_parser
+
+
+@pytest.fixture
+def creator(tmp_path, monkeypatch):
+    from agent.pet import store
+    from hermes_cli import pets
+
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(store, "get_hermes_home", lambda: home)
+    config = home / "config.yaml"
+    config.write_text("display:\n  pet:\n    enabled: false\n    slug: existing\n")
+    def forbidden(*args, **kwargs):
+        pytest.fail("import must not read pet settings or auto-select")
+    monkeypatch.setattr(pets, "_pet_config", forbidden)
+    monkeypatch.setattr(pets, "_set_active", forbidden)
+    root = tmp_path / "pack"
+    root.mkdir()
+    (root / "manifest.json").write_text(json.dumps({
+        "schema_version": 1, "format": "hermes-native-atlas", "name": "Creator pack",
+        "author": "Artist", "licence": "CC0-1.0", "spritesheet": "spritesheet.png",
+    }))
+    image = Image.new("RGBA", (1536, 1872))
+    draw = ImageDraw.Draw(image)
+    for row in range(9):
+        draw.rectangle((40, row * 208 + 30, 150, row * 208 + 180), fill="teal")
+    image.save(root / "spritesheet.png")
+    return root, home
+
+
+def invoke(*words):
+    parser = argparse.ArgumentParser()
+    build_pets_parser(parser.add_subparsers())
+    args = parser.parse_args(["pets", *map(str, words)])
+    return args.func(args)
+
+
+@pytest.mark.platforms("macos", "linux", "windows")
+def test_import_lists_and_removes_without_selecting(creator, capsys):
+    from agent.pet import store
+
+    root, home = creator
+    config = (home / "config.yaml").read_bytes()
+    original = {p.name: p.read_bytes() for p in root.iterdir()}
+    assert invoke("import", root, "creator") == 0
+    out = capsys.readouterr()
+    assert "Creator pack" in out.out and "hermes pets select creator" in out.out
+    assert not out.err and (home / "config.yaml").read_bytes() == config
+    assert {p.name: p.read_bytes() for p in root.iterdir()} == original
+    assert invoke("list", "--installed") == 0
+    assert "Creator pack" in capsys.readouterr().out
+    assert store.load_pet("creator").exists
+    assert invoke("remove", "creator") == 0
+    assert store.load_pet("creator") is None
+    assert (home / "config.yaml").read_bytes() == config
+
+
+@pytest.mark.platforms("macos", "linux", "windows")
+def test_second_import_reports_collision_without_changing_first(creator, capsys):
+    root, home = creator
+    assert invoke("import", root, "creator") == 0
+    capsys.readouterr()
+    installed = home / "pets/creator"
+    before = {p.name: p.read_bytes() for p in installed.iterdir()}
+    assert invoke("import", root, "creator") == 1
+    assert "cannot import pack" in capsys.readouterr().err
+    assert before == {p.name: p.read_bytes() for p in installed.iterdir()}
+    assert not list((home / "pets").glob(".pet-import-*"))
+
+
+@pytest.mark.parametrize("bad", ["slug", "pack", "image"])
+def test_invalid_input_is_visible_before_creating_store(creator, capsys, bad):
+    root, home = creator
+    slug = "../escape" if bad == "slug" else "creator"
+    if bad == "pack":
+        (root / "manifest.json").write_bytes(b"invalid json")
+    elif bad == "image":
+        Image.new("RGBA", (1536, 1872)).save(root / "spritesheet.png")
+    assert invoke("import", root, slug) == 1
+    assert "cannot import pack" in capsys.readouterr().err
+    assert not (home / "pets").exists()
+
+
+@pytest.mark.platforms("macos", "linux", "windows")
+def test_partial_pack_warnings_do_not_auto_select(creator, capsys):
+    root, home = creator
+    image = Image.new("RGBA", (1536, 1872))
+    ImageDraw.Draw(image).rectangle((40, 30, 150, 180), fill="teal")
+    image.save(root / "spritesheet.png")
+    before = (home / "config.yaml").read_bytes()
+    assert invoke("import", root, "creator") == 0
+    assert "state 'waving' has no frames" in capsys.readouterr().out
+    assert (home / "config.yaml").read_bytes() == before
