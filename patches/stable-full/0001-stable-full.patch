+import { $botManagementOpen, requestBotManagement } from './management'
+export function BotWorkspaceActions() {
+  const b = useBots(),
+    management = useValue($botManagementOpen)
+  return (
+    <div className="flex flex-wrap items-center gap-2">
+      <Button size="sm" variant="ghost" aria-pressed={management} onClick={() => $botManagementOpen.set(!management)}>
+        <Codicon name="organization" />
