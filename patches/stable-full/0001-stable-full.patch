+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, describe, expect, it } from "vitest";
+
+import { Markdown } from "./Markdown";
+
+let root: Root | null = null;
+let host: HTMLDivElement | null = null;
+
+function render(content: string): HTMLDivElement {
+  host = document.createElement("div");
+  document.body.appendChild(host);
+  root = createRoot(host);
+  act(() => root!.render(<Markdown content={content} />));
+  return host;
+}
+
+afterEach(() => {
+  act(() => root?.unmount());
+  host?.remove();
+  root = null;
+  host = null;
+});
+
+describe("Markdown", () => {
+  it("renders a GitHub table instead of a pipe-filled paragraph", () => {
+    const el = render("Intro\n| Bot | State |\n| --- | :---: |\n| a | **busy** |\n| b | idle |\nAfter");
+    const cells = [...el.querySelectorAll("th, td")].map((c) => c.textContent);
+    expect(cells).toEqual(["Bot", "State", "a", "busy", "b", "idle"]);
+    expect(el.querySelector("td strong")?.textContent).toBe("busy");
+    expect(el.textContent).toContain("Intro");
+    expect(el.textContent).toContain("After");
+  });
+
+  it("labels a fenced block with its language", () => {
+    const el = render("```mermaid\ngraph TD; A-->B\n```");
+    expect(el.querySelector("pre span")?.textContent).toBe("mermaid");
+    expect(el.querySelector("pre code")?.textContent).toContain("A-->B");
+  });
+
+  it("keeps a lone pipe line as text", () => {
+    const el = render("a | b");
+    expect(el.querySelector("table")).toBeNull();
+    expect(el.textContent).toBe("a | b");
+  });
+});
