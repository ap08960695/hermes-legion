new file mode 100644
index 0000000000000000000000000000000000000000..dba29bf463282724664387446e7cfc4213e3e420
--- /dev/null
+++ b/tools/process_registry_tool_output.py
@@ -0,0 +1,74 @@
+"""Presentation of process results to model tools, separate from UI snapshots."""
+from contextlib import suppress
+from hashlib import sha256
+
+
+def compact_progress(result: dict, session, caller: tuple, action: str) -> dict:
+    """Suppress an unchanged running preview only for the same known tool caller.
+
+    One bounded fingerprint lives with the process; a different caller gets the full
+    preview. UI reads, durable logs, completion delivery and past history are untouched.
+    """
+    if not all(caller) or session is None or action not in {'poll', 'wait'}:
+        return result
+    if result.get('status') not in {'running', 'timeout'}:
+        return result
+    key = 'output_preview' if action == 'poll' else 'output'
+    output = result.get(key)
+    if not output:
+        return result
+    with session._lock:
+        fingerprint = (caller, session.total_output_chars, sha256(output.encode()).digest(),
+                       result.get('note'), result.get('timeout_note'), result.get('notify_on_complete'))
+        previous = session._tool_progress_fingerprint
+        unchanged = previous is not None and previous[:3] == fingerprint[:3]
+        same_instruction = previous is not None and previous[3:] == fingerprint[3:]
+        session._tool_progress_fingerprint = fingerprint
+    if not unchanged:
+        return result
+    compact = dict(result, **{key: ''}, output_unchanged=True)
+    # The first or changed completion instruction is shown in full. Repeating it
+    # on every silent poll wastes the same context as repeating the log preview.
+    if compact.get('notify_on_complete') and same_instruction:
+        compact.pop('note', None)
+        compact.pop('timeout_note', None)
+    return compact
+
+
+def list_processes(task_id) -> dict:
+    from tools.process_registry import _redact_process_result, process_registry
+
+    session_key = ''
+    with suppress(Exception):
+        from tools.approval_context import get_current_session_key
+        session_key = get_current_session_key(default='') or ''
+    return {'processes': [
+        _redact_process_result(p)
+        for p in process_registry.list_sessions(
+            task_id=task_id, session_key=session_key or None, include_retained=True)]}
+
+
+_OTHER_LINE_BREAKS = ("\r", "\v", "\f", "\x1c", "\x1d", "\x1e", "\x85", "\u2028", "\u2029")
+
+
+def log_page(text: str, offset: int | None, limit: int) -> tuple[list[str], int, bool]:
+    """Common LF tails avoid materializing every line; unusual separators retain splitlines semantics."""
+    if offset is None and limit > 0 and not any(separator in text for separator in _OTHER_LINE_BREAKS):
+        total = text.count("\n") + bool(text and not text.endswith("\n"))
+        end = len(text) - int(text.endswith("\n"))
+        start = end
+        for _ in range(min(limit, total)):
+            start = text.rfind("\n", 0, start)
+            if start < 0:
+                break
+        selected = text[start + 1:end].split("\n") if text else []
+        return selected, total, bool(selected) or total == 0
+    lines = text.splitlines()
+    total = len(lines)
+    if offset is None and limit > 0:
+        selected = lines[-limit:]
+        return selected, total, bool(selected) or total == 0
+    offset = offset or 0
+    selected = lines[offset:offset + limit]
+    stop = slice(offset, offset + limit).indices(total)[1]
+    return selected, total, total == 0 or (bool(selected) and stop == total)
