@@ -0,0 +1,101 @@
+"""High-volume sessions must not hide other eligible recall candidates."""
+
+import json
+
+import pytest
+
+from hermes_state import SessionDB
+from tools.session_search_tool import _DISCOVER_SCAN_LIMIT
+from tools.registry import registry
+
+
+@pytest.mark.parametrize("case", ["excluded_root", "excluded_child", "duplicates", "current", "compacted", "cron"])
+@pytest.mark.parametrize("query, storage", [("recallfixture", "fts"), ("记忆", "readonly"), ("ความจำ", "like")])
+def test_recall_survives_raw_candidate_saturation(tmp_path, monkeypatch, case, query, storage):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        db.create_session("old", source="cli")
+        wanted_session = "flood" if case == "compacted" else "old"
+        db.create_session("flood-root", source="cli")
+        db.create_session("flood", source="cron" if case == "cron" else "cli", parent_session_id="flood-root")
+        wanted = db.append_message(wanted_session, role="user",
+                                   content=f"{query} saved checksum decision", timestamp=1_600_000_000)
+        if case == "compacted":
+            db._conn.execute("UPDATE messages SET active=0, compacted=1 WHERE id=?", (wanted,))
+            db._conn.commit()
+        for i in range(_DISCOVER_SCAN_LIMIT + 1):
+            db.append_message("flood", role="user", content=f"{query} recent chatter",
+                              timestamp=1_700_000_000 + i)
+        if storage == "readonly":
+            db.close()
+            db = SessionDB(tmp_path / "state.db", read_only=True)
+        if storage == "like":
+            db._fts_stale = True
+            monkeypatch.setattr(db, "_refresh_fts_stale_state", lambda: None)
+        args = {"query": query, "limit": 2, "sort": "newest"}
+        if case.startswith("excluded_"):
+            args["exclude_session_ids"] = ["flood-root" if case == "excluded_root" else "flood"]
+        current = "flood" if case in ("current", "compacted") else None
+        payload = json.loads(registry.dispatch("session_search", args, db=db, current_session_id=current))
+        assert payload["success"]
+        entries = payload["results"]
+        assert any(entry["match_message_id"] == wanted for entry in entries)
+        if case.startswith("excluded_") or case == "current":
+            assert all(entry["session_id"] == "old" for entry in entries)
+        if case == "cron":
+            assert entries[0]["session_id"] == "old"
+        if case == "compacted":
+            assert entries[0]["match_message_id"] == wanted
+    finally:
+        db.close()
+
+
+@pytest.mark.parametrize("source", ["cli", "cron"])
+def test_refill_does_not_relax_a_query_that_already_has_an_exact_hit(tmp_path, source):
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session("exact", source=source)
+        exact = db.append_message("exact", role="user", content="amber violet", timestamp=1000)
+        db.create_session("partial", source="cli")
+        db.append_message("partial", role="user", content="amber unrelated", timestamp=2000)
+        result = json.loads(registry.dispatch("session_search", {"query": "amber violet", "limit": 3}, db=db))
+        assert result["success"]
+        assert [entry["match_message_id"] for entry in result["results"]] == [exact]
+
+
+def test_refill_is_bounded_by_requested_lineages_not_message_volume(tmp_path, monkeypatch):
+    with SessionDB(tmp_path / "state.db") as db:
+        for index in range(12):
+            sid = f"archive-{index}"
+            db.create_session(sid, source="cli")
+            for message in range(30):
+                db.append_message(sid, role="user", content="boundedfixture decision", timestamp=index * 100 + message)
+        read = db.search_messages
+        calls, returned = [], []
+
+        def observe(*args, **kwargs):
+            rows = read(*args, **kwargs)
+            calls.append(kwargs["limit"])
+            returned.append(len(rows))
+            return rows
+
+        monkeypatch.setattr(db, "search_messages", observe)
+        result = json.loads(registry.dispatch("session_search", {"query": "boundedfixture", "limit": 5}, db=db))
+        assert result["success"] and len(result["results"]) == 5
+        assert len({entry["session_id"] for entry in result["results"]}) == 5
+        assert len(calls) <= 5 and sum(returned) <= 15
+        assert max(calls) <= 5
+
+
+def test_parent_cycle_cannot_loop_or_escape_an_excluded_lineage(tmp_path):
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session("cycle-a", source="cli")
+        db.create_session("cycle-b", source="cli", parent_session_id="cycle-a")
+        db._conn.execute("UPDATE sessions SET parent_session_id='cycle-b' WHERE id='cycle-a'")
+        db._conn.commit()
+        db.append_message("cycle-b", role="user", content="cyclefixture chatter")
+        db.create_session("archive", source="cli")
+        wanted = db.append_message("archive", role="user", content="cyclefixture decision")
+        result = json.loads(registry.dispatch("session_search", {
+            "query": "cyclefixture", "exclude_session_ids": ["cycle-a"]}, db=db))
+        assert result["success"]
+        assert [entry["match_message_id"] for entry in result["results"]] == [wanted]
