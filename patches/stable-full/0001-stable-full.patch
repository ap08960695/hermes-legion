+"""Native self-goals preserve profile/session scope, owner state and turn limits."""
+
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import json
+from pathlib import Path
+import queue
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import goals
+from gateway.session_context import scoped_current_session_id
+
+OBJECTIVE = ('Deliver the approved artifact\n'
+             'outcome: The artifact exists and all requested checks pass\n'
+             'verification: Inspect the artifact and run the offline test suite\n'
+             'constraints: Keep current quotas, permissions and provider settings\n'
+             'boundaries: The assigned working directory')
+
+
+@pytest.fixture
+def own_session(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    home = tmp_path / 'owner'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_SESSION_ID', 'self')
+    (home / 'config.yaml').write_text('goals:\n  max_turns: 7\n  allow_self_management: true\n')
+    goals._DB_CACHE.clear()
+    db = goals._get_session_db()
+    assert db is not None
+    db.create_session('self', source='cli')
+    db.create_session('other', source='cli')
+    with scoped_current_session_id('self'):
+        yield home, db
+    goals._DB_CACHE.clear()
+
+
+def _parse(argv):
+    from hermes_cli.subcommands.sessions import build_sessions_parser
+    parser = argparse.ArgumentParser()
+    build_sessions_parser(parser.add_subparsers(dest='command'), cmd_sessions=lambda args: None)
+    return parser.parse_args(argv)
+
+
+def test_native_goal_subcommand_is_available_without_starting_a_chat(own_session, capsys):
+    args = _parse(['goal', 'status'])
+    assert args.func(args) == 0
+    result = json.loads(capsys.readouterr().out)
+    assert result['session_id'] == 'self' and result['goal_present'] is False
+
+
+def test_ensure_creates_native_contract_once_without_judge_or_budget_change(own_session, monkeypatch):
+    from hermes_cli import goal_self
+    home, db = own_session
+    config = (home / 'config.yaml').read_bytes()
+
+    def forbidden(*args, **kwargs):
+        pytest.fail('Setting a self-goal must not request inference')
+
+    monkeypatch.setattr(goals, 'judge_goal', forbidden)
+    first = goal_self.ensure_current_goal(OBJECTIVE)
+    raw = db.get_meta('goal:self')
+    state = goals.load_goal('self')
+    assert first['created'] is True and first['status'] == 'active'
+    assert state.goal == 'Deliver the approved artifact'
+    assert state.max_turns == 7 and state.turns_used == 0
+    assert state.contract.outcome == 'The artifact exists and all requested checks pass'
+    assert state.contract.verification == 'Inspect the artifact and run the offline test suite'
