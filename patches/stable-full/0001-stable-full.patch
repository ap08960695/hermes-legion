diff --git a/tests/hermes_cli/test_update_preserve_interruption.py b/tests/hermes_cli/test_update_preserve_interruption.py
new file mode 100644
index 0000000000000000000000000000000000000000..0873ac72c258f258dbda6f0a43c3159dde7f82b9
--- /dev/null
+++ b/tests/hermes_cli/test_update_preserve_interruption.py
@@ -0,0 +1,195 @@
+"""Killed preserving updates recover source customizations before application startup."""
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import sys
+
+import pytest
+
+from hermes_cli import _launchers
+from tests.hermes_cli.test_update_recovery_closure import BOOT
+from tests.hermes_cli.test_update_target_identity import git
+
+SOURCE = Path(__file__).resolve().parents[2]
+
+
+def prepared_install(tmp_path, monkeypatch, *, local_recovery=False, target_addition=False):
+    monkeypatch.setenv('GIT_CONFIG_NOSYSTEM', '1')
+    monkeypatch.setenv('GIT_CONFIG_GLOBAL', str(tmp_path / 'gitconfig'))
+    root = tmp_path / 'checkout'
+    for name in BOOT:
+        source = SOURCE / name
+        if source.is_file():
+            target = root / name
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(source, target)
+    (root / 'hermes_cli/main.py').write_text('def main():\n    print("APP_REACHED")\n')
+    (root / '.gitignore').write_text('__pycache__/\n.bytecode-fingerprint\n')
+    (root / 'release.txt').write_text('previous release\n')
+    git(root, 'init', '-q', '-b', 'main')
+    git(root, 'config', 'user.name', 'Fixture')
+    git(root, 'config', 'user.email', 'fixture@example.invalid')
+    local_files = ['hermes_cli/_early_preservation.py', 'hermes_cli/update_preservation_io.py',
+                   'hermes_cli/update_preservation.py', 'hermes_cli/update_cmd_preserve.py']
+    if local_recovery:
+        for name in local_files:
+            (root / name).unlink()
+    git(root, 'add', '-A')
+    git(root, '-c', 'commit.gpgsign=false', 'commit', '-qm', 'previous')
+    before = git(root, 'rev-parse', 'HEAD')
+    (root / 'release.txt').write_text('next release\n')
+    if target_addition:
+        (root / 'added-source.py').write_bytes(b'NEW_SOURCE_VALUE = 1\n')
+        git(root, 'add', 'added-source.py')
+    git(root, '-c', 'commit.gpgsign=false', 'commit', '-qam', 'next')
+    target = git(root, 'rev-parse', 'HEAD')
+    git(root, 'update-ref', 'refs/remotes/origin/main', target)
+    git(root, 'reset', '-q', '--hard', before)
+    (root / '.gitignore').write_text('__pycache__/\n.bytecode-fingerprint\nlocal-output/\n')
+    git(root, 'add', '.gitignore')
+    (root / 'local-helper.py').write_text('LOCAL_VALUE = 7\n')
+    (root / 'local-helper.py').chmod(0o640)
+    (root / 'local-data.bin').write_bytes(b'\0\xff\x80private test fixture\n')
+    (root / 'local-data.bin').chmod(0o600)
+    if local_recovery:
+        for name in local_files:
+            shutil.copy2(SOURCE / name, root / name)
+    (root / 'local-link').symlink_to('local-helper.py')
+    binary = tmp_path / 'bin'
+    binary.mkdir()
+    launcher = _launchers._mint_shell_launcher(
+        'hermes', binary, Path(sys.executable), _launchers._launcher_script('hermes', root, None))
+    assert launcher is not None
+    env = {'HOME': str(tmp_path / 'home'), 'HERMES_HOME': str(tmp_path / 'home/.hermes'),
+           'PATH': os.environ.get('PATH', ''), 'LANG': 'C.UTF-8',
+           'GIT_CONFIG_NOSYSTEM': '1', 'GIT_CONFIG_GLOBAL': str(tmp_path / 'gitconfig')}
+    return root, before, launcher, env
+
+
+def kill_owned_update(tmp_path, monkeypatch, checkpoint, *, local_recovery=False, custom_release=None):
+    root, before, launcher, env = prepared_install(tmp_path, monkeypatch, local_recovery=local_recovery)
+    if custom_release is not None:
+        (root / 'release.txt').write_bytes(custom_release)
+    program = '''
+import os, signal, sys
+from pathlib import Path
+sys.path.insert(0, sys.argv[1])
+from hermes_cli import main, update_cmd as update
+from hermes_cli.update_lock import UpdateLock
+root = Path(sys.argv[2])
+assert root.resolve().parent == Path(__file__).resolve().parent
+main.PROJECT_ROOT = root
+update._UPDATE_CRITICAL_MODULES = ()
+update._posix_pause.pause_at_commit_point = lambda: None
+lock = UpdateLock(install_root=root)
+assert lock.acquire()
+update._commit.begin_update_attempt()
+update._commit.record_run_start(['git'], root)
+metadata = update._capture_customization_metadata(['git'], root)
+stash = update._stash_local_changes_if_needed(['git'], root)
+def killed(*args, **kwargs):
+    os.kill(os.getpid(), signal.SIGKILL)
+if sys.argv[3] == 'after-stash':
+    killed()
+if sys.argv[3] == 'after-source-ready':
+    from hermes_cli import update_preservation_io
+    save = update_preservation_io.save
+    def saved_then_killed(path, state):
+        save(path, state)
+        if state['phase'] == 'source_ready':
+            killed()
+    update_preservation_io.save = saved_then_killed
+elif sys.argv[3] == 'after-restoration':
+    from hermes_cli import update_preservation
+    update_preservation.finish = killed
+else:
+    update._restore_preserving_update = killed
+update._pull_updates(['git'], 'main', stash, prompt_for_restore=False, gw_input_fn=None,
+    discard_local_changes=False, keep_stash=False, preserve_local_changes=True, file_metadata=metadata)
+'''
+    child_program = tmp_path / 'fault-child.py'
+    child_program.write_text(program)
+    child = subprocess.run([sys.executable, '-I', str(child_program), str(SOURCE), str(root), checkpoint],
+                           cwd=tmp_path, env=env, capture_output=True, text=True, timeout=60, check=False)
+    assert child.returncode == -9, child.stdout + child.stderr
+    return root, before, launcher, env
+
+
+@pytest.mark.platforms('posix')
+@pytest.mark.parametrize('checkpoint', ['after-stash', 'before-restoration', 'after-restoration'])
+def test_sigkill_restores_original_patches_and_index_before_boot(tmp_path, monkeypatch, checkpoint):
+    root, before, launcher, env = kill_owned_update(tmp_path, monkeypatch, checkpoint)
+    if checkpoint != 'after-restoration':
+        assert not (root / 'local-helper.py').exists()
+    boot = subprocess.run([str(launcher)], cwd=tmp_path, env=env, capture_output=True,
+                          text=True, timeout=60, check=False)
+    assert boot.returncode == 0 and 'APP_REACHED' in boot.stdout, boot.stderr
+    assert git(root, 'rev-parse', 'HEAD') == before, 'interrupted update booted the new release'
+    helper = root / 'local-helper.py'
+    assert helper.read_bytes() == b'LOCAL_VALUE = 7\n', 'boot ran without the original local source'
+    assert stat.S_IMODE(helper.stat().st_mode) == 0o640
+    assert (root / 'local-link').is_symlink() and os.readlink(root / 'local-link') == 'local-helper.py'
+    assert git(root, 'diff', '--cached', '--name-only') == '.gitignore'
+    assert (root / 'local-data.bin').read_bytes() == b'\0\xff\x80private test fixture\n'
+    assert stat.S_IMODE((root / 'local-data.bin').stat().st_mode) == 0o600
+
+
+@pytest.mark.platforms('posix')
+@pytest.mark.parametrize('foreign', ['source', 'index', 'head', 'ignored-collision', 'new-file'])
+def test_recovery_refuses_foreign_edits_without_boot_or_overwrite(tmp_path, monkeypatch, foreign):
+    root, _before, launcher, env = kill_owned_update(tmp_path, monkeypatch, 'before-restoration')
+    file = root / {'ignored-collision': 'local-helper.py', 'new-file': 'foreign-helper.py'}.get(foreign, 'release.txt')
+    if foreign == 'head':
+        git(root, 'checkout', '-q', '--orphan', 'foreign-owner')
+        git(root, '-c', 'commit.gpgsign=false', 'commit', '-qm', 'foreign owner')
+    else:
+        file.write_text('foreign owner work\n')
+        if foreign == 'index':
+            git(root, 'add', file.name)
+    before = file.read_bytes()
+    head = git(root, 'rev-parse', 'HEAD')
+    index = (root / '.git/index').read_bytes()
+    boot = subprocess.run([str(launcher)], cwd=tmp_path, env=env, capture_output=True,
+                          text=True, timeout=30, check=False)
+    assert boot.returncode != 0 and 'APP_REACHED' not in boot.stdout
+    assert file.read_bytes() == before
+    assert git(root, 'rev-parse', 'HEAD') == head
+    assert (root / '.git/index').read_bytes() == index
+    assert (root / '.git/hermes-update-pull').exists()
+
+
+@pytest.mark.platforms('posix')
+def test_runtime_command_recovers_before_importing_the_application(tmp_path, monkeypatch):
+    root, before, _launcher, env = kill_owned_update(tmp_path, monkeypatch, 'before-restoration')
+    command = _launchers.runtime_command(root, code='from hermes_cli.main import main; main()',
+                                         python=sys.executable)
+    boot = subprocess.run(command, cwd=tmp_path, env=env, capture_output=True, text=True, timeout=30, check=False)
+    assert boot.returncode == 0 and 'APP_REACHED' in boot.stdout, boot.stderr
+    assert git(root, 'rev-parse', 'HEAD') == before
+    assert (root / 'local-helper.py').read_bytes() == b'LOCAL_VALUE = 7\n'
+
+
+@pytest.mark.platforms('posix')
+def test_locally_added_recovery_code_survives_stash_and_is_used_at_boot(tmp_path, monkeypatch):
+    root, before, launcher, env = kill_owned_update(
+        tmp_path, monkeypatch, 'before-restoration', local_recovery=True)
+    assert not (root / 'hermes_cli/_early_preservation.py').exists()
+    boot = subprocess.run([str(launcher)], cwd=tmp_path, env=env, capture_output=True,
+                          text=True, timeout=30, check=False)
+    assert boot.returncode == 0 and 'APP_REACHED' in boot.stdout, boot.stderr
+    assert git(root, 'rev-parse', 'HEAD') == before
+    assert (root / 'hermes_cli/_early_preservation.py').is_file()
+    assert (root / 'local-helper.py').read_bytes() == b'LOCAL_VALUE = 7\n'
+
+
+@pytest.mark.platforms('posix')
+def test_verified_source_ready_is_not_rolled_back_before_native_completion(tmp_path, monkeypatch):
+    root, _before, launcher, env = kill_owned_update(tmp_path, monkeypatch, 'after-source-ready')
+    selected = git(root, 'rev-parse', 'HEAD')
+    boot = subprocess.run([str(launcher)], cwd=tmp_path, env=env, capture_output=True,
+                          text=True, timeout=30, check=False)
+    assert boot.returncode == 0 and 'APP_REACHED' in boot.stdout, boot.stderr
+    assert git(root, 'rev-parse', 'HEAD') == selected
+    assert (root / 'local-helper.py').read_bytes() == b'LOCAL_VALUE = 7\n'
