+"""Session links resolve in the caller's fleet without exposing other stores."""
+
+import json
+
+import pytest
+
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+from hermes_state import SessionDB
+from tools.session_search_tool import _session_link, session_search
+
+
+@pytest.fixture
+def two_fleets(tmp_path, monkeypatch):
+    roots = [tmp_path / "fleet-a", tmp_path / "fleet-b"]
+    for root in roots:
+        root.mkdir()
+        (root / "config.yaml").write_text("model: {}\n", encoding="utf-8")
+        for name in ("work", "review"):
+            home = root / "profiles" / name
+            home.mkdir(parents=True)
+            (home / "config.yaml").write_text("model: {}\n", encoding="utf-8")
+
+    monkeypatch.setenv("HERMES_HOME", str(roots[0]))
+    databases = {}
+    for root in roots:
+        for profile, home in [("default", root), ("work", root / "profiles/work"),
+                              ("review", root / "profiles/review")]:
+            db = SessionDB(home / "state.db")
+            db.create_session("s_shared", source="cli")
+            message_id = db.append_message("s_shared", role="user", content=f"{root.name}-{profile}")
+            databases[(root.name, profile)] = (db, message_id)
+
+    current, _ = databases[("fleet-b", "work")]
+    token = set_hermes_home_override(roots[1] / "profiles/work")
+    try:
+        yield roots, databases, current
+    finally:
+        reset_hermes_home_override(token)
+        for db, _ in databases.values():
+            db.close()
+
+
+def _read(db, **kwargs):
+    return json.loads(session_search(db=db, **kwargs))
+
+
+def _text(result):
+    return " ".join(m.get("content", "") for m in result.get("messages", []))
+
+
+@pytest.mark.parametrize("value", ["s_shared", "@session:s_shared", "work/s_shared",
+                                    "@session:work/s_shared"])
+def test_returned_session_links_resolve_within_the_current_fleet(two_fleets, value):
+    _, _, current = two_fleets
+    result = _read(current, session_id=value)
+    assert result["success"] is True
+    assert _text(result) == "fleet-b-work"
+
+
+def test_explicit_default_profile_uses_the_current_fleet_root(two_fleets):
+    _, _, current = two_fleets
+    result = _read(current, session_id="s_shared", profile="default")
+    assert result["success"] is True
+    assert _text(result) == "fleet-b-default"
+
+
+def test_matching_profile_is_normalized_before_comparing(two_fleets):
+    _, _, current = two_fleets
+    result = _read(current, session_id="@session:WoRk/s_shared", profile=" work ")
+    assert result["success"] is True
+    assert _text(result) == "fleet-b-work"
+
+
+def test_conflicting_profile_is_rejected_without_reading_either_store(two_fleets):
+    _, _, current = two_fleets
+    result = _read(current, session_id="@session:work/s_shared", profile="review")
+    assert result["success"] is False
+    assert "messages" not in result
+    assert "fleet-" not in json.dumps(result)
+
+
+@pytest.mark.parametrize("value", ["@session:", "@session:   ", "@session:/s_shared", "@session:work/",
+                                    "@session:work/s_shared/extra", "work/"])
+def test_malformed_link_does_not_fall_through_to_browse(two_fleets, value):
+    _, _, current = two_fleets
+    result = _read(current, session_id=value)
+    assert result["success"] is False
+    assert "results" not in result and "messages" not in result
+
+
+def test_scroll_uses_the_link_without_changing_its_fleet(two_fleets):
+    _, databases, current = two_fleets
+    _, message_id = databases[("fleet-b", "work")]
+    result = _read(current, session_id="@session:work/s_shared", around_message_id=message_id)
+    assert result["success"] is True
+    assert result["mode"] == "scroll"
+    assert _text(result) == "fleet-b-work"
+
+
+def test_tombstoned_profile_is_not_read_from_the_process_fleet(two_fleets):
+    roots, _, current = two_fleets
+    deleted = roots[1] / "profiles/.deleted"
+    deleted.mkdir()
+    (deleted / "review").write_text("deleted\n", encoding="utf-8")
+    result = _read(current, session_id="s_shared", profile="review")
+    assert result["success"] is False
+    assert "messages" not in result
+
+
+def test_named_current_profile_retains_current_session_exclusion(two_fleets):
+    _, _, current = two_fleets
+    result = _read(current, profile="work", current_session_id="s_shared")
+    assert result["success"] is True
+    assert all(item["session_id"] != "s_shared" for item in result["results"])
+
+
+def test_named_current_profile_rejects_scroll_into_live_context(two_fleets):
+    _, databases, current = two_fleets
+    _, message_id = databases[("fleet-b", "work")]
+    result = _read(current, session_id="work/s_shared", around_message_id=message_id,
+                   current_session_id="s_shared")
+    assert result["success"] is False
+    assert "current session lineage" in result["error"]
+
+
+def test_identical_session_id_in_another_profile_is_not_suppressed(two_fleets):
+    _, _, current = two_fleets
+    result = _read(current, profile="review", current_session_id="s_shared")
+    assert result["success"] is True
+    assert any(item["session_id"] == "s_shared" for item in result["results"])
+
+
+def test_other_profile_can_scroll_with_a_colliding_session_id(two_fleets):
+    _, databases, current = two_fleets
+    _, message_id = databases[("fleet-b", "review")]
+    result = _read(current, session_id="review/s_shared", around_message_id=message_id,
+                   current_session_id="s_shared")
+    assert result["success"] is True
+    assert _text(result) == "fleet-b-review"
+
+
+def test_named_profile_link_survives_switching_profiles_with_colliding_ids(two_fleets):
+    roots, databases, current = two_fleets
+    original = _read(current, session_id="s_shared")
+    token = set_hermes_home_override(roots[1] / "profiles/review")
+    try:
+        review, _ = databases[("fleet-b", "review")]
+        reopened = _read(review, session_id=original["link"])
+    finally:
+        reset_hermes_home_override(token)
+    assert _text(reopened) == "fleet-b-work"
+    assert original["link"] == "@session:work/s_shared"
+
+
+def test_default_profile_link_survives_switching_profiles_with_colliding_ids(two_fleets):
+    roots, databases, current = two_fleets
+    token = set_hermes_home_override(roots[1])
+    try:
+        default, _ = databases[("fleet-b", "default")]
+        original = _read(default, session_id="s_shared")
+    finally:
+        reset_hermes_home_override(token)
+    reopened = _read(current, session_id=original["link"])
+    assert _text(reopened) == "fleet-b-default"
+    assert original["link"] == "@session:default/s_shared"
+
+
+def test_browse_emits_the_context_profile_on_returned_links(two_fleets):
+    _, _, current = two_fleets
+    result = _read(current)
+    assert result["success"] is True
+    assert result["results"][0]["link"] == "@session:work/s_shared"
+
+
+def test_discover_emits_the_context_profile_on_returned_links(two_fleets):
+    _, _, current = two_fleets
+    result = _read(current, query="fleet")
+    assert result["success"] is True
+    assert result["results"][0]["link"] == "@session:work/s_shared"
+
+
+def test_context_profile_symlink_uses_a_canonical_link_name(two_fleets):
+    roots, _, _ = two_fleets
+    alias = roots[1] / "profiles/WoRk"
+    alias.symlink_to(roots[1] / "profiles/work", target_is_directory=True)
+    token = set_hermes_home_override(alias)
+    try:
+        assert _session_link("s_shared") == "@session:work/s_shared"
+    finally:
+        reset_hermes_home_override(token)
+
+
+def test_reserved_context_profile_does_not_emit_an_unresolvable_link(two_fleets):
+    roots, _, _ = two_fleets
+    home = roots[1] / "profiles/hermes"
+    home.mkdir()
+    (home / "config.yaml").write_text("model: {}\n", encoding="utf-8")
+    token = set_hermes_home_override(home)
+    try:
+        assert _session_link("s_shared") == "@session:s_shared"
+    finally:
+        reset_hermes_home_override(token)
