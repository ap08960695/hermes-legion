index 0000000000000000000000000000000000000000..e592e58cc33696493da385a500fa52d6e1f6f3b1
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/hooks/composer-submit-dispatch.ts
@@ -0,0 +1,99 @@
+import { type ComposerAttachment, freshDraftScope, isFreshDraftScope } from '@/store/composer'
+
+import type { ChatBarProps } from '../types'
+
+import { type ComposerDraftRestoreArgs, createComposerDraftRestorer } from './composer-draft-restore'
+
+interface SubmitDispatchArgs extends ComposerDraftRestoreArgs {
+  onSubmit: ChatBarProps['onSubmit']
+}
+
+/** Send settlement belongs to the clicked editor, even after owner/scope navigation commits. */
+export function createComposerSubmitDispatch({
+  draftScopeRef,
+  draftOwnerRef,
+  onSubmit,
+  stashAt,
+  rememberDraftRetry,
+  readCurrentDraft,
+  loadIntoComposer
+}: SubmitDispatchArgs) {
+  const restoreDraft = createComposerDraftRestorer({
+    draftScopeRef,
+    draftOwnerRef,
+    stashAt,
+    rememberDraftRetry,
+    readCurrentDraft,
+    loadIntoComposer
+  })
+
+  const dispatchSubmit = (
+    text: string,
+    attachments?: ComposerAttachment[],
+    displayKind?: 'hidden',
+    target?: Parameters<ChatBarProps['onSubmit']>[1]
+  ) => {
+    // A fresh chat's composer is keyed by its per-lifecycle fresh-draft key
+    // (`__new__:<uuid>`), but the submit contract spells "no session yet" as
+    // null. Keep the raw lifecycle key separately: a later fresh chat must not
+    // become the destination of this send settlement.
+    const submittedDraftScope = target?.storedSessionId ?? draftScopeRef.current ?? freshDraftScope()
+    const submittedScope = isFreshDraftScope(submittedDraftScope) ? null : submittedDraftScope
+
+    // Freeze owner at the click: pending navigation must not re-home success or rejection.
+    const owner = draftOwnerRef?.current
+    const submittedOwner = typeof owner === 'object' && owner ? { ...owner } : owner
+    let restoreScope = submittedDraftScope
+    const submittedAttachments = attachments ?? []
+
+    // Only this operation's explicit session.create handoff may re-home a
+    // pre-session submit. A null → stored render can also be user navigation.
+    const assignment =
+      submittedScope === null
+        ? {
+            onComposerScopeAssigned: (scope: string) => {
+              restoreScope = scope
+            }
+          }
+        : {}
+
+    // The composer owns this send's identity: the caller's (a queue entry), the restored draft's
+    // (the explicit retry), else a new one. Equal text never inherits an identity, so a new
+    // message that repeats an uncertain send, in this pane or another, is its own turn.
+    const submissionId = target?.submission_id ?? crypto.randomUUID()
+
+    const restore = restoreDraft(
+      () => restoreScope,
+      text,
+      submittedAttachments,
+      submittedOwner ?? null,
+      submissionId,
+      target?.requireIdempotentSubmit
+    )
+
+    // A hidden submit is machine text (a setup note, never something the user
+    // typed), so a rejection drops it instead of loading it into the draft.
+    const rejected = displayKind ? () => {} : restore
+
+    void Promise.resolve(
+      onSubmit(text, {
+        ...target,
+        submission_id: submissionId,
+        ...(attachments ? { attachments } : {}),
+        composerScope: submittedScope,
+        ...assignment,
+        ...(displayKind ? { displayKind } : {})
+      })
+    )
+      .then(accepted => {
+        // Typed callers clear at the click. External sends do not own the
+        // editor; admission must never erase text written while awaiting it.
+        if (accepted === false) {
+          rejected()
+        }
+      })
+      .catch(rejected)
+  }
+
+  return dispatchSubmit
+}
