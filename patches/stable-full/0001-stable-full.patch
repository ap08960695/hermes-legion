+"""Send XTest events to the isolated compositor fixture."""
+import ctypes as c
+import sys
+import time
+
+
+def input_x11(command, coords):
+    x11, xtst = c.CDLL('libX11.so.6'), c.CDLL('libXtst.so.6')
+    x11.XOpenDisplay.argtypes = [c.c_char_p]
+    x11.XOpenDisplay.restype = c.c_void_p
+    x11.XSync.argtypes = [c.c_void_p, c.c_int]
+    x11.XCloseDisplay.argtypes = [c.c_void_p]
+    xtst.XTestFakeMotionEvent.argtypes = [c.c_void_p, c.c_int, c.c_int, c.c_int, c.c_ulong]
+    xtst.XTestFakeButtonEvent.argtypes = [c.c_void_p, c.c_uint, c.c_int, c.c_ulong]
+    display = x11.XOpenDisplay(None)
+    if not display:
+        raise RuntimeError('X11 display unavailable')
+
+    def move(x, y):
+        xtst.XTestFakeMotionEvent(display, -1, x, y, 0)
+        x11.XSync(display, 0)
+
+    def button(pressed):
+        xtst.XTestFakeButtonEvent(display, 1, pressed, 0)
+        x11.XSync(display, 0)
+
+    try:
+        move(*coords[:2])
+        time.sleep(.035)
+        button(1)
+        if command == 'drag':
+            x, y, end_x, end_y = coords
+            for step in range(1, 9):
+                time.sleep(.024)
+                move(x + (end_x - x) * step // 8, y + (end_y - y) * step // 8)
+        time.sleep(.04)
+        button(0)
+    finally:
+        x11.XCloseDisplay(display)
+
+
+def main():
+    command, *values = sys.argv[1:]
+    args = list(map(int, values))
+    if command not in ('click', 'drag') or len(args) != {'click': 2, 'drag': 4}[command]:
+        raise ValueError('unsupported fixture input')
+    input_x11(command, args)
+
+
+if __name__ == '__main__':
+    main()
