+"""Real SQLite recall of multimodal text and tool arguments, without model calls."""
+
+import base64
+import json
+import sqlite3
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+from hermes_state import SessionDB
+from tools.session_search_tool import session_search
+
+
+@pytest.fixture
+def db(tmp_path):
+    store = SessionDB(tmp_path / "state.db")
+    store.create_session("s", source="cli")
+    yield store
+    store.close()
+
+
+def call(db, **kwargs):
+    return json.loads(session_search(db=db, **kwargs))
+
+
+def test_thai_multimodal_text_is_found_and_can_be_paged_without_image_payload(db):
+    first = "first part"
+    second = "x" * 6000 + " ข้อความตัวอย่างภาษาไทย " + "y" * 5000
+    value = [
+        {"type": "text", "text": first},
+        {
+            "type": "image_url",
+            "image_url": {"url": "data:image/png;base64,IMAGEPAYLOADMARKER"},
+        },
+        {"type": "text", "text": second},
+    ]
+    message = db.append_message("s", role="user", content=value)
+    result = call(db, session_id="s", query="ข้อความตัวอย่างภาษาไทย")
+    assert result["success"] and len(result["results"]) == 1
+    hit = result["results"][0]
+    assert hit["match_message_id"] == message
+    assert hit["snippet_field"] == "text" and hit["offset_unit"] == "characters"
+    assert "ข้อความตัวอย่างภาษาไทย" in hit["snippet"]
+    assert "IMAGEPAYLOADMARKER" not in json.dumps(result)
+    page = call(
+        db,
+        session_id="s",
+        around_message_id=message,
+        content_offset=hit["snippet_offset"],
+        content_field=hit["snippet_field"],
+    )
+    expected = first + "\n" + second
+    assert (
+        page["success"]
+        and page["content"] == expected[page["offset"] : page["offset"] + page["limit"]]
+    )
+    assert "ข้อความตัวอย่างภาษาไทย" in page["content"]
+    assert "IMAGEPAYLOADMARKER" not in json.dumps(page)
+
+
+def test_multimodal_search_ignores_image_metadata_and_combines_text_parts(db):
+    value = [
+        {"type": "text", "text": "alpha"},
+        {
+            "type": "image_url",
+            "image_url": {"url": "data:image/png;base64,IMAGEPAYLOADMARKER"},
+        },
+        {"type": "text", "text": "beta"},
+    ]
+    message = db.append_message("s", role="user", content=value)
+    assert not call(db, session_id="s", query="IMAGEPAYLOADMARKER")["results"]
+    matches = call(db, session_id="s", query="alpha AND beta")["results"]
+    assert [m["match_message_id"] for m in matches] == [message]
+    assert not call(db, session_id="s", query="alpha NOT beta")["results"]
+
+
+def test_nested_image_text_and_nonobject_parts_are_not_searchable(db):
+    value = [
+        "nonobjectmarker",
+        23,
+        None,
+        {
+            "type": "image_url",
+            "image_url": {"url": "secretimagepayload", "text": "nestedmarker"},
+        },
+        {"type": "other", "text": "nontextpartmarker"},
+        {"type": "text", "text": "realpartmarker"},
+    ]
+    mid = db.append_message("s", role="user", content=value)
+    for word in (
+        "nonobjectmarker",
+        "secretimagepayload",
+        "nestedmarker",
+        "nontextpartmarker",
+    ):
+        assert not call(db, session_id="s", query=word)["results"]
+    result = call(db, session_id="s", query="realpartmarker")
+    assert [hit["match_message_id"] for hit in result["results"]] == [mid]
+
+
+def test_top_level_text_object_can_be_searched_and_paged(db):
+    mid = db.append_message(
+        "s", role="user", content={"type": "text", "text": "ข้อความตัวอย่าง"}
+    )
+    hit = call(db, session_id="s", query="ข้อความตัวอย่าง")["results"][0]
+    assert hit["match_message_id"] == mid and hit["snippet_field"] == "text"
+    page = call(
+        db,
+        session_id="s",
+        around_message_id=mid,
+        content_offset=hit["snippet_offset"],
+        content_field="text",
+    )
+    assert page["success"] and page["content"] == "ข้อความตัวอย่าง"
+
+
+def test_tool_arguments_report_the_matching_field_and_correct_page_offset(db):
+    calls = [
+        {
+            "id": "t1",
+            "type": "function",
+            "function": {
+                "name": "terminal",
+                "arguments": "x" * 6000 + " argumentuniqueword " + "y" * 1000,
+            },
+        }
+    ]
+    message = db.append_message(
+        "s", role="assistant", content="running", tool_calls=calls
+    )
+    hit = call(db, session_id="s", query="argumentuniqueword")["results"][0]
+    assert hit["match_message_id"] == message and hit["snippet_field"] == "tool_calls"
+    assert hit["snippet_offset"] > 0 and "argumentuniqueword" in hit["snippet"]
+    page = call(
+        db,
+        session_id="s",
+        around_message_id=message,
+        content_offset=hit["snippet_offset"],
+        content_field=hit["snippet_field"],
+    )
+    raw = json.dumps(calls)
+    assert page["success"] and "argumentuniqueword" in page["content"]
+    assert page["content"] == raw[page["offset"] : page["offset"] + page["limit"]]
+
+
+@pytest.mark.parametrize("nested", [False, True])
+def test_unicode_in_json_tool_arguments_is_searchable_with_correct_raw_page(db, nested):
+    needle = "ข้อความภาษาไทย"
+    argument = json.dumps({"value": needle}, ensure_ascii=True) if nested else needle
+    calls = [
+        {
