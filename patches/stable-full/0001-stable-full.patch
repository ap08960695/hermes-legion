+                raise ValueError('Invalid ref count')
+            return (CaptureResult(mode='ax', width=0, height=0, elements=elements, app=canonical_app,
+                                  window_title=window['title'], note='AX refs; read a fresh capture after every input attempt. type(text, element) inserts at the caret; set_value replaces the value. scroll requires a scrollarea element. No screenshots or physical input.'), targets)
+        except Exception:
+            raise RuntimeError(failure_message) from None
+
+    def _input_result(self, action, ok=False, code=None):
+        return ActionResult(ok=ok, action=action, code=code, path='ax' if ok else None, delivery_mode='background' if ok else None,
+                            meta={'recapture_required': True}, message=(
+                                'Command completed; UI effect unverified. Inspect a fresh capture before another input.' if ok else
+                                'Input refused or unconfirmed; inspect a fresh capture before another input.'))
+
+    def _unsupported(self, action):
+        with self._lock:
+            self._targets = {}
+            self._capture_epoch = None
+            return self._input_result(action, code='unsupported_action')
+
+    def _act(self, command, element, value=None, *, extra_args=()):
+        from tools.bot_desktop import lease
+        action = 'type_text' if command == 'type' else command.replace('-', '_')
+        with self._lock:
+            targets, epoch = self._targets, self._capture_epoch
+            self._targets, self._capture_epoch = {}, None
+            if self._binary is None or type(element) is not int or element not in targets:
+                return self._input_result(action, code='capture_required')
+            if not _host_placement():
+                return self._input_result(action, code='placement_unsupported')
+            try:
+                if lease.assert_agent_may_act().epoch != epoch:
+                    return self._input_result(action, code='capture_required')
+            except Exception:
+                return self._input_result(action, code='human_has_control')
+            ref, actions = targets[element]
+            if {'click': 'Click', 'set-value': 'SetValue', 'type': 'TypeText', 'scroll': 'Scroll'}[command] not in actions:
+                return self._input_result(action, code='unsupported_action')
+            argv = [self._binary, command, ref, '--session', self._session, '--timeout-ms', '5000']
+            argv.extend(extra_args)
+            if value is not None:
+                argv.append('--stdin')
+            try:
+                result = driver.bounded_probe_run(argv, timeout=10, env=driver._environment(),
+                                                  **({'input': value} if value is not None else {}))
+                if result is None or result.returncode != 0 or len(result.stdout.encode('utf-8')) > 1024 * 1024:
+                    raise ValueError('Action probe failed')
+                envelope = json.loads(result.stdout)
+                if envelope.get('version') != '2.6' or envelope.get('ok') is not True or envelope.get('command') != command:
+                    raise ValueError('Invalid action envelope')
+                data = envelope['data']
+                if data['action'] not in {command, action} or data['disposition']['delivery'] not in {
+                        'delivered_verified', 'delivered_unverified', 'not_delivered'} or data['disposition']['retry'] not in {'safe', 'unsafe'}:
+                    raise ValueError('Invalid action report')
+                return self._input_result(action, ok=True)
+            except Exception:
+                return self._input_result(action, code='agent_desktop_action_failed')
+
+    def click(self, *, element=None, x=None, y=None, button='left', click_count=1, modifiers=None,
+              delivery_mode=None, bring_to_front=False):
+        if x is not None or y is not None or button != 'left' or type(click_count) is not int or click_count != 1 or modifiers or delivery_mode not in {None, 'background'} or bring_to_front:
+            return self._unsupported('click')
+        return self._act('click', element)
+
+    def drag(self, **kwargs):
+        return self._unsupported('drag')
+
+    def scroll(self, *, direction, amount=3, element=None, x=None, y=None, modifiers=None,
+               delivery_mode=None, bring_to_front=False):
+        if (direction not in ('up', 'down', 'left', 'right') or type(amount) is not int or not 1 <= amount <= 50
+                or x is not None or y is not None or modifiers or delivery_mode not in (None, 'background') or bring_to_front):
+            return self._unsupported('scroll')
+        return self._act('scroll', element, extra_args=('--direction', direction, '--amount', str(amount)))
+
+    def type_text(self, text, *, element=None, delivery_mode=None, bring_to_front=False):
+        if delivery_mode not in {None, 'background'} or bring_to_front:
+            return self._unsupported('type_text')
+        try:
+            if not isinstance(text, str) or '\x00' in text:
+                raise ValueError('Invalid text')
+            encoded = text.encode('utf-8')
+            if len(encoded) > 10000:
+                raise ValueError('Text too large')
+        except Exception:
+            return self._unsupported('type_text')
+        return self._act('type', element, encoded)
+
+    def key(self, keys, **kwargs):
+        return self._unsupported('key')
+
+    def set_value(self, value, element=None):
+        try:
+            if not isinstance(value, str) or '\x00' in value:
+                raise ValueError('Invalid value')
+            encoded = value.encode('utf-8')
+            if len(encoded) > 128 * 1024:
+                raise ValueError('Value too large')
+        except Exception:
+            return self._unsupported('set_value')
+        return self._act('set-value', element, encoded)
+
+    def focus_app(self, app, raise_window=False):
+        return self._unsupported('focus_app')
+
+    def list_apps(self):
+        raise RuntimeError('agent-desktop AX provider does not implement app listing')
+
+    def list_windows(self):
+        raise RuntimeError('agent-desktop AX provider does not implement window listing')
