index 0000000000000000000000000000000000000000..cb2f941b3b9fc3735d5aa3a5abf1b3859c5bac6e
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/hooks/use-composer-draft.owner.test.tsx
@@ -0,0 +1,204 @@
+import { act, cleanup, render } from '@testing-library/react'
+import { useRef } from 'react'
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { clearSessionDraft, mainComposerScope, stashSessionDraft, takeSessionDraft } from '@/store/composer'
+import { readDraftRetry } from '@/store/composer-draft-retry'
+import type { SessionOwnerScope } from '@/store/session-request-router'
+
+import type { ChatBarProps } from '../types'
+
+import { useComposerDraft } from './use-composer-draft'
+import { useComposerSubmit } from './use-composer-submit'
+import { useComposerUndo } from './use-composer-undo'
+
+const adapter = vi.hoisted(() => {
+  let text = ''
+  const listeners = new Set<() => void>()
+
+  const api = {
+    setText(value: string) {
+      text = value
+      listeners.forEach(listener => listener())
+    }
+  }
+
+  const runtime = {
+    getState: () => ({ text }),
+    subscribe(listener: () => void) {
+      listeners.add(listener)
+
+      return () => {
+        listeners.delete(listener)
+      }
+    }
+  }
+
+  return { aui: { composer: () => api }, runtime }
+})
+
+vi.mock('@assistant-ui/react', () => ({
+  useAui: () => adapter.aui,
+  useAuiState: (selector: (state: { composer: { text: string } }) => unknown) =>
+    selector({ composer: adapter.runtime.getState() }),
+  useComposerRuntime: () => adapter.runtime
+}))
+
+const original = { connectionId: 'draft-host', profile: 'default' }
+const work = { connectionId: 'draft-host', profile: 'work' }
+const id = 'owner-hook-history'
+
+let handles: {
+  draft: ReturnType<typeof useComposerDraft>
+  submit: ReturnType<typeof useComposerSubmit>
+  undo: ReturnType<typeof useComposerUndo>
+}
+
+function Harness({ owner, onSubmit = () => true }: { owner: SessionOwnerScope; onSubmit?: ChatBarProps['onSubmit'] }) {
+  const queueEditRef = useRef(null)
+
+  const draft = useComposerDraft({
+    activeQueueSessionKey: id,
+    draftOwner: owner,
+    focusKey: null,
+    inputDisabled: false,
+    queueEditRef,
+    sessionId: id
+  })
+
+  const submit = useComposerSubmit({
+    ...draft,
+    activeQueueSessionKey: id,
+    attachments: [],
+    busy: false,
+    disabled: false,
+    drainNextQueued: async () => false,
+    exitQueuedEdit: () => false,
+    inputDisabled: false,
+    onCancel: () => {},
+    onSteer: undefined,
+    onSteerHidden: undefined,
+    onSubmit,
+    queueCurrentDraft: () => false,
+    queueEdit: null,
+    queuedPrompts: [],
+    sessionId: id
+  })
+
+  const undo = useComposerUndo({
+    editorRef: draft.editorRef,
+    syncDraftFromEditor: draft.syncDraftFromEditor,
+    scopeKey: JSON.stringify([id, owner])
+  })
+
+  handles = { draft, submit, undo }
+
+  return <div contentEditable ref={draft.editorRef} suppressContentEditableWarning />
+}
+
+afterEach(() => {
+  cleanup()
+
+  for (const owner of [original, work, undefined]) {
+    clearSessionDraft(id, owner)
+  }
+
+  mainComposerScope.clear()
+})
+
+it('changes owner before paint even when the raw session id stays the same', () => {
+  stashSessionDraft(id, 'Original unsent words', [], original)
+  stashSessionDraft(id, 'Work unsent words', [], work)
+  const view = render(<Harness owner={original} />)
+  expect(handles.draft.draftRef.current).toBe('Original unsent words')
+  view.rerender(<Harness owner={work} />)
+  expect(handles.draft.draftRef.current).toBe('Work unsent words')
+  expect(takeSessionDraft(id, original).text.trim()).toBe('Original unsent words')
+  expect(takeSessionDraft(id, work).text).toBe('Work unsent words')
+})
+
+it('does not load legacy unassigned words into an owned composer', () => {
+  stashSessionDraft(id, 'Legacy unassigned words', [])
+  render(<Harness owner={work} />)
+  expect(handles.draft.draftRef.current).toBe('')
+  expect(takeSessionDraft(id).text).toBe('Legacy unassigned words')
+})
+
+it('persists pending typing and attachments against the outgoing owner on a same-id switch', () => {
+  const mounted = render(<Harness owner={original} />)
+  act(() => {
+    handles.draft.insertText('Original trailing typing')
+    mainComposerScope.$attachments.set([{ id: 'original-file', kind: 'file', label: 'Original file' }])
+  })
+  const view = window.document.querySelector('[contenteditable]')!
+  expect(view.textContent).toBe('Original trailing typing')
+  mounted.rerender(<Harness owner={work} />)
+  expect(handles.draft.draftRef.current).toBe('')
+  expect(takeSessionDraft(id, original).text.trim()).toBe('Original trailing typing')
+  expect(takeSessionDraft(id, original).attachments[0]?.id).toBe('original-file')
+})
+
+it('a late accepted send clears only its captured owner', async () => {
+  let settle!: (value: boolean) => void
+
+  const accepted = new Promise<boolean>(resolve => {
+    settle = resolve
+  })
+
+  const view = render(<Harness onSubmit={() => accepted} owner={original} />)
+  act(() => {
+    handles.draft.insertText('Original message')
+    handles.submit.submitDraft()
+  })
+  stashSessionDraft(id, 'Keep work draft', [], work)
+  view.rerender(<Harness owner={work} />)
+  await act(async () => {
+    settle(true)
+    await accepted
+  })
+  expect(takeSessionDraft(id, original).text.trim()).toBe('')
+  expect(takeSessionDraft(id, work).text).toBe('Keep work draft')
+  expect(handles.draft.draftRef.current).toBe('Keep work draft')
+})
+
+it('a late rejected send restores only its captured owner and retry identity', async () => {
+  let settle!: (value: boolean) => void
+
+  const accepted = new Promise<boolean>(resolve => {
+    settle = resolve
+  })
+
+  const view = render(<Harness onSubmit={() => accepted} owner={original} />)
+  act(() => {
+    handles.draft.insertText('Rejected original message')
+    handles.submit.submitDraft()
+  })
+  stashSessionDraft(id, 'Keep work draft', [], work)
+  view.rerender(<Harness owner={work} />)
+  await act(async () => {
+    settle(false)
+    await accepted
+  })
+  expect(takeSessionDraft(id, original).text.trim()).toBe('Rejected original message')
+  expect(readDraftRetry(id, original)?.id).toBeTruthy()
+  expect(readDraftRetry(id, work)).toBeUndefined()
+  expect(handles.draft.draftRef.current).toBe('Keep work draft')
+})
+
+it('cannot undo back into the previous owner words after a same-id owner switch', () => {
+  stashSessionDraft(id, 'Original owner words', [], original)
+  stashSessionDraft(id, 'Keep work owner words', [], work)
+  const view = render(<Harness owner={original} />)
+  act(() => {
+    handles.undo.recordUndoPoint()
+    handles.draft.insertText('Original extra typing')
+  })
+  view.rerender(<Harness owner={work} />)
+  let changed = false
+  act(() => {
+    changed = handles.undo.undo()
+  })
+
+  expect(changed).toBe(false)
+  expect(handles.draft.draftRef.current.trim()).toBe('Keep work owner words')
+})
