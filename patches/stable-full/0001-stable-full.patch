+            value['tokens']+=record['input'] or 0;value['known']|=record['input'] is not None
+    known=[r['tokens'] for r in completed.values() if r['known']]
+    return {'evidence':'dispatcher-pinned HMAC binding validated against native run/time; legacy PID correlation reported separately',
+            'matched_attempts':matched,'bound_attempts':exact,'legacy_pid_correlated_attempts':legacy,
+            'binding_present_attempts':sum(r['binding'] is not None for r in records),
+            'ambiguous_attempts':ambiguous,'unmatched_attempts':len(records)-matched,
+            'by_reason':reasons,'by_native_outcome':outcomes,'completed_cards_with_known_sample':len(known),
+            'completed_card_input_tokens_per_card':sum(known)/len(known) if known else None}
+
+
+def _add_reason(reasons,run,record):
+    reason=run.get('attempt_reason')
+    reason=reason if isinstance(reason,str) and reason in _REASONS else 'unknown'
+    row=reasons.setdefault(reason,{'attempts':0,'input_tokens':0,'unknown_usage_attempts':0})
+    row['attempts']+=1;row['input_tokens']+=record['input'] or 0;row['unknown_usage_attempts']+=record['input'] is None
+
+
+
+def _add_outcome(outcomes,run,record):
+    outcome=run.get('outcome')
+    allowed={'completed','blocked','review_requested','rate_limited','crashed','timed_out','reclaimed','spawn_failed','protocol_violation','cancelled','interrupted'}
+    outcome=outcome if isinstance(outcome,str) and outcome in allowed else 'running_or_unknown'
