+    assert c.agent._cached_system_prompt is c.prompt
+    assert c.agent.tools == c.tools
+    assert c.db.get_session(c.sid)["tool_names"] == c.pin
+
+
+@pytest.mark.parametrize("in_place", [True, False], ids=["in-place", "rotation"])
+def test_metadata_failure_after_publication_keeps_refreshed_live_prefix(prefix_case, monkeypatch, in_place):
+    c = prefix_case
+    c.agent.compression_in_place = in_place
+    def fail_metadata(*args, **kwargs):
+        raise OSError("fixture: metadata failed after publication")
+    if in_place:
+        monkeypatch.setattr("agent.context_compressor.stamp_db_persisted_markers", fail_metadata)
+    else:
+        monkeypatch.setattr("agent.conversation_compression._carry_session_state_to_child", fail_metadata)
+    messages, prompt = c.agent._compress_context(c.messages, "trusted updated context",
+        approx_tokens=120_000, force=True, commit_fence=CompressionCommitFence())
+    assert len(c.db.get_messages_as_conversation(c.agent.session_id)) == len(messages) < len(c.messages)
+    assert "trusted updated context" in prompt and c.agent._cached_system_prompt == prompt
+    assert c.agent.tools != c.tools
