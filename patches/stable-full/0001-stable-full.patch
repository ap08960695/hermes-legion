+            (home / "config.yaml").write_text("model: {}\n", encoding="utf-8")
+            db = SessionDB(home / "state.db")
+            db.create_session("shared", source="cli")
+            message_id = db.append_message("shared", role="user", content=f"{root.name}-{name}")
+            databases[root.name, name] = (db, message_id)
+    monkeypatch.setenv("HERMES_HOME", str(roots[0]))
+    token = set_hermes_home_override(roots[1] / "profiles/work")
+    try:
+        current, current_id = databases["fleet-b", "work"]
+        _, review_id = databases["fleet-b", "review"]
