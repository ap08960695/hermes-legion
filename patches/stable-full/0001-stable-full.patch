+class DashboardLazyMountTests(unittest.IsolatedAsyncioTestCase):
+    def make_web(self, entered, release, exits):
+        @contextlib.asynccontextmanager
+        async def lifespan(app):
+            entered.set()
+            if release is not None:
+                await release.wait()
+            try:
+                yield
+            finally:
+                exits.append(True)
+
+        class App:
+            state = SimpleNamespace(gateway_runner=None)
+            router = SimpleNamespace(lifespan_context=lifespan)
+
+            async def __call__(self, scope, receive, send):
+                await send({'type': 'http.response.start', 'status': 200, 'headers': []})
+                await send({'type': 'http.response.body', 'body': b'synthetic dashboard'})
+
+        return SimpleNamespace(app=App(), _configure_auth_gate=lambda *args: None)
+
+    async def test_first_requests_mount_once_after_opt_out(self):
+        entered, exits = asyncio.Event(), []
+        web = self.make_web(entered, None, exits)
+        runner = SimpleNamespace(config=GatewayConfig(dashboard_warmup=False), session_authority=object())
+        mount = GatewayDashboardMount(runner, SimpleNamespace(bound_host='127.0.0.1', bound_port=1))
+        runner.session_api = SimpleNamespace(app=mount)
+        warm_gateway_dashboard(runner)
+        self.assertFalse(mount.loaded)
+        messages = []
+
+        async def send(message):
+            messages.append(message)
+
+        with patch.dict(sys.modules, {'hermes_cli.web_server': None}), patch(
+            'importlib.import_module', return_value=web
+        ) as load:
+            await asyncio.gather(*(mount({'type': 'http'}, AsyncMock(), send) for _ in range(2)))
+        load.assert_called_once_with('hermes_cli.web_server')
+        self.assertTrue(mount.loaded and entered.is_set())
+        self.assertEqual([m['status'] for m in messages if m['type'] == 'http.response.start'], [200, 200])
+        self.assertIs(web.app.state.gateway_runner, runner)
+        self.assertTrue(web.app.state.withhold_session_token)
+        await mount.close()
+        self.assertEqual(exits, [True])
+        self.assertIsNone(web.app.state.gateway_runner)
+
+
+    async def test_close_during_lifespan_entry_never_leaves_mount_bound(self):
+        entered, release, exits = asyncio.Event(), asyncio.Event(), []
+        web = self.make_web(entered, release, exits)
+        runner = SimpleNamespace(session_authority=object())
+        mount = GatewayDashboardMount(runner, SimpleNamespace(bound_host='127.0.0.1', bound_port=1))
+        with patch.dict(sys.modules, {'hermes_cli.web_server': web}):
+            task = asyncio.create_task(mount.ensure())
+            await asyncio.wait_for(entered.wait(), 2)
+            await mount.close()
+            release.set()
+            with self.assertRaisesRegex(RuntimeError, 'stopped'):
+                await task
+        self.assertFalse(mount.loaded)
+        self.assertEqual(exits, [True])
+        self.assertIsNone(web.app.state.gateway_runner)
+
+
+class DashboardAuthPreloadTests(unittest.IsolatedAsyncioTestCase):
+    async def test_auth_required_listener_preloads_despite_opt_out(self):
+        runner = SimpleNamespace(config=GatewayConfig(dashboard_warmup=False), session_authority=object())
+        with patch('hermes_cli.web_server_boundary._dashboard_public_hosts',
+                   return_value=frozenset({'example.invalid'})), patch.object(
+            GatewayDashboardMount, 'ensure', new_callable=AsyncMock
+        ) as ensure:
+            handle = await start_gateway_api(runner)
+            try:
+                self.assertTrue(handle.app._state.auth_required)
+                ensure.assert_awaited_once()
+            finally:
+                await stop_gateway_api(handle)
+
+
+if __name__ == '__main__':
+    unittest.main()
