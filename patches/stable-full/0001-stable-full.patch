@@ -0,0 +1,73 @@
+import { useStore } from '@nanostores/react'
+import { Button } from '@/components/ui/button'
+import { Codicon } from '@/components/ui/codicon'
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuItem,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+  DropdownMenuSeparator,
+  DropdownMenuTrigger
+} from '@/components/ui/dropdown-menu'
+import { ProfileGlyph } from '@/components/ui/profile-glyph'
+import {
+  $activeGatewayProfile,
+  $profiles,
+  $gatewaySwapTarget,
+  normalizeProfileKey,
+  profileLabel,
+  selectProfile,
+  sortByProfileOrder,
+  $profileOrder
+} from '@/store/profile'
+import { useParityCopy } from './parity-copy'
+
+/** The existing native profile pick, with a readable trigger and no additional refresh loop. */
+export function InlineProfileSelector({ busy = false, onManage }: { busy?: boolean; onManage: () => void }) {
+  const t = useParityCopy(),
+    profile = useStore($activeGatewayProfile),
+    profiles = useStore($profiles)
+  const swapping = useStore($gatewaySwapTarget),
+    order = useStore($profileOrder)
+  const current = normalizeProfileKey(profile),
+    active = profiles.find(row => normalizeProfileKey(row.name) === current)
+  const label = active ? profileLabel(active) : current
+  return (
+    <DropdownMenu>
+      <DropdownMenuTrigger asChild>
+        <Button
+          variant="ghost"
+          size="sm"
+          className="hermes-context-select"
+          disabled={busy || Boolean(swapping)}
+          aria-label={`${t('profileForNew')}: ${label}`}
+        >
+          <ProfileGlyph aria-hidden="true" color={null} name={current} isDefault={current === 'default'} />
+          <span className="hermes-context-value">{label}</span>
+          <Codicon name="chevron-down" />
+        </Button>
+      </DropdownMenuTrigger>
+      <DropdownMenuContent align="start" className="min-w-52 max-w-96">
+        <DropdownMenuRadioGroup
+          value={current}
+          onValueChange={name => {
+            if (name && normalizeProfileKey(name) !== current) selectProfile(name)
+          }}
+        >
+          {sortByProfileOrder(profiles, order).map(row => (
+            <DropdownMenuRadioItem key={row.name} value={normalizeProfileKey(row.name)}>
+              <ProfileGlyph aria-hidden="true" color={null} name={row.name} isDefault={row.is_default} />
+              <span>{profileLabel(row)}</span>
+            </DropdownMenuRadioItem>
+          ))}
+        </DropdownMenuRadioGroup>
+        <DropdownMenuSeparator />
+        <DropdownMenuItem onSelect={onManage}>
+          <Codicon name="settings-gear" />
+          {t('manageProfiles')}
+        </DropdownMenuItem>
+      </DropdownMenuContent>
+    </DropdownMenu>
+  )
+}
