@@ -0,0 +1,1023 @@
+import { AnimatePresence, motion, type TargetAndTransition, useIsPresent, useReducedMotion } from 'motion/react'
+import { type CSSProperties, useCallback, useEffect, useRef, useState } from 'react'
+
+import { DEFAULT_STATE_ROWS, PetSprite, roamWalkRow } from '@/components/pet/pet-sprite'
+import { FileText, FolderOpen } from '@/lib/icons'
+import { MAX_PREVIEW_CHARACTERS } from '@/lib/pet-character-sprite'
+import { isMacPlatform } from '@/lib/platform'
+import type { PetInfo } from '@/store/pet'
+import type { PetCharacter, PetCharacterFileContent, PetCharacterOutput, PetCharacterPreview } from '@/store/pet-characters'
+import type { PetCharacterCopy, PetCharacterDesktop } from '@/store/pet-overlay'
+
+import { createWander, limitForNeighbors, type WanderRect } from './character-wander'
+import { nextPetArrival, nextPetDeparture, type PetArrival, petArrival, petAtRest, type PetDeparture, petDeparture } from './pet-character-transitions'
+
+interface PetCharactersProps {
+  desktop?: PetCharacterDesktop
+  info: PetInfo
+  preview: PetCharacterPreview
+  paused: boolean
+  output: (PetCharacterOutput & { loading?: true; fileLoading?: true; file?: PetCharacterFileContent; copy?: PetCharacterCopy; stopPending?: true }) | null
+  showActions: boolean
+  onHitTargetsChanged: () => void
+  onOutput: (id: string | null, showActions?: boolean) => void
+  onPreview: () => void
+  onOpen: () => void
+  onOpenLink: (index: number) => void
+  onPreviewFile: () => void
+  onCopy: (kind: PetCharacterCopy['kind']) => void
+  onViewFile: () => void
+  onBrokenImage: () => void
+  onStop: () => void
+}
+
+export function hasSolidSpritePixel(canvas: HTMLCanvasElement, x: number, y: number): boolean {
+  const rect = canvas.getBoundingClientRect()
+  const ctx = canvas.getContext('2d')
+
+  if (!rect.width || !rect.height || !ctx) {return false}
+
+  try {
+    const pixel = Math.floor((x - rect.left) * canvas.width / rect.width)
+    const px = canvas.closest('[data-pet-mirrored]') ? canvas.width - 1 - pixel : pixel
+    const py = Math.floor((y - rect.top) * canvas.height / rect.height)
+
+    return ctx.getImageData(px, py, 1, 1).data[3] >= 16
+  } catch {
+    return false
+  }
+}
+
+const steps = new Map([['ArrowLeft', [-8, 0]], ['ArrowRight', [8, 0]], ['ArrowUp', [0, -8]], ['ArrowDown', [0, 8]]])
+
+type Point = { x: number; y: number }
+const DESKTOP_POSITIONS_KEY = 'hermes.desktop.pet-positions.v1'
+const MAX_SAVED_POSITIONS = 64
+
+function readDesktopPositions() {
+  const positions = new Map<string, Point>()
+
+  try {
+    const stored = JSON.parse(window.localStorage.getItem(DESKTOP_POSITIONS_KEY) ?? '[]')
+
+    if (Array.isArray(stored)) {
+      for (const entry of stored.slice(-MAX_SAVED_POSITIONS)) {
+        if (!Array.isArray(entry)) {continue}
+        const [id, point] = entry
+
+        if (typeof id === 'string' && Number.isFinite(point?.x) && Number.isFinite(point?.y)) {
+          positions.set(id, { x: point.x, y: point.y })
+        }
+      }
+    }
+  } catch {
+    // The overlay can still move pets when storage is unavailable.
+  }
+
+  return positions
+}
+
+function saveDesktopPosition(id: string, position: Point) {
+  const positions = readDesktopPositions()
+
+  positions.delete(id)
+  positions.set(id, { x: position.x, y: position.y })
+
+  try {
+    window.localStorage.setItem(DESKTOP_POSITIONS_KEY, JSON.stringify([...positions].slice(-MAX_SAVED_POSITIONS)))
+  } catch {
+    // Keep the move in this overlay even when it cannot be saved.
+  }
+}
+
+type HandoffEvent = { key: string; from: string; to: string; report: boolean; at: number }
+type HandoffCue = HandoffEvent & { start: Point; end: Point; receiver: HTMLCanvasElement }
+const HANDOFF_WINDOW_MS = 15_000
+const HANDOFF_DURATION_MS = 860
+const HANDOFF_CONTACT = 0.76
+const WAITING_HINT = 'Needs your answer'
+const FAILURE_HINT = 'Worker failed'
+const MAX_STATUS_CUES = 64
+const CELEBRATION_MS = 1000
+type WalkDirection = -1 | 0 | 1
+type SubscribeFrame = (draw: FrameRequestCallback) => () => void
+
+// Keep the last two samples of each step planted at the same position.
+const STEP_TRAVEL = [0.1, 0.28, 0.56, 0.84, 1, 1]
+
+const STEP_SHAPES = ['translateY(0px) scaleY(0.98)', 'translateY(-1px) scaleY(1.01)',
+  'translateY(-2px) scaleY(1.03)', 'translateY(-1px) scaleY(1.01)',
+  'translateY(0px) scaleY(0.95)', 'translateY(0px) scaleY(0.95)']
+
+const LIGHT_MOTION = { dropDuration: 1240, bounceHeight: 24, impactScale: 0.81 }
+const STANDARD_MOTION = { dropDuration: 1040, bounceHeight: 16, impactScale: 0.74 }
+const HEAVY_MOTION = { dropDuration: 920, bounceHeight: 10, impactScale: 0.68 }
+
+const wanderSession = Math.random()
+const wanderPaths = new WeakMap<HTMLElement, WanderRect>()
+
+const GESTURE_SHAPES = {
+  look: ['scaleX(0.94)', 'scaleX(0.88)', 'none', 'scaleX(0.94)'],
+  sit: ['scaleY(0.9)', 'scaleY(0.76)', 'scaleY(0.76)', 'scaleY(0.89)'],
+  stretch: ['scale(0.82, 0.9)', 'scaleX(0.82)', 'scaleX(0.86)', 'scaleX(0.94)'],
+  yawn: ['scaleY(0.93)', 'scaleY(0.85)', 'scaleY(0.85)', 'scaleY(0.93)'],
+  hop: ['scaleY(0.92)', 'translateY(-5px)', 'translateY(-9px)', 'translateY(-5px)', 'scaleY(0.93)']
+}
+
+function handoffFlight({ start, end }: HandoffCue): TargetAndTransition {
+  const x = end.x - start.x, y = end.y - start.y
+  const headroom = Math.max(0, Math.min(start.y, end.y) - 14)
+  const lift = Math.min(headroom, 56, Math.max(20, Math.abs(x) * 0.18))
+  const bump = Math.min(5, Math.max(0, end.y - 14))
+  const spin = x < 0 ? -360 : 360
+
+  return {
+    x: [0, 0, x * 0.25, x * 0.5, x * 0.75, x, x, x],
+    y: [0, 0, y * 0.25 - lift * 0.75, y * 0.5 - lift, y * 0.75 - lift * 0.75, y, y - bump, y],
+    rotate: [0, -spin / 20, spin * 0.25, spin * 0.5, spin * 0.75, spin, spin, spin],
+    scale: [1, 0.94, 1, 1, 1, 0.86, 1.04, 1],
+    opacity: [0, 1, 1, 1, 1, 1, 1, 0],
+    transition: {
+      duration: HANDOFF_DURATION_MS / 1000,
+      times: [0, 0.14, 0.295, 0.45, 0.605, HANDOFF_CONTACT, 0.86, 1],
+      ease: ['easeOut', 'linear', 'linear', 'linear', 'linear', 'easeOut', 'easeIn']
+    }
+  }
+}
+
+function fitDesktopPoint(desktop: PetCharacterDesktop, point: Point, width: number, height: number, cursor = point) {
+  const distance = ({ x, y, width, height }: PetCharacterDesktop['areas'][number]) => {
+    const dx = Math.max(0, x - cursor.x, cursor.x - (x + width - 1))
+    const dy = Math.max(0, y - cursor.y, cursor.y - (y + height - 1))
+
+    return dx * dx + dy * dy
+  }
+
+  const area = desktop.areas.reduce((nearest, next) => distance(next) < distance(nearest) ? next : nearest)
+
+  return { x: Math.max(area.x, Math.min(area.x + area.width - width, point.x)),
+    y: Math.max(area.y, Math.min(area.y + area.height - height, point.y)), area }
+}
+
+function groundPoint(point: ReturnType<typeof fitDesktopPoint>, height: number) {
+  const { area } = point
+
+  return { ...point, y: area.y + Math.max(0, area.height - height - 12) }
+}
+
+function topOutsideInput(position: ReturnType<typeof fitDesktopPoint>, width: number, height: number, wander: number, input: PetCharacterDesktop['input']) {
+  const { x, y, area } = position
+  const gap = 8
+
+  if (!input || x + width + wander <= input.x - gap || x - wander >= input.x + input.width + gap ||
+      y + height <= input.y - gap || y >= input.y + input.height + gap) {return y}
+
+  const above = input.y - height - gap, below = input.y + input.height + gap
+  const fitsAbove = above >= area.y
+  const fitsBelow = below + height <= area.y + area.height
+
+  if (fitsAbove && (!fitsBelow || y - above <= below - y)) {return above}
+
+  return fitsBelow ? below : null
+}
+
+function Character({ actor, subscribeFrame, desktop, foreground, info, size, slot, reduced, open, handoffActive, claimStatusCue, onGrab, onHitTargetsChanged, onLanding, onOutput }: {
+  actor: PetCharacter
+  subscribeFrame: SubscribeFrame
+  desktop?: PetCharacterDesktop
+  info: PetInfo
+  size?: PetCharacterPreview['size']
+  slot: number
+  foreground: boolean
+  reduced: boolean | null
+  open: boolean
+  handoffActive: boolean
+  claimStatusCue: (actorId: string, eventId: string, reportAt?: number) => boolean
+  onGrab: (id: string) => void
+  onHitTargetsChanged: () => void
+  onLanding: () => void
+  onOutput: (id: string | null, showActions?: boolean, origin?: Point) => void
+}) {
+  const present = useIsPresent()
+  const desktopReady = Boolean(desktop)
+  const [ground] = useState(Math.random)
+  const [entrance, setEntrance] = useState<PetArrival>()
+  const entranceChoice = useRef<PetArrival | undefined>(undefined)
+  const exitChoice = useRef<PetDeparture | undefined>(undefined)
+  const [landed, setLanded] = useState(false)
+
+  // eslint-disable-next-line no-restricted-syntax -- keep the committed choice through repeated effect setup.
+  useEffect(() => {
+    if (!desktopReady || entranceChoice.current) {return}
+    entranceChoice.current = nextPetArrival()
+    setEntrance(entranceChoice.current)
+  }, [desktopReady])
+
+  // eslint-disable-next-line no-restricted-syntax -- a return cancels the cached departure.
+  useEffect(() => {
+    if (present) {exitChoice.current = undefined}
+  }, [present])
+  const [position, setPosition] = useState<Point | null>(() => desktop ? readDesktopPositions().get(actor.id) ?? null : null)
+  const [dragPhase, setDragPhase] = useState<'held' | 'moving' | null>(null)
+  const held = dragPhase !== null
+  const [dropOffset, setDropOffset] = useState(0)
+  const dropping = present && dropOffset < 0 && !reduced && !desktop?.input
+
+  useEffect(() => {
+    if (!dropping) {setDropOffset(0)}
+
+    if (landed && !dropping) {onLanding()}
+  }, [dropping, landed, onLanding])
+  const [hint, setHint] = useState(false)
+  const [focused, setFocused] = useState(false)
+  const [statusCue, setStatusCue] = useState<string>()
+  const drag = useRef<{ pointer: number; x: number; y: number; start: Point; destination?: Point; original: Point | null; walkOffset: number } | null>(null)
+  const clickArmed = useRef(false)
+  const walkRef = useRef<HTMLDivElement>(null)
+  const walkOffset = useRef(0)
+  const wander = useRef<ReturnType<typeof createWander> | null>(null)
+  const [direction, setDirection] = useState<WalkDirection>(0)
+  const { outputId, actionsOnly } = actor
+  const sprite = actor.sprite ?? info
+
+  const { dropDuration, bounceHeight, impactScale } = sprite.motionWeight === 'light' ? LIGHT_MOTION :
+    sprite.motionWeight === 'heavy' ? HEAVY_MOTION : STANDARD_MOTION
+
+  const width = sprite.frameW ?? 192
+  const height = sprite.frameH ?? 208
+  const configuredScale = info.scale
+
+  const preferredScale = typeof configuredScale === 'number' && Number.isFinite(configuredScale) && configuredScale > 0
+    ? configuredScale : 0.33
+
+  // The atlas scale already compensates for half-resolution cells.
+  const previewScale = desktop ? (actor.sprite?.scale ?? 0.33) * (preferredScale / 0.33) * 0.5 : sprite.scale ?? 0.33
+  const sizeFactor = size === 'small' ? 0.75 : size === 'large' ? 1.5 : 1
+  const characterScale = size ? (sprite.scale ?? 0.33) * (desktop ? 0.5 : 1) : previewScale
+  const scale = Math.min(characterScale * sizeFactor, 96 * sizeFactor / width, 104 * sizeFactor / height)
+  const sheet = { ...sprite, scale }
+  const w = Math.round(width * scale), h = Math.round(height * scale)
+  const primary = desktop?.areas[0]
+
+  const anchor = primary ? { x: primary.x + Math.round(ground * Math.max(0, primary.width - w)),
+    y: primary.y + primary.height - 12 - h } : { x: 0, y: 0 }
+
+  const current = position ?? anchor
+  const fittedPoint = desktop ? fitDesktopPoint(desktop, current, w, h) : null
+  const fitted = fittedPoint && dragPhase !== 'moving' ? groundPoint(fittedPoint, h) : fittedPoint
+  const roomLeft = fitted ? Math.max(0, fitted.x - fitted.area.x) : 0
+  const roomRight = fitted ? Math.max(0, fitted.area.x + fitted.area.width - fitted.x - w) : 0
+  const stride = fitted ? 64 : 12
+  const minOffset = fitted ? -Math.min(roomLeft, stride) : -stride
+  const maxOffset = fitted ? Math.min(roomRight, stride) : stride
+  const top = fitted ? topOutsideInput(fitted, w, h, stride, desktop?.input) : null
+  const occluded = Boolean(fitted) && top === null
+  const canHop = Boolean(fitted && !desktop?.input && (top ?? fitted.y) - fitted.area.y >= 9)
+  const waiting = actor.state === 'waiting'
+  const failure = actor.state === 'failed' ? actor.failure : undefined
+  const completion = actor.state === 'wave' ? actor.completion : undefined
+
+  const statusId = failure ? `failed:${failure.id}` : completion ? `completed:${completion.id}` :
+    waiting && actor.waitingId ? `waiting:${actor.waitingId}` : undefined
+
+  const reportAt = failure?.at ?? completion?.at
+  const statusText = failure ? FAILURE_HINT : WAITING_HINT
+  const canShowCue = present && !held && !dropping && !open && !occluded
+  const canShowHint = canShowCue && (waiting || Boolean(failure))
+
+  const jumpRow = completion && (sprite.stateRows ?? DEFAULT_STATE_ROWS).find(row =>
+    (row === 'jump' || row === 'jumping') &&
+    (sprite.framesByRow?.[row] ?? sprite.framesByState?.[row] ?? sprite.framesByState?.jump ?? 1) > 0)
+
+  const canCelebrate = Boolean(canShowCue && jumpRow && !reduced)
+  const activeStatus = Boolean(statusId && statusCue === statusId)
+  const showStatusCue = canShowHint && !hint && activeStatus
+  const celebrating = canCelebrate && activeStatus
+
+  const savedFailure = Boolean(failure && (sprite.stateRows ?? DEFAULT_STATE_ROWS).includes('failed') &&
+    (sprite.framesByRow?.failed ?? sprite.framesByState?.failed ?? 1) > 0)
+
+  const hintWidth = Math.min(136, fitted?.area.width ?? 136)
+  const hintLeft = fitted ? fitted.area.x - fitted.x : 0
+
+  useEffect(() => {
+    const first = desktopReady && present && landed && !dropping && statusId && claimStatusCue(actor.id, statusId, reportAt)
+
+    if (!statusId || !(canCelebrate || (canShowHint && !hint))) {setStatusCue(undefined)}
+    else if (first) {setStatusCue(statusId)}
+  }, [actor.id, canCelebrate, canShowHint, claimStatusCue, desktopReady, dropping, hint, landed, present, reportAt, statusId])
+
+  useEffect(() => {
+    if (!celebrating) {return}
+    const timer = setTimeout(() => setStatusCue(current => current === statusId ? undefined : current), CELEBRATION_MS)
+
+    return () => clearTimeout(timer)
+  }, [celebrating, statusId])
+  const canWalk = !occluded && !reduced && (actor.state === 'idle' || actor.state === 'run')
