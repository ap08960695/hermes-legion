+    row=Spaces().read(sid,iid);data=row.pop('data');row['byte_size']=len(data)
+    if row['kind']=='page':row['text']=data.decode();return row
+    state=_format_state(Path(row['title']),len(data));row['preview_state']=state
+    if state!='ready':return row
