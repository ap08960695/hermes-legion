+"""Post-turn judges belong to the goal's session, not a finished or unrelated turn."""
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+from threading import Barrier
+from types import SimpleNamespace
+import time
+
+import pytest
+from openai.types.chat import ChatCompletion
+
+from agent.aux_accounting import record_aux_usage, reset_accounting_context, set_accounting_context
+from agent.auxiliary_client import _validate_llm_response
+from hermes_cli import goals
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    path = tmp_path / ".hermes"
+    path.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(path))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(path))
+    monkeypatch.setattr("agent.usage_pricing.estimate_usage_cost", lambda *a, **kw: SimpleNamespace(amount_usd=None))
+    goals._DB_CACHE.clear()
+    yield path
+    goals._DB_CACHE.clear()
+
+
+def _response():
+    return ChatCompletion.model_validate({
+        "id": "offline-goal", "object": "chat.completion", "created": 0, "model": "offline-judge",
+        "choices": [{"index": 0, "finish_reason": "stop", "message": {
+            "role": "assistant", "content": '{"done":true,"reason":"verified"}'}}],
+        "usage": {"prompt_tokens": 100, "completion_tokens": 20, "total_tokens": 120,
+                  "prompt_tokens_details": {"cached_tokens": 60},
+                  "completion_tokens_details": {"reasoning_tokens": 7}}})
+
+
+def _rows(db):
+    with db._read_ctx() as conn:
+        return [tuple(row) for row in conn.execute(
+            "SELECT session_id,task,input_tokens,output_tokens,cache_read_tokens,reasoning_tokens,api_call_count "
+            "FROM session_model_usage ORDER BY session_id,task")]
+
+
+@pytest.mark.parametrize("failure", [False, True])
+@pytest.mark.parametrize("missing_store", [False, True])
+def test_post_turn_judge_uses_goal_owner_and_restores_outer_owner(home, monkeypatch, failure, missing_store):
+    db = goals._get_session_db()
+    for sid in ("goal-owner", "outer-owner"):
+        db.create_session(sid, source="cli")
+    mgr = goals.GoalManager("goal-owner")
+    mgr.set("finish offline fixture")
+    if missing_store:
+        monkeypatch.setattr(goals, "_get_session_db", lambda: None)
+    attempts = []
+
+    def response_boundary(*, task, **kwargs):
+        attempts.append(task)
+        if failure:
+            raise RuntimeError("offline transport failure")
+        return _validate_llm_response(_response(), task, provider="offline")
+
+    monkeypatch.setattr("agent.auxiliary_client.call_llm", response_boundary)
+    token = set_accounting_context(db, "outer-owner")
+    try:
+        decision = mgr.evaluate_after_turn("fixture completed")
+        record_aux_usage(_response(), "owner-probe", provider="offline")
+    finally:
+        reset_accounting_context(token)
+    expected = [("outer-owner", "owner-probe", 40, 20, 60, 7, 1)]
+    if not failure and not missing_store:
+        expected.insert(0, ("goal-owner", "goal_judge", 40, 20, 60, 7, 1))
+    assert _rows(db) == expected
+    assert attempts == ["goal_judge"]
+    if missing_store:
+        assert decision["status"] is None and decision["verdict"] == "discarded"
+        assert decision["should_continue"] is False
+        assert mgr.state.turns_used == 0
+        assert goals.GoalState.from_json(db.get_meta("goal:goal-owner")).turns_used == 0
+        return
+    assert decision["status"] == ("active" if failure else "done")
+    assert mgr.state.turns_used == 1
