+  expect(await screen.findByText('Fixture confirmation failed')).toBeTruthy()
+  expect(screen.getByRole('button', { name: 'Proceed' })).toBe(freshProceed)
+  expect(rest).toHaveBeenLastCalledWith('/tasks/t_example/planned-action', expect.objectContaining({
+    body: {
+      step: 'configure', workspace_kind: 'dir', workspace_path: '/fixture/repo',
+      decision: 'proceed', token: 'preview-token'
+    }
+  }))
+  expect(onOpen).not.toHaveBeenCalled()
+})
