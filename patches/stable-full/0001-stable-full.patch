+    assert result.meta['recapture_required'] is True and 'PRIVATE_NATIVE_OUTPUT' not in str(result)
+    argv, kwargs = calls[-1]
+    assert argv[:3] == ['/fixture/agent-desktop', 'scroll', '@scrolling:e1']
+    assert argv[-6:] == ['--timeout-ms', '5000', '--direction', direction, '--amount', str(amount)]
+    assert '--headed' not in argv and kwargs == {'timeout': 10, 'env': {'SAFE': 'yes'}}
+    assert not backend.scroll(element=cap.elements[1].index, direction=direction).ok
