index 0000000000000000000000000000000000000000..6f0793c9bff6a334ac759e30bbc1c01ee917d57b
--- /dev/null
+++ b/hermes_cli/prompt_suggestion_http.py
@@ -0,0 +1,97 @@
+"""Small prediction HTTP calls with cancellable body reads and one elapsed deadline."""
+
+import asyncio
+import json
+import time
+
+import httpx
+
+_MAX_BODY_BYTES = 64 * 1024
+
+
+def _client(timeout):
+    return httpx.AsyncClient(
+        timeout=httpx.Timeout(timeout, connect=min(0.5, timeout)), follow_redirects=True
+    )
+
+
+async def _bounded_chunks(response):
+    size = 0
+    async for chunk in response.aiter_bytes():
+        size += len(chunk)
+        if size > _MAX_BODY_BYTES:
+            raise ValueError("prediction response exceeds byte limit")
+        yield chunk
+
+
+def _event(line, text):
+    if not line.startswith(b"data: ") or line[6:].strip() == b"[DONE]":
+        return text, False
+    event = json.loads(line[6:])
+    if not isinstance(event, dict):
+        raise ValueError("prediction stream event is not an object")
+    kind = event.get("type")
+    if kind == "response.output_text.delta":
+        text += event.get("delta", "")
+        if len(text) > 250:
+            raise ValueError("prediction exceeds text limit")
+    if kind in {"response.failed", "response.incomplete", "error"}:
+        raise ValueError("prediction stream did not complete")
+    return text, kind == "response.completed"
+
+
+async def _stream_text(response):
+    pending, text = b"", ""
+    async for chunk in _bounded_chunks(response):
+        pending += chunk
+        while b"\n" in pending:
+            line, pending = pending.split(b"\n", 1)
+            text, complete = _event(line.rstrip(b"\r"), text)
+            if complete:
+                return text
+    if pending:
+        text, complete = _event(pending.rstrip(b"\r"), text)
+        if complete:
+            return text
+    return None
+
+
+async def _post(url, headers, payload, timeout, stream_text):
+    async with _client(timeout) as client:
+        async with client.stream("POST", url, headers=headers, json=payload) as response:
+            status = response.status_code
+            if stream_text:
+                return status, await _stream_text(response) if status == 200 else None
+            raw = b"".join([chunk async for chunk in _bounded_chunks(response)])
+            try:
+                return status, json.loads(raw)
+            except ValueError:
+                if status in {200, 429}:
+                    raise
+                return status, None
+
+
+def request_payload(url, *, headers, payload, timeout, stream_text=False):
+    """The native deadline guards scheduling; async HTTP cancellation closes slow reads.
+
+    The caller owns route selection, credentials and accounting. No request starts
+    after its captured deadline, and this worker never touches their SQLite state.
+    """
+    from agent.deadline import run_bounded_sync
+
+    deadline = time.monotonic() + timeout
+
+    async def bounded_post():
+        remaining = deadline - time.monotonic() - 0.05
+        if remaining <= 0:
+            raise TimeoutError("prediction deadline expired before HTTP start")
+        return await asyncio.wait_for(
+            _post(url, headers, payload, remaining, stream_text), remaining
+        )
+
+    result = run_bounded_sync(
+        lambda: asyncio.run(bounded_post()), timeout, label="prompt-prediction-http"
+    )
+    if result.timed_out:
+        raise TimeoutError("prediction HTTP deadline expired")
+    return result.value
diff --git a/hermes_cli/prompt_suggestions.py b/hermes_cli/prompt_suggestions.py
