+  const body = view.container.querySelector('.kanban-workflow-body') as HTMLElement
+  expect(view.container.querySelector('.kanban-workflow-inspector')).toBeNull()
+  expect(body.style.gridTemplateColumns).toBe('minmax(0, 1fr)')
+  expect(screen.getByText('Select a task to see its bot journey')).toBeTruthy()
+  fireEvent.click(screen.getByRole('button', { name: /Research the example/ }))
+  expect(view.container.querySelector('.kanban-workflow-inspector')).toBeTruthy()
+  expect(body.style.gridTemplateColumns).toBe('')
