+    finally:
+        process_registry._running.pop(sid, None)
+
+
+def test_legacy_pid_without_identity_pauses_when_unverified(home, monkeypatch):
+    monkeypatch.setattr(goals, '_pid_observation', lambda _: True)
+    monkeypatch.setattr(goals, '_pid_fingerprint', lambda _: 'boot|current')
