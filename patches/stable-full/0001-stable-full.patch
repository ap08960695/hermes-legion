--- /dev/null
+++ b/hermes_cli/kanban_attention_run.py
@@ -0,0 +1,31 @@
+"""Explicit CLI invocation of one existing daily attention receipt."""
+from contextlib import redirect_stdout
+import json
+import os
+import sqlite3
+import sys
+
+from hermes_cli import kanban_db as kb
+
+
+def command(args) -> int:
+    from hermes_cli.kanban_attention_host import run
+    previous = os.environ.get('HERMES_SINGLE_QUERY_SESSION')
+    os.environ['HERMES_SINGLE_QUERY_SESSION'] = '1'
+    try:
+        with redirect_stdout(sys.stderr):
+            result = run(kb.kanban_db_path(), delivery_id=args.delivery_id, session_key=args.session)
+    except (OSError, sqlite3.Error, ValueError, RuntimeError, PermissionError) as exc:
+        print('kanban: daily attention not found, ineligible, busy, or could not finish; '
+              f'inspect notify-receipts ({type(exc).__name__})', file=sys.stderr)
+        return 1
+    except KeyboardInterrupt:
+        print('kanban: interrupted; inspect notify-receipts before any retry', file=sys.stderr)
+        return 130
+    finally:
+        if previous is None:
+            os.environ.pop('HERMES_SINGLE_QUERY_SESSION', None)
+        else:
+            os.environ['HERMES_SINGLE_QUERY_SESSION'] = previous
+    print(json.dumps(result) if args.json else f"attention {result['delivery_id']}: {result['state']}")
+    return 0 if result['state'] == 'settled' else 1
