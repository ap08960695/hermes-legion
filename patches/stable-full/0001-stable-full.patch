+"""ASCII argument misses should not require one Python tokenizer call per byte."""
+
+import json
+import sqlite3
+
+import pytest
+
+import hermes_state_global_recall as recall
+
+
+@pytest.mark.parametrize("route", ["decoded", "native"])
+def test_large_ascii_miss_uses_bounded_character_classification(monkeypatch, route):
+    with sqlite3.connect(":memory:") as db:
+        db.execute("CREATE TABLE messages(id INTEGER PRIMARY KEY, tool_calls TEXT)")
+        raw = json.dumps({"function": {"name": "fixture_command", "arguments": "unrelated " * 50_000}})
+        db.execute("INSERT INTO messages VALUES(1, ?)", (raw,))
+        original = recall._Unicode61.classify
+        calls = 0
+
+        def observed(self, char):
+            nonlocal calls
+            calls += 1
+            if calls > 4096:
+                raise TimeoutError("synthetic per-character work budget exhausted")
+            return original(self, char)
+
+        monkeypatch.setattr(recall._Unicode61, "classify", observed)
+        search = recall.GlobalSearch(db, [("absentword", False)])
+        try:
+            actual = search.tool_contains(1, "absentword") if route == "decoded" else search.native_field_contains(
+                1, "tool_calls", "absentword")
+            assert actual == 0
+            assert calls <= 4096
+        finally:
+            search.close()
+
+
+@pytest.mark.parametrize("text, term, prefix, expected", [
+    ("x" * 65535 + "needle", "needle", False, False),
+    ("x" * 65535 + " needle", "needle", False, True),
+    ("needle" + "x" * 65535, "needle", False, False),
+    ("needle" + "x" * 65535, "needle", True, True),
+    ("alpha" + ", " * 40000 + "beta", "alpha beta", False, True),
+    ("prefix ไทย needle café", "cafe", False, True),
+])
+def test_ascii_runs_preserve_native_boundaries_and_unicode(text, term, prefix, expected):
+    with sqlite3.connect(":memory:") as db:
+        db.execute("CREATE TABLE messages(id INTEGER PRIMARY KEY, content TEXT)")
+        raw = "\x00json:" + json.dumps([{"type": "text", "text": text}])
+        db.execute("INSERT INTO messages VALUES(1, ?)", (raw,))
+        search = recall.GlobalSearch(db, [(term, prefix)])
+        try:
+            assert bool(search.contains(1, term, prefix)) == expected
+            info = search.info(1)
+            assert info["chars"] == len(text)
+            assert info["bytes"] == len(text.encode("utf-8"))
+        finally:
+            search.close()
