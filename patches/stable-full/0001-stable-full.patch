+            self.assertEqual(schema["parameters"], self.tool["inputSchema"])
+            self.assertEqual(registry.get_entry(self.utility["name"]).schema, self.utility)
+            self.assertFalse(core._servers)
+            self.assertIsNone(core._death_supervisor)
+
+    def test_profile_discovery_keeps_cached_schema_without_loading_sdk(self):
+        with patch.object(core, "_MCP_AVAILABLE", True), patch.object(
+                core, "_ensure_mcp_sdk", side_effect=AssertionError("metadata must not load SDK")):
+            names = discovery.discover_mcp_tools(["metadata_echo"])
+            self.assertIn("mcp__metadata_echo__echo", names)
+            self.assertEqual(registry.get_entry("mcp__metadata_echo__echo").schema["parameters"],
+                             self.tool["inputSchema"])
+            self.assertFalse(core._servers)
+            self.assertIsNone(core._death_supervisor)
+
+    def test_empty_and_disabled_registration_needs_no_sdk(self):
+        with patch.object(core, "_MCP_AVAILABLE", True), patch.object(
+                core, "_ensure_mcp_sdk", side_effect=AssertionError("empty registration must not load SDK")):
+            self.assertEqual(discovery.register_mcp_servers({}), [])
+            disabled = {name: {**cfg, "enabled": False} for name, cfg in self.servers.items()}
+            self.assertEqual(discovery.register_mcp_servers(disabled), [])
+            self.assertFalse(core._servers)
+
+    def test_empty_probe_needs_no_sdk(self):
+        (self.home / "config.yaml").write_text(json.dumps({"mcp_servers": {}}))
+        with patch.object(core, "_MCP_AVAILABLE", True), patch.object(
+                core, "_ensure_mcp_sdk", side_effect=AssertionError("empty probe must not load SDK")):
+            self.assertEqual(discovery.probe_mcp_server_tools(), {})
+
+    def test_missing_sdk_still_refuses_even_valid_cached_tools(self):
+        with patch.object(core, "_MCP_AVAILABLE", False), patch.object(
+                core, "_import_sdk_names", side_effect=AssertionError("missing SDK must not import")):
+            self.assertEqual(discovery.register_mcp_servers(self.servers), [])
+            self.assertEqual(discovery.discover_mcp_tools(), [])
+            self.assertEqual(discovery.probe_mcp_server_tools(), {})
+            self.assertFalse(core._servers)
+            self.assertNotIn(self.key, core._lazy_server_configs)
+
+    def test_safe_worker_still_refuses_cached_tools(self):
+        with patch("agent.safe_worker_policy.safe_worker_enabled", return_value=True), patch.object(
+                core, "_ensure_mcp_sdk", side_effect=AssertionError("safe worker must not import SDK")):
+            self.assertEqual(discovery.register_mcp_servers(self.servers), [])
+            self.assertEqual(discovery.discover_mcp_tools(), [])
+            self.assertFalse(core._servers)
+            self.assertNotIn(self.key, core._lazy_server_configs)
+
+
+if __name__ == "__main__":
+    unittest.main()
