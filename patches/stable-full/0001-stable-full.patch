+import { expect, test } from '@playwright/test'
+
+import { startMockServer } from '../../../../tests-js/scripts/mock-server'
+
+import { coreAppEnv, createCoreSandbox, launchCoreApp, writeProviderHome } from './harness'
+
+test('narrow navigation keeps short labels intact and Settings reachable', async () => {
+  const sandbox = createCoreSandbox('focus-navigation')
+  const mock = await startMockServer()
+  writeProviderHome(sandbox.hermesHome, mock.url)
+  const { app, page } = await launchCoreApp(coreAppEnv(sandbox, { HERMES_DISABLE_LAZY_INSTALLS: '1' }))
+
+  try {
+    const rail = page.getByRole('navigation', { name: 'Workspace navigation' })
+    await expect(rail).toBeVisible()
+
+    for (const width of [320, 580]) {
+      await app.browserWindow(page).then(window =>
+        window.evaluate((window, width) => {
+          window.setMinimumSize(320, 480)
+          window.setBounds({ x: 0, y: 0, width, height: 700 })
+        }, width)
+      )
+      await page.setViewportSize({ width, height: 700 })
+      await page.evaluate(() => new Promise<void>(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve()))))
+
+      for (const name of ['Chat', 'Work', 'Bots', 'Hub']) {
+        const label = rail.getByRole('button', { name, exact: true }).locator('span:not(.codicon)')
+
+        const metrics = await label.evaluate(element => ({
+          height: element.getBoundingClientRect().height,
+          lineHeight: Number.parseFloat(getComputedStyle(element).lineHeight)
+        }))
+
+        expect(metrics.height, `${name} must not break inside a short word at ${width}px`).toBeLessThanOrEqual(metrics.lineHeight + 1)
+      }
+
+      await rail.getByRole('button', { name: 'All features', exact: true }).click()
+      const features = page.getByRole('dialog')
+      await features.getByRole('textbox').fill('Settings')
+      await features.getByRole('button', { name: 'Settings', exact: true }).click()
+      await page.getByRole('button', { name: 'Close settings', exact: true }).click()
+      await expect(page.locator('[data-overlay-surface]')).toHaveCount(0)
+      await expect(rail.getByRole('button', { name: 'Chat history', exact: true })).toBeVisible()
+    }
+
+    expect(mock.receivedPrompts).toHaveLength(0)
+  } finally {
+    await app.close()
+    await mock.close()
+    sandbox.cleanup()
+  }
+})
diff --git a/apps/desktop/e2e/mermaid-renderer.spec.ts b/apps/desktop/e2e/mermaid-renderer.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e8cbeeb013e543fff7ff524155fe0455eee759ba
--- /dev/null
+++ b/apps/desktop/e2e/mermaid-renderer.spec.ts
@@ -0,0 +1,154 @@
+import { writeFile } from 'node:fs/promises'
+import path from 'node:path'
+import { pathToFileURL } from 'node:url'
+
+import { _electron as electron, expect, test } from '@playwright/test'
+import { build } from 'esbuild'
+
+type Result = { error: string } | { svg: string }
+
+const FIXTURES = [
+  ['flowchart LR\n A[Read] --> B[Check] --> C[Done]', 'Check'],
+  ['sequenceDiagram\n participant A as Intake\n participant B as Review\n A->>B: Submit draft', 'Submit draft'],
+  ['classDiagram\n Draft <|-- Report\n class Draft{\n +String title\n }', 'Report'],
+  ['stateDiagram-v2\n [*] --> Ready\n Ready --> Done\n Done --> [*]', 'Ready'],
+  [
+    'gantt\n title Fixture schedule\n dateFormat YYYY-MM-DD\n section Plan\n Draft :d1, 2026-01-12, 2d',
+    'Fixture schedule'
+  ],
+  ['erDiagram\n TEAM ||--o{ REPORT : owns\n REPORT {\n string title\n }', 'REPORT'],
+  ['pie title Fixture work\n "Draft" : 2\n "Review" : 3', 'Fixture work'],
+  ['mindmap\n root((Plan))\n  Draft\n  Review', 'Plan']
+] as const
+
+function draw(code: string, dark = false) {
+  return { code, dark }
+}
+
+test('renders local static Mermaid SVG in both themes, refuses active inputs and terminates a hung layout', async ({}, info) => {
+  const appDir = path.resolve(import.meta.dirname, '..')
+  const entry = pathToFileURL(path.join(appDir, 'dist', 'mermaid-render.html')).href
+  const stalled = info.outputPath('stalled.html')
+  const bootstrap = info.outputPath('mermaid-host.cjs')
+  await writeFile(
+    stalled,
+    '<script>window.hermesRenderMermaid=()=>{const end=performance.now()+12000;while(performance.now()<end){}}</script>'
+  )
+  await build({
+    stdin: {
+      resolveDir: appDir,
+      contents: `
+        const { app, BrowserWindow, session } = require('electron');
+        const { createMermaidRenderer } = require('./electron/mermaid-renderer');
+        app.disableHardwareAcceleration();
+        app.setPath('userData', ${JSON.stringify(info.outputPath('profile'))});
+        globalThis.mermaidEntry = ${JSON.stringify(entry)};
+        globalThis.renderMermaid = createMermaidRenderer(() => new URL(globalThis.mermaidEntry));
+        globalThis.network = [];
+        app.whenReady().then(async () => {
+          session.defaultSession.webRequest.onBeforeRequest((request, done) => {
+            const remote = /^https?:/i.test(request.url);
+            if (remote) globalThis.network.push(request.url);
+            done({cancel: remote});
+          });
+          session.fromPartition('hermes-mermaid-renderer').webRequest.onBeforeSendHeaders(
+            { urls: ['http://*/*', 'https://*/*'] },
+            (request, done) => {
+              globalThis.network.push(request.url);
+              done({cancel: true});
+            }
+          );
+          const window = new BrowserWindow({ width: 640, height: 480 });
+          await window.loadURL('data:text/html,<h1>Fixture chat</h1>');
+        });
+      `
+    },
+    bundle: true,
+    external: ['electron'],
+    outfile: bootstrap,
+    platform: 'node'
+  })
+
+  const desktop = await electron.launch({ args: [bootstrap, '--disable-gpu'] })
+
+  try {
+    const page = await desktop.firstWindow()
+    const render = ({ code, dark }: ReturnType<typeof draw>) =>
+      desktop.evaluate(
+        async (_electron, input) => {
+          const host = globalThis as unknown as { renderMermaid: (code: string, dark: boolean) => Promise<Result> }
+
+          return host.renderMermaid(input.code, input.dark)
+        },
+        { code, dark }
+      )
+    const views = () => desktop.evaluate(({ webContents }) => webContents.getAllWebContents().length)
+
+    expect(await views()).toBe(1)
+
+    for (const [source, label] of FIXTURES) {
+      const light = await render(draw(source))
+      const dark = await render(draw(source, true))
+      for (const output of [light, dark]) {
+        expect(output).toHaveProperty('svg')
+        if (!('svg' in output)) continue
+        expect(output.svg).toContain(label)
+        expect(output.svg).toContain('<style>')
+        expect(output.svg).not.toMatch(/<(?:script|foreignObject|image|a)\b|\s(?:href|on\w+)=/i)
+        const valid = await page.evaluate(async svg => {
+          const image = new Image()
+          image.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg)
+          await image.decode()
+
+          return image.naturalWidth > 0 && image.naturalHeight > 0
+        }, output.svg)
+        expect(valid).toBe(true)
+      }
+      if ('svg' in light && 'svg' in dark) {
+        const css = (svg: string) =>
+          svg.match(/<style[^>]*>([\s\S]*?)<\/style>/)?.[1]?.replace(/mermaid-[a-f0-9-]+/g, '')
+        expect(css(light.svg)).not.toBe(css(dark.svg))
+      }
+    }
+
+    const standalone = await render(draw(FIXTURES[0][0]))
+    if (!('svg' in standalone)) throw new Error('Expected a diagram to open as a standalone SVG')
+    const saved = info.outputPath('diagram.svg')
+    await writeFile(saved, standalone.svg)
+    await page.goto(pathToFileURL(saved).href)
+    await expect(page.getByText('Check', { exact: true })).toBeVisible()
+
+    for (const active of [
+      '---\nconfig:\n  securityLevel: loose\n---\nflowchart LR\n A --> B',
+      '%%{init: {"securityLevel":"loose"}}%%\nflowchart LR\n A --> B',
+      'flowchart LR\n A["<img src=https://example.invalid/fixture.png>"]',
+      'flowchart LR\n A@{ img: "https://example.invalid/fixture.png", label: "Example" }',
+      'flowchart LR\n A --> B; click A "https://example.invalid/fixture"',
+      'flowchart LR\n A --> B; classDef sample fill:url(https://example.invalid/fixture)'
+    ]) {
+      expect(await render(draw(active))).toEqual({ error: 'restricted' })
+    }
+    expect(await render(draw('flowchart LR\n A -->'))).toEqual({ error: 'invalid' })
+    expect(await render(draw('x'.repeat(12_001)))).toEqual({ error: 'limit' })
+    expect(await render(draw('flowchart LR\n' + '\n'.repeat(160)))).toEqual({ error: 'limit' })
+    await expect.poll(views).toBe(1)
+
+    await desktop.evaluate((_electron, url) => {
+      Object.assign(globalThis, { mermaidEntry: url })
+    }, pathToFileURL(stalled).href)
+    const start = Date.now()
+    const pending = render(draw('flowchart LR\n A --> B'))
+    await expect.poll(views).toBe(2)
+    await expect(page.getByText('Check', { exact: true })).toBeVisible()
+    expect(await pending).toEqual({ error: 'timeout' })
+    expect(Date.now() - start).toBeLessThan(8_000)
+    await expect.poll(views).toBe(1)
+    await desktop.evaluate((_electron, url) => {
+      Object.assign(globalThis, { mermaidEntry: url })
+    }, entry)
+    expect(await render(draw(FIXTURES[0][0]))).toHaveProperty('svg')
+    expect(await desktop.evaluate(() => (globalThis as unknown as { network: string[] }).network)).toEqual([])
+  } finally {
+    await desktop.close()
+  }
+})
diff --git a/apps/desktop/e2e/owner-inbox.capture.mjs b/apps/desktop/e2e/owner-inbox.capture.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2963daebbbd51bf719ad576920e6b33a705e7b19
--- /dev/null
+++ b/apps/desktop/e2e/owner-inbox.capture.mjs
@@ -0,0 +1,84 @@
+import { strict as assert } from 'node:assert'
+import { mkdir, writeFile } from 'node:fs/promises'
+import { resolve } from 'node:path'
+
+import { chromium } from '@playwright/test'
+import { createServer } from 'vite'
+
+const [output, executablePath] = process.argv.slice(2)
+if (!output || !executablePath) throw new Error('Expected screenshot directory and Chromium executable')
+const target = resolve(output)
+await mkdir(target, { recursive: true })
+const server = await createServer({ server: { port: 0 }, clearScreen: false })
+let browser
+try {
+  await server.listen()
+  const endpoint = server.resolvedUrls.local[0] + 'e2e/owner-inbox.fixture.html'
+  browser = await chromium.launch({
+    executablePath, headless: true,
+    args: ['--disable-gpu', '--disable-gpu-compositing', '--disable-webgl', '--disable-background-networking']
+  })
+  const context = await browser.newContext({ viewport: { width: 1120, height: 780 }, reducedMotion: 'reduce' })
+  await context.route('**/*', route => route.request().url().startsWith(server.resolvedUrls.local[0])
+    ? route.continue() : route.abort())
+  const page = await context.newPage()
+  await page.goto(endpoint)
+  const badge = page.getByRole('button', { name: 'Waiting for owner 2' })
+  await badge.focus()
+  await page.keyboard.press('Enter')
+  const heading = page.getByRole('heading', { name: 'Waiting for owner' })
+  await heading.waitFor()
+  assert(await heading.evaluate(el => el === document.activeElement))
+  const cdp = await context.newCDPSession(page)
+  const tree = (await cdp.send('Accessibility.getFullAXTree')).nodes
+  assert(tree.some(node => node.role?.value === 'dialog' && node.name?.value === 'Waiting for owner'))
+  assert(tree.some(node => node.role?.value === 'radio' && node.name?.value === 'Fixture B'))
+  await page.screenshot({ path: resolve(target, 'owner-inbox-two-questions.png') })
+  await page.keyboard.press('Tab')
+  assert.equal(await page.evaluate(() => document.activeElement?.getAttribute('type')), 'radio')
+  await page.keyboard.press('ArrowDown')
+  assert.equal(await page.evaluate(() => document.activeElement?.closest('label')?.textContent), 'Fixture B')
+  await page.keyboard.press('Tab') // custom answer
+  await page.keyboard.press('Tab') // submit
+  assert.equal(await page.evaluate(() => document.activeElement?.textContent), 'Send answer')
+  await page.keyboard.press('Enter')
+  await page.getByText('The gateway accepted your response.').waitFor()
+  assert(await heading.evaluate(el => el === document.activeElement))
+  await page.screenshot({ path: resolve(target, 'owner-inbox-one-remaining.png') })
+  assert.equal(await page.getByText('Should I deliver the report as Markdown or PDF?').count(), 1)
+  assert.deepEqual(await page.evaluate(() => window.fixtureCalls.filter(([method]) => method === 'owner_inbox.respond')), [
+    ['owner_inbox.respond', { profile: 'tester', session_id: 'fixture-chat', prompt_id: 'fixture-q1',
+      authority_epoch: 1, execution_generation: 4, kind: 'clarify', value: 'Fixture B' }]
+  ])
+  await page.keyboard.press('Escape')
+  await page.waitForFunction(() => document.activeElement?.getAttribute('aria-label') === 'Waiting for owner 1')
+  await page.close()
+
+  const samples = []
+  for (const baseline of [true, false]) {
+    const idle = await context.newPage()
+    await idle.goto(endpoint + (baseline ? '?idle&baseline' : '?idle'))
+    await idle.getByRole('heading', { name: 'Bots' }).waitFor()
+    if (!baseline) await idle.waitForFunction(() => window.fixtureCalls.length === 1)
+    const client = await context.newCDPSession(idle)
+    await client.send('Performance.enable')
+    const snapshot = async () => {
+      await client.send('HeapProfiler.collectGarbage')
+      const metrics = new Map((await client.send('Performance.getMetrics')).metrics.map(metric => [metric.name, metric.value]))
+      return { jsHeapBytes: metrics.get('JSHeapUsedSize'), taskSeconds: metrics.get('TaskDuration') }
+    }
+    const before = await snapshot()
+    const startingCalls = await idle.evaluate(() => window.fixtureCalls.length)
+    const durationMs = 8000
+    await new Promise(resolve => setTimeout(resolve, durationMs))
+    const idleCalls = await idle.evaluate(() => window.fixtureCalls.length) - startingCalls
+    const after = await snapshot()
+    assert.equal(idleCalls, 0)
+    samples.push({ baseline, durationMs, idleCalls, before, after })
+    await idle.close()
+  }
+  await writeFile(resolve(target, 'owner-inbox-idle.json'), JSON.stringify(samples, null, 2) + '\n')
+} finally {
+  await browser?.close()
+  await server.close()
+}
diff --git a/apps/desktop/e2e/owner-inbox.fixture.html b/apps/desktop/e2e/owner-inbox.fixture.html
new file mode 100644
index 0000000000000000000000000000000000000000..94e08fc3ef95306fa58959d8ee799fdaadb1948a
--- /dev/null
+++ b/apps/desktop/e2e/owner-inbox.fixture.html
@@ -0,0 +1,66 @@
+<!doctype html>
+<html lang="en" class="dark">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>Bots · owner inbox fixture</title>
+  </head>
+  <body>
+    <main id="fixture"></main>
+    <script type="module">
+      import '/src/styles.css'
+      import { createElement as h } from 'react'
+      import { createRoot } from 'react-dom/client'
+      import { atom } from 'nanostores'
+      import { Button, host } from '@hermes/plugin-sdk'
+      import { registerPluginLocales } from '/src/i18n/plugin-i18n'
+      import { BOTS_LOCALES, useBots } from '/src/plugins/hermes-bots/i18n'
+      import { OwnerInbox } from '/src/plugins/hermes-bots/owner-inbox'
+
+      const baseline = new URLSearchParams(location.search).has('baseline')
+      const bots = [{ profile: 'tester', label: 'Tester' }, { profile: 'writer', label: 'Writer' }]
+      const now = Date.now() / 1000
+      let items = new URLSearchParams(location.search).has('idle') ? [] : [
+        { kind: 'clarify', profile: 'tester', prompt_id: 'fixture-q1', session_id: 'fixture-chat',
+          authority_epoch: 1, execution_generation: 4, created_at: now - 142, card: 't_fixture-1',
+          question: 'Which fixture should I run for the compatibility check?', choices: ['Fixture A', 'Fixture B'] },
+        { kind: 'clarify', profile: 'writer', prompt_id: 'fixture-q2', session_id: 'fixture-chat',
+          authority_epoch: 1, execution_generation: 6, created_at: now - 73, card: 't_fixture-2',
+          goal: 'Publish the fixture report', question: 'Should I deliver the report as Markdown or PDF?',
+          choices: ['Markdown', 'PDF'] }
+      ]
+      const listeners = new Set()
+      window.fixtureCalls = []
+      Object.assign(host.state, { connectionId: atom('local'), profile: atom('default'), gateway: atom('open') })
+      host.getGateway = () => gateway
+      const gateway = {
+        onEvent(listener) { listeners.add(listener); return () => listeners.delete(listener) },
+        async request(method, params) {
+          window.fixtureCalls.push(JSON.parse(JSON.stringify([method, params])))
+          if (method === 'owner_inbox.list') return { items }
+          if (method === 'owner_inbox.respond') {
+            items = items.filter(item => item.profile !== params.profile || item.prompt_id !== params.prompt_id)
+            for (const listener of listeners) listener({ type: 'owner_inbox.changed' })
+            return { status: 'resolved' }
+          }
+          return { watching: false }
+        }
+      }
+      registerPluginLocales('hermes-bots', BOTS_LOCALES)
+      function Fixture() {
+        const text = useBots()
+        return h('div', {
+        className: 'mx-auto mt-12 max-w-4xl rounded-lg border border-(--ui-stroke-tertiary) bg-background'
+      },
+        h('header', { className: 'flex flex-wrap items-center gap-3 border-b border-(--ui-stroke-tertiary) p-5' },
+          h('h1', { className: 'mr-auto text-xl font-semibold' }, 'Bots'),
+          h(Button, { size: 'sm', variant: 'ghost' }, 'Monitor'),
+          !baseline && h(OwnerInbox, { connection: 'local', bots, text })),
+        h('section', { className: 'grid gap-3 p-5' },
+          ...bots.map(bot => h('div', { key: bot.profile, className: 'border-b border-(--ui-stroke-tertiary) pb-3 text-sm' },
+            bot.label))))
+      }
+      createRoot(document.getElementById('fixture')).render(h(Fixture))
+    </script>
+  </body>
+</html>
