+  constructor() {
+    super()
+    this.stdin.on('data', b => this.frames.push(JSON.parse(String(b))))
+  }
+
+  reply(ticket: string, index = this.frames.length - 1) {
+    this.stdout.write(JSON.stringify({ id: this.frames[index].id, ticket }) + '\n')
