+"""Create a task with CLI reasoning depth without changing a profile."""
+import argparse
+import json
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban as kc
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / 'hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(home))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    for key in ('HERMES_KANBAN_TASK', 'HERMES_KANBAN_DB', 'HERMES_KANBAN_BOARD', 'HERMES_KANBAN_RUN_ID'):
+        monkeypatch.delenv(key, raising=False)
+    monkeypatch.setattr(kb, '_fire_task_hook', lambda *args, **kwargs: None)
+    kb._INITIALIZED_PATHS.clear()
+    kb.init_db()
+    root = argparse.ArgumentParser(prog='hermes')
+    kc.build_parser(root.add_subparsers())
+    return root
+
+
+@pytest.mark.parametrize('effort,expected', [('HIGH', 'high'), ('none', 'none')])
+def test_cli_create_passes_effort_from_card_to_worker(board, monkeypatch, capsys, effort, expected):
+    args = board.parse_args(['kanban', 'create', 'Synthetic task', '--assignee', 'default',
+                             '--reasoning-effort', effort, '--json'])
+    assert kc._cmd_create(args) == 0
+    task_id = json.loads(capsys.readouterr().out)['id']
+    with kbc.connect_closing() as conn:
+        task = kb.get_task(conn, task_id)
+    assert task.reasoning_effort == expected
+    from tests.kanban_policy_helpers import claimed_worker_policy
+    policy = claimed_worker_policy(task_id, monkeypatch, {
+        'model': {'default': 'fixture-model', 'provider': 'custom'},
+        'agent': {'reasoning_effort': 'low', 'reasoning_overrides': {'fixture-model': 'max'}},
+    })
+    assert json.loads(policy.request_json)['reasoning'] == expected
+    assert policy.config()['agent']['reasoning_effort'] == expected
+    assert 'reasoning_overrides' not in policy.config()['agent']
+
+
+def test_cli_invalid_effort_does_not_create_task_and_omission_inherits(board, capsys):
+    with pytest.raises(SystemExit):
+        board.parse_args(['kanban', 'create', 'Invalid', '--reasoning-effort', 'strongest'])
+    with kbc.connect_closing() as conn:
+        assert not kb.list_tasks(conn)
+    args = board.parse_args(['kanban', 'create', 'Inherit', '--assignee', 'default', '--json'])
+    assert kc._cmd_create(args) == 0
+    task_id = json.loads(capsys.readouterr().out)['id']
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, task_id).reasoning_effort is None
diff --git a/tests/hermes_cli/test_kanban_decompose_role_routing.py b/tests/hermes_cli/test_kanban_decompose_role_routing.py
