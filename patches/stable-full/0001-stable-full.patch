+
+def test_idle_hooks_report_unverified_wait_once_without_dispatch(home, monkeypatch):
+    import queue
+    from hermes_cli.cli_loops_mixin import CLILoopsMixin
+    from tui_gateway import session_notifications
+    from tui_gateway.method_ctx import rebind
+
+    monkeypatch.setattr(goals, '_session_waiting', lambda _: None)
+    mgr = goals.GoalManager(session_id='unknown-ui'); mgr.set('finish original job')
+    mgr.wait_on_session('proc_original')
+    mgr.state.waiting_since = time.time() - goals._MAX_BARRIER_WAIT_S - 10
+    mgr._save()
+
+    class Cli(CLILoopsMixin):
+        _pending_input = queue.Queue()
+        def _get_goal_manager(self): return mgr
+
+    prints = Mock()
+    monkeypatch.setattr('cli._cprint', prints)
+    cli = Cli(); cli._maybe_resume_parked_goal(); cli._last_goal_barrier_check = 0
+    cli._maybe_resume_parked_goal()
+    assert mgr.state.status == 'paused' and cli._pending_input.empty()
+    assert prints.call_count == 1 and 'paused' in str(prints.call_args).lower()
+
+    mgr.resume(reset_budget=False); mgr.wait_on_session('proc_original')
+    mgr.state.waiting_since = time.time() - goals._MAX_BARRIER_WAIT_S - 10
+    mgr._save()
+    monkeypatch.setattr(goals, 'GoalManager', lambda session_id: mgr)
+    emit, submit = Mock(), Mock()
+    poll = rebind(session_notifications._maybe_resume_tui_parked_goal, {'_emit': emit, '_run_prompt_submit': submit})
+    poll('sid', {'session_key': 'unknown-ui'}); poll('sid', {'session_key': 'unknown-ui'})
+    assert mgr.state.status == 'paused' and emit.call_count == 1
+    assert 'paused' in str(emit.call_args).lower()
+    submit.assert_not_called()
