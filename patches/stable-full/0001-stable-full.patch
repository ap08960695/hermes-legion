+@pytest.mark.parametrize('term', ['needle', 'cafe', 'terminal', '100'])
+def test_adversarial_nested_escapes_and_quotes_keep_native_hits(db, term):
+    rng = random.Random(8732)
+    candidates = []
+    for i in range(300):
+        aliases = [chr(rng.choice((ord(c), ord(c.upper()), *FOLD_ALIASES.get(ord(c), ())))) for c in term]
+        value = ''.join(aliases)
+        for _ in range(i % 4):
+            value = json.dumps({'nested': value, 'delimiter': '\\"'}, ensure_ascii=True)
+        raw = json.dumps({'arguments': value, 'noise': ['sentinel0', '"', '\\', 'x' * 900]}, ensure_ascii=True)
+        if i % 5 == 0:
+            raw = raw.replace('sentinel0', r'sentinel\u0030')
+        candidates.append((i + 1, raw))
+    db.executemany('INSERT INTO messages(id,tool_calls) VALUES(?,?)', candidates)
+    search = GlobalSearch(db, [(term, False), (term, True)])
+    verified = 0
+    try:
+        for mid, raw in candidates:
+            # Force both selective checks to stay enabled for this oracle test.
+            search.ordered_prefilter.samples[term] = [32, 32, 32]
+            for prefix in (False, True):
+                if search.tool_contains(mid, term, prefix):
+                    verified += 1
+                    assert not search.ordered_prefilter.reject(raw, term, None)
+                    assert search.small_json_token_maybe(raw, term) == 1
+        assert verified >= 300
+    finally:
+        search.close()
