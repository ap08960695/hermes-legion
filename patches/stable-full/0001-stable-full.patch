index 0000000..6dd5de7
--- /dev/null
+++ b/gateway/session_bootstrap_io.py
@@ -0,0 +1,31 @@
+"""Keep profile preparation under custody until its physical I/O has settled."""
+import asyncio
+from contextvars import copy_context
+from functools import partial
+
+
+async def profile_store_io(operation, *args, get_executor=None, **kwargs):
+    """Drain even repeated cancellation; Gateway work belongs to its native shutdown pool.
+
+    Shield the executor Future itself: a child Task can also be cancelled during loop teardown,
+    leaving its physical writer running after the profile reservation has been released.
+    Resolve the executor per operation so the native closing fence remains authoritative.
+    """
+    executor = get_executor() if get_executor is not None else None
+    pending = asyncio.get_running_loop().run_in_executor(
+        executor, copy_context().run, partial(operation, *args, **kwargs))
+    cancelled = None
+    try:
+        while not pending.done():
+            try:
+                await asyncio.shield(pending)
+            except asyncio.CancelledError as exc:
+                cancelled = exc
+        result = pending.result()
+    except BaseException:
+        if cancelled is not None:
+            raise cancelled
+        raise
+    if cancelled is not None:
+        raise cancelled
+    return result
