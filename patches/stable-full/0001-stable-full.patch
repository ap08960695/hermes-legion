+def _clip_show_field(value: Any, limit: int) -> Any:
+    """Short values pass through unchanged (dicts stay dicts); long ones become a clipped string."""
+    text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False, default=str)
+    if value is None or len(text) <= limit:
+        return value
+    return text[:limit] + f"... [truncated {len(text) - limit} chars; kanban_show full=true]"
