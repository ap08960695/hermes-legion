+         help="Explicitly run one existing daily attention receipt in its closed stored local chat; never drains other work"),
     _cmd("notify-unsubscribe", [_TASK_ID, *_NOTIFY_TARGET], help="Remove a gateway subscription from a task"),
diff --git a/hermes_cli/kanban_profile_config.py b/hermes_cli/kanban_profile_config.py
