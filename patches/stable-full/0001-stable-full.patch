@@ -0,0 +1,83 @@
+"""Settings write failures explain recovery without disclosing filesystem details."""
+
+import errno
+
+import pytest
+from starlette.testclient import TestClient
+
+import utils
+from hermes_cli import config, web_server
+
+
+@pytest.mark.parametrize(
+    ("error_number", "guidance"),
+    [
+        (errno.EACCES, "write access"),
+        (errno.EPERM, "write access"),
+        (errno.EROFS, "write access"),
+        (errno.ENOSPC, "storage"),
+        (errno.EDQUOT, "storage"),
+        (errno.EIO, "Internal server error"),
+    ],
+)
+def test_failed_settings_write_is_private_and_can_be_retried(
+    _isolate_hermes_home, monkeypatch, error_number, guidance
+):
+    """Catch opaque known failures, exception leaks, or a partial failed save."""
+    path = config.get_config_path()
+    config.atomic_config_replace(
+        path, {"memory": {"memory_char_limit": 2800}, "display": {"language": "en"}}
+    )
+    before = path.read_bytes()
+    client = TestClient(web_server.app)
+    client.headers[web_server._SESSION_HEADER_NAME] = web_server._SESSION_TOKEN
+    patch = {"config": {"memory": {"memory_char_limit": 2900}}}
+
+    def refuse_staging(*_args, **_kwargs):
+        raise OSError(error_number, "private error detail", "/private/user-secret/config.yaml")
+
+    try:
+        with monkeypatch.context() as fault:
+            fault.setattr(utils, "mkstemp_beside", refuse_staging)
+            response = client.put("/api/config", json=patch)
+        assert response.status_code == 500
+        detail = response.json()["detail"]
+        assert guidance in detail
+        assert "private" not in detail and "user-secret" not in detail
+        assert path.read_bytes() == before
+
+        assert client.put("/api/config", json=patch).json() == {"ok": True}
+        saved = config.require_readable_config_before_write(path)
+        assert saved["memory"]["memory_char_limit"] == 2900
+        assert saved["display"]["language"] == "en"
+    finally:
+        client.close()
+
+
+def test_settings_error_does_not_claim_the_file_was_unchanged_after_replace(
+    _isolate_hermes_home, monkeypatch
+):
+    """Cleanup/metadata can fail after replacement; retry must remain safe."""
+    path = config.get_config_path()
+    config.atomic_config_replace(path, {"memory": {"memory_char_limit": 2800}})
+    replace = utils.atomic_replace
+
+    def fail_after_replace(source, destination):
+        replace(source, destination)
+        raise PermissionError(errno.EACCES, "private cleanup failure", str(destination))
+
+    client = TestClient(web_server.app)
+    client.headers[web_server._SESSION_HEADER_NAME] = web_server._SESSION_TOKEN
+    patch = {"config": {"memory": {"memory_char_limit": 2900}}}
+    try:
+        with monkeypatch.context() as fault:
+            fault.setattr(utils, "atomic_replace", fail_after_replace)
+            response = client.put("/api/config", json=patch)
+        assert response.status_code == 500
+        assert "finish" in response.json()["detail"]
+        assert "private" not in response.json()["detail"]
+        assert config.require_readable_config_before_write(path)["memory"]["memory_char_limit"] == 2900
+        assert client.put("/api/config", json=patch).json() == {"ok": True}
+        assert config.require_readable_config_before_write(path)["memory"]["memory_char_limit"] == 2900
+    finally:
+        client.close()
