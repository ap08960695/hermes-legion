+"""Small runtime bindings must not hydrate a session's prompt and transcript context."""
+from types import SimpleNamespace
+import sqlite3
+
+import pytest
+
+from agent.codex_runtime import _stored_codex_thread_id
+from hermes_state import SessionDB
+
+
+@pytest.mark.parametrize("read_only", [False, True])
+def test_codex_thread_binding_does_not_require_prompt_reads(tmp_path, read_only):
+    path = tmp_path / "state.db"
+    with SessionDB(db_path=path) as writer:
+        writer.create_session(
+            "session", "desktop", system_prompt="Synthetic context. " * 16384,
+            model_config={"codex_thread_id": "example-thread"},
+        )
+        if read_only:
+            db = SessionDB(db_path=path, read_only=True)
+        else:
+            db = writer
+
+        def metadata_only(action, table, column, *_args):
+            if action == sqlite3.SQLITE_READ and (
+                (table == "system_prompts" and column == "prompt")
+                or (table == "sessions" and column in {"system_prompt", "tool_names"})
+            ):
+                return sqlite3.SQLITE_DENY
+            return sqlite3.SQLITE_OK
+
+        # Apply the policy to the next borrowed native read connection.
+        with db._read_ctx() as connection:
+            connection.set_authorizer(metadata_only)
+        try:
+            agent = SimpleNamespace(_session_db=db, session_id="session")
+            assert _stored_codex_thread_id(agent) == "example-thread"
+        finally:
+            with db._read_ctx() as connection:
+                connection.set_authorizer(None)
+            if read_only:
+                db.close()
+
+
+def test_config_read_preserves_missing_defaults_and_fresh_committed_values(tmp_path):
+    with SessionDB(db_path=tmp_path / "state.db") as db:
+        fallback = object()
+        assert db.get_session_model_config_value("absent", "key", fallback) is fallback
+        db.create_session("session", "desktop", model_config={"key": {"ready": False}, "empty": None})
+        assert db.get_session_model_config_value("session", "key") == {"ready": False}
+        assert db.get_session_model_config_value("session", "missing", fallback) is fallback
+        assert db.get_session_model_config_value("session", "empty", fallback) is None
+        db.patch_session_model_config("session", {"key": {"ready": True}})
+        assert db.get_session_model_config_value("session", "key") == {"ready": True}
