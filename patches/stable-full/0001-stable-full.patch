+"""A retired profile drops config copies; a parked profile or live writer keeps its recovery state."""
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import config, config_effective
+from hermes_constants import mark_named_profile_deleted, reset_hermes_home_override, set_hermes_home_override
+from gateway.run_profile_reconcile import GatewayProfileReconcileMixin
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('deleted,retired', [(True, True), (False, True), (True, False)])
+async def test_unserve_releases_only_retired_config(tmp_path, monkeypatch, deleted, retired):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    root = tmp_path / '.hermes'
+    home = root / 'profiles' / 'retiring'
+    home.mkdir(parents=True)
+    managed = tmp_path / 'managed'
+    managed.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(root))
+    monkeypatch.setenv('HERMES_MANAGED_DIR', str(managed))
+    for path in [root, home]:
+        (path / 'config.yaml').write_text('display:\n  skin: mono\n')
+        token = set_hermes_home_override(path)
+        try:
+            config.load_config()
+            config.read_raw_config()
+            config_effective.load_user_config_effective()
+        finally:
+            reset_hermes_home_override(token)
+    caches = [config._LOAD_CONFIG_CACHE, config._RAW_CONFIG_CACHE,
+              config._LAST_EXPANDED_CONFIG_BY_PATH, config_effective._EFFECTIVE_CACHE,
+              config_effective._LAST_GOOD_USER_RAW]
+    key, root_key = str(home / 'config.yaml'), str(root / 'config.yaml')
+    held = [cache[root_key] for cache in caches]
+    assert all(key in cache for cache in caches)
+    if deleted:
+        mark_named_profile_deleted(home)
+    runner = SimpleNamespace(_profile_failed_platforms={}, _profile_adapters={},
+                             pairing_stores={}, _served_profile_homes={},
+                             _served_profile_signatures={}, _agent_cache={},
+                             config=SimpleNamespace(_runtime_profile_homes=()))
+    if not retired:
+        async def still_writing(*args):
+            return False
+        monkeypatch.setattr('gateway.run_runtime.unserve_profile_runtime', still_writing)
+        runner.session_authorities = SimpleNamespace()
+    await GatewayProfileReconcileMixin._unserve_profile(runner, 'retiring', home)
+    assert all((key not in cache) if deleted and retired else (key in cache) for cache in caches)
+    assert all(cache[root_key] is value for cache, value in zip(caches, held))
