+        try:
+            if not path.is_file():status={'status':'unavailable','error_type':'NotRegularFile'}
+            else:rows,status=read_board(path,start,end,keys);runs.extend(rows)
+        except sqlite3.Error as exc:status={'status':'unavailable','error_type':type(exc).__name__}
+        coverage['boards'][str(path)]=status
