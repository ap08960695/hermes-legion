+"""On-demand local memory counters expose no session, prompt or credential content."""
+
+import asyncio
+import json
+import os
+import sqlite3
+import threading
+import tracemalloc
+from types import SimpleNamespace
+from pathlib import Path
+
+import pytest
+
+from gateway.control_socket import GatewayControlServer, query_gateway_control
+
+
+@pytest.mark.platforms('posix')
+def test_native_control_socket_exposes_read_only_memory_counters(tmp_path):
+    async def exercise():
+        server = GatewayControlServer(tmp_path)
+        assert await server.start()
+        try:
+            result = await asyncio.to_thread(query_gateway_control, tmp_path, 'memory-stats')
+            assert result and result.get('pid') == os.getpid()
+            assert isinstance(result.get('process'), dict)
+            assert result['sqlite']['reset_highwater'] is False
+        finally:
+            await server.stop()
+    asyncio.run(exercise())
+
+
+def test_cache_diagnostics_count_containers_without_inspecting_their_contents(monkeypatch):
+    from gateway import runtime_memory
+
+    class PrivateValue:
+        def __repr__(self):
+            pytest.fail('Memory diagnostics must not inspect private cached objects')
+
+    marker = 'private-session-prompt-account-marker'
+    runner = SimpleNamespace(_agent_cache={marker: PrivateValue()}, _sessions={marker: PrivateValue()},
+                             _profile_configs={marker: PrivateValue()})
+    monkeypatch.setattr(runtime_memory, '_current_runner', lambda: runner)
+    result = runtime_memory.collect_runtime_memory()
+    assert result['caches'] == {'agents': 1, 'session_states': 1, 'profile_configs': 1}
+    assert marker not in json.dumps(result)
+
+
+def test_unavailable_sqlite_tracking_is_not_reported_as_zero(monkeypatch):
+    from gateway import runtime_memory
+    monkeypatch.setattr(runtime_memory, '_sqlite_functions', lambda: None)
+    result = runtime_memory.collect_runtime_memory()['sqlite']
+    assert result['available'] is False
+    assert result['current_bytes'] is None and result['highwater_bytes'] is None
+
+
+def test_diagnostics_do_not_trim_memory_or_open_a_database(tmp_path, monkeypatch):
+    from gateway import runtime_memory
+    from hermes_cli import mem_trim
+    import hermes_state_registry
+
+    def forbidden(*args, **kwargs):
+        pytest.fail('Memory observation must not trim or initialize a session database')
+
+    before = hermes_state_registry.stats()
+    monkeypatch.setattr(mem_trim, 'trim_memory', forbidden)
+    monkeypatch.setattr(hermes_state_registry, 'acquire', forbidden)
+    runtime_memory.collect_runtime_memory()
+    assert hermes_state_registry.stats() == before
+    assert not (tmp_path / 'state.db').exists()
+
+
+@pytest.mark.platforms('linux')
+def test_native_sqlite_allocator_counter_observes_an_isolated_allocation():
+    from gateway import runtime_memory
+    before = runtime_memory.collect_runtime_memory()['sqlite']
+    if not before['available']:
+        pytest.skip('This SQLite build does not expose allocator tracking')
+    with sqlite3.connect(':memory:') as conn:
+        conn.execute('CREATE TABLE allocation(value BLOB)')
+        conn.executemany('INSERT INTO allocation VALUES(?)', [(bytes(8192),)] * 256)
+        after = runtime_memory.collect_runtime_memory()['sqlite']
+        assert after['current_bytes'] > before['current_bytes'] + 1_000_000
+        assert after['highwater_bytes'] >= after['current_bytes']
