+import { useCallback, useEffect } from 'react'
+
+import { triggerHaptic } from '@/lib/haptics'
+
+import type { DroppedFile } from '../../hooks/use-composer-actions'
+import { extractClipboardFiles } from '../clipboard-files'
+import { type ComposerTarget, onComposerAttachFilesRequest } from '../focus'
+import type { ChatBarProps } from '../types'
+
+interface FilePasteArgs {
+  disabled: boolean
+  onAttachDroppedItems: ChatBarProps['onAttachDroppedItems']
+  target: ComposerTarget
+}
+
+export function useComposerFilePaste({ disabled, onAttachDroppedItems, target }: FilePasteArgs) {
+  const attach = useCallback(
+    (files: DroppedFile[]) => {
+      if (disabled || !onAttachDroppedItems || !files.length) {
+        return false
+      }
+
+      triggerHaptic('selection')
+      void onAttachDroppedItems(files)
+
+      return true
+    },
+    [disabled, onAttachDroppedItems]
+  )
+
+  useEffect(
+    () =>
+      onComposerAttachFilesRequest(detail => {
+        if (detail.target === target) {
+          attach(detail.files)
+        }
+      }),
+    [attach, target]
+  )
+
+  return (clipboard: DataTransfer) => attach(extractClipboardFiles(clipboard))
+}
