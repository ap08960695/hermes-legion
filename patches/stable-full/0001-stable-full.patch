+"""Cross-profile read-only CJK recall should use a healthy existing index."""
+import json
+import shutil
+import sqlite3
+import subprocess
+import threading
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+import pytest
+
+from hermes_state import SessionDB
+
+
+REPO = Path(__file__).resolve().parent.parent.parent
+
+
+@pytest.fixture(scope="session")
+def cjk_so(tmp_path_factory):
+    source = REPO / "native/fts5_cjk/fts5_cjk.c"
+    vendor = source.parent / "vendor"
+    if not shutil.which("gcc") or not source.exists():
+        pytest.skip("native CJK compiler or source unavailable")
+    path = tmp_path_factory.mktemp("readonly-cjk") / "libfts5_cjk.so"
+    subprocess.run(["gcc", "-shared", "-fPIC", "-O2", f"-I{vendor}", str(source), "-o", str(path)],
+                   check=True, capture_output=True)
+    probe = sqlite3.connect(":memory:")
+    try:
+        probe.enable_load_extension(True)
+        probe.load_extension(str(path))
+    finally:
+        probe.close()
+    return path
+
+
+def test_readonly_cjk_search_keeps_native_unicode_folding(tmp_path, monkeypatch, cjk_so):
+    monkeypatch.setenv("HERMES_FTS5_CJK_SO", str(cjk_so))
+    writer = SessionDB(tmp_path / "state.db")
+    reader = None
+    try:
+        assert writer._fts_cjk_available
+        writer.create_session("s", source="cli")
+        accented = writer.append_message("s", role="user", content="café 完成率")
+        plain = writer.append_message("s", role="user", content="cafe 完成率")
+        writer.append_message("s", role="user", content="cafe unrelated")
+        query = '"café" AND 完成率'
+        assert {row["id"] for row in writer.search_messages(query, fields=["id"])} == {accented, plain}
+        reader = SessionDB(writer.db_path, read_only=True)
+        assert {row["id"] for row in reader.search_messages(query, fields=["id"])} == {accented, plain}
+        assert reader._conn.total_changes == 0
+        with pytest.raises(sqlite3.OperationalError):
+            reader._conn.execute("CREATE TABLE must_remain_read_only(x)")
+    finally:
+        if reader is not None:
+            reader.close()
+        writer.close()
+
