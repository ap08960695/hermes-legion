diff --git a/apps/desktop/src/app/session-manager/use-history-search.ts b/apps/desktop/src/app/session-manager/use-history-search.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b5775d973093c40cb313a8f2d267f46a9ba67748
--- /dev/null
+++ b/apps/desktop/src/app/session-manager/use-history-search.ts
@@ -0,0 +1,17 @@
+import { useEffect, useRef, useState } from 'react'
+import { useLocation } from 'react-router'
+
+/** Explicit search handoffs seed native History once per route change; typing stays local. */
+export function useHistorySearch() {
+  const { pathname, search } = useLocation()
+  const [searchQuery, setSearchQuery] = useState('')
+  const searchInputRef = useRef<HTMLInputElement>(null)
+  useEffect(() => {
+    if (pathname !== '/history') return
+    const query = new URLSearchParams(search).get('search')
+    if (query === null) return
+    setSearchQuery(query)
+    searchInputRef.current?.focus({ preventScroll: true })
+  }, [pathname, search])
+  return { searchQuery, setSearchQuery, searchInputRef }
+}
