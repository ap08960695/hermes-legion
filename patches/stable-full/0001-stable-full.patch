+    def test_concurrent_first_use_waits_for_the_shared_connection(self):
+        from tools import mcp_tool_discovery as discovery
+        from tools.mcp_tool_lifecycle import shutdown_mcp_servers
+        from tools.registry import registry
+
+        servers = self._peer_servers()
+        servers["memory_echo"]["connect_timeout"] = 15
+        config = self.load({"memory_saving": True}, servers)
+        allow_connect, connecting = threading.Event(), threading.Event()
+        original = discovery._discover_and_register_server
+
+        async def delayed_connect(name, cfg):
+            connecting.set()
+            await asyncio.to_thread(allow_connect.wait, 15)
+            return await original(name, cfg)
+
+        try:
+            cold = discovery.register_mcp_servers(config)
+            name = next(n for n in cold if n.endswith("echo"))
+            shutdown_mcp_servers()
+            discovery.register_mcp_servers(config)
+            with patch.object(discovery, "_discover_and_register_server", new=delayed_connect):
+                with concurrent.futures.ThreadPoolExecutor(2) as pool:
+                    first = pool.submit(contextvars.copy_context().run, registry.dispatch, name, {"value": "first"})
+                    self.assertTrue(connecting.wait(5))
+                    second = pool.submit(contextvars.copy_context().run, registry.dispatch, name, {"value": "second"})
+                    try:
