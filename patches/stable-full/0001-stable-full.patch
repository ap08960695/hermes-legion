index 0000000000000000000000000000000000000000..444ead3688dade4832b885192df21f7be64c0acc
--- /dev/null
+++ b/apps/desktop/electron/config-autosave-route.ts
@@ -0,0 +1,128 @@
+import { createHash } from 'node:crypto'
+
+import type { HermesApiRequest } from '../../shared/src/api-request'
+
+import type { CapturedConfigRoute } from './config-autosave'
+import {
+  apiRequestRegistryConnectionId,
+  pathForRegistryBackendRequest,
+  type ProfileRouteOptions,
+  type RegistryBackendRequestScope,
+  resolveProfileApiRequest
+} from './connection-config'
+import type { DesktopRemoteRouteInput } from './desktop-remote-route'
+import { resolveDesktopRemoteRoute } from './desktop-remote-route'
+
+/** Only destination inputs belong in the resolution guard. Registry UI
+ * metadata must not invalidate an accepted edit. Credentials remain in the
+ * private guard because headers or principals can select another tenant. */
+export function configRouteRevision(
+  request: HermesApiRequest,
+  input: DesktopRemoteRouteInput,
+  primaryProfile: string,
+  options: ProfileRouteOptions
+): string {
+  const registryId = apiRequestRegistryConnectionId(request)
+
+  const destination = (value: unknown): unknown => {
+    if (!value || typeof value !== 'object') { return value }
+
+    return Object.fromEntries(Object.entries(value).filter(([key]) =>
+      key !== 'label'
+    ).map(([key, entry]) => [key, destination(entry)]))
+  }
+
+  return JSON.stringify([
+    primaryProfile, options,
+    destination(resolveDesktopRemoteRoute({ ...input, profile: request.profile || primaryProfile })),
+    destination(resolveDesktopRemoteRoute({ ...input, profile: primaryProfile })),
+    registryId ? destination(input.registry.connections.find(entry => entry.id === registryId)) : null
+  ])
+}
+
+interface ConfigRouteDeps<C extends RegistryBackendRequestScope> {
+  revision: (request: HermesApiRequest) => string
+  primaryProfile: () => string
+  legacyOptions: (profile: string | null | undefined, request: HermesApiRequest) => ProfileRouteOptions
+  ensureLegacy: (profile: string | null, request: HermesApiRequest) => Promise<C>
+  ensureRegistry: (connectionId: string, request: HermesApiRequest) => Promise<C>
+  forgetLegacy: (profile: string | null, request: HermesApiRequest) => Promise<void>
+  send: (connection: C, path: string, request: HermesApiRequest, reconnect?: {
+    ensure: () => Promise<C>
+    forget: () => Promise<void>
+  }) => Promise<unknown>
+}
+
+/** Begin resolving the original route at admission, not when its debounce
+ * expires. A settings write must never reinterpret a legacy alias as 'local'. */
+export function createConfigRouteCapture<C extends RegistryBackendRequestScope>(deps: ConfigRouteDeps<C>) {
+  return (request: HermesApiRequest): CapturedConfigRoute => {
+    const revision = deps.revision(request)
+    const registry = apiRequestRegistryConnectionId(request)
+    const options = registry ? undefined : deps.legacyOptions(request.profile, request)
+    const legacy = registry ? undefined : resolveProfileApiRequest(request.profile, request.path, options)
+    const profile = request.profile?.trim() || (registry ? '__implicit__' : deps.primaryProfile())
+
+    const key = JSON.stringify([
+      registry ?? '__legacy__', profile, createHash('sha256').update(revision).digest('hex')
+    ])
+
+    const assertOwner = () => {
+      if (deps.revision(request) !== revision) {
+        throw new Error('Settings destination changed while it was being resolved')
+      }
+    }
+
+    const resolve = () => {
+      assertOwner()
+
+      const connection = registry
+        ? deps.ensureRegistry(registry, request)
+        : deps.ensureLegacy(legacy!.backendProfile, request)
+
+      return connection.then(backend => { assertOwner();
+
+ return backend })
+    }
+
+    let resolutionFailed = false
+
+    const beginResolve = async () => {
+      try {
+        return await resolve()
+      } catch (error) {
+        resolutionFailed = true
+        throw error
+      }
+    }
+
+    let resolved = beginResolve()
+    // A rejected dial can settle before the delayed request awaits it.
+    void resolved.catch(() => undefined)
+
+    return {
+      key,
+      async send(next) {
+        // Retry a failed dial only under the originally captured routing
+        // inputs. A transient failure must not poison this accepted edit.
+        if (resolutionFailed) {
+          resolutionFailed = false
+          resolved = beginResolve()
+        }
+
+        const backend = await resolved
+
+        const targetPath = registry
+          ? pathForRegistryBackendRequest(next.path, request.profile, backend, next.method || 'GET')
+          : resolveProfileApiRequest(request.profile, next.path, { ...options, requestMethod: next.method }).requestPath
+
+        return deps.send(backend, targetPath, next, registry ? undefined : {
+          ensure: () => { resolved = beginResolve();
+
+ return resolved },
+          forget: async () => { assertOwner(); await deps.forgetLegacy(legacy!.backendProfile, request) }
+        })
+      }
+    }
+  }
+}
