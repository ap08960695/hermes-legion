+
+import pytest
+
+
+@pytest.fixture
+def skill_fleet(tmp_path, monkeypatch):
+    root = tmp_path / 'fleet'
+    profile = root / 'profiles' / 'worker'
+    profile.mkdir(parents=True)
+    (profile / 'config.yaml').write_text('platform_toolsets:\n  cli: [file]\n')
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setenv('HERMES_HOME', str(root))
+    monkeypatch.setenv('HERMES_ROOT', str(root))
+    return profile / 'skills'
+
+
+def _skill(path):
+    path.mkdir(parents=True)
+    (path / 'SKILL.md').write_text('---\nname: ' + path.name + '\ndescription: Fixture\n---\nFixture.\n')
+
+
+def test_preflight_rejects_archives_inside_skill_support_or_dependencies(skill_fleet):
+    from tools.kanban_tools import _skills_available_for
+    root = skill_fleet
+    for path in [root / 'fixture-live', root / 'fixture-live/references/fixture-archive',
+                 root / 'node_modules/fixture-dependency']:
+        _skill(path)
+    wanted = ['fixture-live', 'fixture-archive', 'fixture-dependency']
+    assert _skills_available_for('worker', wanted) == (wanted[:1], wanted[1:])
+
+
+def test_preflight_does_not_read_dependency_tree_on_repeated_requests(skill_fleet, monkeypatch):
+    from tools.kanban_tools import _skills_available_for
+    root = skill_fleet
+    _skill(root / 'fixture-live')
+    _skill(root / 'node_modules/irrelevant/nested/dependency')
+    scans = []
+    real = os.scandir
+    def scan(path):
+        if isinstance(path, (str, os.PathLike)) and Path(path).is_relative_to(root / 'node_modules'):
+            scans.append(str(path))
+        return real(path)
+    monkeypatch.setattr(os, 'scandir', scan)
+    for _ in range(3):
+        assert _skills_available_for('worker', ['fixture-live']) == (['fixture-live'], [])
+    assert not scans, 'preflight walked unrelated dependency files'
