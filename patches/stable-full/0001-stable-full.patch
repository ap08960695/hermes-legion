+"""ESTOP links remain a stop and must never overwrite unrelated target data."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from agent import estop
+
+
+@pytest.fixture
+def fleet(tmp_path, monkeypatch):
+    root = tmp_path / "fleet"
+    alpha = root / "profiles" / "alpha"
+    beta = root / "profiles" / "beta"
+    alpha.mkdir(parents=True)
+    beta.mkdir(parents=True)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_HOME", str(alpha))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(root))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    return root, alpha, beta
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("where", ["local", "fleet"])
+def test_dangling_link_is_a_pause_until_explicit_resume(fleet, monkeypatch, tmp_path, where):
+    from hermes_cli.subcommands.pause import cmd_resume
+
+    root, alpha, beta = fleet
+    marker = (alpha if where == "local" else root) / "ESTOP"
+    target = tmp_path / "missing-target"
+    marker.symlink_to(target)
+    if where == "fleet":
+        monkeypatch.setenv("HERMES_HOME", str(beta))
+    assert marker.is_symlink() and not target.exists()
+    assert estop.is_engaged() is True
+    assert estop.get_state() == {"reason": None, "engaged_at": None}
+    assert "paused" in estop.paused_reply().lower()
+    assert cmd_resume(argparse.Namespace()) == 0
+    assert not marker.is_symlink() and not target.exists()
+    assert estop.is_engaged() is False
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("where", ["local", "fleet"])
+def test_engage_does_not_write_through_existing_link(fleet, tmp_path, where):
+    root, alpha, _ = fleet
+    marker = (alpha if where == "local" else root) / "ESTOP"
+    target = tmp_path / "unrelated.json"
+    original = b'{"reason":"unrelated data"}\n'
+    target.write_bytes(original)
+    marker.symlink_to(target)
+    if where == "local":
+        estop.engage("new reason")
+    else:
+        estop.engage_fleet("new reason")
+    assert marker.is_symlink()
+    assert target.read_bytes() == original
+    assert estop.is_engaged() is True
+    assert estop.get_state() == {"reason": None, "engaged_at": None}
+
+
+@pytest.mark.platforms("posix")
+def test_engage_does_not_create_a_dangling_links_target(fleet, tmp_path):
+    root, _, _ = fleet
+    target = tmp_path / "missing-target"
+    marker = root / "ESTOP"
+    marker.symlink_to(target)
+    estop.engage_fleet("new reason")
+    assert marker.is_symlink()
+    assert not target.exists()
+    assert estop.is_engaged() is True
+
+
+@pytest.mark.platforms("posix")
+def test_engage_does_not_modify_other_hardlink_to_sentinel(fleet, tmp_path):
+    root, _, _ = fleet
+    target = tmp_path / "unrelated.txt"
+    original = b'{"reason":"unrelated data"}\n'
+    target.write_bytes(original)
+    marker = root / "ESTOP"
+    os.link(target, marker)
+    estop.engage_fleet("new reason")
+    assert target.read_bytes() == original
+    assert estop.is_engaged() is True
+    assert estop.get_state() == {"reason": None, "engaged_at": None}
+
+
+def test_normal_fleet_pause_still_updates_reason_and_preserves_mode(fleet):
+    root, _, _ = fleet
+    marker = root / "ESTOP"
