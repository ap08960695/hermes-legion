+"""Captain reassignment must not reclaim or overwrite a concurrent owner."""
+import json
+import socket
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / '.hermes'; home.mkdir()
+    monkeypatch.setenv('HOME', str(tmp_path)); monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setenv('HERMES_HOME', str(home)); monkeypatch.setenv('HERMES_KANBAN_HOME', str(home))
+    monkeypatch.setenv('HERMES_PROFILE', 'orchestra-captain')
+    for key in ('HERMES_KANBAN_DB', 'HERMES_KANBAN_BOARD', 'HERMES_KANBAN_TASK', 'HERMES_KANBAN_RUN_ID'):
+        monkeypatch.delenv(key, raising=False)
+    def no_network(*args, **kwargs): pytest.fail('reassignment must stay offline')
+    monkeypatch.setattr(socket.socket, 'connect', no_network)
+    monkeypatch.setattr(socket, 'create_connection', no_network)
+    profiles = ('reviewer-gpt', 'developer-gpt', 'tester-gpt')
+    for name in profiles:
+        d=home/'profiles'/name; d.mkdir(parents=True); (d/'config.yaml').write_text('toolsets: [file, kanban]\n')
+    status={name:{'status':'active'} for name in profiles}
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect_closing
+    from tools import kanban_tools
+    from tools.registry import registry
+    with connect_closing() as conn:
+        tid=kb.create_task(conn,title='scoped reassignment',assignee='reviewer-gpt',initial_status='blocked')
+    return home,status,tid,kb,connect_closing,registry
+
+
+@pytest.mark.parametrize('has_child', [False, True])
+def test_limited_status_never_reclaims_live_or_manually_owned_running_card(board, monkeypatch, has_child):
+    home,status,tid,kb,connect,registry=board
+    from hermes_cli import kanban_db_dispatch as dispatch
+    status['reviewer-gpt']={'status':'limited','reason':'old quota status'}
+    (home/'bot-status.json').write_text(json.dumps({'updated':time.time()-4*86400,'bots':status}))
+    child=subprocess.Popen([sys.executable,'-c','import time; time.sleep(60)']) if has_child else None
+    signals=[]
+    monkeypatch.setattr(kb,'_terminate_reclaimed_worker',lambda *a,**kw: signals.append(a) or {'terminated':True})
+    try:
+        with connect() as conn:
+            assert kb.unblock_task(conn,tid)
+            claimed=kb.claim_task(conn,tid,claimer='fixture-original-owner')
+            assert claimed
+            if child: dispatch._set_worker_pid(conn,tid,child.pid)
+            before=kb.get_task(conn,tid)
+        result=json.loads(registry.dispatch('kanban_reassign',{'task_id':tid,'profile':'developer-gpt','reason':'independent scoped work'}))
+        assert not result.get('ok'), result
+        assert 'not interrupting' in result.get('error','')
+        assert signals==[]
+        if child: assert child.poll() is None
+        with connect() as conn:
+            after=kb.get_task(conn,tid)
+            assert (after.status,after.assignee,after.claim_lock,after.current_run_id,after.worker_pid)==(
+                before.status,before.assignee,before.claim_lock,before.current_run_id,before.worker_pid)
+    finally:
+        if child and child.poll() is None: child.terminate();child.wait(timeout=10)
+
+
+def test_concurrent_assignee_change_is_not_overwritten(board, monkeypatch):
+    home,status,tid,kb,connect,registry=board
+    (home/'bot-status.json').write_text(json.dumps({'updated':time.time(),'bots':status}))
+    original=kb.reassign_task
+    def concurrent(conn,task_id,target,**kwargs):
+        assert kb.assign_task(conn,task_id,'tester-gpt')
+        return original(conn,task_id,target,**kwargs)
+    monkeypatch.setattr(kb,'reassign_task',concurrent)
+    result=json.loads(registry.dispatch('kanban_reassign',{'task_id':tid,'profile':'developer-gpt','reason':'scoped'}))
+    assert not result.get('ok'), result
+    with connect() as conn:
+        assert kb.get_task(conn,tid).assignee=='tester-gpt'
+
+
+def test_concurrent_completion_cannot_be_reassigned(board, monkeypatch):
+    home,status,tid,kb,connect,registry=board
+    (home/'bot-status.json').write_text(json.dumps({'updated':time.time(),'bots':status}))
+    original=kb.reassign_task
+    def concurrent(conn,task_id,target,**kwargs):
+        assert kb.complete_task(conn,task_id,result='finished by original owner',fire_lifecycle_hook=False)
+        return original(conn,task_id,target,**kwargs)
+    monkeypatch.setattr(kb,'reassign_task',concurrent)
