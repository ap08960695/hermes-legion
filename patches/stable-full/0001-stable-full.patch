@@ -0,0 +1,33 @@
+import { Codicon, Tip } from '@hermes/plugin-sdk'
+
+import { useBots } from './i18n'
+import { stripPreviewMarkdown } from './labels'
+import { workerActiveAt } from './row-helpers'
+import type { RosterRow } from './types'
+
+/** An observed worker stamp, separate from the canonical conversation's preview and click identity. */
+export function BotWorkerActivity({ bot }: { bot: RosterRow }) {
+  const b = useBots()
+
+  if (!workerActiveAt(bot)) {
+    return null
+  }
+
+  const worker = bot.worker_session
+
+  const detail = stripPreviewMarkdown(worker?.last_activity_description || worker?.title || '')
+    .replace(/\s+/g, ' ')
+    .trim()
+    .slice(0, 120)
+
+  const label = detail ? `${b.roster.workerActivity} · ${detail}` : b.roster.workerActivity
+
+  return (
+    <Tip label={label}>
+      <div className="flex min-w-0 items-center gap-1.5 text-xs text-(--ui-text-tertiary)">
+        <Codicon className="shrink-0 text-[0.6875rem]" name="tools" />
+        <span className="min-w-0 truncate">{detail || b.roster.workerActivity}</span>
+      </div>
+    </Tip>
+  )
+}
