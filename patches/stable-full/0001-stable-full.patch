+"""Completed Responses streams must retain messages whose item.done frame is omitted."""
+from types import SimpleNamespace
+
+import pytest
+
+from agent.codex_runtime import _consume_codex_event_stream
+from agent.transports.codex import ResponsesApiTransport
+
+
+def added(item_id, index, phase="final_answer"):
+    return {"type": "response.output_item.added", "output_index": index, "item": {
+        "id": item_id, "type": "message", "role": "assistant", "phase": phase,
+        "status": "in_progress", "content": [],
+    }}
+
+
+def delta(item_id, index, text):
+    return {"type": "response.output_text.delta", "item_id": item_id,
+            "output_index": index, "delta": text}
+
+
+def done(item_id, index, text, phase="final_answer"):
+    return {"type": "response.output_item.done", "output_index": index, "item": SimpleNamespace(
+        id=item_id, type="message", role="assistant", phase=phase,
+        status="completed", content=[SimpleNamespace(type="output_text", text=text)],
+    )}
+
+
+COMPLETE = {"type": "response.completed", "response": {"status": "completed"}}
+
+
+def test_final_delta_after_completed_commentary_is_not_lost():
+    response = _consume_codex_event_stream([
+        added("comment", 0, "commentary"), delta("comment", 0, "Working"),
+        done("comment", 0, "Working", "commentary"),
+        added("answer", 1), delta("answer", 1, "def plan():\n    return []"), COMPLETE,
+    ], model="gpt-6.1-sol")
+    normalized = ResponsesApiTransport().normalize_response(response)
+    assert normalized.content == "def plan():\n    return []"
+    assert normalized.finish_reason == "stop"
+    assert [item["id"] if isinstance(item, dict) else item.id for item in response.output] == ["comment", "answer"]
+
+
+def test_last_final_message_without_done_is_not_dropped_after_another_done():
+    response = _consume_codex_event_stream([
+        added("first", 0), delta("first", 0, "first file"), done("first", 0, "first file"),
+        added("second", 1), delta("second", 1, "second file"), COMPLETE,
+    ], model="gpt-6.1-sol")
+    assert ResponsesApiTransport().normalize_response(response).content == "first file\nsecond file"
+
+
+def test_confirmed_item_remains_authoritative_over_stream_draft():
+    response = _consume_codex_event_stream([
+        added("answer", 0), delta("answer", 0, "draft"),
+        done("answer", 0, "authoritative final"), COMPLETE,
+    ], model="gpt-6.1-sol")
+    assert len(response.output) == 1
+    assert ResponsesApiTransport().normalize_response(response).content == "authoritative final"
+
+
+def test_rotated_done_id_does_not_duplicate_the_message():
+    response = _consume_codex_event_stream([
+        added("announced", 0), delta("announced", 0, "draft"),
+        done("rotated", 0, "final"), COMPLETE,
+    ], model="gpt-6.1-sol")
+    assert len(response.output) == 1
+    assert ResponsesApiTransport().normalize_response(response).content == "final"
+
+
+@pytest.mark.parametrize("analysis_first", [False, True])
+def test_interleaved_message_delta_uses_its_own_phase(analysis_first):
+    visible, reasoning = [], []
+    announcements = [added("answer", 0), added("analysis", 1, "analysis")]
+    if analysis_first:
+        announcements.reverse()
+    _consume_codex_event_stream([
+        *announcements,
+        delta("answer", 0, "visible code"), delta("analysis", 1, "private thought"),
+        done("answer", 0, "visible code"), done("analysis", 1, "private thought", "analysis"),
+        COMPLETE,
