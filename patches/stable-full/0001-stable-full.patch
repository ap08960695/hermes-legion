+"""Kanban must retain loadable frontmatter aliases without eager metadata reads."""
+import json
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture
+def fleet(tmp_path, monkeypatch):
+    root = tmp_path / 'fleet'
+    for name in ['alpha', 'beta']:
+        profile = root / 'profiles' / name
+        (profile / 'skills').mkdir(parents=True)
+        (profile / 'config.yaml').write_text('platform_toolsets:\n  cli: [file]\n')
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setenv('HERMES_HOME', str(root))
+    monkeypatch.setenv('HERMES_ROOT', str(root))
+    return root
+
+
+def _skill(fleet, profile, folder, name):
+    path = fleet / 'profiles' / profile / 'skills' / folder / 'SKILL.md'
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text('---\nname: ' + name + '\ndescription: Synthetic fixture\n---\nFixture.\n')
+    return path
+
+
+@pytest.mark.parametrize('alias', ['published-name', 'category/published-name'])
+def test_preflight_retains_alias_accepted_by_native_loader(fleet, alias):
+    from agent.skill_utils import TIER_LOCAL
+    from tools.skills_tool import locate_skill
+    from tools.kanban_tools import _skills_available_for
+    path = _skill(fleet, 'alpha', 'folder-name', alias)
+    error, _directory, resolved = locate_skill(alias, None, [(TIER_LOCAL, path.parent.parent)])
+    assert error is None and resolved == path
+    wanted = [alias, 'folder-name', 'missing']
+    assert _skills_available_for('alpha', wanted) == (wanted[:2], wanted[2:])
+
+
+def test_preflight_rejects_ambiguous_alias_like_native_loader(fleet):
+    from agent.skill_utils import TIER_LOCAL
+    from tools.skills_tool import locate_skill
+    from tools.kanban_tools import _skills_available_for
+    path = _skill(fleet, 'alpha', 'one', 'same-alias')
+    _skill(fleet, 'alpha', 'two', 'same-alias')
+    error, _directory, resolved = locate_skill('same-alias', None, [(TIER_LOCAL, path.parent.parent)])
+    assert error and resolved is None
+    assert _skills_available_for('alpha', ['same-alias']) == ([], ['same-alias'])
+
+
+def test_multiple_aliases_read_each_candidate_once(fleet, monkeypatch):
+    from tools.kanban_tools import _skills_available_for
+    paths = [_skill(fleet, 'alpha', 'folder-' + str(i), 'alias-' + str(i)) for i in range(4)]
+    reads = []
+    original = Path.read_text
+    def read(path, *args, **kwargs):
+        if path in paths:
+            reads.append(path)
+        return original(path, *args, **kwargs)
+    monkeypatch.setattr(Path, 'read_text', read)
+    wanted = ['alias-0', 'alias-1', 'alias-2', 'alias-3', 'missing']
+    assert _skills_available_for('alpha', wanted) == (wanted[:4], wanted[4:])
+    assert _skills_available_for('alpha', wanted) == (wanted[:4], wanted[4:])
+    assert len(reads) == len(set(reads)) == 4
+
+
+def test_ordinary_directory_names_do_not_read_skill_bodies(fleet, monkeypatch):
+    from tools.kanban_tools import _skills_available_for
+    path = _skill(fleet, 'alpha', 'plain', 'different-name')
+    original = Path.read_text
+    def read(candidate, *args, **kwargs):
+        assert candidate != path, 'ordinary preflight eagerly read the skill body'
+        return original(candidate, *args, **kwargs)
+    monkeypatch.setattr(Path, 'read_text', read)
+    assert _skills_available_for('alpha', ['plain']) == (['plain'], [])
+
+
+def test_aliases_do_not_leak_between_assignee_profiles(fleet):
+    from tools.kanban_tools import _skills_available_for
+    _skill(fleet, 'alpha', 'same-folder', 'alpha-only')
+    _skill(fleet, 'beta', 'same-folder', 'beta-only')
+    for profile, own, foreign in [('alpha', 'alpha-only', 'beta-only'), ('beta', 'beta-only', 'alpha-only')]:
+        assert _skills_available_for(profile, [own, foreign]) == ([own], [foreign])
+
