+        db = SessionDB(home / "state.db")
+        db.create_session("shared", source="cli")
+        db.append_message("shared", role="tool", content=f"targetword {root.name}")
+        dbs.append(db)
+    monkeypatch.setenv("HERMES_HOME", str(roots[0]))
+    token = set_hermes_home_override(roots[1] / "profiles/work")
+    try:
+        result = _search(dbs[1], query="targetword", session_id="@session:work/shared")
+        assert result["success"] is True
+        assert "fleet-b" in result["results"][0]["snippet"]
+        assert "fleet-a" not in json.dumps(result)
+    finally:
+        reset_hermes_home_override(token)
+        for db in dbs:
+            db.close()
