+import { Button, Codicon, ErrorState, Loader, useQuery, useValue } from '@hermes/plugin-sdk'
+import { useId, useLayoutEffect, useMemo, useRef, useState } from 'react'
+import { $boardSlug, fetchTask, routedToScope, taskKey, useKanbanScope } from './api'
+import { BotJourney } from './bot-journey'
+import { columnLabel, useKanban, Avatar } from './ui'
+import { columnMeta, type KanbanBoard } from './types'
+import {
+  workflowGraph,
+  workflowAncestry,
+  workflowIsActive,
+  NODE_WIDTH,
+  NODE_HEIGHT,
+  COLUMN_GAP,
+  ROW_GAP,
+  type WorkflowNode
+} from './workflow-model'
+
+function WorkflowInspector({
+  id,
+  onOpen,
+  upstream,
+  onSelect
+}: {
+  id: string
+  onOpen: (id: string) => void
+  upstream: WorkflowNode[]
+  onSelect: (id: string) => void
+}) {
+  const k = useKanban(),
+    scope = useKanbanScope(),
+    slug = useValue($boardSlug)
+  const { data, error } = useQuery({
+    queryKey: taskKey(scope, slug, id),
+    queryFn: () => fetchTask(id),
+    enabled: query => Boolean(id) && routedToScope(query),
+    staleTime: 60_000,
+    retry: false,
+    refetchOnWindowFocus: false
+  })
+  return (
+    <aside className="kanban-workflow-inspector" aria-label={k.botJourney}>
+      {error ? (
+        <ErrorState title={k.botJourneyError} />
+      ) : data ? (
+        <>
+          <h2>{data.task.title}</h2>
+          <Button size="sm" variant="outline" onClick={() => onOpen(id)}>
+            <Codicon name="link-external" />
+            {k.workflowOpenCard}
+          </Button>
+          <nav aria-label={k.workflowUpstream} className="kanban-upstream">
+            <h3>{k.workflowUpstream}</h3>
+            {upstream.map(node => (
+              <Button key={node.task.id} size="sm" variant="ghost" onClick={() => onSelect(node.task.id)}>
+                <Codicon name="arrow-left" />
+                {node.task.title}
+              </Button>
+            ))}
+          </nav>
+          <BotJourney key={id} runs={data.runs} assignee={data.task.assignee} />
+        </>
+      ) : (
+        <Loader />
+      )}
+    </aside>
+  )
+}
+
+function Node({
+  node,
+  selected,
+  onSelect,
+  dimmed,
+  active
+}: {
+  node: WorkflowNode
+  selected: boolean
+  onSelect: () => void
+  dimmed: boolean
+  active: boolean
+}) {
+  const k = useKanban(),
+    { task, displayStatus, rank, row } = node
+  return (
+    <button
+      type="button"
+      className="kanban-workflow-node"
+      data-dimmed={dimmed}
+      data-running={active}
+      aria-pressed={selected}
+      aria-label={`${task.title} · ${columnLabel(k, displayStatus)} · ${task.assignee || k.botUnassigned}`}
+      style={
+        {
+          left: rank * (NODE_WIDTH + COLUMN_GAP) + 24,
+          top: row * (NODE_HEIGHT + ROW_GAP) + 24,
+          width: NODE_WIDTH,
+          height: NODE_HEIGHT,
+          '--workflow-tone': columnMeta(displayStatus).tone
+        } as React.CSSProperties
+      }
+      onClick={onSelect}
+    >
+      <span className="kanban-workflow-node-title">
+        <Codicon name="tasklist" />
+        <strong>{task.title}</strong>
+      </span>
+      <span className="kanban-workflow-node-status">
+        <i />
+        {columnLabel(k, displayStatus)}
+      </span>
+      <span className="kanban-workflow-node-bot">
+        <Avatar name={task.assignee || '?'} size="1rem" />
+        {task.assignee || k.botUnassigned}
+      </span>
+    </button>
+  )
+}
+
+export function WorkflowView({ board, onOpen }: { board: KanbanBoard; onOpen: (id: string) => void }) {
+  const markerId = useId()
+  const k = useKanban(),
+    graph = useMemo(() => workflowGraph(board), [board])
+  const [selected, setSelected] = useState<string | null>(null),
+    [zoom, setZoom] = useState(1),
+    viewport = useRef<HTMLDivElement>(null)
+  const [focusRequest, setFocusRequest] = useState<{ rank: number; row: number } | null>(null)
+  const selectedId = graph.nodes.some(n => n.task.id === selected) ? selected : null
+  const lineage = selectedId ? workflowAncestry(selectedId, graph.edges) : null
+  const upstream = graph.nodes
+    .filter(n => n.task.id !== selectedId && lineage?.nodes.has(n.task.id))
+    .sort((a, b) => a.rank - b.rank)
+  const positions = new Map(graph.nodes.map(n => [n.task.id, n]))
+  const limited =
+    graph.omittedNodes > 0 || graph.omittedEdges > 0 || board.links_truncated || Boolean(board.links_external)
+  const fit = () => {
+    const container = viewport.current
+    if (!container || !container.clientWidth || !container.clientHeight) return
+    setZoom(Math.min(1, container.clientWidth / (graph.width + 48), container.clientHeight / (graph.height + 48)))
+    container.scrollTo?.({ left: 0, top: 0 })
+  }
+  const focusSelected = () => {
+    const node = selectedId ? positions.get(selectedId) : null
+    if (!node) return
+    setZoom(1)
+    setFocusRequest({ rank: node.rank, row: node.row })
+  }
+  useLayoutEffect(() => {
+    const container = viewport.current
+    if (!container || !focusRequest) return
+    container.scrollTo?.({
+      left: Math.max(0, focusRequest.rank * (NODE_WIDTH + COLUMN_GAP) + 24 - (container.clientWidth - NODE_WIDTH) / 2),
+      top: Math.max(0, focusRequest.row * (NODE_HEIGHT + ROW_GAP) + 24 - (container.clientHeight - NODE_HEIGHT) / 2)
+    })
+  }, [focusRequest])
+  return (
+    <section className="kanban-workflow" aria-label={k.workflow}>
+      <header className="kanban-workflow-toolbar">
+        <p>
+          <Codicon name="git-merge" />
+          {k.workflowHint}
+        </p>
+        <div role="group" aria-label={k.workflow}>
+          <Button
+            aria-label={k.workflowZoomOut}
+            size="icon-sm"
+            variant="ghost"
+            disabled={zoom <= 0.05}
+            onClick={() => setZoom(n => Math.max(0.05, n * 0.8))}
+          >
+            <Codicon name="remove" />
+          </Button>
+          <span>{Math.round(zoom * 100)}%</span>
+          <Button
+            aria-label={k.workflowZoomIn}
+            size="icon-sm"
+            variant="ghost"
+            disabled={zoom >= 2}
+            onClick={() => setZoom(n => Math.min(2, n / 0.8))}
+          >
+            <Codicon name="add" />
+          </Button>
+          {selectedId && (
+            <Button size="sm" variant="ghost" onClick={focusSelected}>
+              {k.workflowFocus}
+            </Button>
+          )}
+          {selectedId && (
+            <Button size="sm" variant="ghost" onClick={() => setSelected(null)}>
+              {k.workflowAllPaths}
+            </Button>
+          )}
+          <Button size="sm" variant="ghost" onClick={fit}>
+            {k.workflowFit}
+          </Button>
+        </div>
+      </header>
+      {!graph.linksKnown && (
+        <p role="status" className="kanban-workflow-notice">
+          {k.workflowUnknownLinks}
+        </p>
+      )}
+      {limited && (
+        <p role="status" className="kanban-workflow-notice">
+          {k.workflowLimited}
+        </p>
+      )}
+      {graph.cyclic && (
+        <p role="status" className="kanban-workflow-notice">
+          {k.workflowCycle}
+        </p>
+      )}
+      <ol className="sr-only" aria-label={k.workflow}>
+        {graph.edges.map(edge => (
+          <li key={`${edge.parent_id}:${edge.child_id}`}>
+            {positions.get(edge.parent_id)?.task.title} → {positions.get(edge.child_id)?.task.title}
+          </li>
+        ))}
+      </ol>
+      <div className="kanban-workflow-body">
+        <div ref={viewport} className="kanban-workflow-viewport" tabIndex={0} aria-label={k.workflow}>
+          {graph.nodes.length ? (
+            <div style={{ width: (graph.width + 48) * zoom, height: (graph.height + 48) * zoom }}>
+              <div
+                className="kanban-workflow-canvas"
+                style={{ width: graph.width + 48, height: graph.height + 48, transform: `scale(${zoom})` }}
+              >
+                <svg width={graph.width + 48} height={graph.height + 48} aria-hidden="true">
+                  <defs>
+                    <marker id={markerId} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
+                      <path d="M0,0 L8,4 L0,8 Z" fill="currentColor" />
+                    </marker>
+                  </defs>
+                  {graph.edges.map(edge => {
+                    const a = positions.get(edge.parent_id)!,
+                      b = positions.get(edge.child_id)!
+                    const x = a.rank * (NODE_WIDTH + COLUMN_GAP) + NODE_WIDTH + 24,
+                      y = a.row * (NODE_HEIGHT + ROW_GAP) + NODE_HEIGHT / 2 + 24
+                    const endX = b.rank * (NODE_WIDTH + COLUMN_GAP) + 24,
+                      endY = b.row * (NODE_HEIGHT + ROW_GAP) + NODE_HEIGHT / 2 + 24
+                    return (
+                      <path
+                        data-testid="workflow-edge"
+                        data-lineage={Boolean(lineage?.edges.has(`${edge.parent_id}:${edge.child_id}`))}
+                        data-dimmed={Boolean(lineage && !lineage.edges.has(`${edge.parent_id}:${edge.child_id}`))}
+                        data-flow={workflowIsActive(b.task)}
+                        key={`${edge.parent_id}:${edge.child_id}`}
+                        d={`M${x},${y} C${x + 40},${y} ${endX - 40},${endY} ${endX},${endY}`}
+                        markerEnd={`url(#${markerId})`}
+                      />
+                    )
+                  })}
+                </svg>
+                {graph.nodes.map(node => (
+                  <Node
+                    key={node.task.id}
+                    node={node}
+                    selected={selectedId === node.task.id}
+                    dimmed={Boolean(lineage && !lineage.nodes.has(node.task.id))}
+                    active={workflowIsActive(node.task)}
+                    onSelect={() => setSelected(node.task.id)}
+                  />
+                ))}
+              </div>
+            </div>
+          ) : (
+            <p className="kanban-workflow-empty">{k.workflowEmpty}</p>
+          )}
+        </div>
+        {selectedId ? (
+          <WorkflowInspector
+            key={selectedId}
+            id={selectedId}
+            onOpen={onOpen}
+            upstream={upstream}
+            onSelect={setSelected}
+          />
+        ) : (
+          <aside className="kanban-workflow-inspector kanban-workflow-empty">
+            <Codicon name="history" />
+            {k.workflowChooseTask}
+          </aside>
+        )}
+      </div>
+    </section>
+  )
+}
