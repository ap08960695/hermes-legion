diff --git a/tests/tui_gateway/test_kanban_review_notifications.py b/tests/tui_gateway/test_kanban_review_notifications.py
new file mode 100644
index 0000000000000000000000000000000000000000..7fefaa92f0630cebd46460a586a26413609021bf
--- /dev/null
+++ b/tests/tui_gateway/test_kanban_review_notifications.py
@@ -0,0 +1,107 @@
+"""Real review/triage transitions must reach the originating TUI, once per event."""
+import threading
+
+import pytest
+
+from gateway.warning_notifications import DiagnosticText
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_notify as kbn
+from tui_gateway import server
+
+KEY = 'review-notification-owner'
+
+
+def _review(conn):
+    tid = kb.create_task(conn, title='guarded export', assignee='builder')
+    kbn.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY,
+                       delivery_mode='notify+wake')
+    implementation = kb.claim_task(conn, tid, claimer='builder:fixture')
+    assert implementation
+    assert kb.request_review(conn, tid, reviewer='reviewer', summary='Export regression is ready.',
+                             expected_run_id=implementation.current_run_id)
+    return tid
+
+
+def _collect():
+    return server._collect_kanban_notifications({'session_key': KEY})
+
+
+def test_review_request_reaches_origin_with_handoff_and_is_not_replayed():
+    with kbc.connect_closing() as conn:
+        tid = _review(conn)
+    texts = _collect()
+    assert len(texts) == 1
+    assert tid in texts[0] and 'review requested' in texts[0]
+    assert 'Export regression is ready.' in texts[0] and 'reviewer' in texts[0]
+    assert not isinstance(texts[0], DiagnosticText), 'review is a real decision handoff'
+    assert _collect() == []
+
+
+def test_requested_changes_reach_origin_with_provenance_and_reason():
+    with kbc.connect_closing() as conn:
+        tid = _review(conn)
+        review = kb.claim_review_task(conn, tid, claimer='reviewer:fixture')
+        assert review
+        assert kb.request_changes(conn, tid, reason='Cover the empty export branch.',
+                                  expected_run_id=review.current_run_id) == (True, 'builder')
+    texts = _collect()
+    assert len(texts) == 2, 'review and subsequent changes are distinct handoffs'
+    assert 'changes requested' in texts[1] and 'Cover the empty export branch.' in texts[1]
+    assert 'reviewer' in texts[1] and 'builder' in texts[1]
+    assert not isinstance(texts[1], DiagnosticText)
+    assert _collect() == []
+
+
+@pytest.mark.parametrize('kind', ['transient', 'needs_input'])
+def test_block_loop_escalation_is_delivered_without_inventing_owner_input(kind):
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title='bounded retries')
+        kbn.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY,
+                           delivery_mode='notify+wake')
+        for attempt in range(kb.BLOCK_RECURRENCE_LIMIT):
+            assert kb.block_task(conn, tid, kind=kind, reason='fixture repeated cause')
+            if attempt < kb.BLOCK_RECURRENCE_LIMIT - 1:
+                assert kb.unblock_task(conn, tid)
+        assert kb.get_task(conn, tid).status == 'triage'
+    texts = _collect()
+    assert len(texts) == kb.BLOCK_RECURRENCE_LIMIT
+    escalation = texts[-1]
+    assert tid in escalation and 'triage' in escalation and 'fixture repeated cause' in escalation
+    assert isinstance(escalation, DiagnosticText) is (kind != 'needs_input')
+    assert ('owner input' in escalation) is (kind == 'needs_input')
+    assert _collect() == []
+
+
+def test_refused_review_handoff_is_retried_once_on_the_same_idle_session(monkeypatch):
+    with kbc.connect_closing() as conn:
+        tid = _review(conn)
+    session = {'session_key': KEY, 'history_lock': threading.RLock(), 'running': False,
+               'history': [], '_turn_cancel_requested': True}
+    accepted = []
+    monkeypatch.setattr(server, '_emit', lambda *a, **kw: None)
+    monkeypatch.setattr(server, '_run_prompt_submit', lambda *a, **kw: False)
+    server._notif_poll_kanban('review-sid', session)
+    assert session['running'] is False, 'Stop must retain the handoff without starting work'
+    assert tid in '\n'.join(session.get('_kanban_pending') or [])
+    session['_turn_cancel_requested'] = False
+    server._notif_poll_kanban('review-sid', session)
+    assert session['running'] is False
+    assert tid in '\n'.join(session.get('_kanban_pending') or [])
+
+    def submit(rid, sid, record, text, **kwargs):
+        accepted.append(text)
+        return True
+
+    monkeypatch.setattr(server, '_run_prompt_submit', submit)
+    server._notif_poll_kanban('review-sid', session)
+    assert len(accepted) == 1 and 'review requested' in accepted[0]
+    session['running'] = False
+    server._notif_poll_kanban('review-sid', session)
+    assert len(accepted) == 1
+
+
+def test_other_destination_cannot_consume_a_review_handoff():
+    with kbc.connect_closing() as conn:
+        tid = _review(conn)
+    assert server._collect_kanban_notifications({'session_key': 'different-owner'}) == []
+    texts = _collect()
+    assert len(texts) == 1 and tid in texts[0]
diff --git a/tests/tui_gateway/test_kanban_status_wake.py b/tests/tui_gateway/test_kanban_status_wake.py
new file mode 100644
index 0000000000000000000000000000000000000000..1a3845fe238b0083647e47df8f45174070d07eff
--- /dev/null
+++ b/tests/tui_gateway/test_kanban_status_wake.py
@@ -0,0 +1,190 @@
+"""Intermediate card status is visible without another assistant turn."""
+import threading
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_notify as kbn
+from tui_gateway import server
+
+KEY = 'status-wake-fixture'
+
+
+def _fixture():
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title='fixture card', assignee='worker')
+        kbn.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY)
+        cursor = kbn.list_notify_subs(conn, task_id=tid)[0]['last_event_id']
+    return tid, cursor
+
+
+def _event(tid, kind, payload):
+    with kbc.connect_closing() as conn, kb.write_txn(conn):
+        kb._append_event(conn, tid, kind, payload)
+        return conn.execute('SELECT MAX(id) FROM task_events WHERE task_id=?', (tid,)).fetchone()[0]
+
+
+def _session():
+    return {'session_key': KEY, 'history_lock': threading.RLock(), 'running': False, 'history': []}
+
+
+def _spies(monkeypatch):
+    rendered, admitted = [], []
+    monkeypatch.setattr(server, '_emit', lambda *args, **kwargs: rendered.append(args))
+    def submit(rid, sid, session, text, **kwargs):
+        admitted.append(text)
+        if callback := kwargs.get('terminal_callback'):
+            callback({'status': 'settled'})
+        return True
+    monkeypatch.setattr(server, '_run_prompt_submit', submit)
+    return rendered, admitted
+
+
+@pytest.mark.parametrize('status', ['todo', 'ready', 'running', 'scheduled'])
+def test_intermediate_status_is_visible_without_model_turn_and_cursor_advances(monkeypatch, status):
+    tid, before = _fixture()
+    event_id = _event(tid, 'status', {'status': status})
+    rendered, admitted = _spies(monkeypatch)
+    session = _session()
+    server._notif_poll_kanban('sid', session)
+    assert admitted == []
+    assert session['running'] is False
+    assert any(args[0]=='status.update' and status in args[2]['text'] for args in rendered)
+    with kbc.connect_closing() as conn:
+        assert kbn.list_notify_subs(conn, task_id=tid)[0]['last_event_id'] >= event_id > before
+        has_table = conn.execute("SELECT 1 FROM sqlite_master WHERE name='kanban_tui_deliveries'").fetchone()
+        if has_table:
+            assert conn.execute('SELECT COUNT(*) FROM kanban_tui_deliveries WHERE event_id=?', (event_id,)).fetchone()[0] == 0
+    server._notif_poll_kanban('sid', session)
+    assert admitted == [] and len([x for x in rendered if x[0]=='status.update']) == 1
+
+
+def test_status_churn_and_completion_wake_only_for_the_completion(monkeypatch):
+    tid, _ = _fixture()
+    rendered, admitted = _spies(monkeypatch)
+    session = _session()
+    for status in ('todo', 'ready', 'running'):
+        _event(tid, 'status', {'status': status})
+        server._notif_poll_kanban('sid', session)
+    assert admitted == []
+    with kbc.connect_closing() as conn:
+        assert kb.complete_task(conn, tid, summary='actual completion')
+    server._notif_poll_kanban('sid', session)
+    assert len(admitted) == 1 and 'actual completion' in admitted[0]
+    assert all(status not in admitted[0] for status in ('→ todo', '→ ready', '→ running'))
+    assert len([x for x in rendered if x[0]=='status.update']) == 4
+    session['running'] = False
+    server._notif_poll_kanban('sid', session)
+    assert len(admitted) == 1
+
+
+def test_dashboard_intermediate_move_is_visible_without_wake(monkeypatch):
+    from plugins.kanban.dashboard.plugin_api import _set_status_direct
+    tid, _ = _fixture()
+    with kbc.connect_closing() as conn:
+        assert _set_status_direct(conn, tid, 'todo')
+    rendered, admitted = _spies(monkeypatch)
+    server._notif_poll_kanban('sid', _session())
+    assert admitted == []
+    assert any(args[0] == 'status.update' and 'todo' in args[2]['text'] for args in rendered)
+
+
+@pytest.mark.parametrize('status', ['review', 'done', 'blocked', 'triage', 'unknown'])
+def test_other_statuses_are_not_silenced_without_outcome_proof(monkeypatch, status):
+    tid, _ = _fixture()
+    _event(tid, 'status', {'status': status})
+    _, admitted = _spies(monkeypatch)
+    server._notif_poll_kanban('sid', _session())
+    assert len(admitted) == 1 and status in admitted[0]
+
+
+def test_reopened_parent_invalidation_still_wakes_origin(monkeypatch):
+    with kbc.connect_closing() as conn:
+        parent = kb.create_task(conn, title='parent')
+        assert kb.complete_task(conn, parent, summary='parent done')
+        child = kb.create_task(conn, title='dependent', parents=(parent,))
+        assert kb.complete_task(conn, child, summary='dependent done')
