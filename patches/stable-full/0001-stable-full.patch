+@pytest.mark.parametrize('lane,outcome,kind,reason', [
+    ('review','review_requested',None,'review_handoff'),
+    ('ready','crashed',None,'recovery'),
+    ('ready','rate_limited',None,'quota_retry'),
+    ('ready','completed','reopened','reopened'),
+    ('ready','completed','changes_requested','revision'),
+    ('ready','completed',None,'unknown'),
