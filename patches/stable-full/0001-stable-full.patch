+"""Native startup admission and deferred first-prompt facts; no inference requests."""
+import contextlib
+import json
+import os
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import AsyncMock, patch
+
+
+class ProbeFixture(unittest.IsolatedAsyncioTestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.root = Path(temp.name)
+        self.home = self.root / "home"
+        self.home.mkdir()
+        self.context = self.root / "context"
+        self.context.mkdir()
+        (self.context / "AGENTS.md").write_text("WORKSPACE_CONTEXT_SENTINEL สวัสดี.\n")
+        (self.home / "SOUL.md").write_text("PROFILE_SOUL_SENTINEL.\n")
+        (self.home / ".env").write_text("OPENAI_API_KEY=synthetic-fixture\n")
+        env = patch.dict(os.environ, {"HOME": str(self.root), "HERMES_HOME": str(self.home),
+                         "TMPDIR": str(self.root), "PATH": os.defpath,
+                         "HERMES_DISABLE_LAZY_INSTALLS": "1"}, clear=True)
+        env.start()
+        self.addCleanup(env.stop)
+        from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+        token = set_hermes_home_override(self.home)
+        self.addCleanup(reset_hermes_home_override, token)
+        self.config = {"model": {"default": "synthetic-offline", "provider": "custom",
+                                "base_url": "https://example.invalid/v1", "context_length": 131072},
+                       "agent": {"environment_probe": True, "gateway_startup_warmup_timeout": 0, "max_turns": 3},
+                       "terminal": {"backend": "local", "cwd": str(self.context)},
+                       "gateway": {"multiplex_profiles": False}, "platform_toolsets": {"cli": ["todo"]},
+                       "auxiliary": {"title_generation": {"enabled": False}}, "mcp_servers": {},
+                       "credential_pool": {}, "fallback_model": [], "fallback_providers": []}
+        self.write_config()
+        import gateway.run as run
+        import gateway.run_bootstrap as boot
+        from tools import env_probe
+        self.run, self.boot, self.probe = run, boot, env_probe
+        self.probe._reset_cache_for_tests()
+        self.addCleanup(self.finish_probe)
+        self.addCleanup(self.reset_logging)
+
+    def write_config(self):
+        (self.home / "config.yaml").write_text(json.dumps(self.config) + "\n")
+
+    def finish_probe(self):
+        worker = self.probe._PROBE_THREAD
+        if worker is not None:
+            worker.join(2)
+            self.assertFalse(worker.is_alive())
+        self.probe._reset_cache_for_tests()
+
+    @staticmethod
+    def reset_logging():
+        import hermes_logging
+        hermes_logging._reset_queued_handlers()
+        hermes_logging._logging_initialized = False
+        hermes_logging.clear_session_context()
