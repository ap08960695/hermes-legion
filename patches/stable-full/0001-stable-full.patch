+  return (
+    <Button variant="ghost" size="sm" onClick={onMore}>
+      {k.moreHistory(visible, total)}
+    </Button>
+  )
+}
+
+export function EmptyBoardView({
+  view,
+  filtered,
+  onCurrent,
+  onAdd,
+  k
