+@pytest.mark.parametrize('admission_error', [False, True])
+def test_owner_admission_allows_unrelated_progress_and_settles_followers(monkeypatch, admission_error):
+    store = cache.VisionCache()
+    owner_value = '\ud800' if admission_error else json.dumps({'success': True, 'analysis': 'gated owner'})
+    other_value = json.dumps({'success': True, 'analysis': 'independent result'})
+    entered, release, joined = threading.Event(), threading.Event(), threading.Event()
+    calls, admissions = [], []
+
+    async def ready():
+        return RESULT
+
+    assert asyncio.run(store.run('ready', ready)) == RESULT
+    policy, wrap = store.cacheable, asyncio.wrap_future
+
+    def checked(result):
+        admissions.append(result)
+        if result == owner_value and not entered.is_set():
+            entered.set()
+            assert release.wait(10)
+        return policy(result)
+
+    def wrapped(future):
+        if future is target_future:
+            joined.set()
+        return wrap(future)
+
+    def probe_lock():
+        acquired = store.lock.acquire(blocking=False)
+        if acquired:
+            store.lock.release()
+        return acquired
+
+    async def owner_call():
+        calls.append('owner')
+        return owner_value
+
+    async def other_call():
+        calls.append('other')
+        return other_value
+
+    async def forbidden_call():
+        raise AssertionError('cached hit or follower must not call the provider')
+
+    monkeypatch.setattr(store, 'cacheable', checked)
+    with ThreadPoolExecutor(4) as pool:
+        owner = pool.submit(asyncio.run, store.run('owner', owner_call))
+        try:
+            assert entered.wait(3)
+            assert pool.submit(probe_lock).result(3), 'admission must leave the shared cache lock free'
+            with store.lock:
+                target_future = store.pending['owner']
+            monkeypatch.setattr(asyncio, 'wrap_future', wrapped)
+            hit = pool.submit(asyncio.run, store.run('ready', forbidden_call))
+            other = pool.submit(asyncio.run, store.run('other', other_call))
+            follower = pool.submit(asyncio.run, store.run('owner', forbidden_call))
+            assert hit.result(3) == RESULT
+            assert other.result(3) == other_value
+            assert joined.wait(3)
+            assert not owner.done() and not follower.done()
+            assert not release.is_set()
+        finally:
+            release.set()
+        if admission_error:
+            for task in (owner, follower):
+                with pytest.raises(UnicodeEncodeError):
+                    task.result(3)
+            assert 'owner' not in store.done
+        else:
+            assert owner.result(3) == follower.result(3) == owner_value
+            assert store.done['owner'][1] == owner_value
+    assert calls == ['owner', 'other']
+    assert admissions.count(owner_value) == admissions.count(other_value) == 1
+    assert store.done['ready'][1] == RESULT and store.done['other'][1] == other_value
+    assert not store.pending
+
