+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { MemoryRouter } from 'react-router'
+import { afterEach, expect, it } from 'vitest'
+import { useHistorySearch } from './use-history-search'
+function Search() {
+  const x = useHistorySearch()
+  return (
+    <input
+      aria-label="Search"
+      ref={x.searchInputRef}
+      value={x.searchQuery}
+      onChange={e => x.setSearchQuery(e.target.value)}
+    />
+  )
+}
+afterEach(cleanup)
+it('seeds a routed query once and leaves subsequent edits to the user', () => {
