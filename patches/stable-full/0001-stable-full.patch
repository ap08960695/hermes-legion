@@ -0,0 +1,285 @@
+import { Button, Codicon, ErrorState, host, Loader, useValue } from '@hermes/plugin-sdk'
+import { useMemo, useState } from 'react'
+import { BotFace, botAppearance, avatarColor } from './avatar'
+import {
+  $botMeta,
+  $botAttention,
+  botActivitySession,
+  botRosterKey,
+  botSelectionKey,
+  botSourceStatus,
+  useRoster
+} from './data'
+import { $focusedBotOwner, focusedRosterOwner } from './bot-state'
+import { displayName, stripPreviewMarkdown } from './labels'
+import { EditProfileDialog } from './edit-profile-dialog'
+import { useBots } from './i18n'
+import { botWorkingMood, useTurnBusy } from './row-helpers'
+import { openRosterBot } from './roster-actions'
+import { botRosterMeta } from './routing'
+import { $botSections } from './user-sections'
+import type { RosterRow } from './types'
+import { BotsPane } from './roster-pane'
+import { $botManagementOpen } from './management'
+import { BotWorkspaceActions } from './workspace-actions'
+import { openBotScreen } from './screen-open'
+
+/** A full native roster view. Opens the same canonical chat as the existing row. */
+export function BotsWorkspace() {
+  const text = useBots(),
+    management = useValue($botManagementOpen)
+  const b = text.workspace,
+    roster = useRoster(),
+    meta = useValue($botMeta),
+    attention = useValue($botAttention),
+    sections = useValue($botSections)
+  const focused = focusedRosterOwner(useValue($focusedBotOwner)),
+    busy = useTurnBusy(),
+    connection = useValue(host.state.connectionId)
+  const [editing, setEditing] = useState<RosterRow | null>(null)
+  const [search, setSearch] = useState(''),
+    [section, setSection] = useState(''),
+    [filter, setFilter] = useState('all'),
+    [limit, setLimit] = useState(60)
+  const rows = useMemo(
+    () =>
+      (roster.data?.profiles || [])
+        .filter(bot => !(botRosterMeta(bot, meta) || bot.ui_meta?.['hermes-bots'])?.hidden)
+        .map(bot => {
+          const info = botRosterMeta(bot, meta) || bot.ui_meta?.['hermes-bots'] || null,
+            source = botSourceStatus(bot),
+            working = botWorkingMood(bot, focused, busy, connection || 'local') !== 'idle'
+          const needsAttention = Boolean(attention[botSelectionKey(bot)] || attention[botRosterKey(bot)])
+          return {
+            bot,
+            info,
+            source,
+            working,
+            needsAttention,
+            name: displayName(bot, info),
+            section: info?.sectionId || null
+          }
+        }),
+    [roster.data, meta, attention, focused, busy, connection]
+  )
+  const groups = new Map(sections.map(s => [s.id, s.name]))
+  for (const row of rows) {
+    if (row.section && row.info?.sectionName && !groups.has(row.section)) groups.set(row.section, row.info.sectionName)
+  }
+  const shown = rows.filter(
+    row =>
+      (!section || row.section === section) &&
+      (filter === 'all' ||
+        (filter === 'working' && row.working) ||
+        (filter === 'attention' && row.needsAttention) ||
+        (filter === 'unavailable' && !row.source.available)) &&
+      (!search ||
+        [row.name, row.bot.name, row.info?.description, row.bot.description]
+          .join(' ')
+          .toLowerCase()
+          .includes(search.trim().toLowerCase()))
+  )
+  const open = async (bot: RosterRow) => {
+    await openRosterBot(bot)
+  }
+  return (
+    <section className="flex h-full min-h-0 flex-col bg-background text-(--ui-text-primary)" aria-label={b.title}>
+      <header className="flex flex-wrap items-center justify-between gap-4 border-b border-(--ui-stroke-tertiary) px-6 py-5">
+        <div>
+          <h1 className="text-xl font-semibold">
+            {b.title}
+            <span className="ml-3 text-sm font-normal text-muted-foreground">{rows.length}</span>
+          </h1>
+          <p className="mt-1 text-xs text-muted-foreground">{b.hint}</p>
+        </div>
+        <BotWorkspaceActions />
+        <Button variant="ghost" size="sm" onClick={() => void roster.refetch()}>
+          <Codicon name="refresh" />
+          {b.refresh}
+        </Button>
+      </header>
+      {management ? (
+        <div className="min-h-0 flex-1 overflow-hidden px-6 pb-6">
+          <BotsPane acceptDialogIntent />
+        </div>
+      ) : (
+        <>
+          <div className="flex flex-wrap items-center gap-3 px-6 py-4">
+            <input
+              aria-label={b.search}
+              placeholder={b.search}
+              value={search}
+              onChange={e => {
+                setSearch(e.target.value)
+                setLimit(60)
+              }}
+              className="h-9 min-w-40 flex-1 rounded-md border border-(--ui-stroke-tertiary) bg-(--ui-bg-quinary) px-3 text-sm text-(--ui-text-primary) placeholder:text-muted-foreground outline-none focus:border-(--ui-accent)"
+            />
+            <select
+              aria-label={b.group}
+              value={section}
+              onChange={e => {
+                setSection(e.target.value)
+                setLimit(60)
+              }}
+              className="h-9 rounded-md border border-(--ui-stroke-tertiary) bg-background px-3 text-xs text-(--ui-text-primary)"
+            >
+              <option value="">{b.allGroups}</option>
+              {[...groups].map(([id, name]) => (
+                <option key={id} value={id}>
+                  {name}
+                </option>
+              ))}
+            </select>
+            <div className="flex gap-1" role="group" aria-label={b.filter}>
+              {(['all', 'working', 'attention', 'unavailable'] as const).map(value => (
+                <Button
+                  key={value}
+                  size="sm"
+                  variant={filter === value ? 'secondary' : 'ghost'}
+                  aria-pressed={filter === value}
+                  onClick={() => {
+                    setFilter(value)
+                    setLimit(60)
+                  }}
+                >
+                  {b[value]}{' '}
+                  <span className="text-muted-foreground">
+                    {value === 'all'
+                      ? rows.length
+                      : rows.filter(row =>
+                          value === 'working'
+                            ? row.working
+                            : value === 'attention'
+                              ? row.needsAttention
+                              : !row.source.available
+                        ).length}
+                  </span>
+                </Button>
+              ))}
+            </div>
+          </div>
+          <div className="min-h-0 flex-1 overflow-auto px-6 pb-6">
+            {roster.isLoading ? (
+              <Loader />
+            ) : roster.error ? (
+              <ErrorState title={b.unavailable} />
+            ) : shown.length === 0 ? (
+              <p role="status" className="py-16 text-center text-sm text-muted-foreground">
+                {b.empty}
+              </p>
+            ) : (
+              <div className="grid grid-cols-[repeat(auto-fill,minmax(min(100%,260px),1fr))] gap-4">
+                {shown.slice(0, limit).map(row => {
+                  const appearance = botAppearance(row.bot.name, row.info),
+                    preview = stripPreviewMarkdown(
+                      (row.bot.canonical_session || botActivitySession(row.bot))?.preview || ''
+                    )
+                  return (
+                    <article
+                      key={botRosterKey(row.bot)}
+                      className="flex min-w-0 flex-col rounded-xl border border-(--ui-stroke-tertiary) bg-(--ui-bg-elevated) p-5 transition-colors hover:border-(--ui-stroke-primary)"
+                      data-bot-key={botRosterKey(row.bot)}
+                    >
+                      <div className="flex items-start gap-3">
+                        <BotFace
+                          {...appearance}
+                          color={appearance.color || avatarColor(appearance.color, row.bot.name)}
+                          size={44}
+                          name={row.bot.name}
+                          mood={row.working ? 'work' : 'idle'}
+                        />
+                        <div className="min-w-0 flex-1">
+                          <h2 className="truncate text-sm font-semibold">{row.name}</h2>
+                          <p className="truncate text-[11px] text-muted-foreground">@{row.bot.name}</p>
+                        </div>
+                        <span className="text-(--ui-accent)" aria-label={row.working ? b.working : row.source.label}>
+                          <Codicon
+                            name={
+                              row.working
+                                ? 'sync~spin'
+                                : row.needsAttention
+                                  ? 'warning'
+                                  : row.source.available
+                                    ? 'circle-outline'
+                                    : 'debug-disconnect'
+                            }
+                          />
+                        </span>
+                      </div>
+                      <p className="mt-4 line-clamp-2 min-h-10 text-xs leading-5 text-muted-foreground">
+                        {row.info?.description || row.bot.description || b.noDescription}
+                      </p>
+                      <div
+                        className="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-muted-foreground"
+                        title={b.configuredRoute}
+                        aria-label={b.configuredRoute}
+                      >
+                        <span className="min-w-0 break-all">
+                          <Codicon name="hubot" /> {row.bot.model || b.modelUnknown}
+                        </span>
+                        <span className="min-w-0 break-all">{row.bot.provider || b.providerUnknown}</span>
+                      </div>
+                      <p className="mt-3 truncate text-[11px] text-muted-foreground">
+                        {groups.get(row.section || '') || b.noGroup} · {row.bot.connectionLabel || row.source.label}
+                      </p>
+                      <div className="mt-4 min-h-14 rounded-lg bg-(--ui-bg-quinary) p-3">
+                        <p className="line-clamp-2 text-xs leading-5 text-(--ui-text-secondary)">
+                          {preview || b.noPreview}
+                        </p>
+                      </div>
+                      <div className="mt-4 flex items-center justify-between gap-2">
+                        <span className="text-[11px] text-muted-foreground">
+                          {!row.source.available
+                            ? row.source.label
+                            : row.working
+                              ? b.working
+                              : row.needsAttention
+                                ? b.attention
+                                : b.notActive}
+                        </span>
+                        <Button
+                          size="icon-sm"
+                          variant="ghost"
+                          aria-label={text.screen.menu}
+                          disabled={!row.source.available}
+                          onClick={() => openBotScreen(row.bot, row.info)}
+                        >
+                          <Codicon name="device-desktop" />
+                        </Button>
+                        <Button
+                          size="icon-sm"
+                          variant="ghost"
+                          aria-label={b.profile}
+                          disabled={!row.source.available}
+                          onClick={() => setEditing(row.bot)}
+                        >
+                          <Codicon name="settings-gear" />
+                        </Button>
+                        <Button
+                          size="sm"
+                          variant="outline"
+                          disabled={!row.source.available}
+                          onClick={() => void open(row.bot)}
+                        >
+                          <Codicon name="comment-discussion" />
+                          {b.open}
+                        </Button>
+                      </div>
+                    </article>
+                  )
+                })}
+              </div>
+            )}
+            {shown.length > limit && (
+              <Button className="mt-4" variant="ghost" onClick={() => setLimit(n => n + 60)}>
+                {b.more}
+              </Button>
+            )}
+          </div>
+        </>
+      )}
+      <EditProfileDialog bot={editing} open={Boolean(editing)} onClose={() => setEditing(null)} />
+    </section>
+  )
+}
