+    with kbc.connect_closing(board='other') as conn:
+        kb.create_task(conn, title='second', assignee='bob')
+    first_read = threading.Event()
+    release_first = threading.Event()
+    original = kbd.count_running_tasks_other_boards
+
+    def synchronized_count(board=None):
+        value = original(board)
+        if board == 'default':
+            first_read.set()
+            assert release_first.wait(timeout=10)
+        return value
+
+    monkeypatch.setattr(kbd, 'count_running_tasks_other_boards', synchronized_count)
+    spawns = []
+    def tick(slug):
+        with kbc.connect_closing(board=slug) as conn:
+            return kbd.dispatch_once(conn, board=slug, max_in_progress=1,
+                                     spawn_fn=lambda task, workspace, board=None: spawns.append(task.id))
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        first = pool.submit(tick, 'default')
+        assert first_read.wait(timeout=10)
+        second = pool.submit(tick, 'other')
+        try:
+            second.result(timeout=10)
+        finally:
+            release_first.set()
+        first.result(timeout=10)
+    assert len(spawns) == 1
