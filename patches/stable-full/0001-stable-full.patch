@@ -0,0 +1,138 @@
+"""Classic resume selects identity and lineage without loading prompt/tool blobs."""
+import json
+import sqlite3
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import main as cli_main
+from hermes_state import SessionDB
+
+ROOT = "local-" + "a" * 64
+TIP = "local-" + "b" * 64
+TITLE = "Synthetic retained plan"
+AMBIGUOUS = "local-" + "c" * 16
+
+
+def _storage_snapshot(home):
+    files = {path.relative_to(home).as_posix(): path.read_bytes()
+             for path in home.rglob("*") if path.is_file()}
+    directories = {path.relative_to(home).as_posix() for path in home.rglob("*") if path.is_dir()}
+    return files, directories
+
+
+def _assert_data_preserved(home, before):
+    before, directories = before
+    assert "state.db-wal" not in before and "state.db-shm" not in before
+    after, after_directories = _storage_snapshot(home)
+    assert after_directories == directories
+    assert set(after) - set(before) <= {"state.db-wal", "state.db-shm"}
+    for name, data in before.items():
+        assert after.get(name) == data
+    # Native readonly SQLite may create derived WAL-index metadata, never data frames.
+    assert after.get("state.db-wal", b"") == b""
+    assert "state.db-journal" not in after
+
+
+@pytest.fixture
+def archive(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    from hermes_cli.config import ensure_hermes_home
+    ensure_hermes_home()
+    subprocess.run([sys.executable, "-c", "import hermes_cli.main"],
+                   capture_output=True, text=True, check=True)
+    assert all((home / "logs" / name).is_file() for name in ("agent.log", "errors.log"))
+    assert (home / "SOUL.md").is_file()
+    assert all((home / name).is_dir() for name in ("sessions", "logs", "skills", "memories"))
+    with SessionDB(home / "state.db") as db:
+        db.create_session(ROOT, source="cli", system_prompt="Synthetic retained context. " * 16384)
+        db.set_session_title(ROOT, TITLE)
+        db.end_session(ROOT, "compression")
+        db.create_session(TIP, source="cli", parent_session_id=ROOT)
+        db.set_session_title(TIP, TITLE + " #2")
+        for sid, marker in (("fork", "_branched_from"), ("delegate", "_delegate_from")):
+            db.create_session(sid, source="cli", parent_session_id=ROOT, model_config={marker: ROOT})
+        db.create_session("title-collision", source="cli")
+        db.set_session_title("title-collision", ROOT)
+        for ending in ("0", "1"):
+            db.create_session(AMBIGUOUS + ending * 48, source="tui")
+    return home
+
+
+def _watch_readers(monkeypatch, authorizer):
+    original = SessionDB.__init__
+    opened = []
+
+    def initialize(db, *args, **kwargs):
+        assert kwargs.get("read_only") is True
+        original(db, *args, **kwargs)
+        with db._read_ctx() as connection:
+            connection.set_authorizer(authorizer)
+        opened.append(db)
+
+    monkeypatch.setattr(SessionDB, "__init__", initialize)
+    return opened
+
+
+def _deny_context(action, table, column, *_):
+    if action == sqlite3.SQLITE_READ and (
+        table == "system_prompts" and column == "prompt"
+        or table == "sessions" and column in {"system_prompt", "tool_names"}
+    ):
+        return sqlite3.SQLITE_DENY
+    return sqlite3.SQLITE_OK
+
+
+def _run_lookup(home, query, expected, deny_reads=False):
+    before = _storage_snapshot(home)
+    # Separate process keeps setup connections and configuration caches out of lookup.
+    result = subprocess.run([sys.executable, __file__, str(home), query,
+                             json.dumps(expected), str(int(deny_reads))],
+                            capture_output=True, text=True)
+    assert result.returncode == 0, result.stdout + result.stderr
+    _assert_data_preserved(home, before)
+
+
+@pytest.mark.parametrize("query, expected", [
+    (ROOT, TIP),
+    (TITLE, TIP),
+    (ROOT[:22], TIP),
+    (AMBIGUOUS, None),
+    ("Missing retained plan", None),
+])
+def test_resume_selects_without_context_reads(archive, query, expected):
+    _run_lookup(archive, query, expected)
+
+
+def test_resume_lookup_failure_closes_readonly_store(archive):
+    _run_lookup(archive, ROOT, None, deny_reads=True)
+
+
+def test_resume_missing_store_stays_missing(tmp_path, monkeypatch):
+    home = tmp_path / "empty-home"
+    home.mkdir()
+    monkeypatch.setattr(cli_main, "get_hermes_home", lambda: home)
+    before = _storage_snapshot(home)
+    assert cli_main._resolve_session_by_name_or_id(ROOT) is None
+    assert _storage_snapshot(home) == before
+
+
+if __name__ == "__main__":
+    home, query, expected, deny_reads = sys.argv[1:]
+    home = Path(home)
+    before = _storage_snapshot(home)
+    assert "state.db-wal" not in before[0] and "state.db-shm" not in before[0]
+    with pytest.MonkeyPatch.context() as monkeypatch:
+        monkeypatch.setattr(cli_main, "get_hermes_home", lambda: home)
+        authorizer = (lambda action, *_: sqlite3.SQLITE_DENY
+                      if action == sqlite3.SQLITE_READ else sqlite3.SQLITE_OK) if int(deny_reads) else _deny_context
+        opened = _watch_readers(monkeypatch, authorizer)
+        result = cli_main._resolve_session_by_name_or_id(query)
+        assert len(opened) == 1 and opened[0].read_only
+        assert opened[0]._conn is None and opened[0]._read_conns_closed
+        _assert_data_preserved(home, before)
+        assert result == json.loads(expected), (query, result, expected)
diff --git a/tests/hermes_cli/test_session_export_stream.py b/tests/hermes_cli/test_session_export_stream.py
new file mode 100644
index 0000000000000000000000000000000000000000..923cdc045da81959f10a5e17947fd7664f1c458d
--- /dev/null
+++ b/tests/hermes_cli/test_session_export_stream.py
@@ -0,0 +1,149 @@
+"""File JSONL exports avoid whole-output copies and preserve existing targets on staging failure."""
+import errno
+import gc
+import hashlib
+import json
+import os
+import stat
+import tracemalloc
+
+import pytest
+
+from hermes_cli import session_export as export
+from hermes_state import SessionDB
+
+
+def run_cli(args):
+    from hermes_cli._parser import build_top_level_parser
+    from hermes_cli.sessions_cmd import cmd_sessions
+    from hermes_cli.subcommands.sessions import build_sessions_parser
+    parser, subparsers, _ = build_top_level_parser()
+    build_sessions_parser(subparsers, cmd_sessions=cmd_sessions)
+    parsed = parser.parse_args(['sessions', 'export', *args])
+    return parsed.func(parsed)
+
+
+@pytest.mark.parametrize('surface', ['cli', 'console'])
+def test_file_export_serialization_peak_does_not_scale_with_all_rows(tmp_path, monkeypatch, surface):
+    from hermes_cli.console_engine import HermesConsoleEngine
+    import hermes_state
+    with SessionDB() as db:
+        db.create_session('fixture', source='cli')
+    rows = [{'id': f'row-{i}', 'messages': [
+        {'role': 'user', 'content': 'ภาษาไทย🙂 ' * 1024} for _ in range(16)
+    ]} for i in range(24)]
+    monkeypatch.setattr(SessionDB, 'export_all', lambda *a, **kw: rows)
+    monkeypatch.setattr(hermes_state, 'resolved_max_export_messages', lambda: 0)
+    expected = hashlib.sha256(''.join(json.dumps(row, ensure_ascii=False) + '\n' for row in rows).encode()).hexdigest()
+    target = tmp_path / f'{surface}.jsonl'
+    engine = HermesConsoleEngine()
+    assert engine.execute('sessions stats').status == 'ok'  # Warm native imports before the allocation measurement.
+    gc.collect()
+    tracemalloc.start()
+    try:
+        if surface == 'console':
+            result = engine.execute(f'sessions export {target}', confirmed=True)
+            assert result.status == 'ok', result.output
+        else:
+            run_cli([str(target)])
+        _, peak = tracemalloc.get_traced_memory()
+    finally:
+        tracemalloc.stop()
+    assert hashlib.sha256(target.read_bytes()).hexdigest() == expected
+    assert peak < 4 * 1024**2, f'serialization copied the whole export: {peak} Python bytes'
+
+
+def test_jsonl_chunks_match_legacy_unicode_order_empty_and_newline():
+    rows = [{'ชื่อ': 'ไทย🙂\nquoted "value"', 'float': 1.25, 'nested': [None, True, {'x': 3}]}, {'id': 'last'}]
+    assert ''.join(export.iter_jsonl_chunks(rows)) == ''.join(json.dumps(r, ensure_ascii=False) + '\n' for r in rows)
+    assert ''.join(export.iter_jsonl_chunks([])) == ''
+
+
+@pytest.mark.parametrize('failure', ['serializer', 'fsync', 'interrupt'])
+def test_staging_failure_keeps_old_file_and_cleans_temp(tmp_path, monkeypatch, failure):
+    target = tmp_path / 'backup.jsonl'
+    target.write_text('keep original\n')
+    entries = set(tmp_path.iterdir())
+
+    def chunks():
+        yield 'first staged chunk\n'
+        if failure == 'serializer':
+            raise TypeError('Synthetic serializer failure')
+        if failure == 'interrupt':
+            raise KeyboardInterrupt()
+
+    if failure == 'fsync':
+        def fail_sync(fd):
+            raise OSError(errno.ENOSPC, 'Synthetic disk-full sync failure')
+        monkeypatch.setattr(os, 'fsync', fail_sync)
+    with pytest.raises({'serializer': TypeError, 'fsync': OSError, 'interrupt': KeyboardInterrupt}[failure]):
+        export.write_export_payload(str(target), chunks())
+    assert target.read_text() == 'keep original\n'
+    assert set(tmp_path.iterdir()) == entries
+
+
+@pytest.mark.platforms('posix')
+def test_export_follows_symlink_and_preserves_mode(tmp_path):
+    real = tmp_path / 'target.jsonl'
+    real.write_text('old')
+    real.chmod(0o640)
+    link = tmp_path / 'alias.jsonl'
+    link.symlink_to(real)
+    export.write_export_payload(str(link), export.iter_jsonl_chunks([{'text': 'ไทย'}]))
+    assert link.is_symlink() and real.read_text() == '{"text": "ไทย"}\n'
+    assert stat.S_IMODE(real.stat().st_mode) == 0o640
+
+
+@pytest.mark.platforms('posix')
+def test_export_preserves_existing_hardlink_identity(tmp_path):
+    first = tmp_path / 'first.jsonl'
+    second = tmp_path / 'second.jsonl'
+    first.write_text('old')
+    os.link(first, second)
+    export.write_export_payload(str(first), export.iter_jsonl_chunks([{'text': 'new'}]))
+    assert first.stat().st_ino == second.stat().st_ino
+    assert second.read_text() == '{"text": "new"}\n'
+
+
+@pytest.mark.platforms('posix')
+@pytest.mark.skipif(getattr(os, 'geteuid', lambda: 1)() == 0, reason='Root may write readonly files by kernel policy')
+def test_readonly_output_is_not_bypassed_by_atomic_replacement(tmp_path):
+    target = tmp_path / 'readonly.jsonl'
+    target.write_text('keep')
+    target.chmod(0o444)
+    try:
+        with pytest.raises(PermissionError):
+            export.write_export_payload(str(target), ['replacement'])
+        assert target.read_text() == 'keep'
+    finally:
+        target.chmod(0o644)
+
+
+def test_missing_parent_is_not_created_and_stdout_bytes_stay_equal(tmp_path, capsys):
+    target = tmp_path / 'missing' / 'backup.jsonl'
+    with pytest.raises(FileNotFoundError):
+        export.write_export_payload(str(target), ['data'])
+    assert not target.parent.exists()
+    rows = [{'id': 'first'}, {'text': 'ไทย🙂'}]
+    export.write_export_payload('-', export.iter_jsonl_chunks(rows))
+    assert capsys.readouterr().out == ''.join(json.dumps(r, ensure_ascii=False) + '\n' for r in rows)
+
+
+@pytest.mark.platforms('posix')
+def test_special_device_keeps_direct_stream_behavior():
+    export.write_export_payload(os.devnull, export.iter_jsonl_chunks([{'text': 'ไทย'}]))
+
+
+def test_atomic_chunk_writer_does_not_recreate_a_deleted_profile(tmp_path):
+    from hermes_constants import mark_named_profile_deleted
+    from utils import atomic_write_chunks
+    import shutil
+
+    (tmp_path / 'config.yaml').write_text('{}\n')
+    profile = tmp_path / 'profiles' / 'deleted'
+    profile.mkdir(parents=True)
+    mark_named_profile_deleted(profile)
+    shutil.rmtree(profile)
+    with pytest.raises(FileNotFoundError, match='Named profile home does not exist'):
+        atomic_write_chunks(profile / 'exports' / 'saved.jsonl', ['one\n'])
+    assert not profile.exists()
