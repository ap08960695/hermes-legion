+    assert kb.request_changes(conn, tid, reason='Revise the check', expected_run_id=reviewer.current_run_id)[0]
+    contract['acceptance_criteria']['sum'] = 'The revised requirement'
+    with kb.write_txn(conn):
+        conn.execute('UPDATE tasks SET body=? WHERE id=?', (brief(contract), tid))
+    review(delivery)
+    revision = delivery_summary(conn, tid)['revision']
+    assert revision['brief_changed'] is True
+    assert revision['files'] == [{'name': 'answer.txt', 'status': 'unchanged'}]
+
+
+def test_reviewed_usage_binds_runs_and_judge_without_reading_captain_totals(delivery):
+    from contextlib import closing
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+    from hermes_state import SessionDB
+    from plugins.kanban.dashboard.plugin_api import router
+
+    conn, tid, _, evidence, root = delivery
+    first, rejection = review(delivery)
+    assert kb.request_changes(conn, tid, reason='Explain the result', expected_run_id=rejection.current_run_id)[0]
+    revised, acceptance = review(delivery)
+    assert kb.complete_task(conn, tid, summary='Verified result', metadata=approval(evidence, revised),
+                            expected_run_id=acceptance.current_run_id)
+    # The origin does not identify any worker attempt.
+    with kb.write_txn(conn):
+        conn.execute('UPDATE tasks SET session_id=? WHERE id=?', ('origin', tid))
+    with closing(SessionDB(root / 'home' / 'state.db')) as store:
+        store.create_session('origin', 'cli')
+        store.update_token_counts('origin', input_tokens=9999, api_call_count=1)
+
+    def admitted(run_id, sid, prompt, reported=None, judge=False):
+        run = kb.get_run(conn, run_id)
+        profile = root / 'home' / 'profiles' / run.profile
+        profile.mkdir(parents=True, exist_ok=True)
+        path = profile / 'state.db'
+        with closing(SessionDB(path)) as store:
+            store.create_session(sid, 'kanban')
+            store.update_token_counts(sid, input_tokens=prompt - 3, output_tokens=4, cache_read_tokens=3,
+                                      estimated_cost_usd=12, actual_cost_usd=reported,
+                                      cost_status='actual' if reported is not None else 'unknown', api_call_count=1)
+            if judge:
+                store.record_auxiliary_usage(sid, 'goal_judge', input_tokens=8, output_tokens=2, model='judge-fixture')
+                store.end_session(sid, 'compression')
+                store.create_session('compressed-revision', 'kanban', parent_session_id=sid)
+                store.update_token_counts('compressed-revision', input_tokens=3, output_tokens=1, api_call_count=1)
+                store.create_session('delegated-child', 'tool', parent_session_id=sid)
+                store.update_token_counts('delegated-child', input_tokens=500, api_call_count=1)
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, 'owner_admitted', {
+                'db': str(path), 'session_id': sid,
+                'request_id': 'kanban:' + json.dumps(['default', tid, run_id], separators=(',', ':')),
+            }, run_id=run_id)
+
+    admitted(first, 'first-action', 100)
+    admitted(revised, 'second-action', 200, .021, judge=True)
+    admitted(acceptance.current_run_id, 'accepted-review', 20, 0.0)
+
+    app = FastAPI()
+    app.include_router(router)
+    url = f'/tasks/{tid}/reviewed-usage?board=default&review='
+    with TestClient(app) as client:
+        assert client.get(url + str(rejection.current_run_id)).json() == {'usage': None}
+        reply = client.get(url + str(acceptance.current_run_id))
+        assert reply.status_code == 200
+        usage = reply.json()['usage']
+        assert usage['coverage'] == 'partial'
+        rows = {row['stage']: row for row in usage['stages']}
+        assert rows['think']['input_tokens'] is None
+        assert rows['action']['input_tokens'] == 100
+        assert rows['action']['provider_reported_usd'] is None
+        assert rows['revision']['input_tokens'] == 203
+        assert rows['revision']['api_calls'] == 2
+        assert rows['revision']['provider_reported_usd'] == .021
+        assert rows['review']['input_tokens'] == 20
+        assert rows['review']['provider_reported_usd'] == 0
+        assert rows['review']['runs'][0]['source'] == 'unavailable'
+        assert rows['judge']['input_tokens'] == 8
+        assert rows['judge']['runs'] == [{'task_id': tid, 'run_id': revised, 'source': 'session'}]
+        assert str(root) not in json.dumps(usage)
+
+        # Two native markers referring to the same session are ambiguous, never counted twice.
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, 'owner_admitted', {
+                'db': str(root / 'home' / 'profiles' / 'builder' / 'state.db'), 'session_id': 'second-action',
+                'request_id': 'kanban:' + json.dumps(['default', tid, first], separators=(',', ':')),
+            }, run_id=first)
+        rows = {row['stage']: row for row in client.get(url + str(acceptance.current_run_id)).json()['usage']['stages']}
+        assert rows['action']['input_tokens'] is None
+        assert rows['revision']['input_tokens'] is None
+        assert rows['judge']['input_tokens'] is None
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+            kb._append_event(conn, tid, 'reopened', {})
+        assert client.get(url + str(acceptance.current_run_id)).json() == {'usage': None}
