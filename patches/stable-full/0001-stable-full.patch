new file mode 100644
index 0000000000000000000000000000000000000000..48fb2a357fec113ea6d7fb268b1af5b0c14a1f94
--- /dev/null
+++ b/apps/shared/src/config-patch.ts
@@ -0,0 +1,23 @@
+/** Merge sparse config updates using the config API's section semantics.
+ * Null leaves replace scalars/lists, but null over a mapping is ignored. */
+export function mergeConfigPatch(
+  previous: Record<string, unknown>,
+  next: Record<string, unknown>
+): Record<string, unknown> {
+  const entries = new Map(Object.entries(previous))
+
+  for (const [key, value] of Object.entries(next)) {
+    const old = entries.get(key)
+    const oldMapping = old !== null && typeof old === 'object' && !Array.isArray(old)
+
+    if (oldMapping && value === null) { continue }
+
+    const objects = old !== null && value !== null && typeof old === 'object' && typeof value === 'object'
+
+    entries.set(key, objects && !Array.isArray(old) && !Array.isArray(value)
+      ? mergeConfigPatch(old as Record<string, unknown>, value as Record<string, unknown>)
+      : value)
+  }
+
+  return Object.fromEntries(entries)
+}
