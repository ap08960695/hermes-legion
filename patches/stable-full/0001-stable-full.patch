+                foreign_done = await roster('helper')
+                assert foreign_done['canonical_session']['id'] == foreign
+                assert foreign_done['canonical_session']['delegation_reports'] == []
+                for sid, profile, marker in [(side, None, 'INDEPENDENT_SIDE_CHAT'), (foreign, 'helper', 'INDEPENDENT_PROFILE')]:
+                    view = await result('session.resume', **({'profile': profile} if profile else {}), session_id=sid)
+                    content = json.dumps(view['messages'])
+                    assert marker in content and 'MONITOR_PARENT_' not in content and 'MONITOR_NATIVE_REJECTION' not in content
+                denied = await rpc(ws, 'profiles.list', profile='another-profile')
+                assert denied['error']['message'] == 'profile_mismatch'
+                assert set(peer.calls) == {'side-control', 'profile-control', 'delegate', 'status', 'read', 'after-read', 'delivery'}
+                assert not peer.errors, peer.errors
+                print(json.dumps({'kind': 'native backend integration; model replies and usage are fixture',
+                                  'outcome': outcome, 'cancellation': cancellation, 'parent': parent, 'worker': child['id'], 'delegation': ledger['delegation_id'],
+                                  'submitted': admission, 'seconds': time.monotonic() - submitted,
