diff --git a/apps/desktop/src/mermaid/render.ts b/apps/desktop/src/mermaid/render.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a15a7822d141ecc7862257950c153c6a943d77b6
--- /dev/null
+++ b/apps/desktop/src/mermaid/render.ts
@@ -0,0 +1,140 @@
+import { MERMAID_SOURCE_LIMIT, MERMAID_SVG_LIMIT, type MermaidRenderResult } from '@hermes/shared/mermaid-render'
+import DOMPurify from 'dompurify'
+import mermaid from 'mermaid'
+
+import { normalizeSvgSize, svgSize, xmlWellFormedSvg } from '@/lib/svg-image'
+
+const MAX_LINES = 160
+const MAX_EDGES = 100
+const MAX_DIMENSION = 12_000
+
+const FAMILIES =
+  /^(?:flowchart|graph|sequenceDiagram|classDiagram(?:-v2)?|stateDiagram(?:-v2)?|gantt|erDiagram|pie|mindmap)(?:\s|;|$)/
+
+// Skip ordinary comments when identifying the family. Reject source directives,
+// custom styling and active content even when they are on the same line as a
+// diagram statement. The helper's CSP separately denies resource loads.
+function checkSource(code: string) {
+  if (code.length > MERMAID_SOURCE_LIMIT || code.split(/\r\n?|\n/).length > MAX_LINES) {
+    return 'limit'
+  }
+
+  const body = code.replace(/^\s*%%(?!\{)[^\r\n]*/gm, '').trimStart()
+
+  if (
+    body.startsWith('---') ||
+    code.includes('%%{') ||
+    /(?:^|[;\r\n])[ \t]*(?:click|link|links|classDef|linkStyle|style|cssClass)\s+|\b(?:img|icon)\s*:|::icon\b|@\{|<\/?[a-z][^<>]*>/i.test(
+      body.replace(/<br\s*\/?>/gi, '')
+    )
+  ) {
+    return 'restricted'
+  }
+
+  return FAMILIES.test(body) ? null : 'invalid'
+}
+
+// A saved SVG can be opened as a document. Allow SVG geometry and static CSS,
+// remove interactive/foreign elements, and retain only local fragment URLs.
+function exportSvg(raw: string): MermaidRenderResult {
+  if (raw.length > MERMAID_SVG_LIMIT) {
+    return { error: 'limit' }
+  }
+
+  const cleaned = DOMPurify.sanitize(raw, {
+    ADD_TAGS: ['style'],
+    USE_PROFILES: { svg: true },
+    FORBID_TAGS: ['a', 'animate', 'animateMotion', 'animateTransform', 'foreignObject', 'image', 'script', 'set'],
+    FORBID_ATTR: ['href', 'src', 'xlink:href', 'xml:base']
+  })
+
+  const root = new DOMParser().parseFromString(xmlWellFormedSvg(cleaned), 'image/svg+xml').documentElement
+
+  if (root.localName !== 'svg' || !root.hasAttribute('viewBox')) {
+    return { error: 'invalid' }
+  }
+
+  for (const el of [root, ...root.querySelectorAll('*')]) {
+    // Styles are already generated under fixed site configuration. Keep the
+    // export self-contained even if a diagram grammar yields custom CSS.
+    if (el.localName === 'style') {
+      const sheet = new CSSStyleSheet()
+      sheet.replaceSync(el.textContent ?? '')
+      el.textContent = Array.from(sheet.cssRules)
+        .filter(rule => rule.type === CSSRule.STYLE_RULE && safeCss(rule.cssText))
+        .map(rule => rule.cssText)
+        .join('\n')
+    }
+
+    for (const attribute of Array.from(el.attributes)) {
+      if (
+        /^(?:on|.*:href)/i.test(attribute.name) ||
+        (attribute.name === 'style' && !safeCss(attribute.value)) ||
+        (/^(?:fill|stroke|filter|mask|clip-path|cursor|marker(?:-start|-mid|-end)?)$/i.test(attribute.name) &&
+          !safeCss(attribute.value))
+      ) {
+        el.removeAttributeNode(attribute)
+      }
+    }
+  }
+
+  const [, , viewWidth, viewHeight] = (root.getAttribute('viewBox') ?? '')
+    .trim()
+    .split(/[\s,]+/)
+    .map(Number)
+
+  if (!Number.isFinite(viewWidth) || !Number.isFinite(viewHeight) || viewWidth <= 0 || viewHeight <= 0) {
+    return { error: 'invalid' }
+  }
+
+  const svg = normalizeSvgSize(new XMLSerializer().serializeToString(root))
+  const { width, height } = svgSize(svg)
+
+  if (svg.length > MERMAID_SVG_LIMIT || width <= 0 || height <= 0 || Math.max(width, height) > MAX_DIMENSION) {
+    return { error: 'limit' }
+  }
+
+  return { svg }
+}
+
+function safeCss(css: string): boolean {
+  // The remaining CSS has no escapes, at-rules, comments or nonlocal URL
+  // functions. SVG paint servers and arrowheads use local fragments.
+  return !/[@\\]|\/\*|(?:url|image-set|image|src)\s*\(/i.test(css.replace(/url\(\s*["']?#[\w:.-]+["']?\s*\)/gi, ''))
+}
+
+async function render(code: string, dark: boolean): Promise<MermaidRenderResult> {
+  const error = checkSource(code)
+
+  if (error) {
+    return { error }
+  }
+
+  mermaid.initialize({
+    fontFamily: 'system-ui, sans-serif',
+    htmlLabels: false,
+    maxEdges: MAX_EDGES,
+    maxTextSize: MERMAID_SOURCE_LIMIT,
+    securityLevel: 'strict',
+    startOnLoad: false,
+    suppressErrorRendering: true,
+    theme: dark ? 'dark' : 'neutral',
+    themeVariables: { fontSize: '14px' },
+    flowchart: { curve: 'monotoneX', nodeSpacing: 32, rankSpacing: 40, padding: 14 },
+    gantt: { useWidth: 800 }
+  })
+
+  const id = `mermaid-${crypto.randomUUID()}`
+
+  try {
+    const result = await mermaid.render(id, code.replaceAll('&nbsp;', '\u00a0'))
+
+    return exportSvg(result.svg)
+  } catch {
+    return { error: 'invalid' }
+  } finally {
+    document.getElementById(`d${id}`)?.remove()
+  }
+}
+
+Object.assign(window, { hermesRenderMermaid: render })
