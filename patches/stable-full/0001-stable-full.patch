+def test_global_search_falls_back_when_sqlite_omits_json1(db, monkeypatch):
+    """An optional SQLite feature cannot turn a real encoded hit into no result."""
+    class NoJson1(sqlite3.Connection):
+        fallback_registrations = 0
+
+        def execute(self, sql, parameters=()):
+            if sql == "SELECT json_valid('null')":
+                raise sqlite3.OperationalError('no such function: json_valid')
+            return super().execute(sql, parameters)
+
+        def create_function(self, name, narg, function, **kwargs):
+            if name == 'json_valid' and function is not None:
+                self.fallback_registrations += 1
+            return super().create_function(name, narg, function, **kwargs)
+
+    db.create_session('no-json1', source='cli')
+    mid = db.append_message('no-json1', role='assistant', content='ordinary', tool_calls=[
+        {'type': 'function', 'function': {'name': 'terminal', 'arguments': 'café'}},
+    ])
+    reader = sqlite3.connect(f'file:{db.db_path}?mode=ro', uri=True, factory=NoJson1)
+    reader.row_factory = sqlite3.Row
+    reader.execute('PRAGMA query_only=ON')
+    monkeypatch.setattr(db, '_read_retrying_ioerr', lambda fn: fn(reader))
+    try:
+        assert mid in ids(db.search_messages('cafe'))
+        assert reader.fallback_registrations > 0
+    finally:
+        reader.close()
