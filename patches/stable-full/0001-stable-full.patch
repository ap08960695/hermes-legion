index 0000000000000000000000000000000000000000..e4ecad1f9e11fe2c660fa9c2c7ff9547fc7f63e7
--- /dev/null
+++ b/apps/desktop/src/store/composer-draft-owner.ts
@@ -0,0 +1,172 @@
+import type { SessionOwnerScope } from './session-request-router'
+
+export const OWNED_DRAFT_STORAGE_PREFIX = 'hermes:composer-draft:v4:'
+export const MAX_PERSISTED_DRAFTS = 50
+
+type OwnerTuple = [string | null, string, string]
+
+const profileKey = (profile: string | undefined) => profile?.trim() || 'default'
+
+export function draftOwnerKey(owner: SessionOwnerScope): string | undefined {
+  if (owner == null) {
+    return undefined
+  }
+
+  const parts: OwnerTuple =
+    typeof owner === 'string'
+      ? [null, profileKey(owner), profileKey(owner)]
+      : [owner.connectionId.trim(), profileKey(owner.profile), profileKey(owner.targetProfile ?? owner.profile)]
+
+  return JSON.stringify(parts)
+}
+
