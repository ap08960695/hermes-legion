@@ -0,0 +1,46 @@
+"""Known mandatory reasoning uses an explicit cheap floor before the first request."""
+from copy import deepcopy
+from types import SimpleNamespace
+
+import pytest
+
+from agent.auxiliary_client import _CodexCompletionsAdapter, _build_call_kwargs
+from agent.auxiliary_reasoning_floor import known_reasoning_floor
+from agent.reasoning_limits import owner_reasoning_limits
+
+
+@pytest.mark.parametrize('host', ['https://chatgpt.com/backend-api/codex', 'https://api.openai.com/v1'])
+@pytest.mark.parametrize('model', ['gpt-6.1-sol', 'gpt-6-astra'])
+def test_known_native_mandatory_model_gets_low_before_transport(host, model):
+    disabled = {'enabled': False}
+    assert known_reasoning_floor(disabled, 'custom', host, model, 'approval') == {
+        'enabled': True, 'effort': 'low'}
+    assert disabled == {'enabled': False}
+
+
+def test_actual_approval_request_keeps_the_floor_through_codex_conversion():
+    host = 'https://chatgpt.com/backend-api/codex'
+    with owner_reasoning_limits({'gpt-6.1-sol': 'high'}):
+        request = _build_call_kwargs('custom', 'gpt-6.1-sol',
+            [{'role': 'user', 'content': 'Synthetic command risk assessment'}],
+            reasoning_config={'enabled': False}, base_url=host, task='approval')
+    original = deepcopy(request)
+    adapter = _CodexCompletionsAdapter(SimpleNamespace(base_url=host), 'gpt-6.1-sol')
+    wire, _, _ = adapter._build_responses_kwargs(request)
+    assert wire['reasoning']['effort'] == 'low'
+    assert request == original
+
+
+@pytest.mark.parametrize('host', ['https://relay.example/v1', 'https://chatgpt.com.example/backend-api/codex'])
+def test_non_native_route_does_not_inherit_another_endpoints_model_ladder(host):
+    disabled = {'enabled': False}
+    assert known_reasoning_floor(disabled, 'custom', host, 'gpt-6.1-sol', 'approval') is disabled
+
+
+def test_explicit_effort_and_a_model_that_can_disable_keep_their_policy():
+    host = 'https://chatgpt.com/backend-api/codex'
+    explicit = {'enabled': True, 'effort': 'high'}
+    disabled = {'enabled': False}
+    assert known_reasoning_floor(explicit, 'custom', host, 'gpt-6.1-sol', 'approval') is explicit
+    assert known_reasoning_floor(disabled, 'custom', host, 'gpt-6.1-terra', 'approval') is disabled
+    assert known_reasoning_floor(disabled, 'custom', 'https://api.openai.com/v1', 'gpt-4o', 'approval') is disabled
diff --git a/tests/agent/test_auxiliary_usage_buckets.py b/tests/agent/test_auxiliary_usage_buckets.py
new file mode 100644
index 0000000000000000000000000000000000000000..a669d787d0e080039cdb746c6bae8e0928a2c80c
--- /dev/null
+++ b/tests/agent/test_auxiliary_usage_buckets.py
@@ -0,0 +1,118 @@
+"""Native auxiliary adapters must retain the usage their accounting consumers need."""
+
+from copy import deepcopy
+from types import SimpleNamespace
+
+import pytest
+
+from agent.aux_accounting import record_aux_usage, reset_accounting_context, set_accounting_context
+from agent.auxiliary_client import _AnthropicCompletionsAdapter, _CodexCompletionsAdapter
+from agent.auxiliary_hooks import _usage_summary
+from hermes_state import SessionDB
+
+
+def _adapter_response(route):
+    calls = []
+    if route.startswith("codex"):
+        raw = {"input_tokens": 100, "output_tokens": 20, "total_tokens": 120,
+               "input_tokens_details": {"cached_tokens": 60, "cache_write_tokens": 10},
+               "output_tokens_details": {"reasoning_tokens": 7}}
+        usage = raw if route == "codex-dict" else SimpleNamespace(
+            **{**raw, "input_tokens_details": SimpleNamespace(**raw["input_tokens_details"]),
+               "output_tokens_details": SimpleNamespace(**raw["output_tokens_details"])})
+        final = SimpleNamespace(status="completed", usage=usage, output=[SimpleNamespace(
+            type="message", role="assistant", phase="final_answer", status="completed",
+            content=[SimpleNamespace(type="output_text", text="auxiliary answer")])])
+
+        def create(**kwargs):
+            calls.append(kwargs)
+            return final
+
+        adapter = _CodexCompletionsAdapter(SimpleNamespace(responses=SimpleNamespace(create=create)), "offline-aux")
+    else:
+        usage = SimpleNamespace(input_tokens=100, output_tokens=20,
+                                cache_read_input_tokens=80, cache_creation_input_tokens=40)
+        final = SimpleNamespace(content=[SimpleNamespace(type="text", text="auxiliary answer")],
+                                stop_reason="end_turn", usage=usage)
+
+        class Stream:
+            def __enter__(self):
+                return self
+
+            def __exit__(self, *args):
+                return False
+
+            def __iter__(self):
+                yield SimpleNamespace(type="message_stop")
+
+            def get_final_message(self):
+                return final
+
+        def create(**kwargs):
+            calls.append(kwargs)
+            return Stream() if route == "anthropic-stream" else final
+
+        messages = SimpleNamespace(**{"stream" if route == "anthropic-stream" else "create": create})
+        adapter = _AnthropicCompletionsAdapter(SimpleNamespace(messages=messages), "offline-aux")
+    before = deepcopy(vars(usage) if isinstance(usage, SimpleNamespace) else usage)
+    response = adapter.create(messages=[{"role": "user", "content": "offline fixture"}])
+    assert (vars(usage) if isinstance(usage, SimpleNamespace) else usage) == before
+    assert len(calls) == 1, "normalizing usage must not retry the provider"
+    assert response.choices[0].message.content == "auxiliary answer"
+    assert response.choices[0].finish_reason == "stop"
+    return response
+
+
+@pytest.mark.parametrize("route", ["codex-object", "codex-dict", "anthropic-stream", "anthropic-object"])
+def test_native_adapter_cache_buckets_survive_the_existing_auxiliary_hook(route):
+    response = _adapter_response(route)
+    summary = _usage_summary(response)
+    expected = (30, 20, 60, 10, 7, 100, 120) if route.startswith("codex") else (100, 20, 80, 40, 0, 220, 240)
+
+    assert tuple(summary[k] for k in (
+        "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens",
+        "reasoning_tokens", "prompt_tokens", "total_tokens")) == expected
+    assert (response.usage.prompt_tokens, response.usage.total_tokens) == expected[-2:]
+
+
+@pytest.mark.parametrize("provider", ["anthropic", "openai-codex", "openrouter"])
+def test_chat_shaped_auxiliary_usage_reaches_native_session_accounting(tmp_path, monkeypatch, provider):
+    monkeypatch.setattr("agent.usage_pricing.estimate_usage_cost", lambda *a, **kw: SimpleNamespace(amount_usd=None))
+    response = SimpleNamespace(model="offline-aux", usage=SimpleNamespace(
+        prompt_tokens=100, completion_tokens=20, total_tokens=120,
+        prompt_tokens_details=SimpleNamespace(cached_tokens=60, cache_write_tokens=10),
+        completion_tokens_details=SimpleNamespace(reasoning_tokens=7)))
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session("usage-fixture", source="cli")
+        token = set_accounting_context(db, "usage-fixture")
+        try:
+            record_aux_usage(response, "compression", provider=provider)
+        finally:
+            reset_accounting_context(token)
+        with db._read_ctx() as conn:
+            rows = conn.execute(
+                "SELECT input_tokens,output_tokens,cache_read_tokens,cache_write_tokens,reasoning_tokens,"
+                "api_call_count,billing_provider FROM session_model_usage WHERE session_id=? AND task=?",
+                ("usage-fixture", "compression")).fetchall()
+
+    assert [tuple(row) for row in rows] == [(30, 20, 60, 10, 7, 1, provider)]
+
+
+def test_fully_cached_anthropic_auxiliary_call_is_not_dropped(tmp_path, monkeypatch):
+    monkeypatch.setattr("agent.usage_pricing.estimate_usage_cost", lambda *a, **kw: SimpleNamespace(amount_usd=None))
+    response = SimpleNamespace(model="offline-aux", usage=SimpleNamespace(
+        prompt_tokens=100, completion_tokens=0,
+        prompt_tokens_details=SimpleNamespace(cached_tokens=100)))
+    with SessionDB(tmp_path / "state.db") as db:
+        db.create_session("usage-fixture", source="cli")
+        token = set_accounting_context(db, "usage-fixture")
+        try:
+            record_aux_usage(response, "title_generation", provider="anthropic")
+        finally:
+            reset_accounting_context(token)
+        with db._read_ctx() as conn:
+            rows = conn.execute(
+                "SELECT input_tokens,output_tokens,cache_read_tokens,api_call_count FROM session_model_usage "
+                "WHERE session_id=? AND task=?", ("usage-fixture", "title_generation")).fetchall()
+
+    assert [tuple(row) for row in rows] == [(0, 0, 100, 1)]
