+    .filter(row => row.key !== currentKey && !preserveKeys.includes(row.key))
+    .slice(0, excess)
+    .map(row => row.key)
+
+  for (const key of retired) {
+    window.localStorage.removeItem(key)
+  }
+
+  return retired
+}
