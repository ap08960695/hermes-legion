+import { createContext, useContext } from 'react'
+
+/** The native rail owns global navigation; the side pane owns sessions/projects. */
+export const FocusNavigationContext = createContext(false)
+export const useFocusNavigation = () => useContext(FocusNavigationContext)
+
+// The rail's New chat replaces the pane's New session row; Ctrl/Cmd+N and the palette still start one.
+export function contextualSidebarItems<T extends { id: string }>(items: T[], integrated: boolean): T[] {
+  return integrated ? [] : items
+}
