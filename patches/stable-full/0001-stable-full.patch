+"""The real Desktop handoff and native CLI lock agree on the custodian's identity."""
+import json
+from pathlib import Path
+
+import pytest
+
+from tests.scripts.desktop_update.test_desktop_update_posix_marker import _install, _run
+
+pytestmark = pytest.mark.platforms("linux")
+SOURCE_ROOT = Path(__file__).resolve().parents[3]
+
+
+@pytest.mark.parametrize('preserve_supported', [False, True])
+def test_handoff_cli_accepts_only_its_actual_custodian(tmp_path, preserve_supported):
+    home, install = _install(tmp_path)
+    body = f'''
+import json, os, sys
+from pathlib import Path
+if '--help' in sys.argv:
+    print({'update options --keep-stash --preserve-local-changes' if preserve_supported else 'update options --keep-stash'!r})
+    sys.exit(0)
+if sys.argv[1:2] != ['update']:
+    sys.exit(1)
+sys.path.insert(0, {str(SOURCE_ROOT)!r})
+import hermes_cli
+hermes_cli.__path__.insert(0, {str(SOURCE_ROOT / "hermes_cli")!r})
+from hermes_cli.update_lock import UpdateLock
+home = Path(os.environ['HERMES_HOME'])
+marker = home / '.hermes-update-in-progress'
+lock = UpdateLock(path=marker, install_root=Path({str(install)!r}))
+accepted = lock.acquire()
+owner = int(marker.read_text().splitlines()[0])
+claim = {{'accepted': accepted, 'owner': owner,
+          'handoff_pid': int(os.environ['HERMES_UPDATE_HANDOFF_PID']),
+          'owns_claim': lock.acquired, 'argv': sys.argv[1:]}}
+lock.release()
+claim['owner_claim_preserved'] = marker.exists()
+(home / 'cli-custody.json').write_text(json.dumps(claim))
+if not accepted:
+    print('Another Hermes update is already running')
+    sys.exit(2)
+print('Update complete!')
+sys.exit(0)
+'''
+    (install / "hermes_cli" / "main.py").write_text(body)
+    completed = _run(tmp_path, home, install, '--no-gateway')
+    assert completed.returncode == 0, (home / "logs" / "desktop-update-handoff.log").read_text()[-7000:]
+    claim = json.loads((home / 'cli-custody.json').read_text())
+    assert claim['accepted'], claim
+    assert claim['handoff_pid'] == claim['owner'], claim
+    assert claim['owner_claim_preserved'] and not claim['owns_claim'], claim
+    expected_flag = '--preserve-local-changes' if preserve_supported else '--keep-stash'
+    assert expected_flag in claim['argv'], claim
+    if preserve_supported:
+        assert '--keep-stash' not in claim['argv'], claim
+    result = json.loads((home / '.hermes-update-result.json').read_text())
+    assert result['exit_code'] == 0 and result['ok'], result
