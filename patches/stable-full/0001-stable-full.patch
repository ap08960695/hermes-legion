+def test_native_runner_initialization_applies_the_opt_in_without_changing_config(tmp_path, monkeypatch):
+    from gateway.config import GatewayConfig
+    from gateway.run import GatewayRunner, _profile_runtime_scope
+    from agent.secret_scope import is_multiplex_active, set_multiplex_active
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    path = tmp_path / 'config.yaml'
+    path.write_text('runtime:\n  memory_profile_frames: 4\nagent:\n  max_turns: 7\n')
+    original = path.read_bytes()
+    calls = []
+    monkeypatch.setattr(tracemalloc, 'is_tracing', lambda: False)
+    monkeypatch.setattr(tracemalloc, 'start', calls.append)
+    previous = is_multiplex_active()
+    try:
+        with _profile_runtime_scope(tmp_path):
+            runner = GatewayRunner(GatewayConfig(sessions_dir=tmp_path / 'sessions'))
