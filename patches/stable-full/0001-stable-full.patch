--- /dev/null
+++ b/tests/gateway/test_bot_monitor_native_lifecycle.py
@@ -0,0 +1,307 @@
+"""Native delegation reaches Monitor reports; only loopback model replies are simulated."""
+import asyncio
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import json
+import os
+from pathlib import Path
+import sqlite3
+import sys
+import threading
+import time
+
+import pytest
+
+from websockets.asyncio.client import connect
+
+from tests.gateway.fixtures.local_recovery_probe import rpc
+from tests.gateway.test_normal_runtime_boot import control
+from tests.waiting import async_wait_until
+
+
+class _Model(BaseHTTPRequestHandler):
+    def log_message(self, *args):
+        pass
+
+    def do_POST(self):
+        if self.path == '/api/show':
+            self.send_error(404)
+            return
+        kind = None
+        try:
+            assert self.path == '/v1/chat/completions'
+            size = int(self.headers['Content-Length'])
+            assert 0 < size < 2 * 1024 ** 2
+            body = json.loads(self.rfile.read(size))
+            messages = body['messages']
+            tools = [t['function']['name'] for t in body.get('tools', [])]
+            delivered = any(m['role'] == 'user' and str(m.get('content', '')).startswith(
+                '[ASYNC DELEGATION BATCH COMPLETE') for m in messages)
+            result = any(m['role'] == 'tool' for m in messages)
+            kind = ('delivery' if delivered else 'status' if result else 'delegate') if 'delegate_task' in tools else (
+                'after-read' if result else 'read')
+            last_user = next((m.get('content') for m in reversed(messages) if m['role'] == 'user'), '')
+            if last_user in {'INDEPENDENT_SIDE_CHAT', 'INDEPENDENT_PROFILE'}:
+                kind = 'side-control' if last_user == 'INDEPENDENT_SIDE_CHAT' else 'profile-control'
+            with self.server.lock:
+                self.server.calls.append(kind)
+                assert self.server.calls.count(kind) == 1 and len(self.server.calls) <= 7
+            message = {'role': 'assistant', 'content': 'MONITOR_PARENT_' + self.server.outcome.upper() if kind == 'delivery' else (
+                'MONITOR_PARENT_WAITING' if kind == 'status' else 'MONITOR_WORKER_DONE')}
+            if kind in {'side-control', 'profile-control'}:
+                message['content'] = last_user
+            finish = 'stop'
+            if kind in {'delegate', 'read'}:
+                name, args = ('delegate_task', {'tasks': [{
+                    'goal': 'Read the local fixture once, then return MONITOR_WORKER_DONE.', 'toolsets': ['file']}]}) if kind == 'delegate' else (
+                        'read_file', {'path': str(self.server.path), 'offset': 1, 'limit': 5})
+                assert name in tools
+                message = {'role': 'assistant', 'content': None, 'tool_calls': [{
+                    'index': 0, 'id': 'monitor-' + kind, 'type': 'function',
+                    'function': {'name': name, 'arguments': json.dumps(args)}}]}
+                finish = 'tool_calls'
+            if kind == 'after-read':
+                assert any(m['role'] == 'tool' and 'MONITOR_NATIVE_FILE_CONTENT' in str(m.get('content'))
+                           for m in messages)
+                self.server.read_done.set()
+                assert self.server.release.wait(150), 'worker reply latch expired'
+                if self.server.outcome == 'failed':
+                    data = json.dumps({'error': {'type': 'invalid_request_error',
+                                                'message': 'MONITOR_NATIVE_REJECTION'}}).encode()
+                    self.send_response(400)
+                    self.send_header('Content-Type', 'application/json')
+                    self.send_header('Content-Length', str(len(data)))
+                    self.end_headers()
+                    self.wfile.write(data)
+                    return
+            if kind == 'delivery':
+                assert any('status=' + self.server.outcome in str(m.get('content')) for m in messages)
+                if self.server.outcome == 'failed':
+                    assert any('MONITOR_NATIVE_REJECTION' in str(m.get('content')) for m in messages)
+            frame = {'id': 'monitor-' + kind, 'model': 'loopback-fixture', 'choices': [{
+                'index': 0, 'delta' if body.get('stream') else 'message': message, 'finish_reason': finish}],
+                'usage': {'prompt_tokens': 17, 'completion_tokens': 5, 'total_tokens': 22}}
+            data = ('data: ' + json.dumps(frame) + '\n\ndata: [DONE]\n\n').encode() if body.get('stream') else json.dumps(frame).encode()
+            self.send_response(200)
+            self.send_header('Content-Type', 'text/event-stream' if body.get('stream') else 'application/json')
+            self.send_header('Content-Length', str(len(data)))
+            self.end_headers()
+            self.wfile.write(data)
+        except (BrokenPipeError, ConnectionResetError) as exc:
+            if self.server.outcome != 'interrupted' or kind != 'after-read':
+                self.server.errors.append(repr(exc))
+        except Exception as exc:
+            self.server.errors.append(repr(exc))
+            self.send_error(500)
+        finally:
+            if self.path == '/v1/chat/completions' and kind == 'after-read':
+                self.server.reply_done.set()
+
+
+def _rows(home, sql, args=()):
+    with sqlite3.connect((home / 'state.db').as_uri() + '?mode=ro', uri=True) as db:
+        db.row_factory = sqlite3.Row
+        return [dict(row) for row in db.execute(sql, args)]
+
+
+@pytest.mark.parametrize('outcome', ['completed', 'failed', 'interrupted'])
+def test_native_worker_settlement_becomes_its_bot_chat_report(tmp_path, monkeypatch, outcome):
+    home, user = tmp_path / 'state', tmp_path / 'user'
+    home.mkdir(mode=0o700)
+    user.mkdir()
+    monkeypatch.setenv('HOME', str(user))
+    monkeypatch.setenv('USERPROFILE', str(user))
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setattr(Path, 'home', lambda: user)
+    import hermes_state
+    # Restore dynamic profile resolution after conftest pins the per-test default.
+    monkeypatch.setattr(hermes_state, 'DEFAULT_DB_PATH', hermes_state._IMPORT_DEFAULT_DB_PATH)
+    monkeypatch.setenv('PATH', str(Path(sys.executable).parent) + os.pathsep + os.environ.get('PATH', ''))
+    path = tmp_path / 'native-file.txt'
+    path.write_text('MONITOR_NATIVE_FILE_CONTENT\n')
+    peer = ThreadingHTTPServer(('127.0.0.1', 0), _Model)
+    peer.path, peer.calls, peer.errors, peer.outcome = path, [], [], outcome
+    peer.reply_done = threading.Event()
+    peer.lock, peer.read_done, peer.release = threading.Lock(), threading.Event(), threading.Event()
+    thread = threading.Thread(target=peer.serve_forever, daemon=True)
+    thread.start()
+    url = f'http://127.0.0.1:{peer.server_port}/v1'
+    config = {'gateway': {'multiplex_profiles': True},
+              'model': {'provider': 'custom', 'default': 'loopback-fixture', 'base_url': url},
+              'auxiliary': {'title_generation': {'enabled': False}},
+              'platform_toolsets': {'cli': ['delegation', 'file'], 'local': ['delegation', 'file'],
+                                    'desktop': ['delegation', 'file']},
+              'delegation': {'max_concurrent_children': 1, 'max_spawn_depth': 1, 'orchestrator_enabled': False},
+              'telemetry': {'shared_metrics': {'enabled': False, 'send': False, 'offer_version': 2}}}
+    (home / 'config.yaml').write_text(json.dumps(config))
+    baseline = (home / 'config.yaml').read_bytes()
+    other = home / 'profiles/helper'
+    other.mkdir(parents=True)
+    (other / 'config.yaml').write_text(json.dumps(config))
+    monkeypatch.setenv('OPENAI_API_KEY', 'loopback-only')
+    monkeypatch.setenv('OPENAI_BASE_URL', url)
+
+    async def probe(desc):
+        grant = await asyncio.to_thread(control, home, 'session-ticket', {
+            'profile_id': str(home), 'instance_id': desc['instance_id'], 'purpose': 'interactive', 'scope': 'host'})
+        async with connect(desc['api_origin'].replace('http:', 'ws:') + '/api/ws', subprotocols=[
+                'hermes-gateway-v1', 'hermes-gateway-ticket.' + grant['ticket']]) as ws:
+            async def result(method, **params):
+                reply = await rpc(ws, method, **params)
+                assert 'result' in reply, reply
+                return reply['result']
+
+            async def roster(profile=None):
+                rows = (await result('profiles.list', **({'profile': profile} if profile else {})))['profiles']
+                return next(row for row in rows if row['path'] == str(other if profile else home))
+
+            parent = (await result('session.create', request_id='monitor-parent', source='gui',
+                                   cwd=str(tmp_path), title='Bot Chat', hidden=True))['session_id']
+            side = (await result('session.create', request_id='monitor-side', source='gui',
+                                 cwd=str(tmp_path), title='Side chat'))['session_id']
+            foreign = (await result('session.create', profile='helper', request_id='monitor-foreign',
+                                   source='gui', cwd=str(tmp_path), title='Bot Chat', hidden=True))['session_id']
+            for sid, profile, marker in [(side, None, 'INDEPENDENT_SIDE_CHAT'), (foreign, 'helper', 'INDEPENDENT_PROFILE')]:
+                await result('prompt.submit', **({'profile': profile} if profile else {}),
+                             session_id=sid, input_id=marker, text=marker)
+                store = other if profile else home
+                await async_wait_until(lambda: any(row['content'] == marker for row in _rows(
+                    store, "SELECT content FROM messages WHERE session_id=? AND role='assistant'", (sid,))),
+                    timeout=20, what='independent control transcript persisted')
+            async with asyncio.timeout(180):
+                submitted = time.monotonic()
+                admission = await result('prompt.submit', session_id=parent, input_id='monitor-native', text='Delegate the fixture read.')
+                assert admission['status'] == 'queued'
+                assert await asyncio.to_thread(peer.read_done.wait, 30), peer.errors
+                children = _rows(home, 'SELECT * FROM sessions WHERE parent_session_id=? AND source=?', (parent, 'subagent'))
+                assert len(children) == 1
+                child = children[0]
+                assert child['ended_at'] is None and json.loads(child['model_config'])['_delegate_from'] == parent
+                active = await roster()
+                assert active['canonical_session']['id'] == parent
+                assert active['canonical_session']['delegation_reports'] == []
+                observed = next(row for row in active['worker_sessions'] if row['id'] == child['id'])
+                assert observed['iteration'] == child['api_call_count'] >= 1
+                assert side not in {row['id'] for row in active['worker_sessions']}
+                tool_rows = _rows(home, "SELECT content FROM messages WHERE session_id=? AND role='tool'", (child['id'],))
+                assert any('MONITOR_NATIVE_FILE_CONTENT' in row['content'] for row in tool_rows)
+                side_view = await result('session.resume', session_id=side)
+                assert 'INDEPENDENT_SIDE_CHAT' in json.dumps(side_view['messages'])
+                foreign_view = await result('session.resume', profile='helper', session_id=foreign)
+                assert 'INDEPENDENT_PROFILE' in json.dumps(foreign_view['messages'])
+                foreign_roster = await roster('helper')
+                assert foreign_roster['canonical_session']['id'] == foreign
+                assert foreign_roster['canonical_session']['delegation_reports'] == []
+                assert child['id'] not in {row['id'] for row in foreign_roster['worker_sessions']}
+                first = child['last_activity_at'] or 0
+                pulse = {'last_activity_at': first}
+                cancellation = None
+                if outcome == 'completed':
+                    await async_wait_until(lambda: (_rows(home, 'SELECT last_activity_at FROM sessions WHERE id=?', (child['id'],))[0]['last_activity_at'] or 0) > first,
+                                           timeout=85, interval=.2, what='native child heartbeat advances')
+                    pulse = _rows(home, 'SELECT last_activity_at,ended_at FROM sessions WHERE id=?', (child['id'],))[0]
+                    assert pulse['ended_at'] is None
+                if outcome == 'interrupted':
+                    listing = await result('subagent.list', session_id=parent)
+                    target, = listing['subagents']
+                    running, = _rows(home, 'SELECT delegation_id FROM async_delegations WHERE parent_session_id=?', (parent,))
+                    assert target['delegation_id'] == running['delegation_id']
+                    assert target['status'] == 'running'
+                    cancellation = await result('subagent.interrupt', session_id=parent, subagent_id=target['subagent_id'])
+                    assert cancellation == {'found': True, 'subagent_id': target['subagent_id']}
+                    await async_wait_until(lambda: _rows(home, 'SELECT ended_at FROM sessions WHERE id=?',
+                                                       (child['id'],))[0]['ended_at'] is not None,
+                                           timeout=20, what='interrupted child ends before stale reply release')
+                    stopped = _rows(home, 'SELECT ended_at,api_call_count FROM sessions WHERE id=?', (child['id'],))[0]
+                peer.release.set()
+
+                def settled():
+                    rows = _rows(home, 'SELECT * FROM async_delegations WHERE parent_session_id=?', (parent,))
+                    return rows and rows[0]['state'] == ('completed' if outcome == 'completed' else 'error') and rows[0]['completed_at'] is not None and rows[0]
+
+                ledger = await async_wait_until(settled, timeout=30, what='native delegation terminal ledger')
+                batch = json.loads(ledger['result_json'])['results']
+                assert len(batch) == 1 and batch[0]['task_index'] == 0 and batch[0]['status'] == outcome
+                assert batch[0]['exit_reason'] == ('error' if outcome == 'failed' else outcome)
+                assert not batch[0]['truncated']
+                if outcome == 'completed':
+                    assert batch[0]['summary'] == 'MONITOR_WORKER_DONE'
+                elif outcome == 'failed':
+                    assert 'MONITOR_NATIVE_REJECTION' in batch[0]['error']
+                else:
+                    assert 'MONITOR_WORKER_DONE' not in (batch[0]['summary'] or '')
+                    assert await asyncio.to_thread(peer.reply_done.wait, 5)
+                    assert _rows(home, 'SELECT ended_at,api_call_count FROM sessions WHERE id=?', (child['id'],))[0] == stopped
+                    assert not any(row['content'] == 'MONITOR_WORKER_DONE' for row in _rows(
+                        home, "SELECT content FROM messages WHERE session_id=? AND role='assistant'", (child['id'],)))
+                assert _rows(home, 'SELECT ended_at FROM sessions WHERE id=?', (child['id'],))[0]['ended_at'] is not None
+                await async_wait_until(lambda: any(row['content'] == 'MONITOR_PARENT_' + outcome.upper() for row in _rows(
+                    home, "SELECT content FROM messages WHERE session_id=? AND role='assistant'", (parent,))),
+                    timeout=20, what='native parent completion persisted')
+                await async_wait_until(lambda: _rows(home, 'SELECT delivery_state FROM async_delegations WHERE delegation_id=?',
+                                                      (ledger['delegation_id'],))[0]['delivery_state'] == 'delivered',
+                                       timeout=20, what='native completion delivery accounted')
+                def parent_settled():
+                    rows = _rows(home, 'SELECT status FROM session_admissions WHERE target_session_id=?', (parent,))
+                    return rows and all(row['status'] == 'terminal' for row in rows)
+
+                await async_wait_until(parent_settled, timeout=20, what='parent admissions terminal before usage snapshot')
+                terminal = await roster()
+                current = next(row for row in terminal['worker_sessions'] if row['id'] == child['id'])
+                assert current['ended_at'] is not None
+                report, = terminal['canonical_session']['delegation_reports']
+                assert report['delegation_id'] == ledger['delegation_id'] and report['task_index'] == 0
+                assert report['status'] == ('error' if outcome == 'failed' else outcome) and report['summary'] == batch[0]['summary']
+                assert report['error'] == (batch[0].get('error') or '')
+                assert report['completed_at'] == ledger['completed_at']
+                assert terminal['canonical_session']['id'] == parent != side != foreign
+                stored_parent = _rows(home, 'SELECT input_tokens,output_tokens FROM sessions WHERE id=?', (parent,))[0]
+                assert terminal['canonical_session']['input_tokens'] == stored_parent['input_tokens']
+                assert terminal['canonical_session']['output_tokens'] == stored_parent['output_tokens']
