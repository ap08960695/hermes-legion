+"""A native install fixture must include its selected patch commit in a shallow checkout."""
+from tests.e2e.core.upgrade import _helpers as H
+from tests.e2e.core.upgrade import _install_helpers as I
+
+
+def test_origin_includes_a_private_patch_commit_from_a_shallow_source(tmp_path, monkeypatch):
+    monkeypatch.setenv('GIT_CONFIG_GLOBAL', str(tmp_path / 'gitconfig'))
+    monkeypatch.setenv('GIT_CONFIG_NOSYSTEM', '1')
+    original = tmp_path / 'original'
+    original.mkdir()
+    I.git('init', '-q', '-b', 'main', cwd=original)
+    (original / 'source.py').write_text('VALUE = 1\n')
+    I.git('add', 'source.py', cwd=original)
+    I.git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
+          '-c', 'commit.gpgsign=false', 'commit', '-qm', 'base', cwd=original)
+    source = tmp_path / 'shallow'
+    I.git('clone', '-q', '--depth=1', original.as_uri(), str(source), cwd=tmp_path)
+    assert I.git('rev-parse', '--is-shallow-repository', cwd=source) == 'true'
+    base = I.git('rev-parse', 'HEAD', cwd=source)
+    tree = I.git('rev-parse', 'HEAD^{tree}', cwd=source)
+    selected = I.git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.invalid',
+                     'commit-tree', tree, '-p', base, '-m', 'selected private fixture', cwd=source)
+    monkeypatch.setattr(H, 'WORKTREE', source)
+    world = tmp_path / 'world'
+    world.mkdir()
+    origin = I.make_origin(world, selected)
+    assert I.git('rev-parse', 'main', cwd=origin) == selected
+    assert I.git('show', 'main:source.py', cwd=origin) == 'VALUE = 1'
+    assert I.git('rev-parse', 'HEAD', cwd=source) == base
