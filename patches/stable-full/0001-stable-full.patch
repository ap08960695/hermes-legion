+"""Gateway dashboard warmup is optional; lazy mounting and lifecycle remain native."""
+import asyncio
+import argparse
+import contextlib
+import io
+import json
+from pathlib import Path
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest.mock import AsyncMock, patch
+
+from gateway.config import GatewayConfig
+from gateway.run_api import GatewayDashboardMount, start_gateway_api, stop_gateway_api, warm_gateway_dashboard
+
+
+class DashboardWarmupSchedulingTests(unittest.IsolatedAsyncioTestCase):
+    async def test_disabled_policy_does_not_schedule_mount(self):
+        runner = SimpleNamespace(config=SimpleNamespace(dashboard_warmup=False))
+        mount = GatewayDashboardMount(runner, SimpleNamespace())
+        mount.ensure = AsyncMock()
+        runner.session_api = SimpleNamespace(app=mount)
+        warm_gateway_dashboard(runner)
+        task = getattr(runner, '_gateway_dashboard_warmup', None)
+        if task is not None:
+            await task
+        self.assertIsNone(task)
+        mount.ensure.assert_not_awaited()
+
+    async def test_default_policy_schedules_existing_mount(self):
+        runner = SimpleNamespace()
+        mount = GatewayDashboardMount(runner, SimpleNamespace())
+        mount.ensure = AsyncMock()
+        runner.session_api = SimpleNamespace(app=mount)
+        warm_gateway_dashboard(runner)
+        await runner._gateway_dashboard_warmup
+        mount.ensure.assert_awaited_once()
+
+    async def test_invalid_injected_policy_does_not_opt_out(self):
+        runner = SimpleNamespace(config=SimpleNamespace(dashboard_warmup=None))
+        mount = GatewayDashboardMount(runner, SimpleNamespace())
+        mount.ensure = AsyncMock()
+        runner.session_api = SimpleNamespace(app=mount)
+        warm_gateway_dashboard(runner)
+        await runner._gateway_dashboard_warmup
+        mount.ensure.assert_awaited_once()
+
+
+class DashboardWarmupConfigTests(unittest.TestCase):
+    def test_missing_invalid_and_recognized_values(self):
+        for value in (None, '', 'invalid', [], {}, 2, float('inf')):
+            with self.subTest(value=value):
+                self.assertTrue(GatewayConfig.from_dict({'gateway': {'dashboard_warmup': value}}).dashboard_warmup)
+        self.assertTrue(GatewayConfig.from_dict({}).dashboard_warmup)
+        for value in (False, 'false', 'off', 0):
+            with self.subTest(value=value):
+                config = GatewayConfig.from_dict({'gateway': {'dashboard_warmup': value}})
+                self.assertFalse(config.dashboard_warmup)
+                self.assertFalse(GatewayConfig.from_dict(config.to_dict()).dashboard_warmup)
+        self.assertTrue(GatewayConfig.from_dict({'dashboard_warmup': True,
+                                               'gateway': {'dashboard_warmup': False}}).dashboard_warmup)
+
+    def test_native_cli_sets_one_key_without_replacing_profile(self):
+        from hermes_cli.config import DEFAULT_CONFIG, config_command, read_user_config_raw
+        from hermes_cli.subcommands.config import build_config_parser
+        from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+        self.assertTrue(DEFAULT_CONFIG['gateway']['dashboard_warmup'])
+        with tempfile.TemporaryDirectory() as directory:
+            home = Path(directory)
+            original = {'model': {'default': 'synthetic', 'provider': 'custom'},
+                        'credential_pool': {'synthetic': []}, 'fallback_model': [],
+                        'gateway': {'multiplex_profiles': False}, 'unrelated': {'preserve': True}}
+            path = home / 'config.yaml'
+            path.write_text(json.dumps(original) + '\n')
+            backup = path.read_bytes()
+            token = set_hermes_home_override(home)
+            try:
+                parser = argparse.ArgumentParser()
+                build_config_parser(parser.add_subparsers(), cmd_config=config_command)
+                with contextlib.redirect_stdout(io.StringIO()):
+                    args = parser.parse_args(['config', 'set', 'gateway.dashboard_warmup', 'false'])
+                    args.func(args)
+                output = io.StringIO()
+                with contextlib.redirect_stdout(output):
+                    args = parser.parse_args(['config', 'get', 'gateway.dashboard_warmup', '--json'])
+                    args.func(args)
+                self.assertIs(json.loads(output.getvalue()), False)
+                expected = {**original, 'gateway': {**original['gateway'], 'dashboard_warmup': False}}
+                self.assertEqual(read_user_config_raw(path), expected)
+                self.assertFalse(GatewayConfig.from_dict(read_user_config_raw(path)).dashboard_warmup)
+                from gateway.config import load_gateway_config
+                self.assertFalse(load_gateway_config().dashboard_warmup)
+            finally:
+                reset_hermes_home_override(token)
+            self.assertEqual(json.loads(backup), original)
+
