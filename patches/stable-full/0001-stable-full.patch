@@ -0,0 +1,48 @@
+import { expect, it } from 'vitest'
+import { parseAnswerCards } from './answer-cards'
+it('keeps only authored values and safe links without inventing prices or fetching metadata', () => {
+  const cards = parseAnswerCards(
+    JSON.stringify({
+      cards: [
+        {
+          title: 'Example computer',
+          price: '100 units',
+          description: 'Supplied description',
+          images: ['https://example.com/image.png', 'javascript:bad()'],
+          sources: [
+            { title: 'Example store', url: 'https://example.com/item' },
+            { title: 'bad', url: 'javascript:bad()' }
+          ]
+        },
+        { title: 'No price' }
+      ]
+    })
+  )
+  expect(cards[0].price).toBe('100 units')
+  expect(cards[0].images).toHaveLength(1)
+  expect(cards[0].sources).toHaveLength(1)
+  expect(cards[1].price).toBeUndefined()
+})
+it('refuses malformed or oversized payloads and bounds item and image counts', () => {
+  expect(parseAnswerCards('partial')).toEqual([])
+  expect(parseAnswerCards('x'.repeat(256001))).toEqual([])
+  const cards = parseAnswerCards(
+    JSON.stringify({
+      cards: Array.from({ length: 50 }, () => ({ title: 'Example', images: Array(30).fill('https://example.com/img') }))
+    })
+  )
+  expect(cards).toHaveLength(16)
+  expect(cards[0].images).toHaveLength(6)
+})
+
+it('extracts an authored Mermaid fence while retaining the description and plain cards', () => {
+  const description = 'Review workflow\n\n```mermaid\nflowchart LR\n A --> B\n```\n\nTwo stages.'
+  const cards = parseAnswerCards(
+    JSON.stringify({ cards: [{ title: 'Review', description }, { title: 'Plain', description: 'Literal text.' }] })
+  )
+
+  expect(cards[0]?.description).toMatch(/^Review workflow\s+Two stages\.$/)
+  expect(cards[0]?.mermaid).toBe('flowchart LR\n A --> B')
+  expect(cards[1]?.description).toBe('Literal text.')
+  expect(cards[1]?.mermaid).toBeUndefined()
+})
diff --git a/apps/desktop/src/lib/answer-cards.ts b/apps/desktop/src/lib/answer-cards.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a9a7df76dad5d3aa56509b43eea072ec73d7dd90
--- /dev/null
+++ b/apps/desktop/src/lib/answer-cards.ts
@@ -0,0 +1,66 @@
+/** Explicit, bounded presentation data. No inferred facts, network calls or HTML. */
+export interface AnswerCard {
+  title: string
+  price?: string
+  description?: string
+  mermaid?: string
+  images: string[]
+  sources: { title: string; url: string }[]
+  facts: string[]
+}
+const text = (value: unknown, max = 600) =>
+  typeof value === 'string' ? value.trim().slice(0, max) || undefined : undefined
+function url(value: unknown, image = false): string | undefined {
+  const raw = text(value, 4096)
+  if (!raw) return
+  if (image && /^data:image\/(?:png|jpeg|webp|gif);base64,[a-z0-9+/=]+$/i.test(raw)) return raw
+  try {
+    const parsed = new URL(raw)
+    if (['https:', 'http:'].includes(parsed.protocol) && !parsed.username && !parsed.password) return parsed.href
+  } catch {
+    /* Invalid model-authored URLs stay inert. */
+  }
+}
+const MERMAID_FENCE = /(?:^|\r?\n)[ \t]*```mermaid[ \t]*\r?\n([\s\S]*?)\r?\n[ \t]*```[ \t]*(?=\r?\n|$)/i
+
+function card(raw: unknown): AnswerCard[] {
+  if (!raw || typeof raw !== 'object') return []
+  const value = raw as Record<string, unknown>,
+    title = text(value.title)
+  if (!title) return []
+  const description = typeof value.description === 'string' ? value.description : ''
+  const fence = MERMAID_FENCE.exec(description)
+  const mermaid = typeof value.mermaid === 'string' && value.mermaid.trim() ? value.mermaid : fence?.[1]
+  return [
+    {
+      title,
+      price: text(value.price),
+      description: text(description.replace(MERMAID_FENCE, '\n')),
+      ...(mermaid ? { mermaid } : {}),
+      images: (Array.isArray(value.images) ? value.images : [])
+        .slice(0, 6)
+        .map(x => url(x, true))
+        .filter((x): x is string => Boolean(x)),
+      facts: (Array.isArray(value.facts) ? value.facts : [])
+        .slice(0, 12)
+        .map(x => text(x, 120))
+        .filter((x): x is string => Boolean(x)),
+      sources: (Array.isArray(value.sources) ? value.sources : []).slice(0, 8).flatMap(source => {
+        if (!source || typeof source !== 'object') return []
+        const link = source as Record<string, unknown>,
+          target = url(link.url)
+        return target ? [{ url: target, title: text(link.title, 120) || new URL(target).hostname }] : []
+      })
+    }
+  ]
+}
+export function parseAnswerCards(code: string): AnswerCard[] {
+  if (code.length > 256000) return []
+  try {
+    const value = JSON.parse(code)
+    const rows = Array.isArray(value) ? value : Array.isArray(value?.cards) ? value.cards : []
+    return rows.slice(0, 16).flatMap(card)
+  } catch {
+    return []
+  }
+}
