+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { MemoryRouter, useNavigate } from 'react-router'
+import { afterEach, expect, it } from 'vitest'
+import { useHistorySearch } from './use-history-search'
+function Search() {
+  const x = useHistorySearch()
+  return (
+    <input
+      aria-label="Search"
+      ref={x.searchInputRef}
+      value={x.searchQuery}
+      onChange={e => x.setSearchQuery(e.target.value)}
+    />
+  )
+}
+afterEach(cleanup)
+it('seeds a routed query once and leaves subsequent edits to the user', () => {
+  render(
+    <MemoryRouter initialEntries={['/history?search=Older%20notebook']}>
+      <Search />
+    </MemoryRouter>
+  )
+  const field = screen.getByLabelText('Search') as HTMLInputElement
+  expect(field.value).toBe('Older notebook')
+  fireEvent.change(field, { target: { value: '' } })
+  expect(field.value).toBe('')
+})
+it('reapplies the same History query on a fresh handoff after a local edit', () => {
+  function Handoff() {
+    const navigate = useNavigate()
+    return <button type="button" onClick={() => navigate('/history?search=Older%20notebook')}>Search all saved chats</button>
+  }
+
+  render(
+    <MemoryRouter initialEntries={['/history?search=Older%20notebook']}>
+      <Search />
+      <Handoff />
+    </MemoryRouter>
+  )
+  const field = screen.getByLabelText<HTMLInputElement>('Search')
+  const handoff = screen.getByRole('button', { name: 'Search all saved chats' })
+  fireEvent.change(field, { target: { value: 'Edited query' } })
+  handoff.focus()
+  fireEvent.click(handoff)
+  expect(field.value).toBe('Older notebook')
+  expect(document.activeElement).toBe(field)
+})
+
+it('never consumes a history query on an unrelated page', () => {
+  render(
+    <MemoryRouter initialEntries={['/bots?search=Other']}>
+      <Search />
+    </MemoryRouter>
+  )
+  expect((screen.getByLabelText('Search') as HTMLInputElement).value).toBe('')
+})
+
+it('restores the filter for the History entry reached by Back and Forward', () => {
+  function Navigation() {
+    const navigate = useNavigate()
+
+    return (
+      <>
+        <button type="button" onClick={() => navigate('/history?search=Older%20notebook')}>Search all saved chats</button>
+        <button type="button" onClick={() => navigate(-1)}>Back</button>
+        <button type="button" onClick={() => navigate(1)}>Forward</button>
+      </>
+    )
+  }
+
+  render(
+    <MemoryRouter initialEntries={['/history']}>
+      <Search />
+      <Navigation />
+    </MemoryRouter>
+  )
+  const field = screen.getByLabelText<HTMLInputElement>('Search')
+  const back = screen.getByRole('button', { name: 'Back' })
+
+  expect(field.value).toBe('')
+  fireEvent.click(screen.getByRole('button', { name: 'Search all saved chats' }))
+  expect(field.value).toBe('Older notebook')
+  expect(document.activeElement).toBe(field)
+
+  fireEvent.change(field, { target: { value: 'Adjusted query' } })
+  expect(field.value).toBe('Adjusted query')
+  back.focus()
+  fireEvent.click(back)
+  expect(field.value).toBe('')
+  expect(document.activeElement).toBe(back)
+
+  fireEvent.click(screen.getByRole('button', { name: 'Forward' }))
+  expect(field.value).toBe('Older notebook')
+  expect(document.activeElement).toBe(field)
+})
