+    expect($sessionTiles.get()).toEqual([tile])
+  })
+
+  it('preserves legacy profile-only ownership when opening separately', async () => {
+    setApiRequestConnection(null)
+    const tile = { storedSessionId: 'shared-history', runtimeId: 'legacy-original', ownerProfile: 'default' }
