+def test_live_compression_tip_does_not_hydrate_context(tmp_path, monkeypatch, read_only, ended_at):
+    """The liveness gate needs only metadata, including on a read-only store."""
+    import sqlite3
+
+    path = tmp_path / "tip.db"
+    with SessionDB(path) as setup:
+        setup.create_session("parent", source="telegram")
+        setup.end_session("parent", "compression")
+        setup.create_session("tip", source="telegram", parent_session_id="parent",
+                             system_prompt="Synthetic context. " * 32768)
+        setup.update_session_tool_names("tip", ["synthetic_tool_" + "x" * 1024])
+        setup.patch_session_model_config("tip", {"synthetic": "y" * 131072})
+        if ended_at is not None:
+            setup._write_sql("UPDATE sessions SET ended_at = ? WHERE id = ?", (ended_at, "tip"))
+    before = path.read_bytes()
+    with SessionDB(path, read_only=read_only) as db:
+        assert db.get_compression_tip("parent") == "tip"
+        # Lineage legitimately reads JSON configuration; isolate only that unchanged resolver.
+        monkeypatch.setattr(db, "get_compression_tip", lambda sid: "tip")
+        store = object.__new__(SessionStore)
+        store._db = db
+        store._entries = {}
+        denied = []
+
+        def authorize(action, table, column, *_):
+            if action == sqlite3.SQLITE_READ and (
+                table == "system_prompts" and column == "prompt"
+                or table == "sessions" and column in {"system_prompt", "tool_names", "model_config"}
+            ):
+                denied.append((table, column))
+                return sqlite3.SQLITE_DENY
+            return sqlite3.SQLITE_OK
+
+        with db._read_ctx() as connection:
+            connection.set_authorizer(authorize)
+        try:
+            assert store._live_compression_child("parent") == ("tip" if ended_at is None else "")
+            assert denied == []
+            # A control proves the real full reader is still blocked by the same authorizer.
+            with pytest.raises(sqlite3.DatabaseError):
+                db.get_session("tip")
+            assert denied
+        finally:
+            with db._read_ctx() as connection:
+                connection.set_authorizer(None)
+    assert path.read_bytes() == before
+
