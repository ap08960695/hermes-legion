+def test_separate_processes_share_the_admission_lock(board):
+    kb.create_board('other')
+    with kbc.connect_closing() as conn:
+        first_id = kb.create_task(conn, title='first', assignee='alice')
+    with kbc.connect_closing(board='other') as conn:
+        kb.create_task(conn, title='second', assignee='bob')
+    ctx = multiprocessing.get_context('spawn')
+    entered, release, queue = ctx.Event(), ctx.Event(), ctx.Queue()
+    first = ctx.Process(target=_process_tick, args=('default', first_id, entered, release, queue))
+    second = ctx.Process(target=_process_tick, args=('other', first_id, entered, release, queue))
+    try:
+        first.start()
+        assert entered.wait(timeout=10)
+        second.start()
+        second.join(timeout=10)
+        assert not second.is_alive() and second.exitcode == 0
+        release.set()
+        first.join(timeout=10)
+        assert not first.is_alive() and first.exitcode == 0
+        results = [queue.get(timeout=2), queue.get(timeout=2)]
+        assert all(row[0] == 'ok' for row in results), results
+        assert sum(row[1] for row in results) == 1
+        assert sum(row[2] for row in results) == 1
+    finally:
+        release.set()
+        for child in (first, second):
+            if child.is_alive():
+                child.terminate()
+                child.join(timeout=5)
+        queue.close()
+
