+"""Tool progress snapshots should not repeatedly feed unchanged logs to the model."""
+import json
+import time
+
+import pytest
+
+from tools import process_registry as pr
+
+
+@pytest.fixture
+def progress(monkeypatch):
+    reg = pr.ProcessRegistry()
+    session = pr.ProcessSession(id='proc_usage', command='long-job', task_id='owner',
+                                started_at=time.time(), notify_on_complete=True)
+    reg._running[session.id] = session
+    monkeypatch.setattr(pr, 'process_registry', reg)
+    return reg, session
+
+
+def call(session, action='poll', owner='owner', conversation='conversation', **args):
+    return json.loads(pr._handle_process({'action': action, 'session_id': session.id, **args}, task_id=owner, session_id=conversation))
+
+
+def test_unchanged_tool_progress_is_compact_but_log_and_completion_remain(progress):
+    reg, session = progress
+    session.append_output('progress detail\n' * 100)
+    first = call(session)
+    second = call(session)
+    assert len(first['output_preview']) == 1000
+    assert second['output_preview'] == ''
+    assert second['output_unchanged'] is True
+    assert second['status'] == 'running'
+    assert not reg.is_completion_consumed(session.id)
+    assert call(session, 'log')['output'].endswith('progress detail')
+    session.mark_exited(7)
+    finished = call(session, 'wait', timeout=1)
+    assert finished['exit_code'] == 7
+    assert 'progress detail' in finished['output']
+    assert 'output_unchanged' not in finished
+
+
+def test_display_reads_and_other_callers_do_not_lose_preview(progress):
+    reg, session = progress
+    session.append_output('ready\n')
+    assert reg.poll(session.id)['output_preview'] == 'ready\n'
+    assert call(session)['output_preview'] == 'ready\n'
+    assert call(session)['output_preview'] == ''
+    assert reg.poll(session.id)['output_preview'] == 'ready\n'
+    assert call(session, owner='new-owner')['output_preview'] == 'ready\n'
+    assert call(session, owner=None)['output_preview'] == 'ready\n'
+
+
+def test_new_bytes_with_identical_tail_are_not_suppressed(progress):
+    _, session = progress
+    session.append_output('x' * 1000)
+    assert call(session)['output_preview'] == 'x' * 1000
+    assert call(session)['output_preview'] == ''
+    session.append_output('x')
+    assert call(session)['output_preview'] == 'x' * 1000
+
+
+def test_wait_timeout_shares_tool_progress_but_keeps_notification(progress):
+    reg, session = progress
+    session.append_output('waiting for child\n')
+    assert call(session)['output_preview']
+    result = call(session, 'wait', timeout=1)
+    assert result['status'] == 'timeout'
+    assert result['process_running'] is True
+    assert result['output'] == ''
+    assert result['output_unchanged'] is True
+    assert session.notify_on_complete
+    assert not reg.is_completion_consumed(session.id)
+    assert reg.completion_queue.empty()
+
+
+def test_zero_output_is_not_labelled_as_previously_seen(progress):
+    _, session = progress
+    assert 'output_unchanged' not in call(session)
+
+
+def test_poll_payload_reduction_is_measured_without_model_calls(progress):
+    _, session = progress
+    session.append_output('0123456789' * 100)
+    snapshots = [call(session) for _ in range(12)]
+    sent = sum(len(json.dumps(r, ensure_ascii=False)) for r in snapshots)
+    baseline = sum(len(json.dumps({k: v for k, v in dict(r, output_preview='0123456789' * 100).items()
+                                  if k != 'output_unchanged'}, ensure_ascii=False)) for r in snapshots)
+    print(f'PROGRESS_PAYLOAD baseline_chars={baseline} candidate_chars={sent} reduction={1-sent/baseline:.3%}')
+    assert sent < baseline * 0.30
+
+
+def test_new_conversation_after_compression_gets_full_preview(progress):
+    _, session = progress
+    session.append_output('retained log\n')
+    assert call(session)['output_preview']
+    assert call(session)['output_preview'] == ''
+    assert call(session, conversation='compressed-conversation')['output_preview'] == 'retained log\n'
+    assert call(session, conversation=None)['output_preview'] == 'retained log\n'
+
+
+def test_completion_instruction_is_not_repeated_for_unchanged_progress(progress):
+    _, session = progress
+    session.append_output('waiting for the same job')
+    snapshots = [call(session) for _ in range(8)]
+    notes = [r['note'] for r in snapshots if r.get('note')]
+    assert len(notes) == 1
+    assert snapshots[-1]['notify_on_complete'] is True
+    assert snapshots[-1]['output_unchanged'] is True
