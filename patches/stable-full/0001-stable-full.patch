@@ -0,0 +1,68 @@
+"""A bounded call can opt out of the extra client-rebuild attempt without changing defaults."""
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from agent.agent_init import _apply_agent_section
+from agent.agent_runtime_helpers import try_recover_primary_transport
+from hermes_cli.config import atomic_config_replace, load_config_readonly
+
+
+def configured_agent(home, settings):
+    atomic_config_replace(home / 'config.yaml', {'agent': {'environment_probe': False, **settings}})
+    agent = SimpleNamespace(run_budget_seconds=None)
+    _apply_agent_section(agent, load_config_readonly())
+    return agent
+
+
+def test_profile_opt_out_prevents_rebuild_and_wait(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    agent = configured_agent(tmp_path, {'primary_transport_recovery': False})
+    error = type('APIConnectionError', (Exception,), {})('connection lost')
+    with patch('agent.agent_runtime_helpers._rebuild_primary_client') as rebuild, \
+            patch('agent.agent_runtime_helpers.time.sleep') as wait:
+        assert try_recover_primary_transport(agent, error, retry_count=1, max_retries=1) is False
+    rebuild.assert_not_called()
+    wait.assert_not_called()
+
+
+def test_default_retains_the_existing_transport_recovery(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    agent = configured_agent(tmp_path, {})
+    agent._fallback_activated = False
+    agent.provider = 'custom'
+    agent._is_openrouter_url = lambda: False
+    agent._primary_runtime = {}
+    agent._vprint = lambda *_a, **_kw: None
+    agent.log_prefix = ''
+    error = type('APIConnectionError', (Exception,), {})('connection lost')
+    with patch('agent.agent_runtime_helpers._apply_primary_runtime_fields'), \
+            patch('agent.agent_runtime_helpers._rebuild_primary_client') as rebuild, \
+            patch('agent.agent_runtime_helpers.time.sleep') as wait:
+        assert try_recover_primary_transport(agent, error, retry_count=1, max_retries=1) is True
+    rebuild.assert_called_once()
+    wait.assert_called_once()
+
+
+def test_recovery_setting_is_profile_scoped(tmp_path, monkeypatch):
+    first, second = tmp_path / 'first', tmp_path / 'second'
+    first.mkdir()
+    second.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(first))
+    one = configured_agent(first, {'primary_transport_recovery': False})
+    monkeypatch.setenv('HERMES_HOME', str(second))
+    two = configured_agent(second, {'primary_transport_recovery': True})
+    assert one._primary_transport_recovery is False
+    assert two._primary_transport_recovery is True
+
+
+def test_kanban_can_disable_its_separate_in_place_turn_recovery(tmp_path, monkeypatch):
+    from agent.kanban_turn_recovery import max_recovery_attempts, should_recover_turn
+
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.delenv('HERMES_KANBAN_TURN_RECOVERY', raising=False)
+    atomic_config_replace(tmp_path / 'config.yaml', {'kanban': {'turn_recovery_attempts': 0}})
+    assert max_recovery_attempts() == 0
+    assert should_recover_turn({'failed': True, 'failure_retryable': True, 'failure_reason': 'timeout'},
+                               attempt=0, task_id='t_synthetic') is False
+    monkeypatch.setenv('HERMES_KANBAN_TURN_RECOVERY', '2')
+    assert max_recovery_attempts() == 2
