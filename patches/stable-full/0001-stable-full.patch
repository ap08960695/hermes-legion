diff --git a/hermes_cli/continuation_state.py b/hermes_cli/continuation_state.py
new file mode 100644
index 0000000000000000000000000000000000000000..4e79b5fc30dad6fbb4af84d6a2cf0944a80ecb9b
--- /dev/null
+++ b/hermes_cli/continuation_state.py
@@ -0,0 +1,37 @@
+"""Atomic transfer of existing per-session controls at a compression boundary."""
+
+import json
+import logging
+
+logger = logging.getLogger(__name__)
+
+
+def migrate_control_state(prefix, old_session_id, new_session_id, parse_state, get_db):
+    """Commit the child copy and parent archive together; unproven writes return False."""
+    if not old_session_id or not new_session_id or old_session_id == new_session_id:
+        return False
+    old_key, new_key = prefix + old_session_id, prefix + new_session_id
+
+    def transfer(conn):
+        row = conn.execute('SELECT value FROM state_meta WHERE key=?', (old_key,)).fetchone()
+        if row is None or conn.execute('SELECT 1 FROM state_meta WHERE key=?', (new_key,)).fetchone():
+            return False
+        raw = row[0]
+        state = parse_state(raw)
+        if state.status not in {'active', 'paused', 'done'}:
+            return False
+        archived = json.loads(raw)
+        archived['status'] = 'cleared'
+        # BEGIN IMMEDIATE, rollback, identity fences and bounded retries belong to SessionDB.
+        # Preserve unknown fields and the exact child value rather than normalizing a checkpoint.
+        conn.execute('INSERT INTO state_meta(key,value) VALUES(?,?)', (new_key, raw))
+        conn.execute('UPDATE state_meta SET value=? WHERE key=?',
+                     (json.dumps(archived, ensure_ascii=False), old_key))
+        return True
+
+    try:
+        db = get_db()
+        return db._execute_write(transfer) if db is not None else False
+    except Exception as exc:
+        logger.debug('Continuation %s migration not confirmed: %s', prefix, exc)
+        return False
diff --git a/hermes_cli/goal_self.py b/hermes_cli/goal_self.py
new file mode 100644
index 0000000000000000000000000000000000000000..e7be6d1c50f59f85be6c89a3bfc765e0fd326edb
--- /dev/null
+++ b/hermes_cli/goal_self.py
@@ -0,0 +1,157 @@
+"""Opt-in current-session goal setup through the existing native goal store."""
+
+import argparse
+from contextlib import closing
+import json
+import os
+import sqlite3
+import sys
+import time
+
+_MAX_GOAL_CHARS = 16_384
+
+
+def _context():
+    from gateway.session_context import get_session_env
+    from hermes_constants import get_hermes_home
+
+    session_id = get_session_env('HERMES_SESSION_ID')
+    if not isinstance(session_id, str) or not session_id.strip():
+        raise ValueError('An existing bound Hermes session is required; use /goal in that session.')
+    path = get_hermes_home() / 'state.db'
+    if not path.is_file():
+        raise ValueError('An existing session database is required; no home was initialized.')
+    return session_id.strip(), path
+
+
+def _state(raw):
+    if raw is None:
+        return None
+    from hermes_cli.goals import GoalState
+    try:
+        state = GoalState.from_json(raw)
+        if not isinstance(state.goal, str) or not state.goal.strip() or state.status not in {'active', 'paused', 'done', 'cleared'}:
+            raise ValueError('invalid fields')
+        return state
+    except (ValueError, TypeError, AttributeError):
+        raise ValueError('Existing goal state is unreadable; it was not replaced.') from None
+
+
+def _summary(session_id, state, *, include_goal=False):
+    result = {'session_id': session_id, 'goal_present': state is not None}
+    if state is not None:
+        result.update(status=state.status, turns_used=state.turns_used, max_turns=state.max_turns,
+                      has_contract=state.has_contract(), subgoal_count=len(state.subgoals))
+        if state.status == 'paused':
+            result['paused_reason'] = state.paused_reason
+        if include_goal:
+            result.update(goal=state.goal, contract=state.contract.to_dict(), subgoals=state.subgoals)
+    return result
+
+
+def _probe(session_id, path):
+    from hermes_state import SessionDB
+    with closing(SessionDB(path, read_only=True)) as db:
+        # Do not materialize the transcript or a large persisted system prompt.
+        row = db._read_one('SELECT id, ended_at FROM sessions WHERE id=?', (session_id,))
+        if row is None:
+            raise ValueError('The bound session does not exist in this profile.')
+        return row['ended_at'], _state(db.get_meta('goal:' + session_id))
+
+
+def inspect_current_goal(*, include_goal=False):
+    session_id, path = _context()
+    _, state = _probe(session_id, path)
+    return _summary(session_id, state, include_goal=include_goal)
+
+
+def _settings():
+    from hermes_cli.config import load_config_readonly
+    from hermes_cli.goals import DEFAULT_MAX_TURNS
+    config = (load_config_readonly() or {}).get('goals') or {}
+    if config.get('allow_self_management') is not True:
+        raise ValueError('Session self-goal management is disabled for this profile.')
+    value = config.get('max_turns', DEFAULT_MAX_TURNS) or DEFAULT_MAX_TURNS
+    if isinstance(value, bool) or not isinstance(value, (int, str)):
+        raise ValueError('Invalid configured goal turn budget.')
+    turns = int(value)
+    if turns <= 0:
+        raise ValueError('Invalid configured goal turn budget.')
+    return turns
+
+
+def ensure_current_goal(text):
+    from agent.delegation_context import is_delegated_child_process_context
+    from hermes_cli.goals import GoalState, _get_session_db, parse_contract
+
+    if os.environ.get('HERMES_KANBAN_RUN_ID') or is_delegated_child_process_context():
+        raise ValueError('A dispatched or delegated worker must keep its existing native task goal.')
+    if not isinstance(text, str) or not text.strip() or len(text) > _MAX_GOAL_CHARS:
+        raise ValueError('Supply a nonempty goal of at most 16384 characters.')
+    session_id, path = _context()
+    ended_at, _ = _probe(session_id, path)
+    if ended_at is not None:
+        raise ValueError('The bound session is closed; it was not resumed.')
+    turns = _settings()
+    headline, contract = parse_contract(text)
+    if not contract.outcome.strip() or not contract.verification.strip():
+        raise ValueError('A self-goal requires explicit outcome and verification fields.')
+    headline = headline or contract.outcome
+    db = _get_session_db()
+    if db is None or db.db_path.resolve() != path.resolve():
+        raise ValueError('The current goal store is unavailable; no goal was changed.')
+    key = 'goal:' + session_id
+    previous = db.get_meta(key)
+    state = _state(previous)
+    if state is not None and (state.status != 'done' or state.goal == headline):
+        return {**_summary(session_id, state), 'created': False}
+    candidate = GoalState(goal=headline, status='active', max_turns=turns,
+                          turns_used=0, created_at=time.time(), contract=contract)
+    encoded = candidate.to_json()
+    # One native transaction: a concurrent owner goal or closed session wins.
+    changed = db._write_rowcount(
+        'INSERT INTO state_meta(key,value) SELECT ?,? WHERE EXISTS '
+        '(SELECT 1 FROM sessions WHERE id=? AND ended_at IS NULL) '
+        'ON CONFLICT(key) DO UPDATE SET value=excluded.value WHERE state_meta.value IS ?',
+        (key, encoded, session_id, previous),
+    )
+    current_raw = db.get_meta(key)
+    current = _state(current_raw)
+    if current is None:
+        raise ValueError('Goal write outcome is unproven; inspect existing state before acting again.')
+    return {**_summary(session_id, current), 'created': bool(changed and current_raw == encoded)}
+
+
+def cmd_goal(args):
+    try:
+        if args.goal_action == 'ensure':
+            text = args.goal
+            if text is None:
+                if sys.stdin.isatty():
+                    raise ValueError('Supply goal text or pipe the contract on stdin.')
+                text = sys.stdin.read(_MAX_GOAL_CHARS + 1)
+            result = ensure_current_goal(text)
+        else:
+            result = inspect_current_goal(include_goal=args.goal_action == 'show')
+    except (OSError, ValueError, RuntimeError, sqlite3.Error) as exc:
+        print(json.dumps({'error': str(exc), 'outcome': 'unproven', 'retry_safe': False}), file=sys.stderr)
+        return 1
+    print(json.dumps(result, ensure_ascii=True))
+    return 0
+
+
+def register_goal_subparser(subparsers):
+    parser = subparsers.add_parser('goal', help='Inspect or ensure a native goal for this bound session')
+    actions = parser.add_subparsers(dest='goal_action', required=True)
+    for action in ('status', 'show'):
+        actions.add_parser(action).set_defaults(func=cmd_goal)
+    ensure = actions.add_parser('ensure', help='Create an opt-in goal without replacing current owner state')
+    ensure.add_argument('goal', nargs='?', help='Native goal/contract text; otherwise read bounded stdin')
+    ensure.set_defaults(func=cmd_goal)
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    register_goal_subparser(parser.add_subparsers(dest='command', required=True))
+    args = parser.parse_args(['goal', *sys.argv[1:]])
+    raise SystemExit(args.func(args))
