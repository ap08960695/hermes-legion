@@ -0,0 +1,154 @@
+"""New-profile disk I/O must not block served owners or outlive its custody."""
+import asyncio
+import threading
+from contextlib import contextmanager
+
+import pytest
+
+from tests.gateway.test_session_authorities_multiplex import _reserve_homes, _runner
+
+
+@contextmanager
+def _world(tmp_path, monkeypatch):
+    from gateway.runtime_ownership import process_ownership
+    root, homes = _reserve_homes(tmp_path, monkeypatch, names=('alpha',))
+    process_ownership.reserve([home for _, home in homes])
+    runner = _runner(root, homes[:1])
+    try:
+        yield runner, root, homes[1][1]
+    finally:
+        import hermes_state_registry
+        runner._shutdown_executor(drain_timeout=5)
+        runner.session_store._db_handle_cache.close_all(lambda db: db.close())
+        runner.close_all_session_db_handles()
+        hermes_state_registry.close_all_under(root)
+        for _, home in homes:
+            process_ownership.release(home)
+
+
+def _blocked_native_open(monkeypatch, target):
+    import hermes_state_registry
+    from gateway.runtime_ownership import process_ownership
+    from hermes_constants import get_hermes_home
+    native = hermes_state_registry.acquire
+    entered, release, finished = threading.Event(), threading.Event(), threading.Event()
+    rows = []
+
+    def open_store(*args, **kwargs):
+        if get_hermes_home().resolve() == target and not entered.is_set():
+            rows.append({'home': get_hermes_home().resolve(), 'thread': threading.get_ident()})
+            entered.set()
+            assert release.wait(5), 'test observer must release the native open'
+            rows[-1]['owned_at_physical_open'] = process_ownership.owns(target)
+        try:
+            return native(*args, **kwargs)
+        finally:
+            if get_hermes_home().resolve() == target:
+                finished.set()
+
+    monkeypatch.setattr(hermes_state_registry, 'acquire', open_store)
+    return entered, release, finished, rows
+
+
+@pytest.mark.asyncio
+async def test_cold_profile_open_keeps_existing_owner_readable_on_the_loop(tmp_path, monkeypatch):
+    from gateway.run_runtime import initialize_gateway_runtime, _build_profile_authority
+    with _world(tmp_path, monkeypatch) as (runner, root, target):
+        await initialize_gateway_runtime(runner)
+        entered, release, finished, rows = _blocked_native_open(monkeypatch, target)
+        loop = asyncio.get_running_loop()
+        progressed = threading.Event()
+        observations = []
+        loop_thread = threading.get_ident()
+
+        def existing_owner_read():
+            db = runner.session_authority.db
+            observations.append(db._read_one('SELECT COUNT(*) FROM sessions')[0])
+            progressed.set()
+
+        def observer():
+            assert entered.wait(5)
+            loop.call_soon_threadsafe(existing_owner_read)
+            observations.append(progressed.wait(2))
+            release.set()
+
+        watcher = threading.Thread(target=observer)
+        watcher.start()
+        try:
+            authority = await _build_profile_authority(runner, 'alpha', target, register=False)
+            assert rows[0]['thread'] != loop_thread, 'native open must not monopolize the event loop'
+            assert observations == [0, True], 'served owner must answer before the cold open is released'
+            assert authority.db.db_path.resolve().parent == target
+            assert authority.db is not runner.session_authority.db
+            assert runner.session_authorities.for_home(target) is authority
+            assert rows[0]['owned_at_physical_open'] is True
+        finally:
+            release.set()
+            await asyncio.to_thread(watcher.join, 5)
+            assert not watcher.is_alive()
+            assert await asyncio.to_thread(finished.wait, 5)
+
+
+@pytest.mark.asyncio
+async def test_repeated_cancellation_keeps_reservation_until_physical_open_finishes(tmp_path, monkeypatch):
+    from gateway.run_runtime import initialize_gateway_runtime, _build_profile_authority
+    from gateway.runtime_ownership import process_ownership
+    with _world(tmp_path, monkeypatch) as (runner, root, target):
+        await initialize_gateway_runtime(runner)
+        entered, release, finished, rows = _blocked_native_open(monkeypatch, target)
+        loop = asyncio.get_running_loop()
+        cancelled, observed = threading.Event(), threading.Event()
+        checks = []
+
+        async def owning_call():
+            try:
+                return await _build_profile_authority(runner, 'alpha', target, register=False)
+            finally:
+                if runner.session_authorities.for_home(target) is None:
+                    process_ownership.release(target)
+
+        task = asyncio.create_task(owning_call())
+
+        def cancel_twice():
+            task.cancel()
+            loop.call_soon(task.cancel)
+            cancelled.set()
+
+        def check_custody():
+            checks.append((task.done(), process_ownership.owns(target)))
+            observed.set()
+
+        def observer():
+            assert entered.wait(5)
+            loop.call_soon_threadsafe(cancel_twice)
+            checks.append(cancelled.wait(2))
+            loop.call_soon_threadsafe(check_custody)
+            checks.append(observed.wait(2))
+            release.set()
+
+        watcher = threading.Thread(target=observer)
+        watcher.start()
+        try:
+            with pytest.raises(asyncio.CancelledError):
+                await task
+            assert checks == [True, (False, True), True], 'cancelled observer must not release a live opener'
+            assert rows[0]['owned_at_physical_open'] is True
+            assert runner.session_authorities.for_home(target) is None
+            assert not process_ownership.owns(target)
+        finally:
+            release.set()
+            await asyncio.to_thread(watcher.join, 5)
+            assert not watcher.is_alive()
+            assert await asyncio.to_thread(finished.wait, 5)
+
+
+@pytest.mark.asyncio
+async def test_shutdown_fence_refuses_a_new_profile_writer(tmp_path, monkeypatch):
+    from gateway.run_runtime import initialize_gateway_runtime, _build_profile_authority
+    with _world(tmp_path, monkeypatch) as (runner, root, target):
+        await initialize_gateway_runtime(runner)
+        runner._shutdown_executor()
+        with pytest.raises(RuntimeError, match='shutting down; executor unavailable'):
+            await _build_profile_authority(runner, 'alpha', target, register=False)
+        assert not (target / 'state.db').exists()
+        assert runner.session_authorities.for_home(target) is None
