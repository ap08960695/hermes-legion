new file mode 100644
index 0000000000000000000000000000000000000000..7972af6c0aececd154b3dfb4d338616e9d472a68
--- /dev/null
+++ b/agent/cache_change_evidence.py
@@ -0,0 +1,57 @@
+"""Explain observed request changes with bounded digests, never prompt bodies."""
+_POLICIES = {
+    'ready_before_wait': '<!-- captain-ready-before-wait-v1 -->',
+    'decision_autonomy': '<!-- captain-decision-autonomy-v1 -->',
+    'execution_reference': 'Captain execution evidence v1',
+}
+
+
+def policy_evidence(request):
+    effective = dict(request)
+    if isinstance(request.get('extra_body'), dict):
+        effective.update(request['extra_body'])
+    value = effective.get('instructions', effective.get('system'))
+    if value is None:
+        value = [m.get('content') for m in effective.get('messages', [])
+                 if isinstance(m, dict) and m.get('role') in {'system', 'developer'}]
+    # Iterative, bounded traversal of text blocks, no copies of the full context.
+    stack, remaining, found = [value], 2 * 1024 * 1024, set()
+    visited = 0
+    while stack and remaining > 0 and visited < 4096:
+        part = stack.pop()
+        visited += 1
+        if isinstance(part, str):
+            text = part[:remaining]
+            remaining -= len(text)
+            found.update(name for name, marker in _POLICIES.items() if marker in text)
+        elif isinstance(part, list):
+            stack.extend(reversed(part[:4096]))
+        elif isinstance(part, dict):
+            stack.append(part.get('text', part.get('content')))
+    return {'markers_present': sorted(found), 'scan_complete': not stack and remaining > 0,
+            'evidence': 'prepared_instruction_marker_only_not_behavior_or_authorization'}
+
+
+def transition(agent, fingerprint):
+    """Agent-local, scope-bound state. Only compact hashes survive a request."""
+    names = ('route', 'instructions', 'tools', 'options', 'history')
+    def value(name):
+        part = fingerprint.get(name, {})
+        return part.get('hash') if part.get('complete') else None
+    scope = (fingerprint.get('key_id'), value('session'))
+    current = {name: value(name) for name in names}
+    prefixes = fingerprint.get('history', {}).get('prefixes', {})
+    current['history_prefixes'] = {k: v for k, v in prefixes.items() if k in {'4096','16384','65536','262144','1048576','4194304'}}
+    previous = getattr(agent, '_cache_change_evidence', None)
+    agent._cache_change_evidence = (scope, current)
+    if previous is None or previous[0] != scope or None in scope:
+        return {'baseline': True, 'changed': [], 'cause_of_cache_miss_proven': False}
+    changed = [name for name in names if current[name] is not None and previous[1].get(name) is not None
+               and current[name] != previous[1][name]]
+    unknown = [name for name in names if current[name] is None or previous[1].get(name) is None]
+    old_prefixes = previous[1].get('history_prefixes', {})
+    equal = [int(k) for k, v in current['history_prefixes'].items() if old_prefixes.get(k) == v]
+    return {'baseline': False, 'changed': changed, 'unknown': unknown,
+            'history_equal_prefix_bytes': max(equal, default=None),
+            'history_change_does_not_imply_prefix_change': True,
+            'cause_of_cache_miss_proven': False}
