+
+def test_builder_exception_keeps_original_request_prefix(prefix_case, monkeypatch):
+    c = prefix_case
+    def fail_build(*args, **kwargs):
+        raise RuntimeError("fixture: candidate prompt construction failed")
+    monkeypatch.setattr(c.agent, "_build_system_prompt", fail_build)
+    with pytest.raises(RuntimeError, match="candidate prompt construction failed"):
+        c.agent._compress_context(c.messages, "trusted updated context", approx_tokens=120_000,
