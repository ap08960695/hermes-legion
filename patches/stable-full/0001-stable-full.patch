+"""Opt-in requirements through native dispatch, completion and worker-context seams."""
+import hashlib
+import json
+import sqlite3
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_dispatch as kbd
+from hermes_cli import kanban_task_contract as contract
+from hermes_cli import kanban_evidence_context as evidence
+
+
+def sha(text):
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+def body(data):
+    return 'BRIEF: local test\n```hermes-contract\n' + json.dumps({'version': 1, **data}) + '\n```'
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / '.hermes'; home.mkdir()
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(home))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    conn = kbc.connect()
+    yield conn, home
+    conn.close()
+
+
+def task(board, tmp_path, data=None, **kw):
+    return kb.create_task(board[0], title='offline fixture', body=body(data) if data is not None else 'legacy',
+                          workspace_kind='dir', workspace_path=str(tmp_path), **kw)
+
+
+@pytest.fixture
+def verified(board, tmp_path):
+    (tmp_path / 'source.py').write_text('code')
+    (tmp_path / 'lock').write_text('environment')
+    (tmp_path / 'result.log').write_text('one test passed')
+    data = {'inputs': {'source.py': sha('code')}, 'environment': {'lock': sha('environment')}, 'checks': ['unit'], 'check_definitions': {'unit': 'source.py'}}
+    metadata = {'verification': {'version': 1, **data, 'checks': [
+        {'name': 'unit', 'exit_code': 0, 'log': 'result.log', 'sha256': sha('one test passed'),
+         'completed_at': time.time()-10, 'expires_at': time.time()+3600}]}}
+    tid = task(board, tmp_path, data)
+    return tid, data, metadata
+
+
+def test_native_completion_refuses_missing_evidence_before_done(board, tmp_path):
+    tid = task(board, tmp_path, {'inputs': {'x': sha('x')}, 'environment': {'lock': sha('e')}, 'checks':['unit'], 'check_definitions': {'unit': 'x'}})
+    with pytest.raises(ValueError, match='verification'):
+        kb.complete_task(board[0], tid, summary='passed')
+    assert kb.get_task(board[0], tid).status == 'ready'
+    assert not any(e.kind == 'completed' for e in kb.list_events(board[0], tid))
+
+
+def test_native_completion_and_reuse_revalidate_bytes(board, tmp_path, verified):
+    tid, data, metadata = verified
+    assert kb.complete_task(board[0], tid, summary='passed', metadata=metadata)
+    child = task(board, tmp_path, data, parents=[tid])
+    context = kb.build_worker_context(board[0], child)
+    assert 'evidence_matches_now' in context
+    (tmp_path / 'source.py').write_text('changed')
+    assert 'evidence_matches_now' not in kb.build_worker_context(board[0], child)
+
+
+@pytest.mark.parametrize('field', ['environment', 'inputs', 'check_definitions', 'exit_code', 'expires_at', 'sha256', 'log'])
+def test_completion_rejects_changed_scope_failed_or_expired_results(board, tmp_path, verified, field):
+    tid, _, metadata = verified
+    ev = metadata['verification'];row=ev['checks'][0]
+    if field in ('environment','inputs','check_definitions'):ev[field]={}
+    else:
+        row[field] = {'exit_code': 1, 'expires_at': time.time()-1,
+                      'sha256': '0'*64, 'log': '../outside.log'}[field]
+    with pytest.raises((ValueError, FileNotFoundError)):
+        kb.complete_task(board[0],tid,summary='claimed success',metadata=metadata)
+    assert kb.get_task(board[0],tid).status=='ready'
+
+
+def test_reuse_is_lineage_scoped_not_global(board, tmp_path, verified):
+    tid, data, metadata = verified
+    kb.complete_task(board[0],tid,summary='passed',metadata=metadata)
+    other=task(board,tmp_path,data)
+    assert 'evidence_matches_now' not in kb.build_worker_context(board[0],other)
+
+
+def test_review_handoff_requires_same_evidence(board, tmp_path, verified):
+    tid, _, _ = verified
+    kb.claim_task(board[0], tid)
+    with pytest.raises(ValueError, match='verification'):
+        kb.request_review(board[0], tid, summary='review me')
+    assert kb.get_task(board[0],tid).status=='running'
+
+
+def test_legacy_tasks_are_unchanged(board, tmp_path):
+    tid=task(board,tmp_path)
+    assert kb.complete_task(board[0],tid,summary='legacy success')
+
+
+def test_dispatch_missing_tool_does_not_spawn_or_consume_retry(board,tmp_path,monkeypatch):
+    tid=task(board,tmp_path,{'required_tools':['terminal']},assignee='analyst')
+    monkeypatch.setattr(kbd,'_profile_exists_fn',lambda:lambda _:True)
+    monkeypatch.setattr(contract,'configured_tools',lambda _: {'read_file'})
+    spawns=[]
+    result=kbd.dispatch_once(board[0],spawn_fn=lambda *a,**k:spawns.append(a),reconcile_orphans=False)
+    assert not spawns and result.respawn_guarded
+    t=kb.get_task(board[0],tid)
+    assert t.status != 'running' and t.block_kind=='capability'
+    assert t.consecutive_failures == 0
+    receipts = kb.list_runs(board[0], tid)
+    assert len(receipts) == 1
+    assert receipts[0].claim_lock is None and receipts[0].worker_pid is None
+    assert receipts[0].outcome == 'blocked'
+    assert receipts[0].ended_at == receipts[0].started_at
+
+
+def test_dispatch_dry_run_is_readonly_for_missing_capability(board,tmp_path,monkeypatch):
+    tid=task(board,tmp_path,{'required_tools':['terminal']},assignee='analyst')
+    monkeypatch.setattr(kbd,'_profile_exists_fn',lambda:lambda _:True)
+    monkeypatch.setattr(contract,'configured_tools',lambda _: set())
+    before=[e.id for e in kb.list_events(board[0],tid)]
+    result=kbd.dispatch_once(board[0],dry_run=True,reconcile_orphans=False)
+    assert result.respawn_guarded and kb.get_task(board[0],tid).status=='ready'
+    assert before==[e.id for e in kb.list_events(board[0],tid)]
+
+
+def test_preflight_cas_cannot_block_newly_claimed_worker(board,tmp_path):
+    tid=task(board,tmp_path,{},assignee='analyst')
+    claimed=kb.claim_task(board[0],tid)
+    assert not kb.block_task(board[0],tid,kind='capability',expected_status='ready',expected_assignee='analyst')
+    assert kb.get_task(board[0],tid).claim_lock==claimed.claim_lock
+
+
+def test_native_profile_selection_and_disabled_toolset(board):
+    home=board[1]/'profiles'/'analyst';home.mkdir(parents=True)
+    (home/'config.yaml').write_text('platform_toolsets:\n  cli: [hermes-cli]\nagent:\n  disabled_toolsets: [terminal]\n')
+    names=contract.configured_tools('analyst')
+    assert 'read_file' in names and 'terminal' not in names
+
+
+def test_scoped_decision_reference_expiry_revocation_and_source(board,tmp_path,monkeypatch):
+    inputs={'source.py':sha('code')};(tmp_path/'source.py').write_text('code')
+    tid=task(board,tmp_path,{'inputs':inputs,'decision_actions':['apply']},session_id='owner-session')
+    state=board[1]/'profiles'/'captain';state.mkdir(parents=True)
+    with sqlite3.connect(state/'state.db') as db:
+        db.execute('CREATE TABLE messages(id INTEGER, session_id TEXT, role TEXT, content TEXT, display_kind TEXT, _compressed_summary INTEGER)')
+        db.execute('INSERT INTO messages VALUES(1,?,?,?,?,0)',('owner-session','user','approve exact change',None))
+    record={'task_id':tid,'inputs':inputs,'action':'apply','expires_at':time.time()+60,
+            'source':{'profile':'captain','session_id':'owner-session','message_id':1,'sha256':sha('approve exact change')}}
+    kb.add_comment(board[0],tid,author='captain',body='OWNER-DECISION v1\n'+json.dumps(record))
+    assert 'source_reference_matches' in kb.build_worker_context(board[0],tid)
+    record['expires_at'] = time.time() - 1
+    kb.add_comment(board[0],tid,author='captain',body='OWNER-DECISION v1\n'+json.dumps(record))
+    assert 'source_reference_matches' not in kb.build_worker_context(board[0],tid)
+    record['expires_at'] = time.time() + 60
+    record['source']['sha256'] = '0' * 64
+    kb.add_comment(board[0],tid,author='captain',body='OWNER-DECISION v1\n'+json.dumps(record))
+    assert 'source_reference_matches' not in kb.build_worker_context(board[0],tid)
+    record['source']['sha256'] = sha('approve exact change')
+    record['revoked']=True
+    kb.add_comment(board[0],tid,author='captain',body='OWNER-DECISION v1\n'+json.dumps(record))
+    assert 'source_reference_matches' not in kb.build_worker_context(board[0],tid)
+
+
+@pytest.mark.parametrize('bad', [None, {}, {'version':2}, {'version':1,'required_tools':'terminal'},
+                              {'version':1,'checks':['unit'], 'check_definitions': {'unit': 'x'}}])
+def test_malformed_contract_is_explicit_error(bad):
+    with pytest.raises(ValueError):
+        contract.task_contract('```hermes-contract\n'+json.dumps(bad)+'\n```')
