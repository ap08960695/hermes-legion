+function child(result?: { code?: number; stdout?: string; stderr?: string }) {
+  const proc: any = new EventEmitter()
+  proc.stdout = new EventEmitter()
+  proc.stderr = new EventEmitter()
+  proc.stdin = { write: () => true, end: () => {} }
+
+  proc.finish = (code = 0, stdout = '', stderr = '') => {
+    proc.stdout.emit('data', stdout)
+    proc.stderr.emit('data', stderr)
+    proc.emit('close', code, null)
+  }
+
+  proc.kill = vi.fn(() => {
+    queueMicrotask(() => proc.emit('close', null, 'SIGKILL'))
+
+    return true
+  })
+
+  if (result) {
+    queueMicrotask(() => proc.finish(result.code, result.stdout, result.stderr))
+  }
+
+  return proc
+}
