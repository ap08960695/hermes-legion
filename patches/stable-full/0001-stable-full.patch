+
+it('retains failed input separately from both a newer draft and another owner', () => {
+  stashSessionDraft(target, 'Next message', [], owner)
+  stashSessionDraft(target, 'Other owner message', [], other)
+  retainRejectedDraft(target, 'Earlier message', [], owner, 'earlier-send')
+  expect(takeSessionDraft(target, owner).text).toBe('Next message')
+  expect(takeSessionDraft(target, other).text).toBe('Other owner message')
+  expect(retainedRejectedDrafts(target, other)).toEqual([])
+  expect(retainedRejectedDrafts('another-session', owner)).toEqual([])
+  expect(retainedRejectedDrafts(target, owner).map(row => row.text)).toEqual(['Earlier message'])
+})
+
+it('restores only into an empty target and keeps the original explicit retry identity', () => {
+  retainRejectedDraft(target, 'Earlier message', [], owner, 'earlier-send')
+  const [saved] = retainedRejectedDrafts(target, owner)
+  stashSessionDraft(target, 'Newer message', [], owner)
+  expect(restoreRejectedDraft(saved.scope, target, owner)).toBeUndefined()
+  expect(retainedRejectedDrafts(target, owner)).toHaveLength(1)
+  clearSessionDraft(target, owner)
