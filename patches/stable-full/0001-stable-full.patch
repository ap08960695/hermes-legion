+"""Web picker routes have a different effort ladder from API model families."""
+from types import SimpleNamespace
+
+import pytest
+
+from agent.reasoning_effort import clamp_effort, codex_supported_efforts, route_supported_efforts
+from agent.codex_runtime import _codex_turn_effort
+
+
+@pytest.mark.parametrize('slug,levels,requested,expected', [
+    ('gpt-6-pro', ('max',), 'max', 'max'),
+    ('gpt-5.6-pro', ('max',), 'high', 'max'),
+    ('gpt-6-sol-instant', ('low',), 'high', 'low'),
+    ('gpt-5.6-sol-instant', ('low',), 'max', 'low'),
+    ('gpt-6-sol', ('medium', 'high', 'xhigh'), 'max', 'xhigh'),
+    ('gpt-5.6-sol', ('medium', 'high', 'xhigh'), 'low', 'medium'),
+])
+def test_web_catalog_ladder_reaches_native_turn(slug, levels, requested, expected):
+    model = 'chatgpt-web/' + slug
+    assert codex_supported_efforts(model) == levels
+    assert route_supported_efforts('openai-codex', model, 'codex_app_server') == levels
+    assert clamp_effort(requested, levels) == expected
+    agent = SimpleNamespace(model=model, provider='openai-codex', api_mode='codex_app_server',
+                            base_url='https://chatgpt.com/backend-api/codex',
+                            reasoning_config={'enabled': True, 'effort': requested})
+    assert _codex_turn_effort(agent, model) == expected
+    agent.reasoning_config['effort'] = 'ultra'
+    assert _codex_turn_effort(agent, model) == levels[-1]
+
+
+def test_web_namespace_does_not_narrow_api_models():
+    assert 'max' in codex_supported_efforts('gpt-5.6-pro')
+    assert 'high' in codex_supported_efforts('gpt-6-sol-instant')
+    assert 'ultra' in route_supported_efforts('openai-codex', 'gpt-5.6-pro', 'codex_app_server')
