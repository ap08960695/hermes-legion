+            "type": "object", "properties": {"value": {"type": "string"}}, "required": ["value"]},
+            "annotations": {"readOnlyHint": True}}
+        self.utility = {"name": "mcp__metadata_echo__list_prompts", "description": "Cached prompts",
+                        "parameters": {"type": "object", "properties": {}}}
+        write_cache_entry("metadata_echo", config_fingerprint(self.servers["metadata_echo"]),
+                          tools=[self.tool], utility_tools=[{"schema": self.utility, "handler_key": "list_prompts"}])
