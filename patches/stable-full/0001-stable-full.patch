+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { act, cleanup, fireEvent, render, screen, waitFor, within } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+
+// eslint-disable-next-line no-restricted-imports
+import { registerPluginLocales } from '@/i18n/plugin-i18n'
+
+import type * as Api from './api'
+import { KANBAN_LOCALES } from './i18n'
+import { WorkView } from './work-view'
+
+const io = vi.hoisted(() => ({
+  read: vi.fn(),
+  route: vi.fn(() => true),
+  diff: vi.fn(),
+  usage: vi.fn(),
+  run: vi.fn(),
+  write: vi.fn(),
+  download: vi.fn(async () => {})
+}))
+
+vi.mock('./api', async original => ({
+  ...(await original<typeof Api>()),
+  routedToScope: io.route,
+  fetchTask: io.read,
+  fetchRevisionDiff: io.diff,
+  fetchReviewedUsage: io.usage,
+  fetchUsageRun: io.run,
+  patchTask: io.write,
+  createTask: io.write
+}))
+afterEach(() => {
+  cleanup()
+  vi.clearAllMocks()
+  io.route.mockReturnValue(true)
+  io.usage.mockReset()
+})
+it('shows evidence limits and keeps a completed selection available without dispatch', async () => {
+  const dispose = registerPluginLocales('kanban', KANBAN_LOCALES)
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+  io.read.mockResolvedValue({
+    task: { id: 'sample', title: 'Return five', status: 'done', assignee: 'builder' },
+    runs: [],
+    downloadAttachment: io.download,
+    delivery: {
+      version: 1,
+      task_id: 'sample',
+      objective: 'Return five',
+      brief: 'Read the workflow before starting.',
+      state: 'awaiting_verification',
+      native_status: 'done',
+      result: 'Final result is five',
+      outputs: [{ name: 'answer.txt', stored_path: '/fixture/answer.txt' }],
+      owner: 'builder',
+      criteria: [],
+      required_artifacts: ['answer.txt'],
+      latest_summary: '5',
+      verification: { status: 'missing' },
+      dependencies: []
+    }
+  })
+
+  const board = {
+    columns: [{ name: 'done', tasks: [{ id: 'sample', title: 'Return five', status: 'done' }] }],
+    tenants: [],
+    assignees: [],
+    now: 1,
+    latest_event_id: 1
+  }
+
+  render(
+    <QueryClientProvider client={client}>
+      <WorkView board={board} onOpen={vi.fn()} />
+    </QueryClientProvider>
+  )
+  fireEvent.click(screen.getByRole('button', { name: /Return five/ }))
+  expect(await screen.findByText('Awaiting verification')).toBeTruthy()
+  const summary = screen.getByText('Task brief')
+  expect(screen.queryByText('Read the workflow before starting.')).toBeNull()
+  fireEvent.click(summary)
+  expect(await screen.findByText('Read the workflow before starting.')).toBeTruthy()
+  fireEvent.click(summary)
+  await waitFor(() => expect(screen.queryByText('Read the workflow before starting.')).toBeNull())
+  expect(screen.getByText('5')).toBeTruthy()
+  expect(screen.getByText('Final result is five')).toBeTruthy()
+  expect(screen.getByText('Done')).toBeTruthy()
+  fireEvent.click(screen.getByRole('button', { name: 'Download answer.txt' }))
+  await waitFor(() => expect(io.download).toHaveBeenCalledWith('/fixture/answer.txt', 'answer.txt'))
+  expect(screen.getByText('No accepted delivery evidence')).toBeTruthy()
+  expect(io.write).not.toHaveBeenCalled()
+  client.clear()
+  dispose()
