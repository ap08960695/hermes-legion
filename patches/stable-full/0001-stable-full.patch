+beforeEach(async () => {
+  vi.resetModules()
+  vi.useFakeTimers()
+  vi.spyOn(performance, 'now').mockImplementation(() => Date.now())
+  vi.spyOn(process, 'availableMemory').mockReturnValue(floor)
+  children = []
+  spawn.mockReset().mockImplementation(() => {
+    const child = new Child()
+    children.push(child)
+
+    return child
+  })
+  api = await import('./backend-probes')
+})
+
+afterEach(async () => {
+  for (let round = 0; round < 3; round++) {
+    await vi.advanceTimersByTimeAsync(125_001)
+
+    for (const child of children) { child.close(1) }
+    await tick()
+  }
+
+  expect(vi.getTimerCount()).toBe(0)
+  vi.restoreAllMocks()
+  vi.useRealTimers()
+})
+
+it('serializes identical fresh probes until actual close', async () => {
+  const first = probe(); const second = probe()
+  expect(children).toHaveLength(1)
+  children[0].close()
+  await first; await tick()
+  expect(children).toHaveLength(2)
+  children[1].close()
+  await second
+})
+
+it('applies a parsed two-probe launch limit', async () => {
+  api.configureBackendProbes(readDesktopLaunchConfig('desktop:\n  backend_probe_limit: "2" # cap\n'))
+  const first = probe('/a'); const second = probe('/b'); const third = probe('/c')
+  expect(children).toHaveLength(2)
+  children[0].close(); await first; await tick()
+  expect(children).toHaveLength(3)
+  expect(spawn.mock.calls.map(call => call[0])).toEqual(['/a', '/b', '/c'])
+  children[1].close(); children[2].close()
