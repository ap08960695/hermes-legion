+"""Native one-turn construction for the explicit attention CLI consumer."""
+import json
+import logging
+
+
+def build_agent(*, session_id: str, row: dict, cwd: str, session_db):
+    from hermes_cli.config import load_config, resolve_turn_limit
+    from hermes_cli.oneshot import _resolve_model_and_provider, _apply_stored_session_runtime, _oneshot_clarify_callback
+    from hermes_cli.runtime_provider import resolve_runtime_provider
+    from hermes_cli.tools_config import _get_platform_tools
+    from hermes_constants import resolve_reasoning_config
+    from agent.fast_mode import parse_service_tier
+    from run_agent import AIAgent
+    cfg = load_config()
+    agent_cfg = cfg.get("agent") or {}
+    from agent.skill_utils import parse_config_string_list
+    raw_limit = agent_cfg.get("max_turns")
+    if raw_limit is None:
+        raw_limit = cfg.get("max_turns")
+    model_cfg = cfg.get('model') or {}
+    configured_provider = model_cfg.get('provider') if isinstance(model_cfg, dict) else None
+    choice = _apply_stored_session_runtime(_resolve_model_and_provider(cfg, None, configured_provider), row, explicit_model=False)
+    if not choice.provider or choice.provider == 'auto':
+        raise RuntimeError('attention destination requires an explicit configured provider')
+    runtime = resolve_runtime_provider(requested=choice.provider, explicit_api_key=choice.api_key,
+        explicit_base_url=choice.base_url, target_model=choice.model)
+    stored = json.loads(row.get('model_config') or '{}')
+    reasoning = stored.get('reasoning_config')
+    if not isinstance(reasoning, dict):
+        reasoning = resolve_reasoning_config(cfg, choice.model)
+    tier = stored.get('service_tier') or parse_service_tier((cfg.get('agent') or {}).get('service_tier', ''))
+    from hermes_cli.mcp_startup import ensure_mcp_discovery_before_agent_build
+    ensure_mcp_discovery_before_agent_build(logger=logging.getLogger(__name__), single_query=True)
+    return AIAgent(model=choice.model, max_iterations=resolve_turn_limit(raw_limit, default=500),
+        disabled_toolsets=parse_config_string_list(agent_cfg.get("disabled_toolsets")), provider=runtime.get('provider'), requested_provider=runtime.get('requested_provider'),
+        api_key=runtime.get('api_key'), base_url=runtime.get('base_url'), api_mode=choice.api_mode or runtime.get('api_mode'),
+        credential_pool=runtime.get('credential_pool'), fallback_model=None,
+        session_db=session_db, session_id=session_id, platform=row['source'], cwd=cwd,
+        enabled_toolsets=sorted(_get_platform_tools(cfg, row['source'])), quiet_mode=True,
+        reasoning_config=reasoning, service_tier=('' if tier == 'normal' else tier),
+        request_overrides=runtime.get('request_overrides'), clarify_callback=_oneshot_clarify_callback)
