new file mode 100644
index 0000000000000000000000000000000000000000..8efb1a36b441693202bf3846764fa2cd60530522
--- /dev/null
+++ b/tui_gateway/owner_inbox.py
@@ -0,0 +1,164 @@
+"""Owner inbox adapter for the standalone dashboard (Desktop SSH and legacy WebSocket)."""
+import queue
+import sqlite3
+import time
+
+from hermes_constants import profile_name_for_home
+from tui_gateway import server_requests
+from tui_gateway.transport import current_transport
+
+_METHODS = frozenset({'clarify', 'approval'})
+
+
+def invalidate():
+    from tui_gateway import server
+
+    with server._live_transports_lock:
+        peers = tuple(server._live_transports)
+    for peer in peers:
+        if getattr(peer, 'owner_inbox_watching', False):
+            peer.notify_owner_inbox()
+
+
+def _profile(session):
+    from hermes_constants import get_process_hermes_home
+    return profile_name_for_home(session.get('profile_home') or get_process_hermes_home()) or 'default'
+
+
+def _items(sid, session, request):
+    from gateway.run import _redact_approval_command
+    from hermes_cli.goals_metadata import read_goal
+    from tui_gateway import server
+
+    key = str(server._session_lookup_key(session, fallback=sid))
+    base = {'profile': _profile(session), 'session_id': sid, 'chat_session_id': key,
+            'prompt_id': request['id'], 'created_at': request['created_at'],
+            'kind': request['method'], 'execution_generation': 0}
+    params = request['params']
+    if request['method'] == 'clarify':
+        queries = [{
+            **base, 'question_id': question['qid'], 'question': _redact_approval_command(question['question']),
+            'choices': [_redact_approval_command(choice) for choice in question.get('choices') or []],
+            'multi_select': bool(question.get('multi_select')),
+        } for question in params.get('questions', ()) if question['qid'] not in (params.get('answers') or {})]
+    else:
+        queries = [{
+            **base, 'command': _redact_approval_command(params.get('command', '')),
+            'description': _redact_approval_command(params.get('description', '')),
+            'choices': params.get('choices', []), 'chat_only': 'edit' in params,
+        }]
+    if not queries:
+        return []
+    try:
+        with server._session_db(session) as db:
+            if db is None:
+                return queries
+            title = db.get_session_title(key)
+            goal, _ = read_goal(db, db.get_compression_tip(key) or key)
+    except (sqlite3.Error, ValueError, TypeError):
+        return queries
+    return [{**query, 'title': _redact_approval_command(title) if title else None,
+             'goal': _redact_approval_command(goal.goal) if goal and goal.status in {'active', 'paused'} else None}
+            for query in queries]
+
+
+def _mirror(session, request_id=None):
+    from tui_gateway.compute_host_bridge import _history_lock
+    with _history_lock(session):
+        saved = session.get('_compute_host_open_request')
+        if saved and saved['method'] in _METHODS and (request_id is None or saved['id'] == request_id):
+            return {**saved, 'params': dict(saved['params']),
+                    'created_at': session.get('_compute_host_request_created_at') or time.time()}
+    return None
+
+
+def list_pending(rid, params):
+    from tui_gateway import server
+
+    transport = current_transport()
+    if not getattr(transport, 'owner_inbox_operator', False):
+        return server._err(rid, 4003, 'permission_denied')
+    transport.owner_inbox_watching = True
+    with server._sessions_lock:
+        sessions = dict(server._sessions)
+    pending = server_requests.inbox_requests()
+    for sid, session in sessions.items():
+        mirrored = _mirror(session)
+        if mirrored is not None:
+            pending.append(mirrored)
+    items = [item for request in pending
+             if (sid := request['params']['session_id']) in sessions
+             for item in _items(sid, sessions[sid], request)]
+    return server._ok(rid, {'items': sorted(items, key=lambda item: (item['created_at'], item['profile'], item['prompt_id']))})
+
+
+def stop_watching(rid, params):
+    from tui_gateway import server
+
+    transport = current_transport()
+    if not getattr(transport, 'owner_inbox_operator', False):
+        return server._err(rid, 4003, 'permission_denied')
+    transport.owner_inbox_watching = False
+    return server._ok(rid, {'watching': False})
+
+
+def resolve_native(sid, session, params):
+    """Settle the exact local waiter, whether here or in the compute host child."""
+    from tools.approval import resolve_gateway_approval
+
+    request = next((item for item in server_requests.inbox_requests(sid) if item['id'] == params['prompt_id']), None)
+    if request is None or request['method'] != params['kind']:
+        return False
+    if params['kind'] == 'clarify':
+        return server_requests.lock_answer(params['prompt_id'], params['question_id'],
+                                           params['value'], sid=sid, once=True) is not None
+    approval = request['params']
+    if ('edit' in approval or params['value'] not in {'once', 'deny'}
+            or params['value'] not in approval.get('choices', []) or not approval.get('request_id')):
+        raise ValueError('invalid approval choice')
+    return bool(resolve_gateway_approval(session['session_key'], params['value'],
+                                         request_id=approval['request_id']))
+
+
+def _resolve_host(server, sid, session, params):
+    # The parent's mirror is advisory. Only the child's checked response can confirm settlement.
+    ack = server._get_compute_host_supervisor().respond(sid, {'owner_inbox': params})
+    result = (ack.get('response') or {}).get('result') if ack.get('type') == 'respond.ack' else None
+    if not isinstance(result, dict) or result.get('status') not in {'resolved', 'expired'}:
+        raise RuntimeError('compute host did not confirm the response')
+    with server._history_lock(session):
+        if server._open_request_matches(session, params['prompt_id']):
+            if result.get('open') is False:
+                session.pop('_compute_host_open_request', None)
+            elif isinstance(result.get('locked'), list):
+                mirror = session['_compute_host_open_request']['params']
+                mirror['answers'] = {**(mirror.get('answers') or {}), **dict.fromkeys(result['locked'])}
+    invalidate()
+    return result['status']
+
+
+def respond(rid, params):
+    from tui_gateway import server
+
+    if not getattr(current_transport(), 'owner_inbox_operator', False):
+        return server._err(rid, 4003, 'permission_denied')
+    sid, value, kind = params['session_id'], params['value'], params['kind']
+    if (not value.strip() or len(value) > 16384 or params['execution_generation'] != 0
+            or params.get('authority_epoch') is not None or not params['prompt_id']
+            or bool(params.get('question_id')) != (kind == 'clarify')):
+        return server._err(rid, 4002, 'invalid_params')
+    session = server._sessions.get(sid)
+    status = 'expired'
+    if session is not None and params['profile'] == _profile(session):
+        with server._session_profile_runtime_scope(session):
+            try:
+                mirrored = _mirror(session, params['prompt_id'])
+                if mirrored is not None and mirrored['method'] == kind:
+                    status = _resolve_host(server, sid, session, params)
+                elif resolve_native(sid, session, params):
+                    status = 'resolved'
+            except ValueError:
+                return server._err(rid, 4002, 'invalid_params')
+            except (RuntimeError, OSError, queue.Empty):
+                return server._err(rid, 5019, 'compute host did not confirm the response')
+    return server._ok(rid, {'status': status})
