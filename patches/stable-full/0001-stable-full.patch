+"""A wait timeout is not evidence that a tracked operation finished."""
+import json
+import subprocess
+import sys
+import time
+from pathlib import Path
+from unittest.mock import Mock
+
+import pytest
+from hermes_cli import goals
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    goals._DB_CACHE.clear()
+    yield home
+    goals._DB_CACHE.clear()
+
+
+def test_long_running_pid_remains_parked_across_reload_until_real_exit(home, monkeypatch):
+    proc = subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(30)'])
+    try:
+        mgr = goals.GoalManager(session_id='long-pid')
+        mgr.set('finish original job', max_turns=3)
+        mgr.wait_on(proc.pid, reason='original job')
+        mgr.state.waiting_since = time.time() - goals._MAX_BARRIER_WAIT_S - 10
+        mgr._save()
+        mgr = goals.GoalManager(session_id='long-pid')
+        judge = Mock()
+        monkeypatch.setattr(goals, 'judge_goal', judge)
+        decision = mgr.evaluate_after_turn('still waiting')
+        assert decision['verdict'] == 'waiting'
+        assert not decision['should_continue'] and mgr.state.turns_used == 0
+        judge.assert_not_called()
+        proc.terminate(); proc.wait(timeout=10)
+        assert not mgr.is_waiting()
+        assert mgr.state.waiting_on_pid is None
+    finally:
+        if proc.poll() is None:
+            proc.terminate(); proc.wait(timeout=10)
+
+
+def test_live_session_is_not_treated_as_finished_after_timeout(home, monkeypatch):
+    mgr = goals.GoalManager(session_id='long-session'); mgr.set('finish original job')
+    mgr.wait_on_session('proc_original')
+    mgr.state.waiting_since = time.time() - goals._MAX_BARRIER_WAIT_S - 10
+    monkeypatch.setattr(goals, '_session_waiting', lambda _: True)
+    assert mgr.is_waiting() and mgr.state.waiting_on_session == 'proc_original'
+    monkeypatch.setattr(goals, '_session_waiting', lambda _: False)
+    assert not mgr.is_waiting() and mgr.state.waiting_on_session is None
+
+
+def test_pid_reuse_does_not_keep_waiting_on_an_unrelated_process(home, monkeypatch):
+    monkeypatch.setattr(goals, '_pid_alive', lambda _: True)
+    monkeypatch.setattr(goals, '_pid_observation', lambda _: True, raising=False)
+    fingerprint = ['boot|original']
+    monkeypatch.setattr(goals, '_pid_fingerprint', lambda _: fingerprint[0], raising=False)
+    mgr = goals.GoalManager(session_id='reused'); mgr.set('finish original job'); mgr.wait_on(4242)
+    assert getattr(mgr.state, 'waiting_on_pid_fingerprint', None) == 'boot|original'
+    fingerprint[0] = 'boot|replacement'
+    assert not mgr.is_waiting() and mgr.state.waiting_on_pid is None
+
+
+def test_unverified_pid_is_paused_after_timeout_without_judging(home, monkeypatch):
+    monkeypatch.setattr(goals, '_pid_alive', lambda _: True)
+    monkeypatch.setattr(goals, '_pid_observation', lambda _: None, raising=False)
+    monkeypatch.setattr(goals, '_pid_fingerprint', lambda _: None, raising=False)
+    mgr = goals.GoalManager(session_id='unknown'); mgr.set('finish original job'); mgr.wait_on(4242)
+    mgr.state.waiting_since = time.time() - goals._MAX_BARRIER_WAIT_S - 10
+    judge = Mock(); monkeypatch.setattr(goals, 'judge_goal', judge)
+    decision = mgr.evaluate_after_turn('waiting')
+    assert mgr.state.status == 'paused' and mgr.state.waiting_on_pid == 4242
+    assert mgr.state.turns_used == 0 and not decision['should_continue']
+    assert decision['verdict'] == 'wait_unverified' and mgr.next_continuation_prompt() is None
+    judge.assert_not_called()
+
+
+def test_registry_error_does_not_release_session_wait(home, monkeypatch):
+    mgr = goals.GoalManager(session_id='registry-unknown'); mgr.set('finish original job'); mgr.wait_on_session('proc_original')
+    monkeypatch.setattr(goals, '_session_waiting', lambda _: None)
+    assert mgr.is_waiting() and mgr.state.status == 'active'
+    mgr.state.waiting_since = time.time() - goals._MAX_BARRIER_WAIT_S - 10
+    assert mgr.is_waiting() and mgr.state.status == 'paused'
+    assert mgr.state.waiting_on_session == 'proc_original'
+
+
+def test_legacy_state_loads_without_fingerprint():
