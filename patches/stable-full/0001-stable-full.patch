+def _running(conn, assignee='alice'):
+    tid = kb.create_task(conn, title='existing worker', assignee=assignee)
+    assert kb.claim_task(conn, tid)
+    kbd._set_worker_pid(conn, tid, os.getpid())
+    return tid
