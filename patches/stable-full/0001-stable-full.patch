index 0000000000000000000000000000000000000000..ca9adce08d7c5c0f435e8ba38223e587234fce45
--- /dev/null
+++ b/hermes_state_global_recall.py
@@ -0,0 +1,902 @@
+"""Bounded verification of structured FTS hits with the active SQLite tokenizer."""
+
+from __future__ import annotations
+
+from hermes_state_blob_reader import SQLiteBlobReader
+
+import base64
+import codecs
+from collections import OrderedDict, deque
+from itertools import chain
+import json
+import re
+import sqlite3
+import time
+
+from hermes_state_stream_recall import (
+    Cursor, InvalidJSON, UnsupportedJSON, analyze, analyze_raw, decoded_string, page, text_chunks, text_spans,
+)
+from hermes_state_unicode61_folds import FOLD_ALIASES
+
+_BACKSLASH_RUN = re.compile(r'\\+')
+_RAW_TOKEN_DELIMITERS = re.compile(r'["{}\[\],: \t\r\n]+')
+_LONG_RAW_TOKEN = re.compile(r'[^"{}\[\],: \t\r\n]{1025}')
+# These ASCII escapes can assemble a nested \\u escape after JSON decoding.
+# Such input is sent to the existing verifier instead of the quick filter.
+_AMBIGUOUS_ASCII_ESCAPE = re.compile(r'\\u00(?:3[0-9]|4[1-6]|5[5c]|6[1-6]|75)', re.IGNORECASE)
+_HEX_DIGITS = frozenset('0123456789abcdefABCDEF')
+_ASCII_LOWER = str.maketrans('ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz')
+_SURROGATES = re.compile(r'[\ud800-\udfff]')
+_ASCII_WORD_RUN = re.compile(r'[A-Za-z0-9]+')
+
+
+def _positions_complete(positions):
+    return bool(positions) and all(position is not None for position in positions.values())
+
+
+def _remaining_text_state(first, chunks, deadline, chars, size, binary):
+    """Drain decoded text without tokenizing it; preserve validation and full offsets."""
+    for text in chain((first,), chunks):
+        if deadline is not None and time.monotonic() >= deadline:
+            raise TimeoutError('structured global search timed out')
+        chars += len(text)
+        size += len(text.encode('utf-8', 'surrogatepass'))
+        binary |= '\x00' in text or _SURROGATES.search(text) is not None
+    return chars, size, binary
+
+
+def _literal_positions(chunks, literals, deadline):
+    needles = [term.translate(_ASCII_LOWER) for term in literals]
+    found = {term: None for term in literals}
+    tail, chars = '', 0
+    keep = max(map(len, needles), default=1) - 1
+    for text in chunks:
+        if deadline is not None and time.monotonic() >= deadline:
+            raise TimeoutError('structured global search timed out')
+        # Still consume every fragment: a matched prefix must not hide invalid UTF-8 later.
+        if _positions_complete(found):
+            continue
+        folded = (tail + text).translate(_ASCII_LOWER)
+        for term, needle in zip(literals, needles):
+            if found[term] is None and (index := folded.find(needle)) >= 0:
+                found[term] = (chars - len(tail) + index, 0)
+        chars += len(text)
+        tail = folded[-keep:] if keep else ''
+    return found
+
+
+def _unicode_fragments(chunks):
+    """Yield decoded fragments and their source offsets in the outer string."""
+    pending = ''
+    base = 0
+
+    def consume(final):
+        nonlocal pending, base
+        while pending:
+            slash = pending.find('\\')
+            if slash < 0:
+                yield pending, base, True
+                base += len(pending)
+                pending = ''
+                return
+            if slash:
+                yield pending[:slash], base, True
+                pending, base = pending[slash:], base + slash
+            run = _BACKSLASH_RUN.match(pending).end()
+            pairs = run - run % 2
+            if pairs:
+                # Paired backslashes escape each other.  Emit them as source
+                # text, even when a run crosses a chunk boundary.
+                yield pending[:pairs], base, True
+                pending, base = pending[pairs:], base + pairs
+            if not pending:
+                return
+            if len(pending) == 1 and not final:
+                return
+            if pending[1:2] != 'u':
+                yield pending[0], base, True
+                pending, base = pending[1:], base + 1
+                continue
+            if len(pending) < 6:
+                if not final:
+                    return
+            elif all(char in _HEX_DIGITS for char in pending[2:6]):
+                first = int(pending[2:6], 16)
+                length = 6
+                if 0xD800 <= first <= 0xDBFF:
+                    tail = pending[6:]
+                    if not final and len(tail) < 6 and '\\u'.startswith(tail[:2]):
+                        return
+                    if (len(tail) >= 6 and tail.startswith('\\u')
+                            and all(char in _HEX_DIGITS for char in tail[2:6])):
+                        second = int(tail[2:6], 16)
+                        if 0xDC00 <= second <= 0xDFFF:
+                            first = 0x10000 + ((first - 0xD800) << 10) + second - 0xDC00
+                            length = 12
+                yield chr(first), base, False
+                pending, base = pending[length:], base + length
+                continue
+            yield pending[0], base, True
+            pending, base = pending[1:], base + 1
+
+    for chunk in chunks:
+        pending += chunk
+        yield from consume(False)
+    yield from consume(True)
+
+
+def _decoded_unicode_escapes(chunks):
+    """Interpret Unicode escapes inside serialized argument strings, incrementally."""
+    for text, _, _ in _unicode_fragments(chunks):
+        yield text
+
+
+def _outer_string_byte_offset(blob, span, target, deadline):
+    """Map a decoded JSON-string character position to its raw byte offset."""
+    start, end = span
+    cur = Cursor(blob, start, deadline)
+    decoder = codecs.getincrementaldecoder('utf-8')('strict')
+    count = 0
+    while cur.tell() < end:
+        if not cur._fill():
+            raise InvalidJSON('short JSON string')
+        bound = min(len(cur.buf), cur.pos + end - cur.tell())
+        slash = cur.buf.find(b'\\', cur.pos, bound)
+        stop = bound if slash < 0 else slash
+        pending = decoder.getstate()[0]
+        raw_start = cur.tell() - len(pending)
+        text = decoder.decode(cur.buf[cur.pos:stop], final=False)
+        if target < count + len(text):
+            return raw_start + len(text[:target - count].encode('utf-8'))
+        count += len(text)
+        cur.pos = stop
+        if cur.tell() >= end:
+            break
+        if cur.peek() != 92:
+            continue
+        decoder.decode(b'', final=True)
+        decoder = codecs.getincrementaldecoder('utf-8')('strict')
+        raw_start = cur.tell()
+        cur.get()
+        escape = cur.get()
+        if escape == 117:
+            first = int(bytes(cur.get() for _ in range(4)), 16)
+            if 0xD800 <= first <= 0xDBFF and cur.tell() < end and cur.peek() == 92:
+                resume = cur.tell()
+                cur.get()
+                if cur.tell() < end and cur.get() == 117 and cur.tell() + 4 <= end:
+                    try:
+                        second = int(bytes(cur.get() for _ in range(4)), 16)
+                    except ValueError:
+                        second = -1
+                    if not 0xDC00 <= second <= 0xDFFF:
+                        cur = Cursor(blob, resume, deadline)
+                else:
+                    cur = Cursor(blob, resume, deadline)
+        if target == count:
+            return raw_start
+        count += 1
+    decoder.decode(b'', final=True)
+    raise UnsupportedJSON('decoded tool-call offset no longer maps to its source')
+
+
+def _raw_character_offset(blob, byte_offset, deadline):
+    blob.seek(0)
+    decoder = codecs.getincrementaldecoder('utf-8')('strict')
+    remaining, chars = byte_offset, 0
+    while remaining:
+        if deadline is not None and time.monotonic() >= deadline:
+            raise TimeoutError('structured global search timed out')
+        part = blob.read(min(65536, remaining))
+        if not part:
+            raise InvalidJSON('short tool calls')
+        remaining -= len(part)
+        chars += len(decoder.decode(part, final=remaining == 0))
+    return chars
+
+
+class _StringSpans(Cursor):
+    """Collect bounded JSON string spans while validating the entire value."""
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.spans = []
+
+    def string(self):
+        span = super().string()
+        if len(self.spans) >= 65536:
+            raise UnsupportedJSON('too many strings in serialized tool calls')
+        self.spans.append(span)
+        return span
+
+
+def _uses_substring(term: str) -> bool:
+    """Thai/CJK use substring routes because unicode61 has no word segmentation."""
+    return any(
+        0x0E00 <= ord(ch) <= 0x0E7F
+        or 0x3400 <= ord(ch) <= 0x9FFF
+        or 0x20000 <= ord(ch) <= 0x2A6DF
+        or 0x3000 <= ord(ch) <= 0x30FF
+        or 0xAC00 <= ord(ch) <= 0xD7AF
+        for ch in term
+    )
+
+
+def _cjk_token_boundary(code: int) -> bool:
+    """Match the CJK ranges split by native/fts5_cjk/fts5_cjk.c."""
+    return any(lo <= code <= hi for lo, hi in (
+        (0xAC00, 0xD7A3), (0x1100, 0x11FF), (0x3130, 0x318F),
+        (0xA960, 0xA97F), (0xD7B0, 0xD7FF), (0x4E00, 0x9FFF),
+        (0x3400, 0x4DBF), (0xF900, 0xFAFF), (0x20000, 0x2FA1F),
+        (0x3040, 0x309F), (0x30A0, 0x30FF), (0x31F0, 0x31FF),
+    ))
+
+
+class _Unicode61:
+    """Query the actual runtime tokenizer; cache only bounded codepoint metadata."""
+
+    def __init__(self):
+        self.conn = sqlite3.connect(':memory:')
+        self.conn.execute('CREATE VIRTUAL TABLE probe USING fts5(body)')
+        self.conn.execute("CREATE VIRTUAL TABLE vocab USING fts5vocab(probe, 'instance')")
+        self.cache = OrderedDict()
+
+    def tokens(self, text: str) -> list[str]:
+        self.conn.execute('DELETE FROM probe')
+        self.conn.execute('INSERT INTO probe(body) VALUES(?)', (text,))
+        return [row[0] for row in self.conn.execute('SELECT term FROM vocab ORDER BY offset')]
+
+    def classify(self, char: str) -> tuple[bool, str]:
+        code = ord(char)
+        if code < 128:
+            if 'A' <= char <= 'Z':
+                return True, chr(code + 32)
+            if 'a' <= char <= 'z' or '0' <= char <= '9':
+                return True, char
+            return False, ''
+        if 0xD800 <= code <= 0xDFFF:
+            return False, ''
+        if char in self.cache:
+            self.cache.move_to_end(char)
+            return self.cache[char]
+        tokens = self.tokens('a' + char + 'b')
+        if len(tokens) == 1 and tokens[0].startswith('a') and tokens[0].endswith('b'):
+            result = (True, tokens[0][1:-1])
+        elif tokens == ['a', 'b']:
+            result = (False, '')
+        else:
+            raise UnsupportedJSON('SQLite tokenizer produced an unsupported codepoint transformation')
+        self.cache[char] = result
+        if len(self.cache) > 4096:
+            self.cache.popitem(last=False)
+        return result
+
+    def close(self):
+        self.conn.close()
+
+
+class _OrderedPrefilter:
+    """Conservative, bounded necessary-character checks for validated JSON.
+
+    Filter choices adapt only to the first 32 candidates of this one search.
+    Either choice may admit extra candidates; neither may change the verifier.
+    """
+
+    def __init__(self):
+        self.options = {}
+        self.cache = OrderedDict()
+        self.samples = {}
+
+    def ordered(self, raw, term, deadline):
+        text = raw.lower()  # raw is guaranteed ASCII before reaching here
+        if term not in self.options:
+            choices = []
+            for char in term.lower():
+                codes = (ord(char), ord(char.upper()), *FOLD_ALIASES.get(ord(char), ()))
+                if any(code > 0xffff for code in codes):
+                    return True  # unsupported representations fail open
+                choices.append((char, tuple('u' + format(code, '04x') for code in codes)))
+            self.options[term] = choices
+        position = 0
+        for char, escaped in self.options[term]:
+            if deadline is not None and time.monotonic() >= deadline:
+                raise TimeoutError('structured global search timed out')
+            index = text.find(char, position)
+            best = len(text) + 1 if index < 0 else index + 1
+            if best != position + 1:
+                for variant in escaped:
+                    found = text.find(variant, position, best)
+                    if found >= 0:
+                        best = min(best, found + len(variant))
+            if best > len(text):
+                return False
+            position = best
+        return True
+
+    def values(self, raw, term, deadline):
+        # A literal quote decodes to punctuation, so one tokenizer token cannot
+        # span it. Escaped quotes split too; that widens, not narrows, matches.
+        for index, part in enumerate(dict.fromkeys(raw.split('"'))):
+            if index % 64 == 0 and deadline is not None and time.monotonic() >= deadline:
+                raise TimeoutError('structured global search timed out')
+            if not part:
+                continue
+            key = (term, part)
+            cached = self.cache.get(key)
+            if cached is None:
+                cached = self.ordered(part, term, deadline)
+                if len(part) <= 1024:
+                    self.cache[key] = cached
+                    if len(self.cache) > 128:
+                        self.cache.popitem(last=False)
+            else:
+                self.cache.move_to_end(key)
+            if cached:
+                return True
+        return False
+
+    def reject(self, raw, term, deadline, *, escape_checked=False):
+        previous = self.samples.get(term)
+        if previous and previous[0] >= 32 and previous[1] < 8 and previous[2] < 8:
+            return False
+        if (not isinstance(raw, str) or not raw.isascii() or not 1024 < len(raw) <= 16384
+                or '\x00' in raw or not term.isascii() or not term.isalnum() or len(term) > 64
+                or (not escape_checked and _AMBIGUOUS_ASCII_ESCAPE.search(raw))):
+            return False
+        # Keep the existing verifier's unsupported-depth and scalar safeguards.
+        if raw.count('[') + raw.count('{') > 512 or _LONG_RAW_TOKEN.search(raw):
+            return False
+        state = self.samples.setdefault(term, [0, 0, 0])
+        sampling = state[0] < 32
+        if sampling or state[1] >= 8:
+            if not self.ordered(raw, term, deadline):
+                if sampling:
+                    state[0] += 1
+                    state[1] += 1
+                return True
+        if sampling or state[2] >= 8:
+            if not self.values(raw, term, deadline):
+                if sampling:
+                    state[0] += 1
+                    state[2] += 1
+                return True
+        if sampling:
+            state[0] += 1
+        return False
+
+    def close(self):
+        self.cache.clear()
+        self.options.clear()
+        self.samples.clear()
+
