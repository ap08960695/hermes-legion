+            def observe(*args, **kwargs):
+                reads.append(args[0])
+                return real_read(*args, **kwargs)
+
+            monkeypatch.setattr(session_bot_file, '_read_workspace_file', observe)
+            assert 'file_preview' not in (await call())['result']
+            assert 'file_preview' not in (await call(native=False, **opted_in))['result']
+            assert 'error' in await call(pdf_preview='yes')
+            with monkeypatch.context() as other_platform:
+                other_platform.setattr(session_group_controls, 'sys', SimpleNamespace(platform='linux'))
+                assert 'file_preview' not in (await call(**opted_in))['result']
+            token = await offer()
+            assert reads == []
+            assert await read(token) == empty
+            assert 'error' in await call('profiles.output_file', token=token, native=False, **opted_in)
+            expect = {'text': None, 'pdf_base64': b64encode(raw).decode('ascii')}
+            first, second = await asyncio.gather(read(token, **opted_in), read(token, **opted_in))
+            assert expect in (first, second) and empty in (first, second)
+            assert reads == [path]
+
+            token = await offer()
+            replacement = root / 'replacement.pdf'
+            replacement.write_bytes(raw)
+            replacement.replace(path)
+            assert await read(token, **opted_in) == empty
+            assert reads == [path]
+
+            token = await offer()
+            path.write_bytes(raw.replace(b'fixture', b'changed'))
+            assert await read(token, **opted_in) == empty
+            assert reads == [path]
+            token = await offer()
+            db.append_message('bot', 'assistant', f'Changed reply\nMEDIA:"{path}"')
+            assert await read(token, **opted_in) == empty
+            assert reads == [path]
+
+            token = await offer()
+
+            def replace_before_open(*args, **kwargs):
+                replacement.write_bytes(raw)
+                replacement.replace(path)
+                return observe(*args, **kwargs)
+
+            with monkeypatch.context() as race:
+                race.setattr(session_bot_file, '_read_workspace_file', replace_before_open)
+                assert await read(token, **opted_in) == empty
+            assert reads == [path, path]
+
+            path.write_bytes(b'%PDF-' + b'x' * (512 * 1024))
+            assert 'file_preview' not in (await call(**opted_in))['result']
+            path.write_bytes(b'invalid header')
+            assert await read(await offer(), **opted_in) == empty
+            assert reads == [path, path, path]
+
+            path.unlink()
+            outside = root / 'outside.pdf'
+            outside.write_bytes(raw)
+            path.symlink_to(outside)
+            assert 'file_preview' not in (await call(**opted_in))['result']
+            assert reads == [path, path, path]
+
+        asyncio.run(probe())
diff --git a/tests/gateway/test_session_interrupt_goal.py b/tests/gateway/test_session_interrupt_goal.py
new file mode 100644
index 0000000000000000000000000000000000000000..70701fbfd6062b492a85411d1f0e12b4e99a375f
