+import { act, cleanup, fireEvent, render } from '@testing-library/react'
+import { atom } from 'nanostores'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type { HermesGateway } from '@/hermes'
+import { I18nProvider } from '@/i18n'
+import type { ChatMessage } from '@/lib/chat-messages'
+
+import { PromptPredictionControls } from './prompt-prediction'
+import { composerPlainText, insertComposerContentsAtCaret, RICH_INPUT_SLOT } from './rich-editor'
+import { placeCaretAtEnd } from './test-utils'
+
+let editor: HTMLDivElement
+
+const messages = atom<ChatMessage[]>([
+  { id: 'goal', role: 'user', parts: [{ type: 'text', text: 'แก้ compact และ memory แล้วทดสอบ resume' }] },
+  { id: 'result', role: 'assistant', parts: [{ type: 'text', text: 'แก้ compact แล้ว ยังไม่ได้ทดสอบ resume' }] }
+])
+
+beforeEach(() => {
+  localStorage.setItem('hermes.desktop.promptPrediction.next', 'false')
+  localStorage.setItem('hermes.desktop.promptPrediction.autocomplete', 'false')
+  editor = window.document.createElement('div')
+  editor.contentEditable = 'true'
+  editor.tabIndex = 0
+  editor.dataset.slot = RICH_INPUT_SLOT
+  window.document.body.append(editor)
+  editor.focus()
+  placeCaretAtEnd(editor)
+})
+afterEach(() => {
+  cleanup()
+  editor.remove()
+})
+
+function mount(
+  request = vi.fn(async (_method: string, _params?: Record<string, unknown>, _timeout?: number) => ({
+    text: 'ทดสอบ resume กับ memory หลัง compact'
+  }))
+) {
+  const onAccept = vi.fn((text: string) => {
+    editor.textContent = ''
+    placeCaretAtEnd(editor)
+    insertComposerContentsAtCaret(editor, text)
+  })
+
+  const props = {
+    editorRef: { current: editor },
+    messages,
+    gateway: { request } as unknown as HermesGateway,
+    sessionId: 'mine',
+    busy: false,
+    blocked: false,
+    onAccept
+  }
+
+  const view = render(
+    <I18nProvider configClient={null} initialLocale="en">
+      <PromptPredictionControls {...props} />
+    </I18nProvider>
+  )
+
+  return { ...view, request, onAccept, props }
+}
+
+describe('manual predictive prompt controls', () => {
+  it('never queries on mount, typing, focus, or new assistant messages; explicit action predicts a new prompt', async () => {
+    const f = mount()
+    fireEvent.input(editor)
+    fireEvent.focus(editor)
+    await act(async () => {
+      messages.set([...messages.get()])
+      await new Promise(r => setTimeout(r, 40))
+    })
+    expect(f.request).not.toHaveBeenCalled()
+    await act(async () => {
+      fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' }))
+    })
+    expect(f.request).toHaveBeenCalledTimes(1)
+    expect(f.request.mock.calls[0]![0]).toBe('llm.oneshot')
+    expect(f.getByRole('button', { name: /ทดสอบ resume กับ memory/ })).toBeTruthy()
+    expect(composerPlainText(editor)).toBe('')
+    fireEvent.keyDown(editor, { key: 'Tab' })
+    expect(f.onAccept).toHaveBeenCalledExactlyOnceWith('ทดสอบ resume กับ memory หลัง compact')
+    expect(composerPlainText(editor)).toBe('ทดสอบ resume กับ memory หลัง compact')
+  })
+
+  it('has one action regardless of legacy disabled preferences, and sends the current draft', async () => {
+    const f = mount(vi.fn(async () => ({ text: 'ช่วยทดสอบ resume' })))
+    expect(f.queryByRole('button', { name: 'Next prompt' })).toBeNull()
+    expect(f.queryByRole('button', { name: 'Autocomplete' })).toBeNull()
+    expect(f.getAllByRole('button')).toHaveLength(1)
+    expect(f.getByRole('button', { name: 'Suggest prompt' }).hasAttribute('disabled')).toBe(false)
+    editor.textContent = 'ช่วยทดสอบ'
+    placeCaretAtEnd(editor)
+    fireEvent.input(editor)
+    expect(f.request).not.toHaveBeenCalled()
+    await act(async () => fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' })))
+    expect(f.request).toHaveBeenCalledExactlyOnceWith(
+      'llm.oneshot',
+      expect.objectContaining({
+        variables: { draft: 'ช่วยทดสอบ' }
+      }),
+      7000
+    )
+    fireEvent.keyDown(editor, { key: 'Tab' })
+    expect(f.onAccept).toHaveBeenCalledExactlyOnceWith('ช่วยทดสอบ resume')
+  })
+
+  it('does not apply a stale result after typing or switching session', async () => {
+    let resolve!: (value: { text: string }) => void
+
+    const request = vi.fn(
+      () =>
+        new Promise<{ text: string }>(r => {
+          resolve = r
+        })
+    )
+
+    const f = mount(request)
+    fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' }))
+    editor.textContent = 'Different draft'
+    placeCaretAtEnd(editor)
+    fireEvent.input(editor)
+    await act(async () => resolve({ text: 'Old prediction' }))
+    expect(f.queryByRole('button', { name: /Old prediction/ })).toBeNull()
+    expect(composerPlainText(editor)).toBe('Different draft')
+    expect(f.onAccept).not.toHaveBeenCalled()
+  })
+
+  it('only fills a matching draft, and Esc dismisses without sending or clearing text', async () => {
+    editor.textContent = 'ช่วยทดสอบ'
+    placeCaretAtEnd(editor)
+    const f = mount(vi.fn(async () => ({ text: 'ช่วยทดสอบ resume กับ memory' })))
+    await act(async () => {
+      fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' }))
+    })
+    expect(fireEvent.keyDown(editor, { key: 'Enter' })).toBe(true)
+    expect(fireEvent.keyDown(editor, { key: 'Tab', shiftKey: true })).toBe(true)
+    expect(fireEvent.keyDown(editor, { key: 'Escape' })).toBe(false)
+    expect(f.onAccept).not.toHaveBeenCalled()
+    expect(composerPlainText(editor)).toBe('ช่วยทดสอบ')
+  })
+})
+
+it('invalidates an in-flight prediction when switching sessions', async () => {
+  let resolve!: (value: { text: string }) => void
+
+  const f = mount(
+    vi.fn(
+      () =>
+        new Promise<{ text: string }>(r => {
+          resolve = r
+        })
+    )
+  )
+
+  fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' }))
+  f.rerender(
+    <I18nProvider configClient={null} initialLocale="en">
+      <PromptPredictionControls {...f.props} sessionId="other" />
+    </I18nProvider>
+  )
+  await act(async () => resolve({ text: 'Old session prediction' }))
+  expect(f.queryByRole('button', { name: /Old session prediction/ })).toBeNull()
+  expect(f.onAccept).not.toHaveBeenCalled()
+  expect(f.request).toHaveBeenCalledTimes(1)
+})
+
+it('does not generate or accept while an IME composition is active', async () => {
+  const f = mount()
+  fireEvent.compositionStart(editor)
+  fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' }))
+  expect(f.request).not.toHaveBeenCalled()
+  fireEvent.compositionEnd(editor)
+  await act(async () => fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' })))
+  expect(f.request).toHaveBeenCalledTimes(1)
+  fireEvent.compositionStart(editor)
+  fireEvent.keyDown(editor, { key: 'Tab', isComposing: true })
+  expect(f.onAccept).not.toHaveBeenCalled()
+})
diff --git a/apps/desktop/src/app/chat/composer/prompt-prediction.tsx b/apps/desktop/src/app/chat/composer/prompt-prediction.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a1e8ca3227d14a2334c3903b4a2c4b8ef39412a3
--- /dev/null
+++ b/apps/desktop/src/app/chat/composer/prompt-prediction.tsx
@@ -0,0 +1,278 @@
+import type { ReadableAtom } from 'nanostores'
+import { type RefObject, useEffect, useRef, useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { Codicon } from '@/components/ui/codicon'
+import { Popover, PopoverAnchor, PopoverContent } from '@/components/ui/popover'
+import { Tip } from '@/components/ui/tooltip'
+import type { HermesGateway } from '@/hermes'
+import { useI18n } from '@/i18n'
+import { type ChatMessage, chatMessageText } from '@/lib/chat-messages'
+
+import { composerPlainText } from './rich-editor'
+
+export interface PromptPredictionProps {
+  editorRef: RefObject<HTMLDivElement | null>
+  messages: ReadableAtom<ChatMessage[]>
+  gateway: HermesGateway | null
+  sessionId: string | null
+  busy: boolean
+  blocked: boolean
+  compact?: boolean
+  onAccept: (text: string) => void
+}
+
+function conversation(messages: readonly ChatMessage[]) {
+  const visible = messages.filter(m => !m.hidden && !m.pending && (m.role === 'user' || m.role === 'assistant'))
+  const goal = visible.find(m => m.role === 'user')
+
+  const recent = visible
+    .slice(-6)
+    .map(m => `${m.role}: ${chatMessageText(m).slice(-400)}`)
+    .join('\n')
+
+  return `Original request: ${goal ? chatMessageText(goal).slice(0, 450) : ''}\n${recent.slice(-1150)}`
+}
+
+export function PromptPredictionControls({
+  editorRef,
+  messages,
+  gateway,
+  sessionId,
+  busy,
+  blocked,
+  compact = false,
+  onAccept
+}: PromptPredictionProps) {
+  const { t } = useI18n()
+  const [loading, setLoading] = useState(false)
+  const [empty, setEmpty] = useState(false)
+  const [prediction, setPrediction] = useState<{ text: string; draft: string; context: string } | null>(null)
+  const generation = useRef(0)
+  const composing = useRef(false)
+
+  useEffect(() => {
+    generation.current++
+    setPrediction(null)
+    setLoading(false)
+    setEmpty(false)
+
+    return () => {
+      // eslint-disable-next-line react-hooks/exhaustive-deps -- Invalidate the live request counter on cleanup; this is not a DOM ref.
+      generation.current++
+    }
+  }, [sessionId, gateway, busy, blocked])
+
+  // eslint-disable-next-line no-restricted-syntax -- Native IME event handlers own this ref; the effect only attaches them.
+  useEffect(() => {
+    const editor = editorRef.current
+
+    if (!editor) {
+      return
+    }
+
+    const change = () => {
+      setPrediction(null)
+      setEmpty(false)
+    }
+
+    const start = () => {
+      composing.current = true
+      change()
+    }
+
+    const end = () => {
+      composing.current = false
+      change()
+    }
+
+    const observer = new MutationObserver(change)
+    observer.observe(editor, { childList: true, subtree: true, characterData: true })
+    editor.addEventListener('input', change)
+    editor.addEventListener('compositionstart', start)
+    editor.addEventListener('compositionend', end)
+
+    return () => {
+      observer.disconnect()
+      editor.removeEventListener('input', change)
+      editor.removeEventListener('compositionstart', start)
+      editor.removeEventListener('compositionend', end)
+    }
+  }, [editorRef])
+
+  const accept = () => {
+    const editor = editorRef.current
+
+    if (
+      !prediction ||
+      !editor ||
+      composing.current ||
+      busy ||
+      blocked ||
+      composerPlainText(editor) !== prediction.draft ||
+      conversation(messages.get()) !== prediction.context
+    ) {
+      return
+    }
+
+    onAccept(prediction.text)
+    setPrediction(null)
+  }
+
+  useEffect(() => {
+    const editor = editorRef.current
+
+    if (!editor || !prediction) {
+      return
+    }
+
+    const keydown = (event: KeyboardEvent) => {
+      if (
+        composing.current ||
+        event.isComposing ||
+        event.keyCode === 229 ||
+        event.shiftKey ||
+        event.ctrlKey ||
+        event.metaKey ||
+        event.altKey
+      ) {
+        return
+      }
+
+      if (event.key !== 'Tab' && event.key !== 'Escape') {
+        return
+      }
+
+      if (composerPlainText(editor) !== prediction.draft) {
+        return
+      }
+
+      event.preventDefault()
+      event.stopImmediatePropagation()
+
+      if (event.key === 'Tab') {
+        accept()
+      } else {
+        setPrediction(null)
+      }
+    }
+
+    editor.addEventListener('keydown', keydown, true)
+
+    return () => editor.removeEventListener('keydown', keydown, true)
+  })
+
+  // Deliberately no timer, draft sampler, focus handler or transcript subscription
+  // that generates. Only this explicit user action can spend a prediction call.
+  const request = async () => {
+    const editor = editorRef.current
+
+    if (!gateway || !sessionId || !editor || busy || blocked || loading || composing.current) {
+      return
+    }
+
+    const draft = composerPlainText(editor)
+
+    const context = conversation(messages.get())
+    const ticket = ++generation.current
+    setLoading(true)
+    setPrediction(null)
+    setEmpty(false)
+
+    try {
+      const result = await gateway.request<{ text: string }>(
+        'llm.oneshot',
+        {
+          session_id: sessionId,
+          template: 'prompt_suggestions',
+          input: context,
+          variables: { draft },
+          max_tokens: 128
+        },
+        7000
+      )
+
+      if (
+        ticket !== generation.current ||
+        composing.current ||
+        composerPlainText(editor) !== draft ||
+        conversation(messages.get()) !== context
+      ) {
+        return
+      }
+
+      const text = result.text?.trim()
+
+      if (text && text.startsWith(draft) && text !== draft && text.length <= 180) {
+        setPrediction({ text, draft, context })
+      } else {
+        setEmpty(true)
+      }
+    } catch {
+      if (ticket === generation.current) {
+        setEmpty(true)
+      }
+    } finally {
+      if (ticket === generation.current) {
+        setLoading(false)
+      }
+    }
+  }
+
+  return (
+    <Popover
+      onOpenChange={open => {
+        if (!open) {
+          setPrediction(null)
+          setEmpty(false)
+        }
+      }}
+      open={Boolean(prediction) || empty}
+    >
+      <PopoverAnchor asChild>
+        <span className="inline-flex shrink-0 items-center">
+          <Tip label={t.composer.promptSuggestionHint} placement="control">
+            <Button
+              aria-label={t.composer.suggestPrompt}
+              className="h-(--composer-control-size) gap-1 rounded-md px-2 text-xs font-normal text-(--ui-text-tertiary) hover:bg-(--chrome-action-hover) hover:text-foreground"
+              disabled={busy || blocked || loading || !gateway || !sessionId}
+              onClick={() => void request()}
+              onMouseDown={event => event.preventDefault()}
+              size="xs"
+              type="button"
+              variant="ghost"
+            >
+              <Codicon name={loading ? 'loading' : 'lightbulb'} spinning={loading} />
+              {!compact && t.composer.suggestPrompt}
+            </Button>
+          </Tip>
+        </span>
+      </PopoverAnchor>
+      <PopoverContent
+        align="end"
+        className="w-auto max-w-[min(26rem,calc(100vw-2rem))] p-2"
+        onCloseAutoFocus={event => event.preventDefault()}
+        onOpenAutoFocus={event => event.preventDefault()}
+        side="top"
+      >
+        {prediction ? (
+          <Button
+            className="h-auto whitespace-normal text-left"
+            onClick={accept}
+            onMouseDown={event => event.preventDefault()}
+            size="xs"
+            type="button"
+            variant="text"
+          >
+            <span>{prediction.text}</span>
+            <kbd>Tab</kbd>
+          </Button>
+        ) : (
+          <span className="text-xs text-muted-foreground" role="status">
+            {t.composer.noPromptSuggestion}
+          </span>
+        )}
+      </PopoverContent>
+    </Popover>
+  )
+}
