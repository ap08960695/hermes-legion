+        </span>
+        <span>
+          <Codicon name="circle-outline" />
+          {k.col.ready.label}
+          <b>{count.ready}</b>
+        </span>
+        <span>
+          <Codicon name="debug-pause" />
+          {k.col.blocked.label}
+          <b>{count.waiting}</b>
+        </span>
+      </div>
+    </div>
+  )
+}
+
+export function HistoryMore({
+  visible,
+  total,
+  onMore,
+  k
+}: {
+  visible: number
+  total: number
+  onMore: () => void
+  k: KanbanText
+}) {
