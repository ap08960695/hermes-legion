@@ -0,0 +1,120 @@
+"""Explicit extra boards extend read-only attribution without changing discovery."""
+import json
+import sqlite3
+
+import pytest
+
+from agent.usage_run_binding import key_id, run_digest
+from hermes_cli.usage_attribution import analyze
+from hermes_cli.usage_attribution_sources import collect
+
+
+def _fixture(tmp_path):
+    home = tmp_path / 'home'
+    key_dir = home / 'telemetry/cache-diagnostics'
+    key_dir.mkdir(parents=True)
+    key = b'k' * 32
+    (key_dir / 'fingerprint.key').write_bytes(key)
+    (key_dir / 'fingerprint.key').chmod(0o600)
+    logs = home / 'logs'
+    logs.mkdir()
+    board = tmp_path / 'separate' / 'kanban.db'
+    board.parent.mkdir()
+    with sqlite3.connect(board) as db:
+        db.execute('CREATE TABLE task_runs(id,task_id,worker_pid,worker_started_at,started_at,ended_at,outcome)')
+        db.execute("INSERT INTO task_runs VALUES(7,'t_test',NULL,NULL,94,105,'completed')")
+        db.execute('CREATE TABLE task_events(id,task_id,run_id,kind,payload)')
+        db.execute("INSERT INTO task_events VALUES(1,'t_test',7,'claimed',?)", (json.dumps({'attempt': {'reason': 'initial'}}),))
+    field = lambda n: {'complete': True, 'hash': f'{n:064x}'}
+    record = {'process_id': 42, 'status': 'returned', 'usage': {'input_tokens': 100, 'cached_tokens': 80},
+              'fingerprint': {'key_id': key_id(key), 'task_run': {'complete': True, 'hash': run_digest(key, board, 't_test', 7)},
+                              'cross_bot': {'namespace': 'a' * 16, 'started_at_ns': 100_000_000_000,
+                                            'fields': {'profile': field(1), 'request': field(2)}}}}
+    (logs / 'agent.log').write_text('CACHE_DIAGNOSTIC ' + json.dumps(record) + '\n')
+    return home, board
+
+
+def test_explicit_external_board_is_read_only_and_duplicate_paths_do_not_duplicate_runs(tmp_path):
+    home, board = _fixture(tmp_path)
+    alias = tmp_path / 'alias.db'
+    alias.symlink_to(board)
+    before = board.read_bytes()
+    raw, default_runs, _ = collect(home, 90, 110)
+    assert analyze(raw, default_runs, 90, 110)['run_correlation']['bound_attempts'] == 0
+
+    raw, runs, coverage = collect(home, 90, 110, extra_boards=[board, alias])
+    assert analyze(raw, runs, 90, 110)['run_correlation']['bound_attempts'] == 1
+    assert len(runs) == 1
+    assert len(coverage['boards']) == 1
+    assert board.read_bytes() == before
+
+
+def test_explicit_missing_board_is_reported_without_creating_a_database(tmp_path):
+    home, _ = _fixture(tmp_path)
+    missing = tmp_path / 'missing.db'
+    _, _, coverage = collect(home, 90, 110, extra_boards=[missing])
+    assert coverage['boards'][str(missing.resolve())]['status'] == 'unavailable'
+    assert not missing.exists()
+
+
+def test_extra_board_count_is_bounded(tmp_path):
+    home, _ = _fixture(tmp_path)
+    with pytest.raises(ValueError, match='64'):
+        collect(home, 90, 110, extra_boards=[tmp_path / f'{i}.db' for i in range(65)])
+
+
+def test_explicit_boards_keep_priority_within_global_board_budget(tmp_path):
+    home, board = _fixture(tmp_path)
+    native = home / 'kanban.db'
+    native.write_bytes(board.read_bytes())
+    requested = [board, *(tmp_path / f'missing-{i}.db' for i in range(63))]
+
+    raw, runs, coverage = collect(home, 90, 110, extra_boards=requested)
+    assert analyze(raw, runs, 90, 110)['run_correlation']['bound_attempts'] == 1
+    assert len(coverage['boards']) == 64
+    assert coverage['boards_omitted'] == 1
+    assert str(native) not in coverage['boards']
+
+
+def test_directory_board_is_unavailable_and_remains_untouched(tmp_path):
+    home, _ = _fixture(tmp_path)
+    directory = tmp_path / 'directory'
+    directory.mkdir()
+
+    _, _, coverage = collect(home, 90, 110, extra_boards=[directory])
+    assert coverage['boards'][str(directory.resolve())]['status'] == 'unavailable'
+    assert list(directory.iterdir()) == []
+
+
+def test_broken_symlink_loop_is_reported_as_unavailable(tmp_path):
+    home, _ = _fixture(tmp_path)
+    loop = tmp_path / 'loop.db'
+    loop.symlink_to(loop)
+
+    _, _, coverage = collect(home, 90, 110, extra_boards=[loop])
+    assert coverage['boards'][str(loop.absolute())]['status'] == 'unavailable'
+    assert loop.is_symlink()
+
+
+def test_cli_accepts_extra_board_option(tmp_path, monkeypatch, capsys):
+    from hermes_cli.usage_attribution import main
+
+    home, board = _fixture(tmp_path)
+    monkeypatch.setattr('sys.argv', ['usage_attribution', '--home', str(home), '--board', str(board)])
+    main()
+    result = json.loads(capsys.readouterr().out)
+    assert result['coverage']['boards'][str(board.resolve())]['status'] == 'read_only'
+    assert result['model_calls'] == 0 and result['runtime_mutations'] == 0
+
+
+def test_cli_rejects_too_many_extra_boards_before_reading(tmp_path, monkeypatch, capsys):
+    from hermes_cli.usage_attribution import main
+
+    home, board = _fixture(tmp_path)
+    arguments = ['usage_attribution', '--home', str(home)] + [item for _ in range(65) for item in ('--board', str(board))]
+    monkeypatch.setattr('sys.argv', arguments)
+
+    with pytest.raises(SystemExit) as exc:
+        main()
+    assert exc.value.code == 2
+    assert 'at most 64' in capsys.readouterr().err
diff --git a/tests/hermes_cli/test_usage_attribution_log_budget.py b/tests/hermes_cli/test_usage_attribution_log_budget.py
