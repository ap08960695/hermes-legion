+"""Onboarding declarations must load before the server binds its shared globals."""
+
+import importlib.util
+from pathlib import Path
+from typing import get_type_hints
+
+
+def test_onboarding_annotations_resolve_before_server_binding():
+    original = importlib.util.find_spec("tui_gateway.methods_onboarding")
+    assert original is not None and original.origin is not None
+    spec = importlib.util.spec_from_file_location("tui_gateway._onboarding_import_probe", original.origin)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+
+    assert get_type_hints(module._shared_nous_store)["return"] == tuple[Path, ...]
+    assert {"onboarding.state", "onboarding.set_run"} <= module._registry.names()
