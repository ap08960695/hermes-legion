+import json
+import logging
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_dispatch as kd
+from hermes_cli import kanban_dispatch_evidence as evidence
+
+
+def test_native_dispatch_records_stages_without_an_extra_spawn(all_assignees_spawnable, monkeypatch, caplog):
+    monkeypatch.setattr(kd, '_memory_pressure_level', lambda:'ok')
+    spawned=[]
+    with kbc.connect_closing() as conn:
+        tid=kb.create_task(conn,title='private title must not enter telemetry',assignee='worker')
+        caplog.set_level(logging.INFO,logger=evidence.__name__)
+        result=kd.dispatch_once(conn,spawn_fn=lambda t,w:spawned.append(t.id),max_spawn=2)
+        row=evidence.snapshot(result)
+        stages=row['tasks'][tid]
+        assert stages['considered_at'] <= stages['passed_dispatch_gates_at'] <= stages['claimed_at'] <= stages['spawn_returned_at']
+        assert stages['run_id']==kb.get_task(conn,tid).current_run_id
+        assert spawned==[tid]
+        assert row['capacity']['available_slots']==2
+        assert row['passed_dispatch_gates_not_claimed']==0
+    lines=[r.message for r in caplog.records if r.message.startswith('DISPATCH_EVIDENCE ')]
+    assert len(lines)==1 and 'private title' not in lines[0]
+
+
+def test_capacity_defer_is_not_reported_as_eligible(all_assignees_spawnable, monkeypatch):
+    monkeypatch.setattr(kd,'_memory_pressure_level',lambda:'ok')
+    with kbc.connect_closing() as conn:
+        a=kb.create_task(conn,title='a',assignee='worker');kb.claim_task(conn,a)
+        b=kb.create_task(conn,title='b',assignee='worker')
+        result=kd.dispatch_once(conn,max_spawn=1,spawn_fn=lambda *a: (_ for _ in ()).throw(AssertionError('must not spawn')),reconcile_orphans=False)
+        data=evidence.snapshot(result)
+        assert data['capacity']=={'reason':'board_cap','available_slots':0}
+        assert b not in data['tasks']
+        assert kb.get_task(conn,b).status=='ready'
+
+
+def test_unchanged_evidence_is_throttled_and_failure_does_not_retry(caplog):
+    caplog.set_level(logging.INFO,logger=evidence.__name__)
+    with kbc.connect_closing() as conn:
+        evidence._LAST.clear()
+        result=kd.DispatchResult()
+        for _ in range(10):evidence.emit(conn,result)
+    assert sum(r.message.startswith('DISPATCH_EVIDENCE ') for r in caplog.records)==1
+    evidence.emit(None,result)
