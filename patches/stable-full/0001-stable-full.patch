@@ -0,0 +1,11 @@
+import { readKey, writeKey } from '@/lib/storage'
+import { setInterfaceMode } from '@/store/interface-mode'
+
+const PRESENTATION_REVISION = 'hermes.desktop.focusPresentation.v1'
+/** Select the approved presentation once; both native layout scopes stay intact. */
+export function initializeFocusPresentation(onFocus: () => void = () => {}) {
+  if (readKey(PRESENTATION_REVISION) === '1') return
+  setInterfaceMode('simple')
+  onFocus()
+  writeKey(PRESENTATION_REVISION, '1')
+}
