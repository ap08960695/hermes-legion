+
+
+def _upload(sid,payload):
+    from hermes_cli.web_routers.files import _is_sensitive_filename,_fs_mime_type
+    if _is_sensitive_filename(payload.filename):raise ValueError('Credential files cannot be shared')
+    if '/' in payload.filename or '\\' in payload.filename:raise ValueError('Use a filename, not a path')
+    header,sep,content=payload.data_url.partition(',')
