+"""The native acceptance sandbox protects user state when the Hermes home is a symlink."""
+import sys
+
+import pytest
+
+from tests.e2e.core.upgrade import _helpers as H
+
+
+@pytest.mark.platforms('linux')
+def test_offloaded_hermes_home_is_read_only_in_the_native_sandbox(tmp_path, monkeypatch):
+    if not H.BWRAP_OK:
+        pytest.skip('bubblewrap user namespaces are unavailable')
+    user_home = tmp_path / 'user-home'
+    user_home.mkdir()
+    state = tmp_path / 'offloaded-state'
+    state.mkdir()
+    marker = state / 'preserve.txt'
+    marker.write_text('original')
+    (user_home / '.hermes').symlink_to(state, target_is_directory=True)
+    monkeypatch.setattr(H, 'REAL_HOME', user_home)
+    world = tmp_path / 'sandbox'
+    env = H.isolated_env(world)
+    program = (
+        'from pathlib import Path\n'
+        f'p = Path({str(user_home / ".hermes/preserve.txt")!r})\n'
+        'assert p.read_text() == "original"\n'
+        'try:\n'
+        '    p.write_text("changed")\n'
+        'except OSError:\n'
+        '    print("state protected")\n'
+        'else:\n'
+        '    raise AssertionError("sandbox allowed writes into protected user state")\n'
+    )
+    result = H.run([sys.executable, '-c', program], env=env, cwd=world, writable=[world])
+    assert result.returncode == 0, H.describe(result)
+    assert 'state protected' in result.stdout
+    assert marker.read_text() == 'original'
