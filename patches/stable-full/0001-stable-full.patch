+#define _GNU_SOURCE
+#include "ext-image-capture-source.h"
+#include "ext-image-copy-capture.h"
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <wayland-client.h>
+
+static struct wl_shm *shm;
+static struct wl_output *output;
+static struct ext_output_image_capture_source_manager_v1 *sources;
+static struct ext_image_copy_capture_manager_v1 *copies;
+static uint32_t width, height, format;
+static int ready, done, failed, compatible, transform;
+
+static void global(void *data, struct wl_registry *r, uint32_t name, const char *iface, uint32_t version) {
+  (void)data; (void)version;
+  if (!strcmp(iface, "wl_shm")) shm = wl_registry_bind(r, name, &wl_shm_interface, 1);
+  if (!strcmp(iface, "wl_output") && !output) output = wl_registry_bind(r, name, &wl_output_interface, 1);
+  if (!strcmp(iface, "ext_output_image_capture_source_manager_v1"))
+    sources = wl_registry_bind(r, name, &ext_output_image_capture_source_manager_v1_interface, 1);
+  if (!strcmp(iface, "ext_image_copy_capture_manager_v1"))
+    copies = wl_registry_bind(r, name, &ext_image_copy_capture_manager_v1_interface, 1);
+}
+static void removed(void *data, struct wl_registry *r, uint32_t name) {(void)data;(void)r;(void)name;}
+typedef struct ext_image_copy_capture_session_v1 session_t;
+typedef struct ext_image_copy_capture_frame_v1 frame_t;
+static void size(void *d, session_t *s, uint32_t w, uint32_t h) {(void)d;(void)s;width=w;height=h;}
+static void pixel_format(void *d, session_t *s, uint32_t value) {
+  (void)d;(void)s;
+  if (value == WL_SHM_FORMAT_XBGR8888 || value == WL_SHM_FORMAT_ABGR8888) {format=value;compatible=1;}
+}
+static void device(void *d, session_t *s, struct wl_array *a) {(void)d;(void)s;(void)a;}
+static void dma(void *d, session_t *s, uint32_t f, struct wl_array *a) {(void)d;(void)s;(void)f;(void)a;}
+static void complete(void *d, session_t *s) {(void)d;(void)s;done=1;}
+static void stop(void *d, session_t *s) {(void)d;(void)s;failed=1;}
+static void orientation(void *d, frame_t *f, uint32_t value) {(void)d;(void)f;transform=value;}
+static void damage(void *d, frame_t *f, int32_t x, int32_t y, int32_t w, int32_t h) {(void)d;(void)f;(void)x;(void)y;(void)w;(void)h;}
+static void presented(void *d, frame_t *f, uint32_t a, uint32_t b, uint32_t c) {(void)d;(void)f;(void)a;(void)b;(void)c;}
+static void captured(void *d, frame_t *f) {(void)d;(void)f;ready=1;}
+static void frame_failed(void *d, frame_t *f, uint32_t reason) {(void)d;(void)f;fprintf(stderr,"capture: %u\n",reason);failed=1;}
+
+int main(int argc, char **argv) {
+  if (argc != 2) return 1;
+  uint32_t crop = atoi(argv[1]);
+  struct wl_display *display = wl_display_connect(NULL);
+  if (!display) {fprintf(stderr,"no display\n"); return 1;}
+  struct wl_registry *registry = wl_display_get_registry(display);
+  struct wl_registry_listener registry_listener = {global, removed};
+  wl_registry_add_listener(registry, &registry_listener, NULL);
+  if (wl_display_roundtrip(display) < 0 || !shm || !output || !sources || !copies) {fprintf(stderr,"no protocol\n"); return 1;}
+
+  struct ext_image_capture_source_v1 *source = ext_output_image_capture_source_manager_v1_create_source(sources, output);
+  session_t *session = ext_image_copy_capture_manager_v1_create_session(copies, source, 0);
+  struct ext_image_copy_capture_session_v1_listener session_listener = {size, pixel_format, device, dma, complete, stop};
+  ext_image_copy_capture_session_v1_add_listener(session, &session_listener, NULL);
+  while (!done && !failed && wl_display_dispatch(display) >= 0) {}
+  if (!done || failed || !compatible || !width || !height || width > 8192 || height > 8192 || !crop || crop > height) {fprintf(stderr,"constraints: %d %d %d %u %u\n",done,failed,compatible,width,height); return 1;}
+
+  size_t length = width * height * 4U;
+  int fd = memfd_create("synthetic-strip", MFD_CLOEXEC);
+  if (fd < 0 || ftruncate(fd, length) < 0) return 1;
+  uint8_t *bytes = mmap(NULL, length, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  if (bytes == MAP_FAILED) return 1;
+  struct wl_shm_pool *pool = wl_shm_create_pool(shm, fd, length);
+  struct wl_buffer *buffer = wl_shm_pool_create_buffer(pool, 0, width, height, width*4, format);
+  frame_t *frame = ext_image_copy_capture_session_v1_create_frame(session);
+  struct ext_image_copy_capture_frame_v1_listener frame_listener = {orientation, damage, presented, captured, frame_failed};
+  ext_image_copy_capture_frame_v1_add_listener(frame, &frame_listener, NULL);
+  ext_image_copy_capture_frame_v1_attach_buffer(frame, buffer);
+  ext_image_copy_capture_frame_v1_damage_buffer(frame, 0, 0, width, height);
+  ext_image_copy_capture_frame_v1_capture(frame);
+  while (!ready && !failed && wl_display_dispatch(display) >= 0) {}
+  if (!ready || failed || transform != WL_OUTPUT_TRANSFORM_NORMAL) {fprintf(stderr,"completion: %d %d %d\n",ready,failed,transform); return 1;}
+
+  printf("P6\n%u %u\n255\n",width,crop);
+  for (uint32_t i = (height - crop)*width*4; i < length; i += 4) {
+    putchar(bytes[i]);putchar(bytes[i+1]);putchar(bytes[i+2]);
+  }
+  munmap(bytes, length);
+  close(fd);
+  wl_display_disconnect(display);
+  return ferror(stdout);
+}
