+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { act, cleanup, fireEvent, render, waitFor, within } from '@testing-library/react'
+import { atom, type WritableAtom } from 'nanostores'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+import { I18nProvider } from '@/i18n'
+
+const request = vi.hoisted(() => vi.fn())
+vi.mock('@/store/gateway', () => ({ requestGatewayForAgent: (...args: unknown[]) => request(...args) }))
+vi.mock('@/store/connections', () => ({ $activeConnectionId: atom<string | null>('local') }))
+vi.mock('@/store/settings-scope', () => ({ $settingsScopeProfile: atom('captain') }))
+
+import { $activeConnectionId } from '@/store/connections'
+import { $settingsScopeProfile } from '@/store/settings-scope'
+
+import { AccountUsagePanel } from './account-usage-panel'
+
+const reading = (label: string, provider = 'anthropic', remaining = 65) => ({
+  provider,
+  id: label,
+  label,
+  state: 'ready',
+  stale: false,
+  fetched_at: new Date().toISOString(),
+  windows: [
+    { label: 'Weekly', remaining_percent: remaining, used_percent: 100 - remaining, resets_at: null, scope: 'account' }
+  ]
+})
+
+function mount() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+
+  const view = render(
+    <QueryClientProvider client={client}>
+      <I18nProvider configClient={null} initialLocale="en">
+        <AccountUsagePanel />
+      </I18nProvider>
+    </QueryClientProvider>
+  )
+
+  return { ...view, client }
+}
+
+beforeEach(() => {
+  request.mockReset()
+  ;($activeConnectionId as WritableAtom<string | null>).set('local')
+  ;($settingsScopeProfile as WritableAtom<string>).set('captain')
+})
+afterEach(cleanup)
+
+it('reads cached per-account data on entry, exposes all providers and only probes on Refresh', async () => {
+  request.mockResolvedValue({
+    configured_route: { provider: 'anthropic', label: 'Anthropic', model: 'example-claude', local_endpoint: false },
+    accounts: [
+      reading('First'),
+      reading('Second', 'anthropic', 5),
+      reading('Codex login', 'openai-codex', 20),
+      {
+        ...reading('AGY login', 'antigravity-subscription-directsdk'),
+        windows: [],
+        state: 'unknown',
+        reason: 'Credential expired'
+      }
+    ]
+  })
+  const f = mount()
+  await f.findByText('First')
+  expect(f.getByText('example-claude')).toBeTruthy()
+  expect(request).toHaveBeenCalledExactlyOnceWith(
+    'local',
+    'captain',
+    'account.usage',
+    { profile: 'captain', refresh: false },
+    30000,
+    undefined,
+    { spawnPriority: 'foreground' }
+  )
+  expect(
+    within(f.getByRole('region', { name: 'Claude' }))
+      .getAllByRole('progressbar')
+      .map(el => el.getAttribute('aria-valuenow'))
+  ).toEqual(['65', '5'])
+  expect(
+    within(f.getByRole('region', { name: 'Codex' }))
+      .getByRole('progressbar')
+      .getAttribute('aria-valuenow')
+  ).toBe('20')
+  expect(within(f.getByRole('region', { name: 'AGY' })).queryByRole('progressbar')).toBeNull()
+  fireEvent.focus(window)
+  expect(request).toHaveBeenCalledTimes(1)
+  fireEvent.click(f.getByRole('button', { name: 'Refresh' }))
+  await waitFor(() => expect(request).toHaveBeenCalledTimes(2))
+  expect(request.mock.calls[1]?.[3]).toEqual({ profile: 'captain', refresh: true })
+})
+
+it('keeps Refresh focused and admits one probe while the selected account is busy', async () => {
+  let finish!: (value: unknown) => void
+  request.mockResolvedValue({ accounts: [reading('Cached reading')] })
+  const f = mount()
+  await f.findByText('Cached reading')
+  const refresh = f.getByRole('button', { name: 'Refresh' })
+  refresh.focus()
+  request.mockImplementation(() => new Promise(resolve => { finish = resolve }))
+
+  act(() => {
+    fireEvent.click(refresh)
+    fireEvent.click(refresh)
+  })
+  await waitFor(() => expect(refresh.getAttribute('aria-disabled')).toBe('true'))
+  expect(document.activeElement).toBe(refresh)
+  fireEvent.click(refresh)
+  expect(request).toHaveBeenCalledTimes(2)
+  expect(request.mock.calls[1]?.slice(0, 4)).toEqual([
+    'local', 'captain', 'account.usage', { profile: 'captain', refresh: true }
+  ])
+
+  await act(async () => finish({ accounts: [reading('Updated reading')] }))
+  await f.findByText('Updated reading')
+  expect(document.activeElement).toBe(refresh)
+  expect(refresh.getAttribute('aria-disabled')).toBe('false')
+})
+
+it('shows the pending probe when returning to its device and profile', async () => {
+  let finish!: (value: unknown) => void
+  request.mockImplementation((connection, _profile, _method, { refresh }) => {
+    if (refresh) return new Promise(resolve => { finish = resolve })
+    return Promise.resolve({ accounts: [reading(`Cached ${connection}`)] })
+  })
+
+  const f = mount()
+  await f.findByText('Cached local')
+  fireEvent.click(f.getByRole('button', { name: 'Refresh' }))
+  await waitFor(() => expect(finish).toBeTypeOf('function'))
+
+  const connection = $activeConnectionId as WritableAtom<string | null>
+  act(() => connection.set('second'))
+  await f.findByText('Cached second')
+  const otherRefresh = f.getByRole('button', { name: 'Refresh' })
+  await waitFor(() => expect(otherRefresh.getAttribute('aria-disabled')).toBe('false'))
+
+  act(() => connection.set('local'))
+  await waitFor(() => expect(f.client.isFetching()).toBe(0))
+  const pending = f.getByRole('button', { name: /^Refreshing/ })
+  expect(pending.getAttribute('aria-disabled')).toBe('true')
+  fireEvent.click(pending)
+  expect(request.mock.calls.filter(([, , , params]) => params.refresh)).toHaveLength(1)
+
+  await act(async () => finish({ accounts: [reading('Refreshed local')] }))
+  await f.findByText('Refreshed local')
+  expect(f.getByRole('button', { name: 'Refresh' }).getAttribute('aria-disabled')).toBe('false')
+})
+
+it('never renders expired percentages as current quota', async () => {
+  request.mockResolvedValue({
+    accounts: [{ ...reading('Old'), fetched_at: new Date(Date.now() - 901000).toISOString() }]
+  })
+  const f = mount()
+  await f.findByText('Stale reading')
+  expect(f.queryByRole('progressbar')).toBeNull()
+  expect(f.queryByText('Remaining: 65%')).toBeNull()
+})
+
+it('marks only an elapsed quota window stale until a manual refresh', async () => {
+  const account = reading('Fixture account', 'anthropic', 54)
+  const weekly = { ...account.windows[0], resets_at: new Date(Date.now() + 120_000).toISOString() }
+  const elapsed = { ...weekly, label: 'Session', remaining_percent: 7, used_percent: 93,
+    resets_at: new Date(Date.now() - 1_000).toISOString() }
+  const undated = { ...account.windows[0], label: 'Undated' }
+  const renewed = { ...elapsed, resets_at: weekly.resets_at, remaining_percent: 81, used_percent: 19 }
+  request
+    .mockResolvedValueOnce({ accounts: [{ ...account, windows: [elapsed, weekly, undated] }] })
+    .mockResolvedValueOnce({ accounts: [{ ...account, windows: [renewed, weekly, undated] }] })
+  const f = mount()
+
+  await f.findByText('Fixture account')
+  expect(f.getByText('Stale reading')).toBeTruthy()
+  expect(f.queryByRole('progressbar', { name: /Session/ })).toBeNull()
+  expect(f.getByRole('progressbar', { name: /Weekly/ }).getAttribute('aria-valuenow')).toBe('54')
+  expect(f.getByRole('progressbar', { name: /Undated/ }).getAttribute('aria-valuenow')).toBe('54')
+  expect(request).toHaveBeenCalledTimes(1)
+
+  fireEvent.click(f.getByRole('button', { name: 'Refresh' }))
+  expect((await f.findByRole('progressbar', { name: /Session/ })).getAttribute('aria-valuenow')).toBe('81')
+  expect(f.queryByText('Stale reading')).toBeNull()
+  expect(request).toHaveBeenCalledTimes(2)
+})
+
+it('keeps the reset time focused when its quota window becomes stale', async () => {
+  vi.useFakeTimers({ toFake: ['Date', 'setInterval', 'clearInterval'] })
+  try {
+    const account = reading('Fixture account')
+    const reset = new Date(Date.now() + 15_000).toISOString()
+    request.mockResolvedValue({
+      accounts: [{ ...account, windows: [{ ...account.windows[0], resets_at: reset }] }]
+    })
+    const f = mount()
+    await f.findByRole('progressbar')
+    const time = f.container.querySelector<HTMLTimeElement>(`time[datetime="${reset}"]`)!
+    time.focus()
+    expect(document.activeElement).toBe(time)
+
+    act(() => vi.advanceTimersByTime(31_000))
+    expect(f.getByText('Stale reading')).toBeTruthy()
+    expect(f.queryByRole('progressbar')).toBeNull()
+    expect(f.container.querySelector(`time[datetime="${reset}"]`)).toBe(time)
+    expect(document.activeElement).toBe(time)
+    expect(request).toHaveBeenCalledTimes(1)
+  } finally {
+    cleanup()
+    vi.useRealTimers()
+  }
+})
+
+it('fences a late refresh by both connection and owning profile', async () => {
+  let resolve!: (value: unknown) => void
+  request.mockResolvedValue({ accounts: [reading('Captain')] })
+  const f = mount()
+  await f.findByText('Captain')
+  request.mockImplementationOnce(
+    () =>
+      new Promise(r => {
+        resolve = r
+      })
+  )
+  fireEvent.click(f.getByRole('button', { name: 'Refresh' }))
+  request.mockResolvedValue({ accounts: [reading('Other profile')] })
+  await waitFor(() => expect(request).toHaveBeenCalledTimes(2))
+  act(() => {
+    ;($settingsScopeProfile as WritableAtom<string>).set('worker')
+    ;($activeConnectionId as WritableAtom<string | null>).set('remote')
+  })
+  await f.findByText('Other profile')
+  await act(async () => resolve({ accounts: [reading('Late captain')] }))
+  expect(f.queryByText('Late captain')).toBeNull()
+  expect(request.mock.calls.at(-1)?.slice(0, 2)).toEqual(['remote', 'worker'])
+})
+
+it('keeps a failed request retryable without exposing server error payloads', async () => {
+  request.mockRejectedValue(new Error('private-error-detail'))
+  const f = mount()
+  await f.findByRole('alert')
+  expect(f.queryByText(/private-error/)).toBeNull()
+  expect(f.queryByRole('region', { name: 'Provider not reported' })).toBeNull()
+  request.mockResolvedValue({ accounts: [reading('Recovered')] })
+  fireEvent.click(f.getByRole('button', { name: 'Refresh' }))
+  await f.findByText('Recovered')
+  expect(f.queryByRole('alert')).toBeNull()
+  expect(f.getByRole('region', { name: 'Provider not reported' })).toBeTruthy()
+
+  request.mockRejectedValueOnce(new Error('fixture-refresh-failed'))
+  fireEvent.click(f.getByRole('button', { name: 'Refresh' }))
+  await f.findByRole('alert')
+  expect(f.getByText('Recovered')).toBeTruthy()
+  expect(f.getByRole('progressbar').getAttribute('aria-valuenow')).toBe('65')
+})
+
+it('treats a reading fetched after mount as fresh immediately', async () => {
+  const clock = vi.spyOn(Date, 'now').mockReturnValue(100000)
+  let resolve!: (value: unknown) => void
+  request.mockImplementationOnce(
+    () =>
+      new Promise(r => {
+        resolve = r
+      })
+  )
+  const f = mount()
+
+  try {
+    clock.mockReturnValue(101000)
+    await act(async () =>
+      resolve({ accounts: [{ ...reading('New reading'), fetched_at: new Date(101000).toISOString() }] })
+    )
+    await f.findByRole('progressbar')
+    expect(f.queryByText('Stale reading')).toBeNull()
+  } finally {
+    clock.mockRestore()
+  }
+})
+
+
+it('shows Gemini API separately from AGY and uses unknown quota when Gemini has no reading', async () => {
+  request.mockResolvedValue({
+    configured_route: { provider: 'gemini', model: 'example-gemini', local_endpoint: false },
+    accounts: [reading('Subscription login', 'antigravity-subscription-directsdk', 80)]
+  })
+  const f = mount()
+  const gemini = within(await f.findByRole('region', { name: 'Gemini API' }))
+  expect(gemini.getByText('example-gemini')).toBeTruthy()
+  expect(gemini.getByText('Provider does not report quota')).toBeTruthy()
+  expect(gemini.queryByRole('progressbar')).toBeNull()
+  expect(within(f.getByRole('region', { name: 'AGY' })).getByRole('progressbar')).toBeTruthy()
+})
+
+it('shows a NIM snapshot with a timestamp, then retires that view on a same-profile device switch', async () => {
+  request.mockResolvedValue({
+    configured_route: { provider: 'nim', model: 'example-nim', local_endpoint: false },
+    accounts: [reading('Provider login', 'nvidia', 0)]
+  })
+  const f = mount()
+  const nim = within(await f.findByRole('region', { name: 'NVIDIA NIM' }))
+  expect(nim.getByRole('progressbar').getAttribute('aria-valuenow')).toBe('0')
