+def test_registered_handler_uses_cache_and_native_still_enforces_budget(scope, monkeypatch):
+    from tools.registry import registry
+    image, _ = scope
+    monkeypatch.setattr(cache, 'CACHE', cache.VisionCache())
+    monkeypatch.setattr(vision, '_should_use_native_vision_fast_path', lambda: False)
+    calls = []
+    async def uncached(*args, **kwargs):
+        calls.append(1)
