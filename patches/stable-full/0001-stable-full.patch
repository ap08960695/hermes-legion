@@ -0,0 +1,66 @@
+import { beforeEach, expect, it } from 'vitest'
+
+import {
+  $perSessionBrowse,
+  browseBackward,
+  browseForward,
+  isBrowsingHistory,
+  resetBrowseState
+} from '@/store/composer-input-history'
+
+beforeEach(() => $perSessionBrowse.set({}))
+
+it('retires finished browse cursors instead of retaining every visited session', () => {
+  browseBackward('still-browsing', 'Keep this draft', ['Earlier question'])
+
+  for (let index = 0; index < 1000; index++) {
+    const id = 'visited-' + index
+    browseBackward(id, '', ['Earlier question'])
+    resetBrowseState(id)
+  }
+
+  expect(Object.keys($perSessionBrowse.get())).toEqual(['still-browsing'])
+  expect(browseForward('still-browsing', ['Earlier question'])).toEqual({
+    text: 'Keep this draft',
+    returnedToPresent: true
+  })
+  expect(Object.keys($perSessionBrowse.get())).toEqual([])
+})
+
+it('does not allocate an inactive cursor for a forward request with no active browse', () => {
+  expect(browseForward('never-browsed', ['Earlier question'])).toBeNull()
+  expect(Object.keys($perSessionBrowse.get())).toEqual([])
+})
+
+it('stays within a newly shortened live history instead of returning undefined text', () => {
+  browseBackward('history-trimmed', 'Keep my draft', ['Fourth', 'Third', 'Second', 'First'])
+  browseBackward('history-trimmed', '', ['Fourth', 'Third', 'Second', 'First'])
+  browseBackward('history-trimmed', '', ['Fourth', 'Third', 'Second', 'First'])
+  expect(browseForward('history-trimmed', ['Only retained question'])).toEqual({
+    text: 'Only retained question',
+    returnedToPresent: false
+  })
+  expect(browseForward('history-trimmed', ['Only retained question'])).toEqual({
+    text: 'Keep my draft',
+    returnedToPresent: true
+  })
+})
+
+it.each(['backward', 'forward'])('restores the original draft when live history disappears (%s)', direction => {
+  browseBackward('history-gone', 'Original draft', ['Earlier question'])
+
+  const result =
+    direction === 'backward'
+      ? browseBackward('history-gone', 'Earlier question', [])
+      : browseForward('history-gone', [])?.text
+
+  expect(result).toBe('Original draft')
+  expect(isBrowsingHistory('history-gone')).toBe(false)
+  expect(Object.keys($perSessionBrowse.get())).toEqual([])
+})
+
+it('rebases an out-of-range backward cursor onto the oldest remaining question', () => {
+  browseBackward('history-trimmed', '', ['Fourth', 'Third', 'Second'])
+  browseBackward('history-trimmed', '', ['Fourth', 'Third', 'Second'])
+  expect(browseBackward('history-trimmed', '', ['Only retained question'])).toBe('Only retained question')
+})
