+
+def test_capture_maps_complete_scoped_ax_without_pixels_or_raw_attributes(adapter):
+    _, backend, calls = adapter
+    result = backend.capture(mode='ax', app='Fixture')
+    assert result.mode == 'ax' and result.app == 'Fixture' and result.window_title == 'Fixture window'
+    assert result.png_b64 is None and (result.width, result.height) == (0, 0)
