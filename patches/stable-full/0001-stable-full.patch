+it.each(['visible', 'filtered', 'focus moved'])('restores focus when All work removes the active button (%s)', async scenario => {
+  const dispose = registerPluginLocales('kanban', KANBAN_LOCALES)
+  const client = new QueryClient()
+  const task = { id: 'focus-card', title: 'Navigation case', status: 'done' }
+  const other = { id: 'other-card', title: 'Other case', status: 'done' }
+  const show = (tasks: typeof task[]) => (
+    <QueryClientProvider client={client}>
+      <WorkView
+        board={{ columns: [{ name: 'done', tasks }], tenants: [], assignees: [], now: 1, latest_event_id: 1 }}
+        onOpen={vi.fn()}
+      />
+    </QueryClientProvider>
+  )
+  io.read.mockResolvedValue({ task, runs: [] })
+
+  try {
+    const view = render(show([task, other]))
+    const card = screen.getByRole('button', { name: task.title })
+    fireEvent.click(card)
+    await screen.findByRole('article', { name: task.title })
+    if (scenario === 'filtered') view.rerender(show([other]))
+
+    const allCards = screen.getByRole('button', { name: 'All work' })
+    const focused = scenario === 'focus moved' ? screen.getByRole('button', { name: other.title }) : allCards
+    focused.focus()
+    fireEvent.click(allCards)
+
+    expect(screen.queryByRole('article', { name: task.title })).toBeNull()
+    expect(screen.queryByRole('button', { name: 'All work' })).toBeNull()
+    expect(document.activeElement).toBe(
+      scenario === 'visible' ? card : scenario === 'filtered' ? screen.getByRole('navigation') : focused
+    )
+    expect(io.read).toHaveBeenCalledTimes(1)
+    expect(io.write).not.toHaveBeenCalled()
+  } finally {
+    cleanup()
+    client.clear()
+    dispose()
+  }
+})
