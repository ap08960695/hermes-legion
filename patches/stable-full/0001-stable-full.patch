+  fireEvent.click(screen.getByText('Review an ACTION step'))
+  const check = screen.getByRole('button', { name: 'Check declared writes' })
+  fireEvent.click(check)
+  const conflict = await screen.findByRole('button', { name: 'Test config' })
+  const proceed = screen.getByRole('button', { name: 'Proceed' })
+  const path = screen.getByRole('textbox', { name: /Absolute path/ })
+  let fail!: () => void
+  rest.mockImplementationOnce(() => new Promise((_, reject) => {
+    fail = () => reject(new Error('Fixture check failed'))
+  }))
+
+  check.focus()
+  act(() => {
+    fireEvent.click(check)
+    fireEvent.click(check)
+  })
