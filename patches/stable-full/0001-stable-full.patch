@@ -0,0 +1,78 @@
+"""Import validated native creator packs without replacing installed entries."""
+from __future__ import annotations
+
+import ctypes
+import errno
+import json
+import logging
+import os
+from pathlib import Path
+import shutil
+import tempfile
+
+from agent.pet import store
+from agent.pet.pack import load_pack
+from hermes_platform.host import facts
+
+logger = logging.getLogger(__name__)
+
+
+def _publish_new_directory(source: Path, target: Path) -> None:
+    """One native publication point; never fall back to an overwriting rename."""
+    family = facts.os_family()
+    if family == "win32":
+        os.rename(source, target)
+        return
+    if family not in ("darwin", "linux"):
+        raise OSError(errno.ENOTSUP, "atomic no-replace import is unavailable")
+    libc = ctypes.CDLL(None, use_errno=True)
+    function = getattr(libc, "renamex_np" if family == "darwin" else "renameat2", None)
+    if function is None:
+        raise OSError(errno.ENOTSUP, "atomic no-replace import is unavailable")
+    src, dst = os.fsencode(source), os.fsencode(target)
+    if family == "darwin":
+        function.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint]
+        arguments = (src, dst, 4)  # Darwin RENAME_EXCL.
+    else:
+        function.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
+        arguments = (-100, src, -100, dst, 1)  # Linux AT_FDCWD, RENAME_NOREPLACE.
+    function.restype = ctypes.c_int
+    if function(*arguments) != 0:
+        error = ctypes.get_errno()
+        raise OSError(error, os.strerror(error), os.fspath(target))
+
+
+def import_pack(source: Path, slug: str) -> tuple[store.InstalledPet, list[str]]:
+    """Copy one checked snapshot into the current profile; selection stays explicit."""
+    if not isinstance(slug, str) or not slug or len(slug) > 64 or store.slugify(slug) != slug:
+        raise ValueError("slug must be canonical lowercase letters/digits/hyphens, 1-64 characters")
+    report, data = load_pack(source)
+    if not report["ok"]:
+        raise ValueError("; ".join(report["errors"]))
+    meta = report["pack"]
+    root = store.pets_dir().resolve()
+    target = root / slug
+    weight = meta.get("motion_weight")
+    pet = store.InstalledPet(slug, meta["name"], "", target, target / meta["spritesheet"], motion_weight=weight)
+    staged = Path(tempfile.mkdtemp(prefix=".pet-import-", dir=root))
+    try:
+        payload = staged / "payload"
+        payload.mkdir(mode=0o700)
+        pet_meta = {"id": slug, "displayName": meta["name"], "description": "", "spritesheetPath": meta["spritesheet"]}
+        if weight is not None:
+            pet_meta["motionWeight"] = weight
+        files = {
+            "manifest.json": (json.dumps(meta, ensure_ascii=False, indent=2) + "\n").encode("utf-8"),
+            "pet.json": (json.dumps(pet_meta, ensure_ascii=False, indent=2) + "\n").encode("utf-8"),
+            meta["spritesheet"]: data,
+        }
+        for name, content in files.items():
+            (payload / name).write_bytes(content)
+        # shortcut: atomic visibility only; sync files/directories before promising crash durability.
+        _publish_new_directory(payload, target)
+        return pet, report["warnings"]
+    finally:
+        try:
+            shutil.rmtree(staged)
+        except OSError as exc:
+            logger.warning("Pet import staging cleanup failed for %s: %s", staged, exc)
