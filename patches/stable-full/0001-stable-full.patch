+        if term not in self.options:
+            choices = []
+            for char in term.lower():
+                codes = (ord(char), ord(char.upper()), *FOLD_ALIASES.get(ord(char), ()))
+                if any(code > 0xffff for code in codes):
+                    return True  # unsupported representations fail open
+                choices.append((char, tuple('u' + format(code, '04x') for code in codes)))
+            self.options[term] = choices
+        position = 0
+        for char, escaped in self.options[term]:
+            if deadline is not None and time.monotonic() >= deadline:
+                raise TimeoutError('structured global search timed out')
+            index = text.find(char, position)
+            best = len(text) + 1 if index < 0 else index + 1
+            if best != position + 1:
+                for variant in escaped:
+                    found = text.find(variant, position, best)
+                    if found >= 0:
+                        best = min(best, found + len(variant))
+            if best > len(text):
+                return False
+            position = best
+        return True
