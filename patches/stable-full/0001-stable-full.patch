+import { ambientOwnerConnectionId, resolveOwnerNow } from '@/api/client'
+
+import type { SessionOwnerScope } from './session-request-router'
+import { knownOwnerForSession, runtimeSessionOwner } from './session-states'
+
+/** Explicit surface route, then native runtime owner, then durable ownership, then the current new-chat route. */
+export function sessionDraftOwner(
+  sessionId: string | null | undefined,
+  explicit?: SessionOwnerScope
+): SessionOwnerScope {
+  const known = explicit ?? runtimeSessionOwner(sessionId) ?? knownOwnerForSession(sessionId)
+
+  if (known != null) {
+    return typeof known === 'object' ? { ...known } : known
+  }
+
+  const ambient = resolveOwnerNow()
+  const profile = ambient.profile || 'default'
+
+  const connectionId = ambientOwnerConnectionId()
+
+  return connectionId ? { connectionId, profile } : profile
+}
+
+/** Creation already captured these fields before its first await. */
+export function createdDraftOwner(route: SessionOwnerScope, profile: string): SessionOwnerScope {
+  return route ?? profile
+}
