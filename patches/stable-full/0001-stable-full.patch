@@ -0,0 +1,94 @@
+import { useStore } from '@nanostores/react'
+import { useEffect, useMemo } from 'react'
+
+import { DesktopCharacters } from '@/plugins/hermes-bots/desktop-characters'
+import { $botPluginCtx } from '@/plugins/hermes-bots/shared'
+import { $characterSettings, characterScope, characterSizes, getCharacterSettings, hasCharacterSettings, isCharacterSize, migrateLegacyCharacterSettings, setCharacterSettings } from '@/store/character-settings'
+import { $activeConnectionId } from '@/store/connections'
+import { activeGateway } from '@/store/gateway'
+import { initPetOverlayBridge } from '@/store/pet-overlay'
+import { $activeGatewayProfile } from '@/store/profile'
+import { $gatewayState } from '@/store/session'
+
+const currentScope = () => characterScope($activeConnectionId.get(), $activeGatewayProfile.get())
+
+function useCharacterControls() {
+  const connectionId = useStore($activeConnectionId)
+  const profile = useStore($activeGatewayProfile)
+  const ctx = useStore($botPluginCtx)
+  const settingsCache = useStore($characterSettings)
+  const scope = characterScope(connectionId, profile)
+  const { enabled, size } = settingsCache[scope] ?? getCharacterSettings(scope)
+  const overlay = window.hermesDesktop?.petOverlay
+  const supported = useMemo(() => overlay && overlay.supportsCharacters?.() !== false, [overlay])
+  const available = Boolean(connectionId && ctx?.pet.previewCharacters && supported)
+
+  return { available, connectionId, enabled, profile, scope, size }
+}
+
+export function CharacterController() {
+  const { available, connectionId, enabled, profile, scope, size } = useCharacterControls()
+  const menu = window.hermesDesktop?.characterMenu
+  const gatewayState = useStore($gatewayState)
+
+  useEffect(initPetOverlayBridge, [])
+
+  useEffect(() => {
+    if (!available || gatewayState !== 'open' || hasCharacterSettings(scope)) {return}
+    const gateway = activeGateway()
+
+    if (!gateway) {return}
+    let retired = false
+
+    void gateway.request<{ config?: { display?: { pet?: { enabled?: unknown; scale?: unknown } } } }>(
+      'config.get', { key: 'full' }, 8_000
+    ).then(reply => {
+      if (!retired && reply?.config && scope === currentScope() && activeGateway() === gateway) {
+        migrateLegacyCharacterSettings(scope, reply.config.display?.pet)
+      }
+    }, () => { /* Retry on the next connection or profile activation. */ })
+
+    return () => {retired = true}
+  }, [available, gatewayState, scope])
+
+  useEffect(() => {
+    if (!menu) {return}
+    return menu.onAction(action => {
+      if (available && action.scope === scope && scope === currentScope()) {setCharacterSettings(scope, action.change)}
+    })
+
+  }, [available, menu, scope])
+
+  useEffect(() => () => menu?.setState(null), [menu])
+
+  useEffect(() => {
+    menu?.setState(available ? { enabled, scope, size } : null)
+  }, [available, enabled, menu, scope, size])
+
+  return available && enabled && connectionId && gatewayState === 'open'
+    ? <DesktopCharacters connectionId={connectionId} key={scope} profile={profile} size={size} />
+    : null
+}
+
+export function CharacterControls() {
+  const { available, enabled, scope, size } = useCharacterControls()
+
+  if (!available) {return null}
+
+  return (
+    <div aria-label="Desktop Characters" className="flex shrink-0 items-center gap-1 px-1 text-xs" role="group">
+      <button aria-checked={enabled} className="rounded px-1 focus-visible:outline-2" data-characters-switch
+        onClick={() => {if (scope === currentScope()) {setCharacterSettings(scope, { enabled: !getCharacterSettings(scope).enabled })}}}
+        role="switch" type="button">
+        Characters <span aria-hidden="true">{enabled ? 'On' : 'Off'}</span>
+      </button>
+      <select aria-label="Character size" className="rounded bg-transparent focus-visible:outline-2" onChange={event => {
+        const next = event.currentTarget.value
+
+        if (scope === currentScope() && isCharacterSize(next)) {setCharacterSettings(scope, { size: next })}
+      }} value={size}>
+        {characterSizes.map(option => <option key={option} value={option}>{option[0].toUpperCase() + option.slice(1)}</option>)}
+      </select>
+    </div>
+  )
+}
