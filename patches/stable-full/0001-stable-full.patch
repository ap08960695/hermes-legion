+import sys
+import textwrap
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+import hermes_yaml as yaml
+
+
+@pytest.fixture
+def fleet(tmp_path, monkeypatch):
+    root = tmp_path / 'fleet'
+    root.mkdir()
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setenv('HERMES_HOME', str(root))
+    monkeypatch.setenv('HERMES_ROOT', str(root))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(root))
+    for key in ('HERMES_KANBAN_TASK', 'HERMES_KANBAN_RUN_ID', 'HERMES_KANBAN_DB', 'HERMES_KANBAN_BOARD'):
+        monkeypatch.delenv(key, raising=False)
+    for name, tools in [('alpha', ['terminal']), ('beta', ['file'])]:
+        home = root / 'profiles' / name
+        home.mkdir(parents=True)
+        library = tmp_path / ('library-' + name)
+        for directory, skill in [(library, 'external-' + name), (home / 'skills', 'local-' + name)]:
+            path = directory / skill
+            path.mkdir(parents=True)
+            (path / 'SKILL.md').write_text('---\nname: ' + skill + '\ndescription: Synthetic fixture\n---\nFixture.\n')
+        (home / '.env').write_text('SKILL_LIBRARY=' + str(library) + '\n')
+        (home / 'config.yaml').write_text(yaml.safe_dump({
+            'model': {'default': 'synthetic-model'},
+            'platform_toolsets': {'cli': tools},
+            'skills': {'external_dirs': ['${SKILL_LIBRARY}']},
+        }))
+    from hermes_cli import config
+    config._LOAD_CONFIG_CACHE.clear()
+    yield root
+    config._LOAD_CONFIG_CACHE.clear()
+
+
+def test_toolsets_honor_managed_config(fleet, tmp_path, monkeypatch):
+    from tools import kanban_tools
+    managed = tmp_path / 'managed'
+    managed.mkdir()
+    (managed / 'config.yaml').write_text('platform_toolsets:\n  cli: [terminal]\n')
+    monkeypatch.setenv('HERMES_MANAGED_DIR', str(managed))
+    assert kanban_tools._profile_toolsets('beta') == {'terminal'}
