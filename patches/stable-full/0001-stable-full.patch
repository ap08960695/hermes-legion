@@ -0,0 +1,149 @@
+"""Cache diagnostics at the real provider-call seam; no provider/network requests."""
+import copy
+import json
+import logging
+from types import SimpleNamespace
+
+from agent.turn_api_call import perform_api_call
+
+
+def invoke(monkeypatch, request, next_call):
+    from hermes_cli import plugins
+    monkeypatch.setattr(plugins, '_delivery_manager', lambda: SimpleNamespace(_middleware={}))
+    agent = SimpleNamespace(
+        api_mode='codex_responses', provider='openai-codex', model='gpt-6-astra',
+        session_id='session-secret', platform='tui', base_url='https://chatgpt.com/backend-api/codex',
+        _has_stream_consumers=lambda: True, _get_transport=lambda: SimpleNamespace(
+            preflight_kwargs=lambda kw, **_: dict(kw)),
+        _is_copilot_url=lambda: False, _is_codex_backend=lambda: True,
+        _interruptible_streaming_api_call=lambda kw, **_: next_call(kw),
+        _has_pending_redirect=lambda: False,
+    )
+    return perform_api_call(agent, api_kwargs=request, _original_api_kwargs=request,
+        _llm_middleware_trace=[], _moa_prepared_request=None, _retry=None,
+        thinking_spinner=None, retry_count=0, api_call_count=1, api_request_id='request-secret',
+        effective_task_id='task', turn_id='turn', interrupted=False)
+
+
+def records(caplog):
+    return [json.loads(r.getMessage().split('CACHE_DIAGNOSTIC ', 1)[1])
+            for r in caplog.records if r.getMessage().startswith('CACHE_DIAGNOSTIC ')]
+
+
+def request():
+    return {'model':'gpt-6-astra','instructions':'private instructions',
+            'tools':[{'type':'function','name':'one','description':'private schema'}],
+            'input':[{'role':'user','content':'private text ' * 12000}],
+            'prompt_cache_key':'secret-key', 'extra_headers':{'Authorization':'Bearer SECRET'}}
+
+
+def test_real_call_records_cached_usage_without_mutation_or_extra_calls(monkeypatch, caplog):
+    req=request(); original=copy.deepcopy(req); calls=[]
+    response=SimpleNamespace(usage=SimpleNamespace(input_tokens=12000,
+        input_tokens_details=SimpleNamespace(cached_tokens=10000)),id='response-secret')
+    def send(kw):
+        calls.append(kw); return response
+    with caplog.at_level(logging.INFO):
+        assert invoke(monkeypatch,req,send).response is response
+    assert len(calls)==1 and req==original
+    rows=records(caplog)
+    assert len(rows)==1, 'real provider-call path lacks cache-prefix diagnostics'
+    assert rows[0]['usage']=={'input_tokens':12000,'cached_tokens':10000,'cache_write_tokens':None}
+    assert 'private' not in json.dumps(rows) and 'SECRET' not in json.dumps(rows)
+
+
+def test_fingerprints_survive_resume_and_detect_prefix_changes(tmp_path):
+    from agent.cache_request_diagnostics import fingerprint
+    req=request(); kw={'key':b'k'*32,'session_id':'same','request_id':'a','base_url':'https://chatgpt.com'}
+    first=fingerprint(req,**kw)
+    resumed=fingerprint(json.loads(json.dumps(req)),**{**kw,'request_id':'b'})
+    for field in ['route','session','instructions','tools','options','history']:
+        assert first[field]==resumed[field]
+    req['input'].append({'role':'user','content':'new suffix'})
+    appended=fingerprint(req,**kw)
+    assert first['history']['prefixes']==appended['history']['prefixes']
+    assert first['history']['hash']!=appended['history']['hash']
+    req['input'][0]['content']='changed first bytes'+req['input'][0]['content']
+    changed=fingerprint(req,**kw)
+    assert first['history']['prefixes']['4096']!=changed['history']['prefixes']['4096']
+    req['instructions']='new instructions'
+    assert fingerprint(req,**kw)['instructions']!=first['instructions']
+    req['tools'].append({'type':'function','name':'two'})
+    two=fingerprint(req,**kw)
+    req['tools'].reverse()
+    assert fingerprint(req,**kw)['tools']!=two['tools']
+
+
+def test_profile_keys_are_durable_private_and_isolated(tmp_path):
+    from agent.cache_request_diagnostics import _profile_key, fingerprint
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    keys=[]
+    for home in [tmp_path/'a',tmp_path/'b',tmp_path/'a']:
+        token=set_hermes_home_override(home)
+        try: keys.append(_profile_key())
+        finally: reset_hermes_home_override(token)
+    assert keys[0]==keys[2] and keys[0]!=keys[1]
+    assert (tmp_path/'a/telemetry/cache-diagnostics/fingerprint.key').stat().st_mode & 0o777==0o600
+    kw={'session_id':'same','request_id':'a','base_url':'https://chatgpt.com'}
+    assert fingerprint(request(),key=keys[0],**kw)['history']!=fingerprint(request(),key=keys[1],**kw)['history']
+
+
+def test_missing_usage_is_unknown_not_zero(monkeypatch,caplog):
+    with caplog.at_level(logging.INFO):
+        invoke(monkeypatch,request(),lambda _:SimpleNamespace(usage=SimpleNamespace(input_tokens=10)))
+    assert records(caplog)[0]['usage']['cached_tokens'] is None
+
+
+def test_diagnostic_failure_cannot_retry_or_hide_provider_failure(monkeypatch,caplog):
+    import pytest
+    from agent import cache_request_diagnostics as diag
+    def broken(): raise OSError('SECRET must not be logged')
+    monkeypatch.setattr(diag,'_profile_key',broken)
+    calls=[]; failure=RuntimeError('provider-secret')
+    def send(kw): calls.append(kw); raise failure
+    with caplog.at_level(logging.INFO), pytest.raises(RuntimeError) as exc:
+        invoke(monkeypatch,request(),send)
+    assert exc.value is failure and len(calls)==1
+    assert records(caplog)[0]['fingerprint']['unavailable']
+    assert 'SECRET' not in caplog.text and 'provider-secret' not in caplog.text
+
+
+def test_log_failure_does_not_change_success(monkeypatch):
+    from agent import cache_request_diagnostics as diag
+    def broken(*args,**kwargs): raise OSError('disk failure')
+    monkeypatch.setattr(diag.logger,'info',broken)
+    response=object(); calls=[]
+    def send(kw): calls.append(kw); return response
+    assert invoke(monkeypatch,request(),send).response is response
+    assert len(calls)==1
+
+
+def test_large_or_non_json_context_is_not_reported_as_full(monkeypatch,caplog):
+    from agent import cache_request_diagnostics as diag
+    monkeypatch.setattr(diag,'_MAX_BYTES',2048)
+    with caplog.at_level(logging.INFO):
+        invoke(monkeypatch,request(),lambda _:None)
+    assert not records(caplog)[0]['fingerprint']['complete']
+    caplog.clear(); req=request(); req['input']=[object()]
+    with caplog.at_level(logging.INFO): invoke(monkeypatch,req,lambda _:None)
+    assert records(caplog)[0]['fingerprint']['unavailable']
+
+
+def test_extra_body_override_and_reasoning_changes_are_visible():
+    from agent.cache_request_diagnostics import fingerprint
+    kw={'key':b'a'*32,'session_id':'s','request_id':'r','base_url':'https://chatgpt.com'}
+    a=request(); a['reasoning']={'effort':'low'}
+    first=fingerprint(a,**kw)
+    a['extra_body']={'instructions':'actual override','reasoning':{'effort':'high'}}
+    second=fingerprint(a,**kw)
+    assert first['instructions']!=second['instructions'] and first['options']!=second['options']
+    assert first['history']==second['history']
+
+
+def test_other_providers_bypass_key_io(monkeypatch):
+    from agent import cache_request_diagnostics as diag
+    def forbidden(): raise AssertionError('unrelated provider touched diagnostics')
+    monkeypatch.setattr(diag,'_profile_key',forbidden)
+    value=object(); req=request()
+    assert diag.observe_call(SimpleNamespace(provider='external',api_mode='external_process'),
+                             req,lambda x:value,request_id='r') is value
