+import { beforeEach, expect, it, vi } from 'vitest'
+
+beforeEach(() => {
+  localStorage.clear()
+  vi.resetModules()
+})
+
+it('renames local owned drafts and retry identities without moving remote or unassigned copies', async () => {
+  const store = await import('@/store/composer')
+  const retry = await import('@/store/composer-draft-retry')
+  const { migrateTilesForProfile } = await import('@/store/session-states')
+  const local = { connectionId: 'local', profile: 'work' }
+  const remote = { connectionId: 'other-source', profile: 'work' }
+  const renamed = { connectionId: 'local', profile: 'review' }
+  store.stashSessionDraft('shared-history', 'Local draft', [], local)
+  store.stashSessionDraft('shared-history', 'Remote draft', [], remote)
+  store.stashSessionDraft('shared-history', 'Unassigned draft', [])
+  retry.writeDraftRetry('shared-history', retry.draftRetry('local-send', 'Local draft', []), local)
+  retry.writeDraftRetry('retry-only', retry.draftRetry('uncertain-send', 'Other words', []), local)
+  migrateTilesForProfile('work', 'review')
+  store.reloadPersistedDrafts()
+
+  expect(store.takeSessionDraft('shared-history', renamed).text).toBe('Local draft')
+  expect(store.takeSessionDraft('shared-history', local).text).toBe('')
