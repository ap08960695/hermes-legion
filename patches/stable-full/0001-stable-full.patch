+def test_sqlite_deadline_interrupts_scan_and_clears_the_handler(conversations, monkeypatch):
+    import hermes_state_search
+    db, needle = conversations
+    class ExpiringClock:
+        calls = 0
+        def monotonic(self):
+            self.calls += 1
+            return 0.0 if self.calls == 1 else 100.0
+    with monkeypatch.context() as scoped:
+        scoped.setattr(hermes_state_search, "time", ExpiringClock())
