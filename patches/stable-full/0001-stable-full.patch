+"""The first goal turn sees the completion contract and the evidence rule the judge relies on."""
+from hermes_cli import goals
+from hermes_cli.goal_command import dispatch_goal_command
+
+
+def _set(text):
+    mgr = goals.GoalManager(session_id="kick-contract", default_max_turns=5)
+    return dispatch_goal_command(mgr, text, authorize_gate=lambda: None, last_user_message="")
+
+
+def test_kick_carries_contract_and_evidence_rule():
+    result = _set("close card t_1\noutcome: card t_1 is done\nverification: read card t_1 back as done")
+    assert result.kickoff and result.prompt.startswith("close card t_1")
+    assert "read card t_1 back as done" in result.prompt
+    assert "show the concrete evidence" in result.prompt
+
+
+def test_free_form_goal_kick_is_unchanged():
+    assert _set("ship the report").prompt == "ship the report"
