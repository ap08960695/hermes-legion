+"""Bounded saved routing metadata for the existing profile CLI, never a readiness probe."""
+from __future__ import annotations
+
+_LIMIT = 64
+
+
+def _saved_config(directory):
+    # Saved-file diagnostics deliberately omit overlays and secret expansion.
+    from hermes_cli.config import read_user_config_raw
+    from hermes_yaml import YAMLError
+    try:
+        return read_user_config_raw(directory / "config.yaml"), ""
+    except YAMLError:
+        raise ValueError("saved profile config is unreadable") from None
+
+
+def _entry(name, root, allowed):
+    from hermes_cli.bot_settings import _model_snapshot
+    from hermes_cli.bot_workflow import normalize_workflow, workflow_snapshot
+    from hermes_cli.profiles import get_profile_dir
+
+    row = {'name': name, 'workflow': None, 'pair_status': 'unreadable',
+           'dispatch_admitted': False, 'model': {}}
+    try:
+        directory = get_profile_dir(name, home=root)
+        config, _ = _saved_config(directory)
+        workflow = normalize_workflow(config.get('bot_workflow', {}), name)
+        if workflow and allowed is not None and workflow['counterpart'] not in allowed:
+            status = 'not_admitted'
+        else:
+            status = workflow_snapshot(directory, read_config=_saved_config)['pair_status']
+        admitted = allowed is None or name in allowed
+        if workflow:
+            admitted = admitted and status == 'linked' and (
+                allowed is None or workflow['counterpart'] in allowed)
+        row.update(workflow=workflow, pair_status=status, dispatch_admitted=admitted,
+                   model=_model_snapshot(config))
+    except (OSError, ValueError, TypeError, KeyError):
+        pass  # No exception text or raw config enters the result.
+    return row
+
+
+def routing_snapshot():
+    """Native fleet admission and reciprocal links; no skills, auth or provider requests.
+
+    The saved route is descriptive, not a live account/model binding. The dispatcher
+    still checks current permissions, claims, stop states, quotas and resource caps.
+    """
+    from hermes_cli.kanban_db_dispatch import _dispatch_profile_allowlist
+    from hermes_cli.profiles import list_profile_names, normalize_profile_name
+    from hermes_constants import (get_default_hermes_root, get_hermes_home,
+                                  reset_hermes_home_override, set_hermes_home_override)
+
+    root = get_default_hermes_root(home=get_hermes_home())
+    token = set_hermes_home_override(root)
+    try:
+        allowed = _dispatch_profile_allowlist(normalize_profile_name)
+        names = sorted(set(list_profile_names()))
+        names = [name for name in names if allowed is None or name in allowed]
+        rows = [_entry(name, root, allowed) for name in names[:_LIMIT]]
+        result = {'version': 1, 'profiles': rows,
+                  'total_profiles': len(names), 'truncated': len(names) > _LIMIT,
+                  'readiness': 'not_probed',
+                  'authority': 'Saved routing metadata only; current dispatch, quota, stop, review and resource gates still apply.'}
+        if any(row.get('dispatch_admitted') is True
+               and (row.get('workflow') or {}).get('mode') == 'think' for row in rows):
+            from hermes_cli.kanban_role_flow import planning_contract
+            result['role_plan_contract'] = planning_contract()
+        return result
+    finally:
+        reset_hermes_home_override(token)
