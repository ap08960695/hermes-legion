+export function openLinuxPetInput(window: BrowserWindow, onFailure: () => void) {
+  const handle = window.getNativeWindowHandle()
+  // XIDs are 32-bit protocol values. getNativeWindowHandle returns an Xlib
+  // unsigned long. Current Linux Desktop builds are little-endian.
+  const xid = handle.readUInt32LE(0)
+  const helper = spawn(helperPath(), [String(xid)], { stdio: ['pipe', 'pipe', 'ignore'] })
+  const replies = createInterface({ input: helper.stdout })
+  type Update = { region: string; applied?: () => void }
+  let waiting: Update | undefined = { region: '0\n' } // helper's first empty region
+  let next: Update | undefined
+  let last = ''
+  let closed = false
+  let timer = setTimeout(fail, 2000)
+
+  function fail() {
+    if (closed) {return}
+    stop()
+    onFailure()
+  }
+
+  function stop() {
+    if (closed) {return}
+    closed = true
+    clearTimeout(timer)
+    replies.close()
+    helper.kill()
+  }
+
+  function send() {
+    if (closed || waiting || !next) {return}
+    const update = next
+    next = undefined
+
+    if (last === update.region) {
+      update.applied?.()
+
+      return
+    }
+
+    waiting = update
+    timer = setTimeout(fail, 2000)
+    helper.stdin.write(update.region)
+  }
+
+  replies.on('line', line => {
+    if (closed) {return}
+
+    if (line !== 'ok' || !waiting) {
+      fail()
+
+      return
+    }
+
+    clearTimeout(timer)
+    const applied = waiting
+    waiting = undefined
+    last = applied.region
+    applied.applied?.()
+    send()
+  })
+  helper.once('error', fail)
+  helper.once('exit', fail)
+  helper.stdin.once('error', fail)
+  window.once('closed', stop)
+
+  // GNOME can clear the initial always-on-top level while mapping the window.
+  const reassertAbove = () => setImmediate(() => {
+    if (!closed && !window.isDestroyed()) {window.setAlwaysOnTop(true, 'screen-saver')}
+  })
+  if (window.isVisible()) {reassertAbove()}
+  else {window.once('show', reassertAbove)}
+
+  return {
+    set(region: string, applied?: () => void) {
+      next = { region, applied }
+      send()
+    }
+  }
+}
