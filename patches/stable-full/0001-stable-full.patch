+from hermes_state import SessionDB
+from tools.session_search_tool import session_search
+
+
+@pytest.fixture
+def db(tmp_path):
+    store = SessionDB(tmp_path / "state.db")
+    store.create_session("s", source="cli")
+    yield store
+    store.close()
+
+
+def call(db, **kwargs):
+    return json.loads(session_search(db=db, **kwargs))
+
+
+def test_thai_multimodal_text_is_found_and_can_be_paged_without_image_payload(db):
+    first = "first part"
+    second = "x" * 6000 + " ข้อความตัวอย่างภาษาไทย " + "y" * 5000
+    value = [
+        {"type": "text", "text": first},
+        {
+            "type": "image_url",
+            "image_url": {"url": "data:image/png;base64,IMAGEPAYLOADMARKER"},
+        },
+        {"type": "text", "text": second},
+    ]
+    message = db.append_message("s", role="user", content=value)
+    result = call(db, session_id="s", query="ข้อความตัวอย่างภาษาไทย")
+    assert result["success"] and len(result["results"]) == 1
+    hit = result["results"][0]
+    assert hit["match_message_id"] == message
+    assert hit["snippet_field"] == "text" and hit["offset_unit"] == "characters"
+    assert "ข้อความตัวอย่างภาษาไทย" in hit["snippet"]
+    assert "IMAGEPAYLOADMARKER" not in json.dumps(result)
+    page = call(
+        db,
+        session_id="s",
+        around_message_id=message,
+        content_offset=hit["snippet_offset"],
+        content_field=hit["snippet_field"],
+    )
+    expected = first + "\n" + second
+    assert (
+        page["success"]
+        and page["content"] == expected[page["offset"] : page["offset"] + page["limit"]]
+    )
+    assert "ข้อความตัวอย่างภาษาไทย" in page["content"]
+    assert "IMAGEPAYLOADMARKER" not in json.dumps(page)
+
+
+def test_multimodal_search_ignores_image_metadata_and_combines_text_parts(db):
+    value = [
+        {"type": "text", "text": "alpha"},
+        {
+            "type": "image_url",
+            "image_url": {"url": "data:image/png;base64,IMAGEPAYLOADMARKER"},
+        },
+        {"type": "text", "text": "beta"},
+    ]
+    message = db.append_message("s", role="user", content=value)
+    assert not call(db, session_id="s", query="IMAGEPAYLOADMARKER")["results"]
+    matches = call(db, session_id="s", query="alpha AND beta")["results"]
+    assert [m["match_message_id"] for m in matches] == [message]
+    assert not call(db, session_id="s", query="alpha NOT beta")["results"]
+
+
+def test_nested_image_text_and_nonobject_parts_are_not_searchable(db):
+    value = [
+        "nonobjectmarker",
+        23,
+        None,
+        {
+            "type": "image_url",
+            "image_url": {"url": "secretimagepayload", "text": "nestedmarker"},
+        },
+        {"type": "other", "text": "nontextpartmarker"},
+        {"type": "text", "text": "realpartmarker"},
+    ]
+    mid = db.append_message("s", role="user", content=value)
+    for word in (
+        "nonobjectmarker",
+        "secretimagepayload",
+        "nestedmarker",
+        "nontextpartmarker",
