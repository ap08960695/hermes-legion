+"""Profile preparation must retain ownership until a cancelled physical write finishes."""
+import asyncio
+import threading
+
+import pytest
+
+from tests.gateway.test_profile_runtime_io import _world
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('cancel_scope', ['caller', 'all_new_tasks'])
+@pytest.mark.parametrize('operation', [
+    'open_store', 'begin_runtime_epoch', 'recover_session_inputs', 'settle_recovered_unattended',
+    'backfill_legacy_session_owners', 'backfill_compression_created_sources', '_adopt',
+])
+async def test_cancelled_authority_preparation_keeps_physical_write_custody(tmp_path, monkeypatch, operation, cancel_scope):
+    from gateway import session_authority
+    from gateway.run_runtime import initialize_gateway_runtime, _build_profile_authority
+    from gateway.runtime_ownership import process_ownership
+    from hermes_constants import get_hermes_home
+
+    with _world(tmp_path, monkeypatch) as (runner, root, target):
+        await initialize_gateway_runtime(runner)
+        if operation == '_adopt':
+            from gateway.run import _profile_runtime_scope
+            from gateway.session_local import create_local_session
+            from gateway.session_cron import unbind_owner
+            from gateway.session_controls import AuthorityConnection
+            from tests.gateway.test_local_receipt_untracked_compression import _compact_like_0_22_2
+            from gateway import run
+            monkeypatch.setattr(run, '_load_gateway_config', lambda: {'platform_toolsets': {'cli': []}})
+            with _profile_runtime_scope(target, hydrate_secrets=False):
+                first = await _build_profile_authority(runner, 'alpha', target, register=False)
+                connection = AuthorityConnection(first, object(), {'user_id': 'owner'})
+                ref = create_local_session(first, connection.actor, {'request_id': 'fixture', 'source': 'tui',
+                    'cwd': str(target), 'model': 'm', 'toolsets': []})
+                _compact_like_0_22_2(first.db, ref.session_id, 'fixture-child')
+                await connection.close()
+                unbind_owner(first)
+                runner.session_authorities.remove(target)
+        entered, release, finished, observed = (threading.Event() for _ in range(4))
+        import hermes_state_registry
+        from gateway import session_local_adoption, session_unattended_unknown
+        module = {'open_store': hermes_state_registry, '_adopt': session_local_adoption,
+                  'settle_recovered_unattended': session_unattended_unknown}.get(operation, session_authority)
+        seam = 'acquire' if operation == 'open_store' else operation
+        native = getattr(module, seam)
+        writes, checks = [], []
+
+        def physical_write(*args, **kwargs):
+            if get_hermes_home().resolve() != target:
+                return native(*args, **kwargs)
+            if operation != 'open_store':
+                store = args[0].db if operation == '_adopt' else args[0]
+                assert store.db_path.resolve().parent == target
+            entered.set()
+            assert release.wait(8), 'the observer must release the private writer'
+            writes.append(process_ownership.owns(target))
+            try:
+                return native(*args, **kwargs)
+            finally:
+                finished.set()
+
+        monkeypatch.setattr(module, seam, physical_write)
+
+        async def owning_call():
+            try:
+                return await _build_profile_authority(runner, 'alpha', target, register=False)
+            finally:
+                if runner.session_authorities.for_home(target) is None:
+                    process_ownership.release(target)
+
+        prior_tasks = set(asyncio.all_tasks())
+        task = asyncio.create_task(owning_call())
+        loop = asyncio.get_running_loop()
+
+        def cancel_twice():
+            victims = {task} if cancel_scope == 'caller' else set(asyncio.all_tasks()) - prior_tasks
+            for victim in victims:
+                victim.cancel()
+                loop.call_soon(victim.cancel)
+            loop.call_soon(lambda: loop.call_soon(inspect_custody))
+
+        def inspect_custody():
+            checks.extend([task.done(), process_ownership.owns(target),
+                           runner._shutdown_executor(drain_timeout=0)])
+            observed.set()
+
+        def observe():
+            try:
+                if not entered.wait(8):
+                    return
+                loop.call_soon_threadsafe(cancel_twice)
+                observed.wait(5)
+            finally:
+                release.set()
+
+        watcher = threading.Thread(target=observe)
+        watcher.start()
+        try:
+            with pytest.raises(asyncio.CancelledError):
+                await task
+            assert await asyncio.to_thread(finished.wait, 8)
+            assert observed.is_set()
+            assert checks[0] is False, 'cancellation must wait for the physical writer'
+            assert checks[1] is True, 'profile reservation must outlive the write'
+            assert checks[2] >= 1, 'native shutdown must see this database writer'
+            assert writes == [True], 'physical mutation must not run after ownership release'
+            assert runner.session_authorities.for_home(target) is None
+            from gateway.session_cron import owner_for_home
+            assert owner_for_home(target) is None
+            assert not process_ownership.owns(target)
+        finally:
+            release.set()
+            await asyncio.to_thread(watcher.join, 8)
+            assert not watcher.is_alive()
+            assert await asyncio.to_thread(finished.wait, 8)
