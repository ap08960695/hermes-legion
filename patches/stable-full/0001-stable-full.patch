+.hermes-focus-frame {
+  display: flex;
+  flex: 1;
+  min-height: 0;
+  min-width: 0;
+  background: var(--ui-chat-surface-background);
+}
+.hermes-focus-rail {
+  display: flex;
+  flex-direction: column;
+  flex-shrink: 0;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  width: 68px;
+  padding: 16px 8px 12px;
+  gap: 16px;
+  border-inline-end: 1px solid var(--ui-stroke-secondary);
+  background: var(--ui-bg-chrome);
+}
+.hermes-focus-brand {
+  flex-shrink: 0;
+  height: 44px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  color: var(--ui-text-primary);
+}
+.hermes-focus-brand > span {
+  font-size: 21px;
+  font-weight: 600;
+}
+.hermes-focus-brand > strong {
+  display: none;
+  font-size: 14px;
+}
+.hermes-focus-primary,
+.hermes-focus-utilities {
+  flex-shrink: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+.hermes-focus-utilities {
+  margin-top: auto;
+}
+.hermes-focus-primary {
+  gap: 8px;
+}
+.hermes-focus-rail .hermes-focus-nav {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+  min-height: 48px;
+  width: 100%;
+  /* Native scrollbars narrow this rail; leave its full button width for labels. */
+  padding: 8px 0;
+  border-radius: 10px;
+  white-space: normal;
+  transition:
+    background-color 150ms,
+    color 150ms,
+    transform 150ms;
+}
+.hermes-focus-nav > .codicon {
+  font-size: 18px;
+}
+.hermes-focus-nav > span:not(.codicon) {
+  font-size: 10px;
+  line-height: 1.2;
+  overflow-wrap: anywhere;
+}
+.hermes-focus-nav[aria-current='page'] {
+  background: var(--ui-bg-quaternary);
+  color: var(--ui-text-primary);
+}
+.hermes-focus-nav:active {
+  transform: scale(0.97);
+}
+.hermes-focus-content {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+  overflow: hidden;
+}
+[data-presentation='workspace'] > .hermes-focus-rail {
+  width: 146px;
+}
+[data-presentation='workspace'] .hermes-focus-brand > strong {
+  display: block;
+}
+[data-presentation='workspace'] .hermes-focus-nav {
+  flex-direction: row;
+  justify-content: flex-start;
+  gap: 10px;
+  padding-inline: 12px;
+  min-height: 40px;
+}
+[data-presentation='workspace'] .hermes-focus-nav > span:not(.codicon) {
+  font-size: 12px;
+}
+.hermes-focus-features {
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+}
+.hermes-focus-features h3 {
+  margin-block-end: 8px;
+  color: var(--ui-text-tertiary);
+  font-size: 11px;
+}
+.hermes-focus-feature-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 6px;
+}
+.hermes-focus-feature-grid > button {
+  justify-content: flex-start;
+  min-height: 38px;
+  white-space: normal;
+  text-align: start;
+  overflow-wrap: anywhere;
+}
+.hermes-focus-work {
+  display: grid;
+  gap: 16px;
+}
+.hermes-focus-work article {
+  padding: 12px;
+  border: 1px solid var(--ui-stroke-secondary);
+  border-radius: 10px;
+  overflow-wrap: anywhere;
+}
+.hermes-focus-work h3 {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-block-end: 8px;
+  font-size: 13px;
+  font-weight: 500;
+}
+.hermes-focus-work p {
+  font-size: 12px;
+  color: var(--ui-text-secondary);
+  white-space: pre-wrap;
+}
+@media (max-width: 640px) {
+  .hermes-focus-frame {
+    flex-direction: column;
+  }
+  .hermes-focus-frame > .hermes-focus-rail {
+    order: 2;
+    width: 100%;
+    flex-direction: row;
+    padding: 4px;
+    gap: 4px;
+    border-inline-end: 0;
+    border-block-start: 1px solid var(--ui-stroke-secondary);
+  }
+  .hermes-focus-brand {
+    display: none;
+  }
+  .hermes-focus-primary {
+    min-width: 0;
+    flex: 1;
+    flex-direction: row;
+    gap: 0;
+  }
+  .hermes-focus-utilities {
+    flex: 0 0 104px;
+    margin-top: 0;
+    flex-direction: row;
+  }
+  .hermes-focus-utilities > .hermes-focus-nav {
+    display: none;
+  }
+  .hermes-focus-utilities > .hermes-focus-nav:is(:first-child, :last-child) {
+    display: flex;
+  }
+  [data-presentation='workspace'] .hermes-focus-primary > .hermes-focus-nav,
+  .hermes-focus-primary > .hermes-focus-nav,
+  .hermes-focus-utilities > .hermes-focus-nav {
+    width: auto;
+    min-width: 0;
+    flex: 1 1 0;
+    flex-direction: column;
+    justify-content: center;
+    min-height: 48px;
+    padding: 5px;
+    gap: 5px;
+  }
+  .hermes-focus-utilities > .hermes-focus-nav {
+    padding-inline: 0;
+  }
+  .hermes-focus-primary > .hermes-focus-nav > span:not(.codicon),
+  .hermes-focus-utilities > .hermes-focus-nav > span:not(.codicon) {
+    font-size: 10px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .hermes-focus-frame button {
+    transition: none;
+    animation: none;
+    transform: none;
+  }
+}
+.hermes-focus-goal {
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+}
+.hermes-focus-goal > :not(form) {
+  flex-shrink: 0;
+}
+.hermes-focus-goal > form {
+  min-height: 0;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+.hermes-focus-goal form > fieldset {
+  display: grid;
+  gap: 14px;
+  min-width: 0;
+}
+.hermes-focus-goal label {
+  display: grid;
+  gap: 6px;
+  min-width: 0;
+  font-size: 12px;
+}
+.hermes-focus-goal label > span {
+  overflow-wrap: anywhere;
+}
+.hermes-focus-goal legend {
+  font-size: 12px;
+  margin-block-end: 6px;
+}
+.hermes-focus-goal fieldset p {
+  font-size: 11px;
+  color: var(--ui-text-secondary);
+}
+.hermes-focus-skill-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 8px;
+  margin-block-start: 10px;
+}
+.hermes-focus-skill-grid > label {
+  display: flex;
+  align-items: start;
+  gap: 8px;
+}
+.hermes-focus-skill-grid input {
+  margin-block-start: 2px;
+  accent-color: var(--primary);
+}
+.hermes-focus-goal-footer {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+  padding-block: 12px;
+  background: var(--ui-chat-bubble-background);
+  z-index: 1;
+  border-block-start: 1px solid var(--ui-stroke-secondary);
+}
+
+@keyframes hermes-focus-select {
+  from {
+    opacity: 0.55;
+    transform: translateY(2px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+.hermes-focus-nav[aria-current='page'] > .codicon {
+  animation: hermes-focus-select 180ms ease-out both;
+}
+@media (prefers-reduced-motion: reduce) {
+  .hermes-focus-nav[aria-current='page'] > .codicon {
+    animation: none;
+  }
+}
+
+.hermes-focus-goal summary {
+  cursor: pointer;
+  font-size: 12px;
+  color: var(--ui-text-secondary);
+}
+.hermes-focus-more-conditions {
+  display: grid;
+  gap: 14px;
+  margin-block-start: 14px;
+}
+
+/* Native surfaces share one canvas, instead of a second shell inside a rail. */
+.hermes-focus-frame {
+  padding: 10px 10px 10px 0;
+  gap: 10px;
+}
+.hermes-focus-frame > .hermes-focus-rail {
+  border-inline-end: 0;
+  background: transparent;
+}
+.hermes-focus-content {
+  border: 1px solid var(--ui-stroke-tertiary);
+  border-radius: 14px;
+  background: var(--ui-chat-surface-background);
+}
+.hermes-focus-content [data-tour='sessions-sidebar'] {
+  border-color: var(--ui-stroke-tertiary);
+}
+.hermes-focus-brand {
+  margin-block-end: 12px;
+}
+.hermes-focus-nav[aria-current='page'] {
+  box-shadow: inset 0 0 0 1px var(--ui-stroke-tertiary);
+}
+@media (max-width: 640px) {
+  .hermes-focus-frame {
+    padding: 6px 6px 0;
+    gap: 4px;
+  }
+  .hermes-focus-content {
+    border-radius: 12px;
+  }
+}
+
+.hermes-focus-content [data-slot='aui_intro'][data-presentation='quiet'] {
+  max-width: 600px;
+  margin-inline: auto;
+  padding: 28px;
+}
+.hermes-focus-content [data-slot='aui_intro'][data-presentation='quiet'] h1 {
+  font-size: 27px;
+  line-height: 1.3;
+  font-weight: 500;
+  color: var(--ui-text-primary);
+  letter-spacing: -0.4px;
+  margin-block-end: 12px;
+}
+.hermes-focus-content [data-slot='aui_intro'][data-presentation='quiet'] p {
+  max-width: 50ch;
+  margin-inline: auto;
+  font-size: 14px;
+  line-height: 1.65;
+  color: var(--ui-text-tertiary);
+}
+
+.hermes-focus-skill-search {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px 16px;
+  margin-block-start: 10px;
+}
+.hermes-focus-skill-search > span {
+  font-size: 11px;
+  color: var(--ui-text-secondary);
+}
+.hermes-focus-skill-grid > label > span {
+  overflow-wrap: anywhere;
+}
+
+/* Compact windows: the Workspace rail falls back to the Focus icon rail so
+   the page keeps its width (Kanban columns were cut off at ~760px). */
+@media (min-width: 641px) and (max-width: 960px) {
+  [data-presentation='workspace'] > .hermes-focus-rail {
+    width: 68px;
+  }
+  [data-presentation='workspace'] .hermes-focus-brand > strong {
+    display: none;
+  }
+  [data-presentation='workspace'] .hermes-focus-nav {
+    flex-direction: column;
+    justify-content: center;
+    gap: 5px;
+    padding-inline: 0;
+    min-height: 48px;
+  }
+  [data-presentation='workspace'] .hermes-focus-nav > span:not(.codicon) {
+    font-size: 10px;
+  }
+}
