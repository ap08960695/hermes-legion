@@ -0,0 +1,188 @@
+"""Uninstalled packs preview from validated snapshots without pet settings/store."""
+import argparse
+import json
+from pathlib import Path
+import re
+import sys
+import tempfile
+import time
+from unittest.mock import patch
+
+import pytest
+from PIL import Image, ImageDraw
+
+from hermes_cli.subcommands.pets import build_pets_parser
+
+
+def show(root, *flags, tty=True):
+    parser = argparse.ArgumentParser()
+    build_pets_parser(parser.add_subparsers())
+    args = parser.parse_args(["pets", "show", "--pack", str(root), "--mode", "unicode", *flags])
+    with patch.object(sys.stdout, "isatty", return_value=tty):
+        return args.func(args)
+
+
+@pytest.fixture
+def preview(tmp_path, monkeypatch, capsys):
+    from agent.pet import store
+    from hermes_cli import pets
+
+    root = tmp_path / "pack"
+    root.mkdir()
+    (root / "manifest.json").write_text(json.dumps({
+        "schema_version": 1, "format": "hermes-native-atlas", "name": "Preview pack",
+        "author": "Fixture", "licence": "CC0-1.0", "spritesheet": "spritesheet.png",
+    }))
+    image = Image.new("RGBA", (1536, 1872))
+    draw = ImageDraw.Draw(image)
+    for row in range(9):
+        draw.rectangle((0, row * 208, 191, (row + 1) * 208 - 1), fill=(20 + row * 25, 60, 120, 255))
+    image.save(root / "spritesheet.png")
+    scratch = tmp_path / "scratch"
+    scratch.mkdir()
+    monkeypatch.setattr(tempfile, "tempdir", str(scratch))
+    monkeypatch.setattr(time, "sleep", lambda delay: None)
+    def forbidden(*args, **kwargs):
+        pytest.fail("pack preview must not resolve installed pets or pet settings")
+    monkeypatch.setattr(pets, "_pet_config", forbidden)
+    monkeypatch.setattr(pets, "_set_active", forbidden)
+    monkeypatch.setattr(store, "resolve_active_pet", forbidden)
+    monkeypatch.setattr(store, "pets_dir", forbidden)
+    return root, scratch
+
+
+@pytest.mark.parametrize("flags,expected", [
+    (["--cycle", "--once"], [20, 95, 195, 145, 220, 120, 170]),
+    (["--state", "review", "--cycle", "--once"], [220]),
+    (["--once"], [20]),
+])
+def test_pack_preview_renders_requested_native_states_once(preview, capsys, flags, expected):
+    root, scratch = preview
+    before = {p.name: p.read_bytes() for p in root.iterdir()}
+    assert show(root, *flags) == 0
+    output = capsys.readouterr()
+    reds = [int(v) for v in re.findall(r"\x1b\[38;2;(\d+);60;120m", output.out)]
+    sequence = [v for i, v in enumerate(reds) if i == 0 or reds[i - 1] != v]
+    assert sequence == expected
+    assert "Preview pack" in output.out and not output.err
+    assert output.out.count("\x1b[?25l") == output.out.count("\x1b[?25h") == 1
+    assert before == {p.name: p.read_bytes() for p in root.iterdir()}
+    assert not list(scratch.iterdir())
+
+
+def test_renderer_uses_validated_bytes_after_source_changes(preview, monkeypatch, capsys):
+    from agent.pet import render
+
+    root, scratch = preview
+    original = (root / "spritesheet.png").read_bytes()
+    real_build = render.build_renderer
+    observed = []
+    def build(sheet, **kwargs):
+        snapshot = Path(sheet)
+        assert snapshot.parent.parent == scratch and snapshot.read_bytes() == original
+        (root / "spritesheet.png").write_bytes(b"replaced after validation")
+        observed.append(snapshot)
+        return real_build(sheet, **kwargs)
+    monkeypatch.setattr(render, "build_renderer", build)
+    assert show(root, "--once") == 0
+    assert "\x1b[38;2;20;60;120m" in capsys.readouterr().out
+    assert len(observed) == 1 and not observed[0].exists()
+
+
+def test_webp_pack_renders_from_snapshot_with_trusted_basename(preview, capsys):
+    root, scratch = preview
+    with Image.open(root / "spritesheet.png") as image:
+        image.save(root / "spritesheet.webp", lossless=True)
+    (root / "spritesheet.png").unlink()
+    meta = json.loads((root / "manifest.json").read_text())
+    meta["spritesheet"] = "spritesheet.webp"
+    (root / "manifest.json").write_text(json.dumps(meta))
+    assert show(root, "--once") == 0
+    assert "\x1b[38;2;20;60;120m" in capsys.readouterr().out
+    assert not list(scratch.iterdir())
+
+
+def test_snapshot_write_failure_is_visible_and_cleans_directory(preview, monkeypatch, capsys):
+    root, scratch = preview
+    real_write = Path.write_bytes
+    def write(path, data):
+        if path.parent.parent == scratch:
+            raise OSError("snapshot write refused")
+        return real_write(path, data)
+    monkeypatch.setattr(Path, "write_bytes", write)
+    assert show(root, "--once") == 1
+    output = capsys.readouterr()
+    assert "snapshot write refused" in output.err and "\x1b[?25l" not in output.out
+    assert not list(scratch.iterdir())
+
+
+@pytest.mark.parametrize("failure", ["json", "image", "empty"])
+def test_invalid_pack_fails_before_cursor_or_snapshot(preview, capsys, failure):
+    root, scratch = preview
+    if failure == "json":
+        (root / "manifest.json").write_bytes(b"bad json")
+    elif failure == "image":
+        (root / "spritesheet.png").write_bytes(b"bad image")
+    else:
+        Image.new("RGBA", (1536, 1872)).save(root / "spritesheet.png")
+    assert show(root, "--once") == 1
+    out = capsys.readouterr()
+    assert "cannot preview pack" in out.err and "\x1b[?25l" not in out.out
+    assert not list(scratch.iterdir())
+
+
+def test_pack_and_installed_slug_conflict_before_store_access(preview, capsys):
+    root, scratch = preview
+    assert show(root, "installed", "--once") == 1
+    assert "either a pet slug or --pack" in capsys.readouterr().err
+    assert not list(scratch.iterdir())
+
+
+def test_non_tty_refusal_cleans_snapshot(preview, capsys):
+    root, scratch = preview
+    assert show(root, "--once", tty=False) == 1
+    assert "cannot render here" in capsys.readouterr().err
+    assert not list(scratch.iterdir())
+
+
+@pytest.mark.parametrize("failure", [KeyboardInterrupt, ValueError, RuntimeError])
+def test_animation_failure_restores_cursor_and_cleans_snapshot(preview, monkeypatch, capsys, failure):
+    root, scratch = preview
+    def stop(delay):
+        raise failure("preview interrupted")
+    monkeypatch.setattr(time, "sleep", stop)
+    if failure is RuntimeError:
+        with pytest.raises(RuntimeError, match="preview interrupted"):
+            show(root, "--once")
+    else:
+        assert show(root, "--once") == (0 if failure is KeyboardInterrupt else 1)
+    output = capsys.readouterr()
+    assert output.out.count("\x1b[?25l") == output.out.count("\x1b[?25h") == 1
+    if failure is ValueError:
+        assert "preview interrupted" in output.err
+    assert not list(scratch.iterdir())
+
+
+def test_renderer_initialization_error_cleans_snapshot(preview, monkeypatch, capsys):
+    from agent.pet import render
+
+    root, scratch = preview
+    def fail(*args, **kwargs):
+        raise ValueError("renderer init failed")
+    monkeypatch.setattr(render, "build_renderer", fail)
+    assert show(root, "--once") == 1
+    output = capsys.readouterr()
+    assert "renderer init failed" in output.err and "\x1b[?25l" not in output.out
+    assert not list(scratch.iterdir())
+
+
+def test_cycle_refuses_missing_requested_frames(preview, capsys):
+    root, scratch = preview
+    with Image.open(root / "spritesheet.png") as image:
+        changed = image.copy()
