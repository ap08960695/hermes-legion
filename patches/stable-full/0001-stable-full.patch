+"""Bound interpreter work when validating already-bounded recall payloads."""
+import cProfile
+import json
+import pstats
+
+from hermes_state import SessionDB
+from tools.registry import registry
+import tools.session_search_tool
+
+
+def test_full_recall_bounds_interpreter_work_without_changing_results(tmp_path):
+    with SessionDB(tmp_path / "state.db") as db:
+        for index in range(3):
+            sid = f"unicode-work-{index}"
+            db.create_session(sid, source="cli")
+            for number in range(41):
+                text = (f"scanworkneedle code-{index}" if number == 20
+                        else "ordinary context ภาษาไทย 漢字 😀 " * 1000)
+                db.append_message(sid, role="user", content=text,
+                                  timestamp=1000 + index * 100 + number)
+        args = {"query": "scanworkneedle", "limit": 3, "detail": "full"}
+        expected = registry.dispatch("session_search", args, db=db)
+        profiler = cProfile.Profile()
+        with profiler:
+            actual = registry.dispatch("session_search", args, db=db)
+        assert actual == expected
+        actual.encode("utf-8")
+        payload = json.loads(actual)
+        assert payload["success"] and len(payload["results"]) == 3
+        assert all("scanworkneedle" in hit["snippet"] for hit in payload["results"])
+        # Count interpreter work, not wall time: retain ample headroom for the
+        # database/tool plumbing, while rejecting a Python call per character.
+        assert pstats.Stats(profiler).total_calls < 20000
