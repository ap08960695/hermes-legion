index 0000000000000000000000000000000000000000..cc1ae18344be4d4dd215cb28c8a7c6c857950d41
--- /dev/null
+++ b/hermes_cli/goals_metadata.py
@@ -0,0 +1,100 @@
+"""Goal snapshots and atomic writes in the existing SessionDB metadata table."""
+
+from __future__ import annotations
+
+import logging
+from typing import TYPE_CHECKING
+from uuid import uuid4
+
+if TYPE_CHECKING:
+    from hermes_cli.goals import GoalState
+    from hermes_state import SessionDB
+
+logger = logging.getLogger(__name__)
+
+
+def _key(session_id: str) -> str:
+    return f"goal:{session_id}"
+
+
+def read_goal(db: SessionDB, session_id: str) -> tuple[GoalState | None, str | None]:
+    from hermes_cli.goals import GoalState
+
+    raw = db.get_meta(_key(session_id))
+    return (GoalState.from_json(raw), raw) if raw else (None, None)
+
+
+def load_goal(session_id: str) -> GoalState | None:
+    """Load the goal for a session, or None when it cannot be read."""
+    from hermes_cli.goals import _get_session_db
+
+    db = _get_session_db() if session_id else None
+    if db is not None:
+        try:
+            state, _ = read_goal(db, session_id)
+            return state
+        except Exception:
+            logger.debug("GoalManager: could not load stored goal for %s", session_id, exc_info=True)
+    return None
+
+
+def _encode_revision(state: GoalState) -> str:
+    state.revision = uuid4().hex
+    return state.to_json()
+
+
+def save_goal(session_id: str, state: GoalState, *, expected_raw: str | None = None) -> str | None:
+    """Persist a new revision, optionally replacing only the exact stored snapshot."""
+    from hermes_cli.goals import _get_session_db, _warn_dropped_write
+
+    if not session_id:
+        return None
+    db = _get_session_db()
+    if db is None:
+        _warn_dropped_write("GoalManager", "goal", session_id)
+        return None
+    try:
+        raw = _encode_revision(state)
+        key = _key(session_id)
+        if expected_raw is None:
+            db.set_meta(key, raw)
+        elif not db._write_rowcount(
+            "UPDATE state_meta SET value = ? WHERE key = ? AND value = ?",
+            (raw, key, expected_raw),
+        ):
+            return None
+        return raw
+    except Exception:
+        logger.debug("GoalManager: set_meta failed", exc_info=True)
+        return None
+
+
+def pause_active_goal_on_stop(db: SessionDB, session_id: str) -> bool:
+    """Pause the current active revision in the session authority's database."""
+    from hermes_cli.goals import GoalState
+
+    key = _key(session_id)
+
+    def pause(conn):
+        cursor = conn.cursor()
+        row = cursor.execute("SELECT value FROM state_meta WHERE key = ?", (key,)).fetchone()
+        if row is None:
+            return False
+        state = GoalState.from_json(row[0])
+        if state.status != "active":
+            return False
+        state.status = "paused"
+        state.paused_reason = "user-interrupted (Stop)"
+        state.clear_wait()
+        db.set_meta(key, _encode_revision(state), cursor=cursor)
+        return True
+
+    return db._execute_write(pause)
+
+
+def clear_goal(session_id: str) -> None:
+    """Mark a goal cleared in the DB (preserved for audit, status=cleared)."""
+    state = load_goal(session_id)
+    if state is not None:
+        state.status = "cleared"
+        save_goal(session_id, state)
