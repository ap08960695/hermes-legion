+"""Recovery capsules accept UTF-8 state without weakening identity checks."""
+import json
+import subprocess
+
+import pytest
+
+from hermes_cli.update_preservation_io import capsule
+
+
+@pytest.mark.parametrize('marker_encoding, state_encoding', [
+    ('utf-8', 'utf-8'), ('utf-8-sig', 'utf-8'), ('utf-8', 'utf-8-sig'),
+])
+def test_capsule_reads_utf8_state_without_rewriting_it(tmp_path, marker_encoding, state_encoding):
+    root = tmp_path / 'ซอร์ส'
+    subprocess.run(['git', 'init', '-q', str(root)], check=True, capture_output=True)
+    directory = root / '.git'
+    nonce = 'a' * 32
+    marker = directory / 'hermes-update-pull'
+    marker.write_text('preserve=' + nonce + '\n', encoding=marker_encoding)
+    target = directory / 'hermes-preservation' / nonce
+    target.mkdir(parents=True)
+    state = {'version': 1, 'root': str(root.resolve()), 'note': 'เก็บงานเดิม'}
+    document = target / 'state.json'
+    document.write_text(json.dumps(state, ensure_ascii=False), encoding=state_encoding)
+    before = (marker.read_bytes(), document.read_bytes())
+    assert capsule(root) == (target, state)
+    assert (marker.read_bytes(), document.read_bytes()) == before
+
+
+def test_capsule_rejects_a_bom_document_for_another_checkout(tmp_path):
+    subprocess.run(['git', 'init', '-q', str(tmp_path)], check=True, capture_output=True)
+    nonce = 'a' * 32
+    target = tmp_path / '.git' / 'hermes-preservation' / nonce
+    target.mkdir(parents=True)
+    document = target / 'state.json'
+    document.write_text(json.dumps({'version': 1, 'root': '/another-checkout'}), encoding='utf-8-sig')
+    with pytest.raises(OSError, match='another checkout'):
+        capsule(tmp_path, {'preserve': nonce})
