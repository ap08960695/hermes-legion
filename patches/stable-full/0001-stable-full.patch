+"""Deferred resume must enforce the owning profile's lineage-size limit."""
+import threading
+
+import pytest
+
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+from hermes_state import SessionDB
+from tui_gateway import server
+
+
+@pytest.mark.parametrize("profile_limit,launch_limit", [(100, 1), (1, 100)])
+def test_resume_hydration_uses_the_profiles_own_limit(tmp_path, monkeypatch, profile_limit, launch_limit):
+    launch, profile = tmp_path / "launch", tmp_path / "profile"
+    for home, limit in [(launch, launch_limit), (profile, profile_limit)]:
+        home.mkdir()
+        (home / "config.yaml").write_text(f"sessions:\n  max_resume_messages: {limit}\n")
+    monkeypatch.setenv("HERMES_HOME", str(launch))
+    db = SessionDB(profile / "state.db")
+    db.create_session("parent", source="tui")
+    db.append_message("parent", "user", "ancestor fact", timestamp=100.0)
+    db.end_session("parent", "compression")
+    db.create_session("tip", source="tui", parent_session_id="parent")
+    db.append_message("tip", "user", "archived fact", timestamp=101.0)
+    db.archive_and_compact("tip", [
+        {"role": "assistant", "content": "summary", "_compressed_summary": True},
+        {"role": "user", "content": "continue"},
+    ])
+    prefix = db.get_ancestor_display_prefix("tip")
+    assert prefix
+    session = {"history": [], "profile_home": str(profile), "history_lock": threading.RLock(),
+               "resume_history_ready": threading.Event(), "agent_ready": threading.Event(),
+               "resume_message_count": 0}
+    closed = threading.Event()
+    original_close = db.close
+
+    def close():
+        original_close()
+        closed.set()
+
+    monkeypatch.setattr(db, "close", close)
+    monkeypatch.setitem(server._sessions, "scope-resume-test", session)
+    monkeypatch.setattr(server, "_emit", lambda *args: None)
+    monkeypatch.setattr(server, "_start_agent_build", lambda *args: None)
+    monkeypatch.setattr(server, "_maybe_schedule_auto_continue", lambda *args: None)
+    token = set_hermes_home_override(profile)
+    try:
+        server._schedule_resume_hydration("scope-resume-test", "tip", db, close_db=True)
+    finally:
+        reset_hermes_home_override(token)
+    try:
+        assert closed.wait(5)
+        assert session["resume_history_ready"].is_set()
+        assert not session.get("resume_history_error")
+        assert session["display_history_prefix"] == (prefix if profile_limit == 100 else [])
+    finally:
+        db.close()
