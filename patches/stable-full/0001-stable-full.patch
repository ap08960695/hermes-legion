@@ -0,0 +1,40 @@
+import type { HermesNotification } from './notification-types'
+
+interface QuitEvent { preventDefault: () => void }
+interface ConfigQuitHost {
+  queue: { hasPending: () => boolean; flush: () => Promise<void> }
+  holdForActiveWork: (event: QuitEvent) => boolean
+  requestQuit: () => void
+  log: (message: string) => void
+  notify: (payload: HermesNotification) => Promise<boolean>
+}
+
+/** A failed save keeps the viewer and its transports alive, without a modal.
+ * Another explicit quit retries. Forced termination cannot preserve RAM-only
+ * edits; this gate never claims crash durability or discards failed intent. */
+export function createConfigQuitGate(host: ConfigQuitHost) {
+  let waiting: Promise<void> | null = null
+
+  return (event: QuitEvent): boolean => {
+    if (host.holdForActiveWork(event)) { return true }
+
+    if (!waiting && !host.queue.hasPending()) { return false }
+    event.preventDefault()
+
+    if (!waiting) {
+      waiting = host.queue.flush().then(() => {
+        waiting = null
+        host.requestQuit()
+      }).catch(error => {
+        waiting = null
+        host.log(`Settings save failed before quit: ${String(error)}`)
+        void host.notify({
+          tag: 'config-save-failed', title: 'Settings could not be saved',
+          body: 'Hermes is still open. Reconnect to the settings destination and try quitting again.'
+        }).catch(notificationError => host.log(`Settings notification failed: ${String(notificationError)}`))
+      })
+    }
+
+    return true
+  }
+}
