+
+def test_skill_dirs_expand_only_the_assignee_environment(fleet, monkeypatch):
+    from tools import kanban_tools
+    monkeypatch.setenv('SKILL_LIBRARY', '/nonexistent-launch-library')
+    for name, other in [('alpha', 'beta'), ('beta', 'alpha')]:
+        wanted = ['external-' + name, 'local-' + name, 'external-' + other, 'missing']
+        assert kanban_tools._skills_available_for(name, wanted) == (wanted[:2], wanted[2:])
+
+
+def test_routed_turn_reads_its_own_fleet_and_restores_scope(fleet, tmp_path, monkeypatch):
+    from tools import kanban_tools
+    from hermes_constants import get_hermes_home, set_hermes_home_override, reset_hermes_home_override
+    decoy = tmp_path / 'launch'
+    decoy.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(decoy))
+    monkeypatch.setenv('HERMES_ROOT', str(decoy))
+    token = set_hermes_home_override(fleet / 'profiles' / 'alpha')
+    try:
+        assert kanban_tools._profile_toolsets('beta') == {'file'}
+        assert kanban_tools._skills_available_for('beta', ['external-beta']) == (['external-beta'], [])
+        assert get_hermes_home() == fleet / 'profiles' / 'alpha'
+    finally:
+        reset_hermes_home_override(token)
+
+
+def test_registry_create_preserves_a_valid_external_skill(fleet):
+    from tools import kanban_tools
+    from tools.registry import registry
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect_closing
+    result = json.loads(registry.dispatch('kanban_create', {
+        'title': 'Synthetic configured skill', 'assignee': 'alpha',
+        'body': 'BRIEF: synthetic acceptance', 'skills': ['external-alpha'],
+    }))
+    assert result.get('ok'), result
+    with connect_closing() as conn:
+        assert kb.get_task(conn, result['task_id']).skills == ['external-alpha']
+
+
+@pytest.mark.parametrize('mode', ['ordinary', 'safe', 'config'])
+def test_managed_worker_uses_its_frozen_config_without_profile_reads(fleet, tmp_path, mode):
+    source = Path(__file__).resolve().parents[2]
+    home = fleet / 'profiles' / 'alpha'
+    library = tmp_path / 'frozen-library'
+    skill = library / 'frozen-skill'
+    skill.mkdir(parents=True)
+    (skill / 'SKILL.md').write_text('---\nname: frozen-skill\ndescription: Fixture\n---\nFixture.\n')
+    snapshot = {'platform_toolsets': {'cli': ['file']}, 'skills': {'external_dirs': [str(library)]}}
+    script = tmp_path / 'frozen_probe.py'
+    script.write_text('import sys; sys.path.insert(0, ' + repr(str(source)) + ')\n' + textwrap.dedent(r'''
+        import json, os, sys
+        from agent.safe_worker_policy import _bind_worker_config, _bind_safe_worker_policy
+        cfg = json.loads(os.environ['SYNTHETIC_CONFIG'])
+        mode = os.environ['SYNTHETIC_MODE']
+        if mode == 'ordinary':
+            _bind_worker_config(cfg)
+        else:
+            _bind_safe_worker_policy(safe_mode=mode == 'safe', ignore_user_config=True, config=cfg)
+        reads = []
+        def audit(event, args):
+            if event == 'open' and str(args[0]).endswith('config.yaml'):
+                reads.append(str(args[0]))
+        sys.addaudithook(audit)
+        from tools import kanban_tools
+        assert kanban_tools._profile_toolsets('alpha') == {'file'}
+        assert kanban_tools._profile_toolsets('beta') is None
+        assert kanban_tools._skills_available_for('alpha', ['frozen-skill', 'external-alpha']) == (['frozen-skill'], ['external-alpha'])
+        assert kanban_tools._skills_available_for('beta', ['external-beta']) == (['external-beta'], [])
+        from hermes_cli.kanban_task_contract import configured_tools
+        try:
+            configured_tools('beta')
+        except ValueError:
+            pass
+        else:
+            raise AssertionError('another assignee borrowed the frozen worker config')
+        assert not reads, reads
+        preflight_reads = len(reads)
+        from tools.registry import registry
+        body = 'BRIEF: synthetic fanout\n```hermes-contract\n' + json.dumps({'version': 1, 'required_tools': ['terminal']}) + '\n```'
+        created = json.loads(registry.dispatch('kanban_create', {
+            'title': 'Synthetic frozen-worker fanout', 'assignee': 'beta', 'body': body,
+        }))
+        assert created.get('ok'), created
+        # Native role/ownership gates may inspect current fleet metadata at create;
+        # that must not replace this worker's execution configuration.
+        assert kanban_tools._profile_toolsets('alpha') == {'file'}
+        assert kanban_tools._profile_toolsets('beta') is None
+        print(json.dumps({'frozen': True, 'preflight_config_reads': preflight_reads, 'task_id': created['task_id']}))
+    '''))
+    env = {**os.environ, 'HOME': str(tmp_path), 'HERMES_HOME': str(home), 'HERMES_ROOT': str(fleet),
+           'HERMES_DISABLE_LAZY_INSTALLS': '1', 'SYNTHETIC_CONFIG': json.dumps(snapshot), 'SYNTHETIC_MODE': mode}
+    result = subprocess.run([sys.executable, str(script)], env=env, cwd=source,
+                            capture_output=True, text=True, timeout=45, check=False)
+    assert result.returncode == 0, result.stdout + result.stderr
+    observed = json.loads(result.stdout.splitlines()[-1])
+    assert observed.pop('task_id')
+    assert observed == {'frozen': True, 'preflight_config_reads': 0}
+    from hermes_cli.kanban_task_contract import preflight_reason
+    body = '```hermes-contract\n' + json.dumps({'version': 1, 'required_tools': ['terminal']}) + '\n```'
+    assert preflight_reason(body, 'beta') == 'required tools not configured: terminal'
+
+
