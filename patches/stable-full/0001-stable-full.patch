new file mode 100644
index 0000000000000000000000000000000000000000..0371bda90a182e27f3b49cbbc78b4ef7bdf0fbd1
--- /dev/null
+++ b/tests/tools/test_agent_tool_profile_contention.py
@@ -0,0 +1,135 @@
+"""A busy native state DB must not block tool publication for another owning home."""
+import copy
+import json
+from pathlib import Path
+import sqlite3
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+from agent.conversation_compression_prompt import compaction_tool_publication
+from agent.memory_provider import spawn_context_thread
+from hermes_constants import get_hermes_home, reset_hermes_home_override, set_hermes_home_override
+from hermes_state import SessionDB
+from tools.mcp_tool_agent import persist_agent_tool_names, refresh_agent_mcp_tools, restore_agent_tool_prefix, tool_pin_version
+
+
+def _schema(description):
+    return {"type": "function", "function": {"name": "read_file", "description": description,
+        "parameters": {"type": "object", "properties": {}}}}
+
+
+def _agent(db, description):
+    return SimpleNamespace(_session_db=db, session_id="same-session-id", tools=[_schema(description)],
+        valid_tool_names={"read_file"}, enabled_toolsets=None, disabled_toolsets=None)
+
+
+def _scoped(agent, action):
+    token = set_hermes_home_override(Path(agent._session_db.db_path).parent)
+    try:
+        return action()
+    finally:
+        reset_hermes_home_override(token)
+
+
+@pytest.fixture
+def homes(tmp_path, monkeypatch):
+    import httpx
+    import requests
+    def no_http(*args, **kwargs):
+        raise AssertionError("HTTP forbidden in native tool-publication contention test")
+    monkeypatch.setattr(httpx.Client, "send", no_http)
+    monkeypatch.setattr(httpx.AsyncClient, "send", no_http)
+    monkeypatch.setattr(requests.sessions.Session, "request", no_http)
+    stores = []
+    for name in ("profile-a", "profile-b"):
+        home = tmp_path / name
+        home.mkdir()
+        db = SessionDB(home / "state.db")
+        db.create_session("same-session-id", source="cli")
+        db.append_message("same-session-id", "user", "retained original work")
+        stores.append(db)
+    yield stores
+    for db in stores:
+        db.close()
+
+
+@pytest.mark.parametrize("blocked", ["pin", "compact"])
+@pytest.mark.parametrize("other", ["refresh", "restore"])
+def test_busy_profile_does_not_hold_other_profile_publisher(homes, monkeypatch, blocked, other):
+    first, second = homes
+    a, b = _agent(first, "profile-a schema"), _agent(second, "profile-b original schema")
+    _scoped(a, lambda: persist_agent_tool_names(a))
+    _scoped(b, lambda: persist_agent_tool_names(b))
+    expected_b = [_schema("profile-b refreshed schema")]
+    if other == "restore":
+        second.update_session_tool_names(b.session_id, {"version": tool_pin_version(), "tools": expected_b})
+
+    def catalog(**kwargs):
+        assert get_hermes_home() == Path(second.db_path).parent
+        return copy.deepcopy(expected_b)
+
+    monkeypatch.setattr("model_tools.get_tool_definitions", catalog)
+    attempted, completed = threading.Event(), threading.Event()
+    errors = []
+    before_a = first.get_messages_as_conversation(a.session_id)
+    # A real independent SQLite writer holds only profile A's reserved lock.
+    blocker = sqlite3.connect(first.db_path, isolation_level=None)
+    blocker.execute("BEGIN IMMEDIATE")
+
+    def trace(statement):
+        if statement.strip().upper() == "BEGIN IMMEDIATE":
+            attempted.set()
+
+    first._conn.set_trace_callback(trace)
+
+    def work_a():
+        try:
+            def write():
+                if blocked == "pin":
+                    persist_agent_tool_names(a)
+                else:
+                    snapshot = {"system_prompt": "profile-a compacted prefix",
+                        "tool_pin": {"version": tool_pin_version(), "tools": copy.deepcopy(a.tools)}}
+                    with compaction_tool_publication(a, snapshot) as prefix:
+                        first.archive_and_compact(a.session_id,
+                            [{"role": "user", "content": "profile-a compacted work"}], prefix_snapshot=prefix)
+            _scoped(a, write)
+        except BaseException as exc:
+            errors.append(exc)
+
+    def work_b():
+        try:
+            def publish():
+                if other == "refresh":
+                    refresh_agent_mcp_tools(b, content_aware=True)
+                else:
+                    restore_agent_tool_prefix(b, {"version": tool_pin_version(), "tools": expected_b})
+            _scoped(b, publish)
+            assert b.tools == expected_b
+            assert json.loads(second.get_session(b.session_id)["tool_names"])["tools"] == expected_b
+            completed.set()
+        except BaseException as exc:
+            errors.append(exc)
+
+    writer = spawn_context_thread(work_a, name="offline-contended-profile-a")
+    publisher = spawn_context_thread(work_b, name="offline-independent-profile-b")
+    writer.start()
+    try:
+        assert attempted.wait(10), "profile A did not reach a real native SQLite BEGIN"
+        publisher.start()
+        assert completed.wait(5), "profile B publication waited for another profile's SQLite writer"
+        assert first.get_messages_as_conversation(a.session_id) == before_a
+    finally:
+        blocker.rollback()
+        blocker.close()
+        writer.join(10)
+        if publisher.ident is not None:
+            publisher.join(10)
+        first._conn.set_trace_callback(None)
+    assert not writer.is_alive() and not publisher.is_alive() and errors == []
+    assert json.loads(first.get_session(a.session_id)["tool_names"])["tools"] == a.tools
+    assert json.loads(second.get_session(b.session_id)["tool_names"])["tools"] == expected_b
+    if blocked == "compact":
+        assert first.get_session(a.session_id)["system_prompt"] == "profile-a compacted prefix"
