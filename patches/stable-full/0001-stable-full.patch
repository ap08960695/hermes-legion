diff --git a/tests/gateway/test_transcript_metadata_startup.py b/tests/gateway/test_transcript_metadata_startup.py
new file mode 100644
index 0000000000000000000000000000000000000000..80bf2deb3fa22eba396c318e3babcd8f3ec17716
--- /dev/null
+++ b/tests/gateway/test_transcript_metadata_startup.py
@@ -0,0 +1,122 @@
+"""Saved-message metadata must not load the turn engine or change durable API text."""
+import builtins
+import copy
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import sysconfig
+import tempfile
+from types import MappingProxyType
+import unittest
+from unittest.mock import patch
+
+
+def cold_import_check():
+    original = builtins.__import__
+
+    def metadata_import(name, *args, **kwargs):
+        if name in {"agent.turn_context", "agent.conversation_compression", "agent.auxiliary_client"}:
+            raise AssertionError("metadata imported the turn engine: " + name)
+        return original(name, *args, **kwargs)
+
+    def no_external_work(event, args):
+        if event in {"subprocess.Popen", "os.system", "os.fork", "os.posix_spawn",
+                     "socket.connect", "socket.bind", "socket.getaddrinfo"}:
+            raise AssertionError("metadata attempted external work: " + event)
+
+    sys.addaudithook(no_external_work)
+    with patch("builtins.__import__", side_effect=metadata_import):
+        from gateway.session import SessionStore
+        from gateway.session_transcript import transcript_append_kwargs
+        assert SessionStore is not None
+        message = {"role": "assistant", "content": "visible", "api_content": " \nไทย {\"x\":1}\n",
+                   "timestamp": 0, "reasoning": "kept", "display_metadata": {"kind": "fixture"}}
+        original_message = copy.deepcopy(message)
+        row = transcript_append_kwargs("cold-session", message, fallback_ts=99)
+        assert message == original_message
+    assert "agent.turn_context" not in sys.modules
+    print(json.dumps(row))
+
+
+class TranscriptMetadataStartupTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.home = Path(self.temp.name)
+        self.addCleanup(self.temp.cleanup)
+
+    def test_cold_metadata_import_and_append_need_no_turn_engine(self):
+        result = subprocess.run(
+            [sys.executable, "-I", "-B", "-S", str(Path(__file__).resolve()), "--cold-import",
+             sysconfig.get_path("purelib"), sysconfig.get_path("platlib")],
+            env={**os.environ, "HOME": str(self.home), "HERMES_HOME": str(self.home),
+                 "PYTHONDONTWRITEBYTECODE": "1"},
+            cwd=self.home, capture_output=True, text=True, timeout=30,
+        )
+        self.assertEqual(result.returncode, 0, result.stderr)
+        row = json.loads(result.stdout)
+        self.assertEqual(row, {
+            "session_id": "cold-session", "role": "assistant", "content": "visible",
+            "tool_name": None, "tool_calls": None, "tool_call_id": None, "reasoning": "kept",
+            "reasoning_content": None, "reasoning_details": None, "codex_reasoning_items": None,
+            "codex_message_items": None, "platform_message_id": None, "observed": False,
+            "timestamp": 0, "api_content": " \nไทย {\"x\":1}\n", "display_kind": None,
+            "display_metadata": {"kind": "fixture"},
+        })
+
+    def test_sidecar_values_and_gateway_branch_keep_existing_semantics(self):
+        from agent.message_metadata import extract_api_content_sidecar
+        from gateway.slash_commands_session import _branch_row
+        for value in [None, False, 0, [], {}, "", " \nไทย {\"x\":1}\n"]:
+            with self.subTest(value=value):
+                expected = value if isinstance(value, str) else None
+                message = {"role": "user", "content": "visible", "api_content": value, "timestamp": 0}
+                original = copy.deepcopy(message)
+                self.assertEqual(extract_api_content_sidecar(MappingProxyType(message)), expected)
+                row = _branch_row(message)
+                self.assertEqual(row["api_content"], expected)
+                self.assertEqual((row["role"], row["content"], row["timestamp"]), ("user", "visible", 0))
+                self.assertEqual(message, original)
+        self.assertIsNone(extract_api_content_sidecar({}))
+
+    def test_sqlite_append_reopen_and_rewrite_preserve_sidecars_per_profile(self):
+        from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+        from gateway.config import GatewayConfig
+        from gateway.session import SessionStore
+        from hermes_state import SessionDB
+
+        for profile in ["first", "second"]:
+            home = self.home / profile
+            home.mkdir()
+            token = set_hermes_home_override(home)
+            try:
+                path = home / "state.db"
+                messages = [{"role": "user", "content": "visible", "api_content": " \nไทย " + profile},
+                            {"role": "assistant", "content": "done", "api_content": ""}]
+                with SessionDB(path) as db:
+                    db.create_session(session_id="same-id", source="cli", system_prompt=profile)
+                    store = SessionStore(home / "sessions", GatewayConfig(write_sessions_json=False))
+                    self.addCleanup(store.close_all_db_handles)
+                    store._db = db
+                    for message in messages:
+                        store.append_to_transcript("same-id", message)
+                    self.assertEqual([row["api_content"] for row in db.get_messages("same-id")],
+                                     [message["api_content"] for message in messages])
+                    self.assertEqual(store.load_transcript("same-id")[0]["api_content"], messages[0]["api_content"])
+                    messages[0]["api_content"] += " rewritten"
+                    self.assertTrue(store.rewrite_transcript("same-id", messages))
+                with SessionDB(path) as reopened:
+                    self.assertEqual([row["api_content"] for row in reopened.get_messages("same-id")],
+                                     [message["api_content"] for message in messages])
+                    self.assertEqual(reopened.get_session("same-id")["system_prompt"], profile)
+            finally:
+                reset_hermes_home_override(token)
+
+
+if __name__ == "__main__":
+    if sys.argv[1:2] == ["--cold-import"]:
+        sys.path[:0] = [str(Path(__file__).resolve().parents[2]), *sys.argv[2:]]
+        cold_import_check()
+    else:
+        unittest.main()
