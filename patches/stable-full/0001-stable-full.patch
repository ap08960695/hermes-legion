+    atomic_config_replace(fleet/'config.yaml',{'kanban':{'dispatch_profiles':[]}})
+    monkeypatch.setattr(profile_routing,'_entry',lambda *args:pytest.fail('Empty allowlist must not inspect profiles'))
+    assert profile_routing.routing_snapshot()['profiles']==[]
