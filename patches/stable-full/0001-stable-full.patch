+"""Recover a source-preserving update before importing any application code. Stdlib closure only."""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import stat
+
+from hermes_cli import update_preservation_io as io
+from hermes_cli.update_cmd_preserve import restore_customization_metadata
+
+
+def _generations(root, state):
+    refs = [state['before'], state['snapshot'], state['index_tree'], *state['targets']]
+    if state.get('plan'):
+        refs.extend([state['plan'], state['plan_index']])
+    return [io.tree_entries(root, ref) for ref in dict.fromkeys(refs)]
+
+
+def _verify_index(root, generations, path):
+    if io.git(root, 'ls-files', '--unmerged'):
+        raise OSError('Source index has a conflict; capsule retained for manual integration')
+    current = io.tree_entries(root, io.inspect_index(root, path / 'inspection.index'))
+    for name in set(current).union(*(set(tree) for tree in generations)):
+        if current.get(name) not in [tree.get(name) for tree in generations]:
+            raise OSError(f'Source index changed outside the update: {name}')
+
+
+def _current_version(root, name, hashes):
+    path = io.safe_path(root, name)
+    try:
+        info = path.lstat()
+    except FileNotFoundError:
+        return None
+    if stat.S_ISDIR(info.st_mode):
+        return 'directory', ''
+    if stat.S_ISLNK(info.st_mode):
+        mode = '120000'
+    elif stat.S_ISREG(info.st_mode):
+        mode = '100755' if info.st_mode & stat.S_IXUSR else '100644'
+    else:
+        raise OSError(f'Unsupported file type during source recovery: {name}')
+    return mode, hashes[name]
+
+
+def _verify_files(root, generations, *, state=None):
+    from hermes_cli._early_recovery import _hash_worktree, _custody_git, blob_id
+
+    names = sorted(set().union(*(set(tree) for tree in generations)))
+    for name in names:
+        io.safe_path(root, name)
+    unknown = set(filter(None, os.fsdecode(io.git(root, 'ls-files', '--others', '--exclude-standard', '-z')).split('\0'))) - set(names)
+    if unknown:
+        raise OSError('New source files appeared outside the interrupted update; capsule retained')
+    existing = [name for name in names if os.path.lexists(root / name) and not (root / name).is_dir()]
+    regular = [name for name in existing if not (root / name).is_symlink()]
+    hashes = _hash_worktree(_custody_git(root, ''), regular)
+    like = next(version[1] for tree in generations for version in tree.values())
+    hashes.update({name: blob_id(os.fsencode(os.readlink(root / name)), like)
+                   for name in existing if (root / name).is_symlink()})
+    current_versions = {}
+    attributed = None
+    for name in names:
+        current = _current_version(root, name, hashes)
+        current_versions[name] = current
+        choices = [tree.get(name) for tree in generations]
+        if current in choices:
+            continue
+        # A directory replacing a known file is recoverable only when every descendant is a
+        # known update path. Unknown/ignored contents are never recursively removed.
+        if current == ('directory', '') and _known_directory(root, name, names):
+            continue
+        if state is not None:
+            if attributed is None:
+                attributed = _interrupted_writes(root, state)
+            if name in attributed:
+                continue
+        raise OSError(f'Source changed outside the update; refusing to overwrite: {name}')
+    return current_versions
+
+
+def _interrupted_writes(root, state):
+    """Reuse native Git partial-write attribution, including stash cleanup and a killed recovery.
+
+    A truncated added file is ambiguous in the native policy: retain its bytes in the private
+    capsule before replacing it. Only Git's actual bytes or their prefix authorize recovery.
+    """
+    from hermes_cli._early_recovery import _custody_git, _paths_git_wrote
+
+    git = _custody_git(root, '')
+    snapshot = state['snapshot']
+    targets = list(dict.fromkeys([state['before'], *state['targets'], *([state['plan']] if state.get('plan') else [])]))
+    attributable = set()
+    for target in targets:
+        for previous, following in ((snapshot, target), (target, snapshot)):
+            if previous == following:
+                continue
+            written = _paths_git_wrote(git, root, previous, following, direct=True)
+            if written is not None:
+                restore, added, _directories, _kept = written
+                attributable.update(restore)
+                attributable.update(added)
+    return attributable
+
+
+def _known_directory(root, name, names):
+    known = set(names)
+    directory = root / name
+    for parent, dirs, files in os.walk(directory, followlinks=False):
+        for child in [*files, *(entry for entry in dirs if (Path(parent) / entry).is_symlink())]:
+            if (Path(parent) / child).relative_to(root).as_posix() not in known:
+                return False
+    return True
+
+
+def _restore_files(root, state, generations, current, capsule):
+    original = io.tree_entries(root, state['snapshot'])
+    names = sorted(set().union(*(set(tree) for tree in generations)), key=lambda n: len(Path(n).parts), reverse=True)
+    for name in names:
+        if current.get(name) not in [tree.get(name) for tree in generations]:
+            path = io.safe_path(root, name)
+            if path.is_file() and not path.is_symlink():
+                io.keep_partial_source(root, capsule, state, name)
+        if name not in original:
+            path = io.safe_path(root, name)
+            if path.is_dir() and not path.is_symlink():
+                path.rmdir()
+            else:
+                path.unlink(missing_ok=True)
+    for name in sorted(original, key=lambda n: len(Path(n).parts)):
+        if current.get(name) != original[name]:
+            _restore_file(root, name, original[name], state['snapshot'])
+
+
+def _restore_file(root, name, version, snapshot):
+    # Git owns pathname/type/filters and its interrupted-write rules. A Python temporary in the
+    # source directory would itself look like a foreign source file after a second SIGKILL.
+    io.safe_path(root, name)
+    io.git(root, 'restore', f'--source={snapshot}', '--worktree', '--', name)
+
+
+def _restore_head(root, state):
+    current = io.git(root, 'rev-parse', 'HEAD').decode().strip()
+    known = {state['before'], *state['targets']}
+    if current not in known:
+        raise OSError('Source HEAD no longer belongs to the interrupted update')
+    branch = state['branch']
+    if branch != 'HEAD':
+        tip = io.git(root, 'rev-parse', branch).decode().strip()
+        if tip not in known:
+            raise OSError('Original source branch was changed by another owner')
+        io.git(root, 'update-ref', branch, state['before'], tip)
+        io.git(root, 'symbolic-ref', 'HEAD', branch)
+    else:
+        io.git(root, 'update-ref', '--no-deref', 'HEAD', state['before'], current)
+
+
+def recover(root, marker, fields, *, index_free):
+    active = io.capsule(root, fields)
+    if active is None:
+        return False
+    if not index_free:
+        raise OSError('Source index is busy; preservation capsule retained')
+    path, state = active
+    root = Path(root)
+    head = io.git(root, 'rev-parse', 'HEAD').decode().strip()
+    if head not in {state['before'], *state['targets']}:
+        raise OSError('Source HEAD changed outside the interrupted update')
+    if state['phase'] == 'source_ready':
+        _verify_index(root, [io.tree_entries(root, state['plan_index'])], path)
+        _verify_files(root, [io.tree_entries(root, state['plan'])])
+        marker.unlink()
+        return True  # native completion/restart debt remains owed for the verified new source
+    generations = _generations(root, state)
+    _verify_index(root, generations, path)
+    current = _verify_files(root, generations, state=state)
+    # The journal remains armed through every write: another kill repeats the same guarded restore.
+    _restore_head(root, state)
+    _restore_files(root, state, generations, current, path)
+    io.replace_bytes(io.git_dir(root) / 'index', (path / 'original.index').read_bytes())
+    restore_customization_metadata(root, state['metadata'])
+    _verify_files(root, [io.tree_entries(root, state['snapshot'])])
+    if io.read_index(root) != (path / 'original.index').read_bytes():
+        raise OSError('Recovered source index could not be verified')
+    io.restore_obligations(state)
+    state['phase'] = 'recovered'
+    io.save(path, state)
+    marker.unlink()
+    return True
