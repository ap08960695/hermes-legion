@@ -0,0 +1,55 @@
+"""A historical updater cannot silently park/discard local patches through the Desktop handoff."""
+import json
+import os
+
+import pytest
+
+from tests.hermes_cli.test_update_target_identity import git
+from tests.scripts.desktop_update.test_desktop_update_posix_marker import _calls, _install, _run
+
+pytestmark = pytest.mark.platforms('posix')
+
+
+def source_install(tmp_path):
+    home, install = _install(tmp_path)
+    (install / '.gitignore').write_text('__pycache__/\n')
+    source = install / 'local-source.py'
+    source.write_text('VALUE = 1\n')
+    git(install, 'init', '-q')
+    git(install, 'config', 'user.name', 'Fixture')
+    git(install, 'config', 'user.email', 'fixture@example.invalid')
+    git(install, 'add', '-A')
+    git(install, '-c', 'commit.gpgsign=false', 'commit', '-qm', 'installed source')
+    return home, install, source
+
+
+@pytest.mark.parametrize('condition', ['dirty', 'unknown'])
+def test_unsupported_updater_refuses_before_mutating_or_parking_source(tmp_path, condition):
+    home, install, source = source_install(tmp_path)
+    options = {}
+    if condition == 'dirty':
+        source.write_text('VALUE = 2  # local customization\n')
+    else:
+        shims = tmp_path / 'shims'
+        shims.mkdir()
+        fake_git = shims / 'git'
+        fake_git.write_text('#!/bin/sh\nexit 7\n')
+        fake_git.chmod(0o755)
+        options['PATH'] = str(shims) + os.pathsep + os.environ.get('PATH', '')
+    before = source.read_bytes()
+    index = (install / '.git/index').read_bytes()
+    completed = _run(tmp_path, home, install, '--no-gateway', **options)
+    assert completed.returncode != 0
+    assert not any(call.startswith('update ') for call in _calls(tmp_path))
+    assert source.read_bytes() == before
+    assert (install / '.git/index').read_bytes() == index
+    result = json.loads((home / '.hermes-update-result.json').read_text())
+    assert not result['ok'] and result['exit_code'] != 0
+
+
+def test_clean_historical_checkout_keeps_its_existing_update_route(tmp_path):
+    home, install, source = source_install(tmp_path)
+    completed = _run(tmp_path, home, install, '--no-gateway')
+    assert completed.returncode == 0
+    assert any(call.startswith('update ') for call in _calls(tmp_path))
+    assert source.read_bytes() == b'VALUE = 1\n'
