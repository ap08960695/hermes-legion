+import { useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { useI18n } from '@/i18n'
+import { useStoreSelector } from '@/lib/use-session-slice'
+import {
+  $draftTitles,
+  type ComposerAttachment,
+  hasUnassignedSessionDraft,
+  restoreUnassignedSessionDraft,
+  takeSessionDraft
+} from '@/store/composer'
+import { draftIdentityKey } from '@/store/composer-draft-owner'
+import type { SessionOwnerScope } from '@/store/session-request-router'
+
+interface UnassignedDraftNoticeProps {
+  scope: string | null
+  owner: SessionOwnerScope
+  empty: boolean
+  canRestore: () => boolean
+  onRestored: (text: string, attachments: ComposerAttachment[]) => void
+}
+
+/** Old storage has no trustworthy owner. Offer an explicit copy without previewing or consuming it. */
+export function UnassignedDraftNotice({ scope, owner, empty, canRestore, onRestored }: UnassignedDraftNoticeProps) {
+  const { t } = useI18n()
+  const available = useStoreSelector($draftTitles, () => hasUnassignedSessionDraft(scope))
+  const [dismissed, setDismissed] = useState<string | undefined>()
+  const [failedKey, setFailedKey] = useState<string | undefined>()
+  const key = draftIdentityKey(scope || '__new__', owner)
+
+  if (!available || key === undefined || dismissed === key) {
+    return null
+  }
+
+  return (
+    <div
+      className="flex items-center justify-between gap-2 text-xs text-muted-foreground"
+      data-slot="composer-unassigned-draft"
+    >
+      <div className="min-w-0">
+        <span role="status">{t.composer.unassignedDraftNotice}</span>
+        {failedKey === key && <p className="text-destructive" role="alert">{t.composer.unassignedDraftRestoreFailed}</p>}
+      </div>
+      <div className="flex shrink-0 items-center gap-1">
+        <Button
+          disabled={!empty}
+          onClick={() => {
+            if (!canRestore()) return
+
+            if (!restoreUnassignedSessionDraft(scope, owner)) {
+              setFailedKey(key)
+              return
+            }
+
+            const draft = takeSessionDraft(scope, owner)
+            onRestored(draft.text, draft.attachments)
+            setFailedKey(undefined)
+            setDismissed(key)
+          }}
+          type="button"
+          variant="ghost"
+        >
+          {t.composer.unassignedDraftRestore}
+        </Button>
+        <Button aria-label={t.common.close} onClick={() => setDismissed(key)} type="button" variant="ghost">
+          ×
+        </Button>
+      </div>
+    </div>
+  )
+}
