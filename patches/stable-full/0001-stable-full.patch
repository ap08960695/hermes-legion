+def _uses_substring(term: str) -> bool:
+    """Thai/CJK use substring routes because unicode61 has no word segmentation."""
+    return any(
+        0x0E00 <= ord(ch) <= 0x0E7F
+        or 0x3400 <= ord(ch) <= 0x9FFF
+        or 0x20000 <= ord(ch) <= 0x2A6DF
+        or 0x3000 <= ord(ch) <= 0x30FF
+        or 0xAC00 <= ord(ch) <= 0xD7AF
+        for ch in term
