+"""TUI delivery receipts, committed atomically with their subscription cursor.
+
+Pending means safe to retry. Claimed/admitted/unknown are never auto-replayed:
+the worker may have started. Terminal receipts are immutable, not task approval.
+This module has no network, model, session-opening or task-transition operation.
+"""
+from __future__ import annotations
+
+from collections import defaultdict
+import contextlib
+from dataclasses import dataclass
+from pathlib import Path
+import secrets
+import sqlite3
+import time
+
+from gateway.warning_notifications import DiagnosticText
+
+TABLE = 'kanban_tui_deliveries'
+TERMINAL = ('settled', 'failed', 'cancelled')
+
+
+def owner_home() -> str:
+    from hermes_constants import get_hermes_home
+    return str(get_hermes_home().resolve())
+
+
+@dataclass(frozen=True)
+class DeliveryRef:
+    path: str
+    id: int
+    home: str
+    session_key: str
+
+
+class DeliveryText(str):
+    """A string at the renderer boundary, with an internal durable identity."""
+
+
+class DiagnosticDeliveryText(DiagnosticText):
+    """Preserve the existing diagnostic presentation policy."""
+
+
+def _text(row, path: str):
+    cls = DiagnosticDeliveryText if row['diagnostic'] else DeliveryText
+    text = cls(row['text'])
+    text.delivery_ref = DeliveryRef(path, row['id'], row['home'], row['session_key'])
+    return text
+
+
+def _ensure_schema(conn) -> None:
+    # SQLite DDL participates in the caller's cursor/preparation transaction.
+    if not conn.in_transaction:
+        raise RuntimeError('TUI delivery preparation requires a transaction')
+    conn.execute('''CREATE TABLE IF NOT EXISTS kanban_tui_deliveries (
+        id INTEGER PRIMARY KEY AUTOINCREMENT,
+        home TEXT NOT NULL, session_key TEXT NOT NULL, task_id TEXT NOT NULL,
+        thread_id TEXT NOT NULL, event_id INTEGER NOT NULL,
+        text TEXT NOT NULL, diagnostic INTEGER NOT NULL,
+        state TEXT NOT NULL DEFAULT 'pending'
+            CHECK(state IN ('pending','claimed','admitted','unknown','settled','failed','cancelled')),
+        claim_token TEXT, created_at REAL NOT NULL, updated_at REAL NOT NULL,
+        UNIQUE(home, session_key, task_id, thread_id, event_id))''')
+    conn.execute('''CREATE INDEX IF NOT EXISTS idx_tui_delivery_owner_state
+                    ON kanban_tui_deliveries(home, session_key, state, id)''')
+    conn.execute('''CREATE TRIGGER IF NOT EXISTS cancel_pending_tui_deliveries
+        AFTER DELETE ON kanban_notify_subs WHEN LOWER(OLD.platform)='tui'
+        BEGIN
+            UPDATE kanban_tui_deliveries SET state='cancelled',
+                updated_at=MAX(updated_at, (julianday('now')-2440587.5)*86400.0)
+            WHERE task_id=OLD.task_id AND session_key=OLD.chat_id
+                AND thread_id=COALESCE(OLD.thread_id,'') AND state='pending';
+        END''')
+
+
+def prepare(conn, sub: dict, event_id: int, text: str):
+    """Persist a formatted event under the same transaction as its cursor."""
+    from hermes_cli.kanban_db_connect import _main_db_file
+    path = _main_db_file(conn)
+    if not path:
+        raise ValueError('Durable TUI notifications require a file-backed board')
+    _ensure_schema(conn)
+    key = (owner_home(), sub['chat_id'], sub['task_id'], sub.get('thread_id') or '', event_id)
+    now = time.time()
+    conn.execute('''INSERT OR IGNORE INTO kanban_tui_deliveries
+        (home,session_key,task_id,thread_id,event_id,text,diagnostic,created_at,updated_at)
+        VALUES (?,?,?,?,?,?,?,?,?)''', (*key, str(text), int(isinstance(text, DiagnosticText)), now, now))
+    row = conn.execute('''SELECT * FROM kanban_tui_deliveries
+        WHERE home=? AND session_key=? AND task_id=? AND thread_id=? AND event_id=?''', key).fetchone()
+    return _text(row, path)
+
+
+def read_receipts(path: Path, *, home: str, session_key: str | None, states: tuple | None = None) -> list[dict]:
+    """Read only; absent legacy tables do not create a DB, sidecar or schema."""
+    if not path.exists():
+        return []
+    with contextlib.closing(sqlite3.connect(path.resolve().as_uri() + '?mode=ro', uri=True)) as conn:
+        conn.row_factory = sqlite3.Row
+        if not conn.execute("SELECT 1 FROM sqlite_master WHERE name=? AND type='table'", (TABLE,)).fetchone():
+            return []
+        where = 'home=?'
+        args = [home]
+        if session_key is not None:
+            where += ' AND session_key=?'
+            args.append(session_key)
+        if states is not None:
+            if not states:
+                return []
+            where += ' AND state IN (' + ','.join('?' for _ in states) + ')'
+            args.extend(states)
+        return [dict(row) for row in conn.execute(f'SELECT * FROM {TABLE} WHERE {where} ORDER BY id', args)]
+
+
+def pending(path: Path, *, home: str, session_key: str | None) -> list:
+    return [_text(row, str(path.resolve()))
+            for row in read_receipts(path, home=home, session_key=session_key, states=('pending',))]
+
+
+@dataclass(frozen=True)
+class Claim:
+    token: str
+    refs: tuple[DeliveryRef, ...]
+
+    def mark(self, state: str) -> None:
+        """Token-fenced state change; terminal results can never be overwritten."""
+        if state not in ('pending', 'admitted', 'unknown', *TERMINAL):
+            raise ValueError('Unsupported TUI delivery receipt state')
+        from hermes_cli import kanban_db_connect as kbc
+        groups = defaultdict(list)
+        for ref in self.refs:
+            groups[ref.path].append(ref)
+        sources = ('claimed',) if state in ('pending', 'admitted') else ('claimed', 'admitted', 'unknown')
+        for path, refs in groups.items():
+            with kbc.connect_closing(Path(path)) as conn, kbc.write_txn(conn):
+                for ref in refs:
+                    conn.execute(f'''UPDATE {TABLE} SET state=?, updated_at=?
+                        WHERE id=? AND home=? AND session_key=? AND claim_token=?
+                        AND state IN ({','.join('?' for _ in sources)})''',
+                        (state, time.time(), ref.id, ref.home, ref.session_key, self.token, *sources))
+
+
+def claim(texts: list, *, home: str, session_key: str, session_keys: tuple = ()) -> tuple[list, Claim]:
+    """CAS pending rows before dispatch. No age-based reclaim of ambiguous work."""
+    from hermes_cli import kanban_db_connect as kbc
+    groups = defaultdict(list)
+    accepted_keys = {session_key, *session_keys}
+    for text in texts:
+        ref = getattr(text, 'delivery_ref', None)
+        if ref and ref.home == home and ref.session_key in accepted_keys:
+            groups[ref.path].append(ref)
+    token, acquired = secrets.token_hex(24), []
+    try:
+        for path, refs in groups.items():
+            current = []
+            with kbc.connect_closing(Path(path)) as conn, kbc.write_txn(conn):
+                _ensure_schema(conn)
+                for ref in refs:
+                    from hermes_cli.kanban_db_attention import delivery_is_eligible
+                    if not delivery_is_eligible(conn, ref.id, home=home):
+                        conn.execute(f'''UPDATE {TABLE} SET state='cancelled',updated_at=?
+                            WHERE id=? AND home=? AND session_key=? AND state='pending' ''',
+                            (time.time(), ref.id, home, ref.session_key))
+                        continue
+                    conn.execute(f'''UPDATE {TABLE} SET state='cancelled', updated_at=?
+                        WHERE id=? AND home=? AND session_key=? AND state='pending'
+                        AND NOT EXISTS (SELECT 1 FROM kanban_notify_subs s
+                            WHERE s.task_id={TABLE}.task_id AND LOWER(s.platform)='tui'
+                            AND s.chat_id={TABLE}.session_key AND s.thread_id={TABLE}.thread_id)''',
+                        (time.time(), ref.id, home, ref.session_key))
+                    changed = conn.execute(f'''UPDATE {TABLE} SET state='claimed', claim_token=?, updated_at=?
+                        WHERE id=? AND home=? AND session_key=? AND state='pending' ''',
+                        (token, time.time(), ref.id, home, ref.session_key)).rowcount
+                    if changed:
+                        current.append(ref)
+            acquired.extend(current)
+    except Exception:
+        Claim(token, tuple(acquired)).mark('pending')  # no dispatch has occurred
+        raise
+    claimed = set(acquired)
+    result = []
+    for text in texts:
+        ref = getattr(text, 'delivery_ref', None)
+        if ref is None:
+            result.append(text)
+        elif ref in claimed:
+            result.append(text)
+            claimed.remove(ref)  # Repeated buffer entries cannot duplicate the same durable event.
+    return result, Claim(token, tuple(acquired))
