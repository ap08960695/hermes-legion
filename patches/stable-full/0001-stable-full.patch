index 0000000000000000000000000000000000000000..37273c3a954e8702929241287deff2de591b6f55
--- /dev/null
+++ b/apps/desktop/src/app/focus/model.ts
@@ -0,0 +1,119 @@
+import type { SessionControlGoal } from '@/store/session-control'
+
+export type PrimarySection = 'chat' | 'tasks' | 'bots' | 'hub'
+export type FocusTarget = { path: string } | { pane: string } | { panel: 'work' | 'goal' } | { statusbar: true }
+export interface FocusFeature {
+  id: string
+  statusbar?: true
+  path?: string
+  pane?: string
+  panel?: 'work' | 'goal'
+  label?: string
+  codicon: string
+  group: 'work' | 'team' | 'system'
+}
+
+export function resolvePrimaryTarget(
+  section: PrimarySection,
+  chatPath: string | null,
+  routes: readonly string[],
+  panes: readonly string[] = []
+): FocusTarget {
+  if (section === 'hub') return { path: routes.includes('/hub') ? '/hub' : '/artifacts' }
+  if (section === 'chat') return { path: chatPath ?? '/' }
+  if (section === 'tasks') return { path: routes.includes('/kanban') ? '/kanban' : '/agents' }
+  if (section === 'bots' && routes.includes('/bots')) return { path: '/bots' }
+  if (section === 'bots')
+    return panes.includes('hermes-bots:pane') ? { pane: 'hermes-bots:pane' } : { path: '/profiles' }
+  return { path: '/artifacts' }
+}
+
+const CORE_FEATURES: readonly FocusFeature[] = [
+  { id: 'sessions', path: '/history', codicon: 'comment-discussion', group: 'work' },
+  { id: 'projects', path: '/projects', label: 'Projects', codicon: 'root-folder', group: 'work' },
+  { id: 'goals', panel: 'goal', codicon: 'target', group: 'work' },
+  { id: 'summary', panel: 'work', codicon: 'checklist', group: 'work' },
+  { id: 'runs', path: '/agents', codicon: 'run-all', group: 'work' },
+  { id: 'hub', path: '/hub', codicon: 'folder-library', group: 'work' },
+  { id: 'schedules', path: '/cron', codicon: 'calendar', group: 'work' },
+  { id: 'import', path: '/session-import', codicon: 'cloud-download', group: 'work' },
+  { id: 'profiles', path: '/profiles', codicon: 'organization', group: 'team' },
+  { id: 'skills', path: '/capabilities?tab=skills', codicon: 'book', group: 'team' },
+  { id: 'tools', path: '/capabilities?tab=toolsets', codicon: 'tools', group: 'team' },
+  { id: 'connectors', path: '/capabilities?tab=connectors', codicon: 'plug', group: 'team' },
+  { id: 'plugins', path: '/capabilities?tab=plugins', codicon: 'extensions', group: 'team' },
+  { id: 'starmap', path: '/starmap', codicon: 'type-hierarchy', group: 'team' },
+  { id: 'messaging', path: '/messaging', codicon: 'mail', group: 'team' },
+  { id: 'webhooks', path: '/webhooks', codicon: 'radio-tower', group: 'team' },
+  { id: 'models', path: '/settings?tab=config:model', codicon: 'chip', group: 'system' },
+  { id: 'accounts', path: '/settings?tab=providers&pview=accounts', codicon: 'account', group: 'system' },
+  { id: 'gateway', path: '/settings?tab=gateway', codicon: 'server', group: 'system' },
+  { id: 'usage', path: '/command-center?section=usage', codicon: 'graph', group: 'system' },
+  { id: 'memory', path: '/settings?tab=config:memory', codicon: 'database', group: 'system' },
+  { id: 'appearance', path: '/settings?tab=config:appearance', codicon: 'paintcan', group: 'system' },
+  { id: 'notifications', path: '/settings?tab=notifications', codicon: 'bell', group: 'system' },
+  { id: 'keybinds', path: '/settings?tab=keybinds', codicon: 'keyboard', group: 'system' },
+  { id: 'privacy', path: '/settings?tab=vault', codicon: 'shield', group: 'system' },
+  { id: 'storage', path: '/settings?tab=sessions', codicon: 'archive', group: 'system' },
+  { id: 'settings', path: '/settings', codicon: 'settings-gear', group: 'system' },
+  { id: 'logs', path: '/command-center?section=system', label: 'Logs & diagnostics', codicon: 'output', group: 'system' },
+  { id: 'about', path: '/settings?tab=about', codicon: 'info', group: 'system' }
+]
+
+export function buildFeatureCatalog(
+  contributed: readonly { id: string; label: string; path: string; codicon: string }[],
+  panes: readonly { id: string; title?: string }[] = []
+): FocusFeature[] {
+  const rows = CORE_FEATURES.map(row => ({ ...row }))
+  for (const item of contributed) {
+    if (['/spaces', '/artifacts', '/hub'].includes(item.path)) continue
+    if (!rows.some(row => row.id === item.id || row.path === item.path)) rows.push({ ...item, group: 'team' })
+  }
+  for (const pane of panes) {
+    if (['sessions', 'workspace', 'hermes-bots:pane'].includes(pane.id) || pane.id.startsWith('session-tile:') || pane.id.startsWith('route-tile:')) continue
+    if (!pane.title || rows.some(row => row.pane === pane.id)) continue
+    rows.push({ id: `pane:${pane.id}`, pane: pane.id, label: pane.title, codicon: 'layout', group: 'work' })
+  }
+  return rows
+}
+
+type GoalEvidence = Pick<SessionControlGoal, 'status' | 'title'> &
+  Partial<Pick<SessionControlGoal, 'wait_barrier' | 'paused_reason' | 'last_reason'>>
+export interface WorkEvidence {
+  known?: boolean
+  busy?: boolean
+  needsInput?: boolean
+  finished?: boolean
+  providerWait?: string
+  goal?: GoalEvidence | null
+}
+export type WorkKind =
+  | 'unknown'
+  | 'idle'
+  | 'running'
+  | 'finished'
+  | 'done'
+  | 'input'
+  | 'provider'
+  | 'process'
+  | 'session'
+  | 'until'
+  | 'paused'
+export function workStatus(evidence: WorkEvidence): { kind: WorkKind; reason: string; target?: string } {
+  const { goal } = evidence
+  if (evidence.known === false) return { kind: 'unknown', reason: '' }
+  if (evidence.needsInput) return { kind: 'input', reason: '' }
+  if (goal?.wait_barrier && goal.status === 'active') {
+    const wait = goal.wait_barrier
+    return {
+      kind: wait.type === 'pid' ? 'process' : wait.type,
+      reason: wait.reason,
+      ...('target' in wait ? { target: String(wait.target) } : {})
+    }
+  }
+  if (evidence.providerWait) return { kind: 'provider', reason: evidence.providerWait }
+  if (goal?.status === 'paused') return { kind: 'paused', reason: goal.paused_reason || goal.last_reason || '' }
+  if (evidence.busy) return { kind: 'running', reason: '' }
+  if (goal?.status === 'done') return { kind: 'done', reason: goal.title }
+  return { kind: evidence.finished ? 'finished' : 'idle', reason: '' }
+}
