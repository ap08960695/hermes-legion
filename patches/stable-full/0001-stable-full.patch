--- /dev/null
+++ b/tests/agent/test_skill_directory_cycles.py
@@ -0,0 +1,71 @@
+"""Skill discovery must terminate on ancestor links without losing legitimate alias views."""
+import os
+from pathlib import Path
+
+import pytest
+
+pytestmark = pytest.mark.require_symlinks
+
+
+def _skill(path):
+    path.mkdir(parents=True)
+    file = path / 'SKILL.md'
+    file.write_text('---\nname: fixture\ndescription: Synthetic fixture\n---\nFixture.\n')
+    return file
+
+
+def _budget_scans(monkeypatch, root, limit=64):
+    real = os.scandir
+    visited = []
+    def scan(path):
+        if isinstance(path, (str, os.PathLike)) and Path(path).is_relative_to(root):
+            visited.append(str(path))
+            assert len(visited) <= limit, 'skill discovery repeatedly followed an ancestor cycle'
+        return real(path)
+    monkeypatch.setattr(os, 'scandir', scan)
+    return visited
+
+
+def test_index_skips_ancestor_cycle_but_keeps_independent_aliases(tmp_path, monkeypatch):
+    from agent.skill_utils import iter_skill_index_files
+    root = tmp_path / 'skills'
+    local = _skill(root / 'local')
+    external = tmp_path / 'external'
+    _skill(external / 'shared')
+    (root / 'again').symlink_to(root, target_is_directory=True)
+    for name in ['alias-a', 'alias-b']:
+        (root / name).symlink_to(external, target_is_directory=True)
+    visits = _budget_scans(monkeypatch, root)
+    assert list(iter_skill_index_files(root, 'SKILL.md')) == sorted([
+        local, root / 'alias-a/shared/SKILL.md', root / 'alias-b/shared/SKILL.md',
+    ])
+    assert visits
+
+
+def test_index_terminates_on_branching_cycles(tmp_path, monkeypatch):
+    from agent.skill_utils import iter_skill_index_files
+    root = tmp_path / 'skills'
+    real = _skill(root / 'real')
+    for name in ['again-a', 'again-b']:
+        (root / name).symlink_to(root, target_is_directory=True)
+    _budget_scans(monkeypatch, root)
+    assert list(iter_skill_index_files(root, 'SKILL.md')) == [real]
+
+
+def test_catalog_cache_signature_is_bounded_and_still_detects_install(tmp_path, monkeypatch):
+    from tools.skills_tool import _skills_scan_signature
+    root = tmp_path / 'skills'
+    _skill(root / 'category/real')
+    for name in ['again-a', 'again-b']:
+        (root / name).symlink_to(root, target_is_directory=True)
+    _budget_scans(monkeypatch, root)
+    first = _skills_scan_signature([root], set())
+    _skill(root / 'category/new')
+    assert _skills_scan_signature([root], set()) != first
+
+
+def test_deep_acyclic_skill_is_not_cut_off(tmp_path):
+    from agent.skill_utils import iter_skill_index_files
+    root = tmp_path / 'skills'
+    real = _skill(root.joinpath(*['category'] * 12, 'deep'))
+    assert list(iter_skill_index_files(root, 'SKILL.md')) == [real]
