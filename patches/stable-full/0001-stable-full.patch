index 0000000000000000000000000000000000000000..52e353c562911f0e00b06217cd3f5aca50deb35f
--- /dev/null
+++ b/apps/desktop/electron/config-autosave.ts
@@ -0,0 +1,209 @@
+import type { HermesApiRequest } from '../../shared/src/api-request'
+import { mergeConfigPatch } from '../../shared/src/config-patch'
+
+export interface CapturedConfigRoute {
+  key: string
+  send: (request: HermesApiRequest) => Promise<unknown>
+}
+
+interface PendingSave {
+  request: HermesApiRequest
+  route: CapturedConfigRoute
+  resolve: (value: unknown) => void
+  reject: (reason: unknown) => void
+  promise: Promise<unknown>
+  timer: ReturnType<typeof setTimeout>
+}
+
+interface OwnerQueue {
+  tail: Promise<unknown>
+  pending?: PendingSave
+  unsaved: { request: HermesApiRequest; route: CapturedConfigRoute }[]
+  active: number
+}
+
+function compatible(left: HermesApiRequest, right: HermesApiRequest): boolean {
+  return left.path === right.path && left.timeoutMs === right.timeoutMs &&
+    left.priority === right.priority && left.passive === right.passive &&
+    canCoalesce(patch(left), patch(right))
+}
+
+function patch(request: HermesApiRequest): Record<string, unknown> {
+  return (request.body as { config: Record<string, unknown> }).config
+}
+
+function mapping(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+}
+
+/** A replacement can erase an existing mapping. Folding a later mapping/null
+ * into it would instead merge with/ignore that old mapping on the backend. */
+function canCoalesce(previous: Record<string, unknown>, next: Record<string, unknown>): boolean {
+  return Object.entries(next).every(([key, value]) => {
+    if (!Object.hasOwn(previous, key)) { return true }
+    const old = previous[key]
+
+    if (mapping(old) && mapping(value)) { return canCoalesce(old, value) }
+
+    return old === null || mapping(old) || (value !== null && !mapping(value))
+  })
+}
+
+/** The main process, rather than a settings component, owns accepted edits.
+ * Reads and explicit writes are barriers on the same owner queue. */
+export function createConfigAutosaveQueue(
+  dispatch: (request: HermesApiRequest) => Promise<unknown>,
+  capture: (request: HermesApiRequest) => CapturedConfigRoute
+) {
+  const owners = new Map<string, OwnerQueue>()
+  let mutations = 0
+
+  const release = (key: string, owner: OwnerQueue) => {
+    if (!owner.pending && owner.unsaved.length === 0 && owner.active === 0 && owners.get(key) === owner) {
+      owners.delete(key)
+    }
+  }
+
+  const enqueue = (key: string, owner: OwnerQueue, request: HermesApiRequest, route: CapturedConfigRoute) => {
+    owner.active += 1
+
+    const result = owner.tail.catch(() => undefined).then(async () => {
+      const isWrite = request.method?.toUpperCase() === 'PUT'
+
+      // Retain the current write BEFORE retrying its predecessor. If the
+      // predecessor fails again, closing the renderer cannot discard either.
+      if (isWrite) { owner.unsaved.push({ request, route }) }
+      const response = await drain(owner)
+
+      return isWrite ? response : send(request, route)
+    })
+
+    owner.tail = result
+    // Observe errors without changing the rejecting promise returned to callers.
+    void result.catch(() => undefined).finally(() => {
+      owner.active -= 1
+      release(key, owner)
+    })
+
+    return result
+  }
+
+  const send = async (request: HermesApiRequest, route: CapturedConfigRoute) => {
+    const response = await route.send(request)
+
+    if (request.method?.toUpperCase() === 'PUT' && (response as { ok?: boolean } | null)?.ok === false) {
+      throw new Error('Settings save was refused')
+    }
+
+    return response
+  }
+
+  const drain = async (owner: OwnerQueue) => {
+    let response: unknown
+
+    while (owner.unsaved.length > 0) {
+      const next = owner.unsaved[0]
+      response = await send(next.request, next.route)
+      owner.unsaved.shift()
+    }
+
+    return response
+  }
+
+  const flushOwner = (key: string, owner: OwnerQueue) => {
+    const pending = owner.pending
+
+    if (pending) {
+      clearTimeout(pending.timer)
+      owner.pending = undefined
+      void enqueue(key, owner, pending.request, pending.route).then(pending.resolve, pending.reject)
+    }
+  }
+
+  const queue = {
+    run(request: HermesApiRequest): Promise<unknown> {
+      if (request.path.split('?')[0] !== '/api/config') {
+        return dispatch(request)
+      }
+
+      if (mutations > 0) {
+        return Promise.reject(new Error('Settings are waiting for a profile update'))
+      }
+
+      const route = capture(request)
+      // Aliases and registry connections may resolve to the same config file.
+      // Until the backend exposes a canonical home identity, one low-volume
+      // config lane prevents aliases from overtaking each other.
+      const key = 'config' 
+
+      const owner = owners.get(key) ?? { tail: Promise.resolve(), active: 0, unsaved: [] }
+      owners.set(key, owner)
+
+      if (request.method?.toUpperCase() !== 'PUT' || !request.configAutosave) {
+        flushOwner(key, owner)
+
+        return enqueue(key, owner, request, route)
+      }
+
+      if (owner.pending && (owner.pending.route.key !== route.key || !compatible(owner.pending.request, request))) {
+        flushOwner(key, owner)
+      }
+
+      if (owner.pending) {
+        owner.pending.request = {
+          ...request,
+          body: { config: mergeConfigPatch(patch(owner.pending.request), patch(request)) }
+        }
+        clearTimeout(owner.pending.timer)
+        owner.pending.timer = setTimeout(() => flushOwner(key, owner), 550)
+
+        return owner.pending.promise
+      }
+
+      let resolve!: (value: unknown) => void
+      let reject!: (reason: unknown) => void
+      const promise = new Promise<unknown>((done, fail) => { resolve = done; reject = fail })
+      owner.pending = {
+        request, route, resolve, reject, promise,
+        timer: setTimeout(() => flushOwner(key, owner), 550)
+      }
+
+      return promise
+    },
+    hasPending: () => owners.size > 0,
+    async flush(): Promise<void> {
+      while (owners.size > 0) {
+        const batch = [...owners.entries()]
+
+        for (const [key, owner] of batch) {
+          if (!owner.pending && owner.active === 0 && owner.unsaved.length > 0) {
+            owner.active += 1
+            owner.tail = drain(owner).finally(() => { owner.active -= 1; release(key, owner) })
+            void owner.tail.catch(() => undefined)
+          }
+
+          flushOwner(key, owner)
+        }
+
+        await Promise.all(batch.map(([, owner]) => owner.tail))
+
+        for (const [key, owner] of batch) { release(key, owner) }
+      }
+    },
+    async withMutation<T>(operation: () => Promise<T>): Promise<T> {
+      // Close admission synchronously. The already captured routes may finish
+      // before the native profile teardown gate is acquired by operation.
+      mutations += 1
+
+      try {
+        await queue.flush()
+
+        return await operation()
+      } finally {
+        mutations -= 1
+      }
+    }
+  }
+
+  return queue
+}
diff --git a/apps/desktop/electron/config-patch-null.test.ts b/apps/desktop/electron/config-patch-null.test.ts
