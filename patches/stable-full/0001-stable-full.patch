+class GlobalSearch:
+    """Verify atomic query terms against logical structured text, with native token rules."""
+
+    def __init__(self, conn, specs, deadline=None, *, substring_languages=True, cjk_split=False):
+        self.conn, self.deadline = conn, deadline
+        self.specs = list(dict.fromkeys((term, bool(prefix)) for term, prefix in specs))
+        self.terms = list(dict.fromkeys(term for term, _ in self.specs))
+        self.substring_languages = substring_languages
+        self.cjk_split = cjk_split
+        self.cache = OrderedDict()
+        self.tool_cache = OrderedDict()
+        self.field_cache = OrderedDict()
+        self.raw_character_cache = OrderedDict()
+        self.json_token_patterns = {}
+        self.small_json_cache = OrderedDict()
+        self.ordered_prefilter = _OrderedPrefilter()
+        self.error = None
+        self.oracle = None
+        self._prepared = None
+
+    def close(self):
+        self.small_json_cache.clear()
+        self.ordered_prefilter.close()
+        if self.oracle is not None:
+            self.oracle.close()
+            self.oracle = None
+
+    def invalidate(self, message_id):
+        self.cache.pop(message_id, None)
+        self.tool_cache.pop(message_id, None)
+        self.field_cache.pop((message_id, 'tool_name'), None)
+        self.field_cache.pop((message_id, 'tool_calls'), None)
+        self.field_cache.pop((message_id, 'content'), None)
+        for key in list(self.raw_character_cache):
+            if key[0] == message_id:
+                self.raw_character_cache.pop(key, None)
+
+    def _prepare(self):
+        if self._prepared is not None:
+            return self._prepared
+        if self.deadline is not None and time.monotonic() >= self.deadline:
+            raise TimeoutError('structured global search timed out')
+        self.oracle = _Unicode61()
+        prepared = {}
+        for term, prefix in self.specs:
+            tokens = self.oracle.tokens(term)
+            literal = (self.substring_languages and _uses_substring(term)) or not tokens
+            prepared[(term, prefix)] = (tokens, literal)
+        self._prepared = prepared
+        return prepared
+
+    def _tokens(self, blob, spans, prepared):
+        return self._tokens_from_chunks(text_chunks(blob, spans, self.deadline), prepared,
+                                        cjk_split=self.cjk_split)
+
+    def _tokens_from_chunks(self, chunks, prepared, *, cjk_split=False):
+        token_specs = [(key, value[0]) for key, value in prepared.items() if not value[1]]
+        positions = {key: None for key, _ in token_specs}
+        remaining = len(token_specs)
+        max_token = max((len(token) for _, phrase in token_specs for token in phrase), default=0)
+        max_phrase = max((len(phrase) for _, phrase in token_specs), default=1)
+        recent = deque(maxlen=max_phrase)
+        normalized = ''
+        start_char = start_byte = None
+        chars = size = 0
+        binary = False
+
+        def finish():
+            nonlocal normalized, start_char, start_byte, remaining
+            if normalized:
+                recent.append((normalized, start_char, start_byte))
+                for key, phrase in token_specs:
+                    if positions[key] is not None or len(recent) < len(phrase):
+                        continue
+                    tail = list(recent)[-len(phrase):]
+                    if all((part[0].startswith(wanted) if key[1] and index == len(phrase) - 1
+                            else part[0] == wanted) for index, (part, wanted) in enumerate(zip(tail, phrase))):
+                        positions[key] = (tail[0][1], tail[0][2])
+                        remaining -= 1
+            normalized = ''
+            start_char = start_byte = None
+            return bool(token_specs) and remaining == 0
+
+        def consume_ascii(text):
+            nonlocal normalized, start_char, start_byte, chars, size, binary
+            cursor = 0
+            for word in _ASCII_WORD_RUN.finditer(text):
+                begin, end = word.span()
+                if begin > cursor:
+                    if finish():
+                        return cursor
+                    binary |= text.find('\x00', cursor, begin) >= 0
+                    chars += begin - cursor
+                    size += begin - cursor
+                if start_char is None:
+                    start_char, start_byte = chars, size
+                if len(normalized) <= max_token:
+                    folded = text[begin:min(end, begin + max_token + 1)].lower()
+                    normalized = (normalized + folded)[:max_token + 1]
+                chars += end - begin
+                size += end - begin
+                cursor = end
+            if cursor < len(text):
+                if finish():
+                    return cursor
+                binary |= text.find('\x00', cursor) >= 0
+                chars += len(text) - cursor
+                size += len(text) - cursor
+            return None
+
+        def consume_unicode(text):
+            nonlocal normalized, start_char, start_byte, chars, size, binary
+            chunk_start_chars = chars
+            current_chars, current_bytes, current_binary = chars, size, binary
+            for char in text:
+                code = ord(char)
+                current_binary |= code == 0 or 0xD800 <= code <= 0xDFFF
+                is_token, folded = self.oracle.classify(char)
+                if cjk_split and any(_cjk_token_boundary(ord(c)) for c in folded):
+                    finish()
+                    # A quoted Latin phrase cannot jump over native CJK tokens.
+                    recent.clear()
+                elif is_token:
+                    if folded and start_char is None:
+                        start_char, start_byte = current_chars, current_bytes
+                    if len(normalized) <= max_token:
+                        normalized = (normalized + folded)[:max_token + 1]
+                elif finish():
+                    chars, size, binary = current_chars, current_bytes, current_binary
+                    return current_chars - chunk_start_chars
+                current_chars += 1
+                current_bytes += 1 if code < 128 else len(char.encode('utf-8', 'surrogatepass'))
+            chars, size, binary = current_chars, current_bytes, current_binary
+            return None
+
+        chunks = iter(chunks)
+        for text in chunks:
+            if self.deadline is not None and time.monotonic() >= self.deadline:
+                raise TimeoutError('structured global search timed out')
+            if _positions_complete(positions):
+                chars, size, binary = _remaining_text_state(text, chunks, self.deadline, chars, size, binary)
+                return positions, chars, size, binary
+            consume = consume_ascii if text.isascii() else consume_unicode
+            stopped = consume(text)
+            if stopped is not None:
+                chars, size, binary = _remaining_text_state(text[stopped:], chunks, self.deadline, chars, size, binary)
+                return positions, chars, size, binary
+        finish()
+        return positions, chars, size, binary
+
+    def native_field_excerpt(self, session_id, message_id, field, terms, limit, include_inactive=False,
+                             *, cjk_split=False):
+        """Locate a native-FTS match without loading the full tool field."""
+        if field not in ('content', 'tool_name', 'tool_calls'):
+            raise ValueError('unsupported native tool field')
+        prepared = self._prepare()
+        selected = {key: value for key, value in prepared.items()
+                    if key[0] in terms and not value[1]}
+        if not selected:
+            return None
+        with SQLiteBlobReader(self.conn, field, message_id) as blob:
+            decoder = codecs.getincrementaldecoder('utf-8')('strict')
+            def chunks():
+                while True:
+                    if self.deadline is not None and time.monotonic() >= self.deadline:
+                        raise TimeoutError('structured global search timed out')
+                    raw = blob.read(65536)
+                    text = decoder.decode(raw, final=not raw)
+                    if text:
+                        yield text
+                    if not raw:
+                        break
+            positions, _, _, binary = self._tokens_from_chunks(chunks(), selected, cjk_split=cjk_split)
+        position = next((positions[key] for term in terms for key in selected
+                         if key[0] == term and positions[key] is not None), None)
+        if position is None:
+            return None
+        offset = max(0, position[1 if binary else 0] - min(1000, limit // 3))
+        if field in ('content', 'tool_calls'):
+            from hermes_state_recall import _page_from_connection
+            paged = _page_from_connection(self.conn, session_id, message_id, offset, limit, field,
+                                          self.deadline, include_inactive=include_inactive)
+            if paged is None:
+                return None
+            return {'snippet': paged['content'], 'snippet_field': field, 'snippet_offset': offset,
+                    'offset_unit': paged['offset_unit'], 'snippet_encoding': paged['encoding']}
+        if binary:
+            raise UnsupportedJSON('binary tool names cannot be displayed as text')
+        visible = "COALESCE(display_kind, '') <> 'hidden'"
+        if not include_inactive:
+            visible += ' AND (active=1 OR compacted=1)'
+        row = self.conn.execute(
+            f'SELECT substr(tool_name,?,?) FROM messages WHERE id=? AND session_id=? AND {visible}',
+            (offset + 1, limit, message_id, session_id),
+        ).fetchone()
+        if row is None:
+            return None
+        return {'snippet': row[0], 'snippet_field': field, 'snippet_offset': offset,
+                'offset_unit': 'characters', 'snippet_encoding': 'text'}
+
+    def info(self, message_id):
+        if message_id in self.cache:
+            self.cache.move_to_end(message_id)
+            return self.cache[message_id]
+        prepared = self._prepare()
+        with SQLiteBlobReader(self.conn, 'content', message_id) as blob:
+            try:
+                spans = text_spans(blob, self.deadline)
+            except InvalidJSON as exc:
+                blob.seek(0)
+                if blob.read(6) == b'\x00json:':
+                    raise UnsupportedJSON('malformed structured content cannot be verified') from exc
+                raw = analyze_raw(blob, self.terms, self.deadline)
+                lookup = dict(zip(self.terms, raw['positions']))
+                info = {'positions': {key: lookup[key[0]] for key in self.specs},
+                        'binary': True, 'structured': False, 'spans': []}
+            else:
+                literals = list(dict.fromkeys(term for (term, _), (_, literal) in prepared.items() if literal))
+                if len(literals) == len(self.terms):
+                    raw = analyze(blob, spans, literals, self.deadline)
+                    lookup = dict(zip(literals, raw['positions']))
+                    token_positions = {key: lookup[key[0]] for key in self.specs}
+                    chars, size, binary = raw['chars'], raw['bytes'], raw['binary']
+                else:
+                    token_positions, chars, size, binary = self._tokens(blob, spans, prepared)
+                if literals:
+                    if len(literals) != len(self.terms):
+                        raw = analyze(blob, spans, literals, self.deadline)
+                    literal_positions = dict(zip(literals, raw['positions']))
+                    binary |= raw['binary']
+                    token_positions.update({key: literal_positions[key[0]] for key, value in prepared.items()
+                                            if value[1]})
+                info = {'positions': token_positions, 'chars': chars, 'bytes': size, 'binary': binary,
+                        'structured': True, 'spans': spans}
+        self.cache[message_id] = info
+        if len(self.cache) > 64:
+            self.cache.popitem(last=False)
+        return info
+
+    def contains(self, message_id, term, prefix=False):
+        try:
+            info = self.info(message_id)
+            info['spans'] = None
+            return int(info['positions'][(term, bool(prefix))] is not None)
+        except Exception as exc:
+            self.error = exc
+            raise
+
+    def tool_contains(self, message_id, term, prefix=False):
+        """Verify encoded argument text using bounded JSON and tokenizer streams."""
+        try:
+            if message_id not in self.tool_cache:
+                prepared = self._prepare()
+                exists = self.conn.execute('SELECT typeof(tool_calls) FROM messages WHERE id=?',
+                                           (message_id,)).fetchone()
+                if exists is None or exists[0] == 'null':
+                    positions = {key: None for key in self.specs}
+                else:
+                    with SQLiteBlobReader(self.conn, 'tool_calls', message_id) as blob:
+                        parser = _StringSpans(blob, deadline=self.deadline)
+                        try:
+                            parser.value()
+                            parser.ws()
+                            if parser.peek() is not None:
+                                raise InvalidJSON('trailing JSON')
+                        except InvalidJSON as exc:
+                            raise UnsupportedJSON('malformed tool calls cannot be verified') from exc
+
+                        def chunks():
+                            for span in parser.spans:
+                                yield from _decoded_unicode_escapes(decoded_string(blob, span, self.deadline))
+                                yield '\n'
+
+                        literal_terms = list(dict.fromkeys(key[0] for key, value in prepared.items() if value[1]))
+                        if len(literal_terms) == len(self.terms):
+                            positions = {key: None for key in self.specs}
+                        else:
+                            positions, _, _, _ = self._tokens_from_chunks(
+                                chunks(), prepared, cjk_split=self.cjk_split)
+                        if literal_terms:
+                            found = _literal_positions(chunks(), literal_terms, self.deadline)
+                            for key, value in prepared.items():
+                                if value[1]:
+                                    positions[key] = found[key[0]]
+                self.tool_cache[message_id] = positions
+                if len(self.tool_cache) > 64:
+                    self.tool_cache.popitem(last=False)
+            else:
+                self.tool_cache.move_to_end(message_id)
+            return int(self.tool_cache[message_id][(term, bool(prefix))] is not None)
+        except Exception as exc:
+            self.error = exc
+            raise
+
+    def small_json_token_maybe(self, raw, term):
+        """Reject impossible single-token hits in caller-validated small JSON."""
+        if not (term.isascii() and term.isalnum()):
+            return 1
+        try:
+            if not isinstance(raw, str) or len(raw) > 16384:
+                return 1
+            # A nested escape can be assembled only after the outer JSON is
+            # decoded. Raw-segment rejection cannot safely rule such hits out.
+            if _AMBIGUOUS_ASCII_ESCAPE.search(raw):
+                return 1
+            if self.ordered_prefilter.reject(raw, term, self.deadline, escape_checked=True):
+                return 0
+            # This is only a rejection prefilter. A literal occurrence is
+            # already a possible match; leave semantics to the verifier rather
+            # than repeatedly splitting large common-query argument strings.
+            if term.lower() in raw.lower():
+                return 1
+            if term not in self.json_token_patterns:
+                priority = 'zqxjkvbwdlhgmpsyfornuticea'
+                chars = sorted({char.lower() for char in term if char.isalpha()},
+                               key=lambda char: priority.index(char))[:8]
+                patterns = []
+                for char in chars:
+                    codes = {ord(char), ord(char.upper()), *FOLD_ALIASES.get(ord(char), ())}
+                    alternatives = {chr(code) for code in codes}
+                    alternatives.update(f'u{code:04x}' if code <= 0xFFFF
+                                        else f'u{0xD800 + ((code - 0x10000) >> 10):04x}'
+                                        for code in codes)
+                    patterns.append((char, re.compile(
+                        '(?:' + '|'.join(re.escape(v) for v in sorted(alternatives)) + ')', re.IGNORECASE)))
+                self.json_token_patterns[term] = patterns
+            patterns = self.json_token_patterns[term]
+            if not patterns:
+                return 1
+            # JSON punctuation and ASCII whitespace cannot be part of an
+            # ASCII alphanumeric tokenizer term, including in nested strings.
+            # Escaped delimiters remain unsplit, which only widens candidates.
+            # Repeated segments cannot change an any-match decision; process
+            # each once while retaining the original order and bounded input.
+            parts = dict.fromkeys(_RAW_TOKEN_DELIMITERS.split(raw))
+            if len(raw) > 1024 and (raw.count('[') + raw.count('{') > 512
+                                    or any(len(part) > 1024 for part in parts)):
+                # The streaming reader has depth and scalar limits. Avoid
+                # suppressing its explicit unsupported-input error.
+                return 1
+            for index, part in enumerate(parts):
+                if index % 64 == 0 and self.deadline is not None and time.monotonic() >= self.deadline:
+                    raise TimeoutError('structured global search timed out')
+                if not part or part.isascii() and part.isdigit():
+                    continue
+                key = (term, part)
+                if key in self.small_json_cache:
+                    self.small_json_cache.move_to_end(key)
+                    if self.small_json_cache[key]:
+                        return 1
+                    continue
+                folded = part.lower()
+                missing = [pattern for char, pattern in patterns if char not in folded]
+                possible = (not missing or not (part.isascii() and '\\' not in part)
+                            and all(pattern.search(part) for pattern in missing))
+                self.small_json_cache[key] = bool(possible)
+                if len(self.small_json_cache) > 128:
+                    self.small_json_cache.popitem(last=False)
+                if possible:
+                    return 1
+            return 0
+        except Exception as exc:
+            self.error = exc
+            raise
+
+    def _raw_contains_options(self, message_id, field, values, *, folded=False):
+        try:
+            if field not in ('content', 'tool_calls'):
+                raise ValueError('unsupported raw candidate field')
+            if not values or any(not value for value in values):
+                return 0
+            values = tuple(value.lower() for value in values) if folded else values
+            row = self.conn.execute(f'SELECT typeof({field}) FROM messages WHERE id=?',
+                                    (message_id,)).fetchone()
+            if row is None or row[0] == 'null':
+                return 0
+            with SQLiteBlobReader(self.conn, field, message_id) as blob:
+                tail = b''
+                keep = max(map(len, values)) - 1
+                while True:
+                    if self.deadline is not None and time.monotonic() >= self.deadline:
+                        raise TimeoutError('structured global search timed out')
+                    chunk = blob.read(65536)
+                    if not chunk:
+                        return 0
+                    merged = tail + chunk
+                    checked = merged.lower() if folded else merged
+                    if any(value in checked for value in values):
+                        return 1
+                    tail = merged[-keep:] if keep else b''
+        except Exception as exc:
+            self.error = exc
+            raise
+
+    def raw_contains(self, message_id, field, needle):
+        """Find a raw UTF-8 candidate in bounded chunks without hydrating a field."""
+        try:
+            return self._raw_contains_options(message_id, field, (needle.encode('utf-8'),))
+        except Exception as exc:
+            self.error = exc
+            raise
+
+    def raw_has_character(self, message_id, field, char):
+        """Accept a raw or JSON-escaped occurrence as a necessary candidate."""
+        try:
+            if len(char) != 1:
+                raise ValueError('candidate must be one character')
+            key = (message_id, field, char)
+            if key in self.raw_character_cache:
+                self.raw_character_cache.move_to_end(key)
+                return self.raw_character_cache[key]
+            escaped = json.dumps(char, ensure_ascii=True)[1:-1][:6].encode('ascii')
+            result = self._raw_contains_options(message_id, field, (char.encode('utf-8'), escaped), folded=True)
+            self.raw_character_cache[key] = result
+            if len(self.raw_character_cache) > 64:
+                self.raw_character_cache.popitem(last=False)
+            return result
+        except Exception as exc:
+            self.error = exc
+            raise
+
+    def native_field_contains(self, message_id, field, term, prefix=False):
+        """Verify a legacy combined-index hit against its actual tool field."""
+        if field not in ('content', 'tool_name', 'tool_calls'):
+            raise ValueError('unsupported native tool field')
+        try:
+            cache_key = (message_id, field)
+            if cache_key not in self.field_cache:
+                prepared = self._prepare()
+                row = self.conn.execute(f'SELECT typeof({field}) FROM messages WHERE id=?',
+                                        (message_id,)).fetchone()
+                positions = {key: None for key in self.specs}
+                if row is not None and row[0] != 'null':
+                    with SQLiteBlobReader(self.conn, field, message_id) as blob:
+                        def chunks():
+                            blob.seek(0)
+                            decoder = codecs.getincrementaldecoder('utf-8')('strict')
+                            while True:
+                                if self.deadline is not None and time.monotonic() >= self.deadline:
+                                    raise TimeoutError('structured global search timed out')
+                                raw = blob.read(65536)
+                                text = decoder.decode(raw, final=not raw)
+                                if text:
+                                    yield text
+                                if not raw:
+                                    break
+                        literals = list(dict.fromkeys(key[0] for key, val in prepared.items() if val[1]))
+                        if len(literals) != len(self.terms):
+                            positions, _, _, _ = self._tokens_from_chunks(chunks(), prepared)
+                        if literals:
+                            found = _literal_positions(chunks(), literals, self.deadline)
+                            for key, val in prepared.items():
+                                if val[1]:
+                                    positions[key] = found[key[0]]
+                self.field_cache[cache_key] = positions
+                if len(self.field_cache) > 64:
+                    self.field_cache.popitem(last=False)
+            else:
+                self.field_cache.move_to_end(cache_key)
+            return int(self.field_cache[cache_key][(term, bool(prefix))] is not None)
+        except Exception as exc:
+            self.error = exc
+            raise
+
+    def decoded_tool_excerpt(self, session_id, message_id, terms, limit, include_inactive=False):
+        """Page the original tool calls at the verified decoded-token position."""
+        for term in terms:
+            for key in self.specs:
+                if key[0] == term:
+                    self.tool_contains(message_id, *key)
+        positions = self.tool_cache.get(message_id, {})
+        position = next((positions[key] for term in terms for key in self.specs
+                         if key[0] == term and positions.get(key) is not None), None)
+        if position is None:
+            return None
+        target = position[0]
+        with SQLiteBlobReader(self.conn, 'tool_calls', message_id) as blob:
+            parser = _StringSpans(blob, deadline=self.deadline)
+            try:
+                parser.value()
+                parser.ws()
+                if parser.peek() is not None:
+                    raise InvalidJSON('trailing JSON')
+            except InvalidJSON as exc:
+                raise UnsupportedJSON('malformed tool calls cannot be paged') from exc
+            logical = 0
+            raw_byte = None
+            for span in parser.spans:
+                for text, source, unchanged in _unicode_fragments(decoded_string(blob, span, self.deadline)):
+                    if logical <= target < logical + len(text):
+                        outer = source + (target - logical if unchanged else 0)
+                        raw_byte = _outer_string_byte_offset(blob, span, outer, self.deadline)
+                        break
+                    logical += len(text)
+                if raw_byte is not None:
+                    break
+                logical += 1  # Same separator as tool_contains().
+            if raw_byte is None:
+                raise UnsupportedJSON('verified tool-call match has no source offset')
+            raw_char = _raw_character_offset(blob, raw_byte, self.deadline)
+        offset = max(0, raw_char - min(1000, limit // 3))
+        from hermes_state_recall import _page_from_connection
+        paged = _page_from_connection(self.conn, session_id, message_id, offset, limit, 'tool_calls',
+                                      self.deadline, include_inactive=include_inactive)
+        if paged is None:
+            return None
+        return {'snippet': paged['content'], 'snippet_field': 'tool_calls', 'snippet_offset': offset,
+                'offset_unit': paged['offset_unit'], 'snippet_encoding': paged['encoding']}
+
+    def excerpt(self, message_id, terms, limit):
+        info = self.info(message_id)
+        if info['structured'] and info['spans'] is None:
+            self.invalidate(message_id)
+            info = self.info(message_id)
+        position = next((info['positions'][key] for term in terms for key in self.specs
+                         if key[0] == term and info['positions'][key] is not None), None)
+        if position is None:
+            return None
+        offset = max(0, position[1 if info['binary'] else 0] - min(1000, limit // 3))
+        with SQLiteBlobReader(self.conn, 'content', message_id) as blob:
+            if info['structured']:
+                result = page(blob, info['spans'], offset, limit, self.deadline)
+                field = 'text'
+            else:
+                blob.seek(offset)
+                value = blob.read(limit)
+                result = {'content': base64.b64encode(value).decode('ascii'),
+                          'offset_unit': 'bytes', 'encoding': 'base64'}
+                field = 'content'
+        return {'snippet': result['content'], 'snippet_field': field, 'snippet_offset': offset,
+                'offset_unit': result['offset_unit'], 'snippet_encoding': result['encoding']}
