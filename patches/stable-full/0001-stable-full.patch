--- /dev/null
+++ b/tests/hermes_cli/test_kanban_delivery_review.py
@@ -0,0 +1,459 @@
+"""Delivery requires current evidence and an independent native review attempt."""
+import copy
+import hashlib
+import json
+import time
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli.kanban_task_contract import task_contract
+
+
+def sha(value):
+    return hashlib.sha256(value.encode()).hexdigest()
+
+
+def brief(data):
+    return 'Deliver the sum.\n```hermes-contract\n' + json.dumps({'version': 1, **data}) + '\n```'
+
+
+@pytest.fixture
+def delivery(tmp_path, monkeypatch):
+    home = tmp_path / 'home'
+    home.mkdir()
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(home))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    conn = kbc.connect()
+    for name, value in [('check.py', 'assert answer == 5'), ('lock', 'fixture'),
+                        ('answer.txt', '5'), ('check.log', 'PASS')]:
+        (tmp_path / name).write_text(value)
+    contract = {'checks': ['sum'], 'inputs': {'check.py': sha('assert answer == 5')},
+                'environment': {'lock': sha('fixture')}, 'check_definitions': {'sum': 'check.py'},
+                'required_artifacts': ['answer.txt'], 'acceptance_criteria': {'sum': 'The sum is five'},
+                'require_review': True}
+    evidence = {'artifacts': ['answer.txt'], 'verification': {'version': 1,
+        'inputs': contract['inputs'], 'environment': contract['environment'],
+        'check_definitions': contract['check_definitions'], 'checks': [{
+            'name': 'sum', 'exit_code': 0, 'log': 'check.log', 'sha256': sha('PASS'),
+            'completed_at': time.time()-1, 'expires_at': time.time()+3600}]}}
+    tid = kb.create_task(conn, title='Simple sum', body=brief(contract), assignee='builder',
+                         workspace_kind='dir', workspace_path=str(tmp_path))
+    yield conn, tid, contract, evidence, tmp_path
+    conn.close()
+
+
+def fresh_evidence(conn, tid, evidence):
+    evidence['verification']['run_id'] = kb.get_task(conn, tid).current_run_id
+    for check in evidence['verification']['checks']:
+        check['completed_at'] = time.time()
+
+
+def review(delivery, reviewer='reviewer'):
+    conn, tid, _, evidence, _ = delivery
+    worker = kb.claim_task(conn, tid)
+    fresh_evidence(conn, tid, evidence)
+    assert kb.request_review(conn, tid, summary='Output and checks ready', metadata=evidence,
+                             reviewer=reviewer, expected_run_id=worker.current_run_id)
+    reviewer_task = kb.claim_review_task(conn, tid)
+    fresh_evidence(conn, tid, evidence)
+    return worker.current_run_id, reviewer_task
+
+
+def approval(evidence, handoff):
+    return {**copy.deepcopy(evidence), 'delivery_review': {
+        'version': 1, 'handoff_run_id': handoff, 'criteria': ['sum']}}
+
+
+def test_implementer_cannot_certify_its_own_delivery(delivery):
+    conn, tid, _, evidence, _ = delivery
+    worker = kb.claim_task(conn, tid)
+    fresh_evidence(conn, tid, evidence)
+    with pytest.raises(ValueError, match='independent review'):
+        kb.complete_task(conn, tid, summary='passed', metadata=evidence,
+                         expected_run_id=worker.current_run_id)
+    assert kb.get_task(conn, tid).status == 'running'
+
+
+def test_reviewer_must_name_the_reviewed_handoff_and_criteria(delivery):
+    conn, tid, _, evidence, _ = delivery
+    _, reviewer = review(delivery)
+    with pytest.raises(ValueError, match='delivery_review'):
+        kb.complete_task(conn, tid, summary='looks fine', metadata=evidence,
+                         expected_run_id=reviewer.current_run_id)
+
+
+def test_review_acceptance_is_recorded_from_native_provenance(delivery):
+    conn, tid, _, evidence, _ = delivery
+    handoff, reviewer = review(delivery)
+    assert kb.complete_task(conn, tid, summary='Verified sum', metadata=approval(evidence, handoff),
+                            expected_run_id=reviewer.current_run_id)
+    receipt = kb.get_run(conn, reviewer.current_run_id).metadata['delivery_acceptance']
+    assert receipt['handoff_run_id'] == handoff
+    assert receipt['review_run_id'] == reviewer.current_run_id
+    assert receipt['reviewer'] == 'reviewer'
+    assert receipt['artifact_hashes'] == {'answer.txt': sha('5')}
+    from hermes_cli.kanban_delivery_view import delivery_summary
+    view = delivery_summary(conn, tid)
+    assert view['state'] == 'delivered'
+    assert view['verification']['receipt']['review_run_id'] == reviewer.current_run_id
+    assert view['criteria'] == [{'id': 'sum', 'description': 'The sum is five'}]
+    conn.execute('UPDATE tasks SET title=? WHERE id=?', ('Changed requirement', tid))
+    conn.commit()
+    assert delivery_summary(conn, tid)['state'] == 'awaiting_verification'
+
+
+def test_changed_output_requires_another_implementation_handoff(delivery):
+    conn, tid, _, evidence, root = delivery
+    handoff, reviewer = review(delivery)
+    (root / 'answer.txt').write_text('6')
+    with pytest.raises(ValueError, match='artifact'):
+        kb.complete_task(conn, tid, summary='passed', metadata=approval(evidence, handoff),
+                         expected_run_id=reviewer.current_run_id)
+
+
+def test_same_profile_review_cannot_certify_delivery(delivery):
+    conn, tid, _, evidence, _ = delivery
+    worker = kb.claim_task(conn, tid)
+    fresh_evidence(conn, tid, evidence)
+    with pytest.raises(ValueError, match='independent review'):
+        kb.request_review(conn, tid, summary='ready', metadata=evidence, reviewer='builder',
+                          expected_run_id=worker.current_run_id)
+    assert kb.get_task(conn, tid).status == 'running'
+
+
+@pytest.mark.parametrize('change', [{'require_review': 'yes'}, {'acceptance_criteria': {'other': 'Wrong'}},
+                                   {'acceptance_criteria': {'sum': ''}}, {'required_artifacts': []}])
+def test_review_contract_requires_explicit_outputs_and_mapped_criteria(delivery, change):
+    _, _, contract, _, _ = delivery
+    with pytest.raises(ValueError):
+        task_contract(brief({**contract, **change}))
+
+
+def test_revision_rejects_previous_handoff_then_accepts_current_review(delivery):
+    conn, tid, _, evidence, _ = delivery
+    old_handoff, reviewer = review(delivery)
+    assert kb.request_changes(conn, tid, reason='Check once more',
+                              expected_run_id=reviewer.current_run_id) == (True, 'builder')
+    new_handoff, second_review = review(delivery)
+    with pytest.raises(ValueError, match='current handoff'):
+        kb.complete_task(conn, tid, summary='passed', metadata=approval(evidence, old_handoff),
+                         expected_run_id=second_review.current_run_id)
+    assert kb.complete_task(conn, tid, summary='Verified revised work',
+                            metadata=approval(evidence, new_handoff),
+                            expected_run_id=second_review.current_run_id)
+
+
+def test_changed_brief_before_review_claim_invalidates_handoff(delivery):
+    conn, tid, contract, evidence, _ = delivery
+    worker = kb.claim_task(conn, tid)
+    fresh_evidence(conn, tid, evidence)
+    assert kb.request_review(conn, tid, summary='ready', metadata=evidence, reviewer='reviewer',
+                             expected_run_id=worker.current_run_id)
+    changed = copy.deepcopy(contract)
+    changed['acceptance_criteria']['sum'] = 'Additional user requirement'
+    # Simulate a legitimate brief update between implementation and reviewer claim.
+    conn.execute('UPDATE tasks SET body=? WHERE id=?', (brief(changed), tid))
+    conn.commit()
+    reviewer = kb.claim_review_task(conn, tid)
+    fresh_evidence(conn, tid, evidence)
+    with pytest.raises(ValueError, match='brief changed'):
+        kb.complete_task(conn, tid, summary='passed', metadata=approval(evidence, worker.current_run_id),
+                         expected_run_id=reviewer.current_run_id)
+
+
+def test_legacy_caller_cannot_invent_native_delivery_receipt(delivery):
+    conn, _, _, _, _ = delivery
+    tid = kb.create_task(conn, title='Legacy answer')
+    assert kb.complete_task(conn, tid, summary='5', metadata={'delivery_acceptance': {'verified': True}})
+    assert 'delivery_acceptance' not in (kb.list_runs(conn, tid)[-1].metadata or {})
+
+
+def test_wrong_or_duplicate_review_criteria_are_rejected(delivery):
+    conn, tid, _, evidence, _ = delivery
+    handoff, reviewer = review(delivery)
+    for criteria in [[], ['other'], ['sum', 'sum']]:
+        metadata = approval(evidence, handoff)
+        metadata['delivery_review']['criteria'] = criteria
+        with pytest.raises(ValueError, match='every acceptance criterion'):
+            kb.complete_task(conn, tid, summary='passed', metadata=metadata,
+                             expected_run_id=reviewer.current_run_id)
+    assert kb.get_task(conn, tid).status == 'running'
+
+
+def test_worker_brief_explains_delivery_and_current_review_handoff(delivery):
+    conn, tid, _, _, _ = delivery
+    builder_context = kb.build_worker_context(conn, tid)
+    assert '## Delivery acceptance' in builder_context
+    assert 'kanban_request_review' in builder_context
+    handoff, _ = review(delivery)
+    reviewer_context = kb.build_worker_context(conn, tid)
+    assert 'metadata.delivery_review' in reviewer_context
+    assert f'"handoff_run_id": {handoff}' in reviewer_context
+    assert 'kanban_request_changes' in reviewer_context
+
+
+@pytest.mark.parametrize('damage', ['previous_run', 'missing_run', 'predates_run'])
+def test_review_check_record_cannot_be_replayed_from_another_attempt(delivery, damage):
+    conn, tid, _, evidence, _ = delivery
+    handoff, reviewer = review(delivery)
+    metadata = approval(evidence, handoff)
+    verification = metadata['verification']
+    if damage == 'previous_run':
+        metadata['verification'] = copy.deepcopy(kb.get_run(conn, handoff).metadata['verification'])
+    elif damage == 'missing_run':
+        verification.pop('run_id')
+    else:
+        verification['checks'][0]['completed_at'] = kb.get_run(conn, reviewer.current_run_id).started_at - 1
+    with pytest.raises(ValueError, match='current run'):
+        kb.complete_task(conn, tid, summary='Copied check', metadata=metadata,
+                         expected_run_id=reviewer.current_run_id)
+    assert kb.get_task(conn, tid).status == 'running'
+
+
+@pytest.mark.parametrize('through_parent', [False, True])
+def test_reopening_retires_acceptance_before_another_claim(delivery, through_parent):
+    from hermes_cli.kanban_delivery_view import delivery_summary
+    conn, tid, _, evidence, _ = delivery
+    handoff, reviewer = review(delivery)
+    assert kb.complete_task(conn, tid, summary='Verified', metadata=approval(evidence, handoff),
+                            expected_run_id=reviewer.current_run_id)
+    assert delivery_summary(conn, tid)['verification']['status'] == 'accepted'
+    if through_parent:
+        parent = kb.create_task(conn, title='Prerequisite')
+        assert kb.complete_task(conn, parent, summary='Prerequisite ready')
+        kb.link_tasks(conn, parent, tid)
+        conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (parent,)); conn.commit()
+        kb.invalidate_descendants_for_parent_reopen(conn, parent, author='test')
+    else:
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+            kb._append_event(conn, tid, 'status', {'status': 'ready'})
+    assert delivery_summary(conn, tid)['verification']['status'] != 'accepted'
+    # A manual status toggle back to done must not resurrect the older receipt.
+    conn.execute("UPDATE tasks SET status='done' WHERE id=?", (tid,)); conn.commit()
+    assert delivery_summary(conn, tid)['verification']['status'] != 'accepted'
+
+
+def test_revision_compares_native_handoffs_and_reads_only_matching_bytes(delivery):
+    from hermes_cli.kanban_delivery_revision import revision_diff
+    from hermes_cli.kanban_delivery_view import delivery_summary
+
+    conn, tid, _, evidence, root = delivery
+    # Use native retention so both versions survive the next worktree write.
+    workspace = kb.workspaces_root() / tid
+    workspace.mkdir(parents=True)
+    for name in ('check.py', 'lock', 'answer.txt', 'check.log'):
+        (workspace / name).write_bytes((root / name).read_bytes())
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET workspace_kind='scratch', workspace_path=? WHERE id=?", (str(workspace), tid))
+
+    first, reviewer = review(delivery)
+    assert kb.request_changes(conn, tid, reason='Explain the answer', expected_run_id=reviewer.current_run_id)[0]
+    pending = delivery_summary(conn, tid)['revision']
+    assert pending['after_run_id'] is None
+    assert pending['criteria'][0] == {
+        'id': 'sum', 'description': 'The sum is five', 'before': True, 'after': False,
+    }
+    (workspace / 'answer.txt').write_text('5\n2 + 3 = 5\n')
+    second, acceptance = review(delivery)
+    assert kb.complete_task(conn, tid, summary='Accepted the revised text', metadata=approval(evidence, second),
+                            expected_run_id=acceptance.current_run_id)
+    assert not workspace.exists()
+    changes = conn.total_changes
+    revision = delivery_summary(conn, tid)['revision']
+    assert (revision['before_run_id'], revision['request_run_id'], revision['after_run_id']) == (
+        first, reviewer.current_run_id, second)
+    assert revision['files'] == [{'name': 'answer.txt', 'status': 'changed'}]
+    assert revision['criteria'][0]['after'] is True
+
+    task = kb.get_task(conn, tid)
+    contract = task_contract(task.body)
+    diff = revision_diff(conn, task, None, contract, 'answer.txt', first, second)
+    assert diff['status'] == 'available'
+    assert '+2 + 3 = 5' in diff['diff']
+    assert revision_diff(conn, task, None, contract, 'answer.txt', first, first)['status'] == 'stale'
+    assert revision_diff(conn, task, None, contract, '../lock', first, second)['status'] == 'unavailable'
+    first_copy = Path(kb.get_run(conn, first).metadata['artifacts'][0])
+    first_copy.write_text('unexpected content')
+    assert revision_diff(conn, task, None, contract, 'answer.txt', first, second)['status'] == 'unavailable'
+    assert delivery_summary(conn, tid)['revision']['files'] == revision['files']
+    assert conn.total_changes == changes
+
+
+def test_revision_history_bounds_pairs_to_their_own_request_interval(delivery):
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+    from hermes_cli.kanban_delivery_revision import revision_diff
+    from hermes_cli.kanban_delivery_view import delivery_summary
+    from plugins.kanban.dashboard.plugin_api import router
+
+    conn, tid, contract, evidence, root = delivery
+    workspace = kb.workspaces_root() / tid
+    workspace.mkdir(parents=True)
+    for name in ('check.py', 'lock', 'answer.txt', 'check.log'):
+        (workspace / name).write_bytes((root / name).read_bytes())
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET workspace_kind='scratch', workspace_path=? WHERE id=?", (str(workspace), tid))
+
+    handoffs, requests = [], []
+    for number in range(1, 7):
+        if number == 3:
+            (workspace / 'answer.txt').write_text('Provisional text')
+            provisional = kb.claim_task(conn, tid).current_run_id
+            fresh_evidence(conn, tid, evidence)
+            assert kb.request_review(conn, tid, summary='Provisional', metadata=evidence,
+                                     reviewer='reviewer', expected_run_id=provisional)
+            assert kb.reopen_review_task(conn, tid)
+        (workspace / 'answer.txt').write_text(f'Round {number}\n')
+        handoff, reviewer = review(delivery)
+        handoffs.append(handoff)
+        requests.append(reviewer.current_run_id)
+        assert kb.request_changes(conn, tid, reason=f'Request {number}', expected_run_id=requests[-1])[0]
+        if number == 2:
+            other = kb.create_task(conn, title='Another card', assignee='builder')
+            other_run = kb.claim_task(conn, other)
+            with kb.write_txn(conn):
+                kb._append_event(conn, other, 'review_requested', {}, run_id=other_run.current_run_id)
+
+    contract['acceptance_criteria']['sum'] = 'A different current requirement'
+    with kb.write_txn(conn):
+        conn.execute("UPDATE task_events SET created_at=0 WHERE task_id=?", (tid,))
+        conn.execute('UPDATE tasks SET body=? WHERE id=?', (brief(contract), tid))
+    changes = conn.total_changes
+    revision = delivery_summary(conn, tid)['revision']
+    assert revision['request_run_id'] == requests[-1]
+    assert revision['after_run_id'] is None
+    assert revision['history_limited'] is True
+    assert [(entry['before_run_id'], entry['request_run_id'], entry['after_run_id'])
+            for entry in revision['previous']] == list(zip(handoffs[1:-1], requests[1:-1], handoffs[2:]))[::-1]
+
+    assert revision['previous'][-1]['criteria'] == [
+        {'id': 'sum', 'description': 'sum', 'before': True, 'after': True}
+    ]
+
+    task = kb.get_task(conn, tid)
+    contract = task_contract(task.body)
+    pair = (handoffs[1], handoffs[2])
+    diff = revision_diff(conn, task, None, contract, 'answer.txt', *pair)
+    assert diff['status'] == 'available'
+    assert '-Round 2' in diff['diff'] and '+Round 3' in diff['diff']
+    app = FastAPI()
+    app.include_router(router)
+    with TestClient(app) as client:
+        assert client.get(f'/tasks/{tid}').json()['delivery']['revision'] == revision
+        response = client.get(f'/tasks/{tid}/revision-diff',
+                              params={'name': 'answer.txt', 'before': pair[0], 'after': pair[1]})
+        assert response.status_code == 200
+        assert response.json() == diff
+    assert revision_diff(conn, task, None, contract, 'answer.txt', handoffs[1], provisional) == {'status': 'stale'}
+    assert revision_diff(conn, task, None, contract, 'answer.txt', handoffs[0], handoffs[1]) == {'status': 'stale'}
+    assert revision_diff(conn, task, None, contract, 'answer.txt', handoffs[1], handoffs[3]) == {'status': 'stale'}
+    assert revision_diff(conn, task, None, contract, 'answer.txt', handoffs[1], other_run.current_run_id) == {'status': 'stale'}
+    Path(kb.get_run(conn, handoffs[1]).metadata['artifacts'][0]).write_text('overwritten')
+    assert revision_diff(conn, task, None, contract, 'answer.txt', *pair) == {'status': 'unavailable'}
+    assert conn.total_changes == changes
+
+
+def test_revision_does_not_mistake_equal_criterion_ids_for_an_unchanged_brief(delivery):
+    from hermes_cli.kanban_delivery_view import delivery_summary
+
+    conn, tid, contract, _, _ = delivery
