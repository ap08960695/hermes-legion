@@ -0,0 +1,84 @@
+"""Shared SQL visibility and recall eligibility before search pagination."""
+
+from dataclasses import dataclass
+from typing import Optional
+
+from hermes_state_common import _BOUNDARY_END_REASONS
+
+
+@dataclass(frozen=True)
+class RecallScope:
+    """Discovery-only lineage guards; never a profile or authorization override."""
+
+    excluded_roots: tuple[str, ...] = ()
+    current_session_id: str | None = None
+    current_lineage_root: str | None = None
+    match_tier: str = "automatic"
+
+
+def allows_substring_miss(matches, is_cjk, role_filter, scope: RecallScope | None) -> bool:
+    return (not matches and not is_cjk and not (role_filter and "tool" in role_filter)
+            and (scope is None or scope.match_tier in ("automatic", "substring")))
+
+
+def allows_relaxed_miss(matches, is_cjk, fts_stale, scope: RecallScope | None) -> bool:
+    return (not matches and not is_cjk and not fts_stale
+            and (scope is None or scope.match_tier in ("automatic", "relaxed")))
+
+
+def _lineage_members(roots: tuple[str, ...]) -> str:
+    # UNION terminates even if an imported session graph contains a parent cycle.
+    return ("WITH RECURSIVE recall_members(id) AS ("
+            f"SELECT id FROM sessions WHERE id IN ({','.join('?' for _ in roots)}) "
+            "UNION SELECT child.id FROM sessions child "
+            "JOIN recall_members parent ON child.parent_session_id=parent.id) "
+            "SELECT id FROM recall_members")
+
+
+def _append_recall_scope(where: list[str], params: list, scope: RecallScope) -> None:
+    if scope.excluded_roots:
+        where.append(f"m.session_id NOT IN ({_lineage_members(scope.excluded_roots)})")
+        params.extend(scope.excluded_roots)
+    compacted = "(m.active=0 AND m.compacted=1)"
+    if scope.current_lineage_root:
+        ended = tuple(sorted(_BOUNDARY_END_REASONS | {"compression"}))
+        where.append(f"(m.session_id NOT IN ({_lineage_members((scope.current_lineage_root,))}) "
+                     f"OR s.end_reason IN ({','.join('?' for _ in ended)}) OR {compacted})")
+        params.extend((scope.current_lineage_root, *ended))
+    if scope.current_session_id:
+        where.append(f"(m.session_id<>? OR {compacted})")
+        params.append(scope.current_session_id)
+
+
+def append_search_filters(
+    where: list[str], params: list, *, include_inactive: bool, source_filter: Optional[list[str]],
+    exclude_sources: Optional[list[str]], role_filter: Optional[list[str]],
+    after_ts: Optional[int] = None, before_ts: Optional[int] = None,
+    recall_scope: RecallScope | None = None) -> None:
+    """Append the visibility/source/role/session-start predicates every search route shares. Live
+    rows (active=1) AND compaction-archived rows (compacted=1) are discoverable; only
+    rewind/undo rows (active=0, compacted=0) are hidden. ``after_ts``/``before_ts`` bound
+    ``sessions.started_at`` (inclusive / exclusive) inside the query so LIMIT cannot be
+    filled by out-of-window hits."""
+    if not include_inactive:
+        where.append("(m.active = 1 OR m.compacted = 1)")
+    # display_kind="hidden" rows are model-facing scaffolding the person never saw; a hit would confuse.
+    where.append("COALESCE(m.display_kind, '') <> 'hidden'")
+    if source_filter is not None:
+        where.append(f"s.source IN ({','.join('?' for _ in source_filter)})")
+        params.extend(source_filter)
+    if exclude_sources is not None:
+        where.append(f"s.source NOT IN ({','.join('?' for _ in exclude_sources)})")
+        params.extend(exclude_sources)
+    if role_filter:
+        where.append(f"m.role IN ({','.join('?' for _ in role_filter)})")
+        params.extend(role_filter)
+    if after_ts is not None:
+        where.append("s.started_at >= ?")
+        params.append(int(after_ts))
+    if before_ts is not None:
+        where.append("s.started_at < ?")
+        params.append(int(before_ts))
+
+    if recall_scope is not None:
+        _append_recall_scope(where, params, recall_scope)
