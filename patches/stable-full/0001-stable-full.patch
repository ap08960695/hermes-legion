+"""Aggregate existing cross-profile diagnostics without exporting fingerprints.
+
+A comparable prepared-request cohort is not proof of provider cache origin,
+shared credentials, full wire identity, or usage savings.
+"""
+from collections import defaultdict
+import math
+import re
+
+_FIELDS = ('route', 'declared_account', 'cache_key', 'common_prefix', 'tools', 'options')
+
+
+def _mapping(value):
+    return value if isinstance(value, dict) else {}
+
+
+def _hash(value):
+    value = _mapping(value)
+    result = value.get('hash')
+    return result if value.get('complete') is True and isinstance(result, str) and re.fullmatch(r'[0-9a-f]{64}', result) else None
+
+
+def _normalize(raw, start, end):
+    raw = _mapping(raw)
+    cross = _mapping(_mapping(raw.get('fingerprint')).get('cross_bot'))
+    namespace = cross.get('namespace')
+    stamp = cross.get('started_at_ns')
+    if (type(cross.get('version')) is not int or cross.get('version') != 1
+            or cross.get('scope') != 'same_installation'
+            or not isinstance(namespace, str) or not re.fullmatch(r'[0-9a-f]{16}', namespace)
+            or type(stamp) is not int or stamp < 0 or not start * 1e9 <= stamp < end * 1e9):
+        return None
+    fields = _mapping(cross.get('fields'))
+    profile, request = _hash(fields.get('profile')), _hash(fields.get('request'))
+    if not profile or not request:
+        return None
+    usage = _mapping(raw.get('usage'))
+    total, cached = usage.get('input_tokens'), usage.get('cached_tokens')
+    if type(total) is not int or type(cached) is not int or not 0 <= cached <= total:
+        total = cached = None
+    values = tuple(_hash(fields.get(name)) for name in _FIELDS)
+    status = raw.get('status') if raw.get('status') in ('returned', 'failed_or_interrupted') else 'unknown'
+    evidence = 'declared_headers' if cross.get('account_evidence') == 'declared_headers' else 'unknown'
+    return (namespace, profile, request), (stamp, status, evidence, values, total, cached)
+
+
+def summarize(records, start, end):
+    """Summarize eligible cohorts, excluding incomplete or conflicting identities."""
+    if (isinstance(start, bool) or isinstance(end, bool) or not isinstance(start, (int, float))
+            or not isinstance(end, (int, float)) or not math.isfinite(start) or not math.isfinite(end)
+            or start < 0 or end <= start):
+        raise ValueError('invalid observation window')
+    unique = {}
+    conflicts = set()
+    duplicates = 0
+    for raw in records:
+        normalized = _normalize(raw, start, end)
+        if normalized is None:
+            continue
+        identity, value = normalized
+        if identity in conflicts:
+            continue
+        if identity in unique:
+            if unique[identity] == value:
+                duplicates += 1
+            else:
+                del unique[identity]
+                conflicts.add(identity)
+        else:
+            unique[identity] = value
+    cohorts = defaultdict(lambda: defaultdict(list))
+    returned_with_known_usage = 0
+    eligible_requests = 0
+    for (namespace, profile, _), (_, status, evidence, values, total, cached) in unique.items():
+        returned_with_known_usage += status == 'returned' and total is not None
+        if status != 'returned' or evidence != 'declared_headers' or not all(values) or total is None:
+            continue
+        eligible_requests += 1
+        cohorts[(namespace, *values)][profile].append((total, cached))
+    groups = []
+    for profiles in cohorts.values():
+        eligible = [calls for calls in profiles.values() if len(calls) >= 2]
+        if len(eligible) >= 2:
+            groups.append(eligible)
+    calls = [call for group in groups for profile in group for call in profile]
+    return {
+        'identity_qualified_requests': len(unique),
+        'identical_log_copies': duplicates,
+        'conflicting_request_identities': len(conflicts),
+        'returned_requests_with_known_usage': returned_with_known_usage,
+        'eligible_requests_with_complete_declared_fields': eligible_requests,
+        'comparable_groups': len(groups),
+        'groups_with_positive_cached_calls_in_multiple_profiles': sum(
+            sum(any(cached > 0 for _, cached in profile) for profile in group) >= 2 for group in groups),
+        'known_calls_in_comparable_groups': len(calls),
+        'input_tokens_in_comparable_groups': sum(total for total, _ in calls),
+        'cached_tokens_in_comparable_groups': sum(cached for _, cached in calls),
+        'minimum_known_calls_per_profile': 2,
+        'account_evidence': 'declared_headers_not_authenticated_identity',
+        'provider_cache_origin_proven': False,
+        'limitations': [
+            'Prepared metadata does not prove full provider wire identity or which profile populated a cache.',
+            'Declared headers do not prove the authenticated provider account.',
+            'The sampled logs can include tests and omit data; cached tokens do not prove cost savings.',
+        ],
+    }
