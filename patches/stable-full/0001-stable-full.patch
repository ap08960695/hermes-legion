index 0000000000000000000000000000000000000000..8b89de9fdff2265b72843e0f2f23473d63d83d9c
--- /dev/null
+++ b/tests/tui_gateway/test_kanban_notification_preparation.py
@@ -0,0 +1,84 @@
+"""Formatting or one board failure must not consume an undelivered Kanban event."""
+import sqlite3
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_notify as kbn
+from tui_gateway import server
+
+KEY = 'preparation-owner'
+
+
+def _blocked_notification(board='default'):
+    with kbc.connect_closing(board=board) as conn:
+        tid = kb.create_task(conn, title='prepare notification')
+        kbn.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY)
+        cursor = kbn.list_notify_subs(conn, task_id=tid)[0]['last_event_id']
+        assert kb.block_task(conn, tid, reason='fixture review')
+    return tid, cursor
+
+
+def _cursor(tid, board='default'):
+    with kbc.connect_closing(board=board) as conn:
+        return kbn.list_notify_subs(conn, task_id=tid)[0]['last_event_id']
+
+
+@pytest.mark.parametrize('second_event', [False, True])
+def test_failed_preparation_keeps_cursor_and_does_not_starve_sibling(monkeypatch, second_event):
+    broken, before = _blocked_notification()
+    if second_event:
+        with kbc.connect_closing() as conn:
+            assert kb.complete_task(conn, broken, summary='fixture done')
+    healthy, _ = _blocked_notification()
+    original = server._format_kanban_event_text
+
+    def prepare(sub, task, event, slug):
+        if sub['task_id'] == broken and (not second_event or event.kind == 'completed'):
+            raise ValueError('fixture formatter unavailable')
+        return original(sub, task, event, slug)
+
+    monkeypatch.setattr(server, '_format_kanban_event_text', prepare)
+    texts = server._collect_kanban_notifications({'session_key': KEY})
+    assert len(texts) == 1 and healthy in texts[0]
+    assert _cursor(broken) == before, 'nothing was handed off for this subscription'
+    monkeypatch.setattr(server, '_format_kanban_event_text', original)
+    retried = server._collect_kanban_notifications({'session_key': KEY})
+    assert len(retried) == (2 if second_event else 1)
+    assert all(broken in text for text in retried)
+    assert server._collect_kanban_notifications({'session_key': KEY}) == []
+
+
+def test_failed_board_does_not_discard_previous_board_batch(monkeypatch):
+    healthy, _ = _blocked_notification()
+    kb.create_board('other')
+    deferred, cursor = _blocked_notification('other')
+    original = server._kb_poll_board
+
+    def poll(core, slug, key, **kwargs):
+        if slug == 'other':
+            raise sqlite3.OperationalError('fixture board unavailable')
+        return original(core, slug, key, **kwargs)
+
+    monkeypatch.setattr(server, '_kb_poll_board', poll)
+    texts = server._collect_kanban_notifications({'session_key': KEY})
+    assert len(texts) == 1 and healthy in texts[0]
+    assert _cursor(deferred, 'other') == cursor
+    monkeypatch.setattr(server, '_kb_poll_board', original)
+    texts = server._collect_kanban_notifications({'session_key': KEY})
+    assert len(texts) == 1 and deferred in texts[0]
+    assert server._collect_kanban_notifications({'session_key': KEY}) == []
+
+
+def test_notification_claim_is_rolled_back_with_failed_preparation_transaction():
+    tid, cursor = _blocked_notification()
+    args = dict(task_id=tid, platform='tui', chat_id=KEY, kinds=('blocked',))
+    with kbc.connect_closing() as conn:
+        with pytest.raises(ValueError, match='preparation failed'):
+            with kb.write_txn(conn):
+                old, new, events = kbn.claim_unseen_events_for_sub(conn, **args)
+                assert old == cursor and new > old and len(events) == 1
+                raise ValueError('preparation failed')
+        assert not conn.in_transaction
+        assert _cursor(tid) == cursor
+        old, new, events = kbn.claim_unseen_events_for_sub(conn, **args)
+        assert old == cursor and new > old and len(events) == 1
diff --git a/tests/tui_gateway/test_kanban_notification_retry.py b/tests/tui_gateway/test_kanban_notification_retry.py
new file mode 100644
index 0000000000000000000000000000000000000000..4d7c9faba12efbe1c16059c47cc9d0544488f4fc
--- /dev/null
+++ b/tests/tui_gateway/test_kanban_notification_retry.py
@@ -0,0 +1,103 @@
+"""A cursor-claimed Kanban notification must survive failure before a turn starts."""
+import threading
+import queue
+import time
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_notify as kbn
+from tui_gateway import server
+
+
+@pytest.mark.parametrize('failure', ['exception', 'refusal', 'ui'])
+def test_claimed_notification_is_retried_once_after_a_failed_start(monkeypatch, failure):
+    with kbc.connect_closing() as conn:
+        task_id = kb.create_task(conn, title='retry an existing notification')
+        kbn.add_notify_sub(conn, task_id=task_id, platform='tui', chat_id='stored-notification')
+        before = kbn.list_notify_subs(conn, task_id=task_id)[0]['last_event_id']
+        assert kb.block_task(conn, task_id, reason='fixture review')
+    session = {'history_lock': threading.RLock(), 'running': False, 'history': [],
+               'session_key': 'stored-notification'}
+    worker_failed, ui_failed, accepted = [], [], []
+
+    def emit(event, *args, **kwargs):
+        if failure == 'ui' and event == 'status.update' and not ui_failed:
+            ui_failed.append(True)
+            raise RuntimeError('UI transport unavailable')
+
+    def submit(rid, sid, record, text, **kwargs):
+        if failure != 'ui' and not worker_failed:
+            worker_failed.append(True)
+            if failure == 'exception':
+                raise RuntimeError('no worker slot')
+            return False
+        accepted.append(text)
+        return True
+
+    monkeypatch.setattr(server, '_emit', emit)
+    monkeypatch.setattr(server, '_run_prompt_submit', submit)
+    server._notif_poll_kanban('retry-sid', session)
+    assert session['running'] is False
+    assert accepted == []
+    assert task_id in '\n'.join(session.get('_kanban_pending') or [])
+    with kbc.connect_closing() as conn:
+        after = kbn.list_notify_subs(conn, task_id=task_id)[0]['last_event_id']
+    assert after > before, 'the original event has already been cursor-claimed'
+
+    server._notif_poll_kanban('retry-sid', session)
+    assert len(accepted) == 1 and task_id in accepted[0]
+    assert session.get('_kanban_pending') == []
+    session['running'] = False
+    server._notif_poll_kanban('retry-sid', session)
+    assert len(accepted) == 1, 'a successful retry must not replay the event'
+
+
+def test_failed_batch_stays_before_new_work_buffered_during_submission(monkeypatch):
+    session = {'history_lock': threading.RLock(), 'running': False, 'history': [],
+               'session_key': 'stored-notification', '_kanban_pending': ['older']}
+    monkeypatch.setattr(server, '_collect_kanban_notifications', lambda session: [])
+    monkeypatch.setattr(server, '_emit', lambda *args, **kwargs: None)
+
+    def fail(rid, sid, record, text, **kwargs):
+        record['_kanban_pending'].append('newer')
+        raise RuntimeError('worker not started')
+
+    monkeypatch.setattr(server, '_run_prompt_submit', fail)
+    server._notif_poll_kanban('retry-sid', session)
+    assert session['_kanban_pending'] == ['older', 'newer']
+    assert session['running'] is False
+
+
+def test_rejected_notification_refunds_claim_and_only_admitted_delivery_is_acked(monkeypatch):
+    from tools import async_delegation as ledger
+    from tools.process_registry import process_registry
+
+    record = {'delegation_id': 'fixture', 'parent_session_id': 'parent',
+              'session_key': 'stored', 'goal': 'Synthetic completion',
+              'dispatched_at': time.time()}
+    event = {**record, 'type': 'async_delegation', 'status': 'completed',
+             'completed_at': time.time(), 'summary': 'Synthetic result'}
+    ledger._persist_dispatch(record)
+    ledger._persist_completion(event, {'summary': 'Synthetic result'})
+    pending = queue.Queue()
+    monkeypatch.setattr(process_registry, 'completion_queue', pending)
+    monkeypatch.setattr(server, '_emit', lambda *a, **k: None)
+    monkeypatch.setattr(server, '_run_prompt_submit', lambda *a, **k: False)
+    session = {'history_lock': threading.RLock(), 'running': True, 'history': []}
+    server._notif_dispatch_event('retry-sid', session, event, 'fixture')
+    saved = ledger.get_durable_delegation('fixture')
+    assert saved['delivery_state'] == 'pending' and saved['delivery_attempts'] == 0
+    assert pending.get_nowait() == event and pending.empty()
+    assert session['running'] is False
+
+    accepted = []
+    def admit(*args, **kwargs):
+        accepted.append(True)
+        return True
+    monkeypatch.setattr(server, '_run_prompt_submit', admit)
+    session['running'] = True
+    server._notif_dispatch_event('retry-sid', session, event, 'fixture')
+    saved = ledger.get_durable_delegation('fixture')
+    assert saved['delivery_state'] == 'delivered' and saved['delivery_attempts'] == 1
+    server._notif_dispatch_event('retry-sid', session, event, 'fixture')
+    assert len(accepted) == 1 and pending.empty()
