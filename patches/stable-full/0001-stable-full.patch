@@ -0,0 +1,167 @@
+"""Two real clarification waiters behind the authenticated multiplex dispatcher."""
+import asyncio
+
+import pytest
+
+from tests.gateway.test_session_authorities_multiplex import _reserve_homes, _runner
+
+
+class Peer:
+    def __init__(self):
+        self.events = asyncio.Queue()
+
+    def write(self, frame):
+        self.events.put_nowait(frame)
+        return True
+
+
+async def rpc(connection, method, **params):
+    return await connection.dispatch({'jsonrpc': '2.0', 'id': 1, 'method': method, 'params': params})
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('missing_or_invalid_board', [None, '../wrong-board'])
+async def test_inbox_routes_equal_session_ids_to_the_exact_profile_and_survives_reconnect(
+    tmp_path, monkeypatch, missing_or_invalid_board,
+):
+    from gateway.config import Platform
+    from gateway.run_runtime import initialize_gateway_runtime
+    from gateway.runtime_ownership import process_ownership
+    from gateway.session import SessionSource
+    from gateway.session_authority import LiveSession
+    from gateway.session_controls import AuthorityConnection
+    from hermes_cli.goals import GoalState
+    from hermes_state_runtime import admit_session_input, claim_session_input
+    from tools import clarify_gateway
+
+    root, homes = _reserve_homes(tmp_path, monkeypatch)
+    process_ownership.reserve([home for _, home in homes])
+    runner = _runner(root, homes)
+    connections = []
+    entries = {}
+    sid = 'shared-fixture-chat'
+    try:
+        await initialize_gateway_runtime(runner)
+        registry, store = runner.session_authorities, runner.session_ticket_store
+
+        def connect(authority, scope='profile', operator=True):
+            ticket = store.mint(profile_id=authority.profile_id, subject='uid:fixture',
+                                purpose='interactive', scope=scope)
+            grant = store.redeem(ticket, profile_id=None, purpose='interactive')
+            peer = Peer()
+            connection = AuthorityConnection(
+                authority, peer, {'user_id': grant['subject'], 'provider': 'local',
+                                  'profile_id': grant['profile_id'], 'instance_id': grant['instance_id'],
+                                  'capabilities': grant['capabilities'], 'profile_scope': grant['scope']},
+                operator=operator)
+            connections.append(connection)
+            return connection
+
+        for index, (name, home) in enumerate(homes[1:], 1):
+            authority = registry.for_home(home)
+            authority.db.create_session(sid, source='api_server')
+            route = f'fixture-route-{name}'
+            authority.sessions[sid] = LiveSession(
+                SessionSource(platform=Platform.LOCAL, chat_id='local-fixture', user_id='another-viewer'), route)
+            authority.db.set_meta(f'goal:{sid}', GoalState(goal=f'Check fixture {name}').to_json())
+            card = {'task_id': f't_fixture-{index}'}
+            board = 'review-west' if name == 'alpha' else missing_or_invalid_board
+            if board is not None:
+                card['board'] = board
+            admit_session_input(authority.db, epoch=authority.epoch, principal_id='fixture', session_id=sid,
+                                request_id='run', payload={'kanban_card_v1': card}, intent='queue')
+            row = claim_session_input(authority.db, epoch=authority.epoch, session_id=sid)
+            authority.executing[sid] = row['generation']
+            entries[name] = authority, route
+
+        host = connect(registry.launch, 'host')
+        scoped = connect(entries['alpha'][0])
+        viewer = connect(registry.launch, 'host', operator=False)
+        assert (await rpc(viewer, 'owner_inbox.list'))['error']['data']['reason'] == 'permission_denied'
+        assert (await rpc(host, 'owner_inbox.list'))['result']['items'] == []
+        assert (await rpc(scoped, 'owner_inbox.list'))['result']['items'] == []
+
+        questions = {'alpha': 'Tester: use fixture A or B?', 'beta': 'Writer: Markdown or PDF?'}
+        for name, (authority, route) in entries.items():
+            entry = clarify_gateway.register(f'question-{name}', route, questions[name], ['A', 'B'])
+            await asyncio.to_thread(authority.register_clarify, sid, authority.executing[sid], entry)
+
+        for _ in range(2):
+            event = await asyncio.wait_for(host.transport.events.get(), 2)
+            assert event['params']['type'] == 'owner_inbox.changed'
+            assert not event['params'].get('payload')
+        assert scoped.transport.events.qsize() == 1
+
+        items = (await rpc(host, 'owner_inbox.list'))['result']['items']
+        assert {item['profile']: (item['question'], item['card'], item.get('card_board'), item['goal'])
+                for item in items} == {
+            'alpha': (questions['alpha'], 't_fixture-1', 'review-west', 'Check fixture alpha'),
+            'beta': (questions['beta'], 't_fixture-2', None, 'Check fixture beta'),
+        }
+        assert all(item['created_at'] > 0 for item in items)
+        assert [item['profile'] for item in (await rpc(scoped, 'owner_inbox.list'))['result']['items']] == ['alpha']
+        row = next(item for item in items if item['profile'] == 'alpha')
+        params = {key: row[key] for key in ('profile', 'session_id', 'authority_epoch',
+                                           'execution_generation', 'prompt_id', 'kind')}
+        assert (await rpc(host, 'owner_inbox.respond', **{**params, 'profile': 'beta'}, value='wrong'))['result'] == {
+            'status': 'expired'}
+        assert (await rpc(host, 'owner_inbox.respond', **{**params, 'execution_generation': 999}, value='old'))['result'] == {
+            'status': 'expired'}
+        assert (await rpc(host, 'owner_inbox.respond', **params, value='B'))['result'] == {'status': 'resolved'}
+        assert await asyncio.to_thread(clarify_gateway.wait_for_response, 'question-alpha', 1) == 'B'
+        assert clarify_gateway.get_pending('question-beta') is not None
+        assert (await rpc(host, 'owner_inbox.respond', **params, value='duplicate'))['result'] == {'status': 'expired'}
+        assert (await asyncio.wait_for(host.transport.events.get(), 2))['params']['type'] == 'owner_inbox.changed'
+
+        await host.close()
+        connections.remove(host)
+        reopened = connect(registry.launch, 'host')
+        assert [item['prompt_id'] for item in (await rpc(reopened, 'owner_inbox.list'))['result']['items']] == ['question-beta']
+        assert all(not live.subscribers for authority, _ in entries.values() for live in authority.sessions.values())
+        assert (await rpc(reopened, 'owner_inbox.unwatch'))['result'] == {'watching': False}
+    finally:
+        for connection in connections:
+            await connection.close()
+        for _, route in entries.values():
+            clarify_gateway.clear_session(route)
+        for authority in list(getattr(runner, 'session_authorities', []) or []):
+            authority.db.close()
+        for _, home in homes:
+            process_ownership.release(home)
+
+
+@pytest.mark.asyncio
+async def test_managed_inbox_reply_waits_for_worker_receipt_and_cannot_replace_the_answer():
+    from types import SimpleNamespace
+
+    from agent.managed_worker import WorkerControls
+    from gateway.session_events import SessionEvents
+    from gateway.session_pending_controls import PendingControls
+    from hermes_state_runtime import RuntimeStoreError
+
+    parent = PendingControls(SessionEvents())
+    frames = asyncio.Queue()
+    child = WorkerControls.__new__(WorkerControls)
+    import threading
+    child.lock = threading.Lock()
+    entry = {'event': threading.Event(), 'answer': None}
+    child.clarifications = {'fixture-prompt': entry}
+    child.channel = SimpleNamespace(send=lambda kind, **data: frames.put_nowait((kind, data)))
+
+    def send(kind, prompt_id, value, *, receipt=False):
+        child._respond({'type': kind, 'prompt_id': prompt_id, 'value': value, 'receipt': receipt}, None)
+
+    parent.remote_responders['fixture-prompt'] = send
+    parent.register_clarify('fixture-chat', 1, SimpleNamespace(
+        clarify_id='fixture-prompt', question='Which fixture?', choices=['A', 'B'], multi_select=False))
+    response = parent.respond('fixture-chat', 1, 'fixture-prompt', {'answer': 'B'}, kind='clarify', inbox=True)
+    assert not response['receipt'].done()
