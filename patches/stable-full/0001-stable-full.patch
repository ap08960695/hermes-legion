+"""Reassign availability must use a fresh snapshot from the owning Hermes root."""
+
+import json
+import math
+import os
+import socket
+import time
+from pathlib import Path
+
+import pytest
+
+
+def _profile(root, name):
+    p = root / "profiles" / name
+    p.mkdir(parents=True, exist_ok=True)
+    (p / "config.yaml").write_text("toolsets: [file, kanban]\n", encoding="utf-8")
+
+
+def _snapshot(root, status, updated=None):
+    if updated is None:
+        updated = time.time()
+    (root / "bot-status.json").write_text(json.dumps({"updated": updated, "bots": status}), encoding="utf-8")
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    default = tmp_path / ".hermes"
+    other = tmp_path / "other-fleet"
+    for root in (default, other):
+        root.mkdir()
+        (root / "config.yaml").write_text("toolsets: [kanban]\n", encoding="utf-8")
+        for name in ("orchestra-captain", "reviewer-gpt", "developer-gpt"):
+            _profile(root, name)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(other))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(other))
+    monkeypatch.setenv("HERMES_PROFILE", "orchestra-captain")
+    for key in ("HERMES_KANBAN_DB", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_TASK", "HERMES_KANBAN_RUN_ID"):
+        monkeypatch.delenv(key, raising=False)
+    def no_network(*args, **kwargs):
+        pytest.fail("status checks and reassignment must stay offline")
+    monkeypatch.setattr(socket.socket, "connect", no_network)
+    monkeypatch.setattr(socket, "create_connection", no_network)
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_db_connect import connect_closing
+    from tools import kanban_tools  # register the native handlers
+    from tools.registry import registry
+    kb.init_db()
+    with connect_closing() as conn:
+        tid = kb.create_task(conn, title="isolated reassignment", assignee="reviewer-gpt", initial_status="blocked")
+    return default, other, tid, kb, connect_closing, registry
+
+
+def _reassign(board, target="developer-gpt"):
+    *_, tid, _kb, _connect, registry = board
+    return json.loads(registry.dispatch("kanban_reassign", {
+        "task_id": tid, "profile": target, "reason": "scoped correction"}))
+
+
+def _assert_original(board):
+    *_, tid, kb, connect, _ = board
+    with connect() as conn:
+        task = kb.get_task(conn, tid)
+        assert task.assignee == "reviewer-gpt" and task.status == "blocked"
+        assert task.current_run_id is None and task.claim_lock is None
+
+
+@pytest.mark.parametrize("local_status,foreign_status", [("paused", "active"), ("active", "paused")])
+def test_only_owning_fleet_snapshot_controls_reassignment(board, local_status, foreign_status):
+    default, other, *_ = board
+    _snapshot(default, {"developer-gpt": {"status": foreign_status}})
+    _snapshot(other, {"developer-gpt": {"status": local_status}})
+    result = _reassign(board)
+    if local_status == "active":
+        assert result.get("ok"), result
+    else:
+        assert not result.get("ok") and "paused" in result.get("error", ""), result
+        _assert_original(board)
+
+
+@pytest.mark.parametrize("updated", [0, True, "not-a-time", math.nan, math.inf])
+def test_invalid_or_old_snapshot_does_not_authorize_an_active_target(board, updated):
+    default, other, *_ = board
+    data = {"updated": updated, "bots": {"developer-gpt": {"status": "active"}}}
+    for root in (default, other):
+        (root / "bot-status.json").write_text(json.dumps(data), encoding="utf-8")
+    result = _reassign(board)
+    assert not result.get("ok") and "snapshot" in result.get("error", "").lower(), result
+    _assert_original(board)
+
+
+def test_future_snapshot_is_not_current_evidence(board):
+    default, other, *_ = board
+    for root in (default, other):
+        _snapshot(root, {"developer-gpt": {"status": "active"}}, time.time() + 3600)
+    result = _reassign(board)
+    assert not result.get("ok") and "snapshot" in result.get("error", "").lower(), result
+    _assert_original(board)
+
+
+def test_corrupt_snapshot_does_not_bypass_an_existing_gate(board):
+    default, other, *_ = board
+    for root in (default, other):
+        (root / "bot-status.json").write_text("{not-json", encoding="utf-8")
+    result = _reassign(board)
+    assert not result.get("ok") and "snapshot" in result.get("error", "").lower(), result
+    _assert_original(board)
+
+
+def test_empty_configured_snapshot_is_not_an_active_target(board):
+    default, other, *_ = board
+    for root in (default, other):
+        _snapshot(root, {})
+    result = _reassign(board)
+    assert not result.get("ok") and "unknown" in result.get("error", "").lower(), result
+    _assert_original(board)
+
+
+def test_no_snapshot_keeps_legacy_optional_integration_but_marks_unchecked(board):
+    result = _reassign(board)
+    assert result.get("ok") and result.get("availability") == "not_checked", result
+
+
+def test_stale_snapshot_cannot_unblock_a_quota_failure(board):
+    default, other, tid, kb, connect, _ = board
+    from hermes_cli import kanban_db_dispatch as dispatch
+    for root in (default, other):
+        _snapshot(root, {"developer-gpt": {"status": "active"}}, time.time() - 901)
+    with connect() as conn:
+        assert kb.unblock_task(conn, tid)
+        assert dispatch._record_task_failure(conn, tid, "provider quota exhausted", outcome="crashed", failure_limit=1)
+    result = _reassign(board)
+    assert not result.get("ok") and "snapshot" in result.get("error", "").lower(), result
+    _assert_original(board)
+
+
+def test_context_local_home_selects_its_own_custom_role_and_snapshot(board, monkeypatch):
+    import hermes_constants
+    default, other, *_ = board
+    _profile(other, "voice-custom")
+    _snapshot(default, {"voice-custom": {"status": "paused"}})
+    _snapshot(other, {"voice-custom": {"status": "active"}})
+    monkeypatch.setenv("HERMES_HOME", str(default))
+    token = hermes_constants.set_hermes_home_override(other / "profiles/orchestra-captain")
+    try:
+        result = _reassign(board, "voice-custom")
+        assert result.get("ok"), result
+    finally:
+        hermes_constants.reset_hermes_home_override(token)
+
+
+def test_context_local_home_cannot_borrow_other_fleets_custom_profile(board, monkeypatch):
+    import hermes_constants
+    default, other, *_ = board
+    _profile(default, "foreign-only")
+    for root in (default, other):
+        _snapshot(root, {"foreign-only": {"status": "active"}})
+    monkeypatch.setenv("HERMES_HOME", str(default))
+    token = hermes_constants.set_hermes_home_override(other / "profiles/orchestra-captain")
+    try:
+        result = _reassign(board, "foreign-only")
+        assert not result.get("ok") and "unknown target role profile" in result.get("error", ""), result
+        _assert_original(board)
+    finally:
+        hermes_constants.reset_hermes_home_override(token)
+
+
+@pytest.mark.platforms("posix")
+def test_dangling_status_link_is_unavailable_not_unconfigured(board, tmp_path):
+    _, other, *_ = board
+    (other / "bot-status.json").symlink_to(tmp_path / "missing-status")
+    result = _reassign(board)
+    assert not result.get("ok") and "snapshot" in result.get("error", "").lower(), result
+    _assert_original(board)
+
+
+def test_snapshot_removed_during_read_is_unavailable_not_unconfigured(board, monkeypatch):
+    _, other, *_ = board
+    marker = other / "bot-status.json"
+    _snapshot(other, {"developer-gpt": {"status": "active"}})
+    original = Path.open
+    removed = []
+
+    def open_after_remove(path, *args, **kwargs):
+        if path == marker and not removed:
+            marker.unlink()
+            removed.append(True)
+        return original(path, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "open", open_after_remove)
+    result = _reassign(board)
+    assert removed and not result.get("ok") and "snapshot" in result.get("error", "").lower(), result
+    _assert_original(board)
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.skipif(getattr(os, "geteuid", lambda: None)() == 0, reason="root can read a mode-000 file")
+def test_unreadable_configured_snapshot_does_not_bypass_gate(board):
+    _, other, *_ = board
+    marker = other / "bot-status.json"
+    _snapshot(other, {"developer-gpt": {"status": "active"}})
+    marker.chmod(0)
+    try:
+        result = _reassign(board)
+        assert not result.get("ok") and "snapshot" in result.get("error", "").lower(), result
+        _assert_original(board)
+    finally:
+        marker.chmod(0o600)
+
+
+def test_huge_timestamp_is_invalid_without_crashing_handler(board):
+    _, other, *_ = board
+    _snapshot(other, {"developer-gpt": {"status": "active"}}, 10 ** 400)
+    result = _reassign(board)
+    assert not result.get("ok") and "snapshot" in result.get("error", "").lower(), result
+    _assert_original(board)
+
+
+@pytest.mark.parametrize("age,allowed", [(900, True), (901, False), (-1, False)])
+def test_existing_quota_freshness_boundary(board, monkeypatch, age, allowed):
