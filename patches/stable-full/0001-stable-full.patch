@@ -0,0 +1,77 @@
+"""A clean exit without a terminal board call, but WITH a final message, is held for a
+decision (sticky block, message kept as the run summary) instead of a blind full respawn."""
+
+from __future__ import annotations
+
+import time
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_dispatch as kbd
+from hermes_cli.quiet_single_query import KANBAN_WORKER_EXIT_TRAILER
+
+
+@pytest.fixture
+def kanban_home(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_KANBAN_CRASH_GRACE_SECONDS", "0")
+    monkeypatch.setattr(kb, "_pid_alive", lambda _pid: False)
+    kbd._recent_worker_exits.clear()
+    kb.init_db()
+    return home
+
+
+def _dead_worker(conn, tid: str, pid: int, said: str, reaped: bool) -> None:
+    host = kb._claimer_id().split(":", 1)[0]
+    kb.claim_task(conn, tid, claimer=f"{host}:w{pid}")
+    conn.execute(
+        "UPDATE tasks SET worker_pid=?, worker_started_at=NULL, started_at=? WHERE id=?",
+        (pid, int(time.time()) - 120, tid),
+    )
+    conn.commit()
+    log = kb.worker_log_path(tid)
+    log.parent.mkdir(parents=True, exist_ok=True)
+    log.write_text(said)
+    if reaped:  # this process reaped the worker: its rc speaks for this run
+        kbd._recent_worker_exits[pid] = (0, time.time())
+
+
+_EXIT = f"\n\nResume this session with:\n  hermes --resume x\n\n{KANBAN_WORKER_EXIT_TRAILER}0\n"
+
+
+@pytest.mark.parametrize("said, reaped, held", ids=[
+    "final-message", "no-output", "silent-retry-after-held-attempt", "log-trailer-only",
+], argvalues=[
+    ("step\n" * 200 + "Implemented the fix; tests pass." + _EXIT, True, True),
+    (_EXIT, True, False),
+    # The append-mode log still holds an earlier attempt's prose: not this run's message.
+    ("ATTEMPT ONE prose" + _EXIT + _EXIT, True, False),
+    # rc=0 known only from the append-mode log: it may be an older attempt's trailer (#121255).
+    ("old attempt prose" + _EXIT + "half-done retry output\n", False, False),
+])
+def test_clean_exit_with_final_message_is_held_not_respawned(kanban_home, said, reaped, held):
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title="t", assignee="a")
+        _dead_worker(conn, tid, 72001, said, reaped)
+
+        kbd.detect_crashed_workers(conn)
+        kb.recompute_ready(conn, failure_limit=10)
+
+        task = kb.get_task(conn, tid)
+        run = conn.execute(
+            "SELECT summary FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1", (tid,)).fetchone()
+        if held:
+            assert task.status == "blocked"  # sticky: recompute_ready must not respawn it
+            assert run["summary"].endswith("tests pass.")
+            assert 400 < len(run["summary"]) <= kbd._FINAL_MESSAGE_LIMIT
+            assert "final message attached" in task.last_failure_error
+            assert "tests pass." in task.last_failure_error
+        else:
+            assert task.status == "ready"  # no attributable final message: existing bounded retry
+            assert run["summary"] is None
