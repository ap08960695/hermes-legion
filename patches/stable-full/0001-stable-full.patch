+import { workflowAncestry, workflowIsActive } from './workflow-model'
+import { expect, it } from 'vitest'
+import { workflowGraph, orderedBotRuns } from './workflow-model'
+import type { KanbanBoard, KanbanRun } from './types'
+const task = (id: string, status = 'blocked') => ({ id, title: id, status })
+const board = (tasks = [task('plan'), task('write'), task('check'), task('ship')]): KanbanBoard => ({
+  columns: [{ name: 'blocked', tasks }],
+  tenants: [],
+  assignees: [],
+  now: 1,
+  latest_event_id: 1,
+  links: [
+    { parent_id: 'plan', child_id: 'write' },
+    { parent_id: 'plan', child_id: 'check' },
+    { parent_id: 'write', child_id: 'ship' },
+    { parent_id: 'check', child_id: 'ship' }
+  ]
+})
+it('shows real fork/join direction and parallel ranks without mutating the snapshot', () => {
+  const input = board()
+  const original = JSON.stringify(input)
+  const graph = workflowGraph(input)
+  expect(graph.nodes.find(n => n.task.id === 'plan')?.rank).toBe(0)
+  expect(graph.nodes.find(n => n.task.id === 'write')?.rank).toBe(1)
+  expect(graph.nodes.find(n => n.task.id === 'check')?.rank).toBe(1)
+  expect(graph.nodes.find(n => n.task.id === 'ship')?.rank).toBe(2)
+  expect(graph.edges).toHaveLength(4)
+  expect(JSON.stringify(input)).toBe(original)
+})
+it('does not invent edges when the backend has no link capability', () => {
+  const input = board()
+  delete input.links
+  const graph = workflowGraph(input)
+  expect(graph.linksKnown).toBe(false)
+  expect(graph.edges).toEqual([])
+  expect(graph.nodes).toHaveLength(4)
+})
+it('preserves cycle nodes and marks unresolved ordering rather than dropping work', () => {
+  const input = board()
+  input.links!.push({ parent_id: 'ship', child_id: 'plan' })
+  const graph = workflowGraph(input)
+  expect(graph.cyclic).toBe(true)
+  expect(graph.nodes).toHaveLength(4)
+})
+it('bounds nodes/edges and reports omitted context including missing endpoints', () => {
+  const input = board()
+  input.links!.push({ parent_id: 'outside', child_id: 'plan' })
+  const graph = workflowGraph(input, 3, 2)
+  expect(graph.nodes).toHaveLength(3)
+  expect(graph.edges.length).toBeLessThanOrEqual(2)
+  expect(graph.omittedNodes).toBe(1)
+  expect(graph.omittedEdges).toBeGreaterThan(0)
+})
+it('keeps only completed ancestors of current work instead of mounting all history', () => {
+  const input = board([task('write')])
+  input.columns.push({
+    name: 'done',
+    tasks: [task('plan', 'done'), ...Array.from({ length: 2000 }, (_, i) => task('old-' + i, 'done'))]
+  })
+  const graph = workflowGraph(input)
+  expect(graph.nodes.map(n => n.task.id)).toEqual(['write', 'plan'])
+})
+it('shows no active graph for an entirely completed board', () => {
+  const input = board([])
+  input.columns = [{ name: 'done', tasks: [task('old', 'done')] }]
+  expect(workflowGraph(input).nodes).toEqual([])
+})
+it('orders recorded bot attempts and preserves retries and missing-profile evidence', () => {
+  const runs = [
+    { id: 3, profile: 'reviewer', status: 'done', started_at: 30 },
+    { id: 1, profile: 'writer', status: 'failed', started_at: 10 },
+    { id: 2, profile: 'writer', status: 'done', started_at: 20 },
+    { id: 4, profile: null, status: 'claimed' }
+  ] as KanbanRun[]
+  expect(orderedBotRuns(runs).map(r => r.id)).toEqual([1, 2, 3, 4])
+  expect(orderedBotRuns(runs, 2)).toHaveLength(2)
+  expect(runs.map(r => r.id)).toEqual([3, 1, 2, 4])
+})
+
+it('traces ancestors back from a selected destination without crossing unrelated branches or looping', () => {
+  const links = [
+    { parent_id: 'origin', child_id: 'middle' },
+    { parent_id: 'middle', child_id: 'end' },
+    { parent_id: 'middle', child_id: 'sibling' },
+    { parent_id: 'other', child_id: 'unrelated' }
+  ]
+  const result = workflowAncestry('end', links)
+  expect([...result.nodes].sort()).toEqual(['end', 'middle', 'origin'])
+  expect(result.edges.has('middle:end')).toBe(true)
+  expect(result.edges.has('middle:sibling')).toBe(false)
+  expect([...workflowAncestry('end', [...links, { parent_id: 'end', child_id: 'origin' }]).nodes]).toHaveLength(3)
+})
+
+it('animates only a native running worker with a fresh heartbeat, never queued or stale cards', () => {
+  const task = { id: 'work', title: 'work', status: 'running', worker_pid: 123, last_heartbeat_at: 100 }
+  expect(workflowIsActive(task, 110)).toBe(true)
+  for (const changed of [
+    { status: 'ready' },
+    { last_heartbeat_at: 1 },
+    { worker_pid: null },
+    { last_heartbeat_at: null }
+  ])
+    expect(workflowIsActive({ ...task, ...changed }, 200)).toBe(false)
+})
diff --git a/apps/desktop/src/plugins/kanban/workflow-model.ts b/apps/desktop/src/plugins/kanban/workflow-model.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e82e684bcdd3a5aaae3dbd5708890b175d41cb76
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/workflow-model.ts
@@ -0,0 +1,110 @@
+import type { KanbanBoard, KanbanLink, KanbanRun, KanbanTask } from './types'
+
+export const WORKFLOW_NODE_LIMIT = 80
+const TERMINAL = new Set(['done', 'archived'])
+export const NODE_WIDTH = 240,
+  NODE_HEIGHT = 106,
+  COLUMN_GAP = 76,
+  ROW_GAP = 28
+export interface WorkflowNode {
+  task: KanbanTask
+  displayStatus: string
+  rank: number
+  row: number
+}
+
+function includeAncestors(seed: string[], links: KanbanLink[], known: ReadonlyMap<string, unknown>, limit: number) {
+  const ids = new Set(seed.slice(0, limit))
+  const parents = new Map<string, string[]>()
+  for (const link of links) parents.set(link.child_id, [...(parents.get(link.child_id) ?? []), link.parent_id])
+  for (const id of ids) {
+    for (const parent of parents.get(id) ?? []) {
+      if (ids.size < limit && known.has(parent)) ids.add(parent)
+    }
+  }
+  return ids
+}
+
+function dependencyRanks(ids: Set<string>, edges: KanbanLink[]) {
+  const incoming = new Map([...ids].map(id => [id, 0])),
+    children = new Map<string, string[]>()
+  for (const edge of edges) {
+    incoming.set(edge.child_id, (incoming.get(edge.child_id) ?? 0) + 1)
+    children.set(edge.parent_id, [...(children.get(edge.parent_id) ?? []), edge.child_id])
+  }
+  const queue = [...ids].filter(id => incoming.get(id) === 0),
+    ranks = new Map<string, number>()
+  for (const id of queue) {
+    const rank = ranks.get(id) ?? 0
+    for (const child of children.get(id) ?? []) {
+      ranks.set(child, Math.max(ranks.get(child) ?? 0, rank + 1))
+      incoming.set(child, incoming.get(child)! - 1)
+      if (incoming.get(child) === 0) queue.push(child)
+    }
+  }
+  return { ranks, cyclic: queue.length < ids.size }
+}
+
+/** Edges come only from native dependency records; status never invents ordering. */
+export function workflowGraph(board: KanbanBoard, nodeLimit = WORKFLOW_NODE_LIMIT, edgeLimit = 240) {
+  const all = new Map(
+    board.columns.flatMap(col => col.tasks.map(task => [task.id, { task, displayStatus: col.name }] as const))
+  )
+  const active = [...all.values()].filter(node => !TERMINAL.has(node.displayStatus)).map(node => node.task.id)
+  const links = board.links ?? [],
+    ids = includeAncestors(active, links, all, Math.max(0, nodeLimit))
+  const unique = [...new Map(links.map(edge => [`${edge.parent_id}\0${edge.child_id}`, edge])).values()]
+  const visible = unique.filter(edge => ids.has(edge.parent_id) && ids.has(edge.child_id))
+  const { ranks, cyclic } = dependencyRanks(ids, visible),
+    rows = new Map<number, number>()
+  const nodes: WorkflowNode[] = [...ids].map(id => {
+    const rank = ranks.get(id) ?? 0,
+      row = rows.get(rank) ?? 0
+    rows.set(rank, row + 1)
+    return { ...all.get(id)!, rank, row }
+  })
+  return {
+    nodes,
+    edges: visible.slice(0, edgeLimit),
+    linksKnown: Array.isArray(board.links),
+    cyclic,
+    omittedNodes: Math.max(0, active.length - nodes.filter(n => !TERMINAL.has(n.displayStatus)).length),
+    omittedEdges: Math.max(
+      0,
+      unique.filter(e => ids.has(e.parent_id) || ids.has(e.child_id)).length - Math.min(visible.length, edgeLimit)
+    ),
+    width: Math.max(1, ...nodes.map(n => n.rank + 1)) * (NODE_WIDTH + COLUMN_GAP),
+    height: Math.max(1, ...nodes.map(n => n.row + 1)) * (NODE_HEIGHT + ROW_GAP)
+  }
+}
+
+export function orderedBotRuns(runs: readonly KanbanRun[], limit = 30): KanbanRun[] {
+  const time = (run: KanbanRun) => (Number.isFinite(run.started_at) && run.started_at! > 0 ? run.started_at! : Infinity)
+  return [...runs]
+    .sort((a, b) => time(a) - time(b) || String(a.id).localeCompare(String(b.id), undefined, { numeric: true }))
+    .slice(0, limit)
+}
+
+/** Walk backwards through visible native links. A visited set terminates cycles. */
+export function workflowAncestry(selected: string, links: readonly KanbanLink[]) {
+  const nodes = new Set([selected]),
+    edges = new Set<string>()
+  for (const child of nodes)
+    for (const edge of links)
+      if (edge.child_id === child) {
+        nodes.add(edge.parent_id)
+        edges.add(`${edge.parent_id}:${edge.child_id}`)
+      }
+  return { nodes, edges }
+}
+export function workflowIsActive(task: KanbanTask, now = Date.now() / 1000) {
+  const heartbeat = task.last_heartbeat_at
+  return (
+    task.status === 'running' &&
+    Boolean(task.worker_pid && task.worker_pid > 0) &&
+    typeof heartbeat === 'number' &&
+    Number.isFinite(heartbeat) &&
+    now - heartbeat >= 0 &&
+    now - heartbeat <= 120
+  )
+}
