+def test_requesting_allocation_counts_does_not_enable_a_profiler(monkeypatch):
+    from gateway import runtime_memory
+
+    def forbidden(*args, **kwargs):
+        pytest.fail('A read-only diagnostic must not enable profiling or snapshot an untraced process')
+
+    monkeypatch.setattr(tracemalloc, 'is_tracing', lambda: False)
+    monkeypatch.setattr(tracemalloc, 'start', forbidden)
+    monkeypatch.setattr(tracemalloc, 'take_snapshot', forbidden)
