+import hashlib
+import json
+import sqlite3
+
+from hermes_cli.prompt_suggestion_context import work_overview
+
+
+def test_overview_uses_goal_project_backlog_done_and_blockers_without_reading_other_projects(
+    tmp_path, monkeypatch
+):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    state = sqlite3.connect(tmp_path / "state.db")
+    state.execute("CREATE TABLE state_meta (key TEXT PRIMARY KEY,value TEXT)")
+    state.execute(
+        "INSERT INTO state_meta VALUES(?,?)",
+        (
+            "goal:mine",
+            json.dumps(
+                {
+                    "goal": "แก้ compact และ resume",
+                    "status": "active",
+                    "subgoals": ["ตรวจ memory"],
+                }
+            ),
+        ),
+    )
+    state.commit()
+    state.close()
+    db = sqlite3.connect(tmp_path / "kanban.db")
+    db.executescript("""CREATE TABLE tasks(id TEXT,title TEXT,status TEXT,body TEXT,result TEXT,block_kind TEXT,workspace_path TEXT,session_id TEXT,created_at INTEGER);
+    CREATE TABLE task_links(parent_id TEXT,child_id TEXT);
+    INSERT INTO tasks VALUES('done','แก้ compact','done','','ผ่าน unit','','/project/loan','mine',1);
+    INSERT INTO tasks VALUES('pending','ทดสอบ resume','ready','','','','/project/loan',NULL,2);
+    INSERT INTO tasks VALUES('owner','ห้ามลบข้อมูล SIT','blocked','รอเจ้าของยืนยัน baseline','','needs_input','/project/loan',NULL,3);
+    INSERT INTO tasks VALUES('foreign','PRIVATE_OTHER_PROJECT','ready','','','','/project/other',NULL,4);
+    INSERT INTO task_links VALUES('owner','pending');""")
+    db.commit()
+    db.close()
+    paths = [tmp_path / "kanban.db", tmp_path / "state.db"]
+    before = [hashlib.sha256(p.read_bytes()).hexdigest() for p in paths]
+    text = work_overview("mine", "/project/loan")
+    for expected in [
+        "แก้ compact และ resume",
+        "ตรวจ memory",
+        "ทดสอบ resume",
+        "done",
+        "ห้ามลบข้อมูล SIT",
+        "needs_input",
+        "owner",
+    ]:
+        assert expected in text
+    assert "PRIVATE_OTHER_PROJECT" not in text
+    assert [hashlib.sha256(p.read_bytes()).hexdigest() for p in paths] == before
+    assert len(text) <= 2200
+
+
+def test_no_project_does_not_sweep_all_boards_or_create_state(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    assert work_overview("missing", str(tmp_path)) == ""
+    assert not list(tmp_path.rglob("state.db"))
+    assert not list(tmp_path.rglob("kanban.db"))
