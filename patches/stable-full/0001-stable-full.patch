+
+def _outer_string_byte_offset(blob, span, target, deadline):
+    """Map a decoded JSON-string character position to its raw byte offset."""
+    start, end = span
+    cur = Cursor(blob, start, deadline)
+    decoder = codecs.getincrementaldecoder('utf-8')('strict')
+    count = 0
+    while cur.tell() < end:
+        if not cur._fill():
+            raise InvalidJSON('short JSON string')
+        bound = min(len(cur.buf), cur.pos + end - cur.tell())
+        slash = cur.buf.find(b'\\', cur.pos, bound)
+        stop = bound if slash < 0 else slash
+        pending = decoder.getstate()[0]
+        raw_start = cur.tell() - len(pending)
+        text = decoder.decode(cur.buf[cur.pos:stop], final=False)
+        if target < count + len(text):
+            return raw_start + len(text[:target - count].encode('utf-8'))
+        count += len(text)
+        cur.pos = stop
+        if cur.tell() >= end:
+            break
+        if cur.peek() != 92:
+            continue
+        decoder.decode(b'', final=True)
+        decoder = codecs.getincrementaldecoder('utf-8')('strict')
+        raw_start = cur.tell()
+        cur.get()
+        escape = cur.get()
+        if escape == 117:
+            first = int(bytes(cur.get() for _ in range(4)), 16)
+            if 0xD800 <= first <= 0xDBFF and cur.tell() < end and cur.peek() == 92:
+                resume = cur.tell()
+                cur.get()
+                if cur.tell() < end and cur.get() == 117 and cur.tell() + 4 <= end:
+                    try:
+                        second = int(bytes(cur.get() for _ in range(4)), 16)
+                    except ValueError:
+                        second = -1
+                    if not 0xDC00 <= second <= 0xDFFF:
+                        cur = Cursor(blob, resume, deadline)
+                else:
+                    cur = Cursor(blob, resume, deadline)
+        if target == count:
+            return raw_start
+        count += 1
+    decoder.decode(b'', final=True)
+    raise UnsupportedJSON('decoded tool-call offset no longer maps to its source')
+
+
+def _raw_character_offset(blob, byte_offset, deadline):
+    blob.seek(0)
+    decoder = codecs.getincrementaldecoder('utf-8')('strict')
+    remaining, chars = byte_offset, 0
+    while remaining:
+        if deadline is not None and time.monotonic() >= deadline:
+            raise TimeoutError('structured global search timed out')
+        part = blob.read(min(65536, remaining))
+        if not part:
+            raise InvalidJSON('short tool calls')
+        remaining -= len(part)
+        chars += len(decoder.decode(part, final=remaining == 0))
+    return chars
+
+
+class _StringSpans(Cursor):
+    """Collect bounded JSON string spans while validating the entire value."""
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.spans = []
+
+    def string(self):
+        span = super().string()
+        if len(self.spans) >= 65536:
+            raise UnsupportedJSON('too many strings in serialized tool calls')
+        self.spans.append(span)
+        return span
+
