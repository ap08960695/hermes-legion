+@router.get('')
+async def list_spaces():return {'spaces':await asyncio.to_thread(_call,Spaces().list)}
+@router.post('')
+async def create_space(payload:CreateSpace):return await asyncio.to_thread(_call,Spaces().create,payload.title,_members(payload.members))
+@router.get('/all-items')
+async def catalog_items():return {'items':await asyncio.to_thread(_call,_items,None,False)}
+@router.get('/{sid}')
+async def space_detail(sid:str):return await asyncio.to_thread(_call,_space,sid)
+@router.patch('/{sid}')
+async def change_members(sid:str,payload:Members):return await asyncio.to_thread(_call,Spaces().members,sid,_members(payload.members),payload.revision)
+@router.get('/{sid}/items')
+async def list_items(sid:str,trash:bool=False):return {'items':await asyncio.to_thread(_call,_items,sid,trash)}
+@router.post('/{sid}/pages')
+async def create_page(sid:str,payload:Page):
+    row=await asyncio.to_thread(_call,Spaces().add,sid,payload.title,payload.text.encode(),'page','text/markdown');row.pop('data');return row
+@router.post('/{sid}/files')
+async def import_file(sid:str,payload:Upload):return await asyncio.to_thread(_call,_upload,sid,payload)
+@router.get('/{sid}/items/{iid}')
+async def item_detail(sid:str,iid:str):return await asyncio.to_thread(_call,_item,sid,iid)
+@router.patch('/{sid}/items/{iid}')
+async def change_item(sid:str,iid:str,payload:Change):
+    if payload.deleted is not None:return await asyncio.to_thread(_call,Spaces().remove,sid,iid,payload.revision,payload.deleted)
+    if payload.title is None or payload.text is None:raise HTTPException(400,'Title and text are required')
+    row=await asyncio.to_thread(_call,Spaces().save_page,sid,iid,payload.title,payload.text,payload.revision);row.pop('data');return row
