@@ -0,0 +1,42 @@
+"""Keep existing request/payload assertions while doubling only async HTTP I/O."""
+from contextlib import asynccontextmanager
+import json as jsonlib
+
+import httpx
+import requests
+
+
+def install_http_mock(monkeypatch, post):
+    from hermes_cli import prompt_suggestion_http as transport
+
+    class Client:
+        def __init__(self, timeout):
+            self.timeout = timeout
+
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, *exc):
+            return False
+
+        @asynccontextmanager
+        async def stream(self, method, url, *, headers, json):
+            assert method == "POST"
+            kwargs = {"headers": headers, "json": json, "timeout": (0.5, self.timeout)}
+            if json.get("stream") is True:
+                kwargs["stream"] = True
+            try:
+                old = post(url, **kwargs)
+            except requests.RequestException as exc:
+                raise httpx.ReadError("doubled HTTP transport error") from exc
+            if json.get("stream") is True:
+                body = b"\n".join(old.iter_lines()) + b"\n"
+            else:
+                body = jsonlib.dumps(old.json()).encode()
+            response = httpx.Response(old.status_code, content=body)
+            try:
+                yield response
+            finally:
+                await response.aclose()
+
+    monkeypatch.setattr(transport, "_client", Client)
