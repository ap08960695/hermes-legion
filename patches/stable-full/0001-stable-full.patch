+import { describe, expect, it } from 'vitest'
+
+import { buildFeatureCatalog, resolvePrimaryTarget, workStatus } from './model'
+
+describe('Focus native navigation', () => {
+  it('returns to the existing chat and never creates a new session for Chat', () => {
+    expect(resolvePrimaryTarget('chat', '/stored-existing', [])).toEqual({ path: '/stored-existing' })
+    expect(resolvePrimaryTarget('chat', null, [])).toEqual({ path: '/' })
+  })
+
+  it('opens only an installed board and falls back to the actual workers page', () => {
+    expect(resolvePrimaryTarget('tasks', null, [])).toEqual({ path: '/agents' })
+    expect(resolvePrimaryTarget('tasks', null, ['/kanban'])).toEqual({ path: '/kanban' })
+    expect(resolvePrimaryTarget('bots', null, [], ['hermes-bots:pane'])).toEqual({ pane: 'hermes-bots:pane' })
+    expect(resolvePrimaryTarget('bots', null, [])).toEqual({ path: '/profiles' })
+  })
+
+  it('keeps every core feature and late plugin destinations searchable without mutating inputs', () => {
+    const plugin = { id: 'plugin-report', label: 'Reports', path: '/reports', codicon: 'graph' }
+    const rows = buildFeatureCatalog([plugin])
+    expect(rows.length).toBeGreaterThanOrEqual(27)
+    expect(rows.find(r => r.id === 'plugin-report')?.path).toBe('/reports')
+    expect(new Set(rows.map(r => r.id)).size).toBe(rows.length)
+    expect(rows.find(r => r.id === 'skills')?.path).toBe('/capabilities?tab=skills')
+    expect(rows.find(r => r.id === 'plugins')?.path).toBe('/capabilities?tab=plugins')
+    expect(plugin).toEqual({ id: 'plugin-report', label: 'Reports', path: '/reports', codicon: 'graph' })
+  })
+})
+
+describe('Focus status evidence', () => {
+  it('never upgrades idle or a finished turn to a completed goal', () => {
+    expect(workStatus({})).toEqual({ kind: 'idle', reason: '' })
+    expect(workStatus({ finished: true })).toEqual({ kind: 'finished', reason: '' })
+    expect(workStatus({ goal: { status: 'done', title: 'Ship' } })).toEqual({ kind: 'done', reason: 'Ship' })
+  })
+
+  it('prioritizes a real owner request and exact wait target over generic running state', () => {
+    expect(workStatus({ needsInput: true, busy: true })).toEqual({ kind: 'input', reason: '' })
+    expect(
+      workStatus({
+        busy: true,
+        goal: { status: 'active', title: 'Ship', wait_barrier: { type: 'pid', target: 123, reason: 'Build' } }
+      })
+    ).toEqual({ kind: 'process', reason: 'Build', target: '123' })
+    expect(workStatus({ providerWait: 'Rate limited until reset' })).toEqual({
+      kind: 'provider',
+      reason: 'Rate limited until reset'
+    })
+  })
+})
+
+it('opens model configuration and the usage section rather than accounts or sessions', () => {
+  const rows = buildFeatureCatalog([])
+  expect(rows.find(row => row.id === 'models')?.path).toBe('/settings?tab=config:model')
+  expect(rows.find(row => row.id === 'usage')?.path).toBe('/command-center?section=usage')
+})
+
+it('opens the full Bots workspace when the plugin contributes it', () => {
+  expect(resolvePrimaryTarget('bots', null, ['/bots', '/kanban'], ['hermes-bots:pane'])).toEqual({ path: '/bots' })
+})
+
+it('offers one Hub entry for both legacy Library and Spaces routes', () => {
+  const features = buildFeatureCatalog([
+    { id: 'legacy-library', path: '/artifacts', label: 'Library', codicon: 'files' },
+    { id: 'spaces', path: '/spaces', label: 'Spaces', codicon: 'files' },
+    { id: 'new-hub', path: '/hub', label: 'Hub', codicon: 'files' }
+  ])
+  expect(features.filter(row => ['/hub', '/artifacts', '/spaces'].includes(row.path || ''))).toHaveLength(1)
+  expect(features.find(row => row.id === 'hub')).toBeTruthy()
