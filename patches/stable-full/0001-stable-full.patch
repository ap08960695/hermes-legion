+"""On-demand gateway memory observation through the existing private control channel."""
+
+
+def cmd_memory(args):
+    """Print one scalar snapshot without starting or changing the gateway."""
+    import json
+    import sys
+
+    from gateway.control_socket import query_gateway_control
+    from hermes_constants import get_hermes_home
+
+    result = query_gateway_control(get_hermes_home(), "memory-stats", timeout=5)
+    process = result.get("process") if isinstance(result, dict) else None
+    if not (isinstance(result, dict) and type(result.get("pid")) is int and result["pid"] > 0
+            and isinstance(process, dict) and "rss_kib" in process
+            and (process["rss_kib"] is None
+                 or (type(process["rss_kib"]) is int and process["rss_kib"] >= 0))):
+        print("Gateway memory observation unavailable", file=sys.stderr)
+        raise SystemExit(1)
+    print(json.dumps(result, indent=2))
