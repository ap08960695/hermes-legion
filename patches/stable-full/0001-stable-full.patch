+"""Owner checks use the current OS account without shell or environment identity."""
+import pytest
+
+
+@pytest.mark.platforms('posix')
+def test_current_user_id_matches_a_file_created_by_this_process(tmp_path):
+    from hermes_platform.host import identity
+
+    path = tmp_path / 'owned'
+    path.write_bytes(b'owned by this process')
+    assert identity.current_user_id() == path.stat().st_uid
+
