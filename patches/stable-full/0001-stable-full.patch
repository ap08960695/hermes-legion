@@ -0,0 +1,10 @@
+import { expect, it } from 'vitest'
+
+import { runElapsed } from './bot-journey'
+
+it('reports finished, live and unknown run lengths', () => {
+  expect(runElapsed({ ended_at: 1090, id: 1, started_at: 1000, status: 'done' })).toBe('1m')
+  expect(runElapsed({ id: 2, started_at: 1000, status: 'running' }, 1042)).toBe('42s')
+  expect(runElapsed({ id: 3, started_at: 1000, status: 'crashed' }, 1042)).toBeNull()
+  expect(runElapsed({ id: 4, status: 'running' }, 1042)).toBeNull()
+})
diff --git a/apps/desktop/src/plugins/kanban/bot-journey.test.tsx b/apps/desktop/src/plugins/kanban/bot-journey.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..7010347cd9b906d09e1935d014d1a37b317f33a4
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/bot-journey.test.tsx
@@ -0,0 +1,47 @@
+import { cleanup, render, screen, fireEvent } from '@testing-library/react'
+import { beforeEach, afterEach, expect, it } from 'vitest'
+// eslint-disable-next-line no-restricted-imports
+import { registerPluginLocales } from '@/i18n/plugin-i18n'
+import { KANBAN_LOCALES } from './i18n'
+import { BotJourney } from './bot-journey'
+let dispose = () => {}
+beforeEach(() => {
+  dispose = registerPluginLocales('kanban', KANBAN_LOCALES)
+})
+afterEach(() => {
+  cleanup()
+  dispose()
+})
+it('shows recorded attempts in order and separates the current assignment', () => {
+  render(
+    <BotJourney
+      assignee="reviewer"
+      runs={[
+        { id: 2, profile: 'writer', status: 'done', started_at: 20 },
+        { id: 1, profile: 'writer', status: 'failed', started_at: 10 }
+      ]}
+    />
+  )
+  expect(screen.getAllByText('writer')).toHaveLength(2)
+  expect(screen.getByLabelText('Recorded bot runs').textContent!.indexOf('#1')).toBeLessThan(
+    screen.getByLabelText('Recorded bot runs').textContent!.indexOf('#2')
+  )
+  expect(screen.getByText('Currently assigned: reviewer')).toBeTruthy()
+})
+it('never turns an assignee into a recorded execution', () => {
+  render(<BotJourney assignee="planner" runs={[]} />)
+  expect(screen.getByText('No recorded bot runs')).toBeTruthy()
+  expect(screen.queryByRole('list')).toBeNull()
+  expect(screen.getByText('Currently assigned: planner')).toBeTruthy()
+})
+it('keeps unknown profiles explicit and bounds a long run history', () => {
+  render(
+    <BotJourney
+      assignee={null}
+      runs={Array.from({ length: 31 }, (_, i) => ({ id: i + 1, status: 'done', started_at: i + 1, profile: null }))}
+    />
+  )
+  expect(screen.getAllByText('Profile not recorded')).toHaveLength(30)
+  fireEvent.click(screen.getByRole('button', { name: 'Show more runs' }))
+  expect(screen.getAllByText('Profile not recorded')).toHaveLength(31)
+})
diff --git a/apps/desktop/src/plugins/kanban/bot-journey.tsx b/apps/desktop/src/plugins/kanban/bot-journey.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a3513559c329f5b0a686c9bcaff270b888b3b4e8
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/bot-journey.tsx
@@ -0,0 +1,67 @@
+import { Button, Codicon } from '@hermes/plugin-sdk'
+import { useState } from 'react'
+import type { KanbanRun } from './types'
+import { orderedBotRuns } from './workflow-model'
+import { duration, useKanban, Avatar } from './ui'
+
+function runTime(start?: number | null) {
+  if (!start || !Number.isFinite(start)) return null
+  const date = new Date(start * 1000)
+  return Number.isFinite(date.getTime()) ? date : null
+}
+
+/** Run length: ended_at - started_at, or time so far while the run is still open. */
+export function runElapsed(run: KanbanRun, nowS = Date.now() / 1000): null | string {
+  return duration(run.started_at, run.ended_at ?? (run.status === 'running' ? nowS : null))
+}
+
+/** A claim/run record is evidence of that native attempt, not a model call. */
+export function BotJourney({ runs, assignee }: { runs: readonly KanbanRun[]; assignee?: string | null }) {
+  const k = useKanban(),
+    [limit, setLimit] = useState(30)
+  const ordered = orderedBotRuns(runs, limit)
+  return (
+    <section className="kanban-bot-journey" aria-label={k.botJourney}>
+      <h3>
+        <Codicon name="history" />
+        {k.botJourney}
+        <span>{runs.length}</span>
+      </h3>
+      {ordered.length ? (
+        <ol>
+          {ordered.map((run, index) => {
+            const date = runTime(run.started_at),
+              elapsed = runElapsed(run)
+            return (
+              <li key={`${run.id}:${index}`}>
+                <Avatar name={run.profile || '?'} size="1.5rem" />
+                <div>
+                  <strong>{run.profile || k.botJourneyUnknown}</strong>
+                  <small>
+                    #{run.id} · {run.outcome || run.status}
+                    {elapsed && ` · ${elapsed}`}
+                  </small>
+                  {date ? (
+                    <time dateTime={date.toISOString()}>{date.toLocaleString()}</time>
+                  ) : (
+                    <small>{k.botRunTimeUnknown}</small>
+                  )}
+                </div>
+              </li>
+            )
+          })}
+        </ol>
+      ) : (
+        <p>{k.botJourneyEmpty}</p>
+      )}
+      {runs.length > limit && (
+        <Button size="sm" variant="ghost" onClick={() => setLimit(n => n + 30)}>
+          {k.botMoreRuns}
+        </Button>
+      )}
+      <p className="kanban-current-assignee">
+        {k.botCurrentAssignee}: {assignee || k.botUnassigned}
+      </p>
+    </section>
+  )
+}
diff --git a/apps/desktop/src/plugins/kanban/delivery-revision-view.tsx b/apps/desktop/src/plugins/kanban/delivery-revision-view.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b190a863d8d2a94ccd7d462c3b3fc82d9c09705e
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/delivery-revision-view.tsx
@@ -0,0 +1,173 @@
+import { Button, host } from '@hermes/plugin-sdk'
+import { type ReactNode, useId, useRef, useState } from 'react'
+
+import { fetchRevisionDiff } from './api'
+import type { DeliveryRevision, DeliveryRevisionHistory, RevisionDiff } from './types'
+import { useKanban } from './ui'
+
+export function DeliveryRevisionView({
+  board,
+  id,
+  refreshAction,
+  revision
+}: {
+  board: string
+  id: string
+  refreshAction?: ReactNode
+  revision: DeliveryRevisionHistory
+}) {
+  const r = useKanban().work.revision
+  const [requestId, setRequestId] = useState<number | null>(null)
+  const previous = revision.previous ?? []
+  const selected = previous.find(round => round.request_run_id === requestId) ?? revision
+
+  return (
+    <details className="kanban-revision">
+      <summary>{r.open}</summary>
+      {previous.length > 0 && (
+        <label className="my-2 flex flex-wrap items-center gap-2">
+          {r.chooseRound}
+          <select
+            className="max-w-full rounded border border-border bg-background px-2 py-1"
+            onChange={event => {
+              const next = Number(event.currentTarget.value)
+              setRequestId(next === revision.request_run_id ? null : next)
+            }}
+            value={selected.request_run_id}
+          >
+            {[revision, ...previous].map(round => {
+              const reason = round.reason?.trim().replace(/\s+/g, ' ').replace(/^(.{72}).+/u, '$1…')
+              return (
+                <option key={round.request_run_id} value={round.request_run_id}>
+                  {r.request(round.request_run_id)}
+                  {reason && ` · ${reason}`}
+                </option>
+              )
+            })}
+          </select>
+        </label>
+      )}
+      {revision.history_limited && <p>{r.historyLimited}</p>}
+      <RevisionComparison
+        board={board}
+        id={id}
+        key={`${selected.request_run_id}/${selected.before_run_id}/${selected.after_run_id}`}
+        refreshAction={refreshAction}
+        revision={selected}
+      />
+    </details>
+  )
+}
+
+function RevisionComparison({
+  board,
+  id,
+  refreshAction,
+  revision
+}: {
+  board: string
+  id: string
+  refreshAction?: ReactNode
+  revision: DeliveryRevision
+}) {
+  const w = useKanban().work
+  const r = w.revision
+  const diffTitle = useId()
+  const [selection, setSelection] = useState<{ name: string; result?: RevisionDiff } | null>(null)
+  const requests = useRef(new Map<string, Promise<RevisionDiff>>())
+  const pendingName = selection && !selection.result ? selection.name : undefined
+  const after = revision.after_run_id
+
+  const openDiff = async (name: string) => {
+    if (after === null || pendingName === name) {
+      return
+    }
+
+    const connection = host.activeConnectionId()
+    const pending = { name }
+    setSelection(pending)
+
+    const key = JSON.stringify([connection, board, id, revision.before_run_id, after, name])
+    let request = requests.current.get(key)
+    if (!request) {
+      request = fetchRevisionDiff(id, board, name, revision.before_run_id, after)
+        .catch((): RevisionDiff => ({ status: 'unavailable' }))
+        .finally(() => requests.current.delete(key))
+      requests.current.set(key, request)
+    }
+
+    const result = await request
+    setSelection(current =>
+      current === pending && connection === host.activeConnectionId() ? { name, result } : current
+    )
+  }
+
+  return (
+    <>
+      <p>
+        {r.request(revision.request_run_id)}
+        {revision.reason && ` · ${revision.reason}`}
+      </p>
+      <p>
+        {r.old(revision.before_run_id)} · {after === null ? r.pending : r.current(after)}
+      </p>
+      {revision.brief_changed && <p>{r.briefChanged}</p>}
+      <h3>{w.outputs}</h3>
+      <ul>
+        {revision.files.map(file => (
+          <li key={file.name}>
+            <code>{file.name}</code> · {r.fileStatus[file.status]}
+            {after !== null && ['added', 'changed', 'removed'].includes(file.status) && (
+              <Button
+                aria-busy={pendingName === file.name || undefined}
+                aria-disabled={pendingName === file.name || undefined}
+                aria-label={r.view(file.name)}
+                className="aria-disabled:opacity-60"
+                onClick={() => void openDiff(file.name)}
+                size="sm"
+                variant="ghost"
+              >
+                {r.viewTextDiff}
+              </Button>
+            )}
+          </li>
+        ))}
+      </ul>
+      <div aria-atomic="true" aria-live="polite">
+        {selection && (
+          <>
+            <h4 className="mt-2 font-medium [overflow-wrap:anywhere]" id={diffTitle}><code>{selection.name}</code></h4>
+            {!selection.result && <p>{r.loading}</p>}
+            {selection.result?.status === 'available' && <span className="sr-only">{r.ready}</span>}
+            {selection.result?.status === 'unavailable' && <p>{r.unavailable}</p>}
+            {selection.result?.status === 'stale' && <p>{r.stale}</p>}
+          </>
+        )}
+      </div>
+      {selection?.result?.status === 'stale' && refreshAction}
+      {selection?.result?.status === 'available' && (
+        <pre aria-labelledby={diffTitle} className="kanban-revision-diff" role="region" tabIndex={0}>
+          {selection.result.diff}
+        </pre>
+      )}
+      <h3>{w.criteria}</h3>
+      <ul>
+        {revision.criteria.map(check => (
+          <li key={check.id}>
+            {check.description}
+            <ul>
+              <li>
+                {r.old(revision.before_run_id)} · {check.before ? r.recorded : r.missing}
+              </li>
+              {after !== null && (
+                <li>
+                  {r.current(after)} · {check.after ? r.recorded : r.missing}
+                </li>
+              )}
+            </ul>
+          </li>
+        ))}
+      </ul>
+    </>
+  )
+}
