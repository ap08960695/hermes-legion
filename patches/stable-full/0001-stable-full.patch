+it.each([
+  'proceed failure',
+  'sequence removed',
+  'sequence retained',
+  'proceed retained',
+  'focus moved'
+] as const)(
+  'keeps keyboard focus safe during ACTION confirmation (%s)',
+  async scenario => {
+    const { PlannedActionReview } = await import('./planned-action-review')
+    const task = { ...legacyDetail.task, workspace_kind: 'dir', workspace_path: '/fixture/repo' } as const
+    const onCreated = vi.fn()
+    const onOpen = vi.fn()
+    render(
+      <>
+        <PlannedActionReview
+          onCreated={onCreated}
+          onOpen={onOpen}
+          plan={{
+            actor: 'Developer',
+            steps: [{ id: 'configure', instructions: 'Update configuration.', acceptance: [], write_scope: ['src/config'] }]
+          }}
+          task={task}
+        />
+        <button type="button">Continue</button>
+      </>
+    )
+    fireEvent.click(screen.getByText('Review an ACTION step'))
+    const check = screen.getByRole('button', { name: 'Check declared writes' })
+    fireEvent.click(check)
+    const sequence = await screen.findByRole<HTMLButtonElement>('button', { name: 'Sequence after conflicting cards' })
+    const proceed = screen.getByRole<HTMLButtonElement>('button', { name: 'Proceed' })
+    const failed = scenario === 'proceed failure'
+    const retained = scenario.endsWith('retained')
+    const chosen = scenario.startsWith('proceed') ? proceed : sequence
+    let finish!: () => void
+    rest.mockImplementationOnce(() => new Promise((resolve, reject) => {
+      finish = () => failed ? reject(new Error('Fixture confirmation failed')) : resolve({
+        changed: true,
+        preview: {
+          token: 'fresh-token', actor: 'Developer', paths: ['src/config'],
+          conflicts: retained ? [{
+            task_id: 't_new_peer', title: 'New routing edit', actor: 'Tester',
+            paths: [{ planned: 'src/config', existing: 'src/config/settings.py' }],
+            paths_limited: false
+          }] : [],
+          different_checkout: 0, insufficient_information: 0, scan_limited: false
+        }
+      })
+    }))
+
+    chosen.focus()
+    act(() => {
+      fireEvent.click(chosen)
+      fireEvent.click(chosen)
+      fireEvent.click(failed ? sequence : proceed)
+    })
+    expect(rest.mock.calls.filter(([path]) => path.endsWith('/planned-action'))).toHaveLength(2)
+    expect(rest).toHaveBeenLastCalledWith('/tasks/t_example/planned-action', expect.objectContaining({
+      body: expect.objectContaining({ decision: chosen === proceed ? 'proceed' : 'sequence', token: 'preview-token' })
+    }))
+    expect(chosen.disabled).toBe(false)
+    expect(chosen.getAttribute('aria-disabled')).toBe('true')
+    expect(document.activeElement).toBe(chosen)
+
+    const next = screen.getByRole('button', { name: 'Continue' })
+    if (scenario === 'focus moved') next.focus()
+    await act(async () => finish())
+    if (failed) {
+      await screen.findByText('Fixture confirmation failed')
+      expect(document.activeElement).toBe(proceed)
+    } else if (retained) {
+      await screen.findByRole('button', { name: 'New routing edit' })
+      const notice = screen.getByRole('status')
+      expect(notice.textContent).toMatch(/Review the updated check before confirming/)
+      expect(notice.compareDocumentPosition(chosen) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy()
+      expect(chosen.isConnected).toBe(true)
+      expect(document.activeElement).toBe(check)
+    } else {
+      await screen.findByText('No overlapping declarations found in the checked cards.')
+      expect(sequence.isConnected).toBe(false)
+      expect(document.activeElement).toBe(scenario === 'focus moved' ? next : check)
+    }
+    expect(proceed.getAttribute('aria-disabled')).toBeNull()
+    expect(onCreated).not.toHaveBeenCalled()
+    expect(onOpen).not.toHaveBeenCalled()
+  }
+)
