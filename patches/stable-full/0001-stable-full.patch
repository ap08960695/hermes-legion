+const quote = (value: string) => `'${value.replaceAll("'", "'\\''")}'`
+
+export const SSH_HELPER_ADMITTED = '\x1eHERMES-SSH-ADMITTED-v1\n'
+export const SSH_HELPER_MEMORY_PENDING = '\x1eHERMES-SSH-MEMORY-PENDING-v1\n'
+export const SSH_HELPER_MEMORY_WAIT = '\x1eHERMES-SSH-MEMORY-WAIT-v1\n'
+
+// Runs on the execution host under python -I -S, without importing Hermes.
+export const SSH_MEMORY_OBSERVER = String.raw`
+import re
+
+def linux_available(text):
+ rows = [line for line in text.splitlines() if line.startswith('MemAvailable:')]
+ if len(rows) != 1: return None
+ match = re.fullmatch(r'MemAvailable:\s*([0-9]+)\s+kB\s*', rows[0])
+ if match is None: return None
+ value = int(match[1]) * 1024
+ return value if value < 2**63 else None
+
+def darwin_available(text):
+ page = re.search(r'\(page size of ([0-9]+) bytes\)', text)
+ if page is None: return None
+ size = int(page[1])
+ if size < 4096 or size > 65536 or size & (size-1): return None
+ counts = []
+ for name in ('free', 'inactive'):
+  rows = re.findall(r'^Pages ' + name + r':\s*([0-9]+)\.\s*$', text, re.M)
+  if len(rows) != 1: return None
+  counts.append(int(rows[0]))
+ value = sum(counts) * size
+ return value if value < 2**63 else None
+
+def available_memory(deadline):
+ try:
+  if sys.platform == 'linux':
+   with open('/proc/meminfo', encoding='ascii') as stream:
+    return linux_available(stream.read())
+  if sys.platform == 'darwin':
+   remaining = deadline-time.monotonic()
+   if remaining <= 0: return None
+   result = subprocess.run(['/usr/bin/vm_stat'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                           encoding='ascii', timeout=min(.2, remaining), env={'LC_ALL':'C'})
+   if result.returncode == 0: return darwin_available(result.stdout)
+ except (OSError, ValueError, UnicodeError, subprocess.TimeoutExpired): pass
+ return None
+`.trim()
+
+// stdin carries a length-framed payload, then stays open as the session lease.
+// A stopped child remains unreaped until group cleanup, so its PID/PGID cannot be reused.
+const GUARD = String.raw`
+import fcntl, os, select, signal, stat, subprocess, sys, threading, time
+
+${SSH_MEMORY_OBSERVER}
+
+slot, seconds, command = sys.argv[1:]
+deadline = time.monotonic() + float(seconds)
+stopped = False
+exited = False
+def stop_handler(*_):
+ global stopped
+ stopped = True
+def exit_handler(*_):
+ global exited
+ exited = True
+for sig in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT):
+ signal.signal(sig, stop_handler)
+signal.signal(signal.SIGCHLD, exit_handler)
+proc = None
+code = 125
+
+def read_bytes(size):
+ data = bytearray()
+ while len(data) < size:
+  if stopped or time.monotonic() >= deadline:
+   raise TimeoutError('SSH helper input lease expired')
+  if not select.select([0], [], [], .05)[0]: continue
+  chunk = os.read(0, min(size-len(data), 65536))
+  if not chunk: raise EOFError('SSH helper input lease closed')
+  data.extend(chunk)
+ return bytes(data)
+
+try:
+ expected = os.path.join(os.path.expanduser('~'), '.hermes', 'desktop-ssh', 'helper-slots-v1')
+ if os.path.dirname(slot) != expected or os.path.basename(slot) != '0.lock':
+  raise ValueError('Invalid SSH helper slot')
+ for name in (os.path.dirname(os.path.dirname(expected)), os.path.dirname(expected), expected):
+  st = os.lstat(name)
+  if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
+   raise ValueError('Unsafe SSH helper slot directory')
+ live, held = os.lstat(slot), os.fstat(9)
+ if not stat.S_ISREG(live.st_mode) or (live.st_dev, live.st_ino) != (held.st_dev, held.st_ino) or held.st_uid != os.geteuid() or held.st_mode & 0o077:
+  raise ValueError('Unsafe SSH helper slot')
+ fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
+ os.set_inheritable(9, False)
+ header = bytearray()
+ while len(header) < 32:
+  byte = read_bytes(1)
+  if byte == b'\n': break
+  header.extend(byte)
+ else: raise ValueError('SSH helper input header is too long')
+ if not header.isdigit(): raise ValueError('Invalid SSH helper input length')
+ size = int(header)
+ if size > 32*1024*1024: raise ValueError('SSH helper input is too large')
+ payload = read_bytes(size)
+ # Observer children must not mark the not-yet-started helper as exited.
+ signal.signal(signal.SIGCHLD, signal.SIG_DFL)
+ waiting = False
+ while True:
+  available = available_memory(deadline)
+  if stopped or (select.select([0], [], [], 0)[0] and not os.read(0, 1)):
+   raise EOFError('SSH helper input lease closed')
+  if time.monotonic() >= deadline:
+   print('\x1eHERMES-SSH-MEMORY-WAIT-v1', flush=True)
+   raise TimeoutError('SSH helper did not start: waiting for 512 MiB available memory.')
+  if available is not None and available >= 512*1024*1024: break
+  if not waiting:
+   print('\x1eHERMES-SSH-MEMORY-PENDING-v1', flush=True)
+   waiting = True
+  if select.select([0], [], [], min(.1, max(0, deadline-time.monotonic())))[0]:
+   os.read(0, 1)
+   raise EOFError('SSH helper input lease closed')
+ signal.signal(signal.SIGCHLD, exit_handler)
+ print('\x1eHERMES-SSH-ADMITTED-v1', flush=True)
+ proc = subprocess.Popen(['sh', '-c', command], stdin=subprocess.PIPE, start_new_session=True)
+ def feed():
+  try:
+   proc.stdin.write(payload)
+   proc.stdin.close()
+  except (BrokenPipeError, OSError): pass
+ threading.Thread(target=feed, daemon=True).start()
+ while not exited and not stopped and time.monotonic() < deadline:
+  if select.select([0], [], [], .05)[0]:
+   os.read(0, 1)
+   stopped = True
+ code = 0 if exited else 124
+except (OSError, ValueError, EOFError, TimeoutError) as error:
+ print(str(error), file=sys.stderr)
+finally:
+ if proc is not None:
+  if not exited:
+   try: os.killpg(proc.pid, signal.SIGTERM)
+   except ProcessLookupError: pass
+   grace = time.monotonic() + 1
+   while not exited and time.monotonic() < grace: time.sleep(.01)
+  # The unreaped direct child anchors the process group through the final signal.
+  try: os.killpg(proc.pid, signal.SIGKILL)
+  except ProcessLookupError: pass
+  except PermissionError:
+   # XNU reports EPERM when its remaining group members are all zombies.
+   if sys.platform != 'darwin' or not exited: raise
+  result = proc.wait()
+  if code == 0: code = result if 0 <= result < 255 else 1
+ os.close(9)
+sys.exit(code)
+`.trim()
+
+export function leasedSshExec(command: string, stdinData: string | Buffer | undefined, timeoutMs: number) {
+  const payload = stdinData == null ? Buffer.alloc(0) : Buffer.from(stdinData)
+
+  if (payload.length > 32 * 1024 * 1024) {
+    throw new Error('SSH helper input is too large.')
+  }
+
+  const seconds = Math.max(0.05, (timeoutMs - 1000) / 1000)
+
+  // Acquire on a shell FD before starting Python. The guard inherits that same kernel
+  // lock through cleanup, so reconnects cannot overlap it; empty slot files stay reusable.
+  const remoteCommand =
+    `umask 077; __hs_base="$HOME/.hermes/desktop-ssh/helper-slots-v1"; ` +
+    `for __hs_dir in "$HOME/.hermes" "$HOME/.hermes/desktop-ssh" "$__hs_base"; do ` +
+    `[ ! -L "$__hs_dir" ] || exit 126; mkdir -p "$__hs_dir" || exit 126; done; ` +
+    `if command -v flock >/dev/null 2>&1; then __hs_locker=flock; ` +
+    `elif command -v lockf >/dev/null 2>&1; then __hs_locker=lockf; ` +
+    `else echo 'Remote SSH helpers require flock or lockf.' >&2; exit 126; fi; ` +
+    `while :; do __hs_slot="$__hs_base/0.lock"; ` +
+    `[ ! -L "$__hs_slot" ] || exit 126; exec 9>>"$__hs_slot" || exit 126; ` +
+    `if [ "$__hs_locker" = flock ]; then flock -n -E 75 9; else lockf -s -t 0 9; fi; __hs_rc=$?; ` +
+    `if [ "$__hs_rc" = 0 ]; then ` +
+    `exec python3 -I -S -c ${quote(GUARD)} "$__hs_slot" ${seconds} ${quote(command)}; ` +
+    `fi; [ "$__hs_rc" = 75 ] || exit "$__hs_rc"; sleep .1; done`
+
+  return { command: remoteCommand, stdinData: Buffer.concat([Buffer.from(`${payload.length}\n`), payload]) }
+}
