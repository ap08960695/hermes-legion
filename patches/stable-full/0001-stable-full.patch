+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { GoalEditor, type GoalFormArgs } from './goal-editor'
+afterEach(async () => {
+  cleanup()
+  await new Promise(resolve => setTimeout(resolve, 0))
+})
+const t = (key: string) => key
+const contract = {
+  outcome: '',
+  verification: 'Existing check',
+  constraints: 'Keep quota',
+  boundaries: '',
+  stop_when: ''
+}
+
+describe('native goal form', () => {
+  it('saves one revision-bound intent with the exact chosen skills and no implicit start', async () => {
+    const save = vi.fn(async (_id: string, _args: GoalFormArgs) => {})
+    render(
+      <GoalEditor
+        open
+        sessionId="original-runtime"
+        revision="rev-1"
+        goal={null}
+        busy={false}
+        skills={[{ name: 'offline-review', enabled: true }]}
+        t={t}
+        onSave={save}
+        onClose={vi.fn()}
+      />
+    )
+    fireEvent.change(screen.getByLabelText('title'), { target: { value: 'Finish the UI' } })
+    fireEvent.change(screen.getByLabelText('verification'), { target: { value: 'Tests pass' } })
+    fireEvent.click(screen.getByRole('checkbox', { name: 'offline-review' }))
+    fireEvent.click(screen.getByRole('button', { name: 'save' }))
+    await waitFor(() => expect(save).toHaveBeenCalledTimes(1))
+    expect(save.mock.calls[0]).toEqual([
+      'original-runtime',
+      expect.objectContaining({
+        expected_revision: 'rev-1',
+        title: 'Finish the UI',
+        contract: expect.objectContaining({
+          verification: 'Tests pass',
+          constraints: expect.stringContaining('offline-review')
+        })
+      })
+    ])
+  })
+  it('preserves edits on a refused save and never saves while busy or whitespace-only', async () => {
+    const save = vi.fn(async (_id: string, _args: GoalFormArgs) => {
+      throw new Error('State changed')
+    })
+    const props = {
+      open: true,
+      sessionId: 'original-runtime',
+      revision: 'rev-1',
+      goal: { title: 'Original', status: 'active' as const, contract },
+      skills: [],
+      t,
+      onSave: save,
+      onClose: vi.fn()
+    }
+    const view = render(<GoalEditor {...props} busy />)
+    expect((screen.getByRole('button', { name: 'save' }) as HTMLButtonElement).disabled).toBe(true)
+    fireEvent.change(screen.getByLabelText('title'), { target: { value: 'Owner draft' } })
+    view.rerender(<GoalEditor {...props} busy={false} revision="newer" />)
+    fireEvent.click(screen.getByRole('button', { name: 'save' }))
+    await screen.findByRole('alert')
+    expect((screen.getByLabelText('title') as HTMLInputElement).value).toBe('Owner draft')
+    expect(save.mock.calls[0][1].expected_revision).toBe('rev-1')
+    fireEvent.change(screen.getByLabelText('title'), { target: { value: '   ' } })
+    expect((screen.getByRole('button', { name: 'save' }) as HTMLButtonElement).disabled).toBe(true)
+  })
+  it('contains Ctrl+Enter inside the editor and retains a draft after Escape', () => {
+    const save = vi.fn(async (_id: string, _args: GoalFormArgs) => {}),
+      close = vi.fn(),
+      composerKey = vi.fn()
+    const props = {
+      sessionId: 'original-runtime',
+      revision: 'rev-1',
+      goal: null,
+      busy: false,
+      skills: [],
+      t,
+      onSave: save,
+      onClose: close
+    }
+    const view = render(
+      <div onKeyDown={composerKey}>
+        <GoalEditor {...props} open />
+      </div>
+    )
+    fireEvent.change(screen.getByLabelText('title'), { target: { value: 'Keep my draft' } })
+    fireEvent.keyDown(screen.getByLabelText('title'), { key: 'Enter', ctrlKey: true })
+    expect(composerKey).not.toHaveBeenCalled()
+    expect(save).not.toHaveBeenCalled()
+    fireEvent.keyDown(screen.getByLabelText('title'), { key: 'Escape' })
+    expect(close).toHaveBeenCalledTimes(1)
+    view.rerender(
+      <div onKeyDown={composerKey}>
+        <GoalEditor {...props} open={false} />
+      </div>
+    )
+    view.rerender(
+      <div onKeyDown={composerKey}>
+        <GoalEditor {...props} open />
+      </div>
+    )
+    expect((screen.getByLabelText('title') as HTMLInputElement).value).toBe('Keep my draft')
+  })
+
+  it('requires an explicit completion criterion before saving a new goal', () => {
+    render(
+      <GoalEditor
+        open
+        sessionId="original-runtime"
+        revision="rev-1"
+        goal={null}
+        busy={false}
+        skills={[]}
+        t={t}
+        onSave={vi.fn()}
+        onClose={vi.fn()}
+      />
+    )
+    fireEvent.change(screen.getByLabelText('title'), { target: { value: 'Finish the work' } })
+    expect((screen.getByRole('button', { name: 'save' }) as HTMLButtonElement).disabled).toBe(true)
+  })
+})
+
+it('filters installed skills without losing chosen references or changing permissions', async () => {
+  const save = vi.fn(async (_id: string, _args: GoalFormArgs) => {})
+  render(
+    <GoalEditor
+      open
+      sessionId="original"
+      revision="r1"
+      goal={{ title: 'Goal', status: 'active', contract }}
+      busy={false}
+      skills={[
+        { name: 'offline-review', enabled: true },
+        { name: 'write-docs', enabled: true }
+      ]}
+      t={t}
+      onSave={save}
+      onClose={vi.fn()}
+    />
+  )
+  fireEvent.click(screen.getByRole('checkbox', { name: 'offline-review' }))
+  fireEvent.change(screen.getByRole('textbox', { name: 'searchSkills' }), { target: { value: 'write' } })
+  expect(screen.queryByRole('checkbox', { name: 'offline-review' })).toBeNull()
+  expect(screen.getByRole('checkbox', { name: 'write-docs' })).toBeTruthy()
+  fireEvent.change(screen.getByRole('textbox', { name: 'searchSkills' }), { target: { value: 'missing' } })
+  expect(screen.getByText('noSkillMatches')).toBeTruthy()
+  fireEvent.click(screen.getByRole('button', { name: 'save' }))
+  await waitFor(() => expect(save).toHaveBeenCalledTimes(1))
+  expect(save.mock.calls[0][1].contract.constraints).toContain('offline-review')
+})
diff --git a/apps/desktop/src/app/focus/goal-editor.tsx b/apps/desktop/src/app/focus/goal-editor.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5ae5a7bd285859dde05e7c7bfadbb02af3a38486
--- /dev/null
+++ b/apps/desktop/src/app/focus/goal-editor.tsx
@@ -0,0 +1,249 @@
+import { useId, useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { Dialog, DialogContent, DialogTitle } from '@/components/ui/dialog'
+import { Input } from '@/components/ui/input'
+import { SearchField } from '@/components/ui/search-field'
+import { Textarea } from '@/components/ui/textarea'
+import type { SessionControlGoalContract } from '@/store/session-control'
+
+export interface GoalFormArgs {
+  title: string
+  contract: SessionControlGoalContract
+  expected_revision: string
+}
+interface GoalFormState {
+  title: string
+  contract: SessionControlGoalContract
+  skills: string[]
+}
+interface GoalEditorProps {
+  open: boolean
+  sessionId: string
+  sessionLabel?: string
+  revision: string
+  goal: { title: string; status: string; contract: SessionControlGoalContract } | null
+  skills: readonly { name: string; enabled: boolean }[]
+  skillsLoading?: boolean
+  skillsError?: boolean
+  busy: boolean
+  t: (key: string) => string
+  onSave: (sessionId: string, args: GoalFormArgs) => Promise<void>
+  onClose: () => void
+}
+const SKILL_MARKER = '\n\nPreferred installed skills: '
+function draftFor(goal: GoalEditorProps['goal'], t: GoalEditorProps['t']): GoalFormState {
+  const contract = goal
+    ? { ...goal.contract }
+    : { outcome: '', verification: '', constraints: '', boundaries: t('routine'), stop_when: t('material') }
+  let skills: string[] = []
+  const marker = contract.constraints.lastIndexOf(SKILL_MARKER)
+  if (marker >= 0) {
+    try {
+      const parsed: unknown = JSON.parse(contract.constraints.slice(marker + SKILL_MARKER.length))
+      if (Array.isArray(parsed) && parsed.every(item => typeof item === 'string')) {
+        skills = [...new Set(parsed)]
+        contract.constraints = contract.constraints.slice(0, marker)
+      }
+    } catch {
+      /* A user's prose that resembles the marker remains ordinary prose. */
+    }
+  }
+  return { title: goal?.title ?? '', contract, skills }
+}
+
+/** One pinned session/revision; background snapshots never overwrite an owner's draft. */
+export function GoalEditor({
+  open,
+  sessionId,
+  sessionLabel,
+  revision,
+  goal,
+  skills,
+  skillsLoading,
+  skillsError,
+  busy,
+  t,
+  onSave,
+  onClose
+}: GoalEditorProps) {
+  const [draft, setDraft] = useState(() => draftFor(goal, t))
+  const [baseRevision, setBaseRevision] = useState(revision)
+  const [pending, setPending] = useState(false)
+  const [error, setError] = useState('')
+  const [skillSearch, setSkillSearch] = useState('')
+  const hint = useId(),
+    formId = useId()
+  const blocked =
+    pending || busy || goal?.status === 'done' || !draft.title.trim() || !draft.contract.verification.trim()
+  const setField = (field: keyof SessionControlGoalContract, value: string) =>
+    setDraft(prev => ({ ...prev, contract: { ...prev.contract, [field]: value } }))
+  const selectedNames = new Set(draft.skills)
+  const choices = [
+    ...skills.filter(skill => skill.enabled),
+    ...draft.skills
+      .filter(name => !skills.some(skill => skill.name === name && skill.enabled))
+      .map(name => ({ name, enabled: false }))
+  ]
+  const matchingSkills = choices.filter(skill =>
+    skill.name.toLocaleLowerCase().includes(skillSearch.trim().toLocaleLowerCase())
+  )
+  return (
+    <Dialog
+      open={open}
+      onOpenChange={value => {
+        if (!value && !pending) onClose()
+      }}
+    >
+      <DialogContent aria-describedby={hint} bodyClassName="hermes-focus-goal">
+        <DialogTitle>{t('configure')}</DialogTitle>
+        <p id={hint} className="text-xs text-muted-foreground">
+          {t('quota')}
+        </p>
+        <p className="text-xs text-muted-foreground break-all">
+          {t('source')}: <span title={sessionId}>{sessionLabel || sessionId}</span>
+        </p>
+        <form
+          id={formId}
+          onKeyDown={event => {
+            if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) {
+              event.preventDefault()
+              event.stopPropagation()
+            }
+          }}
+          onSubmit={async event => {
+            event.preventDefault()
+            if (blocked) return
+            setPending(true)
+            setError('')
+            const selected = [...new Set(draft.skills)]
+            const contract = {
+              ...draft.contract,
+              constraints: draft.contract.constraints + (selected.length ? SKILL_MARKER + JSON.stringify(selected) : '')
+            }
+            try {
+              await onSave(sessionId, { title: draft.title.trim(), contract, expected_revision: baseRevision })
+            } catch (failure) {
+              setError(failure instanceof Error ? failure.message : t('saveFailed'))
+            } finally {
+              setPending(false)
+            }
+          }}
+        >
+          <fieldset disabled={pending}>
+            <label>
+              <span>{t('title')} *</span>
+              <Input
+                required
+                aria-label={t('title')}
+                maxLength={4000}
+                value={draft.title}
+                onChange={event => setDraft(prev => ({ ...prev, title: event.target.value }))}
+              />
+            </label>
+            {(['verification', 'boundaries'] as const).map(field => (
+              <label key={field}>
+                <span>
+                  {t(field)}
+                  {field === 'verification' ? ' *' : ''}
+                </span>
+                <Textarea
+                  aria-required={field === 'verification'}
+                  aria-label={t(field)}
+                  maxLength={16000}
+                  rows={2}
+                  value={draft.contract[field]}
+                  onChange={event => setField(field, event.target.value)}
+                />
+              </label>
+            ))}
+            <fieldset>
+              <legend>{t('skills')}</legend>
+              <p>{t('skillsHint')}</p>
+              {skillsLoading ? (
+                <p role="status">{t('loading')}</p>
+              ) : skillsError ? (
+                <p role="status">{t('skillError')}</p>
+              ) : !choices.length ? (
+                <p>{t('noSkills')}</p>
+              ) : null}
+              <div className="hermes-focus-skill-search">
+                <SearchField
+                  aria-label={t('searchSkills')}
+                  placeholder={t('searchSkills')}
+                  value={skillSearch}
+                  onChange={setSkillSearch}
+                  onKeyDown={event => {
+                    if (event.key === 'Enter') event.preventDefault()
+                  }}
+                />
+                <span role="status">
+                  {t('selectedSkills')}: {draft.skills.length}
+                </span>
+              </div>
+              {!matchingSkills.length && choices.length > 0 && <p role="status">{t('noSkillMatches')}</p>}
+              <div className="hermes-focus-skill-grid">
+                {matchingSkills.map(skill => (
+                  <label key={skill.name}>
+                    <input
+                      type="checkbox"
+                      aria-label={skill.name}
+                      checked={selectedNames.has(skill.name)}
+                      disabled={!skill.enabled && !selectedNames.has(skill.name)}
+                      onChange={event =>
+                        setDraft(prev => ({
+                          ...prev,
+                          skills: event.target.checked
+                            ? [...prev.skills, skill.name]
+                            : prev.skills.filter(name => name !== skill.name)
+                        }))
+                      }
+                    />
+                    <span title={skill.name}>{skill.name.replaceAll(/[-_]/g, ' ')}</span>
+                  </label>
+                ))}
+              </div>
+            </fieldset>
+            <details>
+              <summary>{t('moreConditions')}</summary>
+              <div className="hermes-focus-more-conditions">
+                {(['outcome', 'constraints', 'stop_when'] as const).map(field => (
+                  <label key={field}>
+                    <span>{t(field)}</span>
+                    <Textarea
+                      aria-label={t(field)}
+                      maxLength={16000}
+                      rows={2}
+                      value={draft.contract[field]}
+                      onChange={event => setField(field, event.target.value)}
+                    />
+                  </label>
+                ))}
+              </div>
+            </details>
+          </fieldset>
+        </form>
+        {busy && <p role="status">{t('busy')}</p>}
+        {goal?.status === 'done' && <p role="status">{t('completeGoal')}</p>}
+        {error && <p role="alert">{error}</p>}
+        <div className="hermes-focus-goal-footer">
+          <Button
+            variant="ghost"
+            disabled={pending}
+            onClick={() => {
+              setDraft(draftFor(goal, t))
+              setBaseRevision(revision)
+              setError('')
+              onClose()
+            }}
+          >
+            {t('cancel')}
+          </Button>
+          <Button type="submit" form={formId} disabled={blocked}>
+            {t('save')}
+          </Button>
+        </div>
+      </DialogContent>
+    </Dialog>
+  )
+}
