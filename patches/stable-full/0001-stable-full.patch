+import assert from 'node:assert/strict'
+
+import { test, vi } from 'vitest'
+
+import { createConfigQuitGate } from './config-autosave-quit'
+
+test('quit waits for the native save without starting teardown, including reentrant quit', async () => {
+  let pending = true
+  let resolve!: () => void
+  const save = new Promise<void>(done => { resolve = done })
+  const requestQuit = vi.fn()
+  const flush = vi.fn(async () => { await save; pending = false })
+
+  const gate = createConfigQuitGate({
+    queue: { hasPending: () => pending, flush }, holdForActiveWork: () => false,
+    requestQuit, log: vi.fn(), notify: vi.fn()
+  })
+
+  const event = { preventDefault: vi.fn() }
+  assert.equal(gate(event), true)
+  assert.equal(gate(event), true)
+  assert.equal(requestQuit.mock.calls.length, 0)
+  assert.equal(flush.mock.calls.length, 1)
+  resolve()
+  await vi.waitFor(() => assert.equal(requestQuit.mock.calls.length, 1))
+  assert.equal(gate(event), false)
+})
+
+test('failed quit reports without a modal or data loss and a later quit can recover', async () => {
+  let pending = true
+  const requestQuit = vi.fn()
+  const notify = vi.fn(async () => true)
+  const flush = vi.fn().mockRejectedValueOnce(new Error('offline')).mockImplementation(async () => { pending = false })
+
+  const gate = createConfigQuitGate({
+    queue: { hasPending: () => pending, flush }, holdForActiveWork: () => false,
+    requestQuit, log: vi.fn(), notify
+  })
+
+  const event = { preventDefault: vi.fn() }
+  assert.equal(gate(event), true)
+  await vi.waitFor(() => assert.equal(notify.mock.calls.length, 1))
+  assert.equal(requestQuit.mock.calls.length, 0)
+  assert.equal(gate(event), true)
+  await vi.waitFor(() => assert.equal(requestQuit.mock.calls.length, 1))
+  assert.equal(gate(event), false)
+})
