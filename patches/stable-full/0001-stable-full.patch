+"""Auto cache budget must respect both local cgroup memory boundaries."""
+import pytest
+from gateway import agent_cache_pressure as pressure
+from gateway import cgroup_cleanup
+
+@pytest.mark.platforms("linux")
+@pytest.mark.parametrize("high,maximum,expected", [(8,2,2),(2,8,2),(None,2,2),(2,None,2)])
+def test_auto_budget_respects_tighter_local_boundary(monkeypatch, high, maximum, expected):
