index 0000000000000000000000000000000000000000..438d199072adc13faa4ab7558e257e4c42b715ec
--- /dev/null
+++ b/agent/reasoning_limits.py
@@ -0,0 +1,136 @@
+"""Optional owner effort ceilings; no account, prompt, provider or network access."""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from copy import deepcopy
+import re
+
+_LEVELS = ('none', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max', 'ultra')
+_ACTIVE_LIMITS = ContextVar('owner_reasoning_effort_limits', default=None)
+
+
+def configured_limits(config):
+    agent = config.get('agent') if isinstance(config, dict) else None
+    limits = agent.get('reasoning_effort_limits', {}) if isinstance(agent, dict) else {}
+    if not isinstance(limits, dict):
+        raise ValueError('reasoning effort limits must be a model-to-level mapping')
+    return deepcopy(limits)
+
+
+def model_effort_limit(limits, model):
+    from hermes_constants import _canonical_model_variants
+    if not isinstance(limits, dict):
+        raise ValueError('reasoning effort limits must be a model-to-level mapping')
+    if not model or not limits:
+        return None
+    variants = _canonical_model_variants(model)
+    # An exact snapshot rule wins; a dated snapshot otherwise belongs to its alias family.
+    dated = re.fullmatch(r'(.+)-\d{4}-\d{2}-\d{2}', model)
+    if dated:
+        variants += _canonical_model_variants(dated[1])
+    keys = [key for key in variants if key in limits]
+    if not keys:
+        forms = set(variants)
+        keys = [key for key in limits if isinstance(key, str) and '/' in key
+                and forms.intersection(_canonical_model_variants(key.split('/')[-1]))]
+    if not keys:
+        return None
+    value = limits[keys[0]]
+    if not isinstance(value, str) or value not in _LEVELS:
+        raise ValueError('reasoning effort limit must be a supported level')
+    return value
+
+
+def _bounded_level(level, limit):
+    if level not in _LEVELS:
+        raise ValueError('requested effort cannot be compared with the configured effort limit')
+    return _LEVELS[min(_LEVELS.index(level), _LEVELS.index(limit))]
+
+
+def bounded_reasoning(reasoning, limit):
+    if limit is None:
+        return reasoning
+    if isinstance(reasoning, dict) and reasoning.get('enabled') is False:
+        return reasoning
+    requested = reasoning.get('effort') if isinstance(reasoning, dict) else None
+    # With a ceiling, never delegate an omitted level to an unbounded route default.
+    effective = _bounded_level(requested or 'medium', limit)
+    if isinstance(reasoning, dict) and effective == requested:
+        return reasoning
+    result = {**(reasoning or {}), 'enabled': effective != 'none'}
+    if effective != 'none':
+        result['effort'] = effective
+    else:
+        result.pop('effort', None)
+    return result
+
+
+def apply_reasoning_limit(config, model, reasoning):
+    return bounded_reasoning(reasoning, model_effort_limit(configured_limits(config), model))
+
+
+@contextmanager
+def owner_reasoning_limits(limits, *, owner=None):
+    """One owner/turn's metadata policy; thread hops inherit the existing ContextVars binding."""
+    token = _ACTIVE_LIMITS.set((owner, deepcopy(limits)))
+    try:
+        yield
+    finally:
+        _ACTIVE_LIMITS.reset(token)
+
+
+def current_reasoning_limits(captured, *, owner=None):
+    active = _ACTIVE_LIMITS.get()
+    if active is None or (owner is not None and active[0] is not None and active[0] != owner):
+        return captured
+    return active[1]
+
+
+def _limit_container(container, limit):
+    result = dict(container)
+    found = False
+    if 'reasoning_effort' in result:
+        result['reasoning_effort'] = _bounded_level(result['reasoning_effort'], limit)
+        found = True
+    for key in ('reasoning', '_reasoning_config'):
+        value = result.get(key)
+        if isinstance(value, dict):
+            if 'effort' in value:
+                result[key] = {**value, 'effort': _bounded_level(value['effort'], limit)}
+                found = True
+            elif value.get('enabled') is False:
+                found = True
+    return result, found
+
+
+def limit_wire_request(request, limits, model, mode='chat_completions'):
+    """Bound every accepted effort carrier after request overrides, without copying prompt/tool data."""
+    model = request.get('model') or model
+    if isinstance(request.get('extra_body'), dict):
+        model = request['extra_body'].get('model') or model
+    limit = model_effort_limit(limits, model)
+    if limit is None:
+        return request
+    if mode not in ('chat_completions', 'codex_responses'):
+        raise ValueError('reasoning effort limit cannot be enforced on this request wire')
+    result, found = _limit_container(request, limit)
+    if isinstance(request.get('extra_body'), dict):
