+@pytest.mark.platforms("posix")
+def test_dangling_fleet_link_prevents_kanban_dispatch(fleet, tmp_path, monkeypatch):
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    from hermes_cli import kanban_db_dispatch as kbd
+
+    root, _, beta = fleet
+    (root / "ESTOP").symlink_to(tmp_path / "missing-target")
+    monkeypatch.setenv("HERMES_HOME", str(beta))
+    monkeypatch.setattr(kbd, "_profile_exists_fn", lambda: lambda _name: True)
+    monkeypatch.setattr(kbd, "_system_memory_sample", dict)
+    monkeypatch.setattr(kbd, "review_dispatch_enabled", lambda: False)
+    kb.init_db()
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title="waiting", assignee="beta")
+        spawned = []
+        result = kbd.dispatch_once(conn, spawn_fn=lambda *args, **kwargs: spawned.append(args) or 999999)
+        assert result.skipped_paused is True
+        assert not spawned and kb.get_task(conn, tid).status == "ready"
