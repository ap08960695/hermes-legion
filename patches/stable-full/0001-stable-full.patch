+            if not count:raise SpaceConflict('Page changed; refresh before saving')
+        return self.read(sid,iid)
+
+    def remove(self,sid,iid,revision,deleted=True):
+        with self.connection(True) as conn:
+            self.space(conn,sid)
+            count=conn.execute('UPDATE items SET deleted=?,revision=revision+1,updated=? WHERE id=? AND space_id=? AND revision=?',(int(deleted),time.time(),iid,sid,revision)).rowcount
