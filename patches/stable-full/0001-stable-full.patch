+++ b/apps/desktop/electron/character-menu.ts
@@ -0,0 +1,103 @@
+import { type BrowserWindow, ipcMain, Menu, nativeImage, Tray, type WebContents } from 'electron'
+
+import type { CharacterMenuState, CharacterSettings } from './character-menu-types'
+
+export function createCharacterMenu(getPrimary: () => BrowserWindow | null) {
+  let tray: Tray | null = null
+  let state: CharacterMenuState | null = null
+  let refresh: ReturnType<typeof setInterval> | undefined
+  let owner: { contents: WebContents; unwatch: () => void } | undefined
+
+  const clear = () => {
+    owner?.unwatch()
+    owner = undefined
+    state = null
+    clearInterval(refresh)
+    refresh = undefined
+    tray?.destroy()
+    tray = null
+  }
+
+  ipcMain.on('hermes:characters:menu-state', (event, value) => {
+    const window = getPrimary()
+
+    if (!window || window.isDestroyed()) {return}
+    const contents = window.webContents
+
+    if (event.sender !== contents || !event.senderFrame || event.senderFrame !== contents.mainFrame) {return}
+    if (value === null) {clear(); return}
+
+    if (!value || typeof value.scope !== 'string' || value.scope.length > 512 || typeof value.enabled !== 'boolean' ||
+        (value.size !== 'small' && value.size !== 'medium' && value.size !== 'large')) {return}
+
+    if (owner?.contents !== contents) {
+      clear()
+      const watched = {
+        contents,
+        unwatch: () => {
+          if (!contents.isDestroyed()) {
+            contents.removeListener('did-navigate', lost)
+            contents.removeListener('render-process-gone', lost)
+            contents.removeListener('destroyed', lost)
+          }
+        }
+      }
+      const lost = () => {if (owner === watched) {clear()}}
+
+      owner = watched
+      // did-navigate is a committed main-frame load, excluding hash/history updates.
+      contents.on('did-navigate', lost)
+      contents.on('render-process-gone', lost)
+      contents.on('destroyed', lost)
+    }
+
+    const watched = owner
+    const next: CharacterMenuState = { scope: value.scope, enabled: value.enabled, size: value.size }
+    state = next
+    // A minimized Chromium renderer can throttle timers beyond the preview lease.
+    if (next.enabled && refresh === undefined) {
+      refresh = setInterval(() => {
+        if (owner !== watched) {return}
+
+        if (getPrimary() !== window || window.isDestroyed() || contents.isDestroyed()) {
+          clear()
+
+          return
+        }
+        if (state?.enabled && window.isMinimized()) {
+          contents.send('hermes:characters:menu-refresh', state.scope)
+        }
+      }, 5_000)
+    } else if (!next.enabled) {
+      clearInterval(refresh)
+      refresh = undefined
+    }
+
+    const isCurrent = () => owner === watched && state === next && getPrimary() === window && !contents.isDestroyed()
+    const send = (change: Partial<CharacterSettings>) => {
+      if (isCurrent()) {
+        contents.send('hermes:characters:menu-action', { scope: next.scope, change })
+      }
+    }
+
+    if (!tray) {
+      tray = new Tray(nativeImage.createEmpty())
+      tray.setTitle('Characters')
+      tray.setToolTip('Hermes desktop Characters')
+    }
+
+    tray.setContextMenu(Menu.buildFromTemplate([
+      { label: 'Show Characters', type: 'checkbox', checked: next.enabled, click: item => send({ enabled: item.checked }) },
+      { type: 'separator' },
+      { label: 'Small', type: 'radio', checked: next.size === 'small', click: () => send({ size: 'small' }) },
+      { label: 'Medium', type: 'radio', checked: next.size === 'medium', click: () => send({ size: 'medium' }) },
+      { label: 'Large', type: 'radio', checked: next.size === 'large', click: () => send({ size: 'large' }) },
+      { type: 'separator' },
+      { label: 'Refresh Characters', enabled: next.enabled, click: () => {
+        if (next.enabled && isCurrent()) {contents.send('hermes:characters:menu-refresh', next.scope, true)}
+      } }
+    ]))
+  })
+
+  return { clear }
+}
