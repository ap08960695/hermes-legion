@@ -0,0 +1,29 @@
+"""Summary prompt keeps a long static prefix ahead of the variable transcript so provider prefix
+caching can hit across compression calls."""
+
+import os
+from unittest.mock import patch
+
+from agent.context_compressor import ContextCompressor
+
+
+def _prompt(compressor, transcript, budget, previous=None):
+    compressor._previous_summary = previous
+    return compressor._build_summary_prompt(transcript, budget, None, "", True)
+
+
+def test_static_prefix_is_identical_and_precedes_transcript():
+    with patch("agent.context_compressor.get_model_context_length", return_value=100000):
+        compressor = ContextCompressor(model="test", quiet_mode=True)
+    for previous in (None, "PREV-SUMMARY-BODY"):
+        a = _prompt(compressor, "[USER]: alpha transcript", 900, previous)
+        b = _prompt(compressor, "[USER]: totally different beta", 4321, previous and "other summary")
+        prefix = os.path.commonprefix([a, b])
+        # The whole section template (static) is in the shared prefix; variable data comes after it.
+        assert "## Critical Context" in prefix and "## Goal" in prefix
+        assert len(prefix) > 4000
+        assert "alpha" not in prefix and "PREV-SUMMARY-BODY" not in prefix
+        assert a.index("## Critical Context") < a.index("[USER]: alpha transcript")
+        # Per-call budget stays out of the prefix and the closing instruction is still last.
+        assert a.index("[USER]: alpha transcript") < a.index("Target ~")
+        assert a.rstrip().endswith("Do not include any preamble or prefix.")
