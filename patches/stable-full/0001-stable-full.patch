+"""Single-use native refs, exact stdin and conservative action results."""
+import json
+from types import SimpleNamespace
+
+import pytest
+
+
+def observation():
+    return {'version': '2.6', 'ok': True, 'command': 'snapshot', 'data': {
+        'app': 'Fixture', 'complete': True, 'snapshot_id': 'observe', 'ref_count': 2,
+        'window': {'id': 'w-1', 'title': 'Fixture'}, 'tree': {
+            'role': 'window', 'name': 'Fixture', 'children': [
+                {'role': 'button', 'name': 'Activate', 'ref_id': '@observe:e1', 'available_actions': ['Click']},
+                {'role': 'textfield', 'name': 'Input', 'ref_id': '@observe:e2', 'available_actions': ['SetValue']}]}}}
+
+
+def completed(command):
+    return SimpleNamespace(returncode=0, stdout=json.dumps({'version': '2.6', 'ok': True, 'command': command,
+        'data': {'action': command, 'disposition': {'delivery': 'delivered_unverified', 'retry': 'unsafe'},
+                 'post_state': {'value': 'PRIVATE_DRIVER_OUTPUT'}}}), stderr='PRIVATE_DRIVER_OUTPUT')
+
+
+@pytest.fixture
+def controls(monkeypatch):
+    from tools.computer_use import agent_desktop_backend as module
+    calls, state = [], {}
+    monkeypatch.setattr(module.driver, 'resolve_agent_desktop', lambda **k: '/fixture/agent-desktop')
+    monkeypatch.setattr(module.driver, '_environment', lambda: {'SAFE': 'yes'})
+    def probe(argv, **kwargs):
+        calls.append((argv, kwargs))
+        if argv[1] == 'snapshot':
+            return state.get('capture', SimpleNamespace(returncode=0, stdout=json.dumps(observation())))
+        if 'action' in state:
+            value = state['action']
+            return value() if callable(value) else value
+        return completed(argv[1])
+    monkeypatch.setattr(module.driver, 'bounded_probe_run', probe)
+    backend = module.AgentDesktopBackend()
+    backend.start()
+    cap = backend.capture(mode='ax', app='Fixture')
+    return module, backend, calls, state, cap
+
+
+def test_semantic_click_consumes_all_refs_and_never_claims_effect(controls):
+    _, backend, calls, _, cap = controls
+    result = backend.click(element=cap.elements[1].index)
+    assert result.ok and result.action == 'click' and result.verified is None
+    assert result.meta['recapture_required'] is True and result.path == 'ax'
+    assert 'PRIVATE_DRIVER_OUTPUT' not in str(result)
+    argv, kwargs = calls[-1]
+    assert argv[:3] == ['/fixture/agent-desktop', 'click', '@observe:e1']
+    assert '--session' in argv and '--headed' not in argv and '--screenshot' not in argv
+    assert kwargs == {'timeout': 10, 'env': {'SAFE': 'yes'}}
+    again = backend.set_value('not delivered', element=cap.elements[2].index)
+    assert not again.ok and again.code == 'capture_required' and len(calls) == 2
+
+
+@pytest.mark.parametrize('value', ['', 'private value\n\r\nก', 'ก' * 43690 + 'ab'])
+def test_value_uses_exact_utf8_stdin_without_argument_or_result_echo(controls, value):
+    _, backend, calls, _, cap = controls
+    result = backend.set_value(value, element=cap.elements[2].index)
+    assert result.ok and result.action == 'set_value' and result.verified is None
+    argv, kwargs = calls[-1]
+    assert argv[:3] == ['/fixture/agent-desktop', 'set-value', '@observe:e2']
+    assert '--stdin' in argv and kwargs['input'] == value.encode('utf-8')
+    if value:
+        assert value not in str(argv) and value not in result.message
+    assert 'PRIVATE_DRIVER_OUTPUT' not in str(result)
+
+
+@pytest.mark.parametrize('value', [None, b'bytes', '\x00', '\ud800', 'ก' * 43691])
+def test_invalid_values_are_rejected_before_spawn(controls, value):
+    _, backend, calls, _, cap = controls
+    result = backend.set_value(value, element=cap.elements[2].index)
+    assert not result.ok and len(calls) == 1
+
+
+@pytest.mark.parametrize('kwargs', [{'x': 1, 'y': 1}, {'button': 'right'}, {'click_count': 2},
+                                   {'click_count': True}, {'modifiers': ['shift']},
+                                   {'delivery_mode': 'foreground'}, {'bring_to_front': True}])
+def test_nonsemantic_click_forms_never_spawn(controls, kwargs):
+    _, backend, calls, _, cap = controls
+    result = backend.click(element=cap.elements[1].index, **kwargs)
+    assert not result.ok and len(calls) == 1
+
+
+def test_static_nodes_wrong_actions_and_boolean_indices_have_no_authority(controls):
+    _, backend, calls, _, cap = controls
+    assert not backend.click(element=cap.elements[0].index).ok
+    cap = backend.capture(mode='ax', app='Fixture')
+    assert not backend.set_value('value', element=cap.elements[1].index).ok
+    cap = backend.capture(mode='ax', app='Fixture')
+    assert not backend.click(element=True).ok
+    assert all(call[0][1] == 'snapshot' for call in calls)
+
+
+def test_replacement_capture_and_restart_never_rebind_old_indices(controls):
+    _, backend, calls, _, old = controls
+    fresh = backend.capture(mode='ax', app='Fixture')
+    assert {e.index for e in old.elements}.isdisjoint(e.index for e in fresh.elements)
+    assert not backend.click(element=old.elements[1].index).ok
+    fresh = backend.capture(mode='ax', app='Fixture')
+    backend.stop()
+    backend.start()
+    restarted = backend.capture(mode='ax', app='Fixture')
+    assert {e.index for e in fresh.elements}.isdisjoint(e.index for e in restarted.elements)
+    assert not backend.click(element=fresh.elements[1].index).ok
+    assert all(c[0][1] == 'snapshot' for c in calls)
+
+
+def test_failed_recapture_invalidates_previous_refs(controls):
+    _, backend, calls, state, old = controls
+    state['capture'] = None
+    with pytest.raises(RuntimeError):
+        backend.capture(mode='ax', app='Fixture')
+    assert not backend.click(element=old.elements[1].index).ok
+    assert len(calls) == 2
+
+
+@pytest.mark.parametrize('native', [None, SimpleNamespace(returncode=1, stdout='PRIVATE_DRIVER_OUTPUT'),
+    SimpleNamespace(returncode=0, stdout='PRIVATE_DRIVER_OUTPUT'),
+    SimpleNamespace(returncode=0, stdout=json.dumps({'version': '2.6', 'ok': False, 'command': 'click',
+        'error': {'message': 'PRIVATE_DRIVER_OUTPUT', 'disposition': {'delivery': 'delivery_uncertain'}}})),
+    completed('different-command')])
+def test_failed_or_uncertain_native_attempts_never_retry_and_require_capture(controls, native):
+    _, backend, calls, state, cap = controls
+    state['action'] = native
+    result = backend.click(element=cap.elements[1].index)
+    assert not result.ok and result.meta['recapture_required'] is True
+    assert 'PRIVATE_DRIVER_OUTPUT' not in str(result)
+    assert not backend.click(element=cap.elements[1].index).ok
+    assert len(calls) == 2
+
+
+def test_probe_exception_and_cancellation_leave_refs_consumed(controls):
+    _, backend, calls, state, cap = controls
+    def failed():
+        raise OSError('PRIVATE_DRIVER_OUTPUT')
+    state['action'] = failed
+    result = backend.click(element=cap.elements[1].index)
+    assert not result.ok and 'PRIVATE_DRIVER_OUTPUT' not in str(result)
+    cap = backend.capture(mode='ax', app='Fixture')
+    def cancelled():
+        raise KeyboardInterrupt
+    state['action'] = cancelled
+    with pytest.raises(KeyboardInterrupt):
+        backend.click(element=cap.elements[1].index)
+    assert not backend.click(element=cap.elements[1].index).ok
+    assert len(calls) == 4
+
+
+def test_concurrent_inputs_cannot_reuse_one_capture(controls):
+    _, backend, calls, state, cap = controls
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Event
+    started, release = Event(), Event()
+    def delayed():
+        started.set()
+        assert release.wait(3)
+        return completed('click')
+    state['action'] = delayed
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        first = pool.submit(backend.click, element=cap.elements[1].index)
+        try:
+            assert started.wait(2)
+            second = pool.submit(backend.click, element=cap.elements[1].index)
+        finally:
+            release.set()
+        assert sorted([first.result(timeout=3).ok, second.result(timeout=3).ok]) == [False, True]
+    assert len(calls) == 2
+
+
+def test_human_handoff_and_placement_change_invalidate_input(controls, monkeypatch):
+    _, backend, calls, _, cap = controls
+    from tools.bot_desktop import lease, placement
+    epoch = lease.assert_agent_may_act().epoch
+    monkeypatch.setattr(lease, 'assert_agent_may_act', lambda: SimpleNamespace(epoch=epoch + 1))
+    assert not backend.click(element=cap.elements[1].index).ok
+    cap = backend.capture(mode='ax', app='Fixture')
+    monkeypatch.setattr(placement, 'resolve', lambda: SimpleNamespace(where='terminal'))
+    assert not backend.set_value('value', element=cap.elements[2].index).ok
+    assert len(calls) == 2
+
+
+def test_common_tool_keeps_approval_and_recapture_verdict(controls, monkeypatch):
+    _, _, calls, _, _ = controls
+    from hermes_cli import config
+    from tools.computer_use import tool
+    monkeypatch.setattr(config, 'load_config_readonly', lambda: {'computer_use': {'backend': 'agent-desktop'}})
+    approvals = []
+    monkeypatch.setattr(tool, '_request_approval', lambda scope, args: approvals.append(scope))
+    tool.reset_backend_for_tests()
+    try:
+        cap = json.loads(tool.handle_computer_use({'action': 'capture', 'mode': 'ax', 'app': 'Fixture'}, session_id='actions'))
+        idx = next(e['index'] for e in cap['elements'] if e['label'] == 'Activate')
+        result = json.loads(tool.handle_computer_use({'action': 'click', 'element': idx, 'app': 'Fixture'}, session_id='actions'))
+        assert result['ok'] and result['verdict']['decision'] == 'verify_fresh_state' and approvals == ['click']
+        again = json.loads(tool.handle_computer_use({'action': 'click', 'element': idx}, session_id='actions'))
+        assert not again['ok'] and again['verdict']['decision'] == 'verify_fresh_state'
+        assert 'delivered' not in again['verdict']['hint'].lower()
+        assert len([c for c in calls if c[0][1] == 'click']) == 1
+    finally:
+        tool.reset_backend_for_tests()
+
+
+def test_pending_approved_index_cannot_rebind_after_another_capture(controls, monkeypatch):
+    _, _, calls, _, _ = controls
+    from hermes_cli import config
+    from tools.computer_use import tool
+    from concurrent.futures import ThreadPoolExecutor
+    from contextvars import copy_context
+    from threading import Event
+    pending, resume = Event(), Event()
+    monkeypatch.setattr(config, 'load_config_readonly', lambda: {'computer_use': {'backend': 'agent-desktop'}})
+    def approve(scope, args):
+        pending.set()
+        assert resume.wait(3)
+    monkeypatch.setattr(tool, '_request_approval', approve)
+    tool.reset_backend_for_tests()
+    try:
+        first = json.loads(tool.handle_computer_use({'action': 'capture', 'mode': 'ax', 'app': 'Fixture'}, session_id='pending'))
+        old = next(e['index'] for e in first['elements'] if e['label'] == 'Activate')
+        with ThreadPoolExecutor(max_workers=1) as pool:
+            future = pool.submit(copy_context().run, tool.handle_computer_use, {'action': 'click', 'element': old}, session_id='pending')
+            try:
+                assert pending.wait(2)
+                fresh = json.loads(tool.handle_computer_use({'action': 'capture', 'mode': 'ax', 'app': 'Fixture'}, session_id='pending'))
+                assert old not in {e['index'] for e in fresh['elements']}
+            finally:
+                resume.set()
+            result = json.loads(future.result(timeout=3))
+        assert not result['ok'] and result['code'] == 'capture_required'
+        assert all(c[0][1] == 'snapshot' for c in calls)
+    finally:
+        resume.set()
+        tool.reset_backend_for_tests()
+
+
+def test_denied_approval_and_wrong_app_never_dispatch(controls, monkeypatch):
+    _, _, calls, _, _ = controls
+    from hermes_cli import config
