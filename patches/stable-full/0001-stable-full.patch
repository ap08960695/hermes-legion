+"""Bounded SQLite-blob streaming of text parts in stored multimodal JSON."""
+
+from hermes_state_blob_reader import SQLiteBlobReader
+
+import base64
+import codecs
+from collections import OrderedDict
+import json
+import re
+import time
+
+_STOP = re.compile(rb'["\\\x00-\x1f]')
+_NUMBER = re.compile(rb"-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\Z")
+_HEX = frozenset(b"0123456789abcdefABCDEF")
+_ASCII_LOWER = str.maketrans("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")
+_RAW_ONLY = re.compile(r"[\x00\ud800-\udfff]")
+
+
+class InvalidJSON(ValueError):
+    pass
+
+
+class UnsupportedJSON(ValueError):
+    pass
+
+
+class Cursor:
+    def __init__(self, blob, start=0, deadline=None, chunk_size=65536):
+        self.blob, self.deadline, self.chunk_size = blob, deadline, chunk_size
+        self.buf, self.pos, self.base = b"", 0, start
+        blob.seek(start)
+
+    def _fill(self):
+        if self.pos < len(self.buf):
+            return True
+        if self.deadline is not None and time.monotonic() >= self.deadline:
+            raise TimeoutError("structured session search timed out")
+        self.base += self.pos
+        self.buf, self.pos = self.blob.read(self.chunk_size), 0
+        return bool(self.buf)
+
+    def tell(self):
+        return self.base + self.pos
+
+    def peek(self):
+        return self.buf[self.pos] if self._fill() else None
+
+    def get(self):
+        value = self.peek()
+        if value is None:
+            raise InvalidJSON("unexpected end of JSON")
+        self.pos += 1
+        return value
+
+    def ws(self):
+        while self.peek() in (9, 10, 13, 32):
+            self.pos += 1
+
+    def expect(self, value):
+        if self.get() != value:
+            raise InvalidJSON("unexpected JSON token")
+
+    def string(self):
+        self.expect(34)
+        start = self.tell()
+        decoder = codecs.getincrementaldecoder("utf-8")("strict")
+        while self._fill():
+            hit = _STOP.search(self.buf, self.pos)
+            end = hit.start() if hit else len(self.buf)
+            try:
+                decoder.decode(self.buf[self.pos : end], final=False)
+            except UnicodeDecodeError as exc:
+                raise InvalidJSON("invalid UTF-8") from exc
+            self.pos = end
+            if hit is None:
+                continue
+            symbol = self.get()
+            if symbol == 34:
+                try:
+                    decoder.decode(b"", final=True)
+                except UnicodeDecodeError as exc:
+                    raise InvalidJSON("invalid UTF-8") from exc
+                return start, self.tell() - 1
+            if symbol != 92:
+                raise InvalidJSON("unescaped control character")
+            try:
+                decoder.decode(b"", final=True)
+            except UnicodeDecodeError as exc:
+                raise InvalidJSON("invalid UTF-8") from exc
+            decoder = codecs.getincrementaldecoder("utf-8")("strict")
+            escaped = self.get()
+            if escaped == 117:
+                if any(self.get() not in _HEX for _ in range(4)):
+                    raise InvalidJSON("invalid unicode escape")
+            elif escaped not in b'"\\/bfnrt':
+                raise InvalidJSON("invalid string escape")
