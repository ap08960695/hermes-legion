+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import type { HermesApiRequest } from '../../shared/src/api-request'
+
+import { createConfigAutosaveQueue } from './config-autosave'
+
+test.each([
+  [[], { provider: 'auto' }],
+  [false, { provider: 'auto' }],
+  ['reset', { provider: 'auto' }],
+  [23, { provider: 'auto' }],
+  [[], null],
+  [false, null],
+  ['reset', null],
+  [23, null]
+])('preserves a replacement followed by a mapping or null: %j then %j', async (first, last) => {
+  const requests: HermesApiRequest[] = []
+
+  const dispatch = async (request: HermesApiRequest) => {
+    requests.push(request)
+
+    return { ok: true }
+  }
+
+  const queue = createConfigAutosaveQueue(dispatch, () => ({ key: 'home', send: dispatch }))
+  const patches = [first, last].map(vision => ({ auxiliary: { vision } }))
+
+  const writes = patches.map(config => queue.run({
+    path: '/api/config', method: 'PUT', body: { config }, configAutosave: true
+  }))
+
+  await queue.flush()
+  await Promise.all(writes)
+  // Sending only the last mapping/null would merge with (or ignore) the old
+  // on-disk mapping, reviving fields removed by the preceding replacement.
+  assert.deepEqual(requests.map(request => request.body), patches.map(config => ({ config })))
+  assert.equal(queue.hasPending(), false)
+})
