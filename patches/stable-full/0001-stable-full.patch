+import { ExternalLink } from '@/lib/external-link'
+
+import { RichCodeBlock } from './registry'
+import type { RichFenceProps } from './types'
+
+function isEmbeddedImage(url: string) {
+  return /^data:/i.test(url)
+}
+
+interface AnswerCardViewProps {
+  card: AnswerCard
+  externalImages: string[]
+}
+
+function AnswerCardView({ card, externalImages }: AnswerCardViewProps) {
+  const { t } = useI18n()
+  const id = useId()
+  const [externalImagesAllowed, setExternalImagesAllowed] = useState(false)
+  const hosts = [...new Set(externalImages.map(url => new URL(url).hostname))]
+  const visibleImages = card.images.flatMap((url, index) =>
+    externalImagesAllowed || isEmbeddedImage(url) ? [{ url, index }] : []
+  )
+
+  return (
+    <article className="flex min-w-0 flex-col gap-4 @sm:flex-row">
+      {card.images.length === 1 && visibleImages.length === 1 && (
+        <div className="h-32 w-32 max-w-full shrink-0 overflow-hidden rounded-xl border border-(--ui-stroke-tertiary) bg-(--ui-bg-quinary)">
+          <ZoomableImage
+            alt={card.title}
+            className="h-32 w-32 max-w-full object-contain"
+            decoding="async"
+            loading="lazy"
+            src={visibleImages[0].url}
+          />
+        </div>
+      )}
+      <div className="min-w-0 flex-1">
+        <h3 className="text-sm font-semibold leading-6" id={`${id}-title`}>
+          {card.title}
+        </h3>
+        {card.price && <p className="mt-1 text-2xl font-semibold tabular-nums">{card.price}</p>}
+        {card.description && <p className="mt-2 text-sm leading-6 text-(--ui-text-secondary)">{card.description}</p>}
+        {card.facts.length > 0 && <p className="mt-2 text-xs text-muted-foreground">{card.facts.join(' · ')}</p>}
+        {card.mermaid && (
+          <div className="mt-3">
+            <RichCodeBlock
+              code={card.mermaid}
+              fallback={<pre className="overflow-auto whitespace-pre-wrap">{card.mermaid}</pre>}
+              language="mermaid"
+            />
+          </div>
+        )}
+        {hosts.length > 0 && !externalImagesAllowed && (
+          <div className="mt-3 flex flex-wrap items-center gap-2">
+            <div className="min-w-0 text-xs text-muted-foreground" id={`${id}-external-images`}>
+              <p>
+                {t.artifacts.tabImages} ({externalImages.length})
+              </p>
+              <ul className="flex list-none flex-wrap gap-x-2 p-0">
+                {hosts.map(host => (
+                  <li key={host}>
+                    <bdi>{host}</bdi>
+                  </li>
+                ))}
+              </ul>
+            </div>
+            <Button
+              aria-describedby={`${id}-title ${id}-external-images`}
+              className="max-w-full whitespace-normal"
+              onClick={() => setExternalImagesAllowed(true)}
+              size="sm"
+              type="button"
+              variant="outline"
+            >
+              {t.preview.previewAnyway}
+            </Button>
+          </div>
+        )}
+        {card.images.length > 1 && visibleImages.length > 0 && (
+          <div className="mt-3 grid grid-cols-[repeat(auto-fit,minmax(min(130px,100%),1fr))] gap-2">
+            {visibleImages.map(({ url, index }) => (
+              <ZoomableImage
+                alt={`${card.title} ${index + 1}`}
+                className="h-40 w-full rounded-xl border border-(--ui-stroke-tertiary) bg-(--ui-bg-quinary) object-contain"
+                decoding="async"
+                key={index}
+                loading="lazy"
+                src={url}
+              />
+            ))}
+          </div>
+        )}
+        {card.sources.length > 0 && (
+          <div className="mt-3 flex flex-wrap gap-2">
+            {card.sources.map(source => (
+              <ExternalLink
+                className="inline-flex items-center gap-1.5 rounded-full bg-(--ui-bg-quaternary) px-2.5 py-1 text-[11px] text-(--ui-text-secondary)"
+                href={source.url}
+                key={source.url}
+                title={source.url}
+              >
+                <Codicon name="globe" size="0.75rem" />
+                {source.title}
+              </ExternalLink>
+            ))}
+          </div>
+        )}
+      </div>
+    </article>
+  )
+}
+
+/** Native answer cards: explicit supplied data, never an executable document. */
+export default function AnswerCards({ code, streaming }: RichFenceProps) {
+  const { t } = useI18n()
+  if (streaming)
+    {return (
+      <p className="text-xs text-muted-foreground" role="status">
+        {t.preview.loading}
+      </p>
+    )}
+  const cards = parseAnswerCards(code)
+  if (!cards.length) {throw new Error('cards: no complete presentation data')}
+  return (
+    <div
+      className="@container not-prose my-5 grid min-w-0 gap-5 wrap-anywhere text-(--ui-text-primary)"
+      data-slot="answer-cards"
+    >
+      {cards.map((card, index) => {
+        const externalImages = card.images.filter(url => !isEmbeddedImage(url))
+
+        // Consent applies only to these URLs on this card.
+        return (
+          <AnswerCardView card={card} externalImages={externalImages} key={JSON.stringify([index, externalImages])} />
+        )
+      })}
+    </div>
+  )
+}
