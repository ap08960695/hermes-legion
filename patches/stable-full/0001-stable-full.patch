+"""Persistent memo keeps the existing search semantics across processes/profiles."""
+import pytest
+
+from tools import web_result_cache as cache
+from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+
+
+def test_separate_memos_reuse_success_without_mutation_and_respect_profiles(tmp_path,monkeypatch):
+    monkeypatch.setattr(cache,'_web_config',dict)
+    a=cache.SearchMemo(); b=cache.SearchMemo()
+    value={'success':True,'data':{'web':[{'title':'result'}]*10}}
+    a.store('fixture','some query',5,value)
+    hit=b.lookup_slice('fixture',' SOME   QUERY ',5)
+    assert hit is not None and len(hit['data']['web'])==5
+    hit['data']['web'][0]['title']='changed'
+    assert b.lookup('fixture','some query',5)['data']['web'][0]['title']=='result'
+    token=set_hermes_home_override(tmp_path/'another')
+    try:
+        assert b.lookup('fixture','some query',5) is None
+    finally:
+        reset_hermes_home_override(token)
+
+
+def test_expired_disabled_and_failed_searches_are_not_reused(monkeypatch):
+    from tools import web_search_disk_cache as disk
+    monkeypatch.setattr(cache,'_web_config',dict)
+    a=cache.SearchMemo(); b=cache.SearchMemo()
+    a.store('fixture','q',5,{'success':False,'error':'no'})
+    assert b.lookup('fixture','q',5) is None
+    a.store('fixture','q',5,{'success':True,'data':{'web':[]}})
+    now=disk.time.time()
+    monkeypatch.setattr(disk.time,'time',lambda:now+1201)
+    assert b.lookup('fixture','q',5) is None
+    monkeypatch.setattr(cache,'cache_enabled',lambda:False)
+    assert a.lookup('fixture','q',5) is None
+
+
+def test_parallel_processes_share_one_vendor_result(tmp_path):
+    import os
+    import subprocess
+    import sys
+    from pathlib import Path
+    code='''
+from tools import web_result_cache as c
+from pathlib import Path
+import sys
+c._web_config=lambda: {}
+m=c.SearchMemo()
+with m.process_flight('offline-fixture','q',5):
+    hit=m.lookup('offline-fixture','q',5)
+    if hit is None:
+        with (Path(sys.argv[1])/'vendor-count').open('a') as f: f.write('call\\n')
+        m.store('offline-fixture','q',5,{'success':True,'data':{'web':[{'title':'same'}]}})
+    assert m.lookup('offline-fixture','q',5)['success']
+'''
+    env={**os.environ,'HERMES_HOME':str(tmp_path/'owner'),'PYTHONPATH':str(Path.cwd())}
+    children=[subprocess.Popen([sys.executable,'-c',code,str(tmp_path)],env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE) for _ in range(4)]
+    for child in children:
+        _stdout,stderr=child.communicate(timeout=15)
+        assert child.returncode==0,stderr.decode()
+    assert (tmp_path/'vendor-count').read_text().splitlines()==['call']
+
+
+def test_busy_flight_cannot_call_provider_or_fallback(monkeypatch):
+    import pytest
+    from types import SimpleNamespace
+    from contextlib import contextmanager
+    from tools import web_search_disk_cache as disk, web_tools
+    from tools.cache_file_lock import CacheLockBusy
+    from unittest.mock import Mock
+    @contextmanager
+    def busy(*args):
+        raise CacheLockBusy('already running')
+        yield
+    monkeypatch.setattr(cache,'_web_config',dict)
+    monkeypatch.setattr(disk,'cache_file_lock',busy)
+    provider=SimpleNamespace(name='offline-only',search=Mock())
+    with pytest.raises(CacheLockBusy):
+        web_tools._memoized_search(provider,'new search',5)
+    provider.search.assert_not_called()
+
+
+@pytest.mark.parametrize('at,hit', [
+    (10**400, False), (-10**400, False), (1999999999.0, True),
+    (1999998800.0, False), (1999998799.0, False), (2000000001.0, False),
+    (float('inf'), False), (-float('inf'), False), (float('nan'), False),
+    (None, False), ('invalid', False), ('missing', False),
+], ids=['overflow-positive', 'overflow-negative', 'fresh', 'ttl-boundary', 'expired',
+        'future', 'infinity', 'negative-infinity', 'nan', 'null', 'invalid', 'missing'])
+def test_disk_timestamp_miss_keeps_cache_bytes_and_healthy_keys(monkeypatch, at, hit):
+    import json
+    import os
+    from tools import web_search_disk_cache as disk
+
+    clock = 2000000000.0
+    monkeypatch.setattr(cache, '_web_config', dict)
+    monkeypatch.setattr(disk.time, 'time', lambda: clock)
+    root = disk._root()
+    key = cache.SearchMemo._key('offline-fixture', 'timestamp fixture', 5)
+    other = cache.SearchMemo._key('offline-fixture', 'healthy fixture', 5)
+    response = {'success': True, 'data': {'web': [{'title': 'synthetic cached result'}]}}
+    for identity, timestamp in ((key, at), (other, clock - 1)):
+        path = root / (disk._key(identity) + '.txt')
+        value = {'response': response}
+        if timestamp != 'missing':
+            value['at'] = timestamp
+        path.write_text(json.dumps(value))
+        path.chmod(0o600)
+        os.utime(path, (clock, clock))
+    before = {p.name: p.read_bytes() for p in root.glob('*.txt')}
+    assert disk.lookup(key, 1200) == (response if hit else None)
+    assert cache.SearchMemo().lookup_slice('offline-fixture', 'timestamp fixture', 5) == (response if hit else None)
+    assert cache.SearchMemo().lookup('offline-fixture', 'healthy fixture', 5) == response
+    assert {p.name: p.read_bytes() for p in root.glob('*.txt')} == before
+
+
+@pytest.mark.parametrize('sign', [1, -1], ids=['positive', 'negative'])
+@pytest.mark.parametrize('provider_error', [False, True], ids=['success', 'provider-error'])
+def test_registered_search_preserves_provider_path_after_bad_disk_timestamp(monkeypatch, sign, provider_error):
+    import json
+    import math
+    from types import SimpleNamespace
+    from unittest.mock import Mock
+    from agent import web_search_registry
+    from tools import web_search_disk_cache as disk, web_tools
+    from tools.registry import registry
+
+    config = {'keyless_rescue': False}
+    monkeypatch.setattr(cache, '_web_config', lambda: config)
+    monkeypatch.setattr(web_tools, '_load_web_config', lambda: config)
+    monkeypatch.setattr(cache, 'search_memo', cache.SearchMemo())
+    query = 'synthetic timestamp recovery'
+    value = {'success': True, 'data': {'web': [
+        {'title': 'synthetic result ' + str(i), 'url': 'https://example.test/' + str(i)} for i in range(10)
+    ]}}
+    cache.SearchMemo().store('offline-fixture', query, 5, value)
+    key = cache.SearchMemo._key('offline-fixture', query, 5)
+    path = disk._root() / (disk._key(key) + '.txt')
+    payload = json.loads(path.read_text())
+    payload['at'] = sign * 10**400
+    path.write_text(json.dumps(payload))
+    before = path.read_bytes()
+    cache.SearchMemo().store('offline-fixture', 'unrelated query', 5, value)
+    other_key = cache.SearchMemo._key('offline-fixture', 'unrelated query', 5)
+    other = disk._root() / (disk._key(other_key) + '.txt')
+    other_bytes = other.read_bytes()
+    response = {'success': False, 'error': 'synthetic provider failure'} if provider_error else value
+    provider = SimpleNamespace(name='offline-fixture', supports_search=lambda: True,
+                               search=Mock(return_value=response))
+    monkeypatch.setattr(web_tools, '_ensure_web_plugins_loaded', lambda: None)
+    monkeypatch.setattr(web_tools, '_get_search_backend', lambda: provider.name)
+    monkeypatch.setattr(web_search_registry, 'get_provider', lambda name: provider)
+    managed = Mock(wraps=web_tools._managed_search_fallback)
+    rescue = Mock(side_effect=AssertionError('Fixture policy disables keyless rescue'))
+    monkeypatch.setattr(web_tools, '_managed_search_fallback', managed)
+    monkeypatch.setattr(web_tools, '_rescue_search', rescue)
+    result = json.loads(registry.dispatch('web_search', {'query': query, 'limit': 3}))
+    assert result == (response if provider_error else {'success': True, 'data': {'web': value['data']['web'][:3]}})
+    provider.search.assert_called_once_with(query, 10)
+    rescue.assert_not_called()
+    assert config == {'keyless_rescue': False} and other.read_bytes() == other_bytes
+    if provider_error:
+        managed.assert_called_once()
+        assert path.read_bytes() == before
+        assert cache.SearchMemo().lookup('offline-fixture', query, 5) is None
+    else:
+        managed.assert_not_called()
+        repaired = json.loads(path.read_text())
+        assert type(repaired['at']) in (int, float) and math.isfinite(repaired['at'])
+        assert repaired['response'] == value
+        monkeypatch.setattr(cache, 'search_memo', cache.SearchMemo())
+        again = json.loads(registry.dispatch('web_search', {'query': ' SYNTHETIC  TIMESTAMP RECOVERY ', 'limit': 5}))
+        assert again == {'success': True, 'data': {'web': value['data']['web'][:5]}}
+        provider.search.assert_called_once_with(query, 10)
+        assert other.read_bytes() == other_bytes
+
+
+def _ttl_config(tmp_path, monkeypatch, raw, *, enabled=True):
+    import json
+    from hermes_cli import config
+    from tools import web_tools
+
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    path = tmp_path / 'config.yaml'
+    path.write_text(json.dumps({'web': {'backend': 'offline-fixture', 'keyless_rescue': False,
+                                      'cache_enabled': enabled, 'cache_ttl_minutes': raw}}))
+    before = path.read_bytes()
+    assert config.get_config_path() == path
+    assert web_tools._load_web_config()['cache_ttl_minutes'] == raw
+    assert cache._web_config()['cache_ttl_minutes'] == raw
+    assert path.read_bytes() == before
+    return path, before
+
+
+@pytest.mark.parametrize('raw, seconds', [
+    (10**400, 1200), (-10**400, 1200), (None, 1200), ('bogus', 1200), ({}, 1200),
+    (0, 60), (99999, 86400), ('1e400', 86400), ('-1e400', 60), ('nan', 60),
+    ('inf', 86400), ('-inf', 60), (True, 60), (False, 60), (2.5, 150), ('20', 1200),
+], ids=['overflow-positive', 'overflow-negative', 'null', 'invalid-string', 'invalid-type',
+        'floor', 'ceiling', 'overflow-string', 'negative-overflow-string', 'nan',
+        'infinity', 'negative-infinity', 'true', 'false', 'fraction', 'numeric-string'])
+def test_real_config_ttl_defaults_and_cache_expiry(tmp_path, monkeypatch, raw, seconds):
+    import os
+    from tools import web_search_disk_cache as disk
+
+    path, before = _ttl_config(tmp_path, monkeypatch, raw)
+    assert cache.ttl_seconds() == seconds
+    clock = [2000000000.0, 5000.0]
+    monkeypatch.setattr(cache.time, 'time', lambda: clock[0])
+    monkeypatch.setattr(cache.time, 'monotonic', lambda: clock[1])
+    memo = cache.SearchMemo()
+    value = {'success': True, 'data': {'web': [{'title': 'TTL fixture'}]}}
+    memo.store('offline-fixture', 'ttl fixture', 5, value)
+    url = 'https://example.test/ttl-fixture'
+    cache.extract_cache_put(url, 'retained content', title='TTL article', provider='offline-fixture')
+    for entry in disk._root().glob('*.txt'):
+        os.utime(entry, (clock[0], clock[0]))
+    cached_bytes = {p: p.read_bytes() for p in (tmp_path / 'cache').rglob('*') if p.is_file()}
+    for elapsed, hit in ((seconds - 0.001, True), (seconds, False)):
+        clock[:] = [2000000000.0 + elapsed, 5000.0 + elapsed]
+        assert memo.lookup('offline-fixture', 'ttl fixture', 5) == (value if hit else None)
+        assert cache.SearchMemo().lookup('offline-fixture', 'ttl fixture', 5) == (value if hit else None)
+        page = cache.extract_cache_get(url, provider='offline-fixture')
+        assert (page is not None) is hit
+        if hit:
+            assert page['content'] == 'retained content' and page['cached'] is True
+    assert all(p.read_bytes() == data for p, data in cached_bytes.items())
+    assert path.read_bytes() == before
+
+
+@pytest.mark.parametrize('sign', [1, -1], ids=['positive', 'negative'])
+@pytest.mark.parametrize('provider_error', [False, True], ids=['success', 'provider-error'])
+@pytest.mark.parametrize('enabled', [True, False], ids=['enabled', 'disabled'])
+def test_registered_search_uses_real_overflow_ttl_config(tmp_path, monkeypatch, sign, provider_error, enabled):
+    import json
+    from types import SimpleNamespace
+    from unittest.mock import Mock, call
+    from agent import web_search_registry
+    from tools import web_tools
+    from tools.registry import registry
+
+    path, before = _ttl_config(tmp_path, monkeypatch, sign * 10**400, enabled=enabled)
+    monkeypatch.setattr(cache, 'search_memo', cache.SearchMemo())
+    value = {'success': True, 'data': {'web': [
+        {'title': 'TTL fixture ' + str(i), 'url': 'https://example.test/' + str(i)} for i in range(10)
+    ]}}
+    failure = {'success': False, 'error': 'synthetic TTL provider failure'}
+    def search(query, limit):
+        return failure if provider_error and query == 'ttl query' else value
+    provider = SimpleNamespace(name='offline-fixture', supports_search=lambda: True, search=Mock(side_effect=search))
+    def resolve(name):
+        assert name == provider.name, 'fixture must not select another provider'
+        return provider
+    monkeypatch.setattr(web_tools, '_ensure_web_plugins_loaded', lambda: None)
+    monkeypatch.setattr(web_search_registry, 'get_provider', resolve)
+    managed = Mock(wraps=web_tools._managed_search_fallback)
+    rescue = Mock(side_effect=AssertionError('fixture disables keyless rescue'))
+    monkeypatch.setattr(web_tools, '_managed_search_fallback', managed)
+    monkeypatch.setattr(web_tools, '_rescue_search', rescue)
+    sliced = {'success': True, 'data': {'web': value['data']['web'][:3]}}
+    for query, expected in [('ttl query', failure if provider_error else sliced), ('healthy query', sliced)]:
+        for _ in range(2):
+            assert json.loads(registry.dispatch('web_search', {'query': query, 'limit': 3})) == expected
+    primary_calls = 2 if provider_error or not enabled else 1
+    healthy_calls = 1 if enabled else 2
+    assert provider.search.call_args_list == ([call('ttl query', 10)] * primary_calls
+                                              + [call('healthy query', 10)] * healthy_calls)
+    assert managed.call_count == (primary_calls if provider_error else 0)
+    rescue.assert_not_called()
+    if not enabled:
+        assert not cache.search_memo._store
+        assert not list((tmp_path / 'cache/web-search-v1').glob('*.txt'))
+    assert path.read_bytes() == before
