index 0000000000000000000000000000000000000000..ed8e77cb68be42045819bb285d00808f8fa0cf23
--- /dev/null
+++ b/tui_gateway/session_kanban_delivery.py
@@ -0,0 +1,91 @@
+"""Recover and submit durable Kanban notifications through the existing TUI worker."""
+from __future__ import annotations
+
+from hermes_cli import kanban_db_tui_delivery as deliveries
+from tui_gateway.session_kanban_lineage import destination_keys
+
+
+def recover(session: dict, fresh: list) -> list:
+    from tui_gateway import server as s
+    from hermes_cli import kanban_db as kb
+    if not session.get('session_key') or session.get('_finalized'):
+        return fresh
+    recovered, seen = [], set()
+    try:
+        boards = kb.list_boards(include_archived=False)
+    except Exception:
+        boards = [kb.read_board_metadata(kb.DEFAULT_BOARD)]
+    for board in boards:
+        slug, path = s._kb_board_key(kb, board)
+        if path in seen:
+            continue
+        seen.add(path)
+        try:
+            pending = deliveries.pending(kb.kanban_db_path(slug), home=deliveries.owner_home(), session_key=None)
+            accepted = destination_keys(session, (text.delivery_ref.session_key for text in pending))
+            recovered.extend(text for text in pending if text.delivery_ref.session_key in accepted)
+        except Exception:
+            s.logger.exception('kanban pending receipt read failed on board %s', slug)
+    # Already prepared fresh rows are also present on disk; identity-based merge preserves events with identical text.
+    return merge(recovered, fresh)[0]
+
+
+def merge(existing: list, incoming: list) -> tuple[list, list]:
+    combined, added = list(existing), []
+    seen = {text.delivery_ref for text in existing if hasattr(text, 'delivery_ref')}
+    for text in incoming:
+        ref = getattr(text, 'delivery_ref', None)
+        if ref is not None and ref in seen:
+            continue
+        if ref is not None:
+            seen.add(ref)
+        combined.append(text)
+        added.append(text)
+    return combined, added
+
+
+def submit(rid: str, sid: str, session: dict, batch: list, *, diagnostic: bool) -> None:
+    """Known refusal is retryable; a started/unknown worker is retained, never replayed."""
+    from tui_gateway import server as s
+    from gateway.warning_notifications import render_notification
+    if not any(hasattr(text, 'delivery_ref') for text in batch):
+        s._notif_submit(rid, sid, session, '\n'.join(batch), 'kanban notification dispatch failed',
+                        **({'display_metadata': {'notification_category': 'diagnostic'}} if diagnostic else {}))
+        return  # Pre-upgrade in-memory buffers keep their existing dispatch contract.
+    claim = deliveries.Claim('', ())
+    prior_thread = session.get('_run_thread')
+    try:
+        with session['history_lock']:
+            if session.get('_turn_cancel_requested'):
+                raise RuntimeError('notification turn was stopped before admission')
+            generation = int(session.get('_queued_prompt_generation', 0))
+        accepted = destination_keys(session, (text.delivery_ref.session_key for text in batch
+                                              if hasattr(text, 'delivery_ref')))
+        batch = [text for text in batch if not hasattr(text, 'delivery_ref') or text.delivery_ref.session_key in accepted]
+        batch, claim = deliveries.claim(batch, home=deliveries.owner_home(), session_key=session['session_key'],
+                                         session_keys=tuple(accepted))
+        if not batch:
+            s._notif_release_turn(session)
+            return
+        render_notification(lambda: s._emit('message.start', sid), platform='tui', diagnostic=diagnostic)
+        kwargs = {'display_metadata': {'notification_category': 'diagnostic'}} if diagnostic else {}
+        kwargs['queued_prompt_generation'] = generation
+        if claim.refs:
+            def terminal(result):
+                state = result.get('status')
+                claim.mark(state if state in deliveries.TERMINAL else 'unknown')
+            kwargs['terminal_callback'] = terminal
+        if s._run_prompt_submit(rid, sid, session, '\n'.join(batch), **kwargs) is False:
+            claim.mark('pending')
+            raise RuntimeError('notification turn was not admitted')
+        claim.mark('admitted')
+    except Exception as exc:
+        thread = session.get('_run_thread')
+        started = thread is not None and thread is not prior_thread and thread.ident is not None
+        claim.mark('unknown' if started else 'pending')
+        s._notif_log_failure('kanban notification dispatch failed', exc)
+        if started:
+            # The actual worker owns running/cleanup. A durable receipt, rather than a replay, survives ambiguity.
+            return
+        s._notif_release_turn(session)
+        raise
diff --git a/tui_gateway/session_kanban_lineage.py b/tui_gateway/session_kanban_lineage.py
new file mode 100644
index 0000000000000000000000000000000000000000..b4c09143b232eceb1ef2a3269ec0f82611e7ea63
--- /dev/null
+++ b/tui_gateway/session_kanban_lineage.py
@@ -0,0 +1,76 @@
+"""Resolve notification destinations in the owning store, without retargeting receipts."""
+from __future__ import annotations
+
+import contextlib
+from pathlib import Path
+import sqlite3
+
+
+@contextlib.contextmanager
+def _reader(session: dict):
+    from tui_gateway import server as s
+    if not session.get('profile_home'):
+        yield s._get_db()
+        return
+    from hermes_state import SessionDB
+    path = Path(session['profile_home']) / 'state.db'
+    if not path.is_file():
+        yield None
+        return
+    # Routing is a read, not a resume. Opening a full profile writer runs schema /
+    # housekeeping work on every poll and needlessly contends with the active agent.
+    with contextlib.closing(SessionDB(path, read_only=True)) as db:
+        yield db
+
+
+def destination_keys(session: dict, candidates) -> set[str]:
+    """Only the selected compression tip may consume an ancestor's work.
+
+    The canonical store resolver excludes branches/delegates/resets. Missing legacy
+    stores retain exact-key delivery only; lookup errors never broaden authority.
+    """
+    from tui_gateway import server as s
+    current = str(session.get('session_key') or '')
+    wanted = {str(key) for key in candidates if key}
+    exact = wanted & {current}
+    if not current or not wanted:
+        return set()
+    try:
+        with _reader(session) as db:
+            if db is None or not callable(getattr(db, 'get_compression_tip', None)):
+                return exact
+            reader = getattr(db, 'get_session_metadata', None)
+            if not callable(reader):
+                reader = db.get_session
+            if not reader(current):
+                return exact
+            if db.get_compression_tip(current) != current:
+                return set()  # A stale parent runtime must leave work for the continuation.
+            return {key for key in wanted if key == current
+                    or reader(key) and db.get_compression_tip(key) == current}
+    except (OSError, sqlite3.Error, RuntimeError, ValueError):
+        s.logger.exception('Kanban destination lineage could not be verified')
+        return set()
+
+
+def subscriptions(session: dict, rows: list[dict]) -> list[dict]:
+    """Legacy exact keys keep their contract; ancestor routes need a stamped owner."""
+    from hermes_cli.profiles import current_profile_name
+    current = str(session.get('session_key') or '')
+    profile = current_profile_name('default')
+    candidates = [row for row in rows if (row.get('platform') or '').lower() == 'tui'
+                  and (row.get('chat_id') == current or row.get('notifier_profile') == profile)]
+    accepted = destination_keys(session, (row.get('chat_id') for row in candidates))
+    return [row for row in candidates if row.get('chat_id') in accepted]
+
+
+def has_destination(path: Path, session: dict) -> bool:
+    """A foreign session must never open a board writable just to discover no route."""
+    if not path.is_file():
+        return False
+    with contextlib.closing(sqlite3.connect(path.resolve().as_uri() + '?mode=ro', uri=True)) as conn:
+        conn.row_factory = sqlite3.Row
+        if not conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='kanban_notify_subs'").fetchone():
+            return False
+        rows = [dict(row) for row in conn.execute("SELECT * FROM kanban_notify_subs WHERE LOWER(platform)='tui'")]
+    return bool(subscriptions(session, rows))
