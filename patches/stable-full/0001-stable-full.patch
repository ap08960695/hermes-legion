+"""Identify prepared prompt layouts without exporting or mutating their content."""
+import copy
+import json
+
+import pytest
+
+from agent.cache_request_diagnostics import fingerprint
+
+
+@pytest.mark.parametrize('version', [1, 2, 3, 4])
+@pytest.mark.parametrize('shape', ['instructions', 'system', 'messages', 'override'])
+def test_layout_is_read_from_effective_complete_prompt(version, shape):
+    text = f'[Hermes common operating rules v{version}]\n\nprivate rules\n\n[/Hermes common operating rules v{version}]\n\nprivate tail'
+    payload = {'model': 'synthetic', 'prompt_cache_key': 'hsp1_unrelated'}
+    if shape == 'messages':
+        payload['messages'] = [{'role': 'system', 'content': text}]
+    elif shape == 'override':
+        payload.update(instructions='unversioned', extra_body={'instructions': text})
+    else:
+        payload[shape] = text
+    original = copy.deepcopy(payload)
+    result = fingerprint(payload, key=b'k' * 32, session_id='s', request_id='r', base_url='https://example.invalid')
+    assert result['shared_layout_version'] == version
+    assert payload == original
+    assert 'private' not in json.dumps(result)
+
+
+@pytest.mark.parametrize('text', [None, '', 'unversioned', '[Hermes common operating rules v4]\n\nmissing end', '[Hermes common operating rules v5]\n\nrules\n\n[/Hermes common operating rules v5]'])
+def test_unknown_or_incomplete_layout_is_not_inferred_from_key(text):
+    result = fingerprint({'instructions': text, 'prompt_cache_key': 'hsp4_synthetic'}, key=b'k' * 32, session_id='s', request_id='r', base_url='https://example.invalid')
+    assert result['shared_layout_version'] is None
