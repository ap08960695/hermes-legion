+it.each(['0', '3', '-1', '1.5', 'true', 'null', 'NaN', 'Infinity', '2e0'])('rejects invalid launch limit %s', value => {
+  expect(readDesktopLaunchConfig(`desktop:\n  backend_probe_limit: ${value}\n`).backendProbeLimit).toBeUndefined()
+})
+
+it('keeps the default limit for invalid configuration and unrelated sections', async () => {
+  expect(readDesktopLaunchConfig('other:\n  backend_probe_limit: 2\n').backendProbeLimit).toBeUndefined()
+  expect(readDesktopLaunchConfig('desktop:\n  backend_probe_limit: 1\n').backendProbeLimit).toBe(1)
+  api.configureBackendProbes({ backendProbeLimit: 3 })
+  const first = probe(); const second = probe()
+  expect(children).toHaveLength(1)
+  children[0].close(); await first; await tick(); children[1].close(); await second
+})
+
+it('bounds waiting probes at 256 without making overflow retryable', async () => {
+  const active = probe(); const waiting = Array.from({ length: 256 }, () => probe())
+  const overflow = probe()
+  await expect(overflow).rejects.toMatchObject({ code: 'EPROBE_QUEUE_FULL' })
+  expect(children).toHaveLength(1)
+  await vi.advanceTimersByTimeAsync(1000)
+  const results = await Promise.allSettled(waiting)
+  expect(results.every(result => result.status === 'rejected' && result.reason.code === 'EPROBE_ADMISSION_TIMEOUT')).toBe(true)
