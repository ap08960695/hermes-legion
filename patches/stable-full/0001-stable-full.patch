--- /dev/null
+++ b/agent/model_metadata_requests.py
@@ -0,0 +1,113 @@
+"""Native catalog read coordination; no lock is held over another scope's HTTP call."""
+from concurrent.futures import Future
+import contextlib
+import threading
+import time
+from typing import Any, Optional
+
+_lock = threading.Lock()
+_pending: dict[tuple, tuple[Future, bool]] = {}
+
+
+def fetch_once(scope: tuple, query, *, force_refresh: bool = False):
+    """Reserve a refresh behind an ordinary read so queued refresh callers share it."""
+    prior = None
+    with _lock:
+        pending = _pending.get(scope)
+        if pending is not None and force_refresh and not pending[1]:
+            prior = pending[0]
+            pending = None
+        owner = pending is None
+        if owner:
+            pending = (Future(), force_refresh)
+            _pending[scope] = pending
+    future, _ = pending
+    if not owner:
+        return future.result()
+    try:
+        if prior is not None:
+            prior.result()
+        value = query()
+    except BaseException as exc:
+        with _lock:
+            if _pending.get(scope) == pending:
+                _pending.pop(scope)
+        future.set_exception(exc)
+        raise
+    else:
+        with _lock:
+            if _pending.get(scope) == pending:
+                _pending.pop(scope)
+        future.set_result(value)
+        return value
+
+
+def fetch_endpoint_catalog(base_url: str, api_key: str, force_refresh: bool):
+    from agent import model_metadata as metadata
+
+    normalized = metadata._normalize_base_url(base_url)
+    if not normalized or metadata.base_url_host_matches(normalized, "openrouter.ai"):
+        return {}
+    return fetch_once(metadata._endpoint_memo_key(normalized, api_key),
+                      lambda: _read_endpoint_catalog(base_url, api_key, force_refresh),
+                      force_refresh=force_refresh)
+
+
+def _read_endpoint_catalog(base_url: str, api_key: str, force_refresh: bool) -> dict[str, dict[str, Any]]:
+    from agent import model_metadata as metadata
+    normalized = metadata._normalize_base_url(base_url)
+    if not normalized or metadata.base_url_host_matches(normalized, "openrouter.ai"):
+        return {}
+    local = metadata.is_local_endpoint(normalized)
+    memo_key = metadata._endpoint_memo_key(normalized, api_key)
+    if not force_refresh:
+        with metadata._endpoint_metadata_lock:
+            cached = metadata._endpoint_model_metadata_cache.get(memo_key)
+            if cached is not None and (time.time() - metadata._endpoint_model_metadata_cache_time.get(memo_key, 0)) < metadata._ENDPOINT_MODEL_CACHE_TTL:
+                return cached
+        memo = metadata._endpoint_disk_cache_get(normalized, api_key) if not local else None
+        if memo is not None:
+            return metadata._remember_endpoint_models(memo_key, memo)
+    # Blackholed: return empty WITHOUT caching so it is retried once the entry expires.
+    if metadata._endpoint_blackholed(normalized):
+        return {}
+    alternate = normalized[:-3].rstrip("/") if normalized.endswith("/v1") else normalized + "/v1"
+    candidates = [normalized] + ([alternate] if alternate != normalized else [])
+    headers = metadata._auth_headers(api_key)
+    verify = metadata.model_metadata_http.resolve_verify(normalized)
+    last_error: Optional[Exception] = None
+    if local:
+        try:
+            if metadata.detect_local_server_type(normalized, api_key=api_key) == "lm-studio":
+                return metadata._remember_endpoint_models(memo_key, metadata._lmstudio_native_models(normalized, headers))
+        except Exception as exc:  # health: allow BLE001 -- Preserve the native optional-probe fallback and timeout tracking.
+            last_error = exc
+            metadata._note_if_connect_timeout(exc, normalized)
+    for candidate in candidates:
+        # A connect timeout condemns the host, not the path.
+        if metadata._endpoint_blackholed(normalized):
+            break
+        # Cache keys stay unrewritten; only the outbound target is IPv4-resolved.
+        request_candidate = metadata._localhost_to_ipv4(candidate)
+        url = request_candidate.rstrip("/") + "/models"
+        try:
+            with metadata.model_metadata_http.stream(url, headers=headers, timeout=(5, 10), verify=verify) as response:
+                if response.status_code in (401, 403):
+                    metadata.logger.debug("Model metadata probe received HTTP %s from %s; stopping candidate probing", response.status_code, url)
+                    break
+                response.raise_for_status()
+                response.read()
+                payload = response.json()
+            cache = metadata._parse_models_payload(payload)
+            if any(m.get("owned_by") == "llamacpp" for m in payload.get("data", []) if isinstance(m, dict)):
+                with contextlib.suppress(Exception):
+                    metadata._apply_llamacpp_props(cache, request_candidate, headers, verify)
+            if cache and not local:
+                metadata._endpoint_disk_cache_put(normalized, cache, api_key)
+            return metadata._remember_endpoint_models(memo_key, cache)
+        except Exception as exc:  # health: allow BLE001 -- Optional provider catalogs must retain the native fallback and timeout tracking.
+            last_error = exc
+            metadata._note_if_connect_timeout(exc, normalized)
+    if last_error:
+        metadata.logger.debug("Failed to fetch model metadata from %s/models: %s", normalized, last_error)
+    return metadata._remember_endpoint_models(memo_key, {})
