+    expect(first.getByText('Sign in again for this profile')).toBeTruthy()
+    expect(second.queryByText('Sign in again for this profile')).toBeNull()
+    fireEvent.click(first.getByRole('button', { name: /Open chat/ }))
+    expect(io.open).toHaveBeenCalledExactlyOnceWith(io.rows[0], storedId, expect.any(AbortSignal))
+
+    act(() => $clarifyRequests.set({ 'runtime-1': requests['runtime-1'] }))
+    expect(first.queryByText('Waiting for your answer…')).toBeNull()
+    expect(first.getByText('Sign in again for this profile')).toBeTruthy()
+    fireEvent.click(first.getByRole('button', { name: /Open chat/ }))
+    expect(io.open).toHaveBeenLastCalledWith(io.rows[0], undefined, expect.any(AbortSignal))
+    act(() => data.clearBotAttention(owner))
+    expect(screen.queryByText('First waiting chat')).toBeNull()
+    expect(screen.getByText('Second waiting chat')).toBeTruthy()
+    expect(io.refetch).not.toHaveBeenCalled()
+  } finally {
+    act(() => {
+      $sessionTiles.set(previous[0])
+      $sessionStates.set(previous[1])
+      $clarifyRequests.set(previous[2])
+    })
+  }
+})
diff --git a/apps/desktop/src/plugins/hermes-bots/monitor.tsx b/apps/desktop/src/plugins/hermes-bots/monitor.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..fd10beaff4af208bbef40b9bbb8ba46f19123bc4
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/monitor.tsx
@@ -0,0 +1,326 @@
+import { atom, Button, Codicon, compactNumber, Dialog, EmptyState, host, SearchField, SegmentedControl, type PluginSessionClarification, useValue } from '@hermes/plugin-sdk'
+import { useRef, useState } from 'react'
+
+import { botRosterKey, type botSourceStatus } from './data'
+import { type BotsText, useBots } from './i18n'
+import { stripPreviewMarkdown } from './labels'
+// eslint-disable-next-line no-restricted-imports -- shared with the global Characters publisher.
+import { $characterExtraActor } from '@/store/character-settings'
+import { BotMonitorReportContent, BotMonitorReports, botRecordedIssue, type ReportSnapshot } from './monitor-reports'
+import { focusedBotClarificationRow } from './routing'
+import { activeWorkerSessions, workerProgress } from './row-helpers'
+import { $pendingBotOpen } from './shared'
+import type { RosterRow, WorkerSession } from './types'
+
+export interface BotMonitorProps {
+  now: number
+  stale?: boolean
+  waitingForRoster?: boolean
+  rows: {
+    bot: RosterRow
+    name: string
+    working: boolean
+    needsAttention: boolean
+    attentionHint: string
+    source: ReturnType<typeof botSourceStatus>
+  }[]
+  onOpen: (bot: RosterRow, waitingSessionId?: string) => void | Promise<void | boolean>
+}
+
+function reportedCounter(value: number | null | undefined): number | undefined {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0 ? value : undefined
+}
+
+function reportedTokenTotal(usage: WorkerSession | null) {
+  const input = reportedCounter(usage?.input_tokens), output = reportedCounter(usage?.output_tokens)
+
+  return input == null && output == null ? -1 : (input ?? 0) + (output ?? 0)
+}
+
+function monitorTokens(usage: WorkerSession | null, b: BotsText): string {
+  const input = reportedCounter(usage?.input_tokens), output = reportedCounter(usage?.output_tokens)
+
+  return input == null && output == null ? b.monitor.missing
+    : b.roster.workerTokens(input == null ? b.monitor.missing : compactNumber(input), output == null ? b.monitor.missing : compactNumber(output))
+}
+
+const recordedUsd = new Intl.NumberFormat('en-US', {
+  style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 4
+})
+
+function formatRecordedUsd(amount: number): string {
+  return amount > 0 && amount < 0.00005 ? '<$0.0001' : recordedUsd.format(amount === 0 ? 0 : amount)
+}
+
+function monitorCost(usage: WorkerSession | null, b: BotsText) {
+  const estimate = reportedCounter(usage?.estimated_cost_usd), actual = reportedCounter(usage?.actual_cost_usd)
+
+  return <>
+    {estimate != null && <div>{b.monitor.recordedEstimate(formatRecordedUsd(estimate))}</div>}
+    {actual != null && <div>{b.monitor.recordedActual(formatRecordedUsd(actual))}</div>}
+    {estimate == null && actual == null && b.monitor.missing}
+  </>
+}
+
+function monitorModel(worker: WorkerSession | null, bot: RosterRow, b: BotsText) {
+  const source = worker || bot.canonical_session
+  const recorded = typeof source?.model === 'string' ? source.model.trim().slice(0, 256) : ''
+
+  return worker ? <div>{b.monitor.recordedModel(recorded || b.monitor.missing)}</div> : <>
+    <div>{b.monitor.configuredModel(bot.model || b.workspace.modelUnknown)}</div>
+    {bot.canonical_session && <div>{b.monitor.recordedChatModel(recorded || b.monitor.missing)}</div>}
+  </>
+}
+
+function monitorSignal(bot: RosterRow, worker: WorkerSession | null) {
+  const preview = worker
+    ? worker.last_activity_description || worker.title
+    : bot.canonical_session?.preview || bot.description
+
+  return stripPreviewMarkdown(preview).slice(0, 120)
+}
+
+function monitorStatusLabel(row: BotMonitorProps['rows'][number], status: string, b: BotsText): string {
+  return status === 'unavailable' ? row.source.label : row.bot.retained ? b.monitor.retained
+    : status === 'working' ? b.workspace.working : status === 'attention' ? b.workspace.attention
+      : row.source.key !== 'ready' ? row.source.label : b.workspace.notActive
+}
+
+const noClarification = atom(null)
+const noOpenClarifications = atom<readonly PluginSessionClarification[]>([])
+
+/** A read-only projection of the existing roster; only explicit chat actions navigate. */
+export function BotMonitor({ rows, onOpen, now, stale: refreshFailed = false, waitingForRoster = false }: BotMonitorProps) {
+  const stale = refreshFailed || waitingForRoster
+  const includeSixth = useValue($characterExtraActor)
+  const pendingOpen = useValue($pendingBotOpen)
+  const clarification = useValue(host.state.focusedClarification || noClarification)
+  const openClarifications = useValue(host.state.openBotClarifications || noOpenClarifications)
+  const waitingRows = new Map<BotMonitorProps['rows'][number], string>()
+
+  if (!stale) {
+    for (const pending of openClarifications) {
+      const row = focusedBotClarificationRow(rows, pending)
+      if (row && !waitingRows.has(row)) waitingRows.set(row, pending.storedSessionId)
+    }
+
+    const focusedRow = focusedBotClarificationRow(rows, clarification)
+    if (focusedRow && clarification) waitingRows.set(focusedRow, clarification.storedSessionId)
+  }
+
+  const b = useBots(), m = b.monitor
+  const [search, setSearch] = useState(''), [filter, setFilter] = useState('all')
+  const [sort, setSort] = useState('name'), [limit, setLimit] = useState(60)
+  const connection = useValue(host.state.connectionId)
+  const profile = useValue(host.state.profile)
+
+  const [report, setReport] = useState<{
+    snapshot: ReportSnapshot; trigger: HTMLButtonElement; botKey: string; connection: string | null; profile: string
+  } | null>(null)
+
+  const [reportFilter, setReportFilter] = useState('all')
+  const searchInput = useRef<HTMLInputElement>(null)
+  const heading = useRef<HTMLHeadingElement>(null)
+
+  const activeReport = report && report.connection === connection && report.profile === profile &&
+    (stale || rows.some(row => botRosterKey(row.bot) === report.botKey)) ? report : null
+
+  if (report && !activeReport) {
+    setReport(null)
+  }
+
+  const entries = rows.flatMap(row => {
+    const current = !stale && row.source.available && !row.bot.retained && row.source.key !== 'on-demand'
+
+    const waiting = current && row.source.key === 'ready' && row.bot.connectionId &&
+      !row.bot.ghost ? waitingRows.get(row) : undefined
+    const status = stale || !row.source.available ? 'unavailable'
+      : current && (row.needsAttention || waiting) ? 'attention' : current && row.working ? 'working' : 'idle'
+
+    const bot = { row, waiting, issue: botRecordedIssue(row.bot), worker: null as WorkerSession | null, usage: row.bot.canonical_session || null, key: `${botRosterKey(row.bot)}:bot`, status }
+    const workers = current ? activeWorkerSessions(row.bot, now) : []
+
+    return [bot, ...workers.map((worker, index) => ({
+      row, worker, waiting: undefined, issue: null, usage: worker, key: `${botRosterKey(row.bot)}:worker:${worker.id || index}`, status: 'working'
+    }))]
+  })
+
+  const query = search.trim().toLowerCase()
+
+  const shown = entries.filter(({ row, worker, status, issue }) =>
+    (filter === 'all' || (filter === 'issues' ? Boolean(issue) : status === filter)) &&
+    (!query || [row.name, row.bot.name, row.bot.connectionLabel, row.bot.description,
+      worker?.title, worker?.last_activity_description, worker?.current_tool, issue?.goal, issue?.excerpt].join(' ').toLowerCase().includes(query) ||
+      monitorSignal(row.bot, worker).toLowerCase().includes(query))
+  ).sort((a, z) => {
+    if (sort === 'elapsed') {
+      const delta = (a.worker?.started_at || Infinity) - (z.worker?.started_at || Infinity)
+
+      if (delta) {return delta}
+    }
+
+    if (sort === 'tokens') {
+      const delta = reportedTokenTotal(z.usage) - reportedTokenTotal(a.usage)
+
+      if (delta) {return delta}
+    }
+
+    return a.row.name.localeCompare(z.row.name) || a.key.localeCompare(z.key)
+  })
+
+  const openingName = pendingOpen && !stale
+    ? shown.slice(0, limit).find(({ row }) => row.source.available && botRosterKey(row.bot) === pendingOpen.key)?.row.name
+    : undefined
+
+  const sortButton = (value: string, label: string, accessible: string) => (
+    <Button aria-label={accessible} onClick={() => setSort(value)} size="inline" variant="textStrong">
+      {label}
+      {sort === value && <Codicon name={value === 'name' ? 'chevron-up' : 'chevron-down'} />}
+    </Button>
+  )
+
+  return (
+    <section aria-label={m.title} className="flex min-h-0 flex-1 flex-col gap-4 overflow-auto px-6 pb-6" data-bot-monitor>
+      <span aria-live="polite" className="sr-only">{openingName ? `${b.bot.openingChat} · ${openingName}` : ''}</span>
+      <div className="pt-4">
+        <h2 className="text-lg font-semibold" ref={heading} tabIndex={-1}>{m.title}</h2>
+        <p className="mt-1 text-xs text-muted-foreground">{m.hint}</p>
+        {!stale && <p className="mt-2 text-xs text-muted-foreground">{m.counts(rows.length, entries.length - rows.length)}</p>}
+        <p className="mt-1 text-xs text-muted-foreground">{m.costHint}</p>
+        <p className="mt-1 text-xs text-muted-foreground">{m.usageHint}</p>
+        {stale && <p className="mt-2 text-sm" role="status">{waitingForRoster ? m.waitingForRoster : m.refreshFailed}</p>}
+      </div>
+      <div className="flex flex-wrap items-center gap-4">
+        <Button aria-pressed={includeSixth} onClick={() => $characterExtraActor.set(!includeSixth)}
+          size="sm" variant={includeSixth ? 'secondary' : 'ghost'}>
+          {b.monitor.includeSixthCharacter}
+        </Button>
+        {rows.length > 0 && <SearchField aria-label={m.search} inputRef={searchInput} onChange={value => {
+          setSearch(value)
+          setLimit(60)
+        }} placeholder={m.search} value={search} />}
+        <div aria-label={b.workspace.filter} role="group">
+          <SegmentedControl onChange={value => {
+            setFilter(value)
+            setLimit(60)
+          }} options={[
+            ...(['all', 'working', 'attention', 'unavailable'] as const).map(id => ({ id, label: b.workspace[id] })),
+            { id: 'issues', label: m.recordedIssues }
+          ]} value={filter} />
+        </div>
+      </div>
+      {shown.length === 0 ? (
+        !waitingForRoster && (!refreshFailed || rows.length > 0) &&
+        <div className="grid min-h-48 content-center justify-items-center gap-2">
+          <EmptyState className="min-h-0" title={rows.length > 0 ? b.workspace.empty : b.roster.emptyTitle} />
+          {rows.length > 0 && (query || filter !== 'all') && (
+            <Button onClick={() => {
+              searchInput.current?.focus()
+              setSearch('')
+              setFilter('all')
+              setLimit(60)
+            }} size="sm" type="button" variant="outline">
+              {b.roster.clearFilters}
+            </Button>
+          )}
+        </div>
+      ) : (
+        <div aria-label={m.scrollRegion} className="shrink-0 overflow-x-auto" data-monitor-table-scroll="" role="region" tabIndex={0}>
+          <table aria-label={m.title} className="w-full border-collapse text-left text-xs">
+            <thead className="text-muted-foreground">
+              <tr>
+                <th aria-sort={sort === 'name' ? 'ascending' : 'none'} className="p-3" scope="col">
+                  {sortButton('name', m.entity, m.sortName)}
+                </th>
+                <th className="p-3" scope="col">{m.status}</th>
+                <th className="p-3" scope="col">{m.activity}</th>
+                <th aria-sort={sort === 'elapsed' ? 'descending' : 'none'} className="p-3" scope="col">
+                  {sortButton('elapsed', m.elapsed, m.sortElapsed)}
+                </th>
+                <th aria-sort={sort === 'tokens' ? 'descending' : 'none'} className="p-3" scope="col">
+                  {sortButton('tokens', m.tokens, m.sortTokens)}
+                </th>
+                <th className="p-3" scope="col">{m.cost}</th>
+                <th className="p-3" scope="col">{m.model}</th>
+                <th className="p-3" scope="col">{m.attention}</th>
+                <th className="p-3" scope="col">{m.reports.title}</th>
+              </tr>
+            </thead>
+            <tbody>
+              {shown.slice(0, limit).map(({ row, worker, usage, key, status, waiting }) => {
+                const progress = workerProgress(worker, now)
+                const title = stripPreviewMarkdown(worker?.title || '').replace(/\s+/g, ' ').trim().slice(0, 120)
+
+                const signal = monitorSignal(row.bot, worker)
+                const ownerKey = botRosterKey(row.bot)
+
+                const isOpening = (pending: typeof pendingOpen) =>
+                  pending?.key === ownerKey && (!waiting || pending.waitingSessionId === waiting)
+
+                const opening = !stale && row.source.available && isOpening(pendingOpen)
+                const openLabel = opening ? b.bot.openingChat : b.workspace.open
+
+                return (
+                  <tr className="border-t border-(--ui-stroke-tertiary) align-top" key={key}>
+                    <td className="p-3">
+                      <div className="font-medium">{row.name}{worker && ` · ${m.worker}`}</div>
+                      <div className="mt-1 text-muted-foreground">{row.bot.connectionLabel || row.bot.connectionId}</div>
+                      <Button aria-disabled={opening || undefined}
+                        aria-label={`${openLabel} · ${row.name}${worker ? ` · ${title || m.worker}` : ''}`}
+                        className="mt-1 whitespace-nowrap aria-disabled:opacity-60" disabled={stale || !row.source.available}
+                        onClick={() => {
+                          if (!isOpening($pendingBotOpen.get())) {
+                            void (waiting ? onOpen(row.bot, waiting) : onOpen(row.bot))
+                          }
+                        }}
+                        size="sm" variant="ghost">
+                        {openLabel}
+                      </Button>
+                    </td>
+                    <td className="p-3">{stale ? m.retained : waiting ? b.group.waitingForAnswer : monitorStatusLabel(row, status, b)}</td>
+                    <td className="min-w-48 p-3">
+                      {title && title !== signal && <div className="font-medium">{title}</div>}
+                      <div className="break-words">{signal || m.missing}</div>
+                      {progress.tool && <div className="mt-1 text-muted-foreground">{progress.tool}</div>}
+                      {progress.step && <div className="mt-1 text-muted-foreground">{b.roster.workerStep(progress.step.n, progress.step.max)}</div>}
+                    </td>
+                    <td className="whitespace-nowrap p-3">{progress.elapsed || m.missing}</td>
+                    <td className="p-3">{monitorTokens(usage, b)}</td>
+                    <td className="min-w-40 p-3">{monitorCost(usage, b)}</td>
+                    <td className="min-w-48 break-all p-3">{monitorModel(worker, row.bot, b)}</td>
+                    <td className="p-3">{worker ? m.missing : row.attentionHint || m.missing}</td>
+                    <td className="min-w-40 p-3">{worker ? m.missing : <BotMonitorReports bot={row.bot} name={row.name} now={now}
+                      onOpen={(snapshot, trigger) => {
+                        setReportFilter('all')
+                        setReport({ snapshot, trigger, botKey: botRosterKey(row.bot), connection, profile })
+                      }} />}</td>
+                  </tr>
+                )
+              })}
+            </tbody>
+          </table>
+        </div>
+      )}
+      {shown.length > limit && <Button onClick={() => setLimit(value => value + 60)} variant="ghost">{b.workspace.more}</Button>}
+      <Dialog onOpenChange={open => !open && setReport(null)} open={activeReport !== null}>
+        {activeReport && <BotMonitorReportContent filter={{ value: reportFilter, onChange: setReportFilter }} onCloseAutoFocus={event => {
+          event.preventDefault()
+          const { trigger } = activeReport
+          const doc = trigger.ownerDocument
+
+          if (doc.activeElement !== doc.body || !heading.current?.isConnected) {return}
+
+          if (trigger.isConnected && !trigger.disabled && activeReport.connection === host.state.connectionId.get() &&
+              activeReport.profile === host.state.profile.get()) {
+            trigger.focus()
+
+            if (doc.activeElement === trigger) {return}
+          }
+
+          const fallback = searchInput.current ?? heading.current
+          fallback.focus()
+        }} snapshot={activeReport.snapshot} />}
+      </Dialog>
+    </section>
+  )
+}
diff --git a/apps/desktop/src/plugins/hermes-bots/owner-inbox-data.ts b/apps/desktop/src/plugins/hermes-bots/owner-inbox-data.ts
new file mode 100644
index 0000000000000000000000000000000000000000..fc629113fadb896acaf3008b270df05203a9b1e5
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/owner-inbox-data.ts
@@ -0,0 +1,186 @@
+import { host, type OwnerInboxItem, type OwnerInboxList, type OwnerInboxResponse, useValue } from '@hermes/plugin-sdk'
+import { atom } from 'nanostores'
+import { useCallback, useEffect, useRef, useState } from 'react'
+
+type Gateway = NonNullable<ReturnType<typeof host.getGateway>>
+
+interface PendingResponse {
+  gateway: Gateway
+  connection: string | null
+  key: string
+}
+
+interface InboxSnapshot {
+  gateway: Gateway | null
+  connection: string | null
+  profile: string
+  items: OwnerInboxItem[]
+  status: 'loading' | 'ready' | 'unavailable'
+  retrying?: boolean
+}
+
+export function ownerPromptKey(prompt: OwnerInboxItem) {
+  return JSON.stringify([prompt.profile, prompt.session_id, prompt.authority_epoch, prompt.execution_generation, prompt.prompt_id,
+    prompt.kind === 'clarify' ? prompt.question_id : undefined])
+}
+
+export function useOwnerInbox(beforeReady: () => void, beforeRowsChange: (keepsRow: (key: string) => boolean, nextItems?: OwnerInboxItem[]) => void) {
+  const connection = useValue(host.state.connectionId)
+  const profile = useValue(host.state.profile)
+  const socketState = useValue(host.state.gateway)
+  const gateway = socketState === 'open' ? host.getGateway() : null
+  const [snapshot, setSnapshot] = useState<InboxSnapshot | null>(null)
+  const refreshRead = useRef<((manual?: boolean) => void) | null>(null)
+  const readyScope = useRef<(() => boolean) | null>(null)
+  const invalidateRead = useRef<(() => void) | null>(null)
+  const [pending] = useState(() => atom<PendingResponse[]>([]))
+  const latestResponse = useRef<PendingResponse | null>(null)
+  const responses = useValue(pending)
+  const includesResponse = (entries: PendingResponse[], key: string) =>
+    entries.some(entry => entry.gateway === gateway && entry.connection === connection && entry.key === key)
+
+
+  const isCurrentScope = useCallback(() =>
+    host.getGateway() === gateway && host.state.gateway.get() === 'open' &&
+    host.state.connectionId.get() === connection && host.state.profile.get() === profile,
+  [connection, gateway, profile])
+
+  useEffect(() => {
+    setSnapshot(current => {
+      if (current?.connection !== connection || current.profile !== profile) return null
+      if (gateway) return current
+      // Keep Local draft rows mounted while their transport reconnects.
+      return connection === 'local' ? { ...current, gateway: null, status: 'unavailable', retrying: false } : null
+    })
+    if (!gateway) return
+
+    const lifetime = new AbortController()
+    let reading = false, dirty = false
+    invalidateRead.current = () => {
+      if (reading) dirty = true
+    }
+
+    const refresh = async (manual = false) => {
+      if (lifetime.signal.aborted) { return }
+
+      if (reading) {
+        if (!manual) dirty = true
+
+        return
+      }
+
+      reading = true
+      if (manual) {
+        setSnapshot(current => current?.status === 'unavailable' ? { ...current, retrying: true } : current)
+      }
+
+      do {
+        dirty = false
+
+        try {
+          const { items } = await gateway.request<OwnerInboxList>(
+            'owner_inbox.list', {}, undefined, lifetime.signal
+          )
+
+          if (!dirty && !lifetime.signal.aborted && isCurrentScope()) {
+            readyScope.current = isCurrentScope
+            beforeReady()
+            beforeRowsChange(key => items.some(item => ownerPromptKey(item) === key), items)
+            setSnapshot({ gateway, connection, profile, items, status: 'ready' })
+          }
+        } catch {
+          if (!dirty && !lifetime.signal.aborted && isCurrentScope()) {
+            readyScope.current = null
+            setSnapshot(current => ({
+              gateway,
+              connection,
+              profile,
+              items: current?.connection === connection && current.profile === profile &&
+                (current.gateway === gateway || connection === 'local') ? current.items : [],
+              status: 'unavailable'
+            }))
+          }
+        }
+      } while (dirty && !lifetime.signal.aborted)
+
+      reading = false
+    }
+
+    refreshRead.current = manual => {
+      if (isCurrentScope()) {
+        void refresh(manual)
+      }
+    }
+    const off = gateway.onEvent(event => {
+      if (event.type === 'owner_inbox.changed' || event.type === 'gateway.ready') { void refresh() }
+    })
+
+    void refresh()
+
+    return () => {
+      readyScope.current = null
+      invalidateRead.current = null
+      refreshRead.current = null
+      lifetime.abort()
+      off()
+
+      if (host.getGateway() === gateway && host.state.gateway.get() === 'open') {
+        void gateway.request('owner_inbox.unwatch').catch(() => undefined)
+      }
+    }
+  }, [beforeReady, beforeRowsChange, connection, gateway, isCurrentScope, profile])
+
+  const scoped = snapshot?.connection === connection && snapshot.profile === profile ? snapshot : null
+  const current = gateway && scoped?.gateway === gateway ? scoped : null
+
+  return {
+    connected: Boolean(gateway),
+    items: (connection === 'local' ? scoped : current)?.items ?? [],
+    status: current?.status ?? (gateway ? 'loading' : 'unavailable'),
+    refresh: () => refreshRead.current?.(),
+    retry: () => refreshRead.current?.(true),
+    retrying: current?.retrying ?? false,
+    isReady: () => current?.status === 'ready' && readyScope.current === isCurrentScope && isCurrentScope(),
+    isResponding: (prompt: OwnerInboxItem) => includesResponse(responses, ownerPromptKey(prompt)),
+    isRespondingNow: (prompt: OwnerInboxItem) => includesResponse(pending.get(), ownerPromptKey(prompt)),
+    async respond(prompt: OwnerInboxItem, value: string) {
+      if (!gateway || !readyScope.current?.() || !isCurrentScope()) {
+        throw new Error('The active inbox is not ready')
+      }
+
+      const key = ownerPromptKey(prompt)
+      if (includesResponse(pending.get(), key)) return
+      const invalidate = invalidateRead.current
+      const response = { gateway, connection, key }
+      latestResponse.current = response
+      pending.set([...pending.get(), response])
+
+      try {
+        const { profile: owner, session_id, prompt_id, execution_generation, authority_epoch, kind } = prompt
+        const result = await gateway.request<OwnerInboxResponse>(
+          'owner_inbox.respond', {
+            profile: owner, session_id, prompt_id, execution_generation, authority_epoch, kind, value,
+            question_id: kind === 'clarify' ? prompt.question_id : undefined
+          }
+        )
+
+        if (invalidate && invalidateRead.current === invalidate && host.getGateway() === gateway &&
+            host.state.gateway.get() === 'open' && host.state.connectionId.get() === connection &&
+            host.state.profile.get() === profile) {
+          // A list started before settlement can still contain the answered prompt.
+          invalidate()
+          beforeRowsChange(focusedKey => focusedKey !== key)
+          setSnapshot(current => current?.gateway === gateway && current.connection === connection &&
+            current.profile === profile
+            ? { ...current, items: current.items.filter(item => ownerPromptKey(item) !== key) }
+            : current)
+        }
+
+        // Older responses still settle their rows. The shared receipt belongs to the latest submission.
+        return latestResponse.current === response ? result.status : undefined
+      } finally {
+        pending.set(pending.get().filter(entry => entry !== response))
+      }
+    }
+  }
+}
