+++ b/tests/hermes_cli/test_kanban_role_flow.py
@@ -0,0 +1,296 @@
+"""Native role handoffs, idempotency and review: isolated SQLite, zero inference."""
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli.bot_workflow import configure_workflow, workflow_snapshot
+
+
+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path / 'user')
+    home = tmp_path / 'state'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(tmp_path / 'board'))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    for name, mode, peer in [('developer-think', 'think', 'developer-action'),
+                             ('developer-action', 'action', 'developer-think')]:
+        root = home / 'profiles' / name
+        root.mkdir(parents=True)
+        (root / 'config.yaml').write_text('model:\n  default: offline-only\nfallback_providers: []\n')
+        configure_workflow(root, {'role': 'developer', 'mode': mode, 'family': 'gpt',
+                                  'counterpart': peer}, workflow_snapshot(root)['revision'])
+    conn = kbc.connect()
+    yield conn, home, tmp_path
+    conn.close()
+
+
+def create(world, assignee, body='bounded offline task'):
+    conn, _, root = world
+    return kb.create_task(conn, title='native role fixture', assignee=assignee,
+                          body=body, workspace_kind='dir', workspace_path=str(root))
+
+
+def plan():
+    return {'version': 1, 'role': 'developer', 'constraints': ['No model calls; no paid fallback'],
+            'steps': [{'id': 'code', 'instructions': 'Write the deterministic fixture.',
+                       'acceptance': ['Offline unit test passes'], 'write_scope': ['src/a.py']},
+                      {'id': 'docs', 'instructions': 'Document the fixture.',
+                       'acceptance': ['Document matches implementation'], 'write_scope': ['docs/a.md']}]}
+
+
+def finish_plan(world, value=None):
+    conn = world[0]
+    tid = create(world, 'developer-think')
+    run = kb.claim_task(conn, tid)
+    assert kb.complete_task(conn, tid, summary='Plan ready', metadata={'role_plan': value or plan()},
+                            expected_run_id=run.current_run_id, fire_lifecycle_hook=False)
+    return tid, run.current_run_id
+
+
+def action(world, parent, step='code', **kwargs):
+    from tools import kanban_tools as kt
+    result = json.loads(kt._handle_create({'title': 'Execute planned step',
+                         'assignee': 'developer-action', 'plan_task': parent, 'plan_step': step,
+                         'workspace_kind': 'dir', 'workspace_path': str(world[2]), **kwargs}))
+    assert result.get('ok'), result
+    return result['task_id']
+
+
+def test_think_cannot_complete_without_durable_plan(world):
+    conn = world[0]
+    tid = create(world, 'developer-think')
+    run = kb.claim_task(conn, tid)
+    with pytest.raises(ValueError, match='role_plan'):
+        kb.complete_task(conn, tid, summary='trust me', expected_run_id=run.current_run_id)
+    assert kb.get_task(conn, tid).status == 'running'
+
+
+@pytest.mark.parametrize('family', ['gpt', 'claude', 'agy', 'nim', 'web'])
+def test_native_plan_action_review_loop_is_provider_independent(world, family):
+    conn, home, _ = world
+    for name in ('developer-think', 'developer-action'):
+        root = home / 'profiles' / name
+        snapshot = workflow_snapshot(root)
+        configure_workflow(root, {**snapshot['workflow'], 'family': family}, snapshot['revision'])
+    parent, parent_run = finish_plan(world)
+    tid = action(world, parent)
+    run = kb.claim_task(conn, tid)
+    context = kb.build_worker_context(conn, tid)
+    assert 'Write the deterministic fixture.' in context and str(parent_run) in context
+    assert 'No model calls; no paid fallback' in context
+    assert kb.request_review(conn, tid, summary='Implementation and tests complete',
+                             reviewer='independent-reviewer', expected_run_id=run.current_run_id)
+    review = kb.claim_review_task(conn, tid)
+    assert review.assignee == 'independent-reviewer'
+    assert kb.complete_task(conn, tid, summary='Independent review passed',
+                            expected_run_id=review.current_run_id, fire_lifecycle_hook=False)
+    assert kb.get_task(conn, tid).status == 'done'
+    assert kb.latest_run(conn, tid).profile == 'independent-reviewer'
+
+
+def test_unbound_action_rejected_before_native_claim_or_model(world):
+    conn = world[0]
+    tid = create(world, 'developer-action')
+    with pytest.raises(ValueError, match='plan'):
+        kb.claim_task(conn, tid)
+    assert kb.get_task(conn, tid).status == 'ready'
+    assert kb.list_runs(conn, tid) == []
+
+
+def test_duplicate_step_reuses_task_and_independent_steps_are_ready(world):
+    conn = world[0]
+    parent, _ = finish_plan(world)
+    first = action(world, parent)
+    assert action(world, parent) == first
+    second = action(world, parent, 'docs')
+    assert first != second
+    assert kb.get_task(conn, first).status == kb.get_task(conn, second).status == 'ready'
+    assert kb.claim_task(conn, first) and kb.claim_task(conn, second)
+
+
+def test_changed_duplicate_brief_is_refused_without_second_task(world):
+    from tools import kanban_tools as kt
+    conn = world[0]
+    parent, _ = finish_plan(world)
+    action(world, parent, body='original scope')
+    before = conn.execute('SELECT COUNT(*) FROM tasks').fetchone()[0]
+    result = json.loads(kt._handle_create({'title': 'changed', 'assignee': 'developer-action',
+                         'plan_task': parent, 'plan_step': 'code', 'body': 'different scope',
+                         'workspace_kind': 'dir', 'workspace_path': str(world[2])}))
+    assert 'error' in result and 'changed' in result['error']
+    assert conn.execute('SELECT COUNT(*) FROM tasks').fetchone()[0] == before
+
+
+def test_plan_parent_reopened_refuses_action_and_keeps_original_run(world):
+    conn = world[0]
+    parent, _ = finish_plan(world)
+    tid = action(world, parent)
+    run = kb.claim_task(conn, tid)
+    # Simulate an external status writer between the worker and its completion.
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (parent,))
+    assert not kb.complete_task(conn, tid, summary='stale implementation', expected_run_id=run.current_run_id)
+    assert kb.get_task(conn, tid).current_run_id == run.current_run_id
+
+
+def test_overlapping_parallel_plan_steps_are_rejected(world):
+    value = plan()
+    value['steps'][1]['write_scope'] = ['src']
+    with pytest.raises(ValueError, match='overlap'):
+        finish_plan(world, value)
+
+
+def test_ordered_overlapping_steps_wait_for_prior_action(world):
+    value = plan()
+    value['steps'][1].update(write_scope=['src/a.py'], after=['code'])
+    conn = world[0]
+    parent, _ = finish_plan(world, value)
+    first = action(world, parent)
+    second = action(world, parent, 'docs')
+    assert kb.get_task(conn, second).status == 'todo'
+    run = kb.claim_task(conn, first)
+    assert kb.complete_task(conn, first, summary='First step done', expected_run_id=run.current_run_id,
+                            fire_lifecycle_hook=False)
+    assert kb.get_task(conn, second).status == 'ready'
+
+
+def test_legacy_tasks_and_existing_provider_settings_unchanged(world):
+    conn, home, _ = world
+    before = {p: hashlib.sha256(p.read_bytes()).hexdigest() for p in home.rglob('config.yaml')}
+    tid = create(world, 'legacy-worker')
+    run = kb.claim_task(conn, tid)
+    assert kb.complete_task(conn, tid, summary='Legacy task done', expected_run_id=run.current_run_id,
+                            fire_lifecycle_hook=False)
+    assert before == {p: hashlib.sha256(p.read_bytes()).hexdigest() for p in before}
+
+
+def test_material_failure_returns_to_role_think_without_replaying_action(world):
+    from tools import kanban_tools as kt
+    conn = world[0]
+    parent, _ = finish_plan(world)
+    tid = action(world, parent)
+    run = kb.claim_task(conn, tid)
+    assert kb.block_task(conn, tid, reason='Plan needs a different supported input format',
+                          kind='capability', expected_run_id=run.current_run_id)
+    args = {'title': 'Revise the plan', 'assignee': 'developer-think', 'replan_of': tid,
+            'workspace_kind': 'dir', 'workspace_path': str(world[2])}
+    reply = json.loads(kt._handle_create(args))
+    assert reply.get('ok'), reply
+    assert json.loads(kt._handle_create(args))['task_id'] == reply['task_id']
+    revised = kb.get_task(conn, reply['task_id'])
+    assert revised.assignee == 'developer-think' and revised.status == 'ready'
+    assert 'different supported input format' in kb.build_worker_context(conn, revised.id)
+    assert kb.get_task(conn, tid).status == 'blocked'
+    assert len(kb.list_runs(conn, tid)) == 1
+    think = kb.claim_task(conn, revised.id)
+    value = plan()
+    value['steps'][0]['instructions'] = 'Use the newly supported format.'
+    assert kb.complete_task(conn, revised.id, summary='Revised plan ready', metadata={'role_plan': value},
+                            expected_run_id=think.current_run_id, fire_lifecycle_hook=False)
+    new = action(world, revised.id)
+    assert new != tid and kb.get_task(conn, new).status == 'ready'
+
+
+def test_missing_plan_is_parked_once_without_worker_or_failure_retry(world):
+    from hermes_cli import kanban_db_dispatch as dispatch
+    conn = world[0]
+    tid = create(world, 'developer-action')
+    spawns = []
+    for _ in range(2):
+        dispatch.dispatch_once(conn, spawn_fn=lambda *a, **k: spawns.append(a), reconcile_orphans=False)
+    task = kb.get_task(conn, tid)
+    assert not spawns and task.status == 'blocked' and task.block_kind == 'capability'
+    assert task.consecutive_failures == 0
+    assert not any(e.kind == 'claimed' for e in kb.list_events(conn, tid))
+
+
+def test_review_changes_return_to_original_action_not_an_unrelated_thinker(world):
+    conn = world[0]
+    parent, _ = finish_plan(world)
+    tid = action(world, parent)
+    run = kb.claim_task(conn, tid)
+    assert kb.request_review(conn, tid, summary='Ready for review', reviewer='independent-reviewer',
+                             expected_run_id=run.current_run_id)
+    reviewer = kb.claim_review_task(conn, tid)
+    ok, assignee = kb.request_changes(conn, tid, reason='Add the missing boundary test',
+                                      expected_run_id=reviewer.current_run_id)
+    assert ok and assignee == 'developer-action'
+    retry = kb.claim_task(conn, tid)
+    assert retry.assignee == 'developer-action'
+    assert 'Write the deterministic fixture.' in kb.build_worker_context(conn, tid)
+
+
+def test_wrong_counterpart_cannot_consume_another_role_plan(world):
+    from tools import kanban_tools as kt
+    parent, _ = finish_plan(world)
+    result = json.loads(kt._handle_create({'title': 'Wrong worker', 'assignee': 'foreign-action',
+                                          'plan_task': parent, 'plan_step': 'code'}))
+    assert 'error' in result and 'paired ACTION' in result['error']
+
+
+def test_saved_plan_is_not_a_live_reference_to_callers_mutable_dict(world):
+    conn = world[0]
+    value = plan()
+    parent, _ = finish_plan(world, value)
+    value['steps'][0]['instructions'] = 'Unexpected later edit'
+    tid = action(world, parent)
+    assert 'Write the deterministic fixture.' in kb.build_worker_context(conn, tid)
+    assert 'Unexpected later edit' not in kb.build_worker_context(conn, tid)
+
+
+def test_scope_widening_and_missing_prior_step_are_refused(world):
+    from tools import kanban_tools as kt
+    parent, _ = finish_plan(world)
+    body = '```hermes-contract\n' + json.dumps({'version': 1, 'write_scope': ['.']}) + '\n```'
+    result = json.loads(kt._handle_create({'title': 'Wider writes', 'assignee': 'developer-action',
+                                          'plan_task': parent, 'plan_step': 'code', 'body': body}))
+    assert 'error' in result and 'write_scope' in result['error']
+    value = plan()
+    value['steps'][1]['after'] = ['code']
+    parent, _ = finish_plan(world, value)
+    result = json.loads(kt._handle_create({'title': 'Wrong order', 'assignee': 'developer-action',
+                                          'plan_task': parent, 'plan_step': 'docs'}))
+    assert 'error' in result and 'preceding ACTION' in result['error']
+
+
+def test_duplicate_step_after_review_returns_the_completed_task(world):
+    conn = world[0]
+    parent, _ = finish_plan(world)
+    tid = action(world, parent)
+    run = kb.claim_task(conn, tid)
+    assert kb.request_review(conn, tid, summary='Ready', reviewer='independent-reviewer',
+                             expected_run_id=run.current_run_id)
+    review = kb.claim_review_task(conn, tid)
+    assert kb.complete_task(conn, tid, summary='Reviewed', expected_run_id=review.current_run_id,
+                            fire_lifecycle_hook=False)
+    assert action(world, parent) == tid
+
+
+def test_reused_completed_step_does_not_create_a_new_claim(world):
