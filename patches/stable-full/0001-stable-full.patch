+"""Compact routing metadata uses native profile/dispatch rules without provider work."""
+import argparse
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli.config import atomic_config_write, atomic_config_replace
+
+
+@pytest.fixture
+def fleet(tmp_path, monkeypatch):
+    root=tmp_path/'state';root.mkdir()
+    monkeypatch.setenv('HERMES_HOME',str(root))
+    monkeypatch.setattr(Path,'home',lambda:tmp_path)
+    atomic_config_write(root/'config.yaml',{'kanban':{'dispatch_profiles':['think','action','analyst']}})
+    for name,model,workflow in [
+        ('think','gpt-6.1-sol',{'role':'developer','mode':'think','family':'gpt','counterpart':'action'}),
+        ('action','gpt-6.1-terra',{'role':'developer','mode':'action','family':'gpt','counterpart':'think'}),
+        ('analyst','gpt-6.1-terra',None),('held','gpt-6-astra',None)]:
+        p=root/'profiles'/name;p.mkdir(parents=True)
+        cfg={'model':{'default':model,'provider':'openai-codex','api_key':'synthetic-private-sentinel'},
+             'agent':{'reasoning_effort':'max','reasoning_effort_limits':{'gpt-6.1-terra':'high'}}}
+        if workflow:cfg['bot_workflow']=workflow
+        atomic_config_write(p/'config.yaml',cfg)
+    return root
+
+
+def test_existing_profile_list_parser_accepts_opt_in_snapshot():
+    from hermes_cli.subcommands.profile import build_profile_parser
+    parser=argparse.ArgumentParser();build_profile_parser(parser.add_subparsers(),cmd_profile=lambda args:None)
+    args=parser.parse_args(['profile','list','--routing-json'])
+    assert args.routing_json is True
+
+
+def test_cli_returns_only_safe_native_routing_fields_without_full_profile_walk(fleet,monkeypatch,capsys):
+    from hermes_cli import profiles,profile_cmd
+    monkeypatch.setattr(profiles,'list_profiles',lambda **kw:pytest.fail('No gateway or skill-count inventory'))
+    before={p:p.read_bytes() for p in fleet.rglob('config.yaml')}
+    profile_cmd._profile_list(SimpleNamespace(routing_json=True))
+    result=json.loads(capsys.readouterr().out)
+    assert result['readiness']=='not_probed' and result['truncated'] is False
+    rows={x['name']:x for x in result['profiles']}
+    assert set(rows)=={'think','action','analyst'}
+    assert rows['think']['workflow']['counterpart']=='action'
+    assert rows['think']['pair_status']=='linked' and rows['think']['dispatch_admitted'] is True
+    assert rows['action']['model']['effort']=='high' and rows['action']['model']['effort_limit']=='high'
+    assert rows['analyst']['workflow'] is None
+    assert 'synthetic-private-sentinel' not in json.dumps(result)
+    assert {p:p.read_bytes() for p in fleet.rglob('config.yaml')}==before
+
+
+def test_pair_requires_both_admissions_even_from_a_routed_caller(fleet):
+    from hermes_cli.profile_routing import routing_snapshot
+    from hermes_constants import set_hermes_home_override,reset_hermes_home_override
+    atomic_config_replace(fleet/'config.yaml',{'kanban':{'dispatch_profiles':['think','analyst']}})
+    atomic_config_replace(fleet/'profiles/analyst/config.yaml',{'kanban':{'dispatch_profiles':['think','action','held']}})
+    token=set_hermes_home_override(fleet/'profiles/analyst')
+    try:result=routing_snapshot()
+    finally:reset_hermes_home_override(token)
+    rows={x['name']:x for x in result['profiles']}
+    assert set(rows)=={'think','analyst'}
+    assert rows['think']['dispatch_admitted'] is False
+    assert rows['think']['pair_status']=='not_admitted'
+
+
+def test_invalid_counterpart_fails_closed_without_error_content(fleet):
+    from hermes_cli.profile_routing import routing_snapshot
+    atomic_config_replace(fleet/'profiles/action/config.yaml',{'bot_workflow':{}})
+    rows={x['name']:x for x in routing_snapshot()['profiles']}
+    assert rows['think']['pair_status']=='one_way' and rows['think']['dispatch_admitted'] is False
+    (fleet/'profiles/analyst/config.yaml').write_text('model: [bad yaml synthetic-private-sentinel')
+    result=routing_snapshot();row=next(x for x in result['profiles'] if x['name']=='analyst')
+    assert row['pair_status']=='unreadable' and row['dispatch_admitted'] is False
+    assert 'synthetic-private-sentinel' not in json.dumps(result)
+    assert not list(fleet.rglob('*.corrupt.*'))
