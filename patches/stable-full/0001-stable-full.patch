@@ -0,0 +1,73 @@
+import { Codicon, Tip } from '@hermes/plugin-sdk'
+
+import { useBots } from './i18n'
+import { stripPreviewMarkdown } from './labels'
+import { activeWorkerSessions, workerProgress } from './row-helpers'
+import type { RosterRow } from './types'
+
+/** Observed worker stamps stay separate from the canonical conversation's preview and click identity. */
+export function BotWorkerActivity({ bot, showAll = false }: { bot: RosterRow; showAll?: boolean }) {
+  const b = useBots()
+  const workers = activeWorkerSessions(bot)
+
+  if (!workers.length) {
+    return null
+  }
+
+  const countLabel = `${b.roster.workerActivity} · ${workers.length}`
+  const scrollable = showAll && workers.length > 1
+
+  return (
+    <div className="min-w-0 space-y-1 text-xs text-(--ui-text-tertiary)">
+      {(showAll || workers.length > 1) && <div>{countLabel}</div>}
+      <div
+        aria-label={scrollable ? countLabel : undefined}
+        className={scrollable ? 'max-h-48 space-y-2 overflow-y-auto overscroll-contain rounded-sm focus-visible:outline-2 focus-visible:outline-(--ui-accent)' : undefined}
+        role={scrollable ? 'region' : undefined}
+        tabIndex={scrollable ? 0 : undefined}
+      >
+        {(showAll ? workers : workers.slice(0, 1)).map((worker, index) => {
+          const title = stripPreviewMarkdown(worker.title || '').replace(/\s+/g, ' ').trim().slice(0, 120)
+
+          const detail = stripPreviewMarkdown(worker.last_activity_description || worker.title || '')
+            .replace(/\s+/g, ' ')
+            .trim()
+            .slice(0, 120)
+
+          const label = detail ? `${b.roster.workerActivity} · ${detail}` : b.roster.workerActivity
+          const { elapsed, step, tokens, tool } = workerProgress(worker)
+
+          // Icon-led "doing now" facts; anything the gateway did not send is simply absent.
+          const facts = [
+            tool && ['symbol-method', tool],
+            step && ['debug-step-over', b.roster.workerStep(step.n, step.max)],
+            elapsed && ['watch', elapsed],
+            tokens && ['symbol-numeric', b.roster.workerTokens(tokens.input, tokens.output)]
+          ].filter((fact): fact is [string, string] => Boolean(fact))
+
+          return (
+            <Tip key={worker.id || index} label={[title !== detail && title, label, ...facts.map(([, text]) => text)].filter(Boolean).join(' · ')}>
+              <div className="min-w-0">
+                {showAll && title && title !== detail && <div className="line-clamp-2 text-(--ui-text-secondary)">{title}</div>}
+                <div className="flex min-w-0 items-center gap-1.5">
+                  <Codicon className="shrink-0 text-[0.6875rem]" name="tools" />
+                  <span className={showAll ? 'min-w-0 break-words' : 'min-w-0 truncate'}>{detail || b.roster.workerActivity}</span>
+                </div>
+                {facts.length > 0 && (
+                  <div className="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-0.5">
+                    {facts.map(([icon, text]) => (
+                      <span className="flex min-w-0 max-w-full items-center gap-1" key={icon}>
+                        <Codicon className="shrink-0 text-[0.6875rem]" name={icon} />
+                        <span className="min-w-0 break-all">{text}</span>
+                      </span>
+                    ))}
+                  </div>
+                )}
+              </div>
+            </Tip>
+          )
+        })}
+      </div>
+    </div>
+  )
+}
