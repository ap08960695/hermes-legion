+    prompt_id: str
+    execution_generation: int
+    authority_epoch: int | None = None
+    question_id: str | None = None
+    kind: Literal['clarify', 'approval']
+    value: str
+
+
+class OwnerInboxResponse(Result):
+    status: Literal['resolved', 'expired']
+
+
+for register in (method, canonical_method):
+    register('owner_inbox.list', params=OwnerInboxParams, result=OwnerInboxList,
+             doc='Watch and list pending owner questions and approvals on the active gateway.')
+    register('owner_inbox.unwatch', params=OwnerInboxParams, result=OwnerInboxUnwatch,
+             doc='Stop inbox invalidations on this socket.')
+    register('owner_inbox.respond', params=OwnerInboxRespondParams, result=OwnerInboxResponse,
+             doc='Settle exactly one still-open question or approval on its owning session.')
+
+event('owner_inbox.changed', doc='Content-free invalidation for a socket watching the owner inbox.')
