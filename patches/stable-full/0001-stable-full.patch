+"""Model-facing discovery of synthetic multimodal session history."""
+import base64
+import json
+
+import pytest
+
+from hermes_state import SessionDB
+from tools.session_search_tool import session_search
+
+
+@pytest.fixture
+def db(tmp_path):
+    store = SessionDB(tmp_path / 'state.db')
+    yield store
+    store.close()
+
+
+def test_discovery_recovers_unicode_and_reports_bounded_page_metadata(db):
+    db.create_session('past', source='cli')
+    text = 'x' * 5000 + ' ข้อความภาษาไทย ' + 'y' * 5000
+    mid = db.append_message('past', role='user', content=[{'type': 'text', 'text': text},
+                            {'type': 'image_url', 'image_url': {'url': 'IMAGEONLYMARKER'}}])
+    result = json.loads(session_search(db=db, query='ข้อความภาษาไทย'))
+    hit = next(entry for entry in result['results'] if entry['session_id'] == 'past')
+    assert hit['match_message_id'] == mid
+    assert hit['snippet_field'] == 'text' and hit['offset_unit'] == 'characters'
+    assert 'ข้อความภาษาไทย' in hit['snippet'] and 'IMAGEONLYMARKER' not in json.dumps(result)
+    page = json.loads(session_search(db=db, session_id='past', around_message_id=mid,
+                      content_offset=hit['snippet_offset'], content_field=hit['snippet_field']))
+    assert page['success'] and 'ข้อความภาษาไทย' in page['content']
+
+
+def test_discovery_does_not_surface_image_only_or_json_structural_hits(db):
+    db.create_session('past', source='cli')
+    db.append_message('past', role='user', content=[{'type': 'text', 'text': 'human words'},
+                      {'type': 'image_url', 'image_url': {'url': 'IMAGEONLYMARKER'}}])
+    for needle in ('IMAGEONLYMARKER', 'text'):
+        result = json.loads(session_search(db=db, query=needle))
+        assert result['success'] and not result['results']
+
+
+def test_discovery_reports_undecodable_tool_calls_as_error(db):
+    db.create_session('past', source='cli')
+    mid = db.append_message('past', role='assistant', content='ordinary')
+    invalid = b'{"arguments":"caf\\u00e9\xff"}'
+    db._execute_write(lambda conn: conn.execute(
+        'UPDATE messages SET tool_calls=CAST(? AS TEXT) WHERE id=?', (invalid, mid),
+    ))
+    result = json.loads(session_search(db=db, query='cafe'))
+    assert not result['success']
+    assert result.get('error')
+
+
+def test_discovery_binary_excerpt_can_be_paged_without_invalid_unicode(db):
+    db.create_session('past', source='cli')
+    mid = db.append_message('past', role='user', content=[{'type': 'text', 'text': 'alpha\ud800beta'}])
+    raw = session_search(db=db, query='beta')
+    raw.encode('utf-8')
+    hit = json.loads(raw)['results'][0]
+    assert hit['match_message_id'] == mid and hit['snippet_encoding'] == 'base64'
+    page = json.loads(session_search(db=db, session_id='past', around_message_id=mid,
+                      content_offset=hit['snippet_offset'], content_field=hit['snippet_field']))
+    assert base64.b64decode(page['content']).decode('utf-8', 'surrogatepass') == 'alpha\ud800beta'
