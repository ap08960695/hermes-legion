+        finally:
+            reset_hermes_home_override(token)
+        return _rows(db)
+
+    monkeypatch.setattr("agent.auxiliary_client.call_llm", response_boundary)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        rows = list(pool.map(evaluate, owners))
