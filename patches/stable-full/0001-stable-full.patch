+import { beforeEach, expect, it } from 'vitest'
+
+import { $characterSettings, characterScope, getCharacterSettings, migrateLegacyCharacterSettings, setCharacterSettings } from './character-settings'
+
+const local = characterScope('local', 'default')
+const second = characterScope('local', 'second')
+beforeEach(() => {
+  localStorage.clear()
+  $characterSettings.set({})
+})
+
+it('translates each legacy preference once and preserves the result across reload', () => {
+  expect(migrateLegacyCharacterSettings(local, { enabled: true, scale: 0.6 })).toBe(true)
+  expect(migrateLegacyCharacterSettings(second, { enabled: false, scale: '0.18' })).toBe(true)
+  $characterSettings.set({})
+  expect(getCharacterSettings(local)).toEqual({ enabled: true, size: 'large' })
+  expect(getCharacterSettings(second)).toEqual({ enabled: false, size: 'small' })
+  expect(migrateLegacyCharacterSettings(second, { enabled: true })).toBe(false)
+})
+
+it('preserves explicit settings and falls back for missing or invalid legacy values', () => {
+  setCharacterSettings(local, { enabled: false, size: 'large' })
+  expect(migrateLegacyCharacterSettings(local, { enabled: true, scale: 0.13 })).toBe(false)
+  expect(getCharacterSettings(local)).toEqual({ enabled: false, size: 'large' })
+  expect(migrateLegacyCharacterSettings(second, { scale: -2 })).toBe(true)
+  expect(getCharacterSettings(second)).toEqual({ enabled: false, size: 'medium' })
+})
