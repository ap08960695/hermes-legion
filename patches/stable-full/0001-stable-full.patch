+@pytest.mark.parametrize("new_process", [False, True])
+def test_server_detection_catalog_is_credential_scoped(monkeypatch, new_process):
+    metadata._endpoint_probe_path_cache.clear()
+    client = httpx.Client
+
+    def reply(request):
+        if request.headers["Authorization"] == "Bearer synthetic-owner-a":
+            return httpx.Response(200, json={"data": []})
+        if request.url.path.endswith("/api/tags"):
+            return httpx.Response(200, json={"models": []})
+        return httpx.Response(404)
+
+    monkeypatch.setattr(httpx, "Client", lambda **kw: client(transport=httpx.MockTransport(reply), **kw))
+    assert metadata.detect_local_server_type(BASE, "synthetic-owner-a") == "lm-studio"
+    if new_process:
+        metadata._endpoint_probe_path_cache.clear()
+    assert metadata.detect_local_server_type(BASE, "synthetic-owner-b") == "ollama"
