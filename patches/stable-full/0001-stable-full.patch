+    expect(gatewayRequest).toHaveBeenCalledTimes(4)
+
+    act(() => refresh(JSON.stringify(['local', 'default']), true))
+    await waitFor(() => expect($petCharacterPreview.get()?.characters[0]?.sprite?.displayName).toBe('Owned 11'))
+    expect(sprite).toHaveBeenCalledTimes(2)
