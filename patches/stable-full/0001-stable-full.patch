+  taskId: string
+  unavailable: boolean
+}> {
+  getSnapshotBeforeUpdate(previous: this['props']) {
+    const close = this.props.closeButton.current
+    const focused = close?.ownerDocument.activeElement
+    if (!focused || !close?.closest('[role="dialog"]')?.contains(focused)) return null
+
+    const changedCard = previous.taskId !== this.props.taskId
+    const becameUnavailable = this.props.unavailable && !previous.unavailable
+    const lostEvidence = previous.hasEvidence && !this.props.hasEvidence
+    const summary = !changedCard && !becameUnavailable && previous.revision !== this.props.revision
+      ? focused.closest('.kanban-revision')?.querySelector('summary')
+      : undefined
+
+    return changedCard || becameUnavailable || lostEvidence || summary ? { focused, summary } : null
+  }
+
+  componentDidUpdate(_previous: this['props'], _state: unknown, snapshot: ReturnType<TaskDrawerFocus['getSnapshotBeforeUpdate']>) {
+    const close = this.props.closeButton.current
+    if (!close || !snapshot || snapshot.focused.isConnected) return
+
+    const doc = close.ownerDocument
+    const focused = doc.activeElement
+    if (focused === doc.body || focused === close.closest('[role="dialog"]')) {
+      const target = snapshot.summary?.isConnected ? snapshot.summary : close
+      target.focus({ preventScroll: true })
+    }
+  }
+
+  render() {
+    return null
+  }
