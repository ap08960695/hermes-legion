index 0000000000000000000000000000000000000000..7e9d4334658d6c32f9471eb21c06fe0a0d22d889
--- /dev/null
+++ b/apps/desktop/src/app/pet-overlay/character-wander.ts
@@ -0,0 +1,76 @@
+import type { PetInfo } from '@/store/pet'
+
+type Weight = NonNullable<PetInfo['motionWeight']>
+export type WanderBounds = { min: number; max: number }
+export type WanderRect = { left: number; right: number; top: number; bottom: number }
+type Gesture = 'look' | 'sit' | 'stretch' | 'yawn' | 'hop'
+type Action = { kind: 'walk'; target: number; turnAt?: number; speed: number } | { kind: Gesture; duration: number }
+
+const movement = {
+  light: { speed: 29, distance: 30, pause: 0.85 },
+  standard: { speed: 22, distance: 24, pause: 1 },
+  heavy: { speed: 15, distance: 18, pause: 1.2 }
+}
+
+export function createWander(id: string) {
+  let seed = 2166136261
+  for (let i = 0; i < id.length; i++) {seed = Math.imul(seed ^ id.charCodeAt(i), 16777619)}
+
+  const random = () => {
+    seed = (seed + 0x6d2b79f5) | 0
+    let value = Math.imul(seed ^ (seed >>> 15), seed | 1)
+    value ^= value + Math.imul(value ^ (value >>> 7), value | 61)
+
+    return ((value ^ (value >>> 14)) >>> 0) / 4294967296
+  }
+  const energy = random(), curiosity = random()
+
+  return {
+    pause: (weight: Weight) => (430 + random() * (2_800 - energy * 1_200)) * movement[weight].pause,
+    next(offset: number, bounds: WanderBounds, weight: Weight, canHop: boolean): Action {
+      const { speed, distance } = movement[weight]
+      const roll = random()
+      const left = offset - bounds.min, right = bounds.max - offset
+
+      if (roll < 0.65 + energy * 0.16 && Math.max(left, right) >= 8) {
+        const dir = left < 8 || (right >= 8 && random() < 0.5) ? 1 : -1
+        const range = dir === 1 ? right : left
+        const length = Math.min(range, distance * (0.45 + random() * 1.1))
+        const endpoint = offset + dir * length
+        const rate = speed * (0.78 + random() * 0.55)
+
+        if (length >= 16 && random() < 0.11 + curiosity * 0.11) {
+          return { kind: 'walk', turnAt: endpoint, target: endpoint - dir * length * (0.25 + random() * 0.44), speed: rate }
+        }
+
+        return { kind: 'walk', target: endpoint, speed: rate }
+      }
+
+      if (canHop && random() < 0.10 + curiosity * 0.06) {return { kind: 'hop', duration: 550 }}
+      const look = 0.22 + curiosity * 0.25
+      const sit = look + 0.12 + (1 - energy) * 0.25
+      const stretch = sit + 0.13 + energy * 0.12
+      const pose = random()
+      const kind = pose < look ? 'look' : pose < sit ? 'sit' : pose < stretch ? 'stretch' : 'yawn'
+
+      return { kind, duration: 650 + random() * 650 }
+    }
+  }
+}
+
+/** Reserve a gap along the whole path. Existing overlap can clear by moving away. */
+export function limitForNeighbors(own: WanderRect, neighbors: WanderRect[], offset: number, bounds: WanderBounds): WanderBounds {
+  let { min, max } = bounds
+  const center = own.left + own.right
+  for (const peer of neighbors) {
+    if (peer.top >= own.bottom || peer.bottom <= own.top) {continue}
+
+    if (peer.left + peer.right >= center) {
+      max = Math.min(max, offset + Math.max(0, peer.left - own.right - 6))
+    } else {
+      min = Math.max(min, offset + Math.min(0, peer.right - own.left + 6))
+    }
+  }
+
+  return { min, max }
+}
