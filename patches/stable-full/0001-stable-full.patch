+        (path.parent.parent / name).symlink_to(path.parent, target_is_directory=True)
+    with assignee_config('alpha'):
+        catalog = _skill_catalog(skip_disabled=True, include_hidden=True)
+    assert 'published-name' in {row['load_name'] for row in catalog}
+    assert _skills_available_for('alpha', ['published-name']) == (['published-name'], [])
