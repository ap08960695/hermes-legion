+"""Diagnostic reads leave unrelated task text and run evidence in SQLite."""
+from __future__ import annotations
+
+import importlib.util
+import json
+import sqlite3
+import sys
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_diagnostics as kd
+
+
+@pytest.fixture
+def diagnostic_board(tmp_path, monkeypatch):
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    kb.init_db()
+    source = Path(__file__).resolve().parents[2] / 'plugins/kanban/dashboard/plugin_api.py'
+    spec = importlib.util.spec_from_file_location('diagnostic_read_test_plugin', source)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = mod
+    spec.loader.exec_module(mod)
+    from hermes_cli import config
+    monkeypatch.setattr(config, 'load_config', dict)
+    monkeypatch.setattr(kd.time, 'time', lambda: 100_000)
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title='Simple diagnostic card', assignee='test-worker')
+        conn.execute("UPDATE tasks SET status='blocked',consecutive_failures=3,last_failure_error='failed check',"
+                     "body=?,result=?,created_at=1 WHERE id=?", ('b' * 100_000, 'r' * 100_000, tid))
+        conn.execute("INSERT INTO task_runs(task_id,profile,status,started_at,outcome,error,summary,metadata) "
+                     "VALUES (?,'test-worker','finished',1,'crashed','worker error',?,?)",
+                     (tid, 's' * 100_000, json.dumps({'unused': 'm' * 100_000})))
+        for kind, payload in [('completion_blocked_hallucination', {'phantom_cards': ['t_ffff0000']}),
+                              ('blocked', {'reason': 'missing input'}),
+                              ('gave_up', {'terminal_provider': True})]:
+            conn.execute('INSERT INTO task_events(task_id,kind,payload,created_at) VALUES (?,?,?,?)',
+                         (tid, kind, json.dumps(payload), 1))
+        conn.commit()
+        yield mod, conn, tid
+
+
+@pytest.mark.parametrize('filtered', [False, True])
+@pytest.mark.parametrize('legacy', [False, True])
+def test_diagnostic_reads_preserve_warnings_without_loading_unrelated_text(diagnostic_board, filtered, legacy):
+    mod, conn, tid = diagnostic_board
+    if legacy:
+        conn.execute('ALTER TABLE tasks ADD COLUMN last_spawn_error TEXT')
+        conn.execute('ALTER TABLE tasks ADD COLUMN spawn_failures INTEGER')
+        conn.execute('UPDATE tasks SET last_failure_error=NULL,last_spawn_error=?,spawn_failures=9 WHERE id=?',
+                     ('legacy error retained', tid))
+    task = conn.execute('SELECT * FROM tasks WHERE id=?', (tid,)).fetchone()
+    events = conn.execute('SELECT * FROM task_events WHERE task_id=? ORDER BY id', (tid,)).fetchall()
+    runs = conn.execute('SELECT * FROM task_runs WHERE task_id=? ORDER BY id', (tid,)).fetchall()
+    graph = kb.task_graph_contexts(conn, [tid])[tid]
+    expected = [d.to_dict() for d in kd.compute_task_diagnostics(task, events, runs, graph=graph)]
+    assert {'hallucinated_cards', 'repeated_failures', 'stuck_in_blocked'} <= {d['kind'] for d in expected}
+    if legacy:
+        assert next(d['data']['last_error'] for d in expected if d['kind'] == 'repeated_failures') == 'legacy error retained'
+    denied = {'tasks': {'body', 'result'}, 'task_runs': {'summary', 'metadata'}}
+
+    def authorize(action, table, column, *_):
+        if action == sqlite3.SQLITE_READ and column in denied.get(table, set()):
+            return sqlite3.SQLITE_DENY
+        return sqlite3.SQLITE_OK
+
+    before = conn.total_changes
+    conn.set_authorizer(authorize)
+    try:
+        assert mod._compute_task_diagnostics(conn, [tid] if filtered else None) == {tid: expected}
+        assert conn.total_changes == before
+    finally:
+        conn.set_authorizer(None)
