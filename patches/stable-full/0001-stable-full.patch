+import { expect, it } from 'vitest'
+
+import { createWander, limitForNeighbors } from './character-wander'
+
+const bounds = { min: -56, max: 56 }
+
+it('produces independent reproducible pauses and a varied action mix', () => {
+  function sample(seed: string) {
+    const model = createWander(seed)
+
+    return Array.from({ length: 80 }, () => [model.pause('standard'), model.next(0, bounds, 'standard', true)] as const)
+  }
+
+  const sequence = sample('first')
+  expect(sample('first')).toEqual(sequence)
+  expect(sample('second')).not.toEqual(sequence)
+  expect(new Set(sequence.map(([pause]) => pause)).size).toBeGreaterThan(20)
+  const actions = sequence.map(([, action]) => action)
+  expect(new Set(actions.map(action => action.kind))).toEqual(new Set(['walk', 'look', 'sit', 'stretch', 'yawn', 'hop']))
+  const walks = actions.filter(action => action.kind === 'walk')
+  expect(walks.some(action => action.turnAt !== undefined)).toBe(true)
+  expect(walks.some(action => action.target > 0)).toBe(true)
+  expect(walks.some(action => action.target < 0)).toBe(true)
+  expect(actions.filter(action => action.kind === 'hop').length).toBeLessThan(walks.length / 2)
+})
+
+it('keeps each path within its bounds and adjusts travel and speed for pack weight', () => {
+  for (const seed of ['first', 'second', 'third', 'fourth']) {
+    for (let i = 0; i < 32; i++) {
+      const light = createWander(seed + i), heavy = createWander(seed + i)
+      const fast = light.next(0, bounds, 'light', false), slow = heavy.next(0, bounds, 'heavy', false)
+      expect(fast.kind).not.toBe('hop')
+      expect(slow.kind).not.toBe('hop')
+      if (fast.kind !== 'walk' || slow.kind !== 'walk') {continue}
+      expect(fast.speed).toBeGreaterThan(slow.speed)
+      expect(Math.abs(fast.turnAt ?? fast.target)).toBeGreaterThanOrEqual(Math.abs(slow.turnAt ?? slow.target))
+      for (const point of [fast.target, fast.turnAt, slow.target, slow.turnAt]) {
+        if (point !== undefined) {
+          expect(point).toBeGreaterThanOrEqual(bounds.min)
+          expect(point).toBeLessThanOrEqual(bounds.max)
+        }
+      }
+    }
+  }
+})
+
+it('leaves room to move away from a crowd while avoiding another actor’s reserved path', () => {
+  const own = { left: 100, right: 140, top: 400, bottom: 460 }
+  expect(limitForNeighbors(own, [
+    { left: 170, right: 270, top: 395, bottom: 465 },
+    { left: 25, right: 70, top: 405, bottom: 465 },
+    { left: 142, right: 170, top: 320, bottom: 380 }
+  ], 0, bounds)).toEqual({ min: -24, max: 24 })
+  expect(limitForNeighbors(own, [{ left: 122, right: 170, top: 400, bottom: 460 }], 10, bounds))
+    .toEqual({ min: -56, max: 10 })
+})
diff --git a/apps/desktop/src/app/pet-overlay/character-wander.ts b/apps/desktop/src/app/pet-overlay/character-wander.ts
