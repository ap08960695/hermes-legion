@@ -0,0 +1,36 @@
+import { useQuery, useValue } from '@hermes/plugin-sdk'
+import { useState } from 'react'
+
+import { $boardSlug, boardsKey, fetchBoards, routedToScope, useKanbanScope } from './api'
+import type { BoardView } from './board-view'
+import { readWorkSelection, saveWorkSelection } from './work-selection'
+
+/** Persist presentation only. Restoring never claims, resumes or creates a task. */
+export function useWorkSelection() {
+  const scope = useKanbanScope(),
+    slug = useValue($boardSlug)
+
+  const { data } = useQuery({
+    queryKey: boardsKey(scope),
+    queryFn: fetchBoards,
+    enabled: query => !slug && routedToScope(query),
+    staleTime: 30_000
+  })
+
+  const board = slug || data?.current || ''
+  const identity = JSON.stringify([scope, board])
+  const [local, setLocal] = useState<{ identity: string; value: ReturnType<typeof readWorkSelection> } | null>(null)
+  const value = local?.identity === identity ? local.value : readWorkSelection(scope, board)
+
+  const update = (change: { view?: BoardView; taskId?: string | null }) => {
+    saveWorkSelection(scope, board, change)
+    setLocal({ identity, value: { ...value, ...change } })
+  }
+
+  return {
+    ...value,
+    board,
+    setView: (view: BoardView) => update({ view }),
+    select: (taskId: string | null) => update({ taskId })
+  }
+}
