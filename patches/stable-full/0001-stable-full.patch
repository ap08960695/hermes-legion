+@pytest.mark.parametrize("variant", [None, "half"])
+@pytest.mark.parametrize("replace_pack", [False, True])
+def test_atlas_cannot_cache_old_pixels_under_replacement_revision(fleet, monkeypatch, variant, replace_pack):
+    server, home = fleet
+    sheet = home / "profiles/alpha/pets/same/spritesheet.png"
+    pack = sheet.parent
+    replacement = pack.with_name("replacement") if replace_pack else sheet.with_name("replacement.png")
+    if replace_pack:
+        replacement.mkdir()
+    Image.new("RGBA", (1536, 1872), "blue").save(replacement / sheet.name if replace_pack else replacement)
+    build_payload = server._pet_sprite_payload
+
+    def replace_after_decode(pet, **kwargs):
+        if replacement.exists():
+            if replace_pack:
+                pack.rename(pack.with_name("old-pack"))
+                replacement.rename(pack)
+            else:
+                replacement.replace(sheet)
+        return build_payload(pet, **kwargs)
+
+    monkeypatch.setattr(server, "_pet_sprite_payload", replace_after_decode)
+    request = {
+        "id": "sprite", "method": "pet.sprite",
+        "params": {"profile": "alpha", "slug": "same", "variant": variant},
+    }
+    assert server.handle_request(request)["result"] == {"enabled": False}
+    current = server.handle_request(request)["result"]
+    with Image.open(BytesIO(base64.b64decode(current["spritesheetBase64"]))) as image:
+        assert image.getpixel((0, 0)) == (0, 0, 255, 255)
