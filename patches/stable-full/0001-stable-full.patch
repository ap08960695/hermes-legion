index 0000000000000000000000000000000000000000..feb1cb3f0d33edd868b91cc0985ed5e609fb7c6c
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/management.test.ts
@@ -0,0 +1,22 @@
+import { afterEach, expect, it } from 'vitest'
+import { $botManagementOpen, $botDialogIntent, requestBotManagement, finishBotManagementDialog } from './management'
+afterEach(() => {
+  finishBotManagementDialog()
+  $botManagementOpen.set(false)
+  $botDialogIntent.set(null)
+})
+it('returns a card-view form to the cards without changing an existing management view', () => {
+  requestBotManagement('bot')
+  expect($botManagementOpen.get()).toBe(true)
+  finishBotManagementDialog()
+  expect($botManagementOpen.get()).toBe(false)
+  $botManagementOpen.set(true)
+  requestBotManagement('bot')
+  finishBotManagementDialog()
+  expect($botManagementOpen.get()).toBe(true)
+})
+it('retains management when a created profile still needs configuration', () => {
+  requestBotManagement('bot')
+  finishBotManagementDialog(true)
+  expect($botManagementOpen.get()).toBe(true)
+})
diff --git a/apps/desktop/src/plugins/hermes-bots/management.test.tsx b/apps/desktop/src/plugins/hermes-bots/management.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..0343ba0e1f44c3dfad4cee07c0b608eed8ab0769
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/management.test.tsx
@@ -0,0 +1,33 @@
+import { act, renderHook } from '@testing-library/react'
+import { afterEach, expect, it } from 'vitest'
+import { $botDialogIntent, $botManagementOpen, requestBotManagement } from './management'
+import { useBotDialogs } from './use-bot-dialogs'
+afterEach(() => {
+  $botDialogIntent.set(null)
+  $botManagementOpen.set(false)
+})
+it('a palette intent opens the native form once, without creating a profile', () => {
+  requestBotManagement('bot')
+  expect($botManagementOpen.get()).toBe(true)
+  const view = renderHook(() => useBotDialogs(true))
+  expect(view.result.current[0]).toBe(true)
+  expect(view.result.current[2]).toBe(false)
+  expect($botDialogIntent.get()).toBeNull()
+  act(() => view.result.current[1](false))
+  view.rerender()
+  expect(view.result.current[0]).toBe(false)
+  act(() => requestBotManagement('group'))
+  expect(view.result.current[2]).toBe(true)
+  expect($botDialogIntent.get()).toBeNull()
+})
+
+it('a hidden legacy roster cannot consume a workspace dialog intent', () => {
+  const hidden = renderHook(() => useBotDialogs())
+  act(() => requestBotManagement('bot'))
+  expect(hidden.result.current[0]).toBe(false)
+  expect($botDialogIntent.get()).toBe('bot')
+  const visible = renderHook(() => useBotDialogs(true))
+  expect(visible.result.current[0]).toBe(true)
+  expect(hidden.result.current[0]).toBe(false)
+  expect($botDialogIntent.get()).toBeNull()
+})
diff --git a/apps/desktop/src/plugins/hermes-bots/management.ts b/apps/desktop/src/plugins/hermes-bots/management.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c9299b98635ce6b570b2264a307e0383a14d4b83
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/management.ts
@@ -0,0 +1,15 @@
+import { atom } from 'nanostores'
+/** UI intent only. Creating a bot or group still requires the native dialog confirmation. */
+export const $botManagementOpen = atom(false)
+let returnToCards = false
+export const $botDialogIntent = atom<'bot' | 'group' | null>(null)
+export function requestBotManagement(kind: 'bot' | 'group') {
+  returnToCards = !$botManagementOpen.get()
+  $botManagementOpen.set(true)
+  $botDialogIntent.set(kind)
+}
+
+export function finishBotManagementDialog(keepManagement = false) {
+  if (returnToCards && !keepManagement) $botManagementOpen.set(false)
+  returnToCards = false
+}
