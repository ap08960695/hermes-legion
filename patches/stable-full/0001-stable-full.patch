@@ -0,0 +1,123 @@
+"""Repeated extracted pages must not re-convert or re-enter model context."""
+import json
+import zipfile
+from unittest.mock import Mock
+
+import pytest
+
+from tools import file_tools as ft, read_extract
+from tools.file_tools_read_tracking import reset_file_dedup
+
+
+def write_document(path, text):
+    if path.suffix == '.ipynb':
+        path.write_text(json.dumps({'cells': [{'cell_type': 'markdown', 'source': text}],
+                                    'metadata': {}, 'nbformat': 4, 'nbformat_minor': 5}))
+    else:
+        with zipfile.ZipFile(path, 'w') as archive:
+            archive.writestr('word/document.xml',
+                '<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">'
+                '<w:body><w:p><w:r><w:t>' + text + '</w:t></w:r></w:p></w:body></w:document>')
+
+
+@pytest.fixture
+def document(tmp_path, monkeypatch):
+    path = tmp_path / 'report.docx'
+    write_document(path, 'Report body')
+    spy = Mock(wraps=read_extract.extract_document_bytes)
+    monkeypatch.setattr(read_extract, 'extract_document_bytes', spy)
+    return path, spy
+
+
+def read(path, task='document-reader', **kwargs):
+    return json.loads(ft._handle_read_file({'path': str(path), **kwargs}, task_id=task))
+
+
+@pytest.mark.parametrize('suffix', ['.docx', '.ipynb'])
+def test_identical_page_converts_once_and_returns_stub(document, suffix):
+    path, spy = document
+    path = path.with_suffix(suffix)
+    write_document(path, 'Detailed report ' * 200)
+    first = read(path)
+    second = read(path)
+    assert first['extracted_document'] and 'Detailed report' in first['content']
+    assert second.get('dedup') is True
+    assert spy.call_count == 1
+    third = read(path)
+    assert 'BLOCKED' in third['error']
+    assert spy.call_count == 1
+
+
+def test_changed_document_is_converted_again(document):
+    path, spy = document
+    read(path)
+    write_document(path, 'Changed report')
+    assert 'Changed report' in read(path)['content']
+    assert spy.call_count == 2
+    assert read(path).get('dedup') is True
+
+
+def test_pages_and_tasks_keep_separate_content(document):
+    path, spy = document
+    read(path, limit=1)
+    assert read(path, task='other-reader', limit=1)['extracted_document']
+    assert read(path, offset=2, limit=1)['extracted_document']
+    assert spy.call_count == 1
+
+
+def test_compression_restores_full_page_once(document):
+    path, spy = document
+    read(path)
+    reset_file_dedup('document-reader')
+    assert 'Report body' in read(path)['content']
+    assert read(path).get('dedup') is True
+    assert spy.call_count == 1
+
+
+def test_review_fork_gets_content(document, monkeypatch):
+    path, spy = document
+    read(path)
+    monkeypatch.setattr(ft, 'is_background_review', lambda: True)
+    assert 'Report body' in read(path)['content']
+    assert spy.call_count == 1
+
+
+def test_failed_conversion_does_not_cache_success(document):
+    path, spy = document
+    path.write_bytes(b'broken archive')
+    assert 'extraction failed' in read(path)['error']
+    assert 'extraction failed' in read(path)['error']
+    write_document(path, 'Repaired report')
+    assert 'Repaired report' in read(path)['content']
+    assert spy.call_count == 3
+
+
+def test_change_during_conversion_is_not_cached(document):
+    path, spy = document
+    # The spy wraps the real converter; replace its side effect, not the converter.
+    real = spy._mock_wraps
+    def convert(data, filename):
+        text = real(data, filename)
+        write_document(path, 'New report')
+        return text
+    spy.side_effect = convert
+    assert 'Report body' in read(path)['content']
+    spy.side_effect = None
+    assert 'New report' in read(path)['content']
+    assert spy.call_count == 2
+
+
+def test_remote_paths_do_not_use_host_metadata(document, monkeypatch):
+    path, spy = document
+    monkeypatch.setattr(ft, '_file_ops_uses_host_paths', lambda ops: False)
+    read(path)
+    assert 'Report body' in read(path)['content']
+    assert spy.call_count == 1
+
+
+def test_denylist_still_applies_after_success(document, monkeypatch):
+    path, spy = document
+    read(path)
+    monkeypatch.setattr(ft, 'get_read_block_error', lambda path: 'Access denied')
+    assert 'Access denied' in read(path)['error']
+    assert spy.call_count == 1
