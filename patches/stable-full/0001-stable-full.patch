+
+it('offers History and Projects as real destinations in every main mode', () => {
+  const rows = buildFeatureCatalog([])
+  expect(rows.find(row => row.id === 'sessions')?.path).toBe('/history')
+  expect(rows.find(row => row.id === 'projects')?.path).toBe('/projects')
