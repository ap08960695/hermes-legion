+++ b/apps/desktop/src/components/assistant-ui/embeds/chart-embed.tsx
@@ -0,0 +1,244 @@
+'use client'
+
+import { useId, useState } from 'react'
+
+import { Zoomable } from '@/components/ui/zoomable'
+import { useI18n } from '@/i18n'
+import { type ChartSpec, parseChartSpec } from '@/lib/chart-spec'
+
+import type { RichFenceProps } from './types'
+
+// Theme tokens, so the chart follows the app's live light/dark palette.
+const COLORS = ['--ui-blue', '--ui-orange', '--ui-green', '--ui-purple', '--ui-red', '--ui-yellow', '--ui-cyan']
+const color = (i: number) => `var(${COLORS[i % COLORS.length]})`
+
+const W = 480
+const H = 240
+const PAD = { bottom: 48, left: 52, right: 20, top: 28 }
+const PLOT_W = W - PAD.left - PAD.right
+const PLOT_H = H - PAD.top - PAD.bottom
+
+const fmt = (n: number) => n.toLocaleString(undefined, { maximumFractionDigits: 2 })
+const short = (s: string) => (s.length > 12 ? `${s.slice(0, 11)}…` : s)
+
+function Cartesian({ spec }: { spec: ChartSpec }) {
+  const all = spec.series.flatMap(s => s.values)
+  const min = Math.min(0, ...all)
+  const max = Math.max(0, ...all)
+  const roughStep = (max - min || 1) / 4
+  const magnitude = 10 ** Math.floor(Math.log10(roughStep))
+  const tickStep = ([1, 2, 5, 10].find(step => step * magnitude >= roughStep) ?? 10) * magnitude
+  const lo = Math.floor(min / tickStep) * tickStep
+  const hi = Math.ceil((max || (min === 0 ? 1 : 0)) / tickStep) * tickStep
+  const y = (v: number) => PAD.top + PLOT_H - ((v - lo) / (hi - lo)) * PLOT_H
+  const n = spec.labels.length
+  const step = PLOT_W / n
+  const x = (i: number) => PAD.left + (i + 0.5) * step
+  const every = Math.ceil(n / 4)
+  const unit = spec.unit ? ` ${spec.unit}` : ''
+  const ticks = Array.from({ length: Math.round((hi - lo) / tickStep) + 1 }, (_, i) => lo + tickStep * i)
+  const barW = Math.min(44, (step * 0.64) / spec.series.length)
+  const groupW = barW * spec.series.length
+  const showValues = n * spec.series.length <= 16
+
+  return (
+    <>
+      <g fill="currentColor" fontSize="12" opacity="0.7">
+        {ticks.map(t => (
+          <g key={t}>
+            <line
+              stroke="currentColor"
+              strokeOpacity={t === 0 ? '0.22' : '0.08'}
+              x1={PAD.left}
+              x2={W - PAD.right}
+              y1={y(t)}
+              y2={y(t)}
+            />
+            <text dominantBaseline="middle" textAnchor="end" x={PAD.left - 6} y={y(t)}>
+              {fmt(t)}
+            </text>
+          </g>
+        ))}
+        {spec.labels.map((label, i) =>
+          i % every ? null : (
+            <text key={i} textAnchor="middle" x={x(i)} y={H - 12}>
+              {short(label)}
+            </text>
+          )
+        )}
+      </g>
+      {spec.series.map((s, si) =>
+        spec.type === 'bar' ? (
+          <g fill={color(si)} key={si}>
+            {s.values.map((v, i) => (
+              <g key={i}>
+                <rect
+                  fillOpacity={0.85}
+                  height={Math.abs(y(v) - y(0))}
+                  key={i}
+                  rx={3}
+                  width={Math.max(1, barW - 2)}
+                  x={x(i) - groupW / 2 + si * barW + 1}
+                  y={Math.min(y(v), y(0))}
+                >
+                  <title>{`${s.name} · ${spec.labels[i]}: ${fmt(v)}${unit}`}</title>
+                </rect>
+                {showValues && (
+                  <text
+                    fill="currentColor"
+                    fontSize="14"
+                    fontWeight="600"
+                    textAnchor="middle"
+                    x={x(i) - groupW / 2 + (si + 0.5) * barW}
+                    y={v >= 0 ? y(v) - 8 : y(v) + 16}
+                  >
+                    {fmt(v)}
+                  </text>
+                )}
+              </g>
+            ))}
+          </g>
+        ) : (
+          <g key={si} stroke={color(si)}>
+            <polyline
+              fill="none"
+              points={s.values.map((v, i) => `${x(i)},${y(v)}`).join(' ')}
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              strokeWidth="2.5"
+            />
+            {s.values.map((v, i) => (
+              <circle cx={x(i)} cy={y(v)} fill={color(si)} key={i} r={n > 60 ? 2 : 3.5}>
+                <title>{`${s.name} · ${spec.labels[i]}: ${fmt(v)}${unit}`}</title>
+              </circle>
+            ))}
+          </g>
+        )
+      )}
+    </>
+  )
+}
+
+function Pie({ spec }: { spec: ChartSpec }) {
+  const values = spec.series[0].values
+  const total = values.reduce((a, b) => a + b, 0)
+  const [cx, cy, r] = [W / 2, H / 2, H / 2 - 12]
+  const unit = spec.unit ? ` ${spec.unit}` : ''
+  let angle = -Math.PI / 2
+
+  return (
+    <>
+      {values.map((v, i) => {
+        const title = <title>{`${spec.labels[i]}: ${fmt(v)}${unit} (${fmt((v / total) * 100)}%)`}</title>
+
+        if (v === total) {
+          return (
+            <circle cx={cx} cy={cy} fill={color(i)} key={i} r={r}>
+              {title}
+            </circle>
+          )
+        }
+
+        const start = angle
+        angle += (v / total) * Math.PI * 2
+        const p = (a: number) => `${cx + r * Math.cos(a)} ${cy + r * Math.sin(a)}`
+        const large = angle - start > Math.PI ? 1 : 0
+
+        return (
+          <path d={`M${cx} ${cy}L${p(start)}A${r} ${r} 0 ${large} 1 ${p(angle)}Z`} fill={color(i)} key={i}>
+            {title}
+          </path>
+        )
+      })}
+    </>
+  )
+}
+
+/** Renders a ```chart fence as an inline SVG; invalid specs throw so the
+ *  RichBoundary falls back to the plain code block. */
+export default function ChartRenderer({ code, streaming }: RichFenceProps) {
+  const { t } = useI18n()
+  const valuesLabelId = useId()
+  const [showData, setShowData] = useState(false)
+
+  if (streaming) {
+    return (
+      <p className="text-xs text-muted-foreground" role="status">
+        {t.preview.loading}
+      </p>
+    )
+  }
+
+  const spec = parseChartSpec(code)
+
+  if (!spec) {
+    throw new Error('chart: invalid spec')
+  }
+
+  const legend = spec.type === 'pie' ? spec.labels : spec.series.map(s => s.name)
+  const label = spec.title || `${spec.type} chart`
+
+  const plot = spec.type === 'pie' ? <Pie spec={spec} /> : <Cartesian spec={spec} />
+
+  const legendView = legend.length > 1 && (
+    <ul className="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted-foreground">
+      {legend.map((name, i) => (
+        <li className="inline-flex max-w-full items-start gap-1.5" key={i}>
+          <span aria-hidden className="mt-0.5 size-2.5 shrink-0 rounded-sm" style={{ background: color(i) }} />
+          <span className="wrap-anywhere">{name}</span>
+        </li>
+      ))}
+    </ul>
+  )
+
+  return (
+    <figure className="not-prose my-4 min-w-0 max-w-[600px] text-(--ui-text-primary)" data-slot="chart">
+      {(spec.title || spec.unit) && (
+        <figcaption className="mb-3 flex items-baseline justify-between gap-3 text-sm font-semibold">
+          <span>{spec.title}</span>
+          {spec.unit && <span className="text-xs font-normal text-muted-foreground">{spec.unit}</span>}
+        </figcaption>
+      )}
+      <Zoomable label={`${t.preview.openPreview}: ${label}`} overlay={
+        <figure className="w-[960px] text-(--ui-text-primary)">
+          <figcaption className="mb-3 text-sm font-semibold">{label}{spec.unit && ` · ${spec.unit}`}</figcaption>
+          <svg className="block" height={480} role="img" viewBox={`0 0 ${W} ${H}`} width={960}>
+            <title>{label}</title>
+            {plot}
+          </svg>
+          {legendView}
+        </figure>
+      }>
+        <svg className="block h-auto max-h-[40dvh] w-full max-w-[600px]" role="img" viewBox={`0 0 ${W} ${H}`}>
+          <title>{label}</title>
+          {plot}
+        </svg>
+      </Zoomable>
+      {legendView}
+      <details className="mt-2" onToggle={event => setShowData(event.currentTarget.open)} open={showData}>
+        <summary className="cursor-pointer py-2 text-xs text-muted-foreground focus-visible:[box-shadow:inset_0_0_0_2px_var(--dt-ring)]" id={valuesLabelId}>
+          {t.preview.chartValues}
+        </summary>
+        {showData && <div
+          aria-labelledby={valuesLabelId}
+          className="max-h-[40dvh] overflow-auto focus-visible:[box-shadow:inset_0_0_0_2px_var(--dt-ring)]"
+          data-slot="chart-values"
+          role="region"
+          tabIndex={0}
+        >
+          <table className="w-full border-collapse text-xs">
+            <caption className="mb-2 text-left">{label}{spec.unit && ` · ${spec.unit}`}</caption>
+            <thead><tr>
+              <th className="px-3 py-2 text-left" scope="col">{t.catalog.category}</th>
+              {spec.series.map((series, index) => <th className="px-3 py-2 text-right" key={index} scope="col">{series.name}</th>)}
+            </tr></thead>
+            <tbody>{spec.labels.map((category, index) => <tr className="border-t border-border" key={index}>
+              <th className="min-w-40 max-w-72 wrap-anywhere px-3 py-2 text-left font-medium" scope="row">{category}</th>
+              {spec.series.map((series, seriesIndex) => <td className="whitespace-nowrap px-3 py-2 text-right tabular-nums" key={seriesIndex}>{String(series.values[index])}</td>)}
+            </tr>)}</tbody>
+          </table>
+        </div>}
+      </details>
+    </figure>
+  )
+}
