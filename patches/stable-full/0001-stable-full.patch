+import { automaticComposerFocusHeld, restoreSplitReconnectFocus, useSplitReconnectFocus } from './reconnect-focus'
+import { caretOffsetInEditor, RICH_INPUT_SLOT } from './rich-editor'
+
+function Editor({ reconnected }: { reconnected: boolean }) {
+  const input = useRef<HTMLDivElement>(null)
+  useEffect(() => {
+    if (reconnected) restoreSplitReconnectFocus('tile:split', input.current)
+  }, [reconnected])
+
+  return (
+    <div data-composer-target="tile:split">
+      <div contentEditable data-slot={RICH_INPUT_SLOT} ref={input} role="textbox" suppressContentEditableWarning tabIndex={0}>Draft text</div>
+    </div>
+  )
+}
+
+function DockedEditor({ reconnected }: { reconnected: boolean }) {
+  const anchor = useRef<HTMLDivElement>(null)
+  const surfaceId = reconnected ? 'split-new' : 'split-old'
+  const [host] = useState(() => document.createElement('div'))
+  useLayoutEffect(() => {
+    host.dataset.composerOwner = surfaceId
+    anchor.current?.appendChild(host)
+    const unregister = registerFloatingComposer(surfaceId, { groupId: 'split-group', target: 'tile:split' })
+
+    return () => {
+      unregister()
+      host.remove()
+    }
+  }, [host, surfaceId])
+
+  return <div ref={anchor}>{createPortal(<Editor reconnected={reconnected} />, host)}</div>
+}
+
+function Split() {
+  const tile = useStore($sessionTiles)[0]
+  useSplitReconnectFocus('split')
+
+  return tile?.runtimeId ? <DockedEditor reconnected={Boolean(tile.localReconnect)} /> : null
+}
+
+function startRebind(select = (editor: HTMLElement) => window.getSelection()?.collapse(editor.firstChild, 3)) {
+  const editor = screen.getByRole('textbox')
+  claimFloatingComposer('split-old')
+  editor.focus()
+  select(editor)
+  expect(document.activeElement).toBe(editor)
+
+  act(() => resetTileRuntimeBindings('local', true))
+  expect(screen.queryByRole('textbox')).toBeNull()
+  expect(automaticComposerFocusHeld()).toBe(true)
+}
+
+describe('focused Local split composer rebind', () => {
+  let unregisterMain: () => void
+  beforeEach(() => {
+    unregisterMain = registerFloatingComposer('main-surface', { groupId: 'main-group', target: 'main' })
+    vi.spyOn(document, 'hasFocus').mockReturnValue(true)
+    $sessionTiles.set([{
+      storedSessionId: 'split', runtimeId: 'old',
+      ownerRoute: { connectionId: 'local', mode: 'local', profile: 'writer' }
+    }])
+  })
+
+  afterEach(() => {
+    cleanup()
