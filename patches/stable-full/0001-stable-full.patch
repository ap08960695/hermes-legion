+"""The frozen worker config must enforce the extra-transport-attempt opt-out."""
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+import pytest
+
+from tests.gateway.fixtures.local_recovery_probe import child_env
+
+
+@pytest.mark.parametrize('enabled,expected', [(False, 1), (True, 2)])
+def test_managed_worker_honors_transport_recovery_setting(tmp_path, enabled, expected):
+    root = Path(__file__).resolve().parents[2]
+    env = child_env() | {'HOME': str(tmp_path / 'user'), 'USERPROFILE': str(tmp_path / 'user'),
+        'HERMES_HOME': str(tmp_path / 'state'), 'HERMES_KANBAN_HOME': str(tmp_path / 'state'),
+        'PYTHONPATH': str(root), 'HERMES_PYTHON': sys.executable, 'HERMES_DISABLE_LAZY_INSTALLS': '1'}
+    result = subprocess.run([sys.executable, str(root / 'tests/gateway/fixtures/transport_policy_probe.py'),
+                             'enabled' if enabled else 'disabled'], cwd=root, env=env,
+                            stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
+    assert result.returncode == 0, result.stdout + result.stderr
+    receipt = json.loads((tmp_path / 'state/receipt.json').read_text())
+    print(json.dumps(receipt))
+    assert receipt['model_attempts'] == expected, receipt
+    assert receipt['completed'] is enabled
+    assert receipt['execution_terminal'] is True
+    assert receipt['worker_receipt_exit'] == (0 if enabled else 75)
+    assert receipt['external_model_calls'] == 0
