+"""Bound expensive output work to what the caller will actually consume."""
+import json
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from agent import web_search_registry
+from hermes_state import SessionDB
+from tools import ansi_strip, read_extract, session_search_tool as sessions
+from tools import web_tools, web_tools_extract, website_policy
+from tools.process_registry import ProcessRegistry, ProcessSession
+
+
+@pytest.mark.parametrize("count", [5, 30, 100])
+def test_session_read_formats_only_returned_messages(tmp_path, monkeypatch, count):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        db.create_session("history", source="cli")
+        for n in range(count):
+            db.append_message("history", role="assistant", content=f"\x1b[31mmessage {n}\x1b[0m")
+        shaped = []
+        original = sessions._shape_message
+
+        def shape(row, **kwargs):
+            shaped.append(row["id"])
+            return original(row, **kwargs)
+
+        monkeypatch.setattr(sessions, "_shape_message", shape)
+        result = json.loads(sessions.session_search(session_id="history", db=db))
+        assert result["message_count"] == count
+        selected = list(range(count)) if count <= 30 else list(range(20)) + list(range(count - 10, count))
+        assert [row["content"] for row in result["messages"]] == [f"message {n}" for n in selected]
+        assert len(shaped) == len(selected)
+        assert result["truncated"] == (count > 30)
+    finally:
+        db.close()
+
+
+def test_log_formatting_does_not_block_output_writer(monkeypatch):
+    registry = ProcessRegistry()
+    session = ProcessSession(id="format-test", command="offline", task_id="task", started_at=time.time())
+    session.append_output("\x1b[31mbefore\x1b[0m\n")
+    registry._running[session.id] = session
+    entered, release, wrote = threading.Event(), threading.Event(), threading.Event()
+    output = []
+    original = ansi_strip.strip_ansi
+
+    def slow_format(text):
+        entered.set()
+        assert release.wait(10)
+        return original(text)
+
+    monkeypatch.setattr(ansi_strip, "strip_ansi", slow_format)
+    reader = threading.Thread(target=lambda: output.append(registry.read_log(session.id)), daemon=True)
+    writer = threading.Thread(target=lambda: (session.append_output("after\n"), wrote.set()), daemon=True)
+    reader.start()
+    try:
+        assert entered.wait(5)
+        writer.start()
+        assert wrote.wait(2), "Formatting a snapshot must not stall process output ingestion"
+    finally:
+        release.set()
+        reader.join(5)
+        if writer.ident is not None:
+            writer.join(5)
+    assert output[0]["output"] == "before"
+    assert session.output_buffer.endswith("after\n")
+    assert session.id not in registry._completion_consumed
+
+
+@pytest.mark.parametrize("text, expected", [
+    ("", ""), ("plain\n\ntext\t\n", "plain\n\ntext\t\n"),
+    ("ไทย😀\n", "ไทย😀\n"), ("\x1b[31mred\x1b[0m\n", "red\n"),
+    ("old\rnew\n", "new\n"), ("old\r\r", "old"),
+    ("\r\r\n", "\n"), ("a\r\nb\r\n", "a\nb\n"),
+])
+def test_notebook_stream_preserves_cleanup_contract(text, expected):
+    assert read_extract._clean_stream_text(text) == expected
+
+
+@pytest.mark.parametrize("enabled", [False, True])
+def test_extract_serializes_raw_debug_payload_only_when_enabled(monkeypatch, enabled):
+    fetched = {"url": "https://example.com/page", "content": "hello", "metadata": {"large": "x" * 50000}}
+    serializations = []
+    original = json.dumps
+
+    def dumps(obj, *args, **kwargs):
+        if isinstance(obj, dict) and obj.get("results") and obj["results"][0] is fetched:
+            serializations.append(True)
+        return original(obj, *args, **kwargs)
+
+    async def extract(urls, **kwargs):
+        return [fetched]
+
+    async def safe(url):
+        return True
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("No alternate provider/fallback")
+
+    provider = SimpleNamespace(name="offline-fixture", supports_extract=lambda: True, extract=extract)
+    monkeypatch.setattr(web_tools, "_ensure_web_plugins_loaded", lambda: None)
+    monkeypatch.setattr(web_tools, "_get_extract_backend", lambda: provider.name)
+    monkeypatch.setattr(web_tools, "_load_web_config", lambda: {"cache_enabled": False, "keyless_rescue": False})
+    monkeypatch.setattr(web_search_registry, "get_provider", lambda name: provider)
+    monkeypatch.setattr(web_search_registry, "get_active_extract_provider", forbidden)
+    monkeypatch.setattr(web_tools, "async_is_safe_url", safe)
+    monkeypatch.setattr(website_policy, "check_website_access", lambda url: None)
+    monkeypatch.setattr(web_tools_extract, "_rescue_extract", forbidden)
+    monkeypatch.setattr(web_tools._debug, "enabled", enabled)
+    monkeypatch.setattr(web_tools._debug, "_calls", [])
+    monkeypatch.setattr(web_tools._debug, "save", lambda: None)
+    monkeypatch.setattr(json, "dumps", dumps)
+    result = json.loads(web_tools.registry.dispatch("web_extract", {"urls": [fetched["url"]]}))
+    assert result["results"][0]["content"] == "hello"
+    assert len(serializations) == int(enabled)
+    if enabled:
+        assert web_tools._debug._calls[-1]["original_response_size"] > 50000
