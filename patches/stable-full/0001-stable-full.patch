+"""A terminal SSE event must retain its status when response.status is absent."""
+import pytest
+
+from agent.codex_runtime import _consume_codex_event_stream
+from agent.turn_response_check import _codex_finish_reason
+
+
+@pytest.mark.parametrize("status", [None, "", "   "])
+def test_incomplete_event_without_status_reaches_continuation(status):
+    response = {
+        "incomplete_details": {"reason": "max_output_tokens"},
+        "usage": {"input_tokens": 100, "output_tokens": 20},
+    }
+    if status is not None:
+        response["status"] = status
+    events = [
+        {"type": "response.output_text.delta", "delta": "def schedule("},
+        {"type": "response.incomplete", "response": response},
+    ]
+
+    final = _consume_codex_event_stream(events, model="gpt-6.1-sol")
+
+    assert final.output_text == "def schedule("
+    assert final.usage == response["usage"]
+    assert final.status == "incomplete"
+    assert _codex_finish_reason(final) == "incomplete"
+
+
+@pytest.mark.parametrize("kind", ["completed", "incomplete", "failed"])
+def test_terminal_event_without_response_retains_event_status(kind):
+    final = _consume_codex_event_stream(
+        [{"type": f"response.{kind}"}], model="gpt-6.1-sol"
+    )
+    assert final.status == kind
+
+
+def test_explicit_response_status_remains_authoritative():
+    final = _consume_codex_event_stream(
+        [{"type": "response.completed", "response": {
+            "status": "incomplete", "incomplete_details": {"reason": "max_output_tokens"}
+        }}], model="gpt-6.1-sol"
+    )
+    assert final.status == "incomplete"
diff --git a/tests/agent/test_compaction_concurrent_tool_reload.py b/tests/agent/test_compaction_concurrent_tool_reload.py
new file mode 100644
index 0000000000000000000000000000000000000000..ff0460e95a23347128cf61faca9feed2e6a1ff92
--- /dev/null
+++ b/tests/agent/test_compaction_concurrent_tool_reload.py
@@ -0,0 +1,176 @@
+"""A confirmed MCP reload during compaction must survive native publication and cold restore."""
+import copy
+import json
+import threading
+
+import pytest
+
+from agent.conversation_compression import CompressionCommitFence
+from agent.conversation_loop import _restore_or_build_system_prompt
+from agent.memory_provider import spawn_context_thread
+from hermes_state import SessionDB
+from tests.agent.test_compression_rotation_state import _build_agent_with_db
+
+pytest_plugins = ["tests.agent.test_compression_failed_commit_boundary"]
+
+
+def _reload(agent, case, monkeypatch, surface):
+    """Use actual native surface admission and snapshot persistence; only discovery is fake."""
+    if surface == "gateway":
+        from gateway.run import GatewayRunner
+        runner = GatewayRunner.__new__(GatewayRunner)
+        runner._agent_cache_lock = threading.RLock()
+        runner._agent_cache = {"concurrent-compaction": (agent, 0)}
+        runner._mcp_reload_refresh_cached_agents(False, None)
+        return
+
+    import tui_gateway.server as srv
+    from tools import mcp_tool, mcp_tool_discovery, mcp_tool_lifecycle
+    monkeypatch.setattr(mcp_tool_lifecycle, "shutdown_mcp_servers", lambda: None)
+    monkeypatch.setattr(mcp_tool_discovery, "discover_mcp_tools", list)
+    monkeypatch.setattr(mcp_tool, "_servers", {})
+    monkeypatch.setattr(srv, "_sessions", {"concurrent-compaction": {
+        "agent": agent, "history": case.messages, "history_lock": threading.RLock(),
+        "running": True, "profile_home": None}})
+    monkeypatch.setattr(srv, "_compute_mcp_rev", lambda: "offline-static-revision")
+    monkeypatch.setattr(srv, "_emit", lambda *a, **kw: True)
+    monkeypatch.setattr(srv, "_session_info", lambda *a, **kw: {})
+    monkeypatch.setattr(srv, "_load_enabled_toolsets", lambda *a: None)
+    monkeypatch.setattr(srv, "_load_disabled_toolsets", lambda: None)
+    monkeypatch.setattr(srv, "_mcp_reload_gen", 0)
+    monkeypatch.setattr(srv, "_mcp_reload_loaded_rev", "")
+    reply = srv._methods["reload.mcp"](11, {"session_id": "concurrent-compaction", "confirm": True})
+    assert reply["result"]["status"] == "reloaded"
+
+
+@pytest.mark.parametrize("in_place", [True, False], ids=["in-place", "rotation"])
+@pytest.mark.parametrize("surface", ["tui", "gateway"])
+@pytest.mark.parametrize("refused", [False, True], ids=["committed", "refused"])
+@pytest.mark.parametrize("same_schema", [False, True], ids=["newer-schema", "same-staged-schema"])
+def test_explicit_reload_survives_prepared_compaction(case, monkeypatch, in_place, surface, refused, same_schema):
+    from tools.mcp_tool_agent import persist_agent_tool_names
+    c = case
+    c.agent.compression_in_place = in_place
+    c.agent._cached_system_prompt = c.agent._build_system_prompt("original context")
+    c.db.update_system_prompt(c.sid, c.agent._cached_system_prompt)
+    persist_agent_tool_names(c.agent)
+    staged = copy.deepcopy(c.agent.tools)
+    staged[0]["function"]["description"] = "Contract staged by compaction"
+    latest = copy.deepcopy(staged)
+    if not same_schema:
+        latest[0]["function"]["description"] = "Latest contract acknowledged by explicit MCP reload"
+    catalog = [staged]
+    monkeypatch.setattr("model_tools.get_tool_definitions", lambda **kw: copy.deepcopy(catalog[0]))
+    if refused:
+        with c.db._conn:
+            c.db._conn.execute("CREATE TRIGGER refuse_reload_compaction BEFORE INSERT ON messages "
+                "BEGIN SELECT RAISE(ABORT, 'fixture: refuse compact after reload'); END")
+    prepared, proceed = threading.Event(), threading.Event()
+    returned, errors = [], []
+    native_memory = c.agent.commit_memory_session
+
+    def memory_boundary(*args, **kwargs):
+        prepared.set()
+        assert proceed.wait(15), "reload coordinator did not release compaction"
+        return native_memory(*args, **kwargs)
+
+    monkeypatch.setattr(c.agent, "commit_memory_session", memory_boundary)
+
+    def compact():
+        try:
+            returned.append(c.agent._compress_context(c.messages, "updated context", approx_tokens=120_000,
+                force=True, commit_fence=CompressionCommitFence()))
+        except BaseException as exc:
+            errors.append(exc)
+
+    worker = spawn_context_thread(compact, name="offline-compaction-reload")
+    worker.start()
+    try:
+        assert prepared.wait(15), "compaction never prepared its candidate prefix"
+        catalog[0] = latest
+        _reload(c.agent, c, monkeypatch, surface)
+        assert c.agent.tools == latest
+        acknowledged_pin = json.loads(c.db.get_session(c.sid)["tool_names"])["tools"]
+    finally:
+        proceed.set()
+        worker.join(15)
+    assert not worker.is_alive() and errors == []
+    assert len(returned) == 1
+    assert acknowledged_pin == latest, "reload acknowledgement must pin even a matching staged candidate"
+    messages, prompt = returned[0]
+    assert (len(messages) < len(c.messages)) is (not refused)
+    assert c.agent.tools == latest
+    with SessionDB(c.db.db_path, read_only=True) as cold:
+        tip = cold.get_compression_tip(c.sid)
+        row = cold.get_session(tip)
+        assert row["system_prompt"] == prompt
+        assert json.loads(row["tool_names"])["tools"] == latest, "older staged tools overwrote acknowledged reload"
+        resumed = _build_agent_with_db(cold, tip, platform="cli")
+        try:
+            _restore_or_build_system_prompt(resumed, "updated context", cold.get_messages_as_conversation(tip))
+            assert resumed.tools == latest, "cold restore must retain the acknowledged reload"
+        finally:
+            resumed.close()
+
+
+@pytest.mark.parametrize("in_place", [True, False], ids=["in-place", "rotation"])
+def test_reload_racing_native_publication_pins_the_selected_tip(case, monkeypatch, in_place):
+    """A reload racing the SQLite commit must pin the adopted child, not the retired parent."""
+    from tools.mcp_tool_agent import persist_agent_tool_names
+    c = case
+    c.agent.compression_in_place = in_place
+    c.agent._cached_system_prompt = c.agent._build_system_prompt("original context")
+    c.db.update_system_prompt(c.sid, c.agent._cached_system_prompt)
+    persist_agent_tool_names(c.agent)
+    latest = copy.deepcopy(c.agent.tools)
+    latest[0]["function"]["description"] = "Reload concurrent with native publication"
+    entered, release, reload_ready = threading.Event(), threading.Event(), threading.Event()
+    errors = []
+    method = "archive_and_compact" if in_place else "publish_compression_child"
+    native = getattr(c.db, method)
+
+    def paused_publication(*args, **kwargs):
+        result = native(*args, **kwargs)
+        entered.set()
+        assert release.wait(15), "publication coordinator did not release handoff"
+        return result
+
+    monkeypatch.setattr(c.db, method, paused_publication)
+
+    def compact():
+        try:
+            c.agent._compress_context(c.messages, "updated context", approx_tokens=120_000,
+                force=True, commit_fence=CompressionCommitFence())
+        except BaseException as exc:
+            errors.append(exc)
+
+    def catalog(**kwargs):
+        reload_ready.set()
+        return copy.deepcopy(latest)
+
+    def reload():
+        try:
+            _reload(c.agent, c, monkeypatch, "tui")
+        except BaseException as exc:
+            errors.append(exc)
+
+    worker = spawn_context_thread(compact, name="offline-publishing-compaction")
+    worker.start()
+    reloader = None
+    try:
+        assert entered.wait(15), "native publication was not reached"
+        monkeypatch.setattr("model_tools.get_tool_definitions", catalog)
+        reloader = spawn_context_thread(reload, name="offline-confirmed-reload")
+        reloader.start()
+        assert reload_ready.wait(15), "confirmed reload did not reach its discovery boundary"
+    finally:
+        release.set()
+        worker.join(15)
+        if reloader:
+            reloader.join(15)
+    assert not worker.is_alive() and reloader and not reloader.is_alive() and errors == []
+    with SessionDB(c.db.db_path, read_only=True) as cold:
+        tip = cold.get_compression_tip(c.sid)
+        assert c.agent.session_id == tip
+        assert c.agent.tools == latest
+        assert json.loads(cold.get_session(tip)["tool_names"])["tools"] == latest
