@@ -0,0 +1,169 @@
+"""Offline cross-profile comparison, privacy and exactly-once observation contracts."""
+import copy
+from concurrent.futures import ThreadPoolExecutor
+import json
+import logging
+import socket
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from agent import cache_cross_bot_diagnostics as cross
+from agent import cache_request_diagnostics as local
+from agent.shared_prompt_cache import HEADER, END
+from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+
+@pytest.fixture(autouse=True)
+def offline(monkeypatch):
+    def forbidden(*args, **kwargs):
+        raise AssertionError('offline test attempted network')
+    monkeypatch.setattr(socket.socket, 'connect', forbidden)
+    monkeypatch.setattr(socket.socket, 'connect_ex', forbidden)
+
+
+@pytest.fixture
+def root(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    home = tmp_path / 'hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    return home
+
+
+def agent(session='private-session', account='private-account'):
+    return SimpleNamespace(api_mode='codex_responses', session_id=session,
+        base_url='https://chatgpt.com/backend-api/codex',
+        _client_kwargs={'default_headers': {'ChatGPT-Account-ID': account,
+                                           'Authorization': 'secret-auth'}})
+
+
+def request():
+    return {'model': 'offline', 'instructions': HEADER+'\n\ncommon-private\n\n'+END+'\nprivate-persona',
+        'prompt_cache_key': 'private',
+        'tools': [{'type': 'function', 'name': 'private-tool'}],
+        'input': [{'role': 'user', 'content': 'private-body'}]}
+
+
+def observe(home, a, req):
+    token = set_hermes_home_override(home)
+    try:
+        return cross.fingerprint(a, req, request_id='private-request')
+    finally:
+        reset_hermes_home_override(token)
+
+
+def test_two_profiles_share_comparable_digests_without_sharing_identity(root):
+    req = request(); original = copy.deepcopy(req)
+    a = observe(root/'profiles/a', agent('session-a'), req)
+    b = observe(root/'profiles/b', agent('session-b'), req)
+    assert a['namespace'] == b['namespace']
+    for field in ['route', 'declared_account', 'cache_key', 'common_prefix', 'tools', 'instructions']:
+        assert a['fields'][field] == b['fields'][field]
+    for field in ['profile', 'session']:
+        assert a['fields'][field] != b['fields'][field]
+    assert req == original
+    serialized = json.dumps([a,b])
+    for secret in ['private', 'secret-auth', 'session-a', 'session-b', str(root)]:
+        assert secret not in serialized
+
+
+def test_restart_and_separate_installation_boundaries(root):
+    a = observe(root/'profiles/a', agent(), request())
+    b = observe(root/'profiles/a', agent(), request())
+    c = observe(root.parent/'other/profiles/a', agent(), request())
+    assert a['namespace'] == b['namespace'] != c['namespace']
+    assert a['fields'] == b['fields'] != c['fields']
+
+
+def test_comparison_distinguishes_account_key_tools_and_private_suffix(root):
+    req = request(); a = observe(root,agent(),req)
+    b = observe(root,agent(account='other-account'),req)
+    assert a['fields']['declared_account'] != b['fields']['declared_account']
+    req['extra_body'] = {'prompt_cache_key': 'different-key', 'instructions': req['instructions']+'changed'}
+    c = observe(root,agent(),req)
+    assert a['fields']['cache_key'] != c['fields']['cache_key']
+    assert a['fields']['instructions'] != c['fields']['instructions']
+    assert a['fields']['common_prefix'] == c['fields']['common_prefix']
+    req['tools'].append({'type':'function','name':'other-tool'})
+    assert observe(root,agent(),req)['fields']['tools'] != a['fields']['tools']
+
+
+def test_missing_account_is_unknown_and_request_header_overrides_defaults(root):
+    a = agent();a._client_kwargs={}
+    f=observe(root,a,request())
+    assert f['fields']['declared_account'] is None and f['account_evidence']=='unknown'
+    req=request();req['extra_headers']={'chatgpt-account-id':'other-account','authorization':'private-token'}
+    assert observe(root,agent(),req)['fields']['declared_account']==observe(root,agent(account='other-account'),request())['fields']['declared_account']
+    req['extra_headers']['chatgpt-account-id']=None
+    assert observe(root,agent(),req)['account_evidence']=='unknown'
+
+
+def test_concurrent_creation_uses_one_complete_private_key(root):
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        keys=list(pool.map(cross._installation_key,[root]*24))
+    assert len(set(keys))==1 and len(keys[0])==32
+    directory=root/'telemetry/cache-cross-bot-v1'
+    assert directory.stat().st_mode&0o777==0o700
+    assert (directory/'fingerprint.key').stat().st_mode&0o777==0o600
+    assert list(directory.glob('.key-*'))==[]
+
+
+@pytest.mark.parametrize('unsafe', ['permissions','short','symlink','directory'])
+def test_unsafe_key_is_rejected_without_replacement(root,unsafe):
+    cross._installation_key(root)
+    directory=root/'telemetry/cache-cross-bot-v1';p=directory/'fingerprint.key'
+    if unsafe=='permissions':p.chmod(0o644)
+    elif unsafe=='short':p.write_bytes(b'bad')
+    elif unsafe=='directory':directory.chmod(0o755)
+    else:
+        p.unlink();other=root/'unrelated';other.write_bytes(b'x'*32);p.symlink_to(other)
+    with pytest.raises((OSError,ValueError)):
+        cross._installation_key(root)
+
+
+def test_oversized_fields_report_incomplete_not_false_identity(root,monkeypatch):
+    monkeypatch.setattr(cross,'_MAX_BYTES',1024)
+    req=request();req['tools']=[{'description':'private-long'*10000}]
+    f=observe(root,agent(),req)
+    assert not f['complete'] and not f['fields']['tools']['complete']
+    assert 'hash' not in f['fields']['tools']
+
+
+def test_observer_success_and_failure_are_once_and_preserve_payload(root,caplog):
+    req=request();original=copy.deepcopy(req);calls=[]
+    response={'usage':{'input_tokens':100,'input_tokens_details':{'cached_tokens':80}}}
+    def send(payload):calls.append(payload);return response
+    with caplog.at_level(logging.INFO):
+        assert local.observe_call(agent(),req,send,request_id='private-request') is response
+    row=json.loads(next(r.message.split('CACHE_DIAGNOSTIC ',1)[1] for r in caplog.records if 'CACHE_DIAGNOSTIC ' in r.message))
+    assert row['fingerprint']['cross_bot']['fields']['cache_key']['hash']
+    assert row['usage']['cached_tokens']==80 and len(calls)==1 and req==original
+    assert 'private' not in json.dumps(row) and 'secret-auth' not in json.dumps(row)
+    error=RuntimeError('private-provider-failure')
+    def fail(payload):calls.append(payload);raise error
+    with caplog.at_level(logging.INFO),pytest.raises(RuntimeError) as exc:
+        local.observe_call(agent(),req,fail,request_id='private-request')
+    assert exc.value is error and len(calls)==2 and req==original
+    assert 'private-provider-failure' not in caplog.text
+
+
+def test_cross_diagnostic_failure_is_independent_and_never_retries(root,monkeypatch,caplog):
+    def broken(home):raise OSError('secret-key-error')
+    monkeypatch.setattr(cross,'_installation_key',broken)
+    calls=[];response=object()
+    with caplog.at_level(logging.INFO):
+        assert local.observe_call(agent(),request(),lambda r:(calls.append(r),response)[1],request_id='r') is response
+    row=json.loads(next(r.message.split('CACHE_DIAGNOSTIC ',1)[1] for r in caplog.records if 'CACHE_DIAGNOSTIC ' in r.message))
+    assert row['fingerprint']['cross_bot']['unavailable']
+    assert row['fingerprint']['complete'] and len(calls)==1
+    assert 'secret-key-error' not in caplog.text
+
+
+def test_unknown_session_and_changed_options_are_not_conflated(root):
+    a=agent(session=None);req=request();first=observe(root,a,req)
+    assert first['fields']['session'] is None
+    req['reasoning']={'effort':'high'}
+    second=observe(root,a,req)
+    assert first['fields']['options']!=second['fields']['options']
+    assert first['fields']['cache_key']==second['fields']['cache_key']
