+  const [openingRowKey, setOpeningRowKey] = useState<string | null>(null)
+  const [openErrorKey, setOpenErrorKey] = useState<string | null>(null)
+  const opening = useRef(false)
+  const focusAfterClose = useRef<((event: Event) => void) | null>(null)
+  const dialogGeneration = useRef(0)
+  const scopeGeneration = useRef(0)
+  const heading = useRef<HTMLHeadingElement>(null)
+  const retryButton = useRef<HTMLButtonElement>(null)
+  const reconnectButton = useRef<HTMLButtonElement>(null)
+  const focusRefreshAfterReconnect = useRef(false)
+  const list = useRef<HTMLUListElement>(null)
+  const focusHeadingFromRetry = useCallback((fromReconnect = false) => {
+    const button = reconnectButton.current ?? retryButton.current
+    const title = heading.current
+    focusRefreshAfterReconnect.current = false
+    if (title && button && button.ownerDocument.activeElement === button) {
+      title.focus()
+      focusRefreshAfterReconnect.current = fromReconnect && button === reconnectButton.current
+    }
+  }, [])
+  const renderedItems = useRef<OwnerInboxItem[]>([])
+  const nextFocus = useRef<{ items: OwnerInboxItem[]; key: string } | null>(null)
+  const focusBeforeRowsChange = useCallback((keepsRow: (key: string) => boolean, nextItems?: OwnerInboxItem[]) => {
+    const focused = list.current?.ownerDocument.activeElement
+    const row = focused?.closest<HTMLElement>('[data-owner-prompt-key]')
+    const key = row?.dataset.ownerPromptKey
+    if (!key || !list.current?.contains(row ?? null) || keepsRow(key)) return
+
+    nextFocus.current = null
+    const previous = renderedItems.current.find(item => ownerPromptKey(item) === key)
+    if (previous?.kind === 'clarify' && nextItems) {
+      const existingKeys = new Set(renderedItems.current.map(ownerPromptKey))
+      const replacements = nextItems.filter(item =>
+        item.kind === 'clarify' && item.profile === previous.profile && item.session_id === previous.session_id &&
+        item.authority_epoch === previous.authority_epoch && item.execution_generation === previous.execution_generation &&
+        !existingKeys.has(ownerPromptKey(item))
+      )
+      if (replacements.length === 1) nextFocus.current = { items: nextItems, key: ownerPromptKey(replacements[0]) }
+    }
+
+    heading.current?.focus()
+  }, [])
+  const inbox = useOwnerInbox(focusHeadingFromRetry, focusBeforeRowsChange)
+  const kanbanAvailable = useValue($kanbanAvailable)
+  useLayoutEffect(() => {
+    if (!focusRefreshAfterReconnect.current || !inbox.connected || inbox.status !== 'unavailable') { return }
+
+    focusRefreshAfterReconnect.current = false
+    const title = heading.current
+
+    if (title && title.ownerDocument.activeElement === title) {
+      retryButton.current?.focus()
+    }
+  }, [inbox.connected, inbox.status])
+
+  useLayoutEffect(() => {
+    renderedItems.current = inbox.items
+    const focus = nextFocus.current
+    nextFocus.current = null
+    const title = heading.current
+    if (!focus || inbox.items !== focus.items || inbox.status !== 'ready' ||
+      !title || title.ownerDocument.activeElement !== title) return
+
+    const row = Array.from(list.current?.children ?? []).find(item => item.getAttribute('data-owner-prompt-key') === focus.key)
+    row?.querySelector<HTMLInputElement>('input:not(:disabled):not([aria-disabled="true"]):not([readonly])')?.focus()
+  }, [inbox.items, inbox.status])
+  const count = inbox.status === 'ready' ? inbox.items.length : 0
+  const needsRefresh = inbox.connected && inbox.status === 'unavailable' && inbox.items.length > 0
+  const status = openingChat ? '' : notice
+  const gatewayState = useValue(host.state.gateway)
+  const reconnect = connection === 'local' && !inbox.connected ? reconnectAction() : null
+  const canReconnect = (state: string) => state === 'closed' || state === 'error'
+  const showInlineReconnect = open && reconnect !== null
+  const reconnectRefused = useValue($localReconnectRefused)
+  let unavailableStatus = t.unavailable
+  if (inbox.connected && inbox.items.length) unavailableStatus = t.stale
+  if (showInlineReconnect) {
+    if (gatewayState === 'connecting') unavailableStatus = appText.composer.placeholderReconnecting
+    else if (canReconnect(gatewayState) && reconnectRefused) unavailableStatus = t.reconnectFailed
+  }
+
+  useLayoutEffect(() => {
+    if (showInlineReconnect) return showLocalReconnectInline()
+  }, [showInlineReconnect])
+
+  useEffect(() => {
+    const invalidateScope = () => {
+      scopeGeneration.current += 1
+      setNotice('')
+      setOpenErrorKey(null)
+      setOpeningRowKey(null)
+    }
+
+    const changeScope = () => {
+      focusHeadingFromRetry()
+      dialogGeneration.current += 1
+      drafts.clear()
+      invalidateScope()
+    }
+
+    const stop = [
+      host.state.connectionId.listen(changeScope),
+      host.state.profile.listen(changeScope),
+      host.state.gateway.listen((state, previous) => {
+        if (previous === 'open' || state === 'open') {
+          focusHeadingFromRetry(state === 'open')
+        }
+        invalidateScope()
+      })
+    ]
+
+    return () => {
+      scopeGeneration.current += 1
+      stop.forEach(unsubscribe => unsubscribe())
+    }
+  }, [drafts, focusHeadingFromRetry])
+
+  function changeOpen(next: boolean, handoff: ((event: Event) => void) | null = null) {
+    focusAfterClose.current = handoff
+
+    if (!next) {
+      focusRefreshAfterReconnect.current = false
+      dialogGeneration.current += 1
+      drafts.clear()
+      setNotice('')
+      setOpenErrorKey(null)
+      setOpeningRowKey(null)
+    }
+    setOpen(next)
+  }
+
+  async function openChat(prompt: OwnerInboxItem, action: HTMLButtonElement) {
+    if (opening.current || inbox.status !== 'ready' || !connection || host.state.connectionId.get() !== connection ||
+        host.state.gateway.get() !== 'open') { return }
+
+    opening.current = true
+    setOpeningChat(true)
+    setOpeningRowKey(ownerPromptKey(prompt))
+    setNotice('')
+    setOpenErrorKey(null)
+    const generation = dialogGeneration.current
+    const scope = scopeGeneration.current
+    const gateway = host.getGateway()
+
+    const isCurrentScope = () => scopeGeneration.current === scope &&
+      host.state.connectionId.get() === connection && host.getGateway() === gateway &&
+      host.state.gateway.get() === 'open'
+
+    const route = bots.find(bot => bot.profile === prompt.profile)?.route ?? {
+      connectionId: connection,
+      profile: prompt.profile,
+      targetProfile: prompt.profile,
+      mode: connection === 'local' ? 'local' as const : 'remote' as const
+    }
+
+    const storedId = prompt.chat_session_id || prompt.session_id
+    const doc = action.ownerDocument
+
+    try {
+      let approvalMissing = false
+      await host.openSession(storedId, {
+        route, forceResume: true, awaitHydration: true,
+        ...(connection === 'local' && (prompt.kind === 'clarify'
+          ? { expectedClarificationId: prompt.prompt_id }
+          : { expectedApprovalId: prompt.prompt_id, onApprovalMissing: () => { approvalMissing = true } }))
+      })
+
+      if (dialogGeneration.current === generation && isCurrentScope()) {
+        const owner = host.state.focusedSessionOwner?.get()
+
+        if (connection === 'local' &&
+          host.state.focusedStoredSessionId?.get() === storedId &&
+          owner?.connectionId === connection && owner.profile === prompt.profile &&
+          (prompt.kind === 'clarify'
+            ? host.state.focusedClarification?.get()?.requestId !== prompt.prompt_id
+            : approvalMissing)) {
+          inbox.refresh()
+        }
+
+        changeOpen(false, prompt.kind === 'clarify' && doc.activeElement === action ? event => {
+          const live = host.state.focusedClarification?.get()
+
+          if (!isCurrentScope() || doc.activeElement !== doc.body ||
+            live?.storedSessionId !== storedId || live.connectionId !== connection ||
+            live.profile !== prompt.profile || live.requestId !== prompt.prompt_id) {
+            return
+          }
+
+          // Let Radix restore its trigger if the live answer control can't take focus.
+          flushSync(() => host.focusPendingClarification?.(storedId))
+
+          if (doc.activeElement !== doc.body) {
+            event.preventDefault()
+          }
+        } : null)
+      }
+    } catch {
+      if (dialogGeneration.current === generation && isCurrentScope()) { setOpenErrorKey(ownerPromptKey(prompt)) }
+    } finally {
+      opening.current = false
+      setOpeningChat(false)
+      setOpeningRowKey(null)
+    }
+  }
+
+  function openCard(prompt: OwnerInboxItem) {
+    if (opening.current || connection !== 'local' || !inbox.isReady() || !prompt.card_board || !prompt.card ||
+        !queueKanbanCard(prompt.card_board, prompt.card)) {
+      return
+    }
+
+    changeOpen(false)
+    host.navigate('/kanban')
+  }
+
+  async function respond(prompt: OwnerInboxItem, value: string) {
+    const dialog = dialogGeneration.current
+    const scope = scopeGeneration.current
+    const gateway = host.getGateway()
+    const isCurrent = () => dialogGeneration.current === dialog &&
+      scopeGeneration.current === scope && host.getGateway() === gateway
+
+    setNotice('')
+    setOpenErrorKey(null)
+
+    try {
+      const result = await inbox.respond(prompt, value)
+
+      if (result && isCurrent()) {
+        drafts.delete(ownerPromptKey(prompt))
+        setNotice(result === 'resolved' ? t.sent : t.expired)
+      }
+    } catch {
+      const sameLocalApproval = prompt.kind === 'approval' && connection === 'local' && dialogGeneration.current === dialog
+      if (isCurrent() || sameLocalApproval) { throw new Error(t.failed) }
+    }
+  }
+
+  return <Dialog onOpenChange={changeOpen} open={open}>
+    <DialogTrigger asChild>
+      <Button aria-label={needsRefresh ? `${t.title} · ${t.refreshNeeded}` : count ? `${t.title} ${count}` : t.title}
+        size="sm" variant={needsRefresh || count ? 'secondary' : 'ghost'}>
+        {t.title}{count > 0 && <span className="tabular-nums">{count}</span>}
+        {needsRefresh && <span className="text-xs text-muted-foreground">{t.refreshNeeded}</span>}
+      </Button>
+    </DialogTrigger>
+    <DialogContent bodyClassName="flex flex-col overflow-hidden" className="w-[94vw] max-w-xl" data-owner-inbox="" onCloseAutoFocus={event => {
+      const handoff = focusAfterClose.current
