+"""THINK/ACTION must work through the real owner, workers and model tool boundary."""
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+from tests.gateway.fixtures.local_recovery_probe import child_env
+
+
+def test_role_handoff_through_native_gateway_and_independent_reviewer(tmp_path):
+    root = Path(__file__).resolve().parents[2]
+    env = child_env() | {'HOME': str(tmp_path / 'user'), 'USERPROFILE': str(tmp_path / 'user'),
+        'HERMES_HOME': str(tmp_path / 'state'), 'PYTHONPATH': str(root), 'HERMES_PYTHON': sys.executable,
+        'HERMES_DISABLE_LAZY_INSTALLS': '1'}
+    probe = root / 'tests/gateway/fixtures/role_workflow_probe.py'
+    result = subprocess.run([sys.executable, str(probe)], cwd=root, env=env, stdin=subprocess.DEVNULL,
+                            capture_output=True, text=True, timeout=240, check=False)
+    assert result.returncode == 0, result.stdout + result.stderr
+    receipt = json.loads((tmp_path / 'state/receipt.json').read_text())
+    assert receipt['done'] and receipt['external_model_calls'] == 0
+    assert [r['profile'] for r in receipt['runs']] == ['role-thinker', 'role-actor', 'role-reviewer']
+    assert receipt['wire_calls'] == {'role-think': 1, 'role-action': 3, 'role-review': 2}
