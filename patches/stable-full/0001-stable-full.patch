+"""Title recall must not hydrate a long transcript or an explicitly filtered-out match."""
+import json
+import pytest
+from hermes_state import SessionDB
+from tools.session_search_tool import session_search
+
+@pytest.fixture
+def archive(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session("archive", source="cli")
+    db.set_session_title("archive", "Quarterly archive review")
+    ids = [db.append_message("archive", role="user" if i % 2 == 0 else "assistant",
+                             content=f"entry {i} " + "x" * 4096) for i in range(80)]
+    db._conn.execute("UPDATE sessions SET started_at=1700000000 WHERE id='archive'")
+    db.end_session("archive", "cli_exit")
+    db._conn.commit()
+    yield db, ids
+    db.close()
+
+
+def watch_reads(monkeypatch, db):
+    counts = {"full_transcripts": 0, "hydrated": 0}
+    messages, hydrate = db.get_messages, db._row_to_message_dict
+    def get_messages(*args, **kwargs):
+        if kwargs.get("limit") is None: counts["full_transcripts"] += 1
+        return messages(*args, **kwargs)
+    def row(*args, **kwargs):
+        counts["hydrated"] += 1
+        return hydrate(*args, **kwargs)
+    monkeypatch.setattr(db, "get_messages", get_messages)
+    monkeypatch.setattr(db, "_row_to_message_dict", row)
+    return counts
+
+
+def title_result(db, **kwargs):
+    result = json.loads(session_search(query="Quarterly archive review", db=db, **kwargs))
+    assert result["success"]
+    return next((r for r in result["results"] if r.get("matched_role") == "session_title"), None)
+
+
+def test_title_recall_hydrates_only_its_bounded_windows(archive, monkeypatch):
+    db, ids = archive
+    counts = watch_reads(monkeypatch, db)
+    entry = title_result(db)
+    assert entry is not None and entry["match_message_id"] == ids[0]
+    assert entry["bookend_start"][0]["id"] == ids[0]
+    assert entry["bookend_end"][-1]["id"] == ids[-1]
+    assert counts["full_transcripts"] == 0
+    assert counts["hydrated"] < 25
+
+
+@pytest.mark.parametrize("filters", [{"exclude_session_ids": ["archive"]}, {"after": "2025-01-01"}])
+def test_filtered_title_match_is_rejected_before_payload_reads(archive, monkeypatch, filters):
+    db, _ = archive
+    counts = watch_reads(monkeypatch, db)
+    assert title_result(db, **filters) is None
+    assert counts == {"full_transcripts": 0, "hydrated": 0}
+
+
+def test_title_window_fallback_preserves_first_last_and_total_counts(archive, monkeypatch):
+    db, ids = archive
+    monkeypatch.setattr(db, "get_recall_anchored_view", lambda *args, **kwargs: {})
+    entry = title_result(db)
+    assert [m["id"] for m in entry["bookend_start"]] == ids[:3]
+    assert [m["id"] for m in entry["messages"]] == ids[:5]
+    assert [m["id"] for m in entry["bookend_end"]] == ids[-3:]
+    assert entry["messages_after"] == len(ids) - 5
+    assert entry["messages_before"] == 0
+
+
+def test_rewind_rows_are_not_returned_by_title_fallback(archive, monkeypatch):
+    db, ids = archive
+    db._conn.execute("UPDATE messages SET active=0 WHERE id=?", (ids[0],))
+    db._conn.commit()
+    monkeypatch.setattr(db, "get_recall_anchored_view", lambda *args, **kwargs: {})
+    entry = title_result(db)
+    assert entry["match_message_id"] == ids[1]
+    assert entry["bookend_start"][0]["id"] == ids[1]
+    assert entry["messages_after"] == len(ids) - 6
+
+
+def test_failed_bounded_title_read_never_retries_as_full_transcript(archive, monkeypatch):
+    db, _ = archive
+    counts = watch_reads(monkeypatch, db)
+    def refused(*args, **kwargs):
+        raise OSError("Synthetic bounded read refusal")
+    monkeypatch.setattr(db, "get_recall_bookends", refused)
+    entry = title_result(db)
+    assert entry is not None and not entry["messages"]
+    assert entry["detail"] == "unavailable"
+    assert entry["messages_before"] is None and entry["messages_after"] is None
+    assert "failed" in entry["warning"]
+    assert counts == {"full_transcripts": 0, "hydrated": 0}
+
+
+def test_legacy_adapter_keeps_title_but_not_unfiltered_messages(archive):
+    db, _ = archive
+    class LegacyAdapter:
+        def __getattr__(self, name):
+            if name == "get_recall_bookends":
+                raise AttributeError(name)
+            return getattr(db, name)
+    entry = title_result(LegacyAdapter())
+    assert entry is not None and entry["detail"] == "unavailable"
+    assert entry["match_message_id"] is None and not entry["messages"]
+    assert not entry["bookend_start"] and not entry["bookend_end"]
+
+
+def test_genuinely_empty_title_match_is_not_reported_as_failed(archive):
+    db, _ = archive
+    db.create_session("empty", source="cli")
+    db.set_session_title("empty", "Empty archive")
+    result = json.loads(session_search(query="Empty archive", db=db))
+    entry = next(r for r in result["results"] if r["matched_role"] == "session_title")
+    assert entry["session_id"] == "empty" and entry["detail"] == "full"
+    assert not entry["messages"] and entry["messages_before"] == entry["messages_after"] == 0
+    assert "warning" not in entry
