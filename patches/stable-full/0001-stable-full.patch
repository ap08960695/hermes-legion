+"""Installed character reads never select/install a mascot or cross profile paths."""
+from pathlib import Path
+import base64
+import hashlib
+import json
+import os
+from io import BytesIO
+
+import pytest
+from PIL import Image
+
+pytestmark = pytest.mark.skipif(os.name != "posix", reason="installed sprite reads require POSIX directory descriptors")
+
+
+@pytest.fixture
+def fleet(tmp_path, monkeypatch):
+    from tui_gateway import server
+    home = tmp_path / "fleet"
+    home.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(server, "_hermes_home", home)
+    for name, color in (("alpha", "red"), ("beta", "blue")):
+        profile = home / "profiles" / name
+        pet = profile / "pets" / "same"
+        pet.mkdir(parents=True)
+        (profile / "config.yaml").write_text("display:\n  pet:\n    enabled: false\n    slug: untouched\n")
+        (profile / "profile.yaml").write_text("name: " + name + "\n")
+        (pet / "pet.json").write_text(json.dumps({"displayName": name, "spritesheetPath": "spritesheet.png"}))
+        if name == "beta":
+            (pet / "pet.json").write_text(json.dumps({"displayName": name, "spritesheetPath": "spritesheet.webp"}))
+            Image.new("RGBA", (1536, 1872), color).save(pet / "spritesheet.webp", lossless=True)
+        else:
+            Image.new("RGBA", (1536, 1872), color).save(pet / "spritesheet.png")
+    return server, home
+
+
+def test_same_slug_reads_own_profile_with_display_disabled_without_mutation(fleet):
+    server, home = fleet
+    before = {str(p): p.read_bytes() for p in home.rglob("*") if p.is_file()}
+    results = []
+    for name in ("alpha", "beta"):
+        response = server.handle_request({"id": name, "method": "pet.sprite", "params": {"profile": name, "slug": "same"}})
+        assert not response.get("error"), response
+        payload = response["result"]
+        assert payload["enabled"] and payload["slug"] == "same" and payload["displayName"] == name
+        assert payload["frameW"] == 192 and payload["frameH"] == 208
+        raw = base64.b64decode(payload["spritesheetBase64"], validate=True)
+        extension = "webp" if name == "beta" else "png"
+        assert payload["mime"] == "image/" + extension
+        assert raw == (home / "profiles" / name / "pets/same" / ("spritesheet." + extension)).read_bytes()
+        results.append(hashlib.sha256(raw).hexdigest())
+    assert results[0] != results[1]
+    assert {str(p): p.read_bytes() for p in home.rglob("*") if p.is_file()} == before
+    absent = server.handle_request({"id": "absent", "method": "pet.sprite", "params": {"profile": "absent", "slug": "same"}})
+    assert absent.get("error"), absent
+
+
+def test_full_character_payload_does_not_reopen_the_decoded_sprite(fleet, monkeypatch):
+    server, home = fleet
+    sheet = home / "profiles/alpha/pets/same/spritesheet.png"
+    expected = sheet.read_bytes()
+    native_read = Path.read_bytes
+
+    def refuse_path_read(path):
+        if path == sheet:
+            raise AssertionError("full atlas reopened path after validation")
+        return native_read(path)
