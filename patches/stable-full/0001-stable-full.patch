+        with kbc.connect_closing(board=slug) as conn:
+            return kbd.dispatch_once(conn, board=slug, max_in_progress=2, spawn_fn=spawn)
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        first = pool.submit(tick, 'default')
+        assert entered.wait(timeout=10)
+        second = pool.submit(tick, 'other')
+        try:
+            second.result(timeout=10)
+            assert len(spawns) == 2
+        finally:
+            release.set()
+        first.result(timeout=10)
+
+
+def test_standalone_daemon_honors_profile_cap(board, monkeypatch):
+    _configuration(monkeypatch, max_in_progress=8, max_in_progress_per_profile=1)
+    with kbc.connect_closing() as conn:
+        _running(conn)
+        same = kb.create_task(conn, title='same profile', assignee='alice')
+        other = kb.create_task(conn, title='other profile', assignee='bob')
+    spawns = []
+    monkeypatch.setattr(kbd, '_default_spawn', lambda task, workspace, board=None: spawns.append(task.id))
+    stop = _OneTick()
+    kbd.run_daemon(interval=0.01, stop_event=stop, on_tick=lambda _: stop.set())
+    assert spawns == [other]
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, same).status == 'ready'
+
+
+def test_standalone_daemon_does_not_launch_with_malformed_settings(board, monkeypatch):
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title='waiting', assignee='alice')
+    monkeypatch.setattr(config, 'load_config_readonly', lambda: {'kanban': 'malformed'})
+    spawns = []
+    monkeypatch.setattr(kbd, '_default_spawn', lambda task, workspace, board=None: spawns.append(task.id))
+    stop = _OneTick()
+    kbd.run_daemon(interval=0.01, stop_event=stop, on_tick=lambda _: stop.set())
+    assert spawns == []
+    with kbc.connect_closing() as conn:
+        assert kb.get_task(conn, tid).status == 'ready'
