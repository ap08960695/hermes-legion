+import asyncio
+from concurrent.futures import ThreadPoolExecutor
+import json
+import threading
+from pathlib import Path
+
+import pytest
+from tools import vision_request_cache as cache
+from tools import vision_tools as vision
+
+RESULT = json.dumps({'success': True, 'analysis': 'offline result', 'scale_note': 'preserved'})
+
+
+def test_concurrent_threads_and_event_loops_share_one_call(monkeypatch):
+    store = cache.VisionCache()
+    entered, release, joined = threading.Event(), threading.Event(), threading.Event()
+    calls = []
+    original = asyncio.wrap_future
+
+    def wrapped(future):
+        joined.set()
+        return original(future)
+
+    monkeypatch.setattr(asyncio, 'wrap_future', wrapped)
+
+    async def call():
+        calls.append(1)
+        entered.set()
+        await asyncio.to_thread(release.wait, 3)
+        return RESULT
+
+    with ThreadPoolExecutor(2) as pool:
+        first = pool.submit(asyncio.run, store.run('key', call))
+        assert entered.wait(3)
+        second = pool.submit(asyncio.run, store.run('key', call))
+        assert joined.wait(3)
+        release.set()
+        assert first.result(3) == second.result(3) == RESULT
+    assert calls == [1]
+    assert asyncio.run(store.run('key', call)) == RESULT
+    assert calls == [1]
+
+
+def test_follower_cancellation_does_not_cancel_owner():
+    async def scenario():
+        store = cache.VisionCache()
+        entered, release = asyncio.Event(), asyncio.Event()
+        async def call():
+            entered.set()
+            await release.wait()
+            return RESULT
+        owner = asyncio.create_task(store.run('key', call))
+        await entered.wait()
+        follower = asyncio.create_task(store.run('key', call))
+        await asyncio.sleep(0)
+        follower.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await follower
+        release.set()
+        assert await owner == RESULT
+        assert await store.run('key', call) == RESULT
+    asyncio.run(scenario())
+
+
+def test_owner_cancellation_releases_followers_without_retry():
+    async def scenario():
+        store = cache.VisionCache()
+        entered = asyncio.Event()
+        calls = []
+        async def call():
+            calls.append(1)
+            entered.set()
+            await asyncio.Event().wait()
+        owner = asyncio.create_task(store.run('key', call))
+        await entered.wait()
+        follower = asyncio.create_task(store.run('key', call))
+        await asyncio.sleep(0)
+        owner.cancel()
+        for task in (owner, follower):
+            with pytest.raises(asyncio.CancelledError):
+                await task
+        assert not store.pending and not store.done and calls == [1]
+    asyncio.run(scenario())
+
+
+@pytest.mark.parametrize('value', ['{"success":false}', '{}', 'bad-json', '{"success":true,"analysis":""}', {'_multimodal': True}])
+def test_failures_and_pixels_are_not_cached(value):
+    calls = []
+    async def call():
+        calls.append(1)
+        return value
+    store = cache.VisionCache()
+    for _ in range(2):
+        assert asyncio.run(store.run('key', call)) == value
+    assert len(calls) == 2 and not store.done
+
+
+def test_exception_cleans_pending():
+    async def call():
+        raise RuntimeError('offline')
+    store = cache.VisionCache()
+    with pytest.raises(RuntimeError):
+        asyncio.run(store.run('key', call))
+    assert not store.pending and not store.done
+
