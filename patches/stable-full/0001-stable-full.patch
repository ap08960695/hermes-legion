@@ -0,0 +1,65 @@
+import { notifyError } from '@/store/notifications'
+import { normalizeProfileKey } from '@/store/profile'
+import {
+  $activeSessionId,
+  $selectedStoredSessionId,
+  $sessions,
+  knownSessionOwner,
+  lineageAliases,
+  ownerLookupSessionRows
+} from '@/store/session'
+import { isSessionOwnerRoute, type SessionOwnerScope } from '@/store/session-request-router'
+import { $sessionTiles, runtimeSessionOwner, type SessionTileWorkspaceScope } from '@/store/session-states'
+import { canOpenSessionWindow, openSessionInNewWindow } from '@/store/windows'
+
+function sameOwner(left: SessionOwnerScope, right: SessionOwnerScope): boolean {
+  if (typeof left === 'string' && typeof right === 'string') {
+    return normalizeProfileKey(left) === normalizeProfileKey(right)
+  }
+
+  return (
+    isSessionOwnerRoute(left) &&
+    isSessionOwnerRoute(right) &&
+    left.connectionId === right.connectionId &&
+    normalizeProfileKey(left.profile) === normalizeProfileKey(right.profile) &&
+    normalizeProfileKey(left.targetProfile ?? left.profile) ===
+      normalizeProfileKey(right.targetProfile ?? right.profile)
+  )
+}
+
+/** A visible runtime cannot be retargeted just because another owner uses the same stored id. */
+export function openConflictingSessionInWindow(storedSessionId: string, scope: SessionTileWorkspaceScope): boolean {
+  const requested = scope.ownerRoute ?? scope.ownerProfile
+
+  if (!requested) {
+    return false
+  }
+
+  const aliases = lineageAliases(storedSessionId, $sessions.get())
+  const tile = $sessionTiles.get().find(candidate => aliases.includes(candidate.storedSessionId))
+  const main = $selectedStoredSessionId.get()
+
+  if (!tile && !aliases.includes(main ?? '')) {
+    return false
+  }
+
+  const runtimeOwner = runtimeSessionOwner(tile ? tile.runtimeId : $activeSessionId.get())
+
+  const current =
+    runtimeOwner ?? (tile ? (tile.ownerRoute ?? tile.ownerProfile) : knownSessionOwner(ownerLookupSessionRows(), main))
+
+  if (sameOwner(current, requested)) {
+    return false
+  }
+
+  if (canOpenSessionWindow()) {
+    void openSessionInNewWindow(storedSessionId, scope)
+  } else {
+    notifyError(
+      new Error('This history needs a separate Desktop window to preserve the already-open session.'),
+      'Could not open chat in a new window'
+    )
+  }
+
+  return true
+}
