@@ -0,0 +1,68 @@
+"""Bounded, origin-scoped file preview checks. Returns no file content."""
+import asyncio
+from pathlib import Path
+from typing import Optional,Annotated
+from fastapi import APIRouter, HTTPException, Request
+from pydantic import BaseModel, Field
+from hermes_cli.ssh_workspace_fs import SshWorkspaceFsError
+
+router = APIRouter()
+_PREVIEW_MEDIA_MIMES = frozenset({'application/pdf','image/png','image/jpeg','image/gif','image/webp','image/svg+xml','image/bmp','image/x-icon','image/avif','audio/mpeg','audio/wav','audio/x-wav','audio/ogg','audio/flac','audio/x-flac','audio/mp4','audio/webm','audio/aac','video/mp4','video/webm','video/ogg'})
+
+class PreviewCheck(BaseModel):
+    session_id: str = Field(min_length=1, max_length=512)
+    paths: list[Annotated[str,Field(min_length=1,max_length=8192)]] = Field(max_length=64)
+
+
+def _format_state(path: Path, size: int) -> str:
+    from hermes_cli.web_routers import files
+    from hermes_cli.web_server import _FS_DATA_URL_MAX_BYTES
+    mime = files._fs_mime_type(path).split(';',1)[0]
+    if mime.startswith(('image/', 'audio/', 'video/')) or mime == 'application/pdf':
+        if mime not in _PREVIEW_MEDIA_MIMES:
+            return 'unsupported'
+        return 'ready' if size <= _FS_DATA_URL_MAX_BYTES else 'too_large'
+    if mime.startswith('text/') or path.suffix.lower() in files._FS_PREVIEW_LANGUAGE_BY_EXT:
+        return 'ready' if size <= files._FS_TEXT_SOURCE_MAX_BYTES else 'too_large'
+    return 'unsupported'
+
+
+def _check_path(raw: str, backend, cwd: str, request: Request) -> dict:
+    from hermes_cli.web_routers import files
+    state = 'unavailable'
+    try:
+        if backend is None:
+            target = files._fs_path(raw, cwd=cwd)
+            files._hosted_fs_read_guard(target, request)
+            target, st = files._fs_regular_file(target)
+            state = _format_state(target, st.st_size)
+            if state == 'ready':
+                prefix = files._fs_read_bytes(target, min(st.st_size,4096))
+                if files._fs_mime_type(target).startswith('text/') and files._fs_looks_binary(prefix):
+                    state = 'unsupported'
+        else:
+            if not Path(raw).is_absolute():
+                return {'path':raw,'state':'unavailable'}
+            target, size = backend.inspect_file(raw)
+            if files._is_sensitive_path(Path(target)):
+                return {'path':raw,'state':'unreadable'}
+            state = _format_state(Path(target),size)
+            if state == 'ready':
+                backend.read_bytes(target,max_bytes=files._FS_TEXT_SOURCE_MAX_BYTES,read_limit=4096)
+    except HTTPException as exc:
+        state = {404:'missing',403:'unreadable',413:'too_large'}.get(exc.status_code,'unavailable')
+    except (OSError,ValueError) as exc:
+        state = 'missing' if isinstance(exc,FileNotFoundError) else 'unreadable'
+    except SshWorkspaceFsError as exc:
+        state = {'ENOENT':'missing','EACCES':'unreadable'}.get(exc.code,'unavailable')
+    return {'path':raw,'state':state}
+
+
