+"""Global pause controls must operate on the fleet root, even from a profile."""
+
+import argparse
+import errno
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from agent import estop
+
+
+@pytest.fixture
+def fleet(tmp_path, monkeypatch):
+    root = tmp_path / "fleet"
+    alpha = root / "profiles" / "alpha"
+    beta = root / "profiles" / "beta"
+    alpha.mkdir(parents=True)
+    beta.mkdir(parents=True)
+    monkeypatch.setenv("HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_HOME", str(alpha))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(root))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    return root, alpha, beta
+
+
+class PauseEvent:
+    def __init__(self, args):
+        self.args = args
+
+    def get_command_args(self):
+        return self.args
+
+
+def reject_root_creation(monkeypatch, path):
+    original = os.open
+
+    def denied_open(target, *args, **kwargs):
+        if os.fspath(target) == os.fspath(path):
+            raise PermissionError(errno.EACCES, "simulated root creation denial")
+        return original(target, *args, **kwargs)
+
+    monkeypatch.setattr(os, "open", denied_open)
+
+
+def test_cli_pause_from_profile_is_visible_to_other_profile(fleet, monkeypatch, capsys):
+    from hermes_cli.subcommands.pause import cmd_pause
+
+    root, alpha, beta = fleet
+    assert cmd_pause(argparse.Namespace(reason="fleet work")) == 0
+    assert (root / "ESTOP").exists()
+    assert not (alpha / "ESTOP").exists()
+    assert str(root / "ESTOP") in capsys.readouterr().out
+    monkeypatch.setenv("HERMES_HOME", str(beta))
+    assert estop.is_engaged() is True
+    assert estop.get_state()["reason"] == "fleet work"
+
+
+@pytest.mark.asyncio
+async def test_gateway_pause_from_profile_is_visible_to_other_profile(fleet, monkeypatch):
+    from gateway.run import GatewayRunner
+
+    root, alpha, beta = fleet
+    runner = object.__new__(GatewayRunner)
+    reply = await runner._handle_pause_command(PauseEvent("fleet work"))
+    assert "paused" in reply.lower()
+    assert (root / "ESTOP").exists() and not (alpha / "ESTOP").exists()
+    monkeypatch.setenv("HERMES_HOME", str(beta))
+    assert estop.is_engaged() is True
+
+
+@pytest.mark.asyncio
+async def test_local_pause_does_not_prevent_a_fleet_pause(fleet, monkeypatch):
+    from gateway.run import GatewayRunner
+
+    root, alpha, beta = fleet
+    local = alpha / "ESTOP"
+    local.write_text(json.dumps({"reason": "local only"}), encoding="utf-8")
+    old = local.read_bytes()
+    reply = await object.__new__(GatewayRunner)._handle_pause_command(PauseEvent(""))
+    assert "paused" in reply.lower()
+    assert (root / "ESTOP").exists() and local.read_bytes() == old
+    monkeypatch.setenv("HERMES_HOME", str(beta))
+    assert estop.is_engaged() is True
+
+
+@pytest.mark.asyncio
+async def test_gateway_reports_the_root_reason_not_a_local_reason(fleet):
+    from gateway.run import GatewayRunner
+
+    root, alpha, _ = fleet
+    (root / "ESTOP").write_text(json.dumps({"reason": "fleet reason"}), encoding="utf-8")
+    (alpha / "ESTOP").write_text(json.dumps({"reason": "local reason"}), encoding="utf-8")
+    reply = await object.__new__(GatewayRunner)._handle_pause_command(PauseEvent(""))
+    assert "fleet reason" in reply and "local reason" not in reply
+
+
+def test_cli_pause_does_not_claim_fleet_success_on_local_pause_alone(fleet, monkeypatch, capsys):
+    from hermes_cli.subcommands.pause import cmd_pause
+
+    root, alpha, _ = fleet
+    local = alpha / "ESTOP"
+    local.write_text(json.dumps({"reason": "local only"}), encoding="utf-8")
+    old = local.read_bytes()
+    reject_root_creation(monkeypatch, root / "ESTOP")
+    assert cmd_pause(argparse.Namespace(reason="fleet request")) != 0
+    assert "unable to confirm" in capsys.readouterr().err.lower()
+    assert local.read_bytes() == old and not (root / "ESTOP").exists()
+
+
+@pytest.mark.asyncio
+async def test_gateway_does_not_claim_fleet_success_on_local_pause_alone(fleet, monkeypatch):
+    from gateway.run import GatewayRunner
+
+    root, alpha, _ = fleet
+    local = alpha / "ESTOP"
+    local.write_text(json.dumps({"reason": "local only"}), encoding="utf-8")
+    old = local.read_bytes()
+    reject_root_creation(monkeypatch, root / "ESTOP")
+    reply = await object.__new__(GatewayRunner)._handle_pause_command(PauseEvent("fleet request"))
+    assert "unable to confirm" in reply.lower()
+    assert local.read_bytes() == old and not (root / "ESTOP").exists()
+
+
+def test_existing_fleet_reason_is_preserved_when_pause_has_no_reason(fleet):
+    from hermes_cli.subcommands.pause import cmd_pause
+
+    root, alpha, _ = fleet
+    marker = root / "ESTOP"
+    marker.write_text(json.dumps({"reason": "existing fleet reason"}), encoding="utf-8")
+    before = marker.read_bytes()
+    assert cmd_pause(argparse.Namespace(reason=None)) == 0
+    assert marker.read_bytes() == before and not (alpha / "ESTOP").exists()
+
+
+def test_pause_without_reason_preserves_a_concurrently_created_fleet_pause(fleet, monkeypatch):
+    from hermes_cli.subcommands.pause import cmd_pause
+
+    root, _, _ = fleet
+    marker = root / "ESTOP"
+    original = estop._sentinel_exists
+    inserted = False
+
+    def concurrent_check(path):
+        nonlocal inserted
+        result = original(path)
+        if path == marker and result is False and not inserted:
+            inserted = True
+            marker.write_text(json.dumps({"reason": "other request"}), encoding="utf-8")
+        return result
+
+    monkeypatch.setattr(estop, "_sentinel_exists", concurrent_check)
+    assert cmd_pause(argparse.Namespace(reason=None)) == 0
+    assert json.loads(marker.read_text(encoding="utf-8"))["reason"] == "other request"
+
+
+def test_context_profile_override_targets_its_own_fleet(fleet, tmp_path):
+    import hermes_constants
+    from hermes_cli.subcommands.pause import cmd_pause
+
+    first_root, _, _ = fleet
+    second_root = tmp_path / "other-fleet"
+    other = second_root / "profiles" / "other"
+    other.mkdir(parents=True)
