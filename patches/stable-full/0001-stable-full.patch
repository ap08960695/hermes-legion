+  const { container } = render(<ChartRenderer code={JSON.stringify({ type: 'bar', labels, series: [{ name: 'Count', values: labels.map((_, index) => index) }] })} />)
+  const ticks = [...container.querySelectorAll('svg text')].filter(node => node.getAttribute('y') === '228')
+  expect(ticks.length).toBeGreaterThan(0)
+  expect(ticks.length).toBeLessThanOrEqual(4)
+})
+
+it('lets Page Up and Page Down scroll focused chart values instead of the conversation', async () => {
+  renderHook(() => useKeybinds({
+    archiveSelectedSession: vi.fn(),
+    openNewSessionTab: vi.fn(),
+    requestGateway: vi.fn(),
+    startFreshSession: vi.fn(),
+    toggleCommandCenter: vi.fn(),
+    toggleSelectedPin: vi.fn()
+  }), { wrapper: MemoryRouter })
+  render(<ChartRenderer code={JSON.stringify({
+    type: 'bar', title: 'Orders', labels: ['A'], series: [{ name: 'Count', values: [2] }]
+  })} />)
+  fireEvent.click(screen.getByText('Chart values'))
+  const region = await screen.findByRole('region', { name: 'Chart values' })
+  const trigger = screen.getByRole('button', { name: 'Open preview: Orders' })
