+import { cleanup, render, screen, fireEvent } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+// eslint-disable-next-line no-restricted-imports
+import { registerPluginLocales } from '@/i18n/plugin-i18n'
+import { BOTS_LOCALES } from './i18n'
+import { BotsWorkspace } from './workspace'
+const io = vi.hoisted(() => ({
+  open: vi.fn(),
+  refetch: vi.fn(),
+  rows: [
+    {
+      name: 'writer',
+      description: 'Writes release documentation',
+      sourceReachable: true,
+      connectionId: 'owner-one',
+      canonical_session: { id: 'kept', preview: 'Existing release draft' }
+    },
+    { name: 'offline', description: 'Offline reviewer', sourceReachable: false, connectionId: 'owner-two' }
+  ]
+}))
+vi.mock('./data', async original => ({
+  ...(await original<typeof import('./data')>()),
+  useRoster: () => ({ data: { profiles: io.rows }, isLoading: false, error: null, refetch: io.refetch })
+}))
+vi.mock('./avatar', () => ({
+  botAppearance: () => ({}),
+  avatarColor: () => '#888888',
+  BotFace: () => <span aria-hidden="true">Avatar</span>
+}))
+vi.mock('./roster-actions', () => ({ openRosterBot: io.open }))
+let dispose: () => void
+beforeEach(() => {
+  dispose = registerPluginLocales('hermes-bots', BOTS_LOCALES)
+})
+afterEach(() => {
+  cleanup()
+  dispose()
+  vi.clearAllMocks()
+})
+it('shows role and preview, filters locally, and opens only the exact existing bot owner after a click', () => {
+  render(<BotsWorkspace />)
+  expect(screen.getByText('Writes release documentation')).toBeTruthy()
+  expect(screen.getByText('Existing release draft')).toBeTruthy()
+  expect(io.open).not.toHaveBeenCalled()
+  const buttons = screen.getAllByRole('button', { name: 'Open chat' })
+  expect((buttons[1] as HTMLButtonElement).disabled).toBe(true)
+  fireEvent.click(buttons[0])
+  expect(io.open).toHaveBeenCalledExactlyOnceWith(io.rows[0])
+  fireEvent.change(screen.getByRole('textbox', { name: 'Search bots and roles' }), { target: { value: 'Offline' } })
+  expect(screen.queryByText('Writes release documentation')).toBeNull()
+  expect(screen.getByText('Offline reviewer')).toBeTruthy()
+  expect(io.refetch).not.toHaveBeenCalled()
+})
+
+it('labels configured model/provider from roster metadata with an honest unknown fallback', () => {
+  Object.assign(io.rows[0], { model: 'example-model', provider: 'example-provider' })
+  render(<BotsWorkspace />)
+  expect(screen.getByText('example-model')).toBeTruthy()
+  expect(screen.getByText('example-provider')).toBeTruthy()
+  expect(screen.getByText('Model not reported')).toBeTruthy()
+  expect(io.refetch).not.toHaveBeenCalled()
+})
+
+it('accepts pasted role searches without refetching or opening a bot', () => {
+  render(<BotsWorkspace />)
+  fireEvent.change(screen.getByRole('textbox', { name: 'Search bots and roles' }), {
+    target: { value: '  documentation  ' }
+  })
+  expect(screen.getByText('Writes release documentation')).toBeTruthy()
+  expect(screen.queryByText('Offline reviewer')).toBeNull()
+  expect(io.refetch).not.toHaveBeenCalled()
+  expect(io.open).not.toHaveBeenCalled()
+})
