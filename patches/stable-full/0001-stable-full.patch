+"""Exercise the native task-to-owner policy boundary without spawning a worker."""
+from types import SimpleNamespace
+
+from gateway.session_contract import Principal
+from gateway.session_kanban import build_kanban_policy
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_workspace as workspace
+from hermes_constants import get_hermes_home
+
+
+def claimed_worker_policy(task_id, monkeypatch, config):
+    home = str(get_hermes_home().resolve())
+    monkeypatch.setattr('hermes_cli.profiles.resolve_profile_env', lambda name: home)
+    with kbc.connect_closing() as conn:
+        created = kb.get_task(conn, task_id)
+        path = workspace.resolve_workspace(created)
+        workspace.set_workspace_path(conn, task_id, path)
+        kb.recompute_ready(conn)
+        task = kb.claim_task(conn, task_id)
+        assert task is not None
+    actor = Principal('fixture-owner', home, frozenset({'session:create'}), 'transport')
+    connection = SimpleNamespace(authority=SimpleNamespace(profile_id=home), actor=actor, native_owner=True)
+    params = {'board': 'default', 'task_id': task.id, 'run_id': task.current_run_id,
+              'claim_lock': task.claim_lock, 'db': str(kb.kanban_db_path().resolve())}
+    return build_kanban_policy(connection, params, config)[0]
