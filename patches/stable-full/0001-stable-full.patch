+"""A routed native worker imports its owner's source after the secret/env scrub."""
+import asyncio
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+
+@pytest.mark.parametrize('routed', [True, False])
+def test_worker_uses_owner_source_instead_of_stale_runtime_package(tmp_path, monkeypatch, routed):
+    from gateway import session_managed_worker as managed
+    from gateway import session_managed_worker_log
+    from cron import scheduler_worker_env
+
+    root = Path(managed.__file__).resolve().parents[1]
+    stale = tmp_path / 'stale-runtime'
+    package = stale / 'agent'
+    package.mkdir(parents=True)
+    (package / '__init__.py').write_text('STALE_RUNTIME = True\n')
+    # The routed profile's sanitizer legitimately removed the Hermes checkout.
+    # The surviving editable/runtime package must not win module resolution.
+    env = {k: os.environ[k] for k in ('PATH', 'LANG', 'HERMES_DISABLE_LAZY_INSTALLS') if k in os.environ}
+    env.update(PYTHONPATH=str(stale), PYTHONSAFEPATH='1', PYTHONDONTWRITEBYTECODE='1',
+               HERMES_HOME=str(tmp_path / 'owned'), OWN_TOOL_TOKEN='synthetic-owned')
+    monkeypatch.setattr(managed, '_worker_env', lambda authority: dict(env) if routed else None)
+    if not routed:
+        for key, value in env.items():
+            monkeypatch.setenv(key, value)
+    monkeypatch.setattr(session_managed_worker_log, 'worker_log_path', lambda profile: None)
+    # This test runtime owns its dependencies; retain the helper's native no-generation branch.
+    monkeypatch.setattr(scheduler_worker_env, '_committed_dependency_site_packages', lambda source: None)
+    native_popen = subprocess.Popen
+    seen = []
+
+    def import_probe(argv, **kwargs):
+        seen.append(kwargs)
+        return native_popen([sys.executable, '-P', '-c',
+            'import agent, agent.reasoning_limits, json, os; '
+            'print(json.dumps({"source":list(agent.__path__)[0], '
+            '"own_secret":os.environ.get("OWN_TOOL_TOKEN")}))'], **kwargs)
+
+    monkeypatch.setattr(managed.subprocess, 'Popen', import_probe)
+    authority = SimpleNamespace(profile_id=str(tmp_path / 'owned'), pending_stop_causes={})
+    ref = SimpleNamespace(session_id='synthetic-source-pin')
+    _worker, process = asyncio.run(managed._spawn_registered_worker(authority, ref, {'generation':1}))
+    try:
+        stdout, _ = process.communicate(timeout=15)
+        assert process.returncode == 0, 'Managed child imported stale package or lost dependencies'
+        result = json.loads(stdout)
+        assert Path(result['source']).resolve() == root / 'agent'
+        assert result['own_secret'] == 'synthetic-owned'
+        assert str(stale) in seen[0]['env']['PYTHONPATH'].split(os.pathsep)
+        assert seen[0]['env']['HERMES_HOME'] == str(tmp_path / 'owned')
+    finally:
+        if process.poll() is None:
+            process.kill()
+            process.wait(timeout=5)
+        process.stdin.close() if not process.stdin.closed else None
+        process.stdout.close() if not process.stdout.closed else None
