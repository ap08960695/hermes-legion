@@ -0,0 +1,191 @@
+"""Owned SIGKILLs during real Git stash, tree moves and the subsequent native launch recovery."""
+import contextlib
+import os
+from pathlib import Path
+import select
+import shlex
+import signal
+import stat
+import subprocess
+import sys
+
+import pytest
+
+from tests.hermes_cli.test_update_preserve_interruption import (
+    SOURCE, kill_owned_update, prepared_install,
+)
+from tests.hermes_cli.test_update_target_identity import git
+
+
+def barrier_filter(tmp_path, root):
+    ready, release = tmp_path / 'ready', tmp_path / 'release'
+    os.mkfifo(ready)
+    os.mkfifo(release)
+    script = tmp_path / 'smudge-barrier.py'
+    script.write_text('import os, sys\n'
+                      f'with open({str(ready)!r}, "wb", buffering=0) as ready:\n'
+                      '    ready.write(b"READY")\n'
+                      f'with open({str(release)!r}, "rb", buffering=0) as release:\n'
+                      '    release.read(1)\n'
+                      'sys.stdout.buffer.write(sys.stdin.buffer.read())\n')
+    git(root, 'config', 'filter.preservation_barrier.smudge', shlex.join([sys.executable, str(script)]))
+    git(root, 'config', 'filter.preservation_barrier.clean', 'cat')
+    git(root, 'config', 'filter.preservation_barrier.required', 'true')
+    return ready
+
+
+def kill_at_barrier(command, tmp_path, env, ready):
+    """No timers or polling: a FIFO proves Git reached its actual smudge operation."""
+    fd = os.open(ready, os.O_RDONLY | os.O_NONBLOCK)
+    child = subprocess.Popen(command, cwd=tmp_path, env=env, start_new_session=True,
+                             stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    try:
+        readable, _, _ = select.select([fd], [], [], 30)
+        assert readable and os.read(fd, 5) == b'READY', 'owned Git did not reach the write barrier'
+    finally:
+        os.close(fd)
+        with contextlib.suppress(ProcessLookupError):
+            os.killpg(child.pid, signal.SIGKILL)  # windows-footgun: ok -- POSIX-marked callers, owned child group
+        output, error = child.communicate(timeout=15)
+    assert child.returncode == -9, (output, error)
+
+
+def interrupted_git_write(tmp_path, monkeypatch, phase):
+    root, before, launcher, env = prepared_install(tmp_path, monkeypatch, target_addition=phase == 'addition')
+    original = b'local source customization\n' if phase == 'stash' else b'previous release\n'
+    (root / 'release.txt').write_bytes(original)
+    ready = barrier_filter(tmp_path, root)
+    child = tmp_path / 'write-child.py'
+    child.write_text('''
+import sys
+from pathlib import Path
+sys.path.insert(0, sys.argv[1])
+from hermes_cli import main, update_cmd as update
+from hermes_cli.update_lock import UpdateLock
+root = Path(sys.argv[2])
+assert root.resolve().parent == Path(__file__).resolve().parent
+main.PROJECT_ROOT = root
+update._UPDATE_CRITICAL_MODULES = ()
+update._posix_pause.pause_at_commit_point = lambda: None
+lock = UpdateLock(install_root=root)
+assert lock.acquire()
+update._commit.begin_update_attempt()
+update._commit.record_run_start(['git'], root)
+metadata = update._capture_customization_metadata(['git'], root)
+attributes = root / '.git/info/attributes'
+def arm_filter():
+    name = 'added-source.py' if sys.argv[3] == 'addition' else 'release.txt'
+    attributes.write_text(name + ' filter=preservation_barrier\\n')
+if sys.argv[3] == 'stash':
+    from hermes_cli import update_cmd_stash as stashing
+    push = stashing._push_stash
+    def blocking_push(*args, **kwargs):
+        arm_filter()
+        return push(*args, **kwargs)
+    stashing._push_stash = blocking_push
+stash = update._stash_local_changes_if_needed(['git'], root)
+arm_filter()
+update._pull_updates(['git'], 'main', stash, prompt_for_restore=False, gw_input_fn=None,
+    discard_local_changes=False, keep_stash=False, preserve_local_changes=True, file_metadata=metadata)
+''')
+    kill_at_barrier([sys.executable, '-I', str(child), str(SOURCE), str(root), phase], tmp_path, env, ready)
+    (root / '.git/info/attributes').unlink()
+    return root, before, launcher, env, original
+
+
+@pytest.mark.platforms('posix')
+@pytest.mark.parametrize('phase', ['stash', 'move'])
+@pytest.mark.parametrize('damage', ['missing', 'prefix'])
+def test_partial_git_writes_recover_all_original_source_before_boot(tmp_path, monkeypatch, phase, damage):
+    root, before, launcher, env, original = interrupted_git_write(tmp_path, monkeypatch, phase)
+    assert not (root / 'release.txt').exists(), 'the real Git write did not stop before replacement'
+    if damage == 'prefix':
+        target = b'previous release\n' if phase == 'stash' else b'next release\n'
+        (root / 'release.txt').write_bytes(target[:5])
+    boot = subprocess.run([str(launcher)], cwd=tmp_path, env=env, capture_output=True,
+                          text=True, timeout=30, check=False)
+    assert boot.returncode == 0 and 'APP_REACHED' in boot.stdout, boot.stderr
+    assert git(root, 'rev-parse', 'HEAD') == before
+    assert (root / 'release.txt').read_bytes() == original
+    assert (root / 'local-helper.py').read_bytes() == b'LOCAL_VALUE = 7\n'
+    assert stat.S_IMODE((root / 'local-helper.py').stat().st_mode) == 0o640
+    assert git(root, 'diff', '--cached', '--name-only') == '.gitignore'
+
+
+@pytest.mark.platforms('posix')
+def test_a_second_kill_during_native_recovery_resumes_without_losing_patches(tmp_path, monkeypatch):
+    root, before, launcher, env = kill_owned_update(tmp_path, monkeypatch, 'before-restoration')
+    ready = barrier_filter(tmp_path, root)
+    (root / '.git/info/attributes').write_text('release.txt filter=preservation_barrier\n')
+    kill_at_barrier([str(launcher)], tmp_path, env, ready)
+    (root / '.git/info/attributes').unlink()
+    assert (root / '.git/hermes-update-pull').exists()
+    boot = subprocess.run([str(launcher)], cwd=tmp_path, env=env, capture_output=True,
+                          text=True, timeout=30, check=False)
+    assert boot.returncode == 0 and 'APP_REACHED' in boot.stdout, boot.stderr
+    assert git(root, 'rev-parse', 'HEAD') == before
+    assert (root / 'release.txt').read_bytes() == b'previous release\n'
+    assert (root / 'local-helper.py').read_bytes() == b'LOCAL_VALUE = 7\n'
+
+
+@pytest.mark.platforms('posix')
+def test_conflicting_local_patch_never_authorizes_overwriting_foreign_content(tmp_path, monkeypatch):
+    root, _before, launcher, env = kill_owned_update(
+        tmp_path, monkeypatch, 'before-restoration', custom_release=b'local customization\n')
+    foreign = b'work from another source owner\n'
+    (root / 'release.txt').write_bytes(foreign)
+    head = git(root, 'rev-parse', 'HEAD')
+    index = (root / '.git/index').read_bytes()
+    boot = subprocess.run([str(launcher)], cwd=tmp_path, env=env, capture_output=True,
+                          text=True, timeout=30, check=False)
+    assert boot.returncode != 0 and 'APP_REACHED' not in boot.stdout
+    assert (root / 'release.txt').read_bytes() == foreign
+    assert git(root, 'rev-parse', 'HEAD') == head
+    assert (root / '.git/index').read_bytes() == index
+
+
+@pytest.mark.platforms('posix')
+def test_a_partial_added_file_is_kept_recoverably_outside_the_active_source(tmp_path, monkeypatch):
+    root, before, launcher, env, _original = interrupted_git_write(tmp_path, monkeypatch, 'addition')
+    source = root / 'added-source.py'
+    assert not source.exists()
+    partial = b'NEW_SOURCE_'
+    source.write_bytes(partial)
+    boot = subprocess.run([str(launcher)], cwd=tmp_path, env=env, capture_output=True,
+                          text=True, timeout=30, check=False)
+    assert boot.returncode == 0 and 'APP_REACHED' in boot.stdout, boot.stderr
+    assert git(root, 'rev-parse', 'HEAD') == before
+    assert not source.exists()
+    archived = list((root / '.git/hermes-preservation').glob('*/kept-added/added-source.py'))
+    assert len(archived) == 1 and archived[0].read_bytes() == partial
+    assert (root / 'local-helper.py').read_bytes() == b'LOCAL_VALUE = 7\n'
+
+
+@pytest.mark.platforms('posix')
+def test_retiring_the_next_capsule_keeps_ambiguous_partial_source(tmp_path, monkeypatch):
+    root, _before, launcher, env, _original = interrupted_git_write(tmp_path, monkeypatch, 'addition')
+    partial = b'NEW_SOURCE_'
+    (root / 'added-source.py').write_bytes(partial)
+    first = subprocess.run([str(launcher)], cwd=tmp_path, env=env, capture_output=True,
+                           text=True, timeout=30, check=False)
+    assert first.returncode == 0, first.stderr
+    archived = list((root / '.git/hermes-preservation').glob('*/kept-added/added-source.py'))
+    assert len(archived) == 1
+    script = tmp_path / 'next-preserving-prepare.py'
+    script.write_text("""
+import sys
+from pathlib import Path
+sys.path.insert(0, sys.argv[1])
+from hermes_cli.update_lock import UpdateLock
+from hermes_cli.update_cmd_preserve import capture_customization_metadata
+root = Path(sys.argv[2])
+assert root.resolve().parent == Path(__file__).resolve().parent
+lock = UpdateLock(install_root=root)
+assert lock.acquire()
+capture_customization_metadata(['git'], root)
+lock.release()
+""")
+    second = subprocess.run([sys.executable, '-I', str(script), str(SOURCE), str(root)],
+                            cwd=tmp_path, env=env, capture_output=True, text=True, timeout=30, check=False)
+    assert second.returncode == 0, second.stderr
