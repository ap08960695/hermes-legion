+"""Legacy and unified roster reads expose recorded usage from the same owned row."""
+import pytest
+
+from gateway.session_group_controls import _read_bot_sessions
+from hermes_state import SessionDB
+import tui_gateway.server as srv
+from tui_gateway.contracts.profiles_vault_complete_foreign_subagents import ProfileWorkerSession
+
+
+@pytest.mark.parametrize('status,amounts,expected', [
+    (None, (0, 0), (None, None)),
+    ('estimated', (0, 0), (0, None)),
+    ('actual', (0, 0), (None, 0)),
+    ('included', (.004, .003), (.004, .003)),
+    ('unknown', (1.25, .7), (1.25, .7)),
+])
+def test_existing_roster_read_keeps_recorded_usage_and_profile_identity(tmp_path, status, amounts, expected):
+    for profile, model, values in [('alpha', 'alpha-recorded-model', amounts),
+                                    ('beta', 'beta-recorded-model', (2.5, 1.1))]:
+        home = tmp_path / profile
+        home.mkdir()
+        with SessionDB(db_path=home / 'state.db') as db:
+            db.create_session(profile + '-worker', 'kanban', model=model,
+                              model_config={'max_iterations': 8, 'api_key': 'private-route-canary'})
+            db.set_session_title(profile + '-worker', profile + ' worker')
+            db.update_token_counts(profile + '-worker', input_tokens=123, output_tokens=4,
+                                   api_call_count=1, estimated_cost_usd=values[0], actual_cost_usd=values[1],
+                                   cost_status=status, absolute=True, source='kanban')
+            db.touch_session_activity(profile + '-worker', description='executing tool: read_file')
+        with SessionDB(db_path=home / 'state.db', read_only=True) as reader:
+            native = _read_bot_sessions(reader, 'uid:desk', True)
+            legacy_human, legacy_workers = srv._latest_profile_session_rows(reader)
+            worker = native['worker_session']
+            assert legacy_human is None
+            assert native['last_session'] is None and native['canonical_session'] is None
+            assert native['worker_sessions'] == legacy_workers == [worker]
+            assert worker['id'] == profile + '-worker' and worker['model'] == model
+            assert (worker['estimated_cost_usd'], worker['actual_cost_usd']) == (expected if profile == 'alpha' else values)
+            assert worker['input_tokens'] == 123 and worker['current_tool'] == 'read_file'
+            assert 'private-route-canary' not in str(worker)
+            assert 'model_config' not in worker and 'cost_status' not in worker
+            assert ProfileWorkerSession.model_validate(worker).model_dump()['model'] == model
+
+
+def test_optional_usage_contract_accepts_an_older_worker():
+    result = ProfileWorkerSession.model_validate({'id': 'older-worker'})
+    assert result.model is None and result.estimated_cost_usd is None and result.actual_cost_usd is None
