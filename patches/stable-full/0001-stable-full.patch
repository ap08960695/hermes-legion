+test('closing the session kills a TERM-resistant helper and its child', async () => {
+  const f = localSession()
+  const receipt = path.join(f.root, 'pids')
+
+  const code = [
+    'import os, signal, subprocess, sys, time',
+    'signal.signal(signal.SIGTERM, signal.SIG_IGN)',
+    'p = subprocess.Popen([sys.executable, "-I", "-S", "-c", "import signal,time; signal.signal(signal.SIGTERM, signal.SIG_IGN); time.sleep(30)"])',
+    `open(${JSON.stringify(receipt)}, 'w').write(str(os.getpid()) + ' ' + str(p.pid))`,
+    'time.sleep(30)'
+  ].join('; ')
+
+  const call = f.connection.exec(`exec python3 -I -S -c ${quote(code)}`).catch(error => error)
+
+  try {
+    await until(() => fs.existsSync(receipt), 'helper never started')
+    f.helpers.push(...fs.readFileSync(receipt, 'utf8').split(' ').map(Number))
+    assert.equal(f.helpers.length, 2)
+    assert.ok(f.helpers.every(running))
+    await f.connection.close()
+    await until(() => f.helpers.every(pid => !running(pid)), 'disconnected helper or child survived', 4000)
+    assert.equal((await call).kind, 'superseded')
+  } finally {
+    await f.cleanup()
+    await call
+  }
+})
