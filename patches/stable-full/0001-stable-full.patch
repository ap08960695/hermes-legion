@@ -0,0 +1,59 @@
+import { useState } from 'react'
+import { Button } from '@/components/ui/button'
+import { ZoomableImage } from '@/components/chat/zoomable-image'
+import { CodeEditor } from '@/components/chat/code-editor'
+import { useI18n } from '@/i18n'
+import { libraryHtmlDocument, type LibraryFile } from './open-artifact'
+
+export function ArtifactFileContent({ file, label }: { file: LibraryFile; label: string }) {
+  const { t } = useI18n(),
+    [source, setSource] = useState(false),
+    mime = file.mimeType || ''
+  if (file.dataUrl && mime.startsWith('image/'))
+    return <ZoomableImage alt={label} src={file.dataUrl} className="max-h-full max-w-full object-contain" />
+  if (file.dataUrl && mime === 'application/pdf')
+    return <iframe title={label} src={file.dataUrl} className="h-full w-full border-0" />
+  if (file.dataUrl && mime.startsWith('audio/'))
+    return <audio aria-label={label} controls preload="metadata" src={file.dataUrl} />
+  if (file.dataUrl && mime.startsWith('video/'))
+    return <video aria-label={label} controls preload="metadata" src={file.dataUrl} className="max-h-full max-w-full" />
+  if (file.binary)
+    return (
+      <div role="status" className="p-6">
+        <strong>{t.preview.binaryTitle}</strong>
+        <p>{t.preview.binaryBody(label)}</p>
+      </div>
+    )
+  const html = mime === 'text/html' || /\.html?$/i.test(file.path)
+  return (
+    <div className="flex h-full min-h-0 flex-col gap-2">
+      {file.truncated && (
+        <p role="status" className="text-xs text-muted-foreground">
+          {t.preview.truncated}
+        </p>
+      )}
+      {html && (
+        <div role="group" aria-label={t.preview.tab}>
+          <Button variant="ghost" size="sm" aria-pressed={!source} onClick={() => setSource(false)}>
+            {t.preview.renderedPreview}
+          </Button>
+          <Button variant="ghost" size="sm" aria-pressed={source} onClick={() => setSource(true)}>
+            {t.preview.source}
+          </Button>
+        </div>
+      )}
+      <div className="min-h-0 flex-1 overflow-auto">
+        {html && !source ? (
+          <iframe
+            title={label}
+            sandbox=""
+            srcDoc={libraryHtmlDocument(file.text)}
+            className="h-full w-full border-0 bg-white"
+          />
+        ) : (
+          <CodeEditor key={file.path} disabled filePath={file.path} initialValue={file.text} onChange={() => {}} />
+        )}
+      </div>
+    </div>
+  )
+}
