+
+
+def test_unicode_tool_argument_terms_obey_boolean_not_and_or(db):
+    calls = [
+        {
+            "type": "function",
+            "function": {
+                "name": "terminal",
+                "arguments": json.dumps({"input": "ข้อความภาษาไทย"}),
