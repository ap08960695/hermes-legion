@@ -0,0 +1,10 @@
+import { normalizeProfileKey } from '@/store/profile'
+import { setSessions } from '@/store/session'
+import type { SessionInfo } from '@/types/hermes'
+/** Search can return an older row outside the loaded page. Adopt its owner before pin mirroring. */
+export function pinLoadedRow(session: SessionInfo, toggle: () => void) {
+  return () => {
+    setSessions(rows => rows.some(row => row.id === session.id && normalizeProfileKey(row.profile) === normalizeProfileKey(session.profile)) ? rows : [...rows, session])
+    toggle()
+  }
+}
