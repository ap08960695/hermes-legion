+"""Canonical control admission distinguishes armed standby from stopped runtime."""
+import pytest
+
+from gateway import hosted_rooms
+from gateway.session_hosted_service import start_ready_hosted_services
+from tests.gateway.test_hosted_group_members import _gateway, _desktop, _members
+
+
+def test_ready_standby_creates_through_its_owner_and_wakes_one_coordinator(tmp_path, monkeypatch):
+    with _gateway(tmp_path, monkeypatch, served=('alpha',)) as (runner, homes, call):
+        service = runner.session_authority.hosted_room_service
+        before = service.runtime.status()
+        assert not before['running']
+        desktop = _desktop(runner, call)
+        assert desktop('default', 'groups.capabilities')['result']['driver'] is True
+        assert not service.runtime.status()['running']
+        created = desktop('default', 'groups.create', room_id='crew', name='Crew',
+                          members=_members('default', 'alpha'))
+        assert 'result' in created, created
+        assert service.runtime.status()['running'], 'native create must wake its armed standby owner'
+        assert service.runtime.status()['armed'] is True
+        coordinator = service.runtime._thread
+        # Metadata reads and additional wakes keep the same native coordinator.
+        service.wakeup()
+        assert 'result' in desktop('default', 'groups.state', room_id='crew')
+        assert service.runtime._thread is coordinator
+
+
+def test_stopped_group_refuses_a_send_without_appending_or_reviving(tmp_path, monkeypatch):
+    with _gateway(tmp_path, monkeypatch, served=('alpha',)) as (runner, homes, call):
+        service = runner.session_authority.hosted_room_service
+        desktop = _desktop(runner, call)
+        created = desktop('default', 'groups.create', room_id='crew', name='Crew',
+                          members=_members('default', 'alpha'))
+        assert 'result' in created
+        assert service.stop(timeout=5)
+        events = hosted_rooms.read_events(service.db_path, room_id='crew')['events']
+        reply = desktop('default', 'groups.send', room_id='crew', event_id='refused',
+                        payload={'text': '@alpha fixture', 'thread_id': 'thread'})
+        assert reply['error']['message'] == 'runtime_coordination_required', reply
+        assert hosted_rooms.read_events(service.db_path, room_id='crew')['events'] == events
+        # A late readiness callback and ordinary wake must not undo explicit Stop.
+        start_ready_hosted_services(runner)
+        service.wakeup()
+        assert not service.runtime.status()['running']
+        assert service.runtime.status()['stopping']
+
+
+@pytest.mark.asyncio
+async def test_pre_ready_group_refuses_execution_until_native_ready_gate(tmp_path, monkeypatch):
+    from gateway.control_socket import GatewayControlServer
+    from gateway.run_runtime import initialize_gateway_runtime
+    from gateway.session_controls import AuthorityConnection
+    from gateway.session_hosted_service import ensure_hosted_service
+    from tests.gateway.test_profile_runtime_io import _world
+
+    with _world(tmp_path, monkeypatch) as (runner, root, target):
+        runner.config._runtime_profile_homes = (('default', root), ('alpha', target))
+        await initialize_gateway_runtime(runner)
+        runner.session_control_server = GatewayControlServer(root, verb_handlers={})
+        await ensure_hosted_service(runner)
+        service = runner.session_authority.hosted_room_service
+        connection = AuthorityConnection(runner.session_authority, object(),
+                                         {'user_id': 'desktop', 'profile_scope': 'host'})
+        try:
+            created = await connection.dispatch({'id': 1, 'method': 'groups.create',
+                'params': {'room_id': 'crew', 'name': 'Crew', 'members': _members('default', 'alpha')}})
+            assert 'result' in created, created
+            refused = await connection.dispatch({'id': 2, 'method': 'groups.send',
+                'params': {'room_id': 'crew', 'event_id': 'too-early',
+                           'payload': {'text': 'fixture', 'thread_id': 'thread'}}})
+            assert refused['error']['message'] == 'runtime_coordination_required', refused
+            assert not service.runtime.status()['running']
+            runner.session_runtime_descriptor['state'] = 'ready'
+            await ensure_hosted_service(runner)
+            assert service.runtime.status()['running']
+        finally:
+            assert service.stop(timeout=5)
