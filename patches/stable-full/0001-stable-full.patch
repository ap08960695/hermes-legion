diff --git a/apps/desktop/src/sdk/kanban-navigation.ts b/apps/desktop/src/sdk/kanban-navigation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4e7b9e7d5a4c585e62d3e282169320a9010793d5
--- /dev/null
+++ b/apps/desktop/src/sdk/kanban-navigation.ts
@@ -0,0 +1,72 @@
+import { LOCAL_CONNECTION_ID } from '@hermes/shared'
+import { atom, computed, type ReadableAtom } from 'nanostores'
+
+import { $apiRequestScope, getApiRequestConnection } from '@/api/client'
+import { $routesVersion, contributedRoutes, ROUTES_AREA } from '@/app/routes'
+import { registry } from '@/contrib/registry'
+import { $gateway, activeGatewayConnectionId } from '@/store/gateway'
+import { $activeGatewayProfile } from '@/store/profile'
+import { $gatewayState } from '@/store/session'
+
+interface KanbanCardTarget {
+  board: string
+  taskId: string
+}
+
+const kanbanAvailable = () => contributedRoutes().some(route => route.path === '/kanban')
+export const $kanbanAvailable: ReadableAtom<boolean> = computed($routesVersion, kanbanAvailable)
+
+const pending = atom<KanbanCardTarget | null>(null)
+export const $kanbanCardRequest: ReadableAtom<KanbanCardTarget | null> = pending
+const retireOnChange: Array<() => void> = []
+
+function clearRequest(): void {
+  for (const stop of retireOnChange.splice(0)) {
+    stop()
+  }
+
+  pending.set(null)
+}
+
+function isLocal(): boolean {
+  return $gatewayState.get() === 'open' && activeGatewayConnectionId() === LOCAL_CONNECTION_ID &&
+    getApiRequestConnection() === LOCAL_CONNECTION_ID
+}
+
+export function isKanbanCardTarget(board: string, taskId: string): boolean {
+  return /^[a-z0-9][a-z0-9_-]{0,63}$/.test(board) && /^t_[a-f0-9]{8,64}$/.test(taskId)
+}
+
+/** A deferred link belongs to the live Local scope that created it. */
+export function queueKanbanCard(board: string, taskId: string): boolean {
+  if (!isLocal() || !kanbanAvailable() || !isKanbanCardTarget(board, taskId)) {
+    return false
+  }
+
+  clearRequest()
+  const onHashChange = () => {
+    if (window.location.hash !== '#/kanban') {
+      clearRequest()
+    }
+  }
+
+  window.addEventListener('hashchange', onHashChange)
+  retireOnChange.push(
+    () => window.removeEventListener('hashchange', onHashChange),
+    $apiRequestScope.listen(clearRequest),
+    $activeGatewayProfile.listen(clearRequest),
+    $gateway.listen(clearRequest),
+    $gatewayState.listen(clearRequest),
+    registry.subscribeArea(ROUTES_AREA, clearRequest)
+  )
+  pending.set({ board, taskId })
+
+  return true
+}
+
+export function takeKanbanCardRequest(): KanbanCardTarget | null {
+  const request = pending.get()
+  clearRequest()
+
+  return request && isLocal() && window.location.hash === '#/kanban' ? request : null
+}
