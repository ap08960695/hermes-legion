diff --git a/apps/desktop/src/plugins/hermes-bots/create-intro.tsx b/apps/desktop/src/plugins/hermes-bots/create-intro.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..377115fe0174ab7060bc7291d0727c63d15d403f
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/create-intro.tsx
@@ -0,0 +1,114 @@
+import { Button, DialogFooter, host, useI18n } from '@hermes/plugin-sdk'
+import { useBots } from './i18n'
+import type { RosterRow } from './types'
+import { displayName } from './labels'
+
+export function CreateBotIntro({
+  remote,
+  checked,
+  busy,
+  onChange
+}: {
+  remote: boolean
+  checked: boolean
+  busy: boolean
+  onChange: (value: boolean) => void
+}) {
+  const b = useBots()
+  if (remote) return null
+  return (
+    <label className="flex items-start gap-2 px-1 text-xs">
+      <input type="checkbox" checked={checked} disabled={busy} onChange={event => onChange(event.target.checked)} />
+      <span>
+        <span className="block">{b.editor.startIntro}</span>
+        <span className="mt-1 block text-muted-foreground">{b.editor.introHint}</span>
+      </span>
+    </label>
+  )
+}
+interface Readiness {
+  error?: string
+  ok?: boolean
+}
+export function checkIntroReadiness(intro: boolean, remote: boolean, read: () => Promise<Readiness>) {
+  return intro || remote ? read().catch(() => null) : Promise.resolve(null)
+}
+export function notifyBotCreated({
+  name,
+  description,
+  botTitle,
+  targetConnection,
+  targetLabel,
+  needsModel,
+  readiness,
+  remote,
+  onConfigureModel,
+  text
+}: {
+  name: string
+  description: string
+  botTitle: string
+  targetConnection: string
+  targetLabel: string
+  needsModel: boolean
+  readiness: Readiness | null
+  remote: boolean
+  onConfigureModel?: (bot: RosterRow) => void
+  text: ReturnType<typeof useBots>['editor']
+}) {
+  const bot: RosterRow = {
+    name,
+    description,
+    title: botTitle,
+    ...(remote ? { connectionId: targetConnection, remoteSource: true } : {})
+  }
+  const who = displayName(bot)
+  const title = remote ? text.createdOn(who, targetLabel) : text.created(who)
+  host.notify(
+    needsModel
+      ? {
+          kind: 'warning',
+          title,
+          message: text.needsModel,
+          detail: readiness?.error,
+          ...(!remote && onConfigureModel
+            ? { action: { label: text.configureModel, onClick: () => onConfigureModel(bot) } }
+            : {})
+        }
+      : { kind: 'success', message: title }
+  )
+}
+
+export function CreateBotActions({
+  remote,
+  checked,
+  busy,
+  onChange,
+  disabled,
+  onCreate,
+  onCancel
+}: {
+  remote: boolean
+  checked: boolean
+  busy: boolean
+  onChange: (value: boolean) => void
+  disabled: boolean
+  onCreate: () => void
+  onCancel: () => void
+}) {
+  const b = useBots(),
+    { t } = useI18n()
+  return (
+    <>
+      <CreateBotIntro remote={remote} checked={checked} busy={busy} onChange={onChange} />
+      <DialogFooter>
+        <Button disabled={busy} onClick={onCancel} variant="ghost">
+          {t.common.cancel}
+        </Button>
+        <Button disabled={busy || disabled} onClick={onCreate}>
+          {busy ? b.editor.creating : b.editor.createBot}
+        </Button>
+      </DialogFooter>
+    </>
+  )
+}
