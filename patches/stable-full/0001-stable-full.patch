diff --git a/hermes_cli/gateway_launch_admission.py b/hermes_cli/gateway_launch_admission.py
new file mode 100644
index 0000000000000000000000000000000000000000..01be3c8aa351059f8c5ad7b5f52249d724e188bb
--- /dev/null
+++ b/hermes_cli/gateway_launch_admission.py
@@ -0,0 +1,73 @@
+"""Serialize direct POSIX ensure launches until the daemon reserves its runtime home."""
+
+from contextlib import contextmanager
+import os
+from pathlib import Path
+import stat
+
+LAUNCH_FD_ENV = "HERMES_GATEWAY_LAUNCH_LOCK_FD"
+_LOCK_NAME = "gateway.launch.lock"
+_inherited_lock: int | None = None
+
+
+def _is_launch_lock(fd: int, path: Path) -> bool:
+    info = os.fstat(fd)
+    return (
+        fd >= 3
+        and stat.S_ISREG(info.st_mode)
+        and not info.st_mode & 0o077
+        and info.st_uid == os.getuid()  # windows-footgun: ok — POSIX callers
+        and info.st_nlink == 1
+        and os.path.samestat(info, path.lstat())
+    )
+
+
+@contextmanager
+def gateway_launch_admission(home: Path):
+    """Yield the child descriptors, or None when another ensure is already launching."""
+    if os.name != "posix":
+        yield ()
+        return
+    import fcntl
+
+    home.mkdir(mode=0o700, parents=True, exist_ok=True)
+    path = home / _LOCK_NAME
+    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
+    try:
+        if not _is_launch_lock(fd, path):
+            raise PermissionError("unsafe gateway launch lock")
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            yield None
+        else:
+            if not _is_launch_lock(fd, path):
+                raise PermissionError("gateway launch lock changed")
+            yield (fd,)
+    finally:
+        # LOCK_UN would also unlock the detached child's copy of this file description.
+        os.close(fd)
+
+
+def adopt_gateway_launch() -> None:
+    """Mark a validated inherited launch lock close-on-exec before loading the gateway."""
+    global _inherited_lock
+    value = os.environ.pop(LAUNCH_FD_ENV, None)
+    if value is None or os.name != "posix":
+        return
+    try:
+        fd = int(value)
+        home = Path(os.environ["HERMES_HOME"])
+        if home.is_absolute() and _is_launch_lock(fd, home / _LOCK_NAME):
+            os.set_inheritable(fd, False)
+            _inherited_lock = fd
+            os.register_at_fork(after_in_child=release_gateway_launch)
+    except (KeyError, OSError, ValueError, OverflowError):
+        return
+
+
+def release_gateway_launch() -> None:
+    global _inherited_lock
+    if _inherited_lock is not None:
+        os.close(_inherited_lock)
+        _inherited_lock = None
