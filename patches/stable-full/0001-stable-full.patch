+it('does not submit an abandoned list draft on unrelated unmount', () => {
+  const onChange = vi.fn()
+
+  const { unmount } = render(
+    <ConfigField onChange={onChange} schema={{ type: 'list' }} schemaKey="custom.setting" value={['one']} />
+  )
+
+  const input = screen.getByRole('textbox')
+  input.focus()
+  fireEvent.change(input, { target: { value: 'one, draft' } })
+  unmount()
+
+  expect(onChange).not.toHaveBeenCalled()
+})
+
+it.each([{ isComposing: true }, { keyCode: 229 }])('does not commit list composition on Escape (%s)', composition => {
+  const onChange = vi.fn()
+  render(<ConfigField onChange={onChange} schema={{ type: 'list' }} schemaKey="custom.setting" value={['one']} />)
+  const input = screen.getByRole('textbox')
+  input.focus()
+  fireEvent.change(input, { target: { value: 'one, unfinished' } })
+  fireEvent.keyDown(input, { key: 'Escape', ...composition })
+
+  expect(input.ownerDocument.activeElement).toBe(input)
+  expect(onChange).not.toHaveBeenCalled()
+})
