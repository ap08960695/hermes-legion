@@ -0,0 +1,103 @@
+"""Bounded auxiliary vision reuse, isolated by caller and route; no provider calls here."""
+import asyncio
+from collections import OrderedDict
+from concurrent.futures import Future
+import hashlib
+import json
+import logging
+import os
+import threading
+import time
+
+
+logger = logging.getLogger(__name__)
+
+
+class VisionCache:
+    def __init__(self, capacity=128, ttl=900, max_result_bytes=262144):
+        self.capacity, self.ttl, self.max_result_bytes = capacity, ttl, max_result_bytes
+        self.lock = threading.Lock()
+        self.pending = {}
+        self.done = OrderedDict()
+
+    def cacheable(self, result):
+        if not isinstance(result, str) or len(result.encode()) > self.max_result_bytes:
+            return False
+        try:
+            value = json.loads(result)
+            return (isinstance(value, dict) and value.get('success') is True
+                    and isinstance(value.get('analysis'), str) and bool(value['analysis'].strip()))
+        except ValueError:
+            return False
+
+    async def run(self, key, call):
+        if key is None:
+            return await call()
+        with self.lock:
+            now = time.monotonic()
+            for old in list(self.done):
+                if now - self.done[old][0] >= self.ttl:
+                    del self.done[old]
+            cached = self.done.get(key)
+            if cached:
+                self.done.move_to_end(key)
+                logger.info("vision_reuse outcome=cache_hit")
+                return cached[1]
+            future = self.pending.get(key)
+            owner = future is None
+            if owner and len(self.pending) < self.capacity:
+                future = self.pending[key] = Future()
+        if future is None:  # Distinct requests beyond the bound retain normal behavior.
+            return await call()
+        if not owner:
+            logger.info("vision_reuse outcome=joined_inflight")
+            return await asyncio.shield(asyncio.wrap_future(future))
+        try:
+            result = await call()
+            with self.lock:
+                if self.cacheable(result):
+                    self.done[key] = (time.monotonic(), result)
+                    while len(self.done) > self.capacity:
+                        self.done.popitem(last=False)
+            logger.info("vision_reuse outcome=owner_completed cacheable=%s", self.cacheable(result))
+            future.set_result(result)
+            return result
+        except BaseException as exc:
+            future.set_exception(exc)
+            raise
+        finally:
+            with self.lock:
+                self.pending.pop(key, None)
+
+
+def request_key(image_url, question, region, task_id, *, session_id=None):
+    """No unbound scope, remote files, credential resolution, prompt logging or disk cache."""
+    from agent.auxiliary_client import _runtime_main_value, _read_main_model, _read_main_provider
+    from gateway.session_context import get_session_env
+    from hermes_constants import get_hermes_home
+    from hermes_cli.config import load_config_readonly
+    from tools.image_source import _is_local_terminal_backend
+
+    session = session_id or _runtime_main_value('session_id') or get_session_env('HERMES_SESSION_ID', '')
+    if not task_id or not session or not _is_local_terminal_backend() or not isinstance(image_url, str):
+        return None
+    path = image_url[7:] if image_url.startswith('file://') else image_url
+    if not path or '://' in path:
+        return None
+    try:
+        path = os.path.realpath(os.path.expanduser(path))
+        stat = os.stat(path)
+        config = load_config_readonly()
+        route = {field: _runtime_main_value(field) for field in
+                 ('provider', 'model', 'base_url', 'api_mode', 'auth_mode')}
+        route.update(main_model=_read_main_model(), main_provider=_read_main_provider(),
+                     auxiliary=config.get('auxiliary', {}), legacy_model=os.getenv('AUXILIARY_VISION_MODEL', ''))
+        identity = [str(get_hermes_home()), str(session), str(task_id), route, path,
+                    stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns, stat.st_ctime_ns,
+                    question, region]
+        return hashlib.sha256(json.dumps(identity, sort_keys=True, ensure_ascii=False).encode()).digest()
+    except (OSError, ValueError, TypeError):
+        return None
+
+
+CACHE = VisionCache()
