+        # span it. Escaped quotes split too; that widens, not narrows, matches.
+        for index, part in enumerate(dict.fromkeys(raw.split('"'))):
+            if index % 64 == 0 and deadline is not None and time.monotonic() >= deadline:
+                raise TimeoutError('structured global search timed out')
+            if not part:
