+import { EventEmitter } from 'node:events'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+import type * as ProbeAPI from './backend-probes'
+import { readDesktopLaunchConfig } from './renderer-heap-flags'
+
+const spawn = vi.hoisted(() => vi.fn())
+vi.mock('node:child_process', () => ({ spawn }))
+
+class Child extends EventEmitter {
+  killed = false
+  closed = false
+  kill = vi.fn((_signal?: string) => { this.killed = true;
+
+ return true })
+  close(code = 0, signal: string | null = null): void {
+    if (this.closed) { return }
+    this.closed = true
+    this.emit('close', code, signal)
+  }
+}
+
+let api: typeof ProbeAPI
+let children: Child[]
+const floor = 536_870_912
+const tick = () => vi.advanceTimersByTimeAsync(0)
+
+function probe(command = '/python', timeout = 1000): Promise<void> {
+  const result = api.execProbe(command, ['--version'], { stdio: 'ignore', timeout })
+  void result.catch(() => {})
+
+  return result
+}
