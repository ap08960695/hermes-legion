+"""Lazy local adapters must admit genuine result wakes through their own native authority."""
+from dataclasses import replace
+from types import MethodType
+
+import pytest
+import pytest_asyncio
+
+from gateway.config import Platform
+from gateway.run import GatewayRunner
+from gateway.wake import WakeNotAccepted, deliver_wake
+from hermes_state_runtime import list_session_admissions
+from tests.gateway import test_session_viewer_automation as session_automation
+
+owner = session_automation.owner
+
+
+@pytest_asyncio.fixture
+async def attached(owner, monkeypatch):
+    from gateway import run
+    monkeypatch.setattr(run, '_load_gateway_config', lambda *args: {'platform_toolsets': {'cli': []}})
+    runner = owner.authority.runner
+    runner.config = runner.session_store.config
+    runner.config.multiplex_profiles = True
+    runner._session_key_for_source = MethodType(GatewayRunner._session_key_for_source, runner)
+    monkeypatch.setattr(owner.authority, '_schedule', lambda ref: None)  # hold only real model execution
+    reply = await owner.viewer.dispatch({'id': 1, 'method': 'session.resume',
+                                         'params': {'session_id': owner.ref.session_id}})
+    assert 'result' in reply
+    return owner
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('human_queued', [False, True])
+async def test_local_result_wake_uses_native_fifo_without_a_second_handler(attached, human_queued):
+    owner = attached
+    live = owner.authority.sessions[owner.ref.session_id]
+    adapter = owner.authority.runner.adapters[Platform.LOCAL]
+    if human_queued:
+        reply = await owner.viewer.dispatch({'id': 2, 'method': 'prompt.submit', 'params': {
+            'session_id': owner.ref.session_id, 'submission_id': 'synthetic-human', 'text': 'Original queued human input'}})
+        assert 'result' in reply
+    before = list_session_admissions(owner.authority.db, session_id=owner.ref.session_id)
+    await deliver_wake(adapter, text='Original followed task completed', source=live.source)
+    after = list_session_admissions(owner.authority.db, session_id=owner.ref.session_id)
+    assert len(after) == len(before) + 1
+    assert after[:len(before)] == before
+    assert after[-1]['status'] == 'queued'
+    assert 'local_automation_v1' in after[-1]['payload']
+    assert after[-1]['payload']['text'] == 'Original followed task completed'
+    assert adapter.gateway_runner is owner.authority.runner
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('field,value', [('chat_id', 'unowned-room'), ('profile', 'unowned-profile')])
+async def test_local_wake_cannot_borrow_a_foreign_route(attached, field, value):
+    owner = attached
+    live = owner.authority.sessions[owner.ref.session_id]
+    adapter = owner.authority.runner.adapters[Platform.LOCAL]
+    before = list_session_admissions(owner.authority.db, session_id=owner.ref.session_id)
+    with pytest.raises(WakeNotAccepted):
+        await deliver_wake(adapter, text='Unowned result must not enter', source=replace(live.source, **{field: value}))
+    assert list_session_admissions(owner.authority.db, session_id=owner.ref.session_id) == before
