+    if not isinstance(api_key, str):
+        return  # A callable credential must not be minted merely for a cache write.
+    if length <= 0:
+        metadata.logger.warning("Refusing to cache non-positive context length for %s", model)
+        return
+    _save_document(model, base_url, length, source=source, api_key=api_key)
+
+
+@locked_context_cache
+def _save_document(model, base_url, length, *, source, api_key):
+    from agent import model_metadata as metadata
+    try:
+        key = metadata._context_cache_key(model, base_url, api_key)
+        document = metadata._load_context_cache_document()
+        cache = document.get("context_lengths") or {}
+        confirmed = document.get("bedrock_confirmed_v1") or {}
+        confirmed = confirmed if isinstance(confirmed, dict) else {}
+        old_confirmed = confirmed.copy()
+        for alias in _aliases(metadata, model, base_url, api_key):
+            confirmed.pop(alias, None)
+        if source == "bedrock-confirmed-v1":
+            confirmed[key] = length
+        if cache.get(key) == length and confirmed == old_confirmed:
+            return
+        cache.pop(key, None)
+        cache[key] = length
+        scoped = [key for key in cache if key.startswith("credential-v1:")]
+        for stale in scoped[:-_MAX_SCOPED_WINDOWS]:
+            cache.pop(stale)
+            confirmed.pop(stale, None)
+        metadata._write_context_cache(cache, confirmed)
+        metadata.logger.info("Cached context length %s -> %s tokens", key, f"{length:,}")
+    except Exception as exc:  # health: allow BLE001 -- Keep the existing optional cache write fail-open.
+        metadata.logger.debug("Failed to save context length cache: %s", exc)
+
+
+def invalidate_window(model, base_url, *, api_key=""):
+    from agent import model_metadata as metadata
+    from hermes_constants import hermes_home_key
+    if not isinstance(api_key, str):
+        return
+    bare, stripped = metadata._strip_provider_prefix(model), (base_url or "").rstrip("/")
+    scope = metadata._endpoint_memo_key(stripped, api_key)
+    for name in ("context", "ollama_show"):
+        metadata._LOCAL_CTX_PROBE_CACHE.pop((name, bare, *scope), None)
+    for memo_key in list(metadata._BEDROCK_PROBE_FAILURE_CACHE):
+        if memo_key[:2] == (hermes_home_key(), stripped) and memo_key[2] in (model, bare):
+            metadata._BEDROCK_PROBE_FAILURE_CACHE.pop(memo_key, None)
+    _invalidate_document(model, base_url, api_key=api_key)
+
+
+@locked_context_cache
+def _invalidate_document(model, base_url, *, api_key):
+    from agent import model_metadata as metadata
+    try:
+        document = metadata._load_context_cache_document()
+        cache = document.get("context_lengths") or {}
+        confirmed = document.get("bedrock_confirmed_v1") or {}
+        confirmed = confirmed if isinstance(confirmed, dict) else {}
+        aliases = _aliases(metadata, model, base_url, api_key)
+        if not any(key in cache or key in confirmed for key in aliases):
+            return
+        for key in aliases:
+            cache.pop(key, None)
+            confirmed.pop(key, None)
+        metadata._write_context_cache(cache, confirmed)
+    except Exception as exc:  # health: allow BLE001 -- Keep native optional invalidation fail-open.
+        metadata.logger.debug("Failed to invalidate context length cache: %s", exc)
