+def test_udf_timeout_is_loud_and_connection_remains_usable(db, monkeypatch):
+    from hermes_state_global_recall import GlobalSearch as Search
+    add(db, 's', 'needle')
+    original = Search.info
+    def fail_once(self, mid):
+        monkeypatch.setattr(Search, 'info', original)
+        raise TimeoutError('structured session search timed out')
+    monkeypatch.setattr(Search, 'info', fail_once)
+    with pytest.raises(TimeoutError, match='timed out'):
