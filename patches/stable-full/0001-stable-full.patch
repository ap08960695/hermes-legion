+    localStorage.setItem('hermes.desktop.layoutTree.v2', 'original-workspace')
+    localStorage.setItem('hermes.desktop.statusbarVisible', 'true')
+    const { initializeFocusPresentation } = await import('./rollout')
+    const { $interfaceMode, setInterfaceMode } = await import('@/store/interface-mode')
