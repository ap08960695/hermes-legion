@@ -0,0 +1,62 @@
+"""Owner-set effort ceilings bound overrides without changing another model or prompt."""
+from copy import deepcopy
+
+import pytest
+
+from hermes_constants import resolve_reasoning_config
+
+
+def config(*, requested='max', limit='high'):
+    return {'model': {'default': 'gpt-6.1-terra'}, 'agent': {
+        'reasoning_effort': requested,
+        'reasoning_overrides': {'gpt-6.1-terra': requested},
+        'reasoning_effort_limits': {'gpt-6.1-terra': limit},
+    }}
+
+
+@pytest.mark.parametrize('model', ['gpt-6.1-terra', 'openai/gpt-6.1-terra', 'relay/openai/gpt-6.1-terra'])
+def test_profile_ceiling_bounds_an_explicit_model_override_without_mutation(model):
+    cfg = config()
+    original = deepcopy(cfg)
+    assert resolve_reasoning_config(cfg, model) == {'enabled': True, 'effort': 'high'}
+    assert cfg == original
+
+
+@pytest.mark.parametrize('requested,expected', [('low', 'low'), ('medium', 'medium'),
+                                             ('high', 'high'), ('xhigh', 'high'), ('max', 'high')])
+def test_a_ceiling_never_raises_lower_effort(requested, expected):
+    assert resolve_reasoning_config(config(requested=requested)) == {'enabled': True, 'effort': expected}
+
+
+def test_disabled_reasoning_and_another_model_keep_their_existing_choices():
+    assert resolve_reasoning_config(config(requested=False)) == {'enabled': False}
+    assert resolve_reasoning_config(config(), 'gpt-6.1-sol') == {'enabled': True, 'effort': 'max'}
+
+
+@pytest.mark.parametrize('limit', ['unknown', 17, {}, None])
+def test_matching_invalid_ceiling_is_not_silently_ignored(limit):
+    with pytest.raises(ValueError, match='effort limit'):
+        resolve_reasoning_config(config(limit=limit))
+
+
+def test_no_limit_preserves_explicit_max():
+    cfg = config()
+    cfg['agent'].pop('reasoning_effort_limits')
+    assert resolve_reasoning_config(cfg) == {'enabled': True, 'effort': 'max'}
+
+
+def test_session_pin_cannot_remove_the_profile_ceiling():
+    from gateway.session_policy import pin_reasoning_effort
+    cfg = config(requested='low')
+    pin_reasoning_effort(cfg, 'max', session=True)
+    assert resolve_reasoning_config(cfg) == {'enabled': True, 'effort': 'high'}
+    assert cfg['agent']['reasoning_effort'] == 'max'
+
+
+def test_bot_editor_reports_effective_effort_and_the_configured_limit():
+    from hermes_cli.bot_settings import _model_snapshot
+    snapshot = _model_snapshot(config())
+    assert snapshot['effort'] == 'high'
+    assert snapshot['effort_limit'] == 'high'
+    assert snapshot['requested_effort'] == 'max'
+    assert 'max' in snapshot['supported_efforts']
diff --git a/tests/agent/test_shared_cache_routing.py b/tests/agent/test_shared_cache_routing.py
