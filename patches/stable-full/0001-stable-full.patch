@@ -0,0 +1,98 @@
+"""Creators can check a local atlas without installing it or changing a profile."""
+import argparse
+
+import pytest
+from PIL import Image, ImageDraw
+
+from hermes_cli.subcommands.pets import build_pets_parser
+
+
+def validate(path):
+    parser = argparse.ArgumentParser()
+    build_pets_parser(parser.add_subparsers())
+    args = parser.parse_args(["pets", "validate", str(path)])
+    return args.func(args)
+
+
+@pytest.fixture
+def sheet(tmp_path):
+    path = tmp_path / "my-character.png"
+    image = Image.new("RGBA", (1536, 1872))
+    draw = ImageDraw.Draw(image)
+    for row in range(9):
+        draw.rectangle((40, row * 208 + 30, 150, row * 208 + 180), fill="teal")
+    image.save(path)
+    return path
+
+
+@pytest.mark.parametrize("format", ["PNG", "WEBP"])
+def test_local_atlas_validates_without_changing_files(sheet, tmp_path, capsys, format):
+    if format == "WEBP":
+        with Image.open(sheet) as image:
+            image.save(sheet, format="WEBP", lossless=True)
+    before = {p.relative_to(tmp_path): p.read_bytes() for p in tmp_path.rglob("*") if p.is_file()}
+    assert validate(sheet) == 0
+    output = capsys.readouterr()
+    assert "1536x1872" in output.out
+    assert "idle" in output.out and "review" in output.out
+    assert not output.err
+    assert before == {p.relative_to(tmp_path): p.read_bytes() for p in tmp_path.rglob("*") if p.is_file()}
+
+
+def test_missing_states_are_visible_warnings(tmp_path, capsys):
+    path = tmp_path / "partial.png"
+    image = Image.new("RGBA", (1536, 1872))
+    ImageDraw.Draw(image).rectangle((40, 30, 150, 180), fill="teal")
+    image.save(path)
+    assert validate(path) == 0
+    assert "state 'review' has no frames" in capsys.readouterr().out
+
+
+@pytest.mark.parametrize("residue", [False, True])
+def test_invalid_atlas_reports_shared_validation_errors(sheet, capsys, residue):
+    image = Image.new("RGBA", (1536, 1872))
+    if residue:
+        with Image.open(sheet) as valid:
+            image = valid.copy()
+        image.putpixel((0, 0), (255, 0, 0, 0))
+    image.save(sheet)
+    assert validate(sheet) == 1
+    expected = "transparent pixels retain RGB residue" if residue else "atlas is empty"
+    assert expected in capsys.readouterr().err
+
+
+def test_wrong_geometry_is_rejected_before_pixel_decode(tmp_path, monkeypatch, capsys):
+    path = tmp_path / "wrong.png"
+    Image.new("RGBA", (10, 10)).save(path)
+    def unexpected_load(self):
+        pytest.fail("wrong geometry must not decode pixels")
+    monkeypatch.setattr(Image.Image, "load", unexpected_load)
+    assert validate(path) == 1
+    assert "expected 1536x1872, got 10x10" in capsys.readouterr().err
+
+
+@pytest.mark.parametrize("format", ["PNG", "WEBP"])
+def test_animated_images_are_not_treated_as_static_atlases(sheet, capsys, format):
+    with Image.open(sheet) as image:
+        first = image.copy()
+    second = first.copy()
+    second.putpixel((50, 50), (255, 0, 0, 255))
+    first.save(sheet, format=format, save_all=True, append_images=[second], lossless=True)
+    assert validate(sheet) == 1
+    assert "expected a static sprite atlas" in capsys.readouterr().err
+
+
+@pytest.mark.parametrize("kind", ["missing", "corrupt", "oversize", "directory", "gif"])
+def test_unreadable_or_unsupported_input_fails_cleanly(tmp_path, capsys, kind):
+    path = tmp_path / "input"
+    if kind == "corrupt":
+        path.write_bytes(b"broken image")
+    elif kind == "oversize":
+        with path.open("wb") as stream:
+            stream.truncate(16 * 1024 * 1024 + 1)
+    elif kind == "directory":
+        path.mkdir()
+    elif kind == "gif":
+        Image.new("RGB", (10, 10)).save(path, format="GIF")
+    assert validate(path) == 1
+    assert "cannot validate atlas" in capsys.readouterr().err
