@@ -0,0 +1,51 @@
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+const io = vi.hoisted(() => ({ select: vi.fn() }))
+vi.mock('@/store/profile', async original => ({ ...(await original<object>()), selectProfile: io.select }))
+import { $activeGatewayProfile, $profiles } from '@/store/profile'
+import { InlineProfileSelector } from './profile-selector'
+afterEach(() => {
+  cleanup()
+  $activeGatewayProfile.set('default')
+  $profiles.set([])
+  vi.clearAllMocks()
+})
+it('shows the full active display name without opening and preserves raw identity', () => {
+  $activeGatewayProfile.set('research')
+  $profiles.set([{ name: 'research', display_name: 'Research team', is_default: false }] as never)
+  render(<InlineProfileSelector onManage={vi.fn()} />)
+  expect(screen.getByRole('button', { name: 'Profile for new chats: Research team' })).toBeTruthy()
+  expect(screen.getByText('Research team')).toBeTruthy()
+  expect(io.select).not.toHaveBeenCalled()
+  act(() => $profiles.set([{ name: 'research', display_name: 'Renamed team', is_default: false }] as never))
+  expect(screen.getByText('Renamed team')).toBeTruthy()
+  expect(io.select).not.toHaveBeenCalled()
+})
+it('opening the menu has no action and choosing another profile uses its canonical name once', async () => {
+  $profiles.set([
+    { name: 'default', display_name: 'Home', is_default: true },
+    { name: 'research', display_name: 'Research team', is_default: false }
+  ] as never)
+  render(<InlineProfileSelector onManage={vi.fn()} />)
+  fireEvent.pointerDown(screen.getByRole('button', { name: 'Profile for new chats: Home' }), {
+    button: 0,
+    ctrlKey: false
+  })
+  const target = await screen.findByRole('menuitemradio', { name: 'Research team' })
+  expect(io.select).not.toHaveBeenCalled()
+  fireEvent.click(target)
+  expect(io.select).toHaveBeenCalledExactlyOnceWith('research')
+})
+
+it('reselecting the current profile does not reset its chat and a pending device switch disables selection', async () => {
+  $profiles.set([{ name: 'default', display_name: 'Home', is_default: true }] as never)
+  const view = render(<InlineProfileSelector onManage={vi.fn()} />)
+  fireEvent.pointerDown(screen.getByRole('button', { name: 'Profile for new chats: Home' }), {
+    button: 0,
+    pointerType: 'mouse'
+  })
+  fireEvent.click(await screen.findByRole('menuitemradio', { name: 'Home' }))
+  expect(io.select).not.toHaveBeenCalled()
+  view.rerender(<InlineProfileSelector busy onManage={vi.fn()} />)
+  expect((screen.getByRole('button', { name: 'Profile for new chats: Home' }) as HTMLButtonElement).disabled).toBe(true)
+})
