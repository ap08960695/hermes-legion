+import time
+
+_STOP = re.compile(rb'["\\\x00-\x1f]')
+_NUMBER = re.compile(rb"-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\Z")
+_HEX = frozenset(b"0123456789abcdefABCDEF")
+_ASCII_LOWER = str.maketrans("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")
+_RAW_ONLY = re.compile(r"[\x00\ud800-\udfff]")
+
+
+class InvalidJSON(ValueError):
+    pass
+
+
+class UnsupportedJSON(ValueError):
+    pass
+
+
+class Cursor:
+    def __init__(self, blob, start=0, deadline=None, chunk_size=65536):
+        self.blob, self.deadline, self.chunk_size = blob, deadline, chunk_size
+        self.buf, self.pos, self.base = b"", 0, start
+        blob.seek(start)
+
+    def _fill(self):
+        if self.pos < len(self.buf):
+            return True
+        if self.deadline is not None and time.monotonic() >= self.deadline:
+            raise TimeoutError("structured session search timed out")
+        self.base += self.pos
+        self.buf, self.pos = self.blob.read(self.chunk_size), 0
+        return bool(self.buf)
+
+    def tell(self):
+        return self.base + self.pos
+
+    def peek(self):
+        return self.buf[self.pos] if self._fill() else None
+
+    def get(self):
+        value = self.peek()
+        if value is None:
+            raise InvalidJSON("unexpected end of JSON")
+        self.pos += 1
+        return value
+
+    def ws(self):
+        while self.peek() in (9, 10, 13, 32):
+            self.pos += 1
+
+    def expect(self, value):
+        if self.get() != value:
+            raise InvalidJSON("unexpected JSON token")
+
+    def string(self):
+        self.expect(34)
+        start = self.tell()
+        decoder = codecs.getincrementaldecoder("utf-8")("strict")
+        while self._fill():
+            hit = _STOP.search(self.buf, self.pos)
+            end = hit.start() if hit else len(self.buf)
+            try:
+                decoder.decode(self.buf[self.pos : end], final=False)
+            except UnicodeDecodeError as exc:
+                raise InvalidJSON("invalid UTF-8") from exc
+            self.pos = end
+            if hit is None:
+                continue
+            symbol = self.get()
+            if symbol == 34:
+                try:
+                    decoder.decode(b"", final=True)
+                except UnicodeDecodeError as exc:
+                    raise InvalidJSON("invalid UTF-8") from exc
+                return start, self.tell() - 1
+            if symbol != 92:
+                raise InvalidJSON("unescaped control character")
+            try:
+                decoder.decode(b"", final=True)
+            except UnicodeDecodeError as exc:
+                raise InvalidJSON("invalid UTF-8") from exc
+            decoder = codecs.getincrementaldecoder("utf-8")("strict")
+            escaped = self.get()
+            if escaped == 117:
+                if any(self.get() not in _HEX for _ in range(4)):
+                    raise InvalidJSON("invalid unicode escape")
+            elif escaped not in b'"\\/bfnrt':
+                raise InvalidJSON("invalid string escape")
+        raise InvalidJSON("unterminated JSON string")
+
+    def small_string(self, span):
+        start, end = span
+        if end - start > 128:
+            return None
+        resume = self.blob.tell()
+        try:
+            self.blob.seek(start)
+            return json.loads(b'"' + self.blob.read(end - start) + b'"')
+        finally:
+            self.blob.seek(resume)
+
+    def value(self, depth=0):
+        if depth > 512:
+            raise UnsupportedJSON("JSON nesting exceeds supported depth")
+        self.ws()
+        token = self.peek()
+        if token == 34:
+            self.string()
+            return
+        if token in (91, 123):
+            opening = self.get()
+            closing = 93 if opening == 91 else 125
+            self.ws()
+            if self.peek() == closing:
+                self.get()
+                return
+            while True:
+                if opening == 123:
+                    self.string()
+                    self.ws()
+                    self.expect(58)
+                self.value(depth + 1)
+                self.ws()
+                if self.peek() == closing:
+                    self.get()
+                    return
+                self.expect(44)
+                self.ws()
+        raw = bytearray()
+        while self.peek() is not None and self.peek() not in (
+            9,
+            10,
+            13,
+            32,
+            44,
+            93,
+            125,
+        ):
+            if len(raw) >= 1024:
+                raise UnsupportedJSON("JSON scalar exceeds supported length")
+            raw.append(self.get())
+        # Python's native json encoder/decoder also accepts these float values.
+        if raw not in (
+            b"true",
+            b"false",
+            b"null",
+            b"NaN",
+            b"Infinity",
+            b"-Infinity",
+        ) and not _NUMBER.fullmatch(raw):
+            raise InvalidJSON("invalid JSON scalar")
+
+    def top_object(self):
+        self.expect(123)
+        self.ws()
+        kind, text = None, None
+        if self.peek() == 125:
+            self.get()
+            return None
+        while True:
+            key = self.small_string(self.string())
+            self.ws()
+            self.expect(58)
+            self.ws()
+            if key in ("type", "text") and self.peek() == 34:
+                span = self.string()
+                if key == "type":
+                    kind = self.small_string(span)
+                else:
+                    text = span
+            else:
+                self.value(1)
+                if key == "type":
+                    kind = None
+                if key == "text":
+                    text = None
+            self.ws()
+            if self.peek() == 125:
+                self.get()
+                return text if kind == "text" else None
+            self.expect(44)
+            self.ws()
+
+
+def text_spans(blob, deadline=None, chunk_size=65536):
+    blob.seek(0)
+    if blob.read(6) != b"\x00json:":
+        raise InvalidJSON("not structured content")
+    cur = Cursor(blob, 6, deadline, chunk_size)
+    cur.ws()
+    root = cur.peek()
+    spans = []
+    if root == 91:
+        cur.get()
+        cur.ws()
+        if cur.peek() != 93:
+            while True:
+                span = cur.top_object() if cur.peek() == 123 else (cur.value(1) or None)
+                if span is not None:
+                    if len(spans) >= 65536:
+                        raise UnsupportedJSON("too many structured text parts")
+                    spans.append(span)
+                cur.ws()
+                if cur.peek() == 93:
+                    break
+                cur.expect(44)
+                cur.ws()
+        cur.expect(93)
+    elif root == 123:
+        span = cur.top_object()
+        if span is not None:
+            spans.append(span)
+    elif root == 34:
+        spans.append(cur.string())
+    else:
+        cur.value()
+    cur.ws()
+    if cur.peek() is not None:
+        raise InvalidJSON("trailing JSON")
+    return spans
+
+
+def decoded_string(blob, span, deadline=None, chunk_size=65536):
+    start, end = span
+    blob.seek(start)
+    remaining = end - start
+    decoder = codecs.getincrementaldecoder("utf-8")("strict")
+    pending = ""
+    escapes = {
+        '"': '"',
+        "\\": "\\",
+        "/": "/",
+        "b": "\b",
+        "f": "\f",
+        "n": "\n",
+        "r": "\r",
+        "t": "\t",
+    }
+    while remaining or pending:
+        if remaining:
+            if deadline is not None and time.monotonic() >= deadline:
+                raise TimeoutError("structured session search timed out")
+            raw = blob.read(min(chunk_size, remaining))
+            remaining -= len(raw)
+            if not raw:
+                raise InvalidJSON("short JSON string")
+            pending += decoder.decode(raw, final=remaining == 0)
+        idx = pending.find("\\")
+        if idx < 0:
+            if pending:
+                yield pending
+            pending = ""
+            continue
+        if idx:
+            yield pending[:idx]
+            pending = pending[idx:]
+        if len(pending) < 2:
+            if remaining:
+                continue
+            raise InvalidJSON("incomplete escape")
+        code = pending[1]
+        if code != "u":
+            if code not in escapes:
+                raise InvalidJSON("invalid escape")
+            yield escapes[code]
+            pending = pending[2:]
+            continue
+        if len(pending) < 6:
+            if remaining:
+                continue
+            raise InvalidJSON("incomplete unicode escape")
+        try:
+            number = int(pending[2:6], 16)
+        except ValueError as exc:
+            raise InvalidJSON("invalid unicode escape") from exc
+        consume = 6
+        if 0xD800 <= number <= 0xDBFF:
+            tail = pending[6:]
+            if (
+                len(pending) < 12
+                and remaining
+                and (not tail or "\\u".startswith(tail) or tail.startswith("\\u"))
+            ):
+                continue
+            if pending[6:8] == "\\u" and len(pending) >= 12:
+                try:
+                    low = int(pending[8:12], 16)
+                except ValueError:
+                    low = -1
+                if 0xDC00 <= low <= 0xDFFF:
+                    number = 0x10000 + ((number - 0xD800) << 10) + low - 0xDC00
+                    consume = 12
+        yield chr(number)
+        pending = pending[consume:]
+
+
+def text_chunks(blob, spans, deadline=None, chunk_size=65536):
+    for index, span in enumerate(spans):
+        if index:
+            yield "\n"
+        yield from decoded_string(blob, span, deadline, chunk_size)
+
+
+def analyze(blob, spans, terms, deadline=None, chunk_size=65536):
+    max_tail = max((len(t) for t in terms), default=1) - 1
+    lower_terms = [t.translate(_ASCII_LOWER) for t in terms]
+    found = [None] * len(terms)
+    carry = ""
+    chars = size = 0
+    binary = False
+    for text in text_chunks(blob, spans, deadline, chunk_size):
+        merged = carry + text
+        folded = merged.translate(_ASCII_LOWER)
+        base_chars = chars - len(carry)
+        base_bytes = size - len(carry.encode("utf-8", "surrogatepass"))
+        for i, term in enumerate(lower_terms):
+            if found[i] is None and (offset := folded.find(term)) >= 0:
+                found[i] = (
+                    base_chars + offset,
+                    base_bytes + len(merged[:offset].encode("utf-8", "surrogatepass")),
+                )
+        chars += len(text)
+        size += len(text.encode("utf-8", "surrogatepass"))
+        binary |= _RAW_ONLY.search(text) is not None
+        carry = merged[-max_tail:] if max_tail else ""
+    return {"positions": found, "chars": chars, "bytes": size, "binary": binary}
+
+
+def page(blob, spans, offset, limit, deadline=None, chunk_size=65536):
+    chars = size = 0
+    binary = False
+    char_parts = []
+    byte_parts = []
+    for text in text_chunks(blob, spans, deadline, chunk_size):
+        raw = text.encode("utf-8", "surrogatepass")
+        left, right = max(0, offset - chars), min(len(text), offset + limit - chars)
+        if right > left:
+            char_parts.append(text[left:right])
+        left, right = max(0, offset - size), min(len(raw), offset + limit - size)
+        if right > left:
+            byte_parts.append(raw[left:right])
+        chars += len(text)
+        size += len(raw)
+        binary |= _RAW_ONLY.search(text) is not None
+    if binary:
+        value = b"".join(byte_parts)
+        content = base64.b64encode(value).decode("ascii")
+        total = size
+        unit, encoding, length = "bytes", "base64", len(value)
+    else:
+        content = "".join(char_parts)
+        total = chars
+        unit, encoding, length = "characters", "text", len(content)
+    return {
+        "content": content,
+        "total": total,
+        "offset": offset,
+        "limit": limit,
+        "offset_unit": unit,
+        "encoding": encoding,
+        "next_offset": offset + length if offset + length < total else None,
+        "previous_offset": max(0, min(offset, total) - limit) if offset else None,
+    }
+
+
+def raw_json_page(blob, offset, limit, deadline=None, chunk_size=65536):
+    """Page the original UTF-8 JSON serialization after its stored marker."""
+    blob.seek(6)
+    decoder = codecs.getincrementaldecoder("utf-8")("strict")
+    total = 0
+    parts = []
+    while True:
+        if deadline is not None and time.monotonic() >= deadline:
+            raise TimeoutError("structured session page timed out")
+        raw = blob.read(chunk_size)
+        text = decoder.decode(raw, final=not raw)
+        left, right = max(0, offset - total), min(len(text), offset + limit - total)
+        if right > left:
+            parts.append(text[left:right])
+        total += len(text)
+        if not raw:
+            break
+    content = "".join(parts)
+    return {
+        "content": content,
+        "total": total,
+        "offset": offset,
+        "limit": limit,
+        "offset_unit": "characters",
+        "encoding": "json",
+        "next_offset": offset + len(content) if offset + len(content) < total else None,
+        "previous_offset": max(0, min(offset, total) - limit) if offset else None,
+    }
+
+
+def raw_binary_page(blob, offset, limit):
+    total = len(blob)
+    blob.seek(min(offset, total))
+    value = blob.read(limit)
+    return {
+        "content": base64.b64encode(value).decode("ascii"),
+        "total": total,
+        "offset": offset,
+        "limit": limit,
+        "offset_unit": "bytes",
+        "encoding": "base64",
+        "next_offset": offset + len(value) if offset + len(value) < total else None,
+        "previous_offset": max(0, min(offset, total) - limit) if offset else None,
+    }
+
+
+def analyze_raw(blob, terms, deadline=None, chunk_size=65536):
+    needles = [term.encode("utf-8").lower() for term in terms]
+    max_tail = max((len(term) for term in needles), default=1) - 1
+    positions = [None] * len(terms)
+    carry = b""
+    total = 0
+    blob.seek(0)
+    while True:
+        if deadline is not None and time.monotonic() >= deadline:
+            raise TimeoutError("structured session search timed out")
+        data = blob.read(chunk_size)
+        if not data:
+            break
+        merged = carry + data
+        folded = merged.lower()
+        base = total - len(carry)
+        for index, needle in enumerate(needles):
+            if positions[index] is None and (offset := folded.find(needle)) >= 0:
+                positions[index] = (None, base + offset)
+        total += len(data)
+        carry = merged[-max_tail:] if max_tail else b""
+    return {"positions": positions, "bytes": total, "binary": True}
+
+
+class Search:
+    def __init__(self, conn, terms, deadline=None):
+        self.conn, self.terms, self.deadline = conn, list(terms), deadline
+        self.cache = OrderedDict()
+        self.error = None
+
+    def invalidate(self, message_id):
+        self.cache.pop(message_id, None)
+
+    def info(self, message_id):
+        if message_id in self.cache:
+            self.cache.move_to_end(message_id)
+            return self.cache[message_id]
+        with SQLiteBlobReader(self.conn, "content", message_id) as blob:
+            try:
+                spans = text_spans(blob, self.deadline)
+            except InvalidJSON:
+                info = analyze_raw(blob, self.terms, self.deadline)
+                info.update(structured=False, spans=[])
+            else:
+                info = analyze(blob, spans, self.terms, self.deadline)
+                info.update(structured=True, spans=spans)
+        self.cache[message_id] = info
+        if len(self.cache) > 64:
+            self.cache.popitem(last=False)
+        return info
+
+    def contains(self, message_id, term):
+        try:
+            info = self.info(message_id)
+            # The SQL predicate needs only match positions. Do not retain a
+            # potentially large list of text spans for every candidate row.
+            info["spans"] = None
+            return int(info["positions"][self.terms.index(term)] is not None)
+        except Exception as exc:
+            self.error = exc
+            raise
+
+    def excerpt(self, message_id, terms, limit):
+        info = self.info(message_id)
+        if info["structured"] and info["spans"] is None:
+            self.invalidate(message_id)
+            info = self.info(message_id)
+        position = next(
+            (
+                info["positions"][self.terms.index(term)]
+                for term in terms
+                if info["positions"][self.terms.index(term)] is not None
+            ),
+            None,
+        )
+        if position is None:
+            return None
+        offset = max(0, position[1 if info["binary"] else 0] - min(1000, limit // 3))
+        with SQLiteBlobReader(self.conn, "content", message_id) as blob:
+            if info["structured"]:
+                result = page(blob, info["spans"], offset, limit, self.deadline)
+                field = "text"
+            else:
+                blob.seek(offset)
+                value = blob.read(limit)
+                result = {
+                    "content": base64.b64encode(value).decode("ascii"),
+                    "offset_unit": "bytes",
+                    "encoding": "base64",
+                }
+                field = "content"
+        return {
+            "snippet": result["content"],
+            "snippet_field": field,
+            "snippet_offset": offset,
+            "offset_unit": result["offset_unit"],
+            "snippet_encoding": result["encoding"],
+        }
