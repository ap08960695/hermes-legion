+"""Project native auxiliary usage onto the Chat Completions consumer contract."""
+
+from types import SimpleNamespace
+from typing import Any
+
+
+def chat_usage_from_native(raw_usage: Any, *, api_mode: str) -> Any:
+    """Keep cache/reasoning buckets while converting native prompt accounting."""
+    if not raw_usage:
+        return None
+    from agent.usage_pricing import normalize_usage
+
+    usage = normalize_usage(raw_usage, api_mode=api_mode)
+    return SimpleNamespace(
+        prompt_tokens=usage.prompt_tokens,
+        completion_tokens=usage.output_tokens,
+        total_tokens=usage.total_tokens,
+        prompt_tokens_details=SimpleNamespace(
+            cached_tokens=usage.cache_read_tokens,
+            cache_write_tokens=usage.cache_write_tokens,
+        ),
+        completion_tokens_details=SimpleNamespace(reasoning_tokens=usage.reasoning_tokens),
+    )
diff --git a/agent/cache_change_evidence.py b/agent/cache_change_evidence.py
new file mode 100644
index 0000000000000000000000000000000000000000..7972af6c0aececd154b3dfb4d338616e9d472a68
--- /dev/null
+++ b/agent/cache_change_evidence.py
@@ -0,0 +1,57 @@
+"""Explain observed request changes with bounded digests, never prompt bodies."""
+_POLICIES = {
+    'ready_before_wait': '<!-- captain-ready-before-wait-v1 -->',
+    'decision_autonomy': '<!-- captain-decision-autonomy-v1 -->',
+    'execution_reference': 'Captain execution evidence v1',
+}
+
+
+def policy_evidence(request):
+    effective = dict(request)
+    if isinstance(request.get('extra_body'), dict):
+        effective.update(request['extra_body'])
+    value = effective.get('instructions', effective.get('system'))
+    if value is None:
+        value = [m.get('content') for m in effective.get('messages', [])
+                 if isinstance(m, dict) and m.get('role') in {'system', 'developer'}]
+    # Iterative, bounded traversal of text blocks, no copies of the full context.
+    stack, remaining, found = [value], 2 * 1024 * 1024, set()
+    visited = 0
+    while stack and remaining > 0 and visited < 4096:
+        part = stack.pop()
+        visited += 1
+        if isinstance(part, str):
+            text = part[:remaining]
+            remaining -= len(text)
+            found.update(name for name, marker in _POLICIES.items() if marker in text)
+        elif isinstance(part, list):
+            stack.extend(reversed(part[:4096]))
+        elif isinstance(part, dict):
+            stack.append(part.get('text', part.get('content')))
+    return {'markers_present': sorted(found), 'scan_complete': not stack and remaining > 0,
+            'evidence': 'prepared_instruction_marker_only_not_behavior_or_authorization'}
+
+
+def transition(agent, fingerprint):
+    """Agent-local, scope-bound state. Only compact hashes survive a request."""
+    names = ('route', 'instructions', 'tools', 'options', 'history')
+    def value(name):
+        part = fingerprint.get(name, {})
+        return part.get('hash') if part.get('complete') else None
+    scope = (fingerprint.get('key_id'), value('session'))
+    current = {name: value(name) for name in names}
+    prefixes = fingerprint.get('history', {}).get('prefixes', {})
+    current['history_prefixes'] = {k: v for k, v in prefixes.items() if k in {'4096','16384','65536','262144','1048576','4194304'}}
+    previous = getattr(agent, '_cache_change_evidence', None)
+    agent._cache_change_evidence = (scope, current)
+    if previous is None or previous[0] != scope or None in scope:
+        return {'baseline': True, 'changed': [], 'cause_of_cache_miss_proven': False}
+    changed = [name for name in names if current[name] is not None and previous[1].get(name) is not None
+               and current[name] != previous[1][name]]
+    unknown = [name for name in names if current[name] is None or previous[1].get(name) is None]
+    old_prefixes = previous[1].get('history_prefixes', {})
+    equal = [int(k) for k, v in current['history_prefixes'].items() if old_prefixes.get(k) == v]
+    return {'baseline': False, 'changed': changed, 'unknown': unknown,
+            'history_equal_prefix_bytes': max(equal, default=None),
+            'history_change_does_not_imply_prefix_change': True,
+            'cause_of_cache_miss_proven': False}
diff --git a/agent/cache_cross_bot_diagnostics.py b/agent/cache_cross_bot_diagnostics.py
new file mode 100644
index 0000000000000000000000000000000000000000..ad1e9fa237d25737cd119dd05dadde35496c5e5e
--- /dev/null
+++ b/agent/cache_cross_bot_diagnostics.py
@@ -0,0 +1,117 @@
+"""Same-installation, content-free cache comparisons; never a cache policy change.
+
+Only keyed digests leave this module. Declared account headers are not authenticated
+account proof, and matching request fields never prove the origin of a provider hit.
+"""
+from __future__ import annotations
+
+import hashlib
+import hmac
+import os
+from hermes_platform.host.identity import current_user_id
+from pathlib import Path
+import stat
+import tempfile
+import time
+
+_MAX_BYTES = 512 * 1024
+_ACCOUNT_HEADERS = ('chatgpt-account-id', 'openai-organization', 'openai-project')
+
+
+def _installation_key(home: Path) -> bytes:
+    from hermes_constants import get_default_hermes_root
+
+    directory = get_default_hermes_root(home=home) / 'telemetry' / 'cache-cross-bot-v1'
+    directory.mkdir(parents=True, mode=0o700, exist_ok=True)
+    info = directory.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o077 or info.st_uid != current_user_id():
+        raise OSError('unsafe diagnostic directory')
+    target = directory / 'fingerprint.key'
+    if not target.exists():
+        # Publish a complete key without replacing another process's winning key.
+        fd, name = tempfile.mkstemp(dir=directory, prefix='.key-')
+        try:
+            with os.fdopen(fd, 'wb') as stream:
+                stream.write(os.urandom(32))
+                stream.flush()
+                os.fsync(stream.fileno())
+            try:
+                os.link(name, target)
+            except FileExistsError:
+                pass
+        finally:
+            os.unlink(name)
+    fd = os.open(target, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
+    with os.fdopen(fd, 'rb') as stream:
+        info = os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077 or info.st_uid != current_user_id():
+            raise OSError('unsafe diagnostic key')
+        key = stream.read(33)
+    if len(key) != 32:
+        raise ValueError('incomplete diagnostic key')
+    return key
+
+
+def _declared_account(agent, request):
+    """Read only non-secret account selectors already staged for the request."""
+    headers = {}
+    defaults = getattr(agent, '_client_kwargs', {}) or {}
+    for source in (defaults.get('default_headers') or {}, request.get('extra_headers') or {}):
+        for name, value in source.items():
+            normalized = str(name).lower()
+            if normalized in _ACCOUNT_HEADERS:
+                headers[normalized] = value
+    # Do not read tokens, credentials, auth files or SDK properties to fill gaps.
+    return {name: value for name, value in headers.items() if isinstance(value, str) and value} or None
+
+
+def fingerprint(agent, request, *, request_id: str) -> dict:
+    from agent.cache_request_diagnostics import _digest
+    from agent.shared_prompt_cache import layout_version, common_prefix, shared_tool_prefix
+    from hermes_constants import get_hermes_home
+
+    home = get_hermes_home()
+    key = _installation_key(home)
+    # Domain separation makes the installation-wide namespace distinct from local logs.
+    key = hmac.new(key, b'hermes-cross-bot-v1', hashlib.sha256).digest()
+    effective = dict(request)
+    if isinstance(request.get('extra_body'), dict):
+        effective.update(request['extra_body'])
+    instructions = effective.get('instructions', effective.get('system'))
+    if instructions is None:
+        instructions = [m for m in effective.get('messages', [])
+                        if isinstance(m, dict) and m.get('role') in {'system', 'developer'}]
+    common = common_prefix(instructions)
+    shared_tools = shared_tool_prefix(effective.get('tools')) if layout_version(instructions) >= 2 else None
+    # Small identity fields are hashed first so large schemas cannot hide the scope.
+    profile = str(home.resolve())
+    session = getattr(agent, 'session_id', None)
+    fields = {
+        'profile': profile,
+        'session': [profile, session] if session else None,
+        'request': request_id or None,
+        'route': [getattr(agent, 'base_url', None), effective.get('model'), getattr(agent, 'api_mode', None)],
+        'declared_account': _declared_account(agent, request),
+        'cache_key': effective.get('prompt_cache_key'),
+        'common_prefix': common,
+        'options': {name: effective.get(name) for name in (
+            'reasoning', 'text', 'tool_choice', 'parallel_tool_calls',
+            'prompt_cache_options', 'prompt_cache_retention',
+            'previous_response_id', 'conversation', 'context_management',
+            'thinking', 'output_config', 'speed', 'service_tier', 'cache_control')},
+        'shared_tools': shared_tools or None,
+        'tools': effective.get('tools'),
+        'instructions': instructions,
+    }
+    budget = [_MAX_BYTES]
+    digests = {name: _digest(key, value, budget, anchors=name in {'tools', 'shared_tools', 'instructions'})
+               if value is not None else None for name, value in fields.items()}
+    return {
+        'version': 1,
+        'scope': 'same_installation',
+        'namespace': hmac.new(key, b'namespace', hashlib.sha256).hexdigest()[:16],
+        'started_at_ns': time.time_ns(),
+        'fields': digests,
+        'complete': all(value is None or value['complete'] for value in digests.values()),
+        'account_evidence': 'declared_headers' if fields['declared_account'] else 'unknown',
+    }
diff --git a/agent/cache_request_diagnostics.py b/agent/cache_request_diagnostics.py
new file mode 100644
index 0000000000000000000000000000000000000000..af9ccaa529069ef4e35e43a8370c2ca4eee4398f
--- /dev/null
+++ b/agent/cache_request_diagnostics.py
@@ -0,0 +1,175 @@
+"""Content-free fingerprints for the existing provider request log.
+
+Observe the prepared request after transport preflight, not the server's hidden prefix or
+SDK wire serialization. HMACs are profile-local and survive resume; nothing here changes
+cache policy, request data, compaction or routing. Fail-open diagnostics never retry calls.
+"""
+from __future__ import annotations
+
+from contextlib import suppress
+import hashlib
+import hmac
+import json
+import logging
+import os
+import stat
+import time
+
+logger = logging.getLogger('agent.conversation_loop')
+_MAX_BYTES = 8 * 1024 * 1024
+_ANCHORS = (4096, 16384, 65536, 262144, 1048576, 4194304)
+_ENCODER = json.JSONEncoder(ensure_ascii=True, sort_keys=True, separators=(',', ':'), allow_nan=False)
+
+
+def _profile_key() -> bytes:
+    from hermes_constants import get_hermes_home
+
+    directory = get_hermes_home() / 'telemetry' / 'cache-diagnostics'
+    directory.mkdir(parents=True, mode=0o700, exist_ok=True)
+    path = directory / 'fingerprint.key'
+    # Exclusive creation makes simultaneous sessions share one key, without replacing it.
+    try:
+        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+    except FileExistsError:
+        pass
+    else:
+        with os.fdopen(fd, 'wb') as stream:
+            stream.write(os.urandom(32))
+    fd = os.open(path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
+    with os.fdopen(fd, 'rb') as stream:
+        info = os.fstat(stream.fileno())
+        if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077:
+            raise ValueError('unsafe diagnostic key permissions')
+        key = stream.read(33)
+    if len(key) != 32:
+        raise ValueError('incomplete diagnostic key')
+    return key
+
+
+def _digest(key: bytes, value, budget: list[int], *, anchors: bool = False) -> dict:
+    digest = hmac.new(key, digestmod=hashlib.sha256)
+    count, prefixes = 0, {}
+    for text in _ENCODER.iterencode(value):
+        data = text.encode('ascii')
+        if len(data) > budget[0]:
+            return {'complete': False, 'bytes_hashed': count, 'prefixes': prefixes}
+        budget[0] -= len(data)
+        offset = 0
+        for boundary in _ANCHORS if anchors else ():
+            if count < boundary <= count + len(data):
+                end = boundary - count
+                digest.update(data[offset:end])
+                prefixes[str(boundary)] = digest.hexdigest()
+                offset = end
+        digest.update(data[offset:])
+        count += len(data)
+    result = {'complete': True, 'bytes_hashed': count, 'hash': digest.hexdigest()}
+    if anchors:
+        result['prefixes'] = prefixes
+    return result
+
+
+def fingerprint(request: dict, *, key: bytes, session_id: str, request_id: str, base_url: str) -> dict:
+    """Bounded canonical-JSON hashes. Dictionary ordering is normalized; list order is retained."""
+    budget = [_MAX_BYTES]
+    extra = request.get('extra_body')
+    # SDK extra_body overrides these values; do not hash headers, credentials or unrelated fields.
+    effective = dict(request)
+    if isinstance(extra, dict):
+        effective.update(extra)
+    fields = {
+        'route': [base_url, effective.get('model')],
+        'session': session_id, 'request': request_id,
+        'instructions': effective.get('instructions', effective.get('system', [
+            m for m in effective.get('messages', []) if isinstance(m, dict) and m.get('role') in {'system', 'developer'}])),
+        'tools': effective.get('tools'),
+        'options': {name: effective.get(name) for name in (
+            'reasoning', 'text', 'tool_choice', 'parallel_tool_calls',
+            'prompt_cache_key', 'prompt_cache_options', 'prompt_cache_retention',
+            'previous_response_id', 'conversation', 'context_management',
+            'thinking', 'output_config', 'speed', 'service_tier', 'cache_control')},
+    }
+    result = {name: _digest(key, value, budget, anchors=name in {'instructions', 'tools'}) for name, value in fields.items()}
+    history = effective.get('input', effective.get('messages'))
+    result['history'] = _digest(key, history, budget, anchors=True)
+    result['input_items'] = len(history) if isinstance(history, list) else None
+    from agent.shared_prompt_cache import common_prefix, layout_version
+    instruction = fields['instructions']
+    if isinstance(instruction, list) and instruction and isinstance(instruction[0], dict):
+        instruction = instruction[0].get('text', instruction[0].get('content'))
+    result['shared_prefix_used'] = common_prefix(instruction) is not None
+    result['shared_layout_version'] = layout_version(instruction) if result['shared_prefix_used'] else None
+    result['shared_key_used'] = str(effective.get('prompt_cache_key') or '').startswith(('hsp1_', 'hsp2_', 'hsp3_', 'hsp4_'))
+    result['key_id'] = hmac.new(key, b'hermes-cache-diagnostics-v1', hashlib.sha256).hexdigest()[:16]
+    result['complete'] = all(result[name]['complete'] for name in (*fields, 'history'))
+    return result
+
+
+def _field(value, name):
+    return value.get(name) if isinstance(value, dict) else getattr(value, name, None)
+
+
+def _count(value):
+    return value if isinstance(value, int) and not isinstance(value, bool) and value >= 0 else None
+
+
+def _usage(response) -> dict:
+    usage = _field(response, 'usage')
+    read = _count(_field(usage, 'cache_read_input_tokens'))
+    written = _count(_field(usage, 'cache_creation_input_tokens'))
+    if read is not None or written is not None:
+        # Anthropic input_tokens excludes both cache reads and writes.
+        uncached = _count(_field(usage, 'input_tokens'))
+        total = sum((uncached, read, written)) if all(v is not None for v in (uncached, read, written)) else None
+        return {'input_tokens': total, 'cached_tokens': read, 'cache_write_tokens': written}
+    total = _count(_field(usage, 'input_tokens'))
+    details = _field(usage, 'input_tokens_details')
+    if total is None:
+        total = _count(_field(usage, 'prompt_tokens'))
+        details = _field(usage, 'prompt_tokens_details')
+    return {'input_tokens': total, 'cached_tokens': _count(_field(details, 'cached_tokens')),
+            'cache_write_tokens': _count(_field(details, 'cache_write_tokens'))}
+
+
+def _emit(snapshot, response, *, status: str, started: float, preparation_ms: float) -> None:
+    # Never format exception text, response content, request bodies, credentials or raw identifiers.
+    with suppress(Exception):
+        row = {'version': 1, 'stage': 'prepared_after_transport_preflight',
+               'implementation': 'cache-sharing-v1', 'status': status, 'process_id': os.getpid(), 'fingerprint': snapshot,
+               'usage': _usage(response), 'elapsed_ms': round((time.perf_counter()-started)*1000, 3),
+               'preparation_ms': round(preparation_ms, 3)}
+        logger.info('CACHE_DIAGNOSTIC %s', json.dumps(row, separators=(',', ':')))
+
+
+def observe_call(agent, request: dict, next_call, *, request_id: str):
+    """Return/raise the downstream result unchanged, exactly once, even if diagnostics fail."""
+    if (getattr(agent, 'api_mode', '') not in {'codex_responses', 'anthropic_messages', 'chat_completions'}
+            or not logger.isEnabledFor(logging.INFO)):
+        return next_call(request)
+    before = time.perf_counter()
+    snapshot = {'complete': False, 'unavailable': True}
+    with suppress(Exception):
+        key = _profile_key()
+        snapshot = fingerprint(request, key=key, session_id=getattr(agent, 'session_id', '') or '',
+                               request_id=request_id, base_url=getattr(agent, 'base_url', '') or '')
+        snapshot['api_mode'] = agent.api_mode
+    with suppress(Exception):
+        from agent.usage_run_binding import snapshot as run_snapshot
+        snapshot['task_run'] = run_snapshot(key)
+    snapshot['cross_bot'] = {'version': 1, 'unavailable': True}
+    with suppress(Exception):
+        from agent.cache_cross_bot_diagnostics import fingerprint as cross_bot_fingerprint
+        snapshot['cross_bot'] = cross_bot_fingerprint(agent, request, request_id=request_id)
+    with suppress(Exception):
+        from agent.cache_change_evidence import policy_evidence, transition
+        snapshot['policy'] = policy_evidence(request)
+        snapshot['transition'] = transition(agent, snapshot)
+    preparation_ms = (time.perf_counter() - before) * 1000
+    started = time.perf_counter()
+    try:
+        response = next_call(request)
+    except BaseException:
+        _emit(snapshot, None, status='failed_or_interrupted', started=started, preparation_ms=preparation_ms)
+        raise
+    _emit(snapshot, response, status='returned', started=started, preparation_ms=preparation_ms)
+    return response
