+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("initial", ["regular", "missing"])
+@pytest.mark.parametrize("no_nofollow_flag", [False, True], ids=["native-nofollow", "identity-fallback"])
+def test_symlink_swap_before_write_does_not_modify_target(
+    fleet, tmp_path, monkeypatch, initial, no_nofollow_flag
+):
+    if no_nofollow_flag:
+        monkeypatch.setattr(os, "O_NOFOLLOW", 0, raising=False)
+    root, _, _ = fleet
+    marker = root / "ESTOP"
+    target = tmp_path / "unrelated.txt"
+    original_data = b"do not change this"
+    target.write_bytes(original_data)
+    if initial == "regular":
+        marker.write_text('{"reason":"old"}', encoding="utf-8")
+    original_open = os.open
+    swapped = []
+
+    def open_with_swap(path, flags, *args, **kwargs):
+        if os.fspath(path) == os.fspath(marker) and flags & os.O_ACCMODE == os.O_WRONLY and not swapped:
+            marker.unlink(missing_ok=True)
+            marker.symlink_to(target)
+            swapped.append(True)
+        return original_open(path, flags, *args, **kwargs)
+
+    monkeypatch.setattr(os, "open", open_with_swap)
+    estop.engage_fleet("new reason")
+    assert swapped and marker.is_symlink()
+    assert target.read_bytes() == original_data
+    assert estop.is_engaged() is True
+
+
+@pytest.mark.platforms("posix")
+@pytest.mark.parametrize("no_nofollow_flag", [False, True], ids=["native-nofollow", "identity-fallback"])
+def test_symlink_swap_before_state_read_does_not_expose_target_reason(
+    fleet, tmp_path, monkeypatch, no_nofollow_flag
+):
+    if no_nofollow_flag:
+        monkeypatch.setattr(os, "O_NOFOLLOW", 0, raising=False)
+    root, _, _ = fleet
+    marker = root / "ESTOP"
+    target = tmp_path / "unrelated.json"
+    marker.write_text('{"reason":"existing"}', encoding="utf-8")
+    target.write_text('{"reason":"unrelated data"}', encoding="utf-8")
+    original_open = os.open
+    swapped = []
+
+    def open_with_swap(path, flags, *args, **kwargs):
+        if os.fspath(path) == os.fspath(marker) and flags & os.O_ACCMODE == os.O_RDONLY and not swapped:
+            marker.unlink()
+            marker.symlink_to(target)
+            swapped.append(True)
+        return original_open(path, flags, *args, **kwargs)
+
+    monkeypatch.setattr(os, "open", open_with_swap)
+    assert estop.get_state() == {"reason": None, "engaged_at": None}
+    assert swapped and marker.is_symlink()
+    assert estop.is_engaged() is True
+
+
+def test_short_writes_store_a_complete_reason(fleet, monkeypatch):
+    root, _, _ = fleet
+    original_write = os.write
+    writes = []
+
+    def short_write(fd, data):
+        writes.append(True)
+        return original_write(fd, data[:3])
+
+    monkeypatch.setattr(os, "write", short_write)
+    estop.engage_fleet("maintenance")
+    assert len(writes) > 1
+    assert json.loads((root / "ESTOP").read_text(encoding="utf-8"))["reason"] == "maintenance"
