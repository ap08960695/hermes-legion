new file mode 100644
index 0000000000000000000000000000000000000000..6ab0fb02bbc0da8fedf9222d68f95e572e70d265
--- /dev/null
+++ b/tests/hermes_cli/test_plugin_registration_memory.py
@@ -0,0 +1,73 @@
+"""Ledger cleanup memory scales with managers, preserving per-handle ownership."""
+
+import sys
+from unittest.mock import Mock
+
+import pytest
+
+from hermes_cli.plugins import PluginManager
+from hermes_cli.plugins_manifest import PluginManifest
+
+
+def _register(manager, manifest, name, release, *, persistent=False):
+    return manager._track_registration(manifest, "fixture", name, release, persistent=persistent)
+
+
+def test_cleanup_callback_memory_is_bounded_by_managers(tmp_path):
+    managers = [PluginManager(scope_key=str(tmp_path / str(i))) for i in range(3)]
+    manifest = PluginManifest(name="fixture-ledger")
+    releases = [Mock() for _ in managers]
+    groups = [[_register(manager, manifest, str(i), release) for i in range(128)]
+              for manager, release in zip(managers, releases)]
+    callbacks = {id(handle._on_dispose): handle._on_dispose for group in groups for handle in group}
+    # The cleanup function is the same operation for every handle owned by one
+    # manager. Hundreds of handles must not each retain a fresh function object.
+    assert sum(sys.getsizeof(callback) for callback in callbacks.values()) < 1024 * len(managers)
+
+    groups[1][0].dispose()
+    groups[1][0].dispose()
+    assert releases[1].call_count == 1
+    releases[0].assert_not_called()
+    releases[2].assert_not_called()
+    assert groups[1][0] not in managers[1]._registration_order
+    assert all(handle.active for handle in groups[0] + groups[2])
+    for manager, group, release in zip(managers, groups, releases):
+        for handle in group:
+            handle.dispose()
+        assert manager._registration_order == []
+        assert manager._ownership_ledger == {}
+        assert release.call_count == len(group)
+
+
+def test_cleanup_keeps_late_owner_dispatch_for_persistent_handles(tmp_path):
+    manager = PluginManager(scope_key=str(tmp_path))
+    manifest = PluginManifest(name="fixture-ledger")
+    ordinary = _register(manager, manifest, "ordinary", Mock())
+    persistent = _register(manager, manifest, "persistent", Mock(), persistent=True)
+    original = manager._forget_registrations
+    forget = Mock(wraps=original)
+    manager._forget_registrations = forget
+
+    persistent.dispose()
+    forget.assert_called_once_with([persistent])
+    assert ordinary.active
+    assert manager._ownership_ledger[manifest.name] == [ordinary]
+    ordinary.dispose()
+    assert manager._ownership_ledger == {}
+
+
+def test_release_failure_still_forgets_only_its_own_handle(tmp_path):
+    manager = PluginManager(scope_key=str(tmp_path))
+    manifest = PluginManifest(name="fixture-ledger")
+    failed_release = Mock(side_effect=ValueError("synthetic release failure"))
+    failed = _register(manager, manifest, "failed", failed_release)
+    survivor = _register(manager, manifest, "survivor", Mock())
+
+    with pytest.raises(ValueError, match="synthetic release failure"):
+        failed.dispose()
+    failed.dispose()
+    failed_release.assert_called_once()
+    assert not failed.active and survivor.active
+    assert manager._ownership_ledger[manifest.name] == [survivor]
+    survivor.dispose()
+    assert manager._ownership_ledger == {}
diff --git a/tests/hermes_cli/test_plugin_source_window.py b/tests/hermes_cli/test_plugin_source_window.py
