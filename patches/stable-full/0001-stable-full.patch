+"""Provider-confirmed windows belong to the credential that observed them."""
+from contextlib import contextmanager
+from types import SimpleNamespace
+
+import httpx
+import pytest
+
+from agent import model_metadata as metadata
+from agent.turn_overflow import _adopt_provider_context_limit
+
+BASE = "https://context.example.invalid/v1"
+MODEL = "synthetic-context-window"
+
+
+@pytest.fixture(autouse=True)
+def isolated_metadata(monkeypatch):
+    metadata._endpoint_model_metadata_cache.clear()
+    metadata._endpoint_model_metadata_cache_time.clear()
+    metadata._endpoint_blackhole_cache.clear()
+    monkeypatch.setattr(metadata.model_metadata_http, "resolve_verify", lambda _: False)
+
+
+def catalog(monkeypatch):
+    calls = []
+
+    @contextmanager
+    def stream(url, *, headers, **kwargs):
+        calls.append(headers.get("Authorization"))
+        yield httpx.Response(200, json={"data": [{"id": MODEL, "context_length": 65536}]},
+                             request=httpx.Request("GET", url))
+
+    monkeypatch.setattr(metadata.model_metadata_http, "stream", stream)
+    return calls
+
+
+def adopt(key, length=131072):
+    compressor = SimpleNamespace(update_model=lambda **_: None, _context_probed=False)
+    agent = SimpleNamespace(model=MODEL, base_url=BASE, provider="custom", api_mode="chat_completions",
+                            api_key=key, context_compressor=compressor, _buffer_vprint=lambda _: None)
+    assert _adopt_provider_context_limit(SimpleNamespace(agent=agent),
+                                        f"maximum context length is {length} tokens", 262144) == length
+
+
+def resolve(key, **kwargs):
+    return metadata.get_model_context_length(MODEL, BASE, api_key=key, provider="custom", **kwargs)
+
+
+def test_confirmed_window_does_not_cross_credentials(monkeypatch):
+    calls = catalog(monkeypatch)
+    adopt("synthetic-owner-a")
+    assert resolve("synthetic-owner-a") == 131072
+    assert resolve("synthetic-owner-b") == 65536
+    assert resolve("synthetic-owner-a") == 131072
+    assert calls == ["Bearer synthetic-owner-b"]
+
+
+def test_legacy_unqualified_window_is_not_current_credential_evidence(monkeypatch):
+    calls = catalog(monkeypatch)
+    metadata.save_context_length(MODEL, BASE, 131072)
+    assert resolve("synthetic-owner-b") == 65536
+    assert calls == ["Bearer synthetic-owner-b"]
+
+
+def test_anonymous_cache_compatibility_and_explicit_override(monkeypatch):
+    calls = catalog(monkeypatch)
+    metadata.save_context_length(MODEL, BASE, 131072)
+    assert resolve("") == 131072
+    assert resolve("synthetic-owner-a", config_context_length=524288) == 524288
+    assert calls == []
+
+
+@pytest.mark.parametrize("provider", ["novita", "deepinfra"])
+@pytest.mark.parametrize("invalid", [True, [], float("nan")])
+def test_provider_pricing_rejects_non_rate_values(provider, invalid):
+    payload = ({"input_token_price_per_m": invalid} if provider == "novita"
+               else {"metadata": {"pricing": {"input_tokens": invalid}}})
+    assert metadata._extract_pricing(payload) == {}
+
+
+@pytest.mark.parametrize("name", ["_query_local_context_length", "_query_ollama_api_show"])
+@pytest.mark.parametrize("change_home", [False, True])
+def test_local_probe_memo_follows_home_and_credential(monkeypatch, tmp_path, name, change_home):
+    from hermes_constants import get_hermes_home
+    metadata._LOCAL_CTX_PROBE_CACHE.clear()
+    first, second = tmp_path / "first", tmp_path / "second"
+    monkeypatch.setenv("HERMES_HOME", str(first))
+    calls = []
+
+    def probe(model, base_url, api_key=""):
+        calls.append((str(get_hermes_home()), api_key))
+        return 131072 if len(calls) == 1 else 65536
+
+    monkeypatch.setattr(metadata, name + "_uncached", probe)
+    query = getattr(metadata, name)
+    assert query(MODEL, BASE, api_key="synthetic-owner-a") == 131072
+    if change_home:
+        monkeypatch.setenv("HERMES_HOME", str(second))
+    key = "synthetic-owner-a" if change_home else "synthetic-owner-b"
+    assert query(MODEL, BASE, api_key=key) == 65536
+    assert len(calls) == 2
+
+
+def test_ollama_num_ctx_disk_memo_follows_credential(monkeypatch):
+    monkeypatch.setattr(metadata, "_is_ollama_server", lambda *_: True)
+    monkeypatch.setattr(metadata, "_ollama_show", lambda _, key, __: {
+        "parameters": "num_ctx " + ("131072" if key == "synthetic-owner-a" else "65536")})
+    assert metadata.query_ollama_num_ctx(MODEL, BASE, "synthetic-owner-a") == 131072
+    assert metadata.query_ollama_num_ctx(MODEL, BASE, "synthetic-owner-b") == 65536
