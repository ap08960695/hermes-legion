   // Per-attempt history. Closed runs first (most recent last), then the
   // active run if any. Each row shows profile / outcome / elapsed /
   // summary. Collapsed by default when there are more than three runs.
+  function activitySeconds(activity) {
+    if (!activity || !activity.seconds) return null;
+    const parts = [activity.unobserved_start_seconds || 0, ...Object.values(activity.seconds)];
+    if (!parts.every(value => typeof value === "number" && Number.isFinite(value) && value >= 0)) return null;
+    const total = parts.reduce((a, b) => a + b, 0);
+    return Number.isFinite(total) ? total : null;
+  }
+
+  function fmtRunSeconds(value, measured) {
+    // Round once before splitting minutes, so 59.96 never renders as 0m 60.0s.
+    const ticks = Math.round(Math.max(0, value) * (measured ? 10 : 1));
+    const secs = ticks / (measured ? 10 : 1);
+    const tail = measured ? (secs % 60).toFixed(1) : String(secs % 60);
+    if (secs < 60) return `${tail}s`;
+    if (secs < 3600) return `${Math.floor(secs / 60)}m ${tail}s`;
+    return `${Math.floor(secs / 3600)}h ${Math.floor(secs / 60) % 60}m ${tail}s`;
+  }
+
+  function RunActivity(props) {
+    const activity = props.run.activity;
+    const total = activitySeconds(activity);
+    if (total === null) return h("div", { className: "hermes-kanban-run-summary" }, "ยังไม่มีข้อมูลช่วงงาน / Phase timing unavailable");
+    const labels = { model: "รอ/รับคำตอบโมเดล", reading: "อ่านบริบท/ไฟล์", tools: "ใช้เครื่องมือ", verification: "ทดสอบ", parallel: "ทำหลายช่วงพร้อมกัน", between_calls: "ระหว่างคำสั่ง" };
+    const timings = Object.entries(activity.seconds || {}).map(function (entry) {
+      return `${labels[entry[0]] || entry[0]} ${Number(entry[1]).toFixed(1)}s`;
+    });
+    return h("div", { className: "hermes-kanban-run-summary" },
+      `${activity.live ? "ช่วงล่าสุด" : "ข้อมูลที่บันทึกไว้"}: ${labels[activity.phase] || activity.phase} · `,
+      `ก่อนเริ่มบันทึก ${Number(activity.unobserved_start_seconds || 0).toFixed(1)}s · `,
+      timings.join(" · "),
+      ` · รวมที่วัดได้ ${total.toFixed(1)}s`,
+      props.run.ended_at != null ? ` · การ์ดปิดที่ ${fmtRunSeconds(props.run.ended_at - props.run.started_at, false)}` : "",
+      activity.after_completion_seconds > 0 ? ` · บันทึกต่อหลังการ์ดปิด ${activity.after_completion_seconds.toFixed(1)}s` : "",
+      activity.unobserved_tail_seconds > 0 ? ` · ช่วงก่อนการ์ดปิดที่ยังไม่ได้วัด ${activity.unobserved_tail_seconds.toFixed(1)}s` : "",
+      ` · วัดถึง ${new Date(activity.observed_at * 1000).toLocaleTimeString()} (ไม่รวมเวลาหลังบันทึก)`);
+  }
