+import { EventEmitter } from 'node:events'
+
+import { afterEach, expect, it, vi } from 'vitest'
+
+const io = vi.hoisted(() => ({ writeText: vi.fn(), on: new Map<string, (...args: any[]) => void>(),
+  displays: [] as Array<{ id: number; workArea: { x: number; y: number; width: number; height: number } }> }))
+
+vi.mock('electron', async () => {
+  const { EventEmitter } = await import('node:events')
+
+  return { clipboard: { writeText: io.writeText }, ipcMain: { on: (name: string, fn: (...args: any[]) => void) => io.on.set(name, fn), handle: vi.fn() },
+    screen: { getAllDisplays: () => io.displays, getPrimaryDisplay: () => io.displays[0] }, powerMonitor: Object.assign(new EventEmitter(), { getSystemIdleState: () => 'active' }) }
+})
+import { ipcMain, powerMonitor } from 'electron'
+
+import { shouldPopInOnOverlayClosed } from './pet-overlay'
+import { registerPetOverlayIpc } from './pet-overlay-ipc'
+
+afterEach(() => { powerMonitor.removeAllListeners(); io.on.clear(); io.displays = []; io.writeText.mockReset() })
+
+it('only grants output focus to the current overlay document and releases it on document loss', () => {
+  const makeOverlay = () => {
+    let focused = false
+    const contents = Object.assign(new EventEmitter(), { mainFrame: {}, isDestroyed: () => false, send: vi.fn() })
+
+    return Object.assign(new EventEmitter(), {
+      webContents: contents, isDestroyed: () => false, isFocused: () => focused,
+      setFocusable: vi.fn(), focus: vi.fn(() => {focused = true}), blur: vi.fn(() => {focused = false})
+    })
+  }
+  const overlay = makeOverlay(), replacement = makeOverlay()
+  let current = overlay
+  registerPetOverlayIpc({ getMainWindow: () => null, getPetOverlayWindow: () => current as never,
+    openPetOverlay: vi.fn(), closePetOverlay: vi.fn() })
+  const setFocus = io.on.get('hermes:pet-overlay:set-focusable')!
+  const event = { sender: overlay.webContents, senderFrame: overlay.webContents.mainFrame }
+
+  setFocus({ ...event, sender: {} }, true)
+  setFocus({ ...event, senderFrame: {} }, true)
+  setFocus(event, 'true')
+  expect(overlay.setFocusable).not.toHaveBeenCalled()
+  setFocus(event, true)
+  setFocus(event, true)
+  expect(overlay.focus).toHaveBeenCalledOnce()
+  overlay.webContents.emit('render-process-gone')
+  expect(overlay.blur).toHaveBeenCalledOnce()
+  expect(overlay.setFocusable.mock.calls).toEqual([[true], [false]])
+  expect(overlay.webContents.listenerCount('did-start-loading')).toBe(0)
+
+  current = replacement
+  const next = { sender: replacement.webContents, senderFrame: replacement.webContents.mainFrame }
+  setFocus(event, true)
+  expect(replacement.setFocusable).not.toHaveBeenCalled()
+  setFocus(next, true)
+  replacement.blur()
+  setFocus(next, false)
