+export function OwnerInbox({ connection, bots, text }: {
+  connection: string | null
+  bots: InboxBot[]
+  text: Pick<BotsText, 'bot' | 'ownerInbox' | 'workspace'>
+}) {
+  const t = text.ownerInbox
