+    (home / "bot-status.json").write_text(json.dumps({"updated": time.time(), "bots": status}))
+    result = json.loads(registry.dispatch("kanban_reassign", {"task_id": tid, "profile": "crafter-media-gpt", "reason": "cross-role"}))
+    assert "paused" in result.get("error", ""), result
+    with connect() as conn:
+        assert kb.get_task(conn, tid).assignee == "reviewer-gpt"
