+"""Bare Hermes in a tool shell must use its owning checkout, not a stale PM venv CLI."""
+import os
+from pathlib import Path
+import subprocess
+
+import pytest
+
+from tools.environments import local
+
+pytestmark=pytest.mark.platforms('posix')
+
+
+@pytest.mark.parametrize('already_present',[False,True])
+def test_owned_source_launcher_wins_without_changing_other_toolchain(tmp_path,monkeypatch,already_present):
+    root=tmp_path/'source';module=root/'tools/environments/local.py';module.parent.mkdir(parents=True)
+    own=root/'.hermes/bin';own.mkdir(parents=True)
+    stale=tmp_path/'old-venv/bin';stale.mkdir(parents=True)
+    for directory,answer in [(own,'OWNING_SOURCE'),(stale,'STALE_RUNTIME')]:
+        script=directory/'hermes';script.write_text("#!/bin/sh\nprintf '%s\\n' "+answer+"\n");script.chmod(0o755)
+    other=stale/'other-tool';other.write_text("#!/bin/sh\nprintf '%s\\n' ORIGINAL_TOOLCHAIN\n");other.chmod(0o755)
+    monkeypatch.setattr(local,'__file__',str(module))
+    monkeypatch.setattr(local,'_HERMES_BIN_DIR',local._SENTINEL)
+    monkeypatch.setenv('PATH',os.pathsep.join([str(stale),*([str(own)] if already_present else []),'/usr/bin','/bin']))
+    from pm import environments
+    monkeypatch.setattr(environments,'payload_command_dir',lambda source:None)
+    child={**os.environ,'PATH':local._prepend_hermes_bin_dir(os.environ['PATH'])}
+    result=subprocess.run(['sh','-c','hermes; other-tool'],check=False, env=child,text=True,capture_output=True,timeout=10)
+    assert result.returncode==0 and result.stdout.splitlines()==['OWNING_SOURCE','ORIGINAL_TOOLCHAIN']
+    assert child['PATH'].split(os.pathsep).count(str(own))==1
+    assert local._prepend_hermes_bin_dir(child['PATH'])==child['PATH']
+
+
+def test_missing_owner_launcher_keeps_operator_cli_precedence(tmp_path,monkeypatch):
+    root=tmp_path/'source';module=root/'tools/environments/local.py';module.parent.mkdir(parents=True)
+    (root/'.hermes/bin').mkdir(parents=True)
