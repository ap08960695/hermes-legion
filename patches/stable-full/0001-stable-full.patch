+"""Explicit ref typing must never degrade to an uncontrolled focused target."""
+import json
+from types import SimpleNamespace
+
+import pytest
+
+
+@pytest.fixture
+def typed(monkeypatch):
+    from tools.computer_use import agent_desktop_backend as module
+    from tools.computer_use import tool
+    tool.reset_backend_for_tests()
+    calls = []
+    state = {'actions': ['TypeText']}
+    monkeypatch.setattr(module.driver, 'resolve_agent_desktop', lambda **k: '/fixture/agent-desktop')
+    monkeypatch.setattr(module.driver, '_environment', lambda: {'SAFE': 'yes'})
+    def probe(argv, **kwargs):
+        calls.append((argv, kwargs))
+        command = argv[1]
+        if command == 'snapshot':
+            data = {'app': 'Fixture', 'complete': True, 'snapshot_id': 'typing', 'ref_count': 2,
+                    'window': {'id': 'w-1', 'title': 'Fixture'}, 'tree': {
+                        'role': 'window', 'name': 'Fixture', 'children': [
+                            {'role': 'button', 'name': 'Activate', 'ref_id': '@typing:e1', 'available_actions': ['Click']},
+                            {'role': 'textfield', 'name': 'Input', 'ref_id': '@typing:e2', 'available_actions': state['actions']}]}}
+        else:
+            if 'failure' in state:
+                value = state['failure']
+                if isinstance(value, BaseException):
+                    raise value
+                return value
+            data = {'action': command, 'disposition': {'delivery': 'delivered_unverified', 'retry': 'unsafe'},
+                    'post_state': {'value': 'PRIVATE_NATIVE_OUTPUT'}}
+        return SimpleNamespace(returncode=0, stdout=json.dumps({'version': '2.6', 'ok': True, 'command': command, 'data': data}))
+    monkeypatch.setattr(module.driver, 'bounded_probe_run', probe)
+    backend = module.AgentDesktopBackend()
+    backend.start()
+    cap = backend.capture(mode='ax', app='Fixture')
+    yield module, backend, calls, state, cap
+    backend.stop()
+    tool.reset_backend_for_tests()
+
+
+@pytest.mark.parametrize('text', ['', 'private\n\r\nภาษาไทย\n', 'ก' * 3333 + 'a'], ids=['empty', 'multiline', 'utf8-byte-limit'])
+def test_ref_type_uses_exact_utf8_stdin_and_consumes_snapshot(typed, text):
+    _, backend, calls, _, cap = typed
+    result = backend.type_text(text, element=cap.elements[2].index)
+    assert result.ok and result.action == 'type_text' and result.verified is None
+    assert result.meta['recapture_required'] is True
+    assert 'PRIVATE_NATIVE_OUTPUT' not in str(result)
+    argv, kwargs = calls[-1]
+    assert argv[:3] == ['/fixture/agent-desktop', 'type', '@typing:e2']
+    assert argv[-3:] == ['--timeout-ms', '5000', '--stdin']
+    assert '--headed' not in argv and '--interval-ms' not in argv
