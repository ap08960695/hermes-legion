+"""Content reuse must follow the same runtime route boundary as auxiliary vision."""
+
+import asyncio
+import json
+from unittest.mock import AsyncMock
+
+import pytest
+from openai.types.chat import ChatCompletion
+from PIL import Image
+
+from agent.auxiliary_client import scoped_runtime_main
+from tools import vision_tools as vt
+from tools import vision_request_cache as cache
+from tools.registry import registry
+
+
+def response(text):
+    return ChatCompletion(
+        id="fixture", created=0, model="fixture-model", object="chat.completion",
+        choices=[{"index": 0, "finish_reason": "stop", "message": {
+            "role": "assistant", "content": text,
+        }}],
+    )
+
+
+@pytest.mark.parametrize("entrypoint", ["direct", "registered"])
+@pytest.mark.parametrize("binding", ["runtime", "saved"])
+@pytest.mark.parametrize("change", [
+    {"base_url": "https://second.invalid/v1"},
+    {"api_mode": "responses"},
+    {"auth_mode": "oauth"},
+])
+def test_changed_route_does_not_reuse_previous_analysis(tmp_path, monkeypatch, change, binding, entrypoint):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(vt, "_ANALYSIS_CACHE", type(vt._ANALYSIS_CACHE)())
+    monkeypatch.setattr(cache, "CACHE", cache.VisionCache())
+    monkeypatch.setattr(vt, "_should_use_native_vision_fast_path", lambda: False)
+    handler = next(e.handler for e in registry.get_all_entries() if e.name == "vision_analyze")
+    image = tmp_path / "image.png"
+    Image.new("RGB", (4, 4), (200, 30, 30)).save(image)
+    # Only the network boundary is replaced; image preparation, context propagation,
+    # response extraction and both cache lookup/store operations remain real.
+    llm = AsyncMock(side_effect=[response("first route"), response("second route")])
+    monkeypatch.setattr(vt, "async_call_llm", llm)
+    route = {"provider": "custom", "model": "fixture-model",
+             "base_url": "https://first.invalid/v1", "api_mode": "chat_completions", "auth_mode": "api_key"}
+
+    async def analyze(runtime):
+        if binding == "saved":
+            model = {**runtime, "default": runtime["model"]}
+            del model["model"]
+            (tmp_path / "config.yaml").write_text(json.dumps({"model": model}))
+        with scoped_runtime_main(runtime if binding == "runtime" else None):
+            if entrypoint == "direct":
+                result = await vt.vision_analyze_tool(str(image), "Describe the image")
+            else:
+                result = await handler({"image_url": str(image), "question": "Describe the image"},
+                                       task_id="fixture-task", session_id="fixture-session")
+            return json.loads(result)
+
+    first = asyncio.run(analyze(route))
+    changed = asyncio.run(analyze({**route, **change}))
+    repeated = asyncio.run(analyze({**route, **change}))
+    restored = asyncio.run(analyze(route))
+    assert first == {"success": True, "analysis": "first route"}
+    assert changed == {"success": True, "analysis": "second route"}
+    assert repeated["success"] is True and repeated["analysis"] == "second route"
+    assert restored["success"] is True and restored["analysis"] == "first route"
+    assert llm.await_count == 2
+
+
+@pytest.mark.parametrize("entrypoint", ["direct", "registered"])
+def test_concurrent_runtime_routes_keep_their_own_reused_results(tmp_path, monkeypatch, entrypoint):
+    from agent.auxiliary_client import _runtime_main_value
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(vt, "_ANALYSIS_CACHE", type(vt._ANALYSIS_CACHE)())
+    monkeypatch.setattr(cache, "CACHE", cache.VisionCache())
+    monkeypatch.setattr(vt, "_should_use_native_vision_fast_path", lambda: False)
+    image = tmp_path / "image.png"
+    Image.new("RGB", (4, 4), (200, 30, 30)).save(image)
+    handler = next(e.handler for e in registry.get_all_entries() if e.name == "vision_analyze")
+    calls = []
+
+    async def scenario():
+        both_entered = asyncio.Event()
+
+        async def complete(**kwargs):
+            route = _runtime_main_value("base_url")
+            calls.append(route)
+            if len(calls) == 2:
+                both_entered.set()
+            await asyncio.wait_for(both_entered.wait(), 3)
+            return response(route)
+
+        monkeypatch.setattr(vt, "async_call_llm", complete)
+
+        async def analyze(route):
+            with scoped_runtime_main({"provider": "custom", "model": "fixture-model", "base_url": route}):
+                if entrypoint == "direct":
+                    result = await vt.vision_analyze_tool(str(image), "Describe the image")
+                else:
+                    result = await handler({"image_url": str(image), "question": "Describe the image"},
+                                           task_id="fixture-task", session_id="fixture-session")
+                return json.loads(result)["analysis"]
+
+        routes = ["https://first.invalid/v1", "https://second.invalid/v1"]
+        assert await asyncio.gather(*(analyze(route) for route in routes)) == routes
+        assert await asyncio.gather(*(analyze(route) for route in routes)) == routes
+        assert sorted(calls) == routes
+
+    asyncio.run(scenario())
