+"""Compact status reads must not materialize a card's entire history."""
+import json
+import sqlite3
+
+import pytest
+
+
+@pytest.fixture
+def history_card(tmp_path, monkeypatch):
+    from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(tmp_path / "board.db"))
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    monkeypatch.delenv("HERMES_SESSION_ID", raising=False)
+    monkeypatch.setattr("tools.async_delegation._current_origin_session_id", lambda: None)
+    kb.init_db()
+    with kbc.connect() as conn:
+        task = kb.create_task(conn, title="History read budget", assignee="worker")
+        other = kb.create_task(conn, title="Another card", assignee="worker")
+        for number in range(90):
+            stamp = 2_000_000_000 + number // 3
+            kind = ("heartbeat" if number % 4 == 0 else "completed" if number % 7 == 0
+                    else "blocked" if number % 9 == 0 else "claimed")
+            conn.execute(
+                "INSERT INTO task_comments(task_id,author,body,created_at) VALUES(?,?,?,?)",
+                (task, "worker", f"note-{number:03d}:" + "x" * 4096, stamp),
+            )
+            conn.execute(
+                "INSERT INTO task_events(task_id,kind,payload,created_at) VALUES(?,?,?,?)",
+                (task, kind, json.dumps({"sequence": number}), stamp),
+            )
+            conn.execute(
+                "INSERT INTO task_runs(task_id,profile,status,started_at,ended_at,"
+                "outcome,summary,metadata) VALUES(?,?,?,?,?,?,?,?)",
+                (task, "worker", "done", stamp, stamp, "completed", f"run-{number:03d}",
+                 json.dumps({"artifact": f"artifact-{number:03d}", "audit": "x" * 4096})),
+            )
+        kb.add_comment(conn, other, "worker", "Other-card evidence must stay isolated")
+    return task
+
+
+@pytest.mark.parametrize("summary", [False, True])
+def test_compact_registry_read_has_a_history_row_budget(history_card, monkeypatch, summary):
+    from hermes_cli import kanban_db_connect as kbc
+    from tools import kanban_tools  # register the native tool
+    from tools.registry import registry
+
+    original = kbc.connect
+    materialized = []
+
+    def connect(*args, **kwargs):
+        conn = original(*args, **kwargs)
+
+        def row_factory(cursor, values):
+            names = {column[0] for column in cursor.description}
+            if {"task_id", "author", "body"} <= names or {"step_key", "metadata"} <= names or {"kind", "payload"} <= names:
+                materialized.append(1)
+            return sqlite3.Row(cursor, values)
+
+        conn.row_factory = row_factory
+        return conn
+
+    monkeypatch.setattr(kbc, "connect", connect)
+    result = json.loads(registry.dispatch("kanban_show", {"task_id": history_card, "summary": summary}))
+    assert "error" not in result
+    if summary:
+        assert result["runs"] == 90
+        assert [row["body"][:9] for row in result["last_comments"]] == ["note-087:", "note-088:", "note-089:"]
+        assert json.loads(result["last_failure"]["payload"])["sequence"] == 81
+        assert json.loads(result["last_completion"]["payload"])["sequence"] == 77
+    else:
+        assert result["compact_view"]["comments_total"] == 90
+        assert result["compact_view"]["runs_total"] == 90
+        assert [run["summary"] for run in result["runs"]] == ["run-087", "run-088", "run-089"]
+        assert result["comments"][0]["body"].startswith("note-078:")
+        assert "truncated" in result["comments"][0]["body"]
+        assert [row["payload"]["sequence"] for row in result["events"]] == [70, 71, 73, 74, 75, 77, 78, 79, 81, 82, 83, 85, 86, 87, 89]
+    assert len(materialized) <= 65, "Compact reads loaded historical rows that are never returned"
+
+
+def test_explicit_full_registry_read_preserves_old_evidence(history_card):
+    from tools import kanban_tools  # register the native tool
+    from tools.registry import registry
+
+    result = json.loads(registry.dispatch("kanban_show", {"task_id": history_card, "full": True}))
+    assert len(result["comments"]) == 90
+    assert len(result["runs"]) == 90
+    assert result["comments"][0]["body"] == "note-000:" + "x" * 4096
+    assert result["runs"][0]["metadata"]["artifact"] == "artifact-000"
+    assert result["worker_context"]
+
+
+def test_bounded_history_works_readonly_without_ending_an_outer_transaction(history_card):
+    from contextlib import closing
+    from hermes_cli import kanban_db as kb
+    from tools.kanban_show_read import show_payload
+
+    with closing(sqlite3.connect(kb.kanban_db_path().resolve().as_uri() + "?mode=ro", uri=True)) as conn:
+        conn.row_factory = sqlite3.Row
+        task = kb.get_task(conn, history_card)
+        result = show_payload(kb, conn, task, full=False, summary=False)
+        assert result["compact_view"]["comments_total"] == 90
+        assert not conn.in_transaction
+        conn.execute("BEGIN")
+        result = show_payload(kb, conn, task, full=False, summary=True)
+        assert result["runs"] == 90
+        assert conn.in_transaction
+        assert conn.total_changes == 0
+        conn.rollback()
