+"""A current owner's cap applies to a frozen session without rewriting its model or prompt."""
+import json
+from pathlib import Path
+
+import pytest
+
+
+@pytest.fixture(autouse=True)
+def offline(monkeypatch):
+    def refuse(*args, **kwargs):
+        raise AssertionError('offline owner-policy test attempted network access')
+    monkeypatch.setattr('socket.socket.connect', refuse)
+    monkeypatch.setattr('socket.socket.connect_ex', refuse)
+
+
+@pytest.mark.asyncio
+async def test_current_owner_ceiling_bounds_saved_reasoning_and_the_next_turn(tmp_path, monkeypatch):
+    from gateway import run
+    from gateway.session_policy import policy_for_source, policy_scope
+    from agent.reasoning_limits import current_reasoning_limits, limit_wire_request
+    from tests.gateway.test_session_policy_verbs import _owner, _mutation
+
+    store, db, authority, owner, ref = _owner(tmp_path, monkeypatch, None)
+    authority.runner.session_authority = authority
+    calls = []
+
+    def current_profile(path):
+        assert Path(path).parent == Path(db.db_path).parent
+        calls.append(path)
+        return {'model': {'default': 'different-new-default'},
+                'agent': {'reasoning_effort_limits': {'frozen': 'high'}}}
+
+    monkeypatch.setattr(run, '_load_gateway_config', current_profile)
+    try:
+        before = db.get_session(ref.session_id)
+        response = await owner.dispatch(_mutation(db, ref, 'bounded-edit', 'reasoning', {'effort': 'max'}))
+        assert 'result' in response, response
+        info = await owner.dispatch({'id': 2, 'method': 'session.info', 'params': {'session_id': ref.session_id}})
+        assert info['result']['reasoning_effort'] == 'high'
+        policy = policy_for_source(authority.runner, authority.sessions[ref.session_id].source)
+        with policy_scope(policy, authority=authority):
+            request = limit_wire_request({'reasoning': {'effort': 'max'}},
+                                         current_reasoning_limits({}), 'frozen', 'codex_responses')
+            assert request['reasoning']['effort'] == 'high'
+        assert current_reasoning_limits({}) == {}
+        assert calls
+        after = db.get_session(ref.session_id)
+        assert after['model'] == before['model'] == 'frozen'
+        assert after['system_prompt'] == before['system_prompt']
+        assert json.loads(policy.config_json)['agent']['reasoning_effort'] == 'max'
+    finally:
+        await owner.close()
+        store.close_all_db_handles()
