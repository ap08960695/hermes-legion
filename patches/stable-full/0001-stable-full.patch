+    ("gpt-5.5", "max", "xhigh"),
+    ("gpt-6.1-sol", "max", "max"),
+])
+def test_sibling_depth_contracts(model, effort, expected):
+    request = ResponsesApiTransport().build_kwargs(
+        model=model,
+        messages=[{"role": "user", "content": "Check a synthetic result."}],
+        tools=[],
+        provider="openai-codex",
+        base_url="https://chatgpt.com/backend-api/codex",
+        reasoning_config={"enabled": effort != "none", "effort": effort},
+    )
+    assert request["reasoning"]["effort"] == expected
diff --git a/tests/agent/test_token_memo_memory_bound.py b/tests/agent/test_token_memo_memory_bound.py
new file mode 100644
index 0000000000000000000000000000000000000000..d184167fd63303cee13954e4a2993c2d83da77d8
--- /dev/null
+++ b/tests/agent/test_token_memo_memory_bound.py
@@ -0,0 +1,85 @@
+"""Long message bodies must not remain pinned without a byte bound."""
+
+import sys
+
+import pytest
+
+from agent import model_metadata as metadata
+
+
+@pytest.fixture(autouse=True)
+def empty_memo():
+    metadata._MSG_TOKENS_CACHE.clear()
+    yield
+    metadata._MSG_TOKENS_CACHE.clear()
+
+
+def _pinned_bytes():
+    pins = {id(pin): pin for values, _, _ in metadata._MSG_TOKENS_CACHE.values() for pin in values}
+    return sum(sys.getsizeof(pin) for pin in pins.values())
+
+
+def test_rotating_large_messages_release_old_pins_without_changing_estimates():
+    for index in range(80):
+        message = {"role": "tool", "content": str(index) + "x" * (512 * 1024)}
+        expected = metadata._estimate_message_tokens_without_images(message)
+        assert metadata.estimate_messages_tokens_rough([message]) == expected
+    assert 0 < _pinned_bytes() <= 32 * 1024 * 1024
+    # A repeated estimate retains the same numeric result.
+    assert metadata.estimate_messages_tokens_rough([message]) == expected
+
+
+def test_oversized_message_does_not_displace_or_pin_other_messages():
+    small = {"role": "user", "content": "retained ordinary message " * 200}
+    metadata.estimate_messages_tokens_rough([small])
+    before = list(metadata._MSG_TOKENS_CACHE.items())
+    large = {"role": "tool", "content": "x" * (33 * 1024 * 1024)}
+    expected = metadata._estimate_message_tokens_without_images(large)
+    assert metadata.estimate_messages_tokens_rough([large]) == expected
+    assert list(metadata._MSG_TOKENS_CACHE.items()) == before
+
+
+def test_memo_reuses_estimates_and_releases_capacity(monkeypatch):
+    from agent.model_metadata_token_memo import MessageTokenMemo, forget_message_token_memo
+
+    memo = MessageTokenMemo(max_bytes=24 * 1024, max_entries=2)
+    monkeypatch.setattr(metadata, "_MSG_TOKENS_CACHE", memo)
+    original = metadata._estimate_message_tokens_without_images
+    calls = []
+
+    def compute(message):
+        calls.append(message["content"])
+        return original(message)
+
+    monkeypatch.setattr(metadata, "_estimate_message_tokens_without_images", compute)
+    first = {"role": "user", "content": "first " + "x" * 9000}
+    second = {"role": "user", "content": "second " + "x" * 9000}
+    third = {"role": "user", "content": "third " + "x" * 9000}
+    first_tokens = metadata.estimate_messages_tokens_rough([first])
+    assert metadata.estimate_messages_tokens_rough([dict(first)]) == first_tokens
+    assert len(calls) == 1
+    metadata.estimate_messages_tokens_rough([second, third])
+    assert len(memo) == 2
+    assert metadata.estimate_messages_tokens_rough([first]) == first_tokens
+    assert len(calls) == 4  # FIFO evicted first, so it was computed again.
+    assert forget_message_token_memo([first]) == 1
+    memo.clear()
+    metadata.estimate_messages_tokens_rough([first, second])
+    assert len(memo) == 2
+
+
+def test_wide_unicode_is_charged_in_bytes_and_shared_pins_are_counted_once(monkeypatch):
+    from agent.model_metadata_token_memo import MessageTokenMemo
+
+    memo = MessageTokenMemo(max_bytes=16 * 1024)
+    monkeypatch.setattr(metadata, "_MSG_TOKENS_CACHE", memo)
+    shared = "z" * 9000
+    message = {"role": "assistant", "content": shared, "reasoning_content": shared}
+    expected = metadata._estimate_message_tokens_without_images(message)
+    assert metadata.estimate_messages_tokens_rough([message]) == expected
+    assert len(memo) == 1  # One string referenced twice still fits.
+    wide = {"role": "user", "content": "😀" * 5000}
+    expected = metadata._estimate_message_tokens_without_images(wide)
+    assert metadata.estimate_messages_tokens_rough([wide]) == expected
+    assert len(memo) == 1
+    assert any(pin is shared for pins, _, _ in memo.values() for pin in pins)
