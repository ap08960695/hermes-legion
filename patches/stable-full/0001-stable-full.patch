+.hermes-focus-frame {
+  display: flex;
+  flex: 1;
+  min-height: 0;
+  min-width: 0;
+  background: var(--ui-chat-surface-background);
+}
+.hermes-focus-rail {
+  display: flex;
+  flex-direction: column;
+  flex-shrink: 0;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  width: 68px;
+  padding: 16px 8px 12px;
+  gap: 16px;
+  border-inline-end: 1px solid var(--ui-stroke-secondary);
+  background: var(--ui-bg-chrome);
+}
+.hermes-focus-brand {
+  flex-shrink: 0;
+  height: 44px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+  color: var(--ui-text-primary);
+}
+.hermes-focus-brand > span {
+  font-size: 21px;
+  font-weight: 600;
+}
+.hermes-focus-brand > strong {
+  display: none;
+  font-size: 14px;
+}
+.hermes-focus-primary,
+.hermes-focus-utilities {
+  flex-shrink: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+.hermes-focus-utilities {
+  margin-top: auto;
+}
+.hermes-focus-rail .hermes-focus-nav {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+  min-height: 48px;
+  width: 100%;
+  padding: 8px 4px;
+  border-radius: 10px;
+  white-space: normal;
+  transition:
+    background-color 150ms,
+    color 150ms,
+    transform 150ms;
+}
+.hermes-focus-nav > .codicon {
+  font-size: 18px;
+}
+.hermes-focus-nav > span:not(.codicon) {
+  font-size: 10px;
+  line-height: 1.2;
+  overflow-wrap: anywhere;
+}
+.hermes-focus-nav[aria-current='page'] {
+  background: var(--ui-bg-quaternary);
+  color: var(--ui-text-primary);
+}
+.hermes-focus-nav:active {
+  transform: scale(0.97);
+}
+.hermes-focus-content {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+  overflow: hidden;
+}
+[data-presentation='workspace'] > .hermes-focus-rail {
+  width: 146px;
+}
+[data-presentation='workspace'] .hermes-focus-brand > strong {
+  display: block;
+}
+[data-presentation='workspace'] .hermes-focus-nav {
+  flex-direction: row;
+  justify-content: flex-start;
+  gap: 10px;
+  padding-inline: 12px;
+  min-height: 40px;
+}
+[data-presentation='workspace'] .hermes-focus-nav > span:not(.codicon) {
+  font-size: 12px;
+}
+.hermes-focus-features {
+  display: flex;
+  flex-direction: column;
+  gap: 18px;
+}
+.hermes-focus-features h3 {
+  margin-block-end: 8px;
+  color: var(--ui-text-tertiary);
+  font-size: 11px;
+}
+.hermes-focus-feature-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 6px;
+}
+.hermes-focus-feature-grid > button {
+  justify-content: flex-start;
+  min-height: 38px;
+  white-space: normal;
+  text-align: start;
+  overflow-wrap: anywhere;
+}
+.hermes-focus-work {
+  display: grid;
+  gap: 16px;
+}
+.hermes-focus-work article {
+  padding: 12px;
+  border: 1px solid var(--ui-stroke-secondary);
+  border-radius: 10px;
+  overflow-wrap: anywhere;
+}
+.hermes-focus-work h3 {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-block-end: 8px;
+  font-size: 13px;
+  font-weight: 500;
+}
+.hermes-focus-work p {
+  font-size: 12px;
+  color: var(--ui-text-secondary);
+  white-space: pre-wrap;
+}
+@media (max-width: 640px) {
+  .hermes-focus-frame {
+    flex-direction: column;
+  }
+  .hermes-focus-frame > .hermes-focus-rail {
+    order: 2;
+    width: 100%;
+    flex-direction: row;
+    padding: 4px;
+    gap: 4px;
+    border-inline-end: 0;
+    border-block-start: 1px solid var(--ui-stroke-secondary);
+  }
+  .hermes-focus-brand {
+    display: none;
+  }
