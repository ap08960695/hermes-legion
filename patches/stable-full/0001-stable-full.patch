@@ -0,0 +1,90 @@
+"""Scheduled and revision handoffs end the owned attempt without extra inference."""
+import json
+import os
+from unittest.mock import patch
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_dispatch as dispatch
+from tests.agent import test_kanban_terminal_stop as terminal
+
+agent = terminal.agent
+
+
+@pytest.fixture
+def handoff_run(tmp_path, monkeypatch, handoff):
+    path = tmp_path / "board.db"
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(path))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    monkeypatch.delenv("HERMES_DELEGATED_CHILD_CONTEXT", raising=False)
+    kb.init_db(path)
+    conn = kbc.connect(path)
+    tid = kb.create_task(conn, title="Offline handoff fixture", body="synthetic", assignee="builder")
+    claim = kb.claim_task(conn, tid)
+    if handoff == "kanban_request_changes":
+        assert kb.request_review(conn, tid, summary="Ready for review", reviewer="reviewer", expected_run_id=claim.current_run_id)
+        claim = kb.claim_review_task(conn, tid, claimer="reviewer:fixture")
+    dispatch._set_worker_pid(conn, tid, os.getpid())
+    for key, value in {"HERMES_KANBAN_TASK": tid, "HERMES_KANBAN_RUN_ID": str(claim.current_run_id),
+                       "HERMES_KANBAN_CLAIM_LOCK": claim.claim_lock}.items():
+        monkeypatch.setenv(key, value)
+    yield conn, tid, claim.current_run_id
+    conn.close()
+
+
+@pytest.mark.parametrize("handoff,phase,outcome", [
+    ("kanban_schedule", "scheduled", "scheduled"),
+    ("kanban_request_changes", "ready", "changes_requested"),
+])
+@pytest.mark.parametrize("max_iterations", [4, 1])
+def test_handoff_preserves_landing_and_reason_without_another_call(agent, handoff_run, handoff, phase, outcome, max_iterations):
+    from tools.registry import registry
+    import tools.kanban_tools
+
+    conn, tid, run = handoff_run
+    reason = "Synthetic handoff checkpoint"
+    agent.max_iterations = max_iterations
+    agent.valid_tool_names = {handoff}
+    agent.client.chat.completions.create.side_effect = [
+        terminal.call(handoff, {"task_id": tid, "reason": reason}, "handoff"),
+        terminal._mock_response(content="Unnecessary acknowledgement", finish_reason="stop"),
+    ]
+
+    def tool(name, args, *unused, **kwargs):
+        return registry.dispatch(name, args if isinstance(args, dict) else json.loads(args))
+
+    with patch.object(agent, "_persist_session"), patch.object(agent, "_save_trajectory"), \
+         patch.object(agent, "_cleanup_task_resources"), patch("model_tools.handle_function_call", side_effect=tool):
+        result = agent.run_conversation("Hand off this owned synthetic card.")
+
+    task = kb.get_task(conn, tid)
+    assert task.status == phase and task.assignee == "builder"
+    assert kb.get_run(conn, run).outcome == outcome
+    assert task.consecutive_failures == 0
+    assert agent.client.chat.completions.create.call_count == 1
+    assert result["final_response"] == reason
+    assert result["turn_exit_reason"] == "kanban_task_" + outcome
+    assert result["completed"] is True and result["failed"] is False
+    assert not conn.execute("SELECT 1 FROM task_events WHERE task_id=? AND kind IN ('completed','timed_out','gave_up')", (tid,)).fetchone()
+
+
+@pytest.mark.parametrize("handoff", ["kanban_schedule", "kanban_request_changes"])
+@pytest.mark.parametrize("proof", ["running", "foreign_lock", "foreign_pid", "wrong_result"])
+def test_uncertain_schedule_or_revision_never_stops(handoff_run, monkeypatch, handoff, proof):
+    from agent.kanban_terminal_stop import verified_worker_handoff
+    from tools.registry import registry
+    import tools.kanban_tools
+
+    conn, tid, run = handoff_run
+    message = {"role": "tool", "name": handoff, "content": json.dumps({"ok": True, "task_id": tid, "run_id": run})}
+    if proof != "running":
+        response = json.loads(registry.dispatch(handoff, {"task_id": tid, "reason": "Synthetic checkpoint"}))
+        assert response["ok"] is True
+    if proof == "foreign_lock":
+        monkeypatch.setenv("HERMES_KANBAN_CLAIM_LOCK", "foreign")
+    elif proof == "foreign_pid":
+        with kb.write_txn(conn):
