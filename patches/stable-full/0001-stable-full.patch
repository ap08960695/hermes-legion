+// @vitest-environment jsdom
+import { AssistantRuntimeProvider, type ThreadMessageLike, useExternalStoreRuntime } from '@assistant-ui/react'
+import { useStore } from '@nanostores/react'
+import { act, cleanup, fireEvent, render } from '@testing-library/react'
+import { MemoryRouter } from 'react-router'
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { I18nProvider } from '@/i18n'
+import { clearSessionDraft, stashSessionDraft, takeSessionDraft } from '@/store/composer'
+import { sessionDraftOwner } from '@/store/session-draft-owner'
+import { $sessionTiles, patchSessionTile, resetTileRuntimeBindings } from '@/store/session-states'
+
+import { FloatingComposerSurface } from './floating-surface'
+import { ChatBar } from './index'
+import { useSplitReconnectFocus } from './reconnect-focus'
+import { ComposerScopeProvider, ComposerSurfaceProvider, MAIN_COMPOSER_SCOPE } from './scope'
+
+const draftKey = 'ime-frame-draft'
+const otherKey = 'ime-other-draft'
+
+function Harness({ scope = draftKey, runtimeId = scope }: { scope?: string; runtimeId?: string }) {
+  const runtime = useExternalStoreRuntime({
+    convertMessage: (message: ThreadMessageLike) => message,
+    isRunning: false,
+    messages: [] as ThreadMessageLike[],
+    onNew: async () => {}
+  })
+
+  return (
+    <AssistantRuntimeProvider runtime={runtime}>
+      <MemoryRouter>
+        <I18nProvider configClient={null} initialLocale="en">
+          <ChatBar
+            busy={false}
+            disabled={false}
+            focusKey={runtimeId}
+            gateway={null}
+            onCancel={() => {}}
+            onSubmit={async () => true}
+            queueSessionKey={scope}
+            sessionId={runtimeId}
+            state={{
+              model: { canSwitch: false, model: '', provider: '' },
+              tools: { enabled: false, label: '' },
+              voice: { enabled: false, active: false }
+            }}
+          />
+        </I18nProvider>
+      </MemoryRouter>
+    </AssistantRuntimeProvider>
+  )
+}
+
+afterEach(() => {
+  cleanup()
+  vi.useRealTimers()
+  act(() => {
+    clearSessionDraft(draftKey, sessionDraftOwner(draftKey))
+    clearSessionDraft(otherKey, sessionDraftOwner(otherKey))
+  })
+})
+
+it.each(['日本', ''])('keeps preedit out of a queued input flush (settled text: %j)', async settled => {
+  vi.useFakeTimers({ toFake: ['requestAnimationFrame', 'cancelAnimationFrame'] })
+  const { getByRole } = render(<Harness />)
+  const editor = getByRole('textbox', { name: 'Message' })
+  await act(async () => editor.focus())
+  editor.textContent = 'a'
+  fireEvent.input(editor)
+  fireEvent.compositionStart(editor)
+  editor.textContent = 'aにほ'
+  const preedit = editor.firstChild
+  fireEvent.input(editor, { isComposing: true, inputType: 'insertCompositionText' })
+
+  act(() => vi.advanceTimersToNextFrame())
+  fireEvent(window, new Event('pagehide'))
+
+  expect(editor.firstChild).toBe(preedit)
+  expect(editor.textContent).toBe('aにほ')
+  expect(takeSessionDraft(draftKey, sessionDraftOwner(draftKey)).text).toBe('a')
+
+  editor.textContent = 'a' + settled
+  fireEvent.compositionEnd(editor, { data: settled })
+  fireEvent(window, new Event('pagehide'))
+  expect(takeSessionDraft(draftKey, sessionDraftOwner(draftKey)).text).toBe('a' + settled)
+})
+
+it.each([false, true])('saves the first ordinary input after a draft swap interrupts IME (return: %s)', async returnToDraft => {
+  vi.useFakeTimers({ toFake: ['requestAnimationFrame', 'cancelAnimationFrame'] })
+  const owner = sessionDraftOwner(draftKey)
+  stashSessionDraft(draftKey, 'Draft', [], owner)
+  stashSessionDraft(otherKey, 'Other', [], owner)
+  const { getByRole, rerender } = render(<Harness />)
+  const editor = getByRole('textbox', { name: 'Message' })
+  await act(async () => editor.focus())
+
+  fireEvent.compositionStart(editor)
+  editor.textContent = 'Drにほaft'
+  fireEvent.input(editor, { isComposing: true, inputType: 'insertCompositionText' })
+
+  await act(async () => rerender(<Harness scope={otherKey} />))
+  expect(editor.textContent).toBe('Other')
+  expect(takeSessionDraft(draftKey, owner).text).toBe('Draft')
+  if (returnToDraft) await act(async () => rerender(<Harness scope={draftKey} />))
+
+  // Replacing the composing DOM can leave no compositionend or keydown event.
+  const key = returnToDraft ? draftKey : otherKey
+  const next = (returnToDraft ? 'Draft' : 'Other') + 'Z'
+  editor.textContent = next
+  fireEvent.input(editor, { data: 'Z', isComposing: false, inputType: 'insertText' })
+  act(() => vi.advanceTimersToNextFrame())
+  fireEvent(window, new Event('pagehide'))
+
+  expect(takeSessionDraft(key, owner).text).toBe(next)
+  expect(takeSessionDraft(returnToDraft ? otherKey : draftKey, owner).text).toBe(returnToDraft ? 'Other' : 'Draft')
+})
+
+const splitOwner = { connectionId: 'local', mode: 'local' as const, profile: 'research' }
+const splitTarget = `tile:${draftKey}` as const
+
+function Split() {
+  const tile = useStore($sessionTiles)[0]
+  useSplitReconnectFocus(draftKey)
+
+  if (!tile?.runtimeId) return null
+
+  return (
+    <ComposerScopeProvider value={{ ...MAIN_COMPOSER_SCOPE, ownerRoute: splitOwner, target: splitTarget, localReconnect: Boolean(tile.localReconnect) }}>
+      <ComposerSurfaceProvider value={tile.runtimeId}>
+        <div data-chat-surface="" data-composer-target={splitTarget}>
+          <FloatingComposerSurface>
+            <Harness runtimeId={tile.runtimeId} />
+          </FloatingComposerSurface>
+        </div>
+      </ComposerSurfaceProvider>
+    </ComposerScopeProvider>
+  )
+}
+
+it.each([
+  { name: 'caret', start: [3, 3], expected: [3, 3] },
+  { name: 'backward selection', start: [8, 0], expected: [8, 0] },
+  { name: 'settled composition', start: [3, 3], expected: [12, 12] }
+])('restores the committed $name after Local reconnect', async ({ name, start, expected }) => {
+  vi.spyOn(document, 'hasFocus').mockReturnValue(true)
+  $sessionTiles.set([{ storedSessionId: draftKey, runtimeId: 'ime-before', ownerRoute: splitOwner }])
+  stashSessionDraft(draftKey, 'Research draft', [], splitOwner)
+
+  try {
+    const { getByRole } = render(<Split />)
+    const editor = getByRole('textbox', { name: 'Message' })
+    await act(async () => editor.focus())
+    const selection = window.getSelection()!
+    selection.setBaseAndExtent(editor.firstChild!, start[0], editor.firstChild!, start[1])
+    fireEvent.compositionStart(editor)
+    editor.textContent = 'にほ draft'
+    fireEvent.input(editor, { isComposing: true, inputType: 'insertCompositionText' })
+
+    if (name === 'settled composition') {
+      editor.textContent = 'Research draft'
+      selection.collapse(editor.firstChild!, 12)
+      fireEvent.compositionEnd(editor, { data: '' })
+    }
+
+    await act(async () => resetTileRuntimeBindings('local', true))
+    expect(editor.isConnected).toBe(false)
+    expect(takeSessionDraft(draftKey, splitOwner).text).toBe('Research draft')
+    await act(async () => patchSessionTile(draftKey, { runtimeId: 'ime-after' }))
+
+    const restored = getByRole('textbox', { name: 'Message' })
+    expect(restored.textContent).toBe('Research draft')
+    expect(document.activeElement).toBe(restored)
+    expect([selection.anchorOffset, selection.focusOffset]).toEqual(expected)
+  } finally {
+    cleanup()
+    $sessionTiles.set([])
+    clearSessionDraft(draftKey, splitOwner)
+    vi.restoreAllMocks()
+  }
+})
+
+it.each([
+  { name: 'before a chip', anchor: 1, focus: 1, expected: '\nX@file:`notes.md`\nReview\n' },
+  { name: 'over a backward chip selection', anchor: 2, focus: 1, expected: '\nX\nReview\n' },
+  { name: 'after the last break', anchor: 5, focus: 5, expected: '\n@file:`notes.md`\nReview\nX' }
+])('inserts plain text at the selected line $name', async ({ anchor, focus, expected }) => {
+  vi.useFakeTimers({ toFake: ['requestAnimationFrame', 'cancelAnimationFrame'] })
+  const owner = sessionDraftOwner(draftKey)
+  const original = '\n@file:`notes.md`\nReview\n'
+  stashSessionDraft(draftKey, original, [], owner)
+  const { getByRole } = render(<Harness />)
+  const editor = getByRole('textbox', { name: 'Message' })
+  await act(async () => editor.focus())
+  window.getSelection()?.setBaseAndExtent(editor, anchor, editor, focus)
+
+  const input = new InputEvent('beforeinput', { bubbles: true, cancelable: true, data: 'X', inputType: 'insertText' })
+  Object.defineProperty(input, 'getTargetRanges', {
+    value: () => [new StaticRange({
+      startContainer: editor,
+      startOffset: Math.min(anchor, focus) - 1,
+      endContainer: editor,
+      endOffset: Math.max(anchor, focus)
+    })]
+  })
+  fireEvent(editor, input)
+  act(() => vi.advanceTimersToNextFrame())
+  fireEvent(window, new Event('pagehide'))
+
+  expect(input.defaultPrevented).toBe(true)
+  expect(takeSessionDraft(draftKey, owner).text).toBe(expected)
+
+  fireEvent(editor, new InputEvent('beforeinput', { bubbles: true, cancelable: true, inputType: 'historyUndo' }))
+  fireEvent(window, new Event('pagehide'))
+  expect(takeSessionDraft(draftKey, owner).text).toBe(original)
+})
+
+it.each([
+  { name: 'leading commit', after: 1, data: '日本', expected: '\n日本@file:`notes.md`\nReview\n' },
+  { name: 'trailing commit', after: 5, data: '日本', expected: '\n@file:`notes.md`\nReview\n日本' },
+  { name: 'cancel', after: 1, data: '', expected: '\n@file:`notes.md`\nReview\n' },
+  { name: 'draft change', after: 1, data: '日本', expected: 'Other draft' }
+])('settles IME after Chromium crosses a line break ($name)', async ({ name, after, data, expected }) => {
+  const owner = sessionDraftOwner(draftKey)
+  const original = '\n@file:`notes.md`\nReview\n'
+  stashSessionDraft(draftKey, original, [], owner)
+  stashSessionDraft(otherKey, 'Other draft', [], owner)
+  const { getByRole, rerender } = render(<Harness />)
+  const editor = getByRole('textbox', { name: 'Message' })
+  await act(async () => editor.focus())
+  window.getSelection()?.collapse(editor, after)
+  fireEvent.compositionStart(editor)
+
+  const input = new InputEvent('beforeinput', {
+    bubbles: true, cancelable: false, data: 'にほ', inputType: 'insertCompositionText', isComposing: true
+  })
+  Object.defineProperty(input, 'getTargetRanges', {
+    value: () => [new StaticRange({
+      startContainer: editor, startOffset: after - 1, endContainer: editor, endOffset: after - 1
+    })]
+  })
+  fireEvent(editor, input)
+  expect(input.defaultPrevented).toBe(false)
+  expect(takeSessionDraft(draftKey, owner).text).toBe(original)
+
+  editor.prepend('に')
+  fireEvent.input(editor, { isComposing: true, inputType: 'insertCompositionText' })
+  if (name === 'draft change') await act(async () => rerender(<Harness scope={otherKey} />))
+  fireEvent.compositionEnd(editor, { data })
+  fireEvent(window, new Event('pagehide'))
+
+  const key = name === 'draft change' ? otherKey : draftKey
+  expect(takeSessionDraft(key, owner).text).toBe(expected)
+})
+
+it.each(['blur', 'malformed completion', 'ordinary input', 'Enter'] as const)(
