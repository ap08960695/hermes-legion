@@ -0,0 +1,64 @@
+"""Unlock ordering is advisory inside priority, never bypasses native claims/caps."""
+import time
+from pathlib import Path
+import pytest
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli.kanban_task_contract import lane_rows
+
+
+@pytest.fixture
+def board(tmp_path,monkeypatch):
+    monkeypatch.setattr(Path,'home',lambda:tmp_path)
+    monkeypatch.setenv('HERMES_HOME',str(tmp_path/'.hermes'))
+    monkeypatch.setenv('HERMES_KANBAN_HOME',str(tmp_path/'.hermes'))
+    with kbc.connect_closing() as c:yield c
+
+
+def make(c,**kw):return kb.create_task(c,title='fixture',assignee='default',**kw)
+
+
+def test_unlock_ready_children_breaks_fifo_tie_without_mutations(board):
+    c=board;first=make(c);gate=make(c)
+    c.execute('UPDATE tasks SET created_at=? WHERE id=?',(int(time.time())-60,first));c.commit()
+    children=[make(c,parents=[gate]) for _ in range(3)]
+    assert [r['id'] for r in lane_rows(c,'ready')][:2]==[gate,first]
+    assert all(kb.get_task(c,x).status=='todo' for x in children)
+    assert kb.get_task(c,gate).claim_lock is None
+
+
+def test_priority_aging_and_other_parent_gates_remain(board):
+    c=board;old=make(c);urgent=make(c,priority=10);gate=make(c);hold=make(c)
+    kb.block_task(c,hold,reason='owner hold')
+    for _ in range(3):make(c,parents=[gate,hold])
+    c.execute('UPDATE tasks SET created_at=? WHERE id=?',(int(time.time())-3600,old));c.commit()
+    rows=lane_rows(c,'ready');assert rows[0]['id']==urgent and rows[1]['id']==old
+    assert kb.get_task(c,hold).status=='blocked'
+
+
+def test_positive_unlock_score_cannot_overtake_priority_or_aged_work(board):
+    c=board;old=make(c);urgent=make(c,priority=4);gate=make(c)
+    make(c,parents=[gate]);make(c,parents=[gate])
+    c.execute('UPDATE tasks SET created_at=? WHERE id=?',(int(time.time())-3600,old));c.commit()
+    assert [r['id'] for r in lane_rows(c,'ready')][:3]==[urgent,old,gate]
+
+
+def test_held_children_and_claimed_rows_never_gain_rank(board):
+    c=board;first=make(c);gate=make(c);claimed=make(c)
+    c.execute('UPDATE tasks SET created_at=? WHERE id=?',(int(time.time())-30,first))
+    c.execute("UPDATE tasks SET claim_lock='foreign-owner' WHERE id=?",(claimed,));c.commit()
+    held=make(c,parents=[gate],initial_status='blocked');assert kb.get_task(c,held).status=='blocked'
+    other=make(c);kb.block_task(c,other,reason='hold')
+    make(c,parents=[gate,other])
+    assert [r['id'] for r in lane_rows(c,'ready')]==[first,gate]
+    assert kb.get_task(c,claimed).claim_lock=='foreign-owner'
+
+
+def test_native_dispatch_honors_one_slot_and_preserves_waiting_work(board):
+    from hermes_cli import kanban_db_dispatch as dispatch
+    c=board;first=make(c);gate=make(c);make(c,parents=[gate])
+    c.execute('UPDATE tasks SET created_at=? WHERE id=?',(int(time.time())-30,first));c.commit()
+    launches=[]
+    def spawn(task,workspace,board=None):launches.append(task.id)
+    dispatch.dispatch_once(c,spawn_fn=spawn,max_spawn=1,max_in_progress=1,max_in_progress_per_profile=1,reconcile_orphans=False)
+    assert launches==[gate]
+    assert kb.get_task(c,first).status=='ready'
diff --git a/tests/hermes_cli/test_kanban_role_flow.py b/tests/hermes_cli/test_kanban_role_flow.py
