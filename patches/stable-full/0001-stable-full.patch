+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { useRef, useState } from 'react'
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { clearSessionDraft, ownedDraftScopes, stashSessionDraft, takeSessionDraft } from '@/store/composer'
+import { ownedDraftKey, readOwnedDraftValue } from '@/store/composer-draft-owner'
+import { readDraftRetry } from '@/store/composer-draft-retry'
+import { $perSessionBrowse, browseBackward, browseForward } from '@/store/composer-input-history'
+import { retainedRejectedDrafts, retainRejectedDraft } from '@/store/composer-rejected-drafts'
+
+import { ComposerDraftRecovery } from './draft-recovery'
+import { RetainedSendNotice } from './retained-send-notice'
+
+const owner = { connectionId: 'retained-notice', profile: 'work' }
+const scope = 'retained-notice-session'
+
+function Harness({ occupied = false, draftOwner = owner }: { occupied?: boolean; draftOwner?: typeof owner }) {
+  const [restored, setRestored] = useState('')
+  const editor = useRef<HTMLTextAreaElement>(null)
+
+  return (
+    <>
+      <RetainedSendNotice
+        readCurrent={() => ({ text: restored || (occupied ? 'Current input' : ''), attachments: [] })}
+        occupied={occupied || Boolean(restored)}
+        onFocusComposer={() => editor.current?.focus()}
+        onRestored={text => setRestored(text)}
+        owner={draftOwner}
+        scope={scope}
+      />
+      <output>{restored}</output>
+      <textarea aria-label="Message" defaultValue={occupied ? 'Current input' : ''} ref={editor} />
+    </>
+  )
+}
+
+afterEach(() => {
+  cleanup()
+  vi.restoreAllMocks()
+
+  for (const row of ownedDraftScopes()) {
+    clearSessionDraft(row.scope, row.owner)
+  }
+
+  window.localStorage.clear()
+  $perSessionBrowse.set({})
+})
+
+it('keeps saved input separate until an explicit restore into an empty editor', () => {
+  retainRejectedDraft(scope, 'Earlier input', [], owner, 'retained-id')
+  const { container } = render(<Harness />)
+  expect(takeSessionDraft(scope, owner).text).toBe('')
+  fireEvent.click(container.querySelector('summary')!)
+  fireEvent.click(screen.getByRole('button', { name: 'Restore message' }))
+  expect(container.querySelector('output')?.textContent).toBe('Earlier input')
+  expect(takeSessionDraft(scope, owner).text).toBe('Earlier input')
+  expect(readDraftRetry(scope, owner)?.id).toBe('retained-id')
+  expect(retainedRejectedDrafts(scope, owner)).toEqual([])
+})
+
+it('parks live input, restores the earlier text, and returns without crossing owners', () => {
+  stashSessionDraft(scope, 'Current input', [], owner)
+  retainRejectedDraft(scope, 'Earlier input', [], owner, 'retained-id')
+  retainRejectedDraft(scope, 'Other owner private input', [], { ...owner, profile: 'other' }, 'other-id')
+  const { container } = render(<Harness occupied />)
+  fireEvent.click(container.querySelector('summary')!)
+  expect(container.textContent).not.toContain('Other owner private input')
+  fireEvent.click(screen.getByRole('button', { name: 'Park draft and edit failed message' }))
+  expect(container.querySelector('output')?.textContent).toBe('Earlier input')
+  expect(readDraftRetry(scope, owner)?.id).toBe('retained-id')
+  expect(retainedRejectedDrafts(scope, owner).map(row => row.text)).toEqual(['Current input'])
+
+  fireEvent.click(screen.getByRole('button', { name: 'Return to parked draft' }))
+  expect(container.querySelector('output')?.textContent).toBe('Current input')
+  expect(readDraftRetry(scope, owner)).toBeUndefined()
+  expect(retainedRejectedDrafts(scope, owner).map(row => row.text)).toEqual(['Earlier input'])
+})
+
+it('removes a recovery affordance when the existing draft store retires that entry', () => {
+  retainRejectedDraft(scope, 'Earlier input', [], owner, 'retained-id')
+  const { container } = render(<Harness />)
+  act(() => {
+    for (let index = 0; index < 50; index++) {
+      stashSessionDraft('other-' + index, 'Other input', [], owner)
+    }
+  })
+  expect(container.querySelector('[data-slot="composer-retained-send"]')).toBeNull()
+})
+
+it('keeps keyboard focus in recovery and returns to the same editor after the last discard', () => {
+  stashSessionDraft(scope, 'Current input', [], owner)
+  retainRejectedDraft(scope, 'First saved input', [], owner, 'first')
+  retainRejectedDraft(scope, 'Second saved input', [], owner, 'second')
+  const { container } = render(<Harness occupied />)
+  const summary = container.querySelector('summary')!
+  fireEvent.click(summary)
+  const discard = screen.getAllByRole('button', { name: 'Discard saved message' })[0]
+  discard.focus()
+  fireEvent.click(discard)
+  expect(screen.queryByText('First saved input')).toBeNull()
+  expect(document.activeElement).toBe(summary)
+
+  const lastDiscard = screen.getByRole('button', { name: 'Discard saved message' })
+  lastDiscard.focus()
+  fireEvent.click(lastDiscard)
+  expect(screen.queryByRole('button', { name: 'Discard saved message' })).toBeNull()
+  expect(document.activeElement).toBe(screen.getByRole('textbox', { name: 'Message' }))
+  expect(takeSessionDraft(scope, owner).text).toBe('Current input')
+})
+
+it('keeps a failed discard available and preserves focus', () => {
+  retainRejectedDraft(scope, 'Saved input', [], owner, 'first')
+  const { container } = render(<Harness />)
+  fireEvent.click(container.querySelector('summary')!)
+  const discard = screen.getByRole('button', { name: 'Discard saved message' })
+  const write = vi.spyOn(Storage.prototype, 'removeItem').mockImplementationOnce(() => {
+    throw new DOMException('Fixture failure', 'QuotaExceededError')
+  })
+  discard.focus()
+  fireEvent.click(discard)
+  expect(write).toHaveBeenCalled()
+  expect(screen.getByText('Saved input')).toBeTruthy()
+  expect(document.activeElement).toBe(discard)
+})
+
+it('shows a draft switch failure only in its retained row and allows a safe retry', () => {
+  const otherOwner = { ...owner, profile: 'other' }
+  stashSessionDraft(scope, 'Current input', [], owner)
+  retainRejectedDraft(scope, 'Earlier input', [], owner, 'retained-id')
+  retainRejectedDraft(scope, 'Other owner input', [], otherOwner, 'retained-id')
+  const [saved] = retainedRejectedDrafts(scope, owner)
+  const currentKey = ownedDraftKey(scope, owner)!
+  const retainedKey = ownedDraftKey(saved.scope, owner)!
+  const readSaved = (key: string) => readOwnedDraftValue(localStorage.getItem(key))?.text
+  const { container, rerender } = render(<Harness occupied />)
+  fireEvent.click(container.querySelector('summary')!)
+  const action = screen.getByRole('button', { name: 'Park draft and edit failed message' })
+  const setItem = Storage.prototype.setItem
+  const write = vi.spyOn(Storage.prototype, 'setItem').mockImplementation(function (this: Storage, key, value) {
+    if (key.includes('parked')) throw new DOMException('Fixture storage full', 'QuotaExceededError')
+    setItem.call(this, key, value)
+  })
+
+  action.focus()
+  fireEvent.click(action)
+  expect(screen.getByRole('alert').textContent).toBe('Could not switch drafts. Your current draft is still in the editor.')
+  expect(document.activeElement).toBe(action)
+  expect(readSaved(currentKey)).toBe('Current input')
+  expect(readSaved(retainedKey)).toBe('Earlier input')
+  expect(container.querySelector('output')?.textContent).toBe('')
+
+  rerender(<Harness occupied draftOwner={otherOwner} />)
+  expect(screen.getByText('Other owner input')).toBeTruthy()
+  expect(screen.queryByRole('alert')).toBeNull()
+  rerender(<Harness occupied />)
+  expect(screen.getByRole('alert')).toBeTruthy()
+
+  write.mockRestore()
+  fireEvent.click(screen.getByRole('button', { name: 'Park draft and edit failed message' }))
+  expect(screen.queryByRole('alert')).toBeNull()
+  expect(container.querySelector('output')?.textContent).toBe('Earlier input')
+  expect(readSaved(currentKey)).toBe('Earlier input')
+  expect(retainedRejectedDrafts(scope, owner).map(row => row.text)).toEqual(['Current input'])
+  expect(readDraftRetry(scope, owner)?.id).toBe('retained-id')
+})
+
+it('explains why a retained draft cannot be switched while this composer is browsing sent history', () => {
+  retainRejectedDraft(scope, 'Earlier input', [], owner, 'retained-id')
+  const onRestored = vi.fn()
+  const draft = {
+    draftOwnerRef: { current: owner },
+    draftScopeRef: { current: scope },
+    sessionIdRef: { current: scope },
+    getDraftRetry: () => undefined,
+    hasText: false,
+    requestMainFocus: vi.fn(),
+    loadRecoveredDraft: onRestored,
+    syncDraftFromEditor: () => ''
+  } as unknown as Parameters<typeof ComposerDraftRecovery>[0]['draft']
+  const view = (sessionId = scope) => (
+    <ComposerDraftRecovery disabled={false} draft={draft} owner={owner} scope={scope} sessionId={sessionId} />
+  )
+  const { container, rerender } = render(view())
+  container.querySelector('details')!.open = true
+  const restore = screen.getByRole<HTMLButtonElement>('button', { name: 'Restore message' })
+  const hint = /press Down Arrow in the composer/i
+  expect(restore.disabled).toBe(false)
+
+  act(() => browseBackward('other-session', '', ['Unrelated history']))
+  expect(restore.disabled).toBe(false)
+  rerender(view('other-session'))
+  expect(restore.disabled).toBe(true)
+  rerender(view())
+  expect(restore.disabled).toBe(false)
+
+  act(() => browseBackward(scope, '', ['Sent text']))
+  expect(restore.disabled).toBe(true)
+  expect(screen.getByText(hint)).toBeTruthy()
+  expect(screen.getByRole<HTMLButtonElement>('button', { name: 'Discard saved message' }).disabled).toBe(false)
+  fireEvent.click(restore)
+  expect(onRestored).not.toHaveBeenCalled()
+  expect(takeSessionDraft(scope, owner).text).toBe('')
+
+  act(() => browseForward(scope, ['Sent text']))
+  expect(restore.disabled).toBe(false)
+  expect(screen.queryByText(hint)).toBeNull()
+  fireEvent.click(restore)
+  expect(onRestored).toHaveBeenCalledWith('Earlier input', [], expect.objectContaining({ id: 'retained-id' }))
+})
