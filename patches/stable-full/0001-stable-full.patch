@@ -0,0 +1,32 @@
+"""Resource eviction must not discard the only up-to-date transcript."""
+from collections import OrderedDict
+from types import SimpleNamespace
+import threading
+import pytest
+from gateway.agent_cache_pressure import AgentCacheBounds
+from gateway.run import GatewayRunner
+
+@pytest.mark.parametrize("policy", ["cap", "ttl"])
+def test_unflushed_history_survives_until_persistence_catches_up(policy):
+    runner=GatewayRunner.__new__(GatewayRunner)
+    runner._agent_cache_lock=threading.Lock()
+    runner._running_agents={}
+    runner._agent_cache_bounds_cache=AgentCacheBounds(max_size=1,idle_ttl_secs=1)
+    old=SimpleNamespace(_session_messages=[{"role":"user","content":"not saved yet"}],
+                        _last_flushed_db_idx=0,_last_activity_ts=1)
+    recent=SimpleNamespace(_session_messages=[],_last_flushed_db_idx=0,_last_activity_ts=float("inf"))
+    runner._agent_cache=OrderedDict(old=(old,"sig"),recent=(recent,"sig"))
+    released=[]
+    runner._spawn_release_thread=lambda target,args,*a,**k: released.append(args[0])
+    def sweep():
+        if policy=="ttl":runner._sweep_idle_cached_agents()
+        else:
+            with runner._agent_cache_lock:runner._enforce_agent_cache_cap()
+    sweep()
+    assert "old" in runner._agent_cache
+    assert not released
+    old._last_flushed_db_idx=1
+    sweep()
+    assert "old" not in runner._agent_cache
+    assert released==[old]
+    assert "recent" in runner._agent_cache
