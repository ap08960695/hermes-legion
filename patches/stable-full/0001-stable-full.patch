+function WorkDetail({
+  id,
+  board,
+  onOpen
+}: {
+  id: string
+  board: string
+  onOpen: (id: string, opener: HTMLButtonElement) => void
+}) {
+  const k = useKanban(),
+    scope = useKanbanScope(),
+    slug = useValue($boardSlug)
+
+  const { t } = useI18n()
+  const queryKey = taskKey(scope, board || slug, id)
+  const focusKey = JSON.stringify(queryKey)
+  const retryFocus = useRef<string | null>(null)
+  const panelRef = useRef<HTMLElement>(null)
+  const rememberRetryFocus = useCallback((button: HTMLButtonElement | null) => {
+    if (!button) return
+
+    return () => {
+      if (button.ownerDocument.activeElement === button) retryFocus.current = focusKey
+    }
+  }, [focusKey])
+
+  const { data, fetchStatus, isFetched, isRefetchError, refetch } = useQuery({
+    queryKey,
+    queryFn: () => fetchTask(id, board || undefined),
+    enabled: query => routedToScope(query),
+    staleTime: 60_000,
+    retry: false,
+    refetchOnWindowFocus: false
+  })
+
+  useLayoutEffect(() => {
+    // A refresh retains the article, so its ref need not reattach when a refresh button disappears.
+    const panel = panelRef.current
+    const restore = retryFocus.current === focusKey
+    retryFocus.current = null
+    if (!panel || !restore || $boardSlug.get() !== slug || !routedToScope({ queryKey })) return
+
+    const owner = panel.ownerDocument
+    if (owner.hasFocus() && owner.activeElement === owner.body) {
+      panel.focus({ preventScroll: true })
+    }
+  })
+
+  if (!data && !isFetched) return <Loader />
+
+  const busy = fetchStatus !== 'idle'
+  const refreshButton = (label: string) => (
+    <Button
+      aria-busy={busy || undefined}
+      aria-disabled={busy || undefined}
+      className="mx-auto aria-disabled:opacity-60"
+      onClick={() => {
+        if (!busy && $boardSlug.get() === slug && routedToScope({ queryKey })) {
+          void refetch({ cancelRefetch: false })
+        }
+      }}
+      ref={rememberRetryFocus}
+      size="sm"
+      variant="outline"
+    >
+      {label}
+    </Button>
+  )
+
+  if (!data) {
+    return <ErrorState title={busy ? t.common.loading : k.botJourneyError}>{refreshButton(t.common.retry)}</ErrorState>
+  }
+
+  return (
+    <article
+      aria-label={data.delivery?.objective ?? data.task.title}
+      className="kanban-delivery"
+      ref={panelRef}
+      tabIndex={-1}
+    >
+      {isRefetchError && (
+        <div className="flex flex-wrap items-center gap-2 rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2">
+          <p role="status">{k.work.staleNotice}</p>
+          {refreshButton(t.common.retry)}
+        </div>
+      )}
+      {data.delivery ? (
+        <Delivery
+          data={{ ...data.delivery, native_status: data.delivery.native_status ?? data.task.status }}
+          onDownload={data.downloadAttachment}
+        />
+      ) : (
+        <>
+          <h2>{data.task.title}</h2>
+          <p>{k.work.unavailable}</p>
+        </>
+      )}
+      {data.delivery?.revision && (
+        <DeliveryRevisionView
+          board={board || slug}
+          id={id}
+          key={`${scope}/${board || slug}/${id}`}
+          refreshAction={refreshButton(k.work.revision.refreshCard)}
+          revision={data.delivery.revision}
+        />
+      )}
+      {data.delivery?.verification.status === 'accepted' && data.delivery.verification.receipt?.review_run_id && (
+        <ReviewedUsageView
+          board={board || slug}
+          id={id}
+          review={data.delivery.verification.receipt.review_run_id}
+          scope={scope}
+        />
+      )}
+      {(data.delivery?.result || data.task.result) && (
+        <section className="kanban-delivery-result">
+          <h3>{k.work.result}</h3>
+          <TaskMarkdown text={data.delivery?.result || data.task.result!} />
+        </section>
+      )}
+      {Boolean(data.attachments?.length) && (
+        <section>
+          <h3>{k.attachments(data.attachments!.length)}</h3>
+          {data.attachments!.map(attachment => (
+            <AttachmentDownload attachment={attachment} key={attachment.id} onDownload={data.downloadAttachment} />
+          ))}
+        </section>
+      )}
+      <Button onClick={event => onOpen(id, event.currentTarget)} size="sm" variant="outline">
+        <Codicon name="link-external" />
+        {k.workflowOpenCard}
+      </Button>
+      <BotJourney assignee={data.task.assignee} runs={data.runs} />
+    </article>
+  )
+}
