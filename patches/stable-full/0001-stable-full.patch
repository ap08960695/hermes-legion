+def test_capacity_expiry_and_result_size(monkeypatch):
+    store = cache.VisionCache(capacity=2, ttl=10)
+    clock = [100.0]
+    monkeypatch.setattr(cache.time, 'monotonic', lambda: clock[0])
+    calls = []
+    async def call():
+        calls.append(1)
+        return RESULT
+    for key in ('a', 'b', 'c'):
+        asyncio.run(store.run(key, call))
+    assert list(store.done) == ['b', 'c']
+    clock[0] += 11
+    asyncio.run(store.run('c', call))
+    assert len(calls) == 4
+    assert not cache.VisionCache(max_result_bytes=2).cacheable(RESULT)
+
