--- /dev/null
+++ b/apps/desktop/electron/pet-overlay-linux-fixture/gnome-capture.py
@@ -0,0 +1,53 @@
+#!/usr/bin/python3
+"""Capture one cropped frame via Mutter's ScreenCast and PipeWire interfaces."""
+import os
+import subprocess
+import sys
+from gi.repository import Gio, GLib
+
+address = 'org.gnome.Mutter.ScreenCast'
+path = '/org/gnome/Mutter/ScreenCast'
+proxy = Gio.DBusProxy.new_for_bus_sync(Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE,
+                                       None, address, path, address, None)
+session_path = proxy.call_sync('CreateSession', GLib.Variant('(a{sv})', ({},)),
+                               Gio.DBusCallFlags.NONE, 3000).unpack()[0]
+bus = proxy.get_connection()
+loop = GLib.MainLoop()
+pipewire = []
+
+
+def call(obj, interface, method, params=None):
+    return bus.call_sync(address, obj, interface, method, params, None, Gio.DBusCallFlags.NONE, 3000, None)
+
+
+session = address + '.Session'
+try:
+    props = {'cursor-mode': GLib.Variant('u', 0)}
+    stream = call(session_path, session, 'RecordMonitor', GLib.Variant('(sa{sv})', ('', props))).unpack()[0]
+
+    def ready(_bus, _sender, _obj, _interface, _signal, params):
+        pipewire.append(params.unpack()[0])
+        loop.quit()
+
+    bus.signal_subscribe(address, address + '.Stream', 'PipeWireStreamAdded', stream, None, Gio.DBusSignalFlags.NONE, ready)
+    call(session_path, session, 'Start')
+    GLib.timeout_add(4000, lambda: loop.quit() or False)
+    loop.run()
+    if not pipewire:
+        raise RuntimeError('Mutter did not publish a PipeWire stream')
+    target, height = sys.argv[1:]
+    # Cap screenshot output to the synthetic bottom strip. No full screen file.
+    pipeline = subprocess.Popen(['gst-launch-1.0', '-q', 'pipewiresrc', f'path={pipewire[0]}',
+        'num-buffers=1', '!', 'videoconvert', '!', 'pngenc', '!', 'fdsink', 'fd=1'], stdout=subprocess.PIPE)
+    try:
+        subprocess.run(['convert', 'png:-', '-gravity', 'south', '-crop', f'x{int(height)}+0+0',
+                        '+repage', target], stdin=pipeline.stdout, check=True, timeout=8)
+        if pipeline.wait(timeout=3):
+            raise RuntimeError('PipeWire screen receipt failed')
+    finally:
+        pipeline.stdout.close()
+        if pipeline.poll() is None:
+            pipeline.terminate()
+            pipeline.wait(timeout=3)
+finally:
+    call(session_path, session, 'Stop')
