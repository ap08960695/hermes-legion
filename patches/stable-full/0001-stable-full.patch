@@ -0,0 +1,44 @@
+"""A good config backup must contain the generation the native reader actually parsed."""
+import os
+import stat
+
+import pytest
+
+from hermes_cli import config, config_backups, config_effective
+
+
+@pytest.mark.parametrize('reader', ['defaults', 'effective'])
+@pytest.mark.parametrize('replacement', ['agent: [', 'agent: {}\n'])
+def test_backup_is_the_parsed_generation_not_a_later_edit(tmp_path, monkeypatch, reader, replacement):
+    home = tmp_path / 'home'
+    home.mkdir()
+    managed = tmp_path / 'managed'
+    managed.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_MANAGED_DIR', str(managed))
+    path = home / 'config.yaml'
+    original = b'\xef\xbb\xbf# retained source bytes\r\nagent:\r\n  reasoning_effort_limits:\r\n    gpt-6.1-terra: high\r\n'
+    path.write_bytes(original)
+    path.chmod(0o640)
+    before = path.stat()
+    module = config if reader == 'defaults' else config_effective
+    parse = module.fast_safe_load
+    reached = []
+
+    def edit_after_parsing(value):
+        parsed = parse(value)
+        if not reached:
+            reached.append(True)
+            path.write_text(replacement)
+            path.chmod(0o644)
+            os.utime(path, ns=(before.st_atime_ns, before.st_mtime_ns + 10_000_000))
+        return parsed
+
+    monkeypatch.setattr(module, 'fast_safe_load', edit_after_parsing)
+    loaded = config.load_config() if reader == 'defaults' else config_effective.load_user_config_effective(path)
+    assert reached and loaded['agent']['reasoning_effort_limits']['gpt-6.1-terra'] == 'high'
+    saved = config_backups.list_config_backups(path, 'good')
+    assert len(saved) == 1 and saved[0].read_bytes() == original
+    assert stat.S_IMODE(saved[0].stat().st_mode) == 0o640
+    assert saved[0].stat().st_mtime_ns == before.st_mtime_ns
+    assert config_backups.load_newest_good_backup(path)['agent']['reasoning_effort_limits']['gpt-6.1-terra'] == 'high'
