index 0000000000000000000000000000000000000000..ed4191ef5abcad14d14a78e607fae0d7ca63153e
--- /dev/null
+++ b/hermes_cli/kanban_attention.py
@@ -0,0 +1,27 @@
+"""CLI edge for a trusted template's daily TUI attention request."""
+import json
+from pathlib import Path
+import sqlite3
+import sys
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli.kanban_db_attention import request_attention
+
+
+def command(args) -> int:
+    if not kb.kanban_db_path().is_file():
+        print('kanban: attention requires an existing board', file=sys.stderr)
+        return 1
+    try:
+        guard = json.loads(Path(args.guard).read_text(encoding='utf-8'))
+        with kbc.connect_closing() as conn:
+            receipt = request_attention(conn, task_id=args.task_id, day=args.day,
+                                        session_key=args.session, guard=guard, message=args.message)
+    except (OSError, sqlite3.Error, json.JSONDecodeError):
+        print('kanban: could not read the attention policy or commit its receipt', file=sys.stderr)
+        return 1
+    except (ValueError, RuntimeError, PermissionError) as exc:
+        print(f'kanban: {exc}', file=sys.stderr)
+        return 1
+    print(json.dumps(receipt) if args.json else f"attention receipt {receipt['delivery_id']}; inspect notify-receipts for delivery state")
+    return 0
diff --git a/hermes_cli/kanban_attention_guard.py b/hermes_cli/kanban_attention_guard.py
new file mode 100644
index 0000000000000000000000000000000000000000..fd9374ef8c16dff83a6e53b0608b137bd809e63a
--- /dev/null
+++ b/hermes_cli/kanban_attention_guard.py
@@ -0,0 +1,88 @@
+"""Strict opt-in policy for untouched automation plans; unknown activity is a hold.
+
+The policy comes from a trusted, reviewed template, never from blindly hashing the
+current card. It is not an owner answer, execution permission or publication grant.
+"""
+from dataclasses import asdict
+from datetime import datetime, timedelta, timezone
+import hashlib
+import json
+from pathlib import Path
+
+BANGKOK = timezone(timedelta(hours=7))
+FIELDS = {'version', 'workspace', 'created_by', 'idempotency_key', 'body_sha256',
+          'initial_block_reason', 'initial_comment_author'}
+
+
+def encode(value) -> str:
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False)
+
+
+def digest(value) -> str:
+    return hashlib.sha256(encode(value).encode()).hexdigest()
+
+
+def validate_policy(guard: dict) -> dict:
+    if not isinstance(guard, dict) or set(guard) != FIELDS or guard['version'] != 1:
+        raise ValueError('attention guard requires the exact version 1 policy fields')
+    if any(not isinstance(guard[k], str) or not guard[k].strip() for k in FIELDS - {'version'}):
+        raise ValueError('attention guard fields must be non-empty strings')
+    if not Path(guard['workspace']).is_absolute():
+        raise ValueError('attention guard workspace must be absolute')
+    if len(guard['body_sha256']) != 64 or any(c not in '0123456789abcdef' for c in guard['body_sha256']):
+        raise ValueError('attention guard body_sha256 must be a SHA256 digest')
+    return {**guard, 'workspace': str(Path(guard['workspace']).resolve())}
+
+
+def check_day(day: str, now: float) -> None:
+    clock = datetime.fromtimestamp(now, BANGKOK)
+    if day != clock.date().isoformat() or clock.hour < 7:
+        raise ValueError('attention requires the current Bangkok day at or after 07:00')
+
+
+def _known_event(event, guard: dict, own_attention_ids: set) -> bool:
+    p = event.payload or {}
+    if event.kind == 'created':
+        return event.run_id is None
+    if event.kind == 'blocked':
+        return (p.get('reason') == 'initial_status' and p.get('actor') == guard['created_by']
+                or p.get('classified_in_place') is True and p.get('kind') == 'needs_input'
+                and p.get('reason') == guard['initial_block_reason'])
+    if event.kind == 'commented':
+        return p.get('author') == guard['initial_comment_author']
+    return event.kind == 'attention_requested' and event.id in own_attention_ids
+
+
+def eligible_snapshot(conn, task_id: str, guard: dict) -> str:
+    """Return a fingerprint only for an untouched, unowned template plan."""
+    from hermes_cli import kanban_db as kb
+    task = kb.get_task(conn, task_id)
+    if not task or task.status not in ('ready', 'todo', 'blocked'):
+        raise ValueError('task is not eligible for attention')
+    if any((task.assignee, task.claim_lock, task.claim_expires, task.current_run_id, task.worker_pid,
+            task.started_at, task.completed_at, task.result, task.consecutive_failures)):
+        raise ValueError('owned or previously executed task is not eligible for attention')
+    expected = (guard['created_by'], guard['idempotency_key'], 'dir', guard['workspace'])
+    if (task.created_by, task.idempotency_key, task.workspace_kind, task.workspace_path) != expected:
+        raise ValueError('attention guard provenance mismatch')
+    if hashlib.sha256((task.body or '').encode()).hexdigest() != guard['body_sha256']:
+        raise ValueError('attention guard body mismatch')
+    if task.block_kind not in (None, 'needs_input') or kb.list_runs(conn, task_id) or kb.parent_ids(conn, task_id):
+        raise ValueError('task history or dependency gate is not eligible for attention')
+    if task.block_kind == 'needs_input' and task.status != 'blocked':
+        raise ValueError('attention guard requires a consistent block state')
+    comments, events = kb.list_comments(conn, task_id), kb.list_events(conn, task_id)
+    if len(comments) > 1 or any(c.author != guard['initial_comment_author']
+                                or c.body not in (guard['initial_block_reason'],
+                                                 f"BLOCKED: {guard['initial_block_reason']}") for c in comments):
+        raise ValueError('unknown comment or owner gate is not eligible for attention')
+    own = {r[0] for r in conn.execute('SELECT event_id FROM kanban_task_attention WHERE task_id=?', (task_id,))}
+    if not all(_known_event(e, guard, own) for e in events):
+        raise ValueError('unknown task activity is not eligible for attention')
+    classified = [e for e in events if e.kind == 'blocked' and (e.payload or {}).get('classified_in_place')]
+    if len(classified) > 1 or (task.block_kind == 'needs_input') != bool(classified):
+        raise ValueError('attention guard block history mismatch')
+    if sum(e.kind == 'created' for e in events) != 1 or sum(e.kind == 'commented' for e in events) != len(comments):
+        raise ValueError('attention guard audit history mismatch')
+    return digest({'task': asdict(task), 'comments': [asdict(c) for c in comments],
+                   'events': [asdict(e) for e in events if e.kind != 'attention_requested']})
diff --git a/hermes_cli/kanban_attention_host.py b/hermes_cli/kanban_attention_host.py
new file mode 100644
index 0000000000000000000000000000000000000000..7c216f7ee8d3e3b59e33498872cc25087109b3d3
--- /dev/null
+++ b/hermes_cli/kanban_attention_host.py
@@ -0,0 +1,157 @@
+"""Explicit one-receipt, one-turn host for a closed stored captain.
+
+This is a CLI consumer, not a general session resume or background notification
+service. Receipt claim is the admission boundary; ambiguous attempts never replay.
+"""
+from contextlib import closing, contextmanager
+from contextvars import copy_context
+from pathlib import Path
+import sqlite3
+import uuid
+
+from hermes_cli import kanban_db_attention as attention, kanban_db_tui_delivery as delivery
+from hermes_cli.active_sessions import active_session_registry_snapshot, try_acquire_active_session
+from hermes_constants import get_hermes_home
+
+
+def _request(path: Path, delivery_id: int, session_key: str, home: str) -> dict:
+    if not path.is_file():
+        raise ValueError('daily attention receipt not found')
+    with closing(sqlite3.connect(path.resolve().as_uri() + '?mode=ro', uri=True)) as conn:
+        conn.row_factory = sqlite3.Row
+        tables = {r[0] for r in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")}
+        if not {attention.TABLE, delivery.TABLE} <= tables:
+            raise ValueError('daily attention receipt not found')
+        row = conn.execute(f'''SELECT d.* FROM {delivery.TABLE} d JOIN {attention.TABLE} a
+            ON a.delivery_id=d.id WHERE d.id=? AND d.home=? AND d.session_key=?''',
+            (delivery_id, home, session_key)).fetchone()
+        if row is None:
+            raise ValueError('daily attention receipt not found for this profile and destination')
+        return dict(row)
+
+
+def _out(row: dict, ran: bool = False) -> dict:
+    return {'delivery_id': row['id'], 'state': row['state'], 'ran': ran}
+
+
+def _unowned(db, tip: str, home: Path, own_lease_id: str = '') -> None:
+    for owner in active_session_registry_snapshot(home, strict=True):
+        if owner['lease_id'] != own_lease_id and db.get_compression_tip(owner['session_id']) == tip:
+            raise RuntimeError('destination has a live owner; attention remains pending')
+
+
+def _restore(db, key: str):
+    from agent.replay_cleanup import canonicalize_replay_history
+    tip = db.get_compression_tip(key)
+    row = db.get_session(tip) if tip else None
+    if not row:
+        raise ValueError('stored attention destination not found')
+    if db.is_kanban_owned_session(tip):
+        raise RuntimeError('a Kanban worker cannot be resumed by an attention host')
+    if row.get('source') not in ('desktop', 'tui', 'cli'):
+        raise ValueError('attention host requires a stored local chat destination')
+    db.assert_resume_safe(tip, tip_only=True)
+    raw, _display = db.get_resume_conversations(tip)
+    return tip, row, canonicalize_replay_history(raw)
+
+
+def build_agent(*, session_id: str, row: dict, cwd: str, session_db):
+    """Normal native agent construction, with exact stored runtime and no fallback ladder."""
+    from hermes_cli.kanban_attention_runtime import build_agent as build
+    return build(session_id=session_id, row=row, cwd=cwd, session_db=session_db)
+
+
+def _turn(agent, text: str, history: list, claim):
+    try:
+        result = agent.run_conversation(str(text), conversation_history=history)
+        messages = getattr(agent, '_session_messages', None)
+        if isinstance(messages, list) and messages:
+            if agent._flush_messages_to_session_db(messages, history) is False:
+                raise RuntimeError('attention transcript flush did not complete')
+        if not isinstance(result, dict):
+            state = 'unknown'
+        elif result.get('interrupted'):
+            state = 'cancelled'
+        elif result.get('failed') or result.get('error') or result.get('partial') or result.get('completed') is False:
+            state = 'failed'
+        else:
+            state = 'settled' if result.get('completed') is True else 'unknown'
+        claim.mark(state)
+    except BaseException:
+        claim.mark('unknown')
+        raise
+
+
+@contextmanager
+def _reserve(db, tip: str, home: Path):
+    from hermes_cli.config import load_config
+    _unowned(db, tip, home)
+    lease, refusal = try_acquire_active_session(session_id=tip, surface='cli', registry_home=home,
+        config=load_config(), metadata={'live_session_id': f'attention-{uuid.uuid4().hex}'})
+    if refusal is not None:
+        raise RuntimeError(f'attention destination owner/capacity refusal: {getattr(refusal, "reason", "unavailable")}')
+    try:
+        _unowned(db, tip, home, lease.lease_id)
+        yield
+    finally:
+        lease.release()
+
+
+def _consume(path, row, key, home, db, tip, stored, history):
+    from gateway.session_context import set_session_vars, clear_session_vars
+    from tools.approval_context import set_current_session_key, reset_current_session_key
+    claim = delivery.Claim('', ())
+    agent, entered = None, False
+    cwd = str(stored.get('cwd') or '')
+    if not cwd or not Path(cwd).is_dir():
+        raise ValueError('stored destination workspace is unavailable')
+    tokens = set_session_vars(platform=stored['source'], source=stored['source'], session_key=tip,
+        session_id=tip, cwd=cwd, async_delivery=False, cron_session='')
+    approval = set_current_session_key(tip)
+    try:
+        agent = build_agent(session_id=tip, row=stored, cwd=cwd, session_db=db)
+        agent.auto_title_enabled = False
+        text = delivery._text(row, str(path.resolve()))
+        texts, claim = delivery.claim([text], home=str(home), session_key=tip, session_keys=(key,))
+        if not texts:
+            return _out(_request(path, row['id'], key, str(home)))
+        db.reopen_session(tip)  # Only an admitted request creates activity.
+        entered = True
+        _turn(agent, texts[0], history, claim)
+        return _out(_request(path, row['id'], key, str(home)), ran=True)
+    finally:
+        try:
+            try:
+                if not entered:
+                    claim.mark('pending')
+            finally:
+                if agent is not None:
+                    agent.close()
+        finally:
+            reset_current_session_key(approval)
+            clear_session_vars(tokens)
+
+
+def _run(path: Path, *, delivery_id: int, session_key: str) -> dict:
+    from hermes_state import SessionDB
+    from tui_gateway.server import _session_profile_runtime_scope
+    home = get_hermes_home().resolve()
+    row = _request(path, delivery_id, session_key, str(home))
+    if row['state'] != 'pending':
+        return _out(row)
+    state_path = home / 'state.db'
+    if not state_path.is_file():
+        raise ValueError('stored attention destination not found')
+    with _session_profile_runtime_scope({'profile_home': str(home)}), closing(SessionDB(state_path, read_only=True)) as reader:
+        tip, _stored, _history = _restore(reader, session_key)
+        with _reserve(reader, tip, home):
+            current, stored, history = _restore(reader, session_key)
+            if current != tip:
+                raise RuntimeError('destination changed during admission; attention remains pending')
+            with closing(SessionDB(state_path)) as db:
+                return _consume(path, row, session_key, home, db, tip, stored, history)
+
+
+def run(path: Path, *, delivery_id: int, session_key: str) -> dict:
+    # clear_session_vars intentionally clears rather than resets; isolate it from a library caller.
+    return copy_context().run(_run, path, delivery_id=delivery_id, session_key=session_key)
