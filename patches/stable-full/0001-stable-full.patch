+    flex: 0 0 52px;
+    margin-top: 0;
+    flex-direction: row;
+  }
+  .hermes-focus-utilities > .hermes-focus-nav {
+    display: none;
+  }
+  .hermes-focus-utilities > .hermes-focus-nav:first-child {
+    display: flex;
+  }
+  [data-presentation='workspace'] .hermes-focus-primary > .hermes-focus-nav,
+  .hermes-focus-primary > .hermes-focus-nav {
+    width: auto;
+    min-width: 0;
+    flex: 1 1 0;
+    flex-direction: column;
+    justify-content: center;
+    min-height: 48px;
+    padding: 5px;
+    gap: 5px;
+  }
+  .hermes-focus-primary > .hermes-focus-nav > span:not(.codicon) {
+    font-size: 10px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .hermes-focus-frame button {
+    transition: none;
+    animation: none;
+    transform: none;
+  }
+}
+.hermes-focus-goal {
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+}
+.hermes-focus-goal > :not(form) {
+  flex-shrink: 0;
+}
+.hermes-focus-goal > form {
+  min-height: 0;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+.hermes-focus-goal form > fieldset {
+  display: grid;
+  gap: 14px;
+  min-width: 0;
+}
+.hermes-focus-goal label {
+  display: grid;
+  gap: 6px;
+  min-width: 0;
+  font-size: 12px;
+}
+.hermes-focus-goal label > span {
+  overflow-wrap: anywhere;
+}
+.hermes-focus-goal legend {
+  font-size: 12px;
+  margin-block-end: 6px;
+}
+.hermes-focus-goal fieldset p {
+  font-size: 11px;
+  color: var(--ui-text-secondary);
+}
+.hermes-focus-skill-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 8px;
+  margin-block-start: 10px;
+}
+.hermes-focus-skill-grid > label {
+  display: flex;
+  align-items: start;
+  gap: 8px;
+}
+.hermes-focus-skill-grid input {
+  margin-block-start: 2px;
+  accent-color: var(--primary);
+}
+.hermes-focus-goal-footer {
+  display: flex;
+  justify-content: flex-end;
+  gap: 8px;
+  padding-block: 12px;
+  background: var(--ui-chat-bubble-background);
+  z-index: 1;
+  border-block-start: 1px solid var(--ui-stroke-secondary);
+}
+
+@keyframes hermes-focus-select {
+  from {
+    opacity: 0.55;
+    transform: translateY(2px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+.hermes-focus-nav[aria-current='page'] > .codicon {
+  animation: hermes-focus-select 180ms ease-out both;
+}
+@media (prefers-reduced-motion: reduce) {
+  .hermes-focus-nav[aria-current='page'] > .codicon {
+    animation: none;
+  }
+}
+
+.hermes-focus-goal summary {
+  cursor: pointer;
+  font-size: 12px;
+  color: var(--ui-text-secondary);
+}
+.hermes-focus-more-conditions {
+  display: grid;
+  gap: 14px;
+  margin-block-start: 14px;
+}
+
+/* Native surfaces share one canvas, instead of a second shell inside a rail. */
+.hermes-focus-frame {
+  padding: 10px 10px 10px 0;
+  gap: 10px;
+}
+.hermes-focus-frame > .hermes-focus-rail {
+  border-inline-end: 0;
+  background: transparent;
+}
+.hermes-focus-content {
+  border: 1px solid var(--ui-stroke-tertiary);
+  border-radius: 14px;
+  background: var(--ui-chat-surface-background);
+}
+.hermes-focus-content [data-tour='sessions-sidebar'] {
+  border-color: var(--ui-stroke-tertiary);
+}
+.hermes-focus-brand {
+  margin-block-end: 12px;
+}
+.hermes-focus-primary {
+  gap: 8px;
+}
+.hermes-focus-nav[aria-current='page'] {
+  box-shadow: inset 0 0 0 1px var(--ui-stroke-tertiary);
+}
+@media (max-width: 640px) {
+  .hermes-focus-frame {
+    padding: 6px 6px 0;
+    gap: 4px;
+  }
+  .hermes-focus-content {
+    border-radius: 12px;
+  }
+}
+
+.hermes-focus-content [data-slot='aui_intro'][data-presentation='quiet'] {
+  max-width: 600px;
+  margin-inline: auto;
+  padding: 28px;
+}
+.hermes-focus-content [data-slot='aui_intro'][data-presentation='quiet'] h1 {
+  font-size: 27px;
+  line-height: 1.3;
+  font-weight: 500;
+  color: var(--ui-text-primary);
+  letter-spacing: -0.4px;
+  margin-block-end: 12px;
+}
+.hermes-focus-content [data-slot='aui_intro'][data-presentation='quiet'] p {
+  max-width: 50ch;
+  margin-inline: auto;
+  font-size: 14px;
+  line-height: 1.65;
+  color: var(--ui-text-tertiary);
+}
+
+.hermes-focus-skill-search {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 8px 16px;
+  margin-block-start: 10px;
+}
+.hermes-focus-skill-search > span {
+  font-size: 11px;
+  color: var(--ui-text-secondary);
+}
+.hermes-focus-skill-grid > label > span {
+  overflow-wrap: anywhere;
+}
