+@pytest.mark.parametrize("title, expected, bound", [
+    ("abc", b'{"new": {"title": "abc"}}', b'{"new": {"title": "abc"}}'),
+    ("ก", b'{"new": {"title": "\xe0\xb8\x81"}}', b'{"new": {"title": "\\u0e01"}}'),
+    (chr(0xDCFF), b'{"new": {"title": "\\udcff"}}', b'{"new": {"title": "\\udcff"}}'),
+], ids=["ascii", "thai", "surrogate"])
+@pytest.mark.parametrize("capacity", ["full", "unknown", "below", "equal"])
+def test_web_index_admission_preserves_native_serialization(
+    web_cache_root, monkeypatch, caplog, title, expected, bound, capacity,
+):
+    import logging
+    import stat
+    import utils
+    from tools import web_result_cache as cache
+
+    index = web_cache_root / cache._INDEX_FILENAME
+    previous = b'{"previous": {"title": "kept"}}'
+    index.write_bytes(previous)
+    index.chmod(0o640)
+    before = index.stat()
+    usage = shutil.disk_usage(web_cache_root)
+    created = []
+    real_mkstemp = utils.tempfile.mkstemp
+
+    def mkstemp(*args, **kwargs):
+        result = real_mkstemp(*args, **kwargs)
+        created.append(result[1])
+        return result
+
+    def space(parent):
+        assert parent == web_cache_root
+        if capacity == "unknown":
+            raise OSError("synthetic volume observation unavailable")
+        free = 0 if capacity == "full" else 1024**3 + len(bound) - (capacity == "below")
+        return usage._replace(free=free)
+
+    monkeypatch.setattr(utils.tempfile, "mkstemp", mkstemp)
+    monkeypatch.setattr(shutil, "disk_usage", space)
+    with caplog.at_level(logging.DEBUG):
+        cache._save_index({"new": {"title": title}})
+    assert sorted(p.name for p in web_cache_root.iterdir()) == [cache._INDEX_FILENAME]
+    assert stat.S_IMODE(index.stat().st_mode) == stat.S_IMODE(before.st_mode)
+    if capacity == "equal":
+        assert index.read_bytes() == expected
+        assert cache._load_index() == {"new": {"title": title}}
+        assert len(created) == 1  # Real atomic temp/write/replace remains in use.
+    else:
+        assert index.read_bytes() == previous
+        assert (index.stat().st_ino, index.stat().st_mtime_ns) == (before.st_ino, before.st_mtime_ns)
+        assert not created, "Refused index admission must precede temporary allocation"
+        assert "Failed to save web extract cache index" in caplog.text
+
