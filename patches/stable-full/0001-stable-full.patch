+def test_concurrent_profile_judges_keep_their_own_store(home, monkeypatch):
+    owners = []
+    for name in ("left", "right"):
+        profile = home / name
+        profile.mkdir()
+        token = set_hermes_home_override(profile)
+        try:
+            db = goals._get_session_db()
+            db.create_session(name, source="cli")
+            mgr = goals.GoalManager(name)
+            mgr.set("finish isolated fixture")
+            owners.append((profile, db, mgr))
+        finally:
+            reset_hermes_home_override(token)
+    barrier = Barrier(2)
+
+    def response_boundary(*, task, **kwargs):
+        barrier.wait(timeout=5)
+        return _validate_llm_response(_response(), task, provider="offline")
+
+    def evaluate(owner):
+        profile, db, mgr = owner
+        token = set_hermes_home_override(profile)
+        try:
+            assert mgr.evaluate_after_turn("fixture completed")["status"] == "done"
