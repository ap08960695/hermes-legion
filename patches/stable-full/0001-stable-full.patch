+@pytest.mark.parametrize("rows", [8, 9])
+def test_character_counts_decode_once_without_touching_terminal_cache(fleet, monkeypatch, rows):
+    from agent.pet import constants, render
+
+    server, home = fleet
+    sheet = home / "profiles/alpha/pets/same/spritesheet.png"
+    width, height = constants.FRAME_W, constants.FRAME_H
+    image = Image.new("RGBA", (width * 8, height * rows))
+    counts = [7, 2, 3, 4, 5, 6, 0, 7, 8][:rows]
+    for row, count in enumerate(counts):
+        for column in range(count):
+            image.putpixel((column * width, row * height), (100, 80, 60, 9))
+        if count + 1 < 8:
+            image.putpixel((count * width, row * height), (100, 80, 60, 8))
+            image.putpixel(((count + 1) * width, row * height), (100, 80, 60, 255))
+    image.save(sheet)
+
+    classic = render.PetRenderer(str(sheet), mode="unicode", scale=0.45)
+    expected_terminal = classic.frame("idle", 0)
+    old_cache = render._raw_frames.cache_info()
+    open_image = Image.open
+    opens = []
+
+    def count_open(path, *args, **kwargs):
+        opens.append(path)
+        return open_image(path, *args, **kwargs)
+
+    with monkeypatch.context() as probe:
+        probe.setattr(Image, "open", count_open)
+        result = server.handle_request({
+            "id": "metadata", "method": "pet.sprite", "params": {"profile": "alpha", "slug": "same"},
+        })["result"]
+        assert result["enabled"]
+        assert len(opens) == 1 and isinstance(opens[0], BytesIO)
+        assert render._raw_frames.cache_info() == old_cache
+    names = constants.state_rows_for_grid(rows)
+    assert result["stateRows"] == names
+    assert result["framesByRow"] == dict(zip(names, counts, strict=True))
+    assert result["framesByState"] == {
+        state.value: min(constants.FRAMES_PER_STATE, counts[constants.state_row_index(state, rows)])
+        for state in constants.PetState
+    }
+    assert {state: classic.frame_count(state) for state in result["framesByState"]} == result["framesByState"]
+    assert classic.frame("idle", 0) == expected_terminal
+
