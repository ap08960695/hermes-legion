+    monkeypatch.setattr(Path, "read_bytes", refuse_path_read)
+    response = server.handle_request({
+        "id": "snapshot", "method": "pet.sprite",
+        "params": {"profile": "alpha", "slug": "same"},
+    })
+    result = response["result"]
+    assert result["enabled"]
+    assert base64.b64decode(result["spritesheetBase64"], validate=True) == expected
