@@ -0,0 +1,93 @@
+import { clearSessionDraft, ownedDraftScopes, stashSessionDraft, takeSessionDraft } from './composer'
+import { draftOwnerKey, type OwnedDraftScope } from './composer-draft-owner'
+import { ownedDraftRetryScopes, readDraftRetry, writeDraftRetry } from './composer-draft-retry'
+import { dropStatusDrawersForProfile, migrateStatusDrawersForProfile } from './composer-status-drawer'
+import type { SessionOwnerScope } from './session-request-router'
+
+const scopes = () => [
+  ...new Map(
+    [...ownedDraftScopes(), ...ownedDraftRetryScopes()].map(scope => [
+      JSON.stringify([scope.ownerKey, scope.scope]),
+      scope
+    ])
+  ).values()
+]
+
+const profileKey = (value?: string) => value?.trim() || 'default'
+
+function renamedOwner(owner: NonNullable<SessionOwnerScope>, from: string, to: string): NonNullable<SessionOwnerScope> {
+  if (typeof owner === 'string') {
+    return owner === from ? to : owner
+  }
+
+  if (owner.connectionId && owner.connectionId !== 'local') {
+    return owner
+  }
+
+  return {
+    ...owner,
+    profile: owner.profile === from ? to : owner.profile,
+    targetProfile: (owner.targetProfile || owner.profile) === from ? to : owner.targetProfile || owner.profile
+  }
+}
+
+function migrateDraft(scope: OwnedDraftScope, destination: NonNullable<SessionOwnerScope>): void {
+  if (draftOwnerKey(scope.owner) === draftOwnerKey(destination)) {
+    return
+  }
+
+  const source = takeSessionDraft(scope.scope, scope.owner)
+  const target = takeSessionDraft(scope.scope, destination)
+  const retry = readDraftRetry(scope.scope, scope.owner)
+  const targetRetry = readDraftRetry(scope.scope, destination)
+
+  // A rename must never overwrite an existing draft or a different uncertain send.
+  if (target.text || target.attachments.length || (targetRetry && targetRetry.id !== retry?.id)) {
+    return
+  }
+
+  if (!stashSessionDraft(scope.scope, source.text, source.attachments, destination)) {
+    return
+  }
+
+  if (retry && !writeDraftRetry(scope.scope, retry, destination)) {
+    return
+  }
+
+  clearSessionDraft(scope.scope, scope.owner)
+  writeDraftRetry(scope.scope, undefined, scope.owner)
+}
+
+export function migrateComposerStateForProfile(from: string, to: string): void {
+  migrateStatusDrawersForProfile(from, to)
+
+  for (const scope of scopes()) {
+    migrateDraft(scope, renamedOwner(scope.owner, from, to))
+  }
+}
+
+export function dropComposerStateForProfile(
+  profile: string,
+  route?: { connectionId?: string; profile?: string; targetProfile?: string },
+  ambientConnection = 'local'
+): void {
+  dropStatusDrawersForProfile(profile, route)
+  const connection = route?.connectionId?.trim() || ambientConnection
+
+  for (const scope of scopes()) {
+    const owner = scope.owner
+    const ownerConnection = typeof owner === 'string' ? 'local' : owner.connectionId || 'local'
+    const ownerProfile = typeof owner === 'string' ? owner : owner.profile
+    const ownerTarget = typeof owner === 'string' ? owner : owner.targetProfile || owner.profile
+
+    const matchesProfile = route
+      ? profileKey(ownerProfile) === profileKey(route.profile) &&
+        (!route.targetProfile || profileKey(ownerTarget) === profileKey(route.targetProfile))
+      : profileKey(ownerProfile) === profile || profileKey(ownerTarget) === profile
+
+    if (ownerConnection === connection && matchesProfile) {
+      clearSessionDraft(scope.scope, owner)
+      writeDraftRetry(scope.scope, undefined, owner)
+    }
+  }
+}
