+++ b/tests/gateway/test_hosted_standby.py
@@ -0,0 +1,117 @@
+"""Real canonical stores must not allocate supervisors for empty profiles."""
+from contextlib import ExitStack
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.hosted_rooms import create_room, disband_room, local_authority_gateway_id
+from gateway.session_hosted_service import CanonicalHostedRoomService, start_ready_hosted_services
+from hermes_state import SessionDB
+from hermes_state_runtime import begin_runtime_epoch
+
+
+def _service(stack, root, name):
+    home = root / name
+    home.mkdir()
+    db = stack.enter_context(SessionDB(home / 'state.db'))
+    authority = SimpleNamespace(db=db, profile_id=str(home),
+                               epoch=begin_runtime_epoch(db, instance_id='fixture'))
+    service = authority.hosted_room_service = CanonicalHostedRoomService(authority, None)
+    service._transport_installed = True
+    stack.callback(lambda: service.stop(timeout=5))
+    return authority
+
+
+def _runner(authorities, state='ready'):
+    from gateway.session_authorities import SessionAuthorities
+    registry = SessionAuthorities(authorities[0].profile_id)
+    for authority in authorities:
+        registry.add(authority.profile_id, authority)
+    return SimpleNamespace(session_authorities=registry,
+        session_authority=authorities[0], session_runtime_descriptor={'state': state}, _draining=False)
+
+
+
+def _room(service, name='room', *, owned=True, gateway=None):
+    if owned:
+        service.authorize_room('fixture-owner', name, create=True)
+    create_room(service.db_path, room_id=name, name='Room',
+        authority_gateway_id=gateway or local_authority_gateway_id(),
+        members=[{'member_id': 'one', 'profile': 'default', 'handle': 'one'}])
+
+
+def test_ready_empty_profiles_allocate_no_supervisors_and_respect_ready_gate(tmp_path):
+    with ExitStack() as stack:
+        authorities = [_service(stack, tmp_path, str(i)) for i in range(8)]
+        runner = _runner(authorities, 'starting')
+        start_ready_hosted_services(runner)
+        assert all(not a.hosted_room_service.runtime.status()['running'] for a in authorities)
+        runner.session_runtime_descriptor['state'] = 'ready'
+        start_ready_hosted_services(runner)
+        assert all(not a.hosted_room_service.runtime.status()['running'] for a in authorities), (
+            'empty served profiles must remain available without per-profile supervisor threads')
+
+
+@pytest.mark.asyncio
+async def test_standby_probe_finds_persisted_rooms_without_reviving_closed_or_retiring_owners(tmp_path):
+    from gateway.session_hosted_service import ensure_hosted_service
+    with ExitStack() as stack:
+        authorities = [_service(stack, tmp_path, str(i)) for i in range(6)]
+        runner = _runner(authorities)
+        # No API wake: persisted/external room discovery must remain supported.
+        _room(authorities[1].hosted_room_service)
+        _room(authorities[2].hosted_room_service, owned=False)
+        _room(authorities[3].hosted_room_service, gateway='another-install')
+        _room(authorities[4].hosted_room_service)
+        authorities[4].retiring = True
+        archived = authorities[5].hosted_room_service
+        _room(archived)
+        disband_room(archived.db_path, room_id='room', expected_gateway_id=local_authority_gateway_id(), expected_epoch=1)
+        await ensure_hosted_service(runner)
+        assert [a.hosted_room_service.runtime.status()['running'] for a in authorities] == [
+            False, True, False, False, False, False]
+        # Bounded discovery must not reopen the writer once ownership is released.
+        closed = authorities[0]
+        closed.db.close()
+        runner._hosted_room_next_probe = 0
+        await ensure_hosted_service(runner)
+        assert closed.db._conn is None
+        assert not closed.hosted_room_service.runtime.status()['running']
+        assert authorities[1].hosted_room_service.runtime.status()['running']
+
+
+@pytest.mark.asyncio
+async def test_cancelled_probe_cannot_overlap_the_same_profile_read(tmp_path, monkeypatch):
+    import asyncio
+    import threading
+    from gateway.session_hosted_service import ensure_hosted_service
+
+    with ExitStack() as stack:
+        authority = _service(stack, tmp_path, 'owner')
+        runner = _runner([authority])
+        entered, release = threading.Event(), threading.Event()
+        reads = []
+
+        def blocked_read():
+            reads.append(1)
+            entered.set()
+            assert release.wait(5)
+            return False
+
+        monkeypatch.setattr(authority.hosted_room_service, 'has_owned_rooms', blocked_read)
+        first = asyncio.create_task(ensure_hosted_service(runner))
+        try:
+            assert await asyncio.to_thread(entered.wait, 5)
+            first.cancel()
+            with pytest.raises(asyncio.CancelledError):
+                await first
+            runner._hosted_room_next_probe = 0
+            await ensure_hosted_service(runner)
+            assert len(reads) == 1, 'cancelled observer must not duplicate an in-flight read'
+        finally:
+            release.set()
+            if not first.done():
+                await first
+            pending = getattr(runner, "_hosted_room_probe", None)
+            if pending is not None:
+                await asyncio.shield(pending)
