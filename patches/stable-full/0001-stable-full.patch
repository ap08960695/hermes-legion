diff --git a/apps/desktop/src/plugins/hermes-bots/character-picker.tsx b/apps/desktop/src/plugins/hermes-bots/character-picker.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..131e8fafdd5b27ae391c8ca1e19f2ca1ab077177
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/character-picker.tsx
@@ -0,0 +1,39 @@
+import { queryClient, useQuery } from '@hermes/plugin-sdk'
+
+import { useBots } from './i18n'
+import { requestForBot } from './routing'
+import { ID } from './shared'
+import type { RosterRow } from './types'
+
+interface CharacterPickerProps {
+  bot: RosterRow
+  sourceKey: string
+  value: null | string
+  onChange: (slug: null | string) => void
+}
+
+/** Assignment reads installed packs only; static avatars and global selection are independent. */
+export function CharacterPicker({ bot, sourceKey, value, onChange }: CharacterPickerProps) {
+  const b = useBots()
+
+  const { data, isPending, isError } = useQuery({
+    queryKey: [ID, 'character-gallery', sourceKey],
+    queryFn: () => requestForBot<{ pets?: { slug: string; displayName?: string; installed?: boolean }[] }>(
+      bot, 'pet.gallery', { profile: bot.name, localOnly: true }, { timeoutMs: 8000 }),
+    staleTime: 300_000, gcTime: 0, retry: false, refetchOnWindowFocus: false
+  }, queryClient)
+
+  const installed = (data?.pets ?? []).filter(pet => pet.installed && typeof pet.slug === 'string')
+
+  return <div className="grid gap-2 pt-3">
+    <select aria-label={b.monitor.character} className="w-full rounded-md bg-(--ui-bg-elevated) p-2 text-xs"
+      disabled={isPending} onChange={event => onChange(event.target.value || null)} value={value || ''}>
+      <option value="">{b.monitor.defaultCharacter}</option>
+      {value && !installed.some(pet => pet.slug === value) && <option value={value}>{value} · {b.monitor.characterUnavailable}</option>}
+      {installed.map(pet => <option key={pet.slug} value={pet.slug}>{pet.displayName || pet.slug}</option>)}
+    </select>
+    <p className="text-xs text-(--ui-text-tertiary)" role={isError ? 'status' : undefined}>
+      {isError ? b.monitor.characterUnavailable : b.monitor.characterHint}
+    </p>
+  </div>
+}
diff --git a/apps/desktop/src/plugins/hermes-bots/character-sprites.test.ts b/apps/desktop/src/plugins/hermes-bots/character-sprites.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ab7104a54997244f21a0896f60908733c3764155
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/character-sprites.test.ts
@@ -0,0 +1,99 @@
+import { expect, it, vi } from 'vitest'
+
+// eslint-disable-next-line no-restricted-imports -- exercise the real public preview capability in this consumer test
+import { createPetCharacterPublisher } from '@/store/pet-characters'
+
+import { createCharacterSpriteLoader } from './character-sprites'
+
+// Original solid-colour Pillow fixture, 1536x1872 lossless WebP (162 bytes).
+const sprite = { enabled: true, slug: 'same', displayName: 'Owned', mime: 'image/webp', spritesheetBase64: "UklGRpoAAABXRUJQVlA4TI0AAAAv/8XTAQcQ/Y/+BwAU6f9/iuh/6n//+9///ve///3vf//73//+97///e9///vf//73v//973//+9///ve///3vf//73//+97///e9///vf//73v//973//+9///ve///3vf//73//+97///e9///vf//73v//973//+9///ve///3vf//73//+97//qwAA", frameW: 192, frameH: 208, framesPerState: 6, stateRows: ['idle','running-right','running-left','waving','jumping','failed','waiting','running','review'], loopMs: 1100 }
+
+it('serializes across preview remounts and drops an evicted reply before preparing image bytes', async () => {
+  const publisher = createPetCharacterPublisher('loader-remount')
+  const prepare = vi.fn(publisher.prepareSprite!)
+  let finishOld!: (value: unknown) => void
+  const oldRead = vi.fn(() => new Promise(resolve => { finishOld = resolve }))
+  const oldChanged = vi.fn(), nextChanged = vi.fn()
+  const old = createCharacterSpriteLoader(oldChanged, prepare)
+  old.update([{ key: 'same-key', read: oldRead }])
+  await Promise.resolve()
+  expect(oldRead).toHaveBeenCalledOnce()
+  old.dispose()
+  const freshRead = vi.fn(async () => ({ ...sprite, displayName: 'New generation' }))
+  const fresh = createCharacterSpriteLoader(nextChanged, prepare)
+  fresh.update([{ key: 'same-key', read: freshRead }])
+  await Promise.resolve()
+  expect(freshRead).not.toHaveBeenCalled()
+  finishOld({ ...sprite, displayName: 'Retired generation' })
+  await vi.waitFor(() => expect(fresh.get('same-key')?.displayName).toBe('New generation'))
+  expect(old.get('same-key')).toBeNull()
+  expect(prepare).toHaveBeenCalledOnce()
+  expect(oldChanged).toHaveBeenCalledOnce()
+  expect(Object.isFrozen(fresh.get('same-key'))).toBe(true)
+  fresh.dispose(); publisher.dispose()
+})
+
+it('retains only five current identities, reuses unchanged reads, evicts old atlases and does not retry an unavailable assignment', async () => {
+  const publisher = createPetCharacterPublisher('loader-bounds')
+  const changed = vi.fn()
+  const loader = createCharacterSpriteLoader(changed, publisher.prepareSprite!)
+  const reads = Array.from({ length: 7 }, (_, i) => vi.fn(async () => ({ ...sprite, displayName: `Owned ${i}` })))
+  const targets = reads.map((read, i) => ({ key: String(i), read }))
+  loader.update(targets)
+  await vi.waitFor(() => expect(loader.get('5')?.displayName).toBe('Owned 5'))
+  expect(reads.slice(0, 6).every(read => read.mock.calls.length === 1)).toBe(true)
+  expect(reads[6]).not.toHaveBeenCalled()
+  expect(changed.mock.calls.every(([snapshot]) => snapshot.size <= 6)).toBe(true)
+  loader.update(targets)
+  await Promise.resolve()
+  expect(reads.slice(0, 6).every(read => read.mock.calls.length === 1)).toBe(true)
+  loader.update([targets[6]])
+  expect(loader.get('0')).toBeNull()
+  await vi.waitFor(() => expect(loader.get('6')?.displayName).toBe('Owned 6'))
+  loader.update([targets[0]])
+  await vi.waitFor(() => expect(reads[0]).toHaveBeenCalledTimes(2))
+  const missing = vi.fn(async () => ({ enabled: false }))
+  loader.update([{ key: 'missing', read: missing }])
+  await vi.waitFor(() => expect(missing).toHaveBeenCalledOnce())
+  loader.update([{ key: 'missing', read: missing }])
+  await Promise.resolve()
+  expect(missing).toHaveBeenCalledOnce()
+  expect(loader.get('missing')).toBeNull()
+  loader.dispose();publisher.dispose()
+})
+
+it('rearms only failed reads with the latest reader and leaves a pending retry alone', async () => {
+  const publisher = createPetCharacterPublisher('loader-recovery')
+  const loader = createCharacterSpriteLoader(vi.fn(), publisher.prepareSprite!)
+  const timedOut = vi.fn(async () => {throw new Error('Request timed out')})
+  const ready = vi.fn(async () => sprite)
+  const missing = vi.fn(async () => ({ enabled: false }))
+  const older = vi.fn(async () => {throw new Error('unknown method: pet.sprite')})
+  const initial = [{ key: 'timed-out', read: timedOut }, { key: 'ready', read: ready },
+    { key: 'missing', read: missing }, { key: 'older', read: older }]
+  let resolveRetry!: (value: unknown) => void
+  const recovered = vi.fn(() => new Promise(resolve => {resolveRetry = resolve}))
+
+  try {
+    loader.update(initial)
+    await vi.waitFor(() => expect(older).toHaveBeenCalledOnce())
+    loader.update([{ key: 'timed-out', read: recovered }, ...initial.slice(1)])
+    expect(timedOut).toHaveBeenCalledOnce()
+    expect(recovered).not.toHaveBeenCalled()
+    expect(loader.get('timed-out')).toBeNull()
+
+    loader.retryFailed()
+    await vi.waitFor(() => expect(recovered).toHaveBeenCalledOnce())
+    loader.retryFailed()
+    resolveRetry({ ...sprite, displayName: 'Recovered' })
+    await vi.waitFor(() => expect(loader.get('timed-out')?.displayName).toBe('Recovered'))
+    loader.retryFailed()
+    expect(loader.get('ready')?.displayName).toBe('Owned')
+    expect(loader.get('missing')).toBeNull()
+    expect(loader.get('older')).toBeNull()
+    for (const read of [timedOut, recovered, ready, missing, older]) {expect(read).toHaveBeenCalledOnce()}
+  } finally {
+    loader.dispose()
+    publisher.dispose()
+  }
+})
diff --git a/apps/desktop/src/plugins/hermes-bots/character-sprites.ts b/apps/desktop/src/plugins/hermes-bots/character-sprites.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c920b85d063aa926f7dc4b7d65899cf4aa12ae7d
--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/character-sprites.ts
@@ -0,0 +1,87 @@
+import { atom, MAX_PREVIEW_CHARACTERS, type PetCharacter } from '@hermes/plugin-sdk'
+
+// eslint-disable-next-line no-restricted-imports -- the bundled Characters loader distinguishes older backends from failed reads.
+import { isMissingRpcMethod } from '@/lib/gateway-rpc'
+
+export const $characterSpriteRefresh = atom<{ connectionId: string; profile: string } | null>(null)
+
+const failedRead = Symbol('failed sprite read')
+
+type Sprite = NonNullable<PetCharacter['sprite']>
+export interface CharacterSpriteTarget {
+  key: string
+  read: () => Promise<unknown>
+}
+let readTail: Promise<void> = Promise.resolve()
+
+interface Entry {
+  read: CharacterSpriteTarget['read']
+  value?: Sprite | null | typeof failedRead
+}
+
+// shortcut: atlas snapshots last one preview; watch pet.changed when persistent tracking ships.
+/** One serial read across remounts, bounded current identities; evicted replies never publish. */
+export function createCharacterSpriteLoader(onChange: (sprites: Map<string, Sprite | null>) => void, prepare: (input: unknown) => Sprite | null) {
+  let entries = new Map<string, Entry>(), running = false, disposed = false
+  const get = (key: string) => {
+    const value = entries.get(key)?.value
+
+    return value === failedRead ? null : value ?? null
+  }
+  const publish = () => onChange(new Map([...entries.keys()].map(key => [key, get(key)])))
+
+  const drain = async () => {
+    if (running || disposed) {return}
+    running = true
+
+    try {
+      while (!disposed) {
+        const next = [...entries].find(([, entry]) => entry.value === undefined)
+
+        if (!next) {break}
+        const [key, entry] = next
+        entry.value = null
+        let value: Entry['value'] = null
+
+        try {
+          const read = readTail.then(() => !disposed && entries.get(key) === entry ? entry.read() : null)
+          readTail = read.then(() => undefined, () => undefined)
+          const reply = await read.catch(error => isMissingRpcMethod(error) ? null : failedRead)
+
+          if (disposed || entries.get(key) !== entry) {continue}
+          value = reply === failedRead ? failedRead : reply === null ? null : prepare(reply)
+        } catch { /* An invalid atlas stays unavailable. */ }
+
+        if (!disposed && entries.get(key) === entry) {entry.value = value; publish()}
+      }
+    } finally {running = false}
+  }
+
+  return {
+    get,
+    retryFailed: () => {
+      for (const entry of entries.values()) {
+        if (entry.value === failedRead) {entry.value = undefined}
+      }
+
+      void drain()
+    },
+    update: (targets: CharacterSpriteTarget[]) => {
+      if (disposed) {return}
+      const next = new Map<string, Entry>()
+
+      for (const target of targets.slice(0, MAX_PREVIEW_CHARACTERS)) {
+        const entry = entries.get(target.key) ?? { read: target.read }
+
+        entry.read = target.read
+        next.set(target.key, entry)
+      }
+
+      if (next.size === entries.size && [...next].every(([key, entry]) => entries.get(key) === entry)) {return}
+      entries = next
+      publish()
+      void drain()
+    },
+    dispose: () => {disposed = true; entries.clear()}
+  }
+}
