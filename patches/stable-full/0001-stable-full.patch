+    assert counts == [2, 1] and mgr.state.waiting_on_kanban_cards == 1 and mgr.is_waiting()
+    assert mgr.state.turns_used == 2
+
+
+def test_new_turn_still_runs_quality_gates_and_preserves_turn_budget(fleet, monkeypatch):
