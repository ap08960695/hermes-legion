+def test_corrupt_peer_is_unavailable_without_backup_or_yaml_content(fleet):
+    from hermes_cli.profile_routing import routing_snapshot
+    (fleet/'profiles/action/config.yaml').write_text('bot_workflow: [private-invalid-sentinel')
+    result=routing_snapshot()
+    rows={x['name']:x for x in result['profiles']}
+    assert rows['think']['pair_status']=='invalid' and rows['think']['dispatch_admitted'] is False
+    assert rows['action']['pair_status']=='unreadable'
+    assert not list(fleet.rglob('*.corrupt.*'))
+    assert 'private-invalid-sentinel' not in json.dumps(result)
+
