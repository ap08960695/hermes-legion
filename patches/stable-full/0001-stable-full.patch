--- /dev/null
+++ b/apps/desktop/src/plugins/hermes-bots/group-membership-save.test.tsx
@@ -0,0 +1,205 @@
+import type * as HermesSdk from '@hermes/plugin-sdk'
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { GroupDialog } from './create-dialog'
+import { $botMeta, $lastRoster, botMetaKey } from './data'
+import { $groupChats } from './group-chat'
+import { scriptedStorage } from './group-test-utils'
+import { translateBotsIn } from './i18n-test-helper'
+import { setPluginCtx } from './shared'
+import type { RosterRow } from './types'
+
+const { notify, requestProfile, settings } = vi.hoisted(() => ({ notify: vi.fn(), requestProfile: vi.fn(), settings: { locale: 'en' } }))
+
+vi.mock('@hermes/plugin-sdk', async importOriginal => {
+  const sdk = await importOriginal<typeof HermesSdk>()
+
+  return {
+    ...sdk,
+    host: { ...sdk.host, notify, requestProfile },
+    usePluginI18n: () => translateBotsIn(settings.locale)
+  }
+})
+
+const bot: RosterRow = { name: 'reviewer', connectionId: 'local', targetProfile: 'reviewer', sourceScoped: true }
+const warning = 'Group memberships changed on this device, but could not be saved to Hermes. Try the change again to sync other devices.'
+type Outcome = 'failed' | 'persisted' | 'unsupported'
+let outcomes: Outcome[]
+let gate: Promise<void> | null
+let writes: number
+let server: Record<string, unknown>
+
+function setupGroups(groups: string[]) {
+  server = { title: 'Reviewer', groups, group: groups[0] || null }
+  $botMeta.set({ [botMetaKey(bot)]: { ...server } })
+  $lastRoster.set([bot])
+}
+
+function join() {
+  fireEvent.change(screen.getByRole('textbox'), { target: { value: 'Research' } })
+  fireEvent.click(screen.getByRole('button', { name: 'Create & join' }))
+}
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  settings.locale = 'en'
+  $groupChats.set({})
+  setPluginCtx(scriptedStorage(new Map()))
+  setupGroups(['Existing'])
+  outcomes = ['persisted']
+  gate = null
+  writes = 0
+  requestProfile.mockImplementation(async (route, method, params) => {
+    expect(route.connectionId).toBe('local')
+    expect(route.targetProfile).toBe('reviewer')
+
+    if (method === 'profiles.list') {
+      return { profiles: [{ name: 'reviewer', ui_meta: { 'hermes-bots': { ...server } }, ui_meta_revisions: { 'hermes-bots': writes } }] }
+    }
+
+    expect(method).toBe('profiles.configure')
+    expect(params.name).toBe('reviewer')
+    const outcome = outcomes[Math.min(writes++, outcomes.length - 1)]
+    await gate
+
+    if (outcome === 'unsupported') {
+      return {}
+    }
+
+    if (outcome === 'persisted') {
+      server = { ...params.ui_meta['hermes-bots'] }
+    }
+
+    return { ok: outcome === 'persisted', applied: { ui_meta: outcome === 'persisted' } }
+  })
+})
+
+afterEach(cleanup)
+
+describe('Manage groups persistence feedback', () => {
+  it('waits for the save and blocks another mutation before reporting success', async () => {
+    let release!: () => void
+    gate = new Promise(resolve => { release = resolve })
+    render(<GroupDialog bot={bot} onClose={vi.fn()} />)
+    join()
+    await waitFor(() => expect(writes).toBe(1))
+
+    expect((screen.getByRole('textbox') as HTMLInputElement).value).toBe('Research')
+    expect((screen.getByRole('checkbox', { name: 'Existing' }) as HTMLButtonElement).disabled).toBe(true)
+    expect((screen.getByRole('button', { name: 'Remove from all groups' }) as HTMLButtonElement).disabled).toBe(true)
+    fireEvent.click(screen.getByRole('button', { name: 'Create & join' }))
+    expect(notify).not.toHaveBeenCalled()
+
+    await act(async () => { release(); await gate })
+    await waitFor(() => expect((screen.getByRole('textbox') as HTMLInputElement).value).toBe(''))
+    expect(writes).toBe(1)
+    expect(server.groups).toEqual(['Existing', 'Research'])
+    expect(server.title).toBe('Reviewer')
+    expect(notify).toHaveBeenCalledWith({ kind: 'info', message: 'Reviewer added to “Research”' })
+  })
+
+  it('keeps a failed join local, shows the warning, and confirms an explicit recovery save', async () => {
+    outcomes = ['failed', 'persisted']
+    render(<GroupDialog bot={bot} onClose={vi.fn()} />)
+    join()
+
+    expect((await screen.findByRole('alert')).textContent).toContain(warning)
+    expect((screen.getByRole('textbox') as HTMLInputElement).value).toBe('Research')
+    expect((screen.getByRole('checkbox', { name: 'Research' }) as HTMLButtonElement).getAttribute('aria-checked')).toBe('true')
+    expect($botMeta.get()[botMetaKey(bot)].groups).toEqual(['Existing', 'Research'])
+    expect(server.groups).toEqual(['Existing'])
+    expect(notify).not.toHaveBeenCalled()
+
+    fireEvent.click(screen.getByRole('button', { name: 'Create & join' }))
+    await waitFor(() => expect(screen.queryByRole('alert')).toBeNull())
+    expect(server.groups).toEqual(['Existing', 'Research'])
+    expect((screen.getByRole('textbox') as HTMLInputElement).value).toBe('')
+  })
+
+  it('warns when an unchecked membership only changed on this device', async () => {
+    outcomes = ['failed', 'persisted']
+    render(<GroupDialog bot={bot} onClose={vi.fn()} />)
+    fireEvent.click(screen.getByRole('checkbox', { name: 'Existing' }))
+
+    expect((await screen.findByRole('alert')).textContent).toContain(warning)
+    expect($botMeta.get()[botMetaKey(bot)].groups).toEqual([])
+    expect(server.groups).toEqual(['Existing'])
+    expect(notify).not.toHaveBeenCalled()
+
+    fireEvent.click(screen.getByRole('button', { name: 'Retry' }))
+    await waitFor(() => expect(screen.queryByRole('alert')).toBeNull())
+    expect(server.groups).toEqual([])
+    expect(writes).toBe(2)
+  })
+
+  it('keeps an explicit failure visible when the next save has no confirmation', async () => {
+    outcomes = ['failed', 'unsupported']
+    render(<GroupDialog bot={bot} onClose={vi.fn()} />)
+    join()
+    await screen.findByRole('alert')
+    fireEvent.click(screen.getByRole('button', { name: 'Create & join' }))
+
+    await waitFor(() => expect(writes).toBe(2))
+    await waitFor(() => expect((screen.getByRole('textbox') as HTMLInputElement).disabled).toBe(false))
+    expect(screen.getByRole('alert').textContent).toContain(warning)
+    expect(server.groups).toEqual(['Existing'])
+  })
+
+  it('retries the failed membership without clearing a different group name typed later', async () => {
+    outcomes = ['failed', 'persisted']
+    render(<GroupDialog bot={bot} onClose={vi.fn()} />)
+    join()
+    await screen.findByRole('alert')
+    fireEvent.change(screen.getByRole('textbox'), { target: { value: 'Other draft' } })
+    fireEvent.click(screen.getByRole('button', { name: 'Retry' }))
+
+    await waitFor(() => expect(screen.queryByRole('alert')).toBeNull())
+    expect(server.groups).toEqual(['Existing', 'Research'])
+    expect((screen.getByRole('textbox') as HTMLInputElement).value).toBe('Other draft')
+  })
+
+  it('uses the active plugin locale for the persistence warning', async () => {
+    settings.locale = 'ja'
+    outcomes = ['failed']
+    render(<GroupDialog bot={bot} onClose={vi.fn()} />)
+    join()
+
+    expect((await screen.findByRole('alert')).textContent).toContain('このデバイスのグループ参加状況は変更されましたが、Hermesに保存できませんでした。')
+  })
+
+  it('warns if the final remove-all state was not saved', async () => {
+    setupGroups(['Existing', 'Second'])
+    outcomes = ['persisted', 'failed']
+    render(<GroupDialog bot={bot} onClose={vi.fn()} />)
+    fireEvent.click(screen.getByRole('button', { name: 'Remove from all groups' }))
+
+    expect((await screen.findByRole('alert')).textContent).toContain(warning)
+    expect($botMeta.get()[botMetaKey(bot)].groups).toEqual([])
+    expect(server.groups).toEqual(['Second'])
+    expect(writes).toBe(2)
+  })
+
+  it('accepts a later confirmed full membership save after an earlier remove failed', async () => {
+    setupGroups(['Existing', 'Second'])
+    outcomes = ['failed', 'persisted']
+    render(<GroupDialog bot={bot} onClose={vi.fn()} />)
+    fireEvent.click(screen.getByRole('button', { name: 'Remove from all groups' }))
+
+    await waitFor(() => expect(server.groups).toEqual([]))
+    expect($botMeta.get()[botMetaKey(bot)].groups).toEqual([])
+    expect(screen.queryByRole('alert')).toBeNull()
+  })
+
+  it('keeps the older-gateway local fallback without an explicit-save failure', async () => {
+    outcomes = ['unsupported']
+    render(<GroupDialog bot={bot} onClose={vi.fn()} />)
+    join()
+
+    await waitFor(() => expect(writes).toBe(1))
+    await waitFor(() => expect(notify).toHaveBeenCalled())
+    expect($botMeta.get()[botMetaKey(bot)].groups).toEqual(['Existing', 'Research'])
+    expect(server.groups).toEqual(['Existing'])
+    expect(screen.queryByRole('alert')).toBeNull()
+  })
+})
