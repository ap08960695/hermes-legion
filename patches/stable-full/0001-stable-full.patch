+"""Repeated raw search must not retain per-row native Blob bookkeeping."""
+import gc
+import sqlite3
+import tracemalloc
+
+from hermes_state_global_recall import GlobalSearch
+
+
+def test_repeated_raw_search_retains_bounded_memory_with_connection_open():
+    conn = sqlite3.connect(':memory:')
+    conn.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, tool_calls TEXT)')
+    conn.execute('INSERT INTO messages VALUES(1, ?)', ('ordinary ' * 160,))
+    search = GlobalSearch(conn, [('absent', False)])
+    for _ in range(100):
+        assert search.raw_contains(1, 'tool_calls', 'absent') == 0
+    gc.collect()
+    tracemalloc.start()
+    try:
+        for _ in range(20_000):
+            assert search.raw_contains(1, 'tool_calls', 'absent') == 0
+        gc.collect()
+        retained, _ = tracemalloc.get_traced_memory()
+        assert retained < 256 * 1024
+        assert conn.execute('SELECT count(*) FROM messages').fetchone()[0] == 1
+    finally:
+        tracemalloc.stop()
+        search.close()
+        conn.close()
