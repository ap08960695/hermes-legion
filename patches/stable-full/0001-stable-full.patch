+"""Scoped AX reads and single-use semantic refs; no physical input or raw logging."""
+from __future__ import annotations
+
+import json
+import re
+from itertools import count
+from threading import Lock, RLock
+from uuid import uuid4
+
+from tools.computer_use import agent_desktop as driver
+from tools.computer_use.backend import ActionResult, CaptureResult, ComputerUseBackend, UIElement
+
+# An approved old index must never bind to a later capture or backend instance.
+_indices = count((uuid4().int >> 80) + 1)
+_index_lock = Lock()
+
+
+def _host_placement():
+    from tools.bot_desktop import placement
+    try:
+        return placement.resolve().where == placement.GATEWAY
+    except Exception:
+        return False
+
+
+def binary_available():
+    try:
+        return _host_placement() and bool(driver.resolve_agent_desktop(probe_npm=False))
+    except Exception:
+        return False
+
+
+class AgentDesktopBackend(ComputerUseBackend):
+    def __init__(self, *, permission_mode='standard'):
+        if permission_mode not in {'standard', 'unrestricted'}:
+            raise ValueError('agent-desktop AX provider does not implement bounded permissions')
+        self._binary = None
+        self._session = None
+        self._lock = RLock()
+        self._targets = {}
+        self._capture_epoch = None
+        self._last_app = None
+
+    def start(self):
+        with self._lock:
+            self.stop()
+            if not _host_placement():
+                raise RuntimeError('agent-desktop AX provider supports gateway-host placement only')
+            try:
+                binary = driver.resolve_agent_desktop()
+                if not binary:
+                    raise ValueError('Missing binary')
+            except Exception:
+                raise RuntimeError('agent-desktop not found; check computer_use.agent_desktop.path') from None
+            self._binary = binary
+            self._session = 'hermes-' + uuid4().hex
+
+    def stop(self):
+        with self._lock:
+            self._binary = self._session = self._last_app = None
+            self._targets = {}
+            self._capture_epoch = None
+
+    def is_available(self):
+        return binary_available()
+
+    def capture(self, mode='som', app=None, pid=None, window_id=None):
+        from tools.bot_desktop import lease
+        with self._lock:
+            self._targets = {}
+            self._capture_epoch = self._last_app = None
+            epoch = lease.assert_agent_may_act().epoch
+            cap, targets = self._capture(mode, app, pid, window_id)
+            if lease.assert_agent_may_act().epoch != epoch:
+                raise RuntimeError('Desktop lease changed; capture fresh state')
+            self._targets, self._capture_epoch, self._last_app = targets, epoch, cap.app
+            return cap
+
+    def _capture(self, mode, app, pid, window_id):
+        if self._binary is None:
+            raise RuntimeError('agent-desktop AX backend is not started')
+        if not _host_placement():
+            raise RuntimeError('agent-desktop AX provider supports gateway-host placement only')
+        if mode != 'ax' or pid is not None:
+            raise ValueError('agent-desktop AX capture requires mode=ax without pid')
+        if not isinstance(app, str) or not app.strip() or len(app) > 256 or '\x00' in app:
+            raise ValueError('agent-desktop AX capture requires an explicit application name')
+        app = app.strip()
+        selector = ['--app', app]
+        if window_id is not None:
+            if type(window_id) is not int or not 0 < window_id < 2**53:
+                raise ValueError('agent-desktop AX window_id must be a positive exact JSON integer')
+            selector.extend(['--window-id', f'w-{window_id}'])
+        failure_message = 'agent-desktop AX snapshot failed; check target, permissions and protocol'
+        try:
+            result = driver.bounded_probe_run(
+                [self._binary, 'snapshot', *selector, '--session', self._session],
+                timeout=10, env=driver._environment())
+            if result is None or len(result.stdout.encode('utf-8')) > 1024 * 1024:
+                raise ValueError('Probe failed')
+            envelope = json.loads(result.stdout)
+            if isinstance(envelope, dict) and envelope.get('version') == '2.6' and envelope.get('command') == 'snapshot' and envelope.get('ok') is False:
+                error = envelope.get('error')
+                if isinstance(error, dict) and error.get('code') == 'ACTION_NOT_SUPPORTED' and isinstance(error.get('details'), dict) and error['details'].get('kind') == 'window_without_accessibility_element':
+                    failure_message = ('agent-desktop AX snapshot failed: target window is not exposed to accessibility; '
+                                       'inspect the target app accessibility support before capturing again')
+            if result.returncode != 0 or not isinstance(envelope, dict) or envelope.get('version') != '2.6' or envelope.get('ok') is not True or envelope.get('command') != 'snapshot':
+                raise ValueError('Invalid envelope')
+            data = envelope['data']
+            canonical_app = data['app']
+            if (not isinstance(canonical_app, str) or not canonical_app.strip() or len(canonical_app) > 256
+                    or '\x00' in canonical_app or data['complete'] is not True
+                    or data.get('identity_unproven', False) is not False
+                    or (window_id is None and canonical_app != app)):
+                raise ValueError('Incomplete or wrong target')
+            window = data['window']
+            if not isinstance(window['id'], str) or not window['id'] or not isinstance(window['title'], str):
+                raise ValueError('Invalid window')
+            if window_id is not None and window['id'] != f'w-{window_id}':
+                raise ValueError('Wrong window')
+            snapshot_id = data['snapshot_id']
+            if not isinstance(snapshot_id, str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,128}', snapshot_id):
+                raise ValueError('Invalid snapshot')
+            stack = [(data['tree'], 0)]
+            elements, refs, targets = [], set(), {}
+            count = 0
+            while stack:
+                node, depth = stack.pop()
+                count += 1
+                if count > 2048 or depth > 64 or not isinstance(node, dict):
+                    raise ValueError('Invalid tree')
+                role, name, value = node['role'], node.get('name', ''), node.get('value')
+                if not isinstance(role, str) or not role or len(role) > 128 or not isinstance(name, str):
+                    raise ValueError('Invalid node')
+                ref = node.get('ref_id')
+                if ref is not None:
+                    if not isinstance(ref, str) or not re.fullmatch('@' + re.escape(snapshot_id) + r':e[0-9]+', ref) or ref in refs:
+                        raise ValueError('Invalid ref')
+                    refs.add(ref)
+                label = name
+                if isinstance(value, str) and value and value != name:
+                    label = f'{name}: {value}' if name else value
+                if label or ref:
+                    with _index_lock:
+                        index = next(_indices)
+                    if index >= 2**53:
+                        raise ValueError('Element index range exhausted')
+                    elements.append(UIElement(index=index, role=role, label=label, app=canonical_app, element_token=ref))
+                    if ref:
+                        actions = node.get('available_actions', [])
+                        if not isinstance(actions, list) or any(not isinstance(a, str) for a in actions):
+                            raise ValueError('Invalid actions')
+                        permitted = {a for a in actions if a in {'Click', 'SetValue', 'TypeText'}}
+                        if role == 'scrollarea':
+                            permitted.add('Scroll')
