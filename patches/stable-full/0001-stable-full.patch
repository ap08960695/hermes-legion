+
+@pytest.mark.require_symlinks
+def test_preflight_uses_cycle_safe_discovery_and_preserves_shared_links(skill_fleet, tmp_path, monkeypatch):
+    from tools.kanban_tools import _skills_available_for
+    root = skill_fleet
+    _skill(root / 'fixture-live')
+    outside = tmp_path / 'shared'
+    _skill(outside / 'fixture-shared')
+    (root / 'shared').symlink_to(outside, target_is_directory=True)
+    (root / 'again-a').symlink_to(root, target_is_directory=True)
+    (root / 'again-b').symlink_to(root, target_is_directory=True)
+    visits = []
+    real = os.scandir
+    def scan(path):
+        if isinstance(path, (str, os.PathLike)) and Path(path).is_relative_to(root):
+            visits.append(str(path))
+            assert len(visits) <= 64, 'preflight repeatedly followed an ancestor cycle'
+        return real(path)
+    monkeypatch.setattr(os, 'scandir', scan)
+    wanted = ['fixture-live', 'fixture-shared']
+    assert _skills_available_for('worker', wanted) == (wanted, [])
