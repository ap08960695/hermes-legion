+++ b/hermes_cli/update_preservation_io.py
@@ -0,0 +1,178 @@
+"""Private Git-backed source capsules; shared by the updater and its stdlib-only recovery."""
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+
+from hermes_cli.update_custody import run_git
+from hermes_cli.update_host_obligation import replace_bytes
+
+
+def git(root, *args, env=None, data=None):
+    result = run_git(['git', '--no-replace-objects'], list(args), cwd=str(root),
+                     env=env, input=data, capture_output=True, timeout=120)
+    if result.returncode:
+        raise OSError(f'Preservation Git operation failed: {args[0]}: '
+                      + result.stderr.decode('utf-8', 'replace')[:1000])
+    return result.stdout
+
+
+def git_dir(root):
+    from hermes_cli._early_recovery import _git_dir
+
+    return _git_dir(Path(root)).resolve()
+
+
+def capsule(root, fields=None):
+    directory = git_dir(root)
+    if fields is None:
+        marker = directory / 'hermes-update-pull'
+        if not marker.exists():
+            return None
+        fields = dict(line.partition('=')[::2] for line in marker.read_text().splitlines())
+    nonce = fields.get('preserve', '')
+    if not nonce:
+        return None
+    if not re.fullmatch('[0-9a-f]{32}', nonce):
+        raise OSError('Invalid source preservation capsule identity')
+    path = directory / 'hermes-preservation' / nonce
+    if path.is_symlink() or path.parent.is_symlink():
+        raise OSError('Source preservation capsule is aliased')
+    state = json.loads((path / 'state.json').read_text())
+    if state.get('version') != 1 or state.get('root') != str(Path(root).resolve()):
+        raise OSError('Source preservation capsule belongs to another checkout')
+    return path, state
+
+
+def save(path, state):
+    replace_bytes(path / 'state.json', json.dumps(state, sort_keys=True).encode())
+
+
+def indexed_tree(root, index):
+    env = {**os.environ, 'GIT_INDEX_FILE': str(index)}
+    return git(root, 'write-tree', env=env).decode().strip()
+
+
+def inspect_index(root, scratch):
+    raw = read_index(root)
+    if raw is None:
+        raise OSError('Source index is absent')
+    replace_bytes(scratch, raw)
+    return indexed_tree(root, scratch)
+
+
+def capture_tree(root, index):
+    """An alternate index reads the full nonignored source without changing the user's index."""
+    env = {**os.environ, 'GIT_INDEX_FILE': str(index)}
+    git(root, 'read-tree', 'HEAD', env=env)
+    git(root, 'add', '-A', '--', '.', env=env)
+    return indexed_tree(root, index)
+
+
+def pin_tree(root, tree, ref, parents):
+    identity = {**os.environ, 'GIT_AUTHOR_NAME': 'Hermes Source Recovery',
+                'GIT_AUTHOR_EMAIL': 'recovery@example.invalid',
+                'GIT_COMMITTER_NAME': 'Hermes Source Recovery',
+                'GIT_COMMITTER_EMAIL': 'recovery@example.invalid'}
+    args = ['commit-tree', tree]
+    for parent in parents:
+        args.extend(['-p', parent])
+    commit = git(root, *args, env=identity, data=b'Private local source recovery\n').decode().strip()
+    git(root, 'update-ref', ref, commit)
+    return commit
+
+
+def tree_entries(root, tree):
+    entries = {}
+    for entry in git(root, 'ls-tree', '-r', '-z', tree).split(b'\0'):
+        if not entry:
+            continue
+        meta, name = entry.split(b'\t', 1)
+        mode, kind, oid = meta.decode().split()
+        if kind != 'blob':
+            raise OSError('Source preservation does not support submodules')
+        entries[os.fsdecode(name)] = (mode, oid)
+    return entries
+
+
+def safe_path(root, name):
+    relative = Path(name)
+    if relative.is_absolute() or '..' in relative.parts or '.git' in relative.parts:
+        raise OSError('Invalid source capsule path')
+    path = Path(root) / relative
+    if any(parent.is_symlink() for parent in path.parents
+           if parent != root and root in parent.parents):
+        raise OSError(f'Refusing source recovery through a symlink: {name}')
+    return path
+
+
+def read_index(root):
+    try:
+        return (git_dir(root) / 'index').read_bytes()
+    except FileNotFoundError:
+        return None
+
+
+def restore_obligations(state):
+    """Compare-and-restore this update's private records; release only its shared owner stake."""
+    import base64
+
+    from hermes_cli.update_host_obligation import release_host_obligation
+
+    for record in state.get('obligations', []):
+        path = Path(record['path'])
+        try:
+            current = path.read_bytes()
+        except FileNotFoundError:
+            current = None
+        armed = base64.b64decode(record['armed']) if record['armed'] is not None else None
+        if current != armed:
+            continue
+        if record['before'] is None:
+            path.unlink(missing_ok=True)
+        else:
+            replace_bytes(path, base64.b64decode(record['before']))
+    if state.get('host_owner'):
+        release_host_obligation(state['host_owner'], path=Path(state['host_path']))
+
+
+def keep_partial_source(root, capsule, state, name):
+    """Keep an ambiguous partial file before recovery removes/replaces it; bounded-memory copy."""
+    import hashlib
+    import shutil
+    import tempfile
+
+    source = safe_path(root, name)
+    before = source.lstat()
+    target = safe_path(capsule / 'kept-added', name)
+    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    if target.is_symlink():
+        raise OSError('Partial-source archive is aliased; recovery refused')
+    source_fd = os.open(source, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
+    with os.fdopen(source_fd, 'rb') as incoming:
+        if os.fstat(incoming.fileno()) != before:
+            raise OSError('Partial source changed before preservation')
+        fd, temporary = tempfile.mkstemp(prefix='.partial-', dir=target.parent)
+        temporary = Path(temporary)
+        try:
+            with os.fdopen(fd, 'wb') as outgoing:
+                shutil.copyfileobj(incoming, outgoing, length=128 * 1024)
+                outgoing.flush()
+                os.fsync(outgoing.fileno())
+            if target.exists():
+                with target.open('rb') as previous, temporary.open('rb') as new:
+                    if hashlib.file_digest(previous, 'sha256').digest() != hashlib.file_digest(new, 'sha256').digest():
+                        raise OSError('Another partial-source copy is already retained; neither copy was removed')
+            else:
+                os.replace(temporary, target)
+        finally:
+            temporary.unlink(missing_ok=True)
+    after = source.lstat()
+    fields = ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns')
+    if any(getattr(before, field) != getattr(after, field) for field in fields):
+        raise OSError('Partial source changed while preserving; recovery stopped before replacement')
+    state['kept_files'] = sorted({*state.get('kept_files', []), name})
+    save(capsule, state)
