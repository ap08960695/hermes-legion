+class _Unicode61:
+    """Query the actual runtime tokenizer; cache only bounded codepoint metadata."""
+
+    def __init__(self):
+        self.conn = sqlite3.connect(':memory:')
+        self.conn.execute('CREATE VIRTUAL TABLE probe USING fts5(body)')
+        self.conn.execute("CREATE VIRTUAL TABLE vocab USING fts5vocab(probe, 'instance')")
+        self.cache = OrderedDict()
+
+    def tokens(self, text: str) -> list[str]:
+        self.conn.execute('DELETE FROM probe')
+        self.conn.execute('INSERT INTO probe(body) VALUES(?)', (text,))
+        return [row[0] for row in self.conn.execute('SELECT term FROM vocab ORDER BY offset')]
+
+    def classify(self, char: str) -> tuple[bool, str]:
+        code = ord(char)
+        if code < 128:
+            if 'A' <= char <= 'Z':
+                return True, chr(code + 32)
+            if 'a' <= char <= 'z' or '0' <= char <= '9':
+                return True, char
+            return False, ''
+        if 0xD800 <= code <= 0xDFFF:
+            return False, ''
+        if char in self.cache:
+            self.cache.move_to_end(char)
+            return self.cache[char]
+        tokens = self.tokens('a' + char + 'b')
+        if len(tokens) == 1 and tokens[0].startswith('a') and tokens[0].endswith('b'):
+            result = (True, tokens[0][1:-1])
+        elif tokens == ['a', 'b']:
+            result = (False, '')
+        else:
+            raise UnsupportedJSON('SQLite tokenizer produced an unsupported codepoint transformation')
+        self.cache[char] = result
+        if len(self.cache) > 4096:
+            self.cache.popitem(last=False)
+        return result
+
+    def close(self):
+        self.conn.close()
+
+
+class _OrderedPrefilter:
+    """Conservative, bounded necessary-character checks for validated JSON.
