+@pytest.mark.platforms('linux')
+def test_native_sqlite_allocator_counter_observes_an_isolated_allocation():
+    from gateway import runtime_memory
+    before = runtime_memory.collect_runtime_memory()['sqlite']
+    if not before['available']:
+        pytest.skip('This SQLite build does not expose allocator tracking')
+    with sqlite3.connect(':memory:') as conn:
+        conn.execute('CREATE TABLE allocation(value BLOB)')
+        conn.executemany('INSERT INTO allocation VALUES(?)', [(bytes(8192),)] * 256)
+        after = runtime_memory.collect_runtime_memory()['sqlite']
+        assert after['current_bytes'] > before['current_bytes'] + 1_000_000
+        assert after['highwater_bytes'] >= after['current_bytes']
