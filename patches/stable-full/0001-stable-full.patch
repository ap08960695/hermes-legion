@@ -0,0 +1,96 @@
+"""Bot usage follows the scoped named chat's resolved row, never recency or a worker sum."""
+import pytest
+
+from gateway.session_group_controls import _read_bot_sessions
+from hermes_state import SessionDB
+import tui_gateway.server as srv
+from tui_gateway.contracts.profiles_vault_complete_foreign_subagents import ProfileCanonicalSession
+
+USAGE_KEYS = {'input_tokens', 'output_tokens', 'estimated_cost_usd', 'actual_cost_usd', 'model'}
+
+
+def _write(db, sid, *, model, tokens, estimate, actual, status='estimated', parent=None, source='local', stamp=2000):
+    db.create_session(sid, source, model=model, user_id='uid:desk', chat_id='local-' + sid,
+                      parent_session_id=parent, model_config={'api_key': 'private-config-canary'})
+    db.update_token_counts(sid, input_tokens=tokens[0], output_tokens=tokens[1],
+                           estimated_cost_usd=estimate, actual_cost_usd=actual,
+                           cost_status=status, absolute=True, source=source)
+    db.touch_session_activity(sid, ts=stamp, description='Stored test observation')
+    db.append_message(sid, 'assistant', sid + ' preview', timestamp=stamp)
+
+
+@pytest.mark.parametrize('compressed', [False, True])
+def test_scoped_canonical_usage_reads_current_row_without_sidechat_or_worker_rollup(tmp_path, compressed):
+    for index, profile in enumerate(['alpha', 'beta']):
+        home = tmp_path / profile
+        home.mkdir()
+        root, tip = profile + '-root', profile + '-tip'
+        expected = {'input_tokens': 7 + index, 'output_tokens': 3 + index,
+                    'estimated_cost_usd': .003 + index, 'actual_cost_usd': .002 + index,
+                    'model': profile + '-recorded-model'}
+        with SessionDB(db_path=home / 'state.db') as db:
+            _write(db, root, model='parent-model', tokens=(90, 80), estimate=9, actual=8, stamp=1000)
+            assert db.set_session_title(root, 'Bot Chat')
+            db._execute_write(lambda conn: conn.execute('UPDATE sessions SET hidden=1 WHERE id=?', (root,)))
+            if compressed:
+                db.end_session(root, 'compression')
+            target = tip if compressed else root
+            _write(db, target, model=expected['model'], tokens=(expected['input_tokens'], expected['output_tokens']),
+                   estimate=expected['estimated_cost_usd'], actual=expected['actual_cost_usd'],
+                   parent=root if compressed else None, stamp=3000)
+            # Upsert preserves an existing root route; the test sets its stored route explicitly.
+            db.update_session_model(target, expected['model'])
+            _write(db, profile + '-side', model='newest-side-model', tokens=(900, 800), estimate=90, actual=80, stamp=6000)
+            _write(db, profile + '-worker', model='worker-model', tokens=(300, 200), estimate=30, actual=20,
+                   source='kanban', stamp=7000)
+        with SessionDB(db_path=home / 'state.db', read_only=True) as db:
+            native = _read_bot_sessions(db, 'uid:desk', False)
+            legacy = srv._canonical_session_row(db, home)
+            for row in [native['canonical_session'], legacy]:
+                assert row['id'] == root and row['resolved_id'] == target
+                assert {key: row[key] for key in USAGE_KEYS} == expected
+                assert row['preview'] == target + ' preview'
+                assert 'private-config-canary' not in str(row)
+                assert 'model_config' not in row and 'current_tool' not in row and 'iteration' not in row
+                assert ProfileCanonicalSession.model_validate(row).model_dump()['model'] == expected['model']
+            assert native['last_session']['id'] == profile + '-side'
+            assert not USAGE_KEYS.intersection(native['last_session'])
+            assert native['worker_session']['input_tokens'] == 300
+            assert _read_bot_sessions(db, 'uid:other', False)['canonical_session'] is None
+
+
+@pytest.mark.parametrize('status,expected', [(None, (None, None)), ('estimated', (0, None)), ('actual', (None, 0))])
+def test_zero_token_counts_and_unknown_or_known_zero_cost_stay_distinct(tmp_path, status, expected):
+    with SessionDB(db_path=tmp_path / 'state.db') as db:
+        _write(db, 'chat', model=None, tokens=(0, 0), estimate=0, actual=0, status=status)
+        assert db.set_session_title('chat', 'Bot Chat')
+    with SessionDB(db_path=tmp_path / 'state.db', read_only=True) as db:
+        for row in [_read_bot_sessions(db, 'uid:desk', True)['canonical_session'], srv._canonical_session_row(db, tmp_path)]:
+            assert row['input_tokens'] == row['output_tokens'] == 0
+            assert (row['estimated_cost_usd'], row['actual_cost_usd']) == expected
+            assert row['model'] is None
+
+
+def test_missing_named_chat_does_not_borrow_ordinary_or_worker_usage(tmp_path):
+    with SessionDB(db_path=tmp_path / 'state.db') as db:
+        _write(db, 'side', model='side-model', tokens=(900, 800), estimate=90, actual=80)
+        _write(db, 'worker', model='worker-model', tokens=(300, 200), estimate=30, actual=20, source='kanban')
+    with SessionDB(db_path=tmp_path / 'state.db', read_only=True) as db:
+        native = _read_bot_sessions(db, 'uid:desk', True)
+        assert native['canonical_session'] is None and srv._canonical_session_row(db, tmp_path) is None
+        assert not USAGE_KEYS.intersection(native['last_session'])
+
+
+def test_canonical_latest_alias_keeps_its_own_usage(tmp_path):
+    with SessionDB(db_path=tmp_path / 'state.db') as db:
+        _write(db, 'chat', model='chat-model', tokens=(7, 3), estimate=.003, actual=.002)
+        assert db.set_session_title('chat', 'Bot Chat')
+    with SessionDB(db_path=tmp_path / 'state.db', read_only=True) as db:
+        row = _read_bot_sessions(db, 'uid:desk', False)
+        assert row['last_session'] == row['canonical_session']
+        assert row['last_session']['input_tokens'] == 7
+
+
+def test_older_canonical_contract_accepts_missing_usage():
+    row = ProfileCanonicalSession.model_validate({'id': 'old', 'resolved_id': 'old'})
+    assert all(getattr(row, key) is None for key in USAGE_KEYS)
diff --git a/tests/gateway/test_bot_monitor_native_lifecycle.py b/tests/gateway/test_bot_monitor_native_lifecycle.py
