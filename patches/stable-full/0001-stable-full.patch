+"""Self-originated card transitions must not wake their caller again."""
+import json
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+from hermes_cli import kanban_db_connect as kbc
+from hermes_cli import kanban_db_notify as kbn
+from tools import kanban_tools as kt
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    for name in ('HERMES_KANBAN_TASK', 'HERMES_KANBAN_RUN_ID'):
+        monkeypatch.delenv(name, raising=False)
+    env = {'HERMES_SESSION_KEY': 'captain-session', 'HERMES_SESSION_PROFILE': 'captain'}
+    monkeypatch.setattr('gateway.session_context.get_session_env', lambda k, default='': env.get(k, default))
+    monkeypatch.setattr(kt, '_live_tui_session_key', lambda key, profile: key)
+    kb.init_db()
+    with kbc.connect() as conn:
+        tid = kb.create_task(conn, title='pause probe', assignee='developer')
+        for chat in ('captain-session', 'other-session'):
+            kbn.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=chat,
+                               notifier_profile='captain', delivery_mode='notify+wake')
+    return tid, env
+
+
+def claim(conn, tid, chat='captain-session'):
+    return kbn.claim_unseen_events_for_sub(conn, task_id=tid, platform='tui', chat_id=chat,
+                                         kinds=['blocked'])
+
+
+def test_captain_block_does_not_wake_self_but_other_observer_receives(board):
+    tid, _ = board
+    assert json.loads(kt._handle_block({'task_id': tid, 'reason': 'pause for review'}))['ok']
+    with kbc.connect() as conn:
+        old, new, events = claim(conn, tid)
+        assert events == [], 'Captain already received the tool result; do not wake it again'
+        assert new > old, 'self event must be consumed, not scanned again forever'
+        assert claim(conn, tid) == (new, new, [])
+        assert len(claim(conn, tid, 'other-session')[2]) == 1
+        assert conn.execute("SELECT COUNT(*) FROM task_events WHERE task_id=? AND kind='blocked'", (tid,)).fetchone()[0] == 1
+        assert len(kbn.list_notify_subs(conn, tid)) == 2
+
+
+def test_cli_or_legacy_without_origin_still_delivers(board):
+    tid, _ = board
+    with kbc.connect() as conn:
+        assert kb.block_task(conn, tid, reason='external failure')
+        assert len(claim(conn, tid)[2]) == 1
+
+
+def test_worker_inheriting_captain_route_still_delivers(board, monkeypatch):
+    tid, _ = board
+    monkeypatch.setenv('HERMES_KANBAN_TASK', tid)
+    with kbc.connect() as conn:
+        assert kb.claim_task(conn, tid)
+        run_id = kb.latest_run(conn, tid).id
+    monkeypatch.setenv('HERMES_KANBAN_RUN_ID', str(run_id))
+    assert json.loads(kt._handle_block({'task_id': tid, 'reason': 'worker needs help'}))['ok']
+    with kbc.connect() as conn:
+        assert len(claim(conn, tid)[2]) == 1
+
+
+def test_other_profile_same_chat_still_delivers(board):
+    tid, env = board
+    env['HERMES_SESSION_PROFILE'] = 'different-profile'
+    assert json.loads(kt._handle_block({'task_id': tid, 'reason': 'external observer'}))['ok']
+    with kbc.connect() as conn:
+        assert len(claim(conn, tid)[2]) == 1
+
+
+@pytest.mark.parametrize('mode', ['cron', 'cleared', 'missing-profile'])
+def test_ambiguous_or_background_origin_is_delivered(board, monkeypatch, mode):
+    tid, env = board
+    if mode == 'cron':
+        env['HERMES_CRON_SESSION'] = '1'
+    elif mode == 'cleared':
+        env['HERMES_SESSION_KEY'] = ''
+        monkeypatch.setenv('HERMES_SESSION_KEY', 'captain-session')
+    else:
+        with kbc.connect() as conn:
+            with kb.write_txn(conn):
+                conn.execute('UPDATE kanban_notify_subs SET notifier_profile=NULL WHERE task_id=?', (tid,))
+    assert json.loads(kt._handle_block({'task_id': tid, 'reason': mode}))['ok']
+    with kbc.connect() as conn:
+        assert len(claim(conn, tid)[2]) == 1
+
+
+def test_gateway_thread_identity_and_legacy_batch(board):
+    tid, env = board
+    env.update(HERMES_SESSION_PLATFORM='slack', HERMES_SESSION_CHAT_ID='channel',
+               HERMES_SESSION_THREAD_ID='thread-a')
+    with kbc.connect() as conn:
+        for thread in ('thread-a', 'thread-b'):
+            kbn.add_notify_sub(conn, task_id=tid, platform='slack', chat_id='channel',
+                               thread_id=thread, notifier_profile='captain', delivery_mode='notify+wake')
+    assert json.loads(kt._handle_block({'task_id': tid, 'reason': 'self'}))['ok']
+    with kbc.connect() as conn:
+        # An independent external outcome in the same batch must survive suppression.
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, 'blocked', {'reason': 'worker later asks for help'})
+        args = dict(task_id=tid, platform='slack', chat_id='channel', kinds=['blocked'])
+        own = kbn.claim_unseen_events_for_sub(conn, thread_id='thread-a', **args)[2]
+        other = kbn.claim_unseen_events_for_sub(conn, thread_id='thread-b', **args)[2]
+        assert [e.payload['reason'] for e in own] == ['worker later asks for help']
+        assert len(other) == 2
+
+
+def test_context_resets_and_other_card_cascade_is_not_suppressed(board):
+    from hermes_cli.kanban_event_origin import event_origin
+    tid, _ = board
+    target = dict(platform='tui', chat_id='captain-session', notifier_profile='captain')
+    with kbc.connect() as conn:
+        with pytest.raises(RuntimeError):
+            with event_origin('another-card', target):
+                assert kb.block_task(conn, tid, reason='cascade from another card')
+                raise RuntimeError('after mutation')
+        assert len(claim(conn, tid)[2]) == 1
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, 'blocked', {'reason': 'outside context'})
+        assert len(claim(conn, tid)[2]) == 1
+
+
+def test_tui_preparation_has_no_durable_self_delivery(board):
+    from tui_gateway.session_notifications import _kb_prepare_sub
+    tid, _ = board
+    assert json.loads(kt._handle_block({'task_id': tid, 'reason': 'pause'}))['ok']
+    with kbc.connect() as conn:
+        sub = next(s for s in kbn.list_notify_subs(conn, tid) if s['chat_id'] == 'captain-session')
+        identity = dict(task_id=tid, platform='tui', chat_id='captain-session', thread_id='')
+        texts, _ = _kb_prepare_sub(kb, conn, sub, 'default', identity)
+        assert texts == []
+        # Other observer is processed by the identical production preparation path.
+        sub = next(s for s in kbn.list_notify_subs(conn, tid) if s['chat_id'] == 'other-session')
+        identity['chat_id'] = 'other-session'
+        texts, _ = _kb_prepare_sub(kb, conn, sub, 'default', identity)
+        assert len(texts) == 1
+
+
+def test_parallel_callers_do_not_leak_origin():
+    from concurrent.futures import ThreadPoolExecutor
+    from threading import Barrier
+    from hermes_cli.kanban_event_origin import attributed_payload, event_origin
+    barrier = Barrier(2)
+
+    def emit(chat):
+        with event_origin('task', {'chat_id': chat}):
+            barrier.wait(timeout=5)
+            return attributed_payload('task', {})['_notification_origin']['chat_id']
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        first = pool.submit(emit, 'a')
+        second = pool.submit(emit, 'b')
+        assert (first.result(timeout=5), second.result(timeout=5)) == ('a', 'b')
+    assert attributed_payload('task', None) is None
