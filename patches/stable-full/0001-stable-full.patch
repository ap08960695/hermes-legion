+      { title: 'Single image option', images: [image], facts: ['A'.repeat(80)] },
+      { title: 'Multiple image option', images: [image, image] }
+    ]
+  }
+
+  const content =
+    '```cards\n' +
+    JSON.stringify(cards) +
+    '\n```\n\n```html\n' +
+    '<!doctype html><html><head><title>Layout fixture</title></head><body><h1>Layout fixture</h1><p>Supplied local content for the native chat and preview layout test. No external services or resources.</p></body></html>\n```'
+
+  const seeded = spawnSync(
+    python,
+    [
+      '-c',
+      `
+import sys
+from pathlib import Path
+from hermes_state import SessionDB
+db=SessionDB(db_path=Path(sys.argv[1])/'state.db')
+db.create_session('answer-card-layout',source='desktop',model='mock-model')
+db.set_session_title('answer-card-layout','Answer card layout')
+db.append_message('answer-card-layout','assistant',sys.argv[2])
+db.close()
+`,
+      sandbox.hermesHome,
+      content
+    ],
+    {
+      cwd: root,
+      env: {
+        PATH: process.env.PATH,
+        HOME: sandbox.root,
+        HERMES_HOME: sandbox.hermesHome,
+        HERMES_DISABLE_LAZY_INSTALLS: '1',
+        PYTHONPATH: root
+      },
+      encoding: 'utf8'
+    }
+  )
+
+  expect(seeded.status, seeded.stderr).toBe(0)
+
+  const { app, page } = await launchDesktop(
+    buildAppEnv(sandbox, { HERMES_DESKTOP_PYTHON: python, HERMES_DISABLE_LAZY_INSTALLS: '1' })
+  )
+
+  try {
+    await page.getByRole('button', { name: 'All features', exact: true }).waitFor({ timeout: 60_000 })
+    await page.locator('.hermes-focus-rail').getByRole('button', { name: 'Chat history', exact: true }).click()
+    await page.getByRole('button', { name: 'Answer card layout', exact: true }).first().click()
+    const cardsView = page.locator('[data-slot="answer-cards"]')
+    await cardsView.waitFor()
+    await page.locator('[data-slot="aui_artifact-card"]').filter({ hasText: 'Layout fixture' }).click()
+    await page
+      .frameLocator('iframe[title="Layout fixture"]')
+      .getByRole('heading', { name: 'Layout fixture', exact: true })
+      .waitFor()
+    await app.evaluate(({ BrowserWindow }) => {
+      const window = BrowserWindow.getAllWindows()[0]
+      window.setMinimumSize(320, 480)
+      window.setBounds({ width: 560, height: 840 })
+    })
+    await page.setViewportSize({ width: 560, height: 840 })
+    await expect
+      .poll(async () =>
+        cardsView.evaluate(view =>
+          [...view.querySelectorAll('article')].every(card => card.scrollWidth <= card.clientWidth + 2)
+        )
+      )
+      .toBe(true)
+    const width = await cardsView.evaluate(view => view.clientWidth)
+    expect(width).toBeLessThan(130)
+    expect(width).toBeGreaterThan(60)
+    expect(mock.receivedPrompts).toHaveLength(0)
+  } finally {
+    await app.close()
+    await mock.close()
