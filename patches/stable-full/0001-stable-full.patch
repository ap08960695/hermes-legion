+        def finish():
+            nonlocal normalized, start_char, start_byte
+            if normalized:
+                recent.append((normalized, start_char, start_byte))
+                for key, phrase in token_specs:
+                    if positions[key] is not None or len(recent) < len(phrase):
+                        continue
+                    tail = list(recent)[-len(phrase):]
+                    if all((part[0].startswith(wanted) if key[1] and index == len(phrase) - 1
+                            else part[0] == wanted) for index, (part, wanted) in enumerate(zip(tail, phrase))):
