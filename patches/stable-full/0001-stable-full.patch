+import { Button, Codicon } from '@hermes/plugin-sdk'
+import { type ComponentProps, useLayoutEffect, useRef } from 'react'
+
+import { boardCounts, type BoardView } from './board-view'
+import type { KanbanText } from './i18n'
+import type { KanbanBoard } from './types'
+
+interface OverviewProps {
+  board: KanbanBoard | null | undefined
+  view: BoardView
+  onView: (view: BoardView) => void
+  k: KanbanText
+}
+
+export function BoardOverview({ board, view, onView, k }: OverviewProps) {
+  const count = boardCounts(board)
+
+  return (
+    <div className="kanban-overview">
+      <div aria-label={k.workViews} className="kanban-view-switch" role="group">
+        <Button aria-pressed={view === 'work'} onClick={() => onView('work')} variant="ghost">
+          <Codicon name="target" />
+          {k.work.tab}
+        </Button>
+        <Button aria-pressed={view === 'current'} onClick={() => onView('current')} variant="ghost">
+          <Codicon name="checklist" />
+          {k.currentWork}
+          <span>{count.current}</span>
+        </Button>
+        <Button aria-pressed={view === 'workflow'} onClick={() => onView('workflow')} variant="ghost">
+          <Codicon name="git-merge" />
+          {k.workflow}
+        </Button>
+        <Button aria-pressed={view === 'history'} onClick={() => onView('history')} variant="ghost">
+          <Codicon name="history" />
+          {k.taskHistory}
+          <span>{count.history}</span>
+        </Button>
+      </div>
+      <div aria-label={k.currentWork} className="kanban-work-summary">
+        <span>
+          <Codicon name="pulse" />
+          {k.col.running.label}
+          <b>{count.working}</b>
+        </span>
+        <span>
+          <Codicon name="circle-outline" />
+          {k.col.ready.label}
+          <b>{count.ready}</b>
+        </span>
+        <span>
+          <Codicon name="debug-pause" />
+          {k.col.blocked.label}
+          <b>{count.waiting}</b>
+        </span>
+      </div>
+    </div>
+  )
+}
+
+export function ShowMore({
+  cardSelector,
+  visible,
+  total,
+  onMore,
+  size,
+  k
+}: {
+  cardSelector: string
+  visible: number
+  total: number
+  onMore: () => void
+  size?: ComponentProps<typeof Button>['size']
+  k: KanbanText
+}) {
+  const revealFocus = useRef<{ button: HTMLButtonElement; list: HTMLElement; index: number } | null>(null)
+
+  useLayoutEffect(() => {
+    const pending = revealFocus.current
+    revealFocus.current = null
+    if (!pending) return
+
+    const { button, list, index } = pending
+    const { activeElement, body } = button.ownerDocument
+    if (activeElement === button || (!button.isConnected && activeElement === body)) {
+      list.querySelectorAll<HTMLButtonElement>(cardSelector)[index]?.focus()
+    }
+  }, [cardSelector, visible])
+
+  if (visible >= total) {
+    return null
+  }
+
+  return (
+    <Button
+      onClick={({ currentTarget }) => {
+        const list = currentTarget.parentElement
+        if (list && currentTarget.ownerDocument.activeElement === currentTarget) {
+          revealFocus.current = { button: currentTarget, list, index: visible }
+        }
+        onMore()
+      }}
+      size={size}
+      variant="ghost"
+    >
+      {k.moreHistory(visible, total)}
+    </Button>
+  )
+}
+
+export function EmptyBoardView({
+  view,
+  filtered,
+  onCurrent,
+  onAdd,
+  k
+}: {
+  view: BoardView
+  filtered: boolean
+  onCurrent: () => void
+  onAdd: () => void
+  k: KanbanText
+}) {
+  const history = view === 'history'
+
+  return (
+    <div className="grid flex-1 place-items-center px-4 text-center">
+      <div className="flex flex-col items-center gap-2">
+        <Codicon className="text-(--ui-text-quaternary)" name={history ? 'history' : 'project'} size="1.25rem" />
+        <p className="text-sm text-(--ui-text-tertiary)">{filtered ? k.noMatch : history ? k.noHistory : k.noTasks}</p>
+        <Button className="mt-0.5" onClick={history ? onCurrent : onAdd} size="sm" variant="outline">
+          <Codicon name={history ? 'arrow-left' : 'add'} size="0.75rem" />
+          {history ? k.backToCurrent : k.newTask}
+        </Button>
+      </div>
+    </div>
+  )
+}
