+          <Codicon name="git-merge" />
+          {k.workflow}
+        </Button>
+        <Button variant="ghost" aria-pressed={view === 'history'} onClick={() => onView('history')}>
+          <Codicon name="history" />
+          {k.taskHistory}
+          <span>{count.history}</span>
+        </Button>
+      </div>
+      <div className="kanban-work-summary" aria-label={k.currentWork}>
