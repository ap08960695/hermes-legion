@@ -0,0 +1,143 @@
+import { useEffect, useState, useMemo } from 'react'
+import { Button } from '@/components/ui/button'
+import { Codicon } from '@/components/ui/codicon'
+import { CopyButton } from '@/components/ui/copy-button'
+import { Dialog, DialogContent, DialogTitle } from '@/components/ui/dialog'
+import { ErrorState } from '@/components/ui/error-state'
+import { useI18n } from '@/i18n'
+import { useFocusCopy } from '../focus/copy'
+import { ArtifactFileContent } from './artifact-file-content'
+import { readLibraryDirectory, readLibraryFile, type LibraryItem, type LibraryFile } from './open-artifact'
+import { useLibraryAvailability } from './library-availability'
+import type { HermesReadDirEntry } from '@/global'
+
+function LibraryBrowser({ item, onClose }: { item: LibraryItem; onClose: () => void }) {
+  const { t } = useI18n(),
+    copy = useFocusCopy()
+  const [history, setHistory] = useState([{ path: item.value, directory: false }])
+  const { path, directory } = history[history.length - 1]
+  const navigate = (path: string, directory: boolean) => setHistory(previous => [...previous, { path, directory }])
+  const [file, setFile] = useState<LibraryFile | null>(null),
+    [entries, setEntries] = useState<HermesReadDirEntry[] | null>(null),
+    [error, setError] = useState(''),
+    [limit, setLimit] = useState(200)
+  const visibleItems = useMemo(
+    () =>
+      (entries || [])
+        .slice(0, limit)
+        .filter(entry => !entry.isDirectory)
+        .map(entry => ({ ...item, id: entry.path, value: entry.path })),
+    [entries, limit, item]
+  )
+  const availability = useLibraryAvailability(visibleItems)
+  useEffect(() => {
+    let current = true
+    setFile(null)
+    setEntries(null)
+    setError('')
+    setLimit(200)
+    const request = directory
+      ? readLibraryDirectory(path, item.owner)
+      : path === item.value && item.initialFile
+        ? Promise.resolve(item.initialFile)
+        : readLibraryFile(path, item.owner, item.sessionId)
+    void request
+      .then(value => {
+        if (!current) return
+        if ('entries' in value) setEntries(value.entries)
+        else setFile(value)
+      })
+      .catch(error => {
+        if (current) setError(error instanceof Error ? error.message : t.preview.unavailable)
+      })
+    return () => {
+      current = false
+    }
+  }, [path, directory, item, t.preview.unavailable])
+  const folder = () => {
+    const full = file?.path || path
+    const parent = full.replace(/[\\/][^\\/]+$/, '') || full
+    if (parent !== path || !directory) navigate(parent, true)
+  }
+  return (
+    <div className="flex h-[min(72vh,800px)] min-h-0 flex-col gap-3">
+      <div className="flex flex-wrap items-center gap-2">
+        <Button
+          size="sm"
+          variant="ghost"
+          onClick={() => {
+            if (history.length > 1) setHistory(previous => previous.slice(0, -1))
+            else onClose()
+          }}
+        >
+          <Codicon name="arrow-left" />
+          {t.common.back}
+        </Button>
+        <Button size="sm" variant="ghost" onClick={folder}>
+          <Codicon name="folder" />
+          {copy('libraryFolder')}
+        </Button>
+        <CopyButton text={file?.path || path} label={t.fileMenu.copyPath} />
+        <span className="min-w-0 truncate text-xs text-muted-foreground">{file?.path || path}</span>
+      </div>
+      <div className="min-h-0 flex-1 overflow-auto">
+        {error ? (
+          <ErrorState title={t.preview.unavailable} description={error} />
+        ) : entries ? (
+          <div className="flex flex-col gap-1">
+            {entries.slice(0, limit).map(entry => (
+              <Button
+                key={entry.path}
+                disabled={!entry.isDirectory && availability[entry.path] !== 'ready'}
+                title={
+                  entry.isDirectory || availability[entry.path] === 'ready'
+                    ? entry.name
+                    : copy('library_' + (availability[entry.path] || 'checking'))
+                }
+                variant="ghost"
+                className="justify-start"
+                onClick={() => {
+                  navigate(entry.path, entry.isDirectory)
+                }}
+              >
+                <Codicon name={entry.isDirectory ? 'folder' : 'file'} />
+                {entry.name}
+              </Button>
+            ))}
+            {entries.length > limit && (
+              <Button variant="ghost" onClick={() => setLimit(n => n + 200)}>
+                {t.common.expand} · {limit}/{entries.length}
+              </Button>
+            )}
+          </div>
+        ) : file ? (
+          <ArtifactFileContent file={file} label={item.label} />
+        ) : (
+          <p role="status">{t.preview.loading}</p>
+        )}
+      </div>
+    </div>
+  )
+}
+
+export function LibraryFilePreview({ item, onClose }: { item: LibraryItem | null; onClose: () => void }) {
+  return (
+    <Dialog
+      open={Boolean(item)}
+      onOpenChange={open => {
+        if (!open) onClose()
+      }}
+    >
+      <DialogContent className="w-[min(1100px,94vw)] max-w-none" aria-describedby={undefined}>
+        <DialogTitle>{item?.label}</DialogTitle>
+        {item && (
+          <LibraryBrowser
+            key={`${item.owner.connectionId}:${item.owner.profile}:${item.value}`}
+            item={item}
+            onClose={onClose}
+          />
+        )}
+      </DialogContent>
+    </Dialog>
+  )
+}
