+"""Current-process RSS is sampled afresh; unavailable observations stay unknown."""
+import builtins
+import unittest
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import psutil
+from hermes_platform.host.runtime import current_process_rss_kib
+
+
+class ProcessRssTests(unittest.TestCase):
+    def test_current_rss_is_not_cached_or_a_highwater_value(self):
+        with patch('psutil.Process') as process:
+            process.return_value.memory_info.side_effect = [SimpleNamespace(rss=2049), SimpleNamespace(rss=1024)]
+            self.assertEqual(current_process_rss_kib(), 2)
+            self.assertEqual(current_process_rss_kib(), 1)
+            self.assertEqual(process.call_count, 2)
+
+    def test_expected_sampling_failures_remain_unknown(self):
+        for error in (OSError('synthetic'), psutil.AccessDenied(), psutil.NoSuchProcess(1)):
+            with self.subTest(error=error), patch('psutil.Process', side_effect=error):
+                self.assertIsNone(current_process_rss_kib())
+
+    def test_missing_dependency_remains_unknown(self):
+        original = builtins.__import__
+
+        def without_psutil(name, *args, **kwargs):
+            if name == 'psutil':
+                raise ImportError('synthetic missing dependency')
+            return original(name, *args, **kwargs)
+
+        with patch('builtins.__import__', side_effect=without_psutil):
+            self.assertIsNone(current_process_rss_kib())
+
+
+if __name__ == '__main__':
+    unittest.main()
