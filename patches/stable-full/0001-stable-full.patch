+"""Compaction recovery searches the requested session without model calls."""
+
+import json
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+from hermes_state import SessionDB
+from tools.session_search_tool import session_search
+
+
+@pytest.fixture
+def conversations(tmp_path):
+    db = SessionDB(tmp_path / "state.db")
+    db.create_session("target", source="cli")
+    db.create_session("distractor", source="cli")
+    for index in range(45):
+        db.append_message("target", role="user", content=f"ordinary message {index}")
+    needle = db.append_message("target", role="tool", tool_name="terminal",
+                               content="prefix " + "x" * 5000 + " recoveryneedle " + "y" * 5000)
+    for index in range(45, 90):
+        db.append_message("target", role="assistant", content=f"ordinary answer {index}")
+    for index in range(350):
+        db.append_message("distractor", role="user", content=f"recoveryneedle unrelated {index}")
+    try:
+        yield db, needle
+    finally:
+        db.close()
+
+
+def _search(db, **kwargs):
+    return json.loads(session_search(db=db, **kwargs))
+
+
+def test_compaction_recovery_finds_middle_tool_output_in_only_the_target(conversations):
+    db, needle = conversations
+    result = _search(db, query="recoveryneedle", session_id="target", current_session_id="target")
+    assert result["success"] is True
+    assert result["mode"] == "search_session"
+    assert result["session_id"] == "target"
+    assert [row["match_message_id"] for row in result["results"]] == [needle]
+    assert "recoveryneedle" in result["results"][0]["snippet"]
+    assert len(result["results"][0]["snippet"]) <= 512
+
+
+def test_full_detail_requests_a_larger_but_still_bounded_excerpt(conversations):
+    db, needle = conversations
+    result = _search(db, query="recoveryneedle", session_id="target", detail="full")
+    assert result["results"][0]["match_message_id"] == needle
+    assert "recoveryneedle" in result["results"][0]["snippet"]
+    assert 512 < len(result["results"][0]["snippet"]) <= 4000
+
+
+def test_scoped_query_has_no_match_when_only_another_session_contains_it(conversations):
+    db, _ = conversations
+    result = _search(db, query="unrelated", session_id="target")
+    assert result["success"] is True
+    assert result["results"] == []
+
+
+def test_role_filter_is_honored_in_scoped_search(conversations):
+    db, needle = conversations
+    assert _search(db, query="recoveryneedle", session_id="target", role_filter="user,assistant")["results"] == []
+    assert _search(db, query="recoveryneedle", session_id="target", role_filter="tool")["results"][0]["match_message_id"] == needle
+
+
+def test_a_missing_session_is_an_error_not_a_global_search(conversations):
+    db, _ = conversations
+    result = _search(db, query="recoveryneedle", session_id="missing")
+    assert result["success"] is False
+    assert "results" not in result and "messages" not in result
+
+
+def test_bare_session_read_and_anchor_scroll_remain_compatible(conversations):
+    db, needle = conversations
+    assert _search(db, session_id="target")["mode"] == "read"
+    result = _search(db, query="ignored for scroll", session_id="target", around_message_id=needle)
+    assert result["success"] is True and result["mode"] == "scroll"
