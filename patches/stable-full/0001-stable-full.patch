@@ -0,0 +1,247 @@
+import { act, cleanup, renderHook } from '@testing-library/react'
+import { atom, type WritableAtom } from 'nanostores'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+import type { HermesConnection } from '@/global'
+import { $activeConnectionId, $pendingConnectionId } from '@/store/connections'
+import { $connection, $gatewayState } from '@/store/session'
+
+import { useServerSessionSearch } from './use-server-session-search'
+
+vi.mock('@/store/connections', () => ({
+  $activeConnectionId: atom<string | null>(null),
+  $pendingConnectionId: atom<string | null>(null)
+}))
+
+const connectionId = $activeConnectionId as WritableAtom<string | null>
+const io = vi.hoisted(() => ({ search: vi.fn() }))
+vi.mock('@/hermes', async original => ({ ...(await original<typeof import('@/hermes')>()), searchSessions: io.search }))
+beforeEach(() => $gatewayState.set('open'))
+
+afterEach(() => {
+  cleanup()
+  vi.useRealTimers()
+  io.search.mockReset()
+  connectionId.set(null)
+  $pendingConnectionId.set(null)
+  $connection.set(null)
+  $gatewayState.set('idle')
+})
+const hit = { id: 'old-hit', title: 'Earlier query', source: 'cli' }
+async function tick() {
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(201)
+  })
+}
+it('retires previous query and profile hits immediately and reports failure without retrying', async () => {
+  vi.useFakeTimers()
+  io.search.mockResolvedValueOnce({ results: [hit] }).mockRejectedValue(new Error('Offline test'))
+  const { result, rerender } = renderHook(({ query, profile }) => useServerSessionSearch(query, profile), {
+    initialProps: { query: 'earlier', profile: 'default' }
+  })
+  await tick()
+  expect(result.current.serverMatches).toEqual([hit])
+  rerender({ query: 'later', profile: 'default' })
+  expect(result.current.serverMatches).toEqual([])
+  expect(result.current.searchPending).toBe(true)
+  await tick()
+  expect(result.current.searchError).toBe(true)
+  expect(result.current.serverMatches).toEqual([])
+  await act(async () => {
+    await vi.advanceTimersByTimeAsync(30000)
+  })
+  expect(io.search).toHaveBeenCalledTimes(2)
+  rerender({ query: 'earlier', profile: 'other' })
+  expect(result.current.serverMatches).toEqual([])
+  expect(result.current.searchError).toBe(false)
+  await tick()
+  expect(io.search).toHaveBeenLastCalledWith('earlier', 'other', null)
+})
+it('ignores late responses and makes one new request on explicit retry', async () => {
+  vi.useFakeTimers()
+  let finish!: (value: unknown) => void
+  io.search
+    .mockReturnValueOnce(
+      new Promise(resolve => {
+        finish = resolve
+      })
+    )
+    .mockRejectedValueOnce(new Error('Offline test'))
+    .mockResolvedValueOnce({ results: [hit] })
+  const { result, rerender } = renderHook(({ query }) => useServerSessionSearch(query, 'default'), {
+    initialProps: { query: 'old' }
+  })
+  await tick()
+  rerender({ query: 'new' })
+  await tick()
+  await act(async () => {
+    finish({ results: [hit] })
+  })
+  expect(result.current.serverMatches).toEqual([])
+  expect(result.current.searchError).toBe(true)
+  act(() => result.current.retrySearch())
+  await tick()
+  expect(io.search).toHaveBeenCalledTimes(3)
+  expect(result.current.searchError).toBe(false)
+  expect(result.current.serverMatches).toEqual([hit])
+  rerender({ query: '' })
+  expect(result.current.serverMatches).toEqual([])
+  expect(result.current.searchPending).toBe(false)
+  await tick()
+  expect(io.search).toHaveBeenCalledTimes(3)
+})
+
+it('retires a previous same-query result on device switch and ignores the late old-device response', async () => {
+  vi.useFakeTimers()
+  connectionId.set('local')
+  let resolveRemote!: (value: unknown) => void
+  io.search
+    .mockResolvedValueOnce({ results: [hit] })
+    .mockReturnValueOnce(
+      new Promise(resolve => {
+        resolveRemote = resolve
+      })
+    )
+    .mockResolvedValueOnce({ results: [] })
+
+  const { result } = renderHook(() => useServerSessionSearch('same query', 'default'))
+  await tick()
+  expect(result.current.serverMatches).toEqual([hit])
+  act(() => connectionId.set('remote'))
+  expect(result.current.serverMatches).toEqual([])
+  expect(result.current.searchPending).toBe(true)
+  await tick()
+  expect(io.search).toHaveBeenLastCalledWith('same query', 'default', 'remote')
+
+  act(() => connectionId.set('local'))
+  expect(result.current.serverMatches).toEqual([])
+  await act(async () => resolveRemote({ results: [hit] }))
+  expect(result.current.serverMatches).toEqual([])
+  await tick()
+  expect(io.search).toHaveBeenLastCalledWith('same query', 'default', 'local')
+  expect(result.current.searchPending).toBe(false)
+})
+
+it('discards pre-switch reads and waits through a rollback to the same query and device', async () => {
+  vi.useFakeTimers()
+  connectionId.set('local')
+  let finishOld!: (value: unknown) => void
+  io.search
+    .mockImplementationOnce(() => new Promise(resolve => { finishOld = resolve }))
+    .mockResolvedValueOnce({ results: [] })
+  const { result, rerender } = renderHook(({ query }) => useServerSessionSearch(query, 'default'), {
+    initialProps: { query: 'same query' }
+  })
+  await tick()
+  expect(io.search).toHaveBeenCalledOnce()
+
+  act(() => $pendingConnectionId.set('fixture-other'))
+  rerender({ query: 'edited while switching' })
+  await tick()
+  expect(io.search).toHaveBeenCalledOnce()
+  expect(result.current.searchPending).toBe(true)
+
+  rerender({ query: 'same query' })
+  act(() => $pendingConnectionId.set(null))
+  await act(async () => finishOld({ results: [hit] }))
+  expect(result.current.serverMatches).toEqual([])
+  expect(result.current.searchPending).toBe(true)
+  await tick()
+  expect(io.search.mock.calls).toEqual([
+    ['same query', 'default', 'local'],
+    ['same query', 'default', 'local']
+  ])
+  expect(result.current.searchPending).toBe(false)
+})
+
+
+it('waits for legacy Local and searches only the current query on Ready', async () => {
+  vi.useFakeTimers()
+  $connection.set({ mode: 'local' } as HermesConnection)
+  $gatewayState.set('connecting')
+  io.search.mockResolvedValue({ results: [hit] })
+
+  const { result, rerender } = renderHook(({ query }) => useServerSessionSearch(query, 'default'), {
+    initialProps: { query: 'first' }
+  })
+
+  await tick()
+  rerender({ query: 'current' })
+  await tick()
+  expect(io.search).not.toHaveBeenCalled()
+  expect(result.current.waitingForLocal).toBe(true)
+  expect(result.current.searchError).toBe(false)
+
+  act(() => $gatewayState.set('open'))
+  await tick()
+  expect(io.search).toHaveBeenCalledExactlyOnceWith('current', 'default', null)
+  expect(result.current.waitingForLocal).toBe(false)
+  expect(result.current.serverMatches).toEqual([hit])
+})
+
+it('keeps completed same-scope rows but rejects a held reply across Local reconnect', async () => {
+  vi.useFakeTimers()
+  connectionId.set('local')
+  $gatewayState.set('open')
+
+  let finishHeld!: (value: unknown) => void
+  const oldResponse = new Promise(resolve => { finishHeld = resolve })
+  const latest = { ...hit, id: 'ready-hit', title: 'Ready result' }
+
+  io.search
+    .mockResolvedValueOnce({ results: [hit] })
+    .mockReturnValueOnce(oldResponse)
+    .mockResolvedValueOnce({ results: [latest] })
+
+  const { result, rerender } = renderHook(({ query }) => useServerSessionSearch(query, 'default'), {
+    initialProps: { query: 'first' }
+  })
+
+  await tick()
+  act(() => $gatewayState.set('connecting'))
+  await tick()
+  expect(io.search).toHaveBeenCalledTimes(1)
+  expect(result.current.serverMatches).toEqual([hit])
+
+  act(() => $gatewayState.set('open'))
+  await tick()
+  expect(io.search).toHaveBeenCalledTimes(2)
+  act(() => $gatewayState.set('connecting'))
+  await tick()
+  expect(io.search).toHaveBeenCalledTimes(2)
+
+  act(() => $gatewayState.set('open'))
+  await tick()
+  expect(io.search).toHaveBeenCalledTimes(3)
+  expect(io.search).toHaveBeenLastCalledWith('first', 'default', 'local')
+  await act(async () => finishHeld({ results: [hit] }))
+  expect(result.current.serverMatches).toEqual([latest])
+
+  act(() => $gatewayState.set('connecting'))
+  rerender({ query: 'different' })
+  expect(result.current.serverMatches).toEqual([])
+})
+
+
+it('requires explicit Retry for a search that genuinely failed before reconnect', async () => {
+  vi.useFakeTimers()
+  connectionId.set('local')
+  $gatewayState.set('open')
+  io.search.mockRejectedValueOnce(new Error('Fixture refusal')).mockResolvedValueOnce({ results: [hit] })
+
+  const { result } = renderHook(() => useServerSessionSearch('failed query', 'default'))
+  await tick()
+  expect(result.current.searchError).toBe(true)
+  act(() => $gatewayState.set('connecting'))
+  expect(result.current.waitingForLocal).toBe(true)
+  expect(result.current.searchError).toBe(false)
+  act(() => $gatewayState.set('open'))
+  await tick()
+  expect(io.search).toHaveBeenCalledTimes(1)
+  expect(result.current.searchError).toBe(true)
+
+  act(() => result.current.retrySearch())
+  await tick()
+  expect(io.search).toHaveBeenCalledTimes(2)
+  expect(result.current.serverMatches).toEqual([hit])
+})
