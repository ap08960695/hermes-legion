+import type { ConnectionState } from '@hermes/shared'
+import { useEffect, useReducer } from 'react'
+
+import type { SshBackendStatus } from '../../electron/ssh-backend-status'
+
+import { useI18n } from '@/i18n'
+
+export function SshBackendStatusText({
+  activeState,
+  compact = false,
+  pending,
+  retryAt,
+  status
+}: {
+  activeState?: ConnectionState
+  compact?: boolean
+  pending?: boolean
+  retryAt?: number
+  status?: SshBackendStatus
+}) {
+  const { t, locale } = useI18n()
+  const copy = t.settings.connections.sshStatus
+  const cooldown = status?.phase === 'disconnected' ? status.retryNotBefore : undefined
+  const transportRetryAt = cooldown !== undefined && cooldown > Date.now() ? cooldown : undefined
+  const [cooldownRevision, refreshCooldown] = useReducer((revision: number) => revision + 1, 0)
+
+  useEffect(() => {
+    if (transportRetryAt === undefined || activeState === 'open' || retryAt !== undefined) {
+      return
+    }
+
+    const timer = window.setTimeout(refreshCooldown, Math.max(0, transportRetryAt - Date.now()))
+    return () => window.clearTimeout(timer)
+  }, [activeState, cooldownRevision, retryAt, transportRetryAt])
+
+  const starting = (pending || activeState === 'connecting') && retryAt === undefined && transportRetryAt === undefined
+  const phase =
+    activeState === 'open'
+      ? 'ready'
+      : status && status.phase !== 'ready' && status.phase !== 'disconnected'
+        ? status.phase
+        : starting
+          ? 'starting'
+          : retryAt !== undefined || activeState
+            ? 'disconnected'
+            : (status?.phase ?? 'disconnected')
+  const expiredBackoff = status?.phase === 'disconnected' && status.reason === 'reconnect-backoff' &&
+    cooldown !== undefined && transportRetryAt === undefined
+  const reason =
+    phase === 'disconnected'
+      ? status?.phase === 'disconnected' && !expiredBackoff
+        ? copy.failure[status.reason]
+        : activeState
+          ? copy.socketClosed
+          : copy.noConnection
+      : undefined
+
+  const time = (at: number) => new Intl.DateTimeFormat(locale, { timeStyle: 'medium' }).format(at)
+  let retry: string | undefined
+
+  if (phase === 'disconnected') {
+    if (retryAt !== undefined) {
+      retry = copy.nextRetryAt(time(retryAt))
+    } else if (transportRetryAt !== undefined) {
+      retry = copy.retryAvailableAt(time(transportRetryAt))
+    } else {
+      retry = activeState ? copy.reconnectManually : copy.selectToConnect
+    }
+  }
+
+  return (
+    <span className={compact ? 'min-w-0 truncate' : 'grid min-w-0 text-xs text-muted-foreground'}>
+      <span>{copy[phase]}</span>
+      {!compact && reason && <span>{reason}</span>}
+      {!compact && retry && <span>{retry}</span>}
+    </span>
+  )
+}
