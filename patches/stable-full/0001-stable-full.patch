+
+    act(() => gateway.set('closed'))
+    expect(screen.getByRole('status').textContent).toBe('Waiting for a fresh Local snapshot.')
+    expect(screen.queryByText('Old worker')).toBeNull()
+    const local = within(screen.getByText('Saved canonical note').closest('tr')!)
+    expect(local.getByText('Retained snapshot')).toBeTruthy()
+    expect((local.getByRole('button', { name: 'Open chat · Writer' }) as HTMLButtonElement).disabled).toBe(true)
+
+    act(() => gateway.set('open'))
