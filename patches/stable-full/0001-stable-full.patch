diff --git a/hermes_cli/kanban_delivery.py b/hermes_cli/kanban_delivery.py
new file mode 100644
index 0000000000000000000000000000000000000000..83c583112bf34c87fa979d365d043669b56eaf76
--- /dev/null
+++ b/hermes_cli/kanban_delivery.py
@@ -0,0 +1,163 @@
+"""Evidence-backed delivery on the existing task/reviewer lifecycle.
+
+Recorded checks and an independent reviewer are evidence, not an assertion of
+universal correctness. This module never dispatches work or runs a command.
+"""
+from __future__ import annotations
+
+import json
+
+
+def validate_delivery_contract(contract):
+    required = contract.get('require_review', False)
+    if type(required) is not bool:
+        raise ValueError('require_review must be a boolean')
+    criteria = contract.get('acceptance_criteria', {})
+    if (not isinstance(criteria, dict) or len(criteria) > 32
+            or any(not isinstance(v, str) or not v.strip() or len(v) > 500
+                   for v in criteria.values())):
+        raise ValueError('invalid acceptance_criteria')
+    if criteria and set(criteria) != set(contract.get('checks', [])):
+        raise ValueError('acceptance_criteria must name exactly the declared checks')
+    if required and (not criteria or not contract.get('required_artifacts')):
+        raise ValueError('review delivery requires acceptance_criteria and required_artifacts')
+
+
+def _record(value):
+    result = json.loads(value or '{}') if isinstance(value, str) else value
+    if not isinstance(result, dict):
+        raise ValueError('delivery evidence is not a record')
+    return result
+
+
+def validate_run_verification(run, metadata):
+    """Bind recorded checks to this native attempt, without claiming execution."""
+    verification = _record(_record(metadata).get('verification'))
+    if (run is None or type(verification.get('run_id')) is not int
+            or verification['run_id'] != run.id):
+        raise ValueError('verification must identify the current run')
+    checks = verification.get('checks')
+    if not isinstance(checks, list):
+        raise ValueError('verification checks must belong to the current run')
+    for check in checks:
+        completed = check.get('completed_at') if isinstance(check, dict) else None
+        if type(completed) not in (int, float) or not completed >= run.started_at:
+            raise ValueError('verification checks predate the current run')
+
+
+def _review_handoff(conn, task, expected_run_id):
+    from hermes_cli import kanban_db as kb
+
+    run = kb.get_run(conn, task.current_run_id) if task.current_run_id is not None else None
+    if (run is None or run.task_id != task.id or run.id != expected_run_id
+            or run.status != 'running' or run.ended_at is not None
+            or kb._retry_status_for_run(conn, task.id, run.id) != 'review'):
+        raise ValueError('delivery requires a current independent review run')
+    event = conn.execute(
+        "SELECT id,run_id,payload FROM task_events WHERE task_id=? AND kind='review_requested' "
+        'ORDER BY id DESC LIMIT 1', (task.id,),
+    ).fetchone()
+    if event is None:
+        raise ValueError('delivery requires an independent review handoff')
+    route = _record(event['payload'])
+    implementer, reviewer = route.get('implementer'), route.get('reviewer')
+    if (not implementer or not reviewer or implementer == reviewer
+            or run.profile != reviewer or task.assignee != reviewer):
+        raise ValueError('delivery requires an independent review profile')
+    invalidated = conn.execute(
+        "SELECT 1 FROM task_events WHERE task_id=? AND id>? AND kind IN ('changes_requested','reopened') LIMIT 1",
+        (task.id, event['id']),
+    ).fetchone()
+    previous = kb.get_run(conn, event['run_id']) if event['run_id'] is not None else None
+    if (invalidated or previous is None or previous.task_id != task.id
+            or previous.profile != implementer or previous.outcome != 'review_requested'
+            or previous.ended_at is None or previous.id >= run.id):
+        raise ValueError('delivery review handoff is stale or unavailable')
+    return run, previous
+
+
+def completion_metadata(conn, task_id, metadata, expected_run_id):
+    """Called inside the native completion transaction, before its status CAS."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_run_inputs import brief_pin
+    from hermes_cli.kanban_task_contract import task_contract
+
+    task = kb.get_task(conn, task_id)
+    contract = task_contract(task.body) if task else None
+    if not contract or not contract.get('require_review'):
+        # A caller-supplied label is never a native delivery receipt.
+        if isinstance(metadata, dict) and 'delivery_acceptance' in metadata:
+            metadata = {k: v for k, v in metadata.items() if k != 'delivery_acceptance'}
+        return metadata
+    run, previous = _review_handoff(conn, task, expected_run_id)
+    metadata = _record(metadata)
+    approval = metadata.get('delivery_review')
+    if (not isinstance(approval, dict) or type(approval.get('version')) is not int
+            or approval['version'] != 1 or type(approval.get('handoff_run_id')) is not int
+            or approval['handoff_run_id'] != previous.id):
+        raise ValueError('delivery_review must identify the current handoff run')
+    criteria = approval.get('criteria')
+    if (not isinstance(criteria, list) or not all(isinstance(v, str) for v in criteria)
+            or len(criteria) != len(set(criteria))
+            or set(criteria) != set(contract['acceptance_criteria'])):
+        raise ValueError('delivery_review must cover every acceptance criterion')
+    validate_run_verification(previous, previous.metadata)
+    prior = _record(_record(previous.metadata).get('handoff_check', {}))
+    current = metadata.get('handoff_check', {})
+    pin = brief_pin(conn, task_id)['sha256']
+    if (prior.get('status') != 'declared_evidence_matches'
+            or prior.get('brief_sha256') != pin or current.get('brief_sha256') != pin):
+        raise ValueError('delivery review brief changed since implementation handoff')
+    prior_hashes, hashes = prior.get('artifact_hashes', {}), current.get('artifact_hashes', {})
+    if any(not hashes.get(name) or hashes[name] != prior_hashes.get(name)
+           for name in contract['required_artifacts']):
+        raise ValueError('delivery artifact changed since implementation handoff')
+    receipt = {'version': 1, 'handoff_run_id': previous.id, 'review_run_id': run.id,
+               'implementer': previous.profile, 'reviewer': run.profile,
+               'brief_sha256': pin, 'criteria': sorted(criteria),
+               'artifact_hashes': {name: hashes[name] for name in contract['required_artifacts']}}
+    return {**metadata, 'delivery_acceptance': receipt}
+
+
+def worker_context(conn, task):
+    """On-demand task brief, scoped to the native attempt; no prompt mutation."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_task_contract import task_contract
+
+    contract = task_contract(task.body)
+    if not contract or not contract.get('require_review'):
+        return ''
+    guidance = ('\n## Delivery acceptance\n'
+                'Declared outputs and every named check are required. Preserve the declared brief and input hashes. '
+                'An implementer must use kanban_request_review with a different reviewer profile, '
+                'not complete its own delivery. This contract grants no extra permissions or budget.\n')
+    if task.current_run_id is not None:
+        guidance += ('Bind freshly executed check records to metadata.verification.run_id='
+                     + str(task.current_run_id) + '. Check completed_at must not predate this run; '
+                     'never reuse another run verification record.\n')
+    if task.current_run_id is not None and kb._retry_status_for_run(conn, task.id) == 'review':
+        event = conn.execute(
+            "SELECT run_id FROM task_events WHERE task_id=? AND kind='review_requested' ORDER BY id DESC LIMIT 1",
+            (task.id,),
+        ).fetchone()
+        if event is not None:
+            record = {'version': 1, 'handoff_run_id': event['run_id'],
+                      'criteria': sorted(contract['acceptance_criteria'])}
+            guidance += ('Independently inspect the output and rerun the declared checks. On success, include '
+                         'metadata.delivery_review=' + json.dumps(record, sort_keys=True)
+                         + ' along with current verification and artifacts. If any criterion fails use '
+                         'kanban_request_changes; if input or authority is missing use kanban_block. '
+                         'Never claim acceptance from the implementer summary alone.\n')
+    return guidance
+
+
+def validate_review_target(conn, task_id, implementer, reviewer):
+    """Refuse self-review before a new reviewer can consume an inference call."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.kanban_task_contract import task_contract
+
+    task = kb.get_task(conn, task_id)
+    contract = task_contract(task.body) if task else None
+    if contract and contract.get('require_review') and (
+            not implementer or not reviewer or implementer == reviewer):
+        raise ValueError('delivery requires a named independent review profile')
diff --git a/hermes_cli/kanban_delivery_revision.py b/hermes_cli/kanban_delivery_revision.py
new file mode 100644
index 0000000000000000000000000000000000000000..82f957eb92e95347955268e3c8013176c57459f1
--- /dev/null
+++ b/hermes_cli/kanban_delivery_revision.py
@@ -0,0 +1,183 @@
+"""Compare the native handoffs immediately around a request for changes."""
+from __future__ import annotations
+
+from difflib import unified_diff
+from pathlib import Path
+import re
+
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_delivery import validate_run_verification
+from hermes_cli.kanban_run_inputs import brief_pin
+from hermes_cli.kanban_task_contract import _file_bytes
+
+_TEXT_LIMIT = 64 * 1024
+_MAX_LINES = 1200
+_HISTORY_LIMIT = 5
+
+
+def _requests(conn, task_id):
+    # Resolve adjacent event boundaries in one snapshot, including the limit probe.
+    return conn.execute("""
+        WITH newest AS (
+            SELECT id, run_id FROM task_events
+            WHERE task_id=:task AND kind='changes_requested'
+            ORDER BY id DESC LIMIT :limit
+        ), requests AS (
+            SELECT id, run_id, lag(id) OVER (ORDER BY id DESC) AS next_id FROM newest
+        )
+        SELECT run_id AS request_run_id,
+               (SELECT run_id FROM task_events
+                WHERE task_id=:task AND kind='review_requested' AND id < requests.id
+                ORDER BY id DESC LIMIT 1) AS before_run_id,
+               (SELECT run_id FROM task_events
+                WHERE task_id=:task AND kind='review_requested' AND id > requests.id
+                  AND (requests.next_id IS NULL OR id < requests.next_id)
+                ORDER BY id DESC LIMIT 1) AS after_run_id
+        FROM requests ORDER BY id DESC
+    """, {"task": task_id, "limit": _HISTORY_LIMIT + 1}).fetchall()
+
+
+def _run(conn, task_id, run_id, outcome):
+    run = kb.get_run(conn, run_id) if run_id is not None else None
+    if run and run.task_id == task_id and run.outcome == outcome and run.ended_at is not None:
+        return run
+    return None
+
+
+def _handoff(run):
+    metadata = run.metadata if run and isinstance(run.metadata, dict) else {}
+    stamp = metadata.get('handoff_check')
+    if not isinstance(stamp, dict) or stamp.get('status') != 'declared_evidence_matches':
+        return {}, {}, set()
+    try:
+        validate_run_verification(run, metadata)
+    except ValueError:
+        return {}, {}, set()
+    hashes, names, paths = stamp.get('artifact_hashes'), stamp.get('artifact_names'), metadata.get('artifacts')
+    hashes = {k: v for k, v in hashes.items()
+              if isinstance(k, str) and isinstance(v, str) and re.fullmatch('[0-9a-f]{64}', v)
+              } if isinstance(hashes, dict) else {}
+    locations = dict(zip(names, paths)) if (
+        isinstance(names, list) and isinstance(paths, list) and len(names) == len(paths)
+        and all(isinstance(name, str) for name in names)
+    ) else {}
+    checks = stamp.get('checks')
+    return stamp, {name: (digest, locations.get(name)) for name, digest in hashes.items()}, (
+        {value for value in checks if isinstance(value, str)} if isinstance(checks, list) else set())
+
+
+def _rounds(conn, task_id, request):
+    rejection = _run(conn, task_id, request['request_run_id'], 'changes_requested')
+    before = _run(conn, task_id, request['before_run_id'], 'review_requested')
+    if not rejection or before is None or before.id >= rejection.id:
+        return None
+    after = _run(conn, task_id, request['after_run_id'], 'review_requested')
+    if after and after.id <= rejection.id:
+        after = None
+    return before, rejection, after
+
+
+def revision_summary(conn, task_id, contract):
+    if not contract.get('require_review'):
+        return None
+    requests = _requests(conn, task_id)
+    latest = _rounds(conn, task_id, requests[0]) if requests else None
+    if not latest:
+        return None
+    summary = _summary(latest, contract)
+    if len(requests) > 1:
+        brief_hash = brief_pin(conn, task_id)['sha256']
+        summary['previous'] = [
+            _summary(rounds, contract, brief_hash)
+            for request in requests[1:_HISTORY_LIMIT]
+            if (rounds := _rounds(conn, task_id, request))
+        ]
+    if len(requests) > _HISTORY_LIMIT:
+        summary['history_limited'] = True
+    return summary
+
+
+def _summary(rounds, contract, brief_hash=None):
+    before, rejection, after = rounds
+    old_stamp, old, old_checks = _handoff(before)
+    new_stamp, new, new_checks = _handoff(after)
+    same_brief = bool(old_stamp and new_stamp and old_stamp.get('brief_sha256') == new_stamp.get('brief_sha256'))
+    files = []
+    for name in sorted(set(contract['required_artifacts']) | old.keys() | new.keys()):
+        old_hash, new_hash = old.get(name, (None, None))[0], new.get(name, (None, None))[0]
+        if old_hash and new_hash:
+            status = 'unchanged' if old_hash == new_hash else 'changed'
+        elif old_stamp and new_stamp and (old_hash or new_hash):
+            status = 'added' if new_hash else 'removed'
+        else:
+            status = 'unknown'
+        files.append({'name': name, 'status': status})
+    criteria = contract['acceptance_criteria']
+    if brief_hash is not None and any(
+        stamp and stamp.get('brief_sha256') != brief_hash for stamp in (old_stamp, new_stamp)
+    ):
+        criteria = {name: name for name in sorted(old_checks | new_checks)}
+    return {
+        'before_run_id': before.id, 'request_run_id': rejection.id, 'after_run_id': after.id if after else None,
+        'reason': (rejection.summary or '')[:2000], 'brief_changed': bool(old_stamp and new_stamp and not same_brief),
+        'files': files,
+        'criteria': [{'id': name, 'description': description,
+                      'before': name in old_checks, 'after': name in new_checks}
+                     for name, description in criteria.items()],
+    }
+
+
+def _text(conn, task, board, name, artifact):
+    from hashlib import sha256
+
+    digest, stored = artifact
+    if not isinstance(stored, str):
+        return None
+    path = Path(stored)
+    if not path.is_absolute():
+        return None
+    try:
+        attachments = kb.task_attachments_dir(task.id, board=board).resolve()
+        if path.parent == attachments and conn.execute(
+            'SELECT 1 FROM task_attachments WHERE task_id=? AND stored_path=?',
+            (task.id, stored),
+        ).fetchone():
+            root, relative = attachments, path.name
+        elif task.workspace_path:
+            root = Path(task.workspace_path).resolve(strict=True)
+            if (root / name).resolve(strict=True) != path:
+                return None
+            relative = name
+        else:
+            return None
+        data = _file_bytes(root, relative, [_TEXT_LIMIT])
+        if sha256(data).hexdigest() != digest:
+            return None
+        value = data.decode('utf-8')
+    except (OSError, ValueError, RuntimeError):
+        return None
+    if any(ord(char) < 32 and char not in '\n\r\t' or ord(char) == 127 for char in value):
+        return None
+    return value.splitlines(keepends=True)
+
+
+def revision_diff(conn, task, board, contract, name, before_id, after_id):
+    """Read only hash-matched text from a listed revision pair on this card."""
+    if not contract.get('require_review'):
+        return {'status': 'unavailable'}
+    requests = _requests(conn, task.id)[:_HISTORY_LIMIT]
+    request = next((row for row in requests
+                    if (row['before_run_id'], row['after_run_id']) == (before_id, after_id)), None)
+    rounds = _rounds(conn, task.id, request) if request else None
+    if not rounds or not rounds[2]:
+        return {'status': 'stale'}
+    old_stamp, old, _ = _handoff(rounds[0])
+    new_stamp, new, _ = _handoff(rounds[2])
+    if not old_stamp or not new_stamp or (name not in old and name not in new):
+        return {'status': 'unavailable'}
+    left = _text(conn, task, board, name, old[name]) if name in old else []
+    right = _text(conn, task, board, name, new[name]) if name in new else []
+    if left is None or right is None or len(left) + len(right) > _MAX_LINES:
+        return {'status': 'unavailable'}
+    lines = list(unified_diff(left, right, fromfile=f'Run {before_id}', tofile=f'Run {after_id}', lineterm=''))
+    return {'status': 'available', 'diff': '\n'.join(line.rstrip('\r\n') for line in lines)}
diff --git a/hermes_cli/kanban_delivery_usage.py b/hermes_cli/kanban_delivery_usage.py
new file mode 100644
index 0000000000000000000000000000000000000000..196cd7519db79769e97899c5c4ace5fb647659f7
--- /dev/null
+++ b/hermes_cli/kanban_delivery_usage.py
@@ -0,0 +1,229 @@
+"""Observed usage for native attempts leading to an accepted delivery."""
+from __future__ import annotations
+
+from collections import Counter
+from contextlib import closing
+import json
+from pathlib import Path
+import sqlite3
+
+from agent.session_activity import session_row_usage
+from agent.usage_run_binding import existing_key, key_id, run_digest
+from hermes_cli import kanban_db as kb
+from hermes_cli.profiles import get_profile_dir
+from hermes_cli.usage_attribution import normalize
+from hermes_cli.usage_attribution_sources import read_logs
+from hermes_constants import get_hermes_home
+from hermes_state_compression import _CHAIN_STEP_SQL
+
+_STAGES = ('think', 'action', 'revision', 'review', 'judge')
+_COUNTERS = ('api_calls', 'input_tokens', 'output_tokens', 'cache_read_tokens', 'cache_write_tokens', 'reasoning_tokens')
+_RUN_LIMIT = 32
+_SESSION_LIMIT = 64
+_USAGE_LIMIT = 256
+_LOG_PROFILE_LIMIT = 8
+_LOG_FILE_LIMIT = 4
+
+
+def _think_run(conn, contract):
+    pin = contract.get('role_plan')
+    if not isinstance(pin, dict) or type(pin.get('run_id')) is not int:
+        return None
+    row = kb.get_run(conn, pin['run_id'])
+    if not row or row.task_id != pin.get('task_id') or row.outcome != 'completed' or row.ended_at is None:
+        return None
+    record = (row.metadata or {}).get('role_plan')
+    if (isinstance(record, dict) and record.get('status') == 'validated'
+            and record.get('sha256') == pin.get('sha256') and record.get('run_id') == row.id):
+        return row
+    return None
+
+
+def _attempts(conn, task_id, receipt, contract):
+    previous = conn.execute(
+        "SELECT COALESCE(MAX(id),0) FROM task_runs WHERE task_id=? AND id<? AND outcome='completed'",
+        (task_id, receipt['handoff_run_id']),
+    ).fetchone()[0]
+    rejected = conn.execute(
+        "SELECT MIN(run_id) FROM task_events WHERE task_id=? AND kind='changes_requested' AND run_id>? AND run_id<?",
+        (task_id, previous, receipt['review_run_id']),
+    ).fetchone()[0]
+    rows = conn.execute(
+        'SELECT id FROM task_runs WHERE task_id=? AND id>? AND id<=? ORDER BY id DESC LIMIT ?',
+        (task_id, previous, receipt['review_run_id'], _RUN_LIMIT + 1),
+    ).fetchall()
+    result = []
+    think = _think_run(conn, contract)
+    if think:
+        result.append(('think', think))
+    for row in reversed(rows[:_RUN_LIMIT]):
+        run = kb.get_run(conn, row['id'])
+        if not run or run.ended_at is None:
+            continue
+        claim = kb._latest_event(conn, task_id, 'claimed', run.id)
+        origin = kb._json_dict(claim['payload']).get('source_status') if claim else None
+        if run.id == receipt['review_run_id'] or origin == 'review' or run.outcome == 'changes_requested':
+            stage = 'review'
+        elif run.id == receipt['handoff_run_id'] or origin == 'ready' or run.outcome == 'review_requested':
+            stage = 'revision' if rejected and run.id > rejected else 'action'
+        else:
+            stage = 'unclassified'
+        result.append((stage, run))
+    return result, len(rows) > _RUN_LIMIT
+
+
+def _profile_home(run):
+    if not run.profile:
+        return None
+    try:
+        return get_profile_dir(run.profile, home=get_hermes_home())
+    except ValueError:
+        return None
+
+
+def _binding(conn, board_slug, run, home):
+    event = kb._latest_event(conn, run.task_id, 'owner_admitted', run.id)
+    if event is None or not home:
+        return None
+    data = kb._json_dict(event['payload'])
+    expected = 'kanban:' + json.dumps([board_slug, run.task_id, run.id], separators=(',', ':'))
+    sid, stored = data.get('session_id'), data.get('db')
+    if (data.get('request_id') != expected or not isinstance(sid, str) or not 1 <= len(sid) <= 256
+            or not isinstance(stored, str) or not Path(stored).is_absolute()):
+        return None
+    try:
+        db = (home / 'state.db').resolve(strict=True)
+        if Path(stored).resolve(strict=True) == db and db.is_file():
+            return db, sid
+    except (OSError, RuntimeError, ValueError):
+        pass
+    return None
+
+
+def _stored_usage(binding):
+    """The private session store is opened read-only, along the native compression continuation."""
+    path, sid = binding
+    try:
+        with closing(sqlite3.connect(path.as_uri() + '?mode=ro', uri=True, timeout=0.25)) as conn:
+            conn.row_factory = sqlite3.Row
+            conn.execute('PRAGMA query_only=ON')
+            conn.execute('BEGIN')
+            if not conn.execute(
+                "SELECT 1 FROM sessions WHERE id=? AND (source='kanban' OR created_source='kanban')", (sid,)
+            ).fetchone():
+                return {}, False
+            chain = [sid]
+            limited = False
+            for _ in range(_SESSION_LIMIT):
+                child = conn.execute(_CHAIN_STEP_SQL, (chain[-1],)).fetchone()
+                if child is None:
+                    break
+                if child['id'] in chain or len(chain) == _SESSION_LIMIT:
+                    limited = True
+                    break
+                chain.append(child['id'])
+            placeholders = ','.join('?' for _ in chain)
+            rows = conn.execute(
+                'SELECT session_id,task,api_call_count AS api_calls,input_tokens,output_tokens,'
+                'cache_read_tokens,cache_write_tokens,reasoning_tokens,actual_cost_usd,cost_status '
+                f'FROM session_model_usage WHERE session_id IN ({placeholders}) '
+                'ORDER BY session_id,model,billing_provider,billing_mode,task LIMIT ?',
+                (*chain, _USAGE_LIMIT + 1),
+            ).fetchall()
+            by_session = {(path, member): [] for member in chain}
+            for row in rows[:_USAGE_LIMIT]:
+                values = dict(row)
+                values['input_tokens'] += values['cache_read_tokens'] + values['cache_write_tokens']
+                values['provider_reported_usd'] = session_row_usage(values)['actual_cost_usd']
+                if values['api_calls'] or any(values[key] for key in _COUNTERS[1:]) or values['provider_reported_usd'] is not None:
+                    by_session[(path, row['session_id'])].append(values)
+            return by_session, limited or len(rows) > _USAGE_LIMIT
+    except (OSError, sqlite3.Error):
+        return {}, False
+
+
+def _legacy_logs(home, first, last):
+    """Only existing bounded diagnostic tails, without creating a key or scanning the fleet."""
+    try:
+        key = existing_key(home)
+        files = sorted(((p.stat().st_mtime, p) for p in (home / 'logs').glob('*.log*')
+                        if p.is_file() and p.suffix != '.gz'), reverse=True)
+    except (OSError, ValueError):
+        return None, {}
+    samples, _ = read_logs([path for _, path in files[:_LOG_FILE_LIMIT]])
+    kid = key_id(key)
+    records = {}
+    for raw in samples:
+        row = normalize(raw, first, last)
+        if row and row['binding'] and row['key_id'] == kid:
+            records.setdefault(row['identity'], row)
+    return key, records
+
+
+def _sample(run, board_path, sample, seen):
+    key, records = sample
+    if key is None:
+        return []
+    expected = run_digest(key, board_path, run.task_id, run.id)
+    rows = []
+    for identity, row in records.items():
+        if row['binding'] == expected and run.started_at <= row['at'] < run.ended_at + 1 and identity not in seen:
+            seen.add(identity)
+            rows.append({'api_calls': 1, 'input_tokens': row['input'], 'cache_read_tokens': row['cached']})
+    return rows
+
+
+def _add(row, usage):
+    for key in (*_COUNTERS, 'provider_reported_usd'):
+        amount = usage.get(key)
+        if amount is not None:
+            row[key] = (row[key] or 0) + amount
+
+
+def reviewed_usage(conn, task, board, receipt, contract):
+    """Return only exact run/receipt-bound usage; missing and ambiguous data stay partial."""
+    attempts, limited = _attempts(conn, task.id, receipt, contract)
+    board_slug = kb._normalize_board_slug(board) or kb.get_current_board()
+    board_path = conn.execute('PRAGMA database_list').fetchone()['file']
+    stages = {stage: {'stage': stage, 'runs': [], **dict.fromkeys((*_COUNTERS, 'provider_reported_usd'))}
+              for stage in _STAGES}
+    if not attempts:
+        return {'coverage': 'partial', 'stages': list(stages.values()), 'limited': limited, 'unclassified_runs': 0}
+
+    stored, owners, homes = {}, Counter(), {}
+    for _, run in attempts:
+        home = homes[run.id] = _profile_home(run)
+        binding = _binding(conn, board_slug, run, home)
+        rows, capped = _stored_usage(binding) if binding else ({}, False)
+        owners.update(rows.keys())
+        stored[run.id] = rows
+        limited |= capped
+
+    logs, seen = {}, set()
+    first = min(run.started_at for _, run in attempts)
+    last = max(run.ended_at for _, run in attempts) + 1
+    unclassified = 0
+    for stage, run in attempts:
+        if stage == 'unclassified':
+            unclassified += 1
+            continue
+        owned = stored[run.id]
+        rows = [row for session, usage in owned.items() if owners[session] == 1 for row in usage]
+        source = 'session' if rows else 'unavailable'
+        home = homes[run.id]
+        if not rows and not any(owners[member] > 1 for member in owned) and home and board_path:
+            if home not in logs and len(logs) < _LOG_PROFILE_LIMIT:
+                logs[home] = _legacy_logs(home, first, last)
+            rows = _sample(run, board_path, logs.get(home, (None, {})), seen)
+            if rows:
+                source = 'diagnostics'
+        evidence = {'task_id': run.task_id, 'run_id': run.id, 'source': source}
+        stages[stage]['runs'].append(evidence)
+        has_judge = False
+        for usage in rows:
+            judge = usage.get('task') == 'goal_judge'
+            has_judge |= judge
+            _add(stages['judge' if judge else stage], usage)
+        if has_judge:
+            stages['judge']['runs'].append(evidence)
+    return {'coverage': 'partial', 'stages': list(stages.values()), 'limited': limited, 'unclassified_runs': unclassified}
diff --git a/hermes_cli/kanban_delivery_view.py b/hermes_cli/kanban_delivery_view.py
new file mode 100644
index 0000000000000000000000000000000000000000..5a3b42d7c29a94d121c07badd9d06d9d1beeaccc
--- /dev/null
+++ b/hermes_cli/kanban_delivery_view.py
@@ -0,0 +1,182 @@
+"""Bounded, board-scoped delivery projection. Reading never starts work.
+
+Acceptance describes evidence at handoff, not a fresh filesystem verification.
+"""
+from __future__ import annotations
+
+import json
+
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_delivery_revision import revision_summary
+from hermes_cli.kanban_run_inputs import brief_pin
+from hermes_cli.kanban_task_contract import task_contract
+
+
+def _record(value):
+    try:
+        parsed = json.loads(value or '{}') if isinstance(value, str) else value
+        return parsed if isinstance(parsed, dict) else {}
+    except (ValueError, TypeError):
+        return {}
+
+
+def _accepted(conn, task, contract, run):
+    metadata = _record(run.metadata)
+    receipt = _record(metadata.get('delivery_acceptance'))
+    stamp = _record(metadata.get('handoff_check'))
+    if not receipt:
+        return {'status': 'missing'}
+    event = conn.execute(
+        "SELECT id,run_id,created_at FROM task_events WHERE task_id=? AND kind='completed' ORDER BY id DESC LIMIT 1",
+        (task.id,),
+    ).fetchone()
+    if task.status not in ('done', 'archived') or (event and _retired(conn, task.id, event['id'])):
+        return {'status': 'invalid', 'reason': 'delivery_reopened'}
+    from hermes_cli.kanban_delivery import validate_run_verification
+    try:
+        validate_run_verification(run, metadata)
+    except ValueError:
+        return {'status': 'invalid', 'reason': 'check_attempt_mismatch'}
+    valid = (contract.get('require_review') and receipt.get('version') == 1
+             and event is not None and event['run_id'] == run.id
+             and receipt.get('review_run_id') == run.id and run.outcome == 'completed'
+             and run.ended_at is not None and receipt.get('reviewer') == run.profile
+             and receipt.get('brief_sha256') == brief_pin(conn, task.id)['sha256']
+             and receipt.get('criteria') == sorted(contract.get('acceptance_criteria', {})))
+    if not valid or not _handoff_matches(conn, task, receipt, stamp, contract):
+        return {'status': 'invalid', 'reason': 'evidence_mismatch'}
+    return {'status': 'accepted', 'receipt': receipt, 'accepted_at': event['created_at'],
+            'scope': 'evidence_at_handoff'}
+
+
+def _retired(conn, task_id, completed_event):
+    return conn.execute(
+        "SELECT 1 FROM task_events WHERE task_id=? AND id>? AND ("
+        "kind IN ('descendant_invalidated','reopened','review_reopened','changes_requested','claimed') "
+        "OR (kind='status' AND CASE WHEN json_valid(payload) THEN "
+        "COALESCE(json_extract(payload,'$.status'),'unknown') NOT IN ('done','archived') ELSE 1 END)) LIMIT 1",
+        (task_id, completed_event),
+    ).fetchone() is not None
+
+
+def _outputs(conn, task_id, contract):
+    if not contract.get('required_artifacts'):
+        return []
+    row = conn.execute(
+        "SELECT metadata,id FROM task_runs WHERE task_id=? AND outcome IN ('completed','review_requested') "
+        'ORDER BY id DESC LIMIT 1', (task_id,),
+    ).fetchone()
+    metadata = _record(row['metadata']) if row else {}
+    names = _record(metadata.get('handoff_check')).get('artifact_names', [])
+    paths = metadata.get('artifacts', [])
+    pairs = dict(zip(names, paths)) if (isinstance(names, list) and isinstance(paths, list)
+        and all(isinstance(name, str) for name in names)) else {}
+    return [{'name': name, 'stored_path': pairs.get(name) if isinstance(pairs.get(name), str) else None,
+             'run_id': row['id'] if row else None} for name in contract.get('required_artifacts', [])]
+
+
+def _handoff_matches(conn, task, receipt, stamp, contract):
+    handoff_id = receipt.get('handoff_run_id')
+    if type(handoff_id) is not int:
+        return False
+    previous = kb.get_run(conn, handoff_id)
+    if (previous is None or previous.task_id != task.id or previous.ended_at is None
+            or previous.outcome != 'review_requested' or previous.profile != receipt.get('implementer')
+            or previous.profile == receipt.get('reviewer') or previous.id >= receipt['review_run_id']):
+        return False
+    from hermes_cli.kanban_delivery import validate_run_verification
+    try:
+        validate_run_verification(previous, previous.metadata)
+    except ValueError:
+        return False
+    prior = _record(_record(previous.metadata).get('handoff_check'))
+    hashes = _record(receipt.get('artifact_hashes'))
+    if (stamp.get('status') != 'declared_evidence_matches'
+            or stamp.get('brief_sha256') != receipt.get('brief_sha256')
+            or prior.get('brief_sha256') != receipt.get('brief_sha256')):
+        return False
+    return all(isinstance(hashes.get(name), str) and len(hashes[name]) == 64
+               and hashes[name] == _record(stamp.get('artifact_hashes')).get(name)
+               and hashes[name] == _record(prior.get('artifact_hashes')).get(name)
+               for name in contract.get('required_artifacts', []))
+
+
+def _state(conn, task, run, verification, dependencies):
+    if task.status == 'archived':
+        return 'archived'
+    if task.status == 'done':
+        return 'delivered' if verification['status'] == 'accepted' else 'awaiting_verification'
+    if task.status == 'blocked':
+        return 'needs_input' if task.block_kind == 'needs_input' else 'waiting'
+    if task.status == 'running':
+        return 'reviewing' if kb._retry_status_for_run(conn, task.id) == 'review' else 'working'
+    if task.status == 'review':
+        return 'reviewing'
+    if task.status in ('todo', 'scheduled') or any(d['status'] not in ('done', 'archived') for d in dependencies):
+        return 'waiting'
+    if task.status == 'ready':
+        return 'changes_requested' if run and run.outcome == 'changes_requested' else 'ready'
+    return 'unknown'
+
+
+def delivery_summary(conn, task_id):
+    """Project only this connection's task and native evidence; no mutations."""
+    task = kb.get_task(conn, task_id)
+    if task is None:
+        return None
+    row = conn.execute('SELECT id FROM task_runs WHERE task_id=? ORDER BY id DESC LIMIT 1', (task_id,)).fetchone()
+    run = kb.get_run(conn, row['id']) if row else None
+    verification = {'status': 'missing'}
+    try:
+        contract = task_contract(task.body) or {}
+    except (ValueError, TypeError):
+        contract = {}
+        verification = {'status': 'invalid', 'reason': 'invalid_contract'}
+    if run and verification['status'] != 'invalid':
+        verification = _accepted(conn, task, contract, run)
+    rows = conn.execute(
+        'SELECT t.id,t.title,t.status FROM task_links l JOIN tasks t ON t.id=l.parent_id '
+        'WHERE l.child_id=? ORDER BY t.id LIMIT 65', (task_id,),
+    ).fetchall()
+    dependencies = [dict(row) for row in rows[:64]]
+    reason = None
+    if task.status == 'blocked':
+        event = conn.execute(
+            "SELECT payload FROM task_events WHERE task_id=? AND kind='blocked' ORDER BY id DESC LIMIT 1", (task_id,),
+        ).fetchone()
+        reason = _record(event['payload']).get('reason') if event else None
+        reason = reason[:2000] if isinstance(reason, str) else None
+    state = _state(conn, task, run, verification, dependencies)
+    return {'version': 1, 'task_id': task.id, 'objective': task.title,
+            'brief': (task.body or '').split('```hermes-contract\n', 1)[0][:8000],
+            'criteria': [{'id': key, 'description': value} for key, value in contract.get('acceptance_criteria', {}).items()],
+            'required_artifacts': contract.get('required_artifacts', []),
+            'outputs': _outputs(conn, task_id, contract),
+            'owner': task.assignee, 'current_step': task.current_step_key,
+            'current_run_id': task.current_run_id, 'native_status': task.status, 'state': state,
+            'latest_summary': (kb.latest_summary(conn, task_id) or '')[:8000],
+            'result': (task.result or '')[:8000], 'blocked_reason': reason,
+            'dependencies': dependencies, 'dependencies_truncated': len(rows) > 64,
+            'verification': verification, 'next_action': state,
+            'revision': revision_summary(conn, task_id, contract)}
+
+
+def reviewed_delivery_usage(conn, task_id, board, review_id):
+    """Open usage sources only when the caller names the current accepted review."""
+    view = delivery_summary(conn, task_id)
+    verification = view['verification'] if view else {}
+    receipt = verification.get('receipt')
+    if verification.get('status') != 'accepted' or receipt['review_run_id'] != review_id:
+        return None
+    task = kb.get_task(conn, task_id)
+    if task is None or task.status not in ('done', 'archived'):
+        return None
+    try:
+        contract = task_contract(task.body) or {}
+    except (ValueError, TypeError):
+        return None
+    if brief_pin(conn, task_id)['sha256'] != receipt['brief_sha256']:
+        return None
+    from hermes_cli.kanban_delivery_usage import reviewed_usage
+
+    return reviewed_usage(conn, task, board, receipt, contract)
diff --git a/hermes_cli/kanban_dispatch_evidence.py b/hermes_cli/kanban_dispatch_evidence.py
new file mode 100644
index 0000000000000000000000000000000000000000..74bb3246a0abe4dcead3c5b6c0ebd4ef42543513
--- /dev/null
+++ b/hermes_cli/kanban_dispatch_evidence.py
@@ -0,0 +1,67 @@
+"""Bounded local dispatch measurements. No model calls, state transitions or extra ticks."""
+from collections import OrderedDict
+from contextlib import suppress
+import hashlib
+import json
+import logging
+import threading
+import time
+
+_LOG = logging.getLogger(__name__)
+_LAST = OrderedDict()
+_LOCK = threading.Lock()
+_LIMIT = 128
+
+
+def mark(result, task_id, stage, *, run_id=None):
+    rows = getattr(result, '_admission_evidence', None)
+    if rows is None:
+        rows = result._admission_evidence = {}
+    if task_id not in rows and len(rows) >= _LIMIT:
+        result._admission_evidence_truncated = True
+        return
+    row = rows.setdefault(task_id, {})
+    row[stage] = time.time()
+    if run_id is not None:
+        row['run_id'] = run_id
+
+
+def capacity(result, reason, slots=None):
+    result._capacity_evidence = {'reason': reason, 'available_slots': slots}
+
+
+def snapshot(result):
+    reasons = {name: len(getattr(result, name, [])) for name in (
+        'spawned','skipped_per_profile_capped','skipped_unassigned','skipped_nonspawnable',
+        'respawn_guarded','auto_blocked')}
+    rows = getattr(result, '_admission_evidence', {})
+    return {'version': 1, 'at': time.time(), 'process_id': __import__('os').getpid(),
+            'capacity': getattr(result, '_capacity_evidence', {'reason': 'not_observed'}),
+            'counts': reasons, 'tasks': rows,
+            'truncated': bool(getattr(result, '_admission_evidence_truncated', False)),
+            'review_slot_reused': getattr(result, '_review_slot_reused', 0),
+            'passed_dispatch_gates_not_claimed': sum('passed_dispatch_gates_at' in r and 'claimed_at' not in r for r in rows.values()),
+            'eligibility_limit': 'Dispatch guards observed at this tick; atomic claim rechecks dependencies and ownership. No continuous eligibility or unused-capacity duration inferred.'}
+
+
+def emit(conn, result, *, dry_run=False):
+    """After the dispatch lock; failures cannot retry a tick or interfere with work."""
+    if dry_run or not _LOG.isEnabledFor(logging.INFO):
+        return
+    with suppress(Exception):
+        row = snapshot(result)
+        db = conn.execute('PRAGMA database_list').fetchone()[2]
+        board = hashlib.sha256(db.encode()).hexdigest()[:16]
+        row['board'] = board
+        # Idle/unchanged summaries at most once per five minutes, bounded per process.
+        signature = json.dumps([row['capacity'], row['counts'], sorted(row['tasks'])], sort_keys=True)
+        now = time.monotonic()
+        with _LOCK:
+            previous = _LAST.get(board)
+            if not row['counts']['spawned'] and previous and previous[0] == signature and now-previous[1] < 300:
+                return
+            _LAST[board] = (signature, now)
+            _LAST.move_to_end(board)
+            while len(_LAST) > _LIMIT:
+                _LAST.popitem(last=False)
+        _LOG.info('DISPATCH_EVIDENCE %s', json.dumps(row, separators=(',', ':')))
diff --git a/hermes_cli/kanban_dispatch_lane.py b/hermes_cli/kanban_dispatch_lane.py
new file mode 100644
index 0000000000000000000000000000000000000000..b030c6a26e751c522fe6c9c2cb9f2886468cb098
--- /dev/null
+++ b/hermes_cli/kanban_dispatch_lane.py
@@ -0,0 +1,330 @@
+"""Native lane helpers; preserve fairness, caps and the existing spawn contract."""
+from __future__ import annotations
+
+import sqlite3
+from contextlib import closing
+from typing import Optional
+
+
+def stop_if_paused(result) -> bool:
+    """Stop before admitting new work; an existing claim is left alone."""
+    from agent.estop import check_paused
+    from hermes_cli import kanban_db
+
+    if check_paused('kanban', kanban_db._log):
+        result.skipped_paused = True
+        return True
+    return False
+
+
+def configured_daemon_caps():
+    """Read the optional board and profile caps without changing config."""
+    from hermes_cli import kanban_db_dispatch as dispatch
+    from hermes_cli.config import load_config_readonly
+
+    config = load_config_readonly().get('kanban') or {}
+    return (dispatch._positive_int(config.get('max_spawn'), None, minimum=0),
+            dispatch._positive_int(config.get('max_in_progress_per_profile'), None))
+
+
+class CapacityUnavailable(Exception):
+    """A configured host or profile cap cannot be verified across boards."""
+
+
+def other_board_running_counts(board, *, strict=False):
+    """Count other active board rows once per resolved database path."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli.sqlite_safe_read import connect_tracked
+
+    try:
+        current = str(kb.kanban_db_path(board=board).expanduser().resolve())
+        boards = kb.list_boards(include_archived=False)
+    except Exception as exc:
+        if strict:
+            raise CapacityUnavailable('board enumeration unavailable') from exc
+        return 0, {}
+    seen = {current}
+    total = 0
+    counts: dict[str, int] = {}
+    for meta in boards:
+        slug = meta.get('slug') or kb.DEFAULT_BOARD
+        try:
+            path = kb.kanban_db_path(board=slug).expanduser()
+            resolved = str(path.resolve())
+            if resolved in seen:
+                continue
+            if not path.exists():
+                if strict:
+                    raise CapacityUnavailable('board database unavailable')
+                continue
+            seen.add(resolved)
+            uri = path.resolve().as_uri() + '?mode=ro'
+            with closing(connect_tracked(uri, tracking_path=path, uri=True, timeout=1.0)) as conn:
+                conn.row_factory = sqlite3.Row
+                rows = conn.execute("SELECT assignee, COUNT(*) AS n FROM tasks WHERE status='running' GROUP BY assignee")
+                for row in rows:
+                    n = int(row['n'])
+                    total += n
+                    if row['assignee']:
+                        counts[row['assignee']] = counts.get(row['assignee'], 0) + n
+        except Exception as exc:
+            if strict:
+                raise CapacityUnavailable('board capacity unavailable') from exc
+            continue
+    return total, counts
+
+
+def claim_with_capacity(conn, task_id, assignee, result, *, lane, ttl_seconds, board,
+                        host_cap, per_profile_cap):
+    """Reserve a real claim while shared board capacity is serialized."""
+    from hermes_cli import kanban_db as kb
+    from hermes_cli import kanban_db_connect as kbc
+    from hermes_cli.kanban_dispatch_evidence import capacity
+
+    claim = kb.claim_review_task if lane == 'review' else kb.claim_task
+    if host_cap is None and per_profile_cap is None:
+        return None if stop_if_paused(result) else claim(conn, task_id, ttl_seconds=ttl_seconds)
+    with kbc._dispatch_admission_lock(kb.kanban_home()) as lock_state:
+        if lock_state != 'held':
+            result.skipped_capacity_locked = True
+            result.capacity_lock_reason = lock_state
+            return None
+        if stop_if_paused(result):
+            return None
+        try:
+            other_total, other_profiles = other_board_running_counts(board, strict=True)
+        except CapacityUnavailable:
+            result.skipped_capacity_unknown = True
+            capacity(result, 'board_capacity_unknown')
+            return None
+        if host_cap is not None:
+            local_total = conn.execute("SELECT COUNT(*) FROM tasks WHERE status='running'").fetchone()[0]
+            if local_total + other_total >= host_cap:
+                capacity(result, 'host_cap', 0)
+                result._host_capacity_exhausted = True
+                return None
+        if per_profile_cap is not None:
+            local = conn.execute("SELECT COUNT(*) FROM tasks WHERE status='running' AND assignee=?", (assignee,)).fetchone()[0]
+            current = local + other_profiles.get(assignee, 0)
+            if current >= per_profile_cap:
+                result.skipped_per_profile_capped.append((task_id, assignee, current))
+                return None
+        return claim(conn, task_id, ttl_seconds=ttl_seconds)
+
+
+def call_spawn(spawn_fn, task, workspace: str, board: str | None) -> int | None:
+    """Back-compat: older spawn_fn signatures (and test stubs) accept only
+    ``(task, workspace)``; pass ``board`` only when the callable supports it."""
+    import inspect
+    try:
+        sig = inspect.signature(spawn_fn)
+    except (TypeError, ValueError):
+        sig = None
+    # Catch signature inspection errors only. A callback may already have spawned
+    # before raising: no exception from its body can authorize a second launch.
+    if sig is not None and "board" in sig.parameters:
+        return spawn_fn(task, workspace, board=board)
+    return spawn_fn(task, workspace)
+
+
+def dispatch_ready_row(conn, row, result, default_assignee, lane_kwargs):
+    if stop_if_paused(result):
+        return False
+    assignee = row['assignee']
+    if not assignee:
+        if not default_assignee or not apply_default_assignee(
+                conn, row['id'], default_assignee, dry_run=lane_kwargs['dry_run']):
+            result.skipped_unassigned.append(row['id'])
+            return False
+        assignee = default_assignee
+        result.auto_assigned_default.append(row['id'])
+    return dispatch_lane_task(conn, row, assignee, result, lane='ready', **lane_kwargs)
+
+
+def apply_default_assignee(
+    conn, task_id: str, assignee: str, *, dry_run: bool,
+) -> bool:
+    """Persist ``kanban.default_assignee`` on an unassigned ready row.
+
+    Mutating the row keeps board state honest: the task is legitimately owned
+    by the default, not "unassigned but secretly routed". ``dry_run`` reports
+    without writing. Returns False when the write failed.
+    """
+    from hermes_cli import kanban_db as _kb
+    logger = _kb._log
+
+    if dry_run:
+        return True
+    try:
+        with _kb.write_txn(conn):
+            conn.execute(
+                "UPDATE tasks SET assignee = ? WHERE id = ? "
+                "AND (assignee IS NULL OR assignee = '')",
+                (assignee, task_id),
+            )
+            _kb._append_event(
+                conn, task_id, "assigned",
+                {"assignee": assignee, "source": "kanban.default_assignee"},
+            )
+    except Exception:
+        logger.debug(
+            "kanban dispatch: failed to apply default_assignee=%r to task %s",
+            assignee, task_id, exc_info=True,
+        )
+        return False
+    return True
+
+
+
+
+def _lane_guard_rejects(conn, row, assignee, result, *, lane, dry_run, per_profile_cap, per_profile_running):
+    """Record pre-claim guard failures without changing their existing semantics."""
+    from hermes_cli import kanban_db_dispatch as dispatch
+    _kb = dispatch._kb
+    _profile_exists_fn = dispatch._profile_exists_fn
+    check_respawn_guard = dispatch.check_respawn_guard
+    task_id = row["id"]
+    # Non-profile assignees (control-plane lanes that pull via ``claim_task``)
+    # would fail ``hermes -p <assignee>`` at startup and loop ready→crash→ready
+    # forever. Bucketed apart from skipped_unassigned: the operator cannot fix
+    # it by assigning a profile, and health telemetry suppresses "stuck" for it.
+    profile_exists = _profile_exists_fn()
+    if profile_exists is not None and not profile_exists(assignee):
+        result.skipped_nonspawnable.append(task_id)
+        # Per-task diagnostic so ``show``/``tail`` name the missing profile instead of leaving
+        # the card in ``ready`` with zero board evidence (#122422). Unlike a respawn guard the
+        # condition never expires on its own, so write it once: a repeat only when something
+        # else happened on the card since (reassign, comment) — not one row per tick forever,
+        # and not one row per foreign home per tick on a shared board (#101015).
+        if not dry_run:
+            with _kb.write_txn(conn):
+                last = conn.execute(
+                    "SELECT kind, payload FROM task_events WHERE task_id = ? "
+                    "ORDER BY created_at DESC, id DESC LIMIT 1", (task_id,)).fetchone()
+                if (last is None or last["kind"] != "skipped_nonspawnable"
+                        or last["payload"] != _kb._json_or_null({"assignee": assignee})):
+                    _kb._append_event(conn, task_id, "skipped_nonspawnable", {"assignee": assignee})
+        return True
+    # Per-profile cap: one profile's local model / API quota / browser pool
+    # must not be overwhelmed by a fan-out even with global headroom.
+    if per_profile_cap is not None:
+        current = per_profile_running.get(assignee, 0)
+        if current >= per_profile_cap:
+            result.skipped_per_profile_capped.append((task_id, assignee, current))
+            return True
+    from hermes_cli.kanban_task_contract import guard_dispatch
+    if lane == 'ready' and guard_dispatch(conn, row, assignee, result, dry_run=dry_run):
+        return True
+    guard_reason = check_respawn_guard(conn, task_id, lane=lane)
+    if guard_reason is not None:
+        result.respawn_guarded.append((task_id, guard_reason))
+        # Event so ``hermes kanban tail`` shows why the task looks stuck.
+        if not dry_run:
+            with _kb.write_txn(conn):
+                _kb._append_event(conn, task_id, "respawn_guarded", {"reason": guard_reason})
+        return True
+
+    return False
+
+
+def dispatch_lane_task(
+    conn: sqlite3.Connection,
+    row: sqlite3.Row,
+    assignee: str,
+    result,
+    *,
+    lane: str,
+    dry_run: bool,
+    ttl_seconds: Optional[int],
+    board: Optional[str],
+    failure_limit: int,
+    spawn_fn,
+    per_profile_cap: Optional[int],
+    per_profile_running: dict[str, int],
+    host_cap: Optional[int],
+) -> bool:
+    """Guard, claim, resolve the workspace and spawn one ready/review row.
+    Returns True when a spawn slot was consumed (real or ``dry_run``); every
+    skip is recorded on ``result``.
+    """
+    from hermes_cli import kanban_db_dispatch as dispatch
+    _kb, _kbw = dispatch._kb, dispatch._kbw
+    _record_task_failure, _default_spawn = dispatch._record_task_failure, dispatch._default_spawn
+    _set_worker_pid = dispatch._set_worker_pid
+    if stop_if_paused(result):
+        return False
+    task_id = row["id"]
+    from hermes_cli.kanban_dispatch_evidence import mark
+    mark(result, task_id, "considered_at")
+    if _lane_guard_rejects(conn, row, assignee, result, lane=lane, dry_run=dry_run,
+                           per_profile_cap=per_profile_cap, per_profile_running=per_profile_running):
+        return False
+
+    def _count_spawn(name: str) -> None:
+        # Later rows in this tick respect the per-profile cap; subsequent
+        # ticks re-query from the DB.
+        if per_profile_cap is not None and name:
+            per_profile_running[name] = per_profile_running.get(name, 0) + 1
+
+    if dry_run:
+        result.spawned.append((task_id, assignee, ""))
+        _count_spawn(assignee)
+        return True
+    mark(result, task_id, "passed_dispatch_gates_at")
+    claimed = claim_with_capacity(conn, task_id, assignee, result, lane=lane, ttl_seconds=ttl_seconds,
+                                  board=board, host_cap=host_cap, per_profile_cap=per_profile_cap)
+    if claimed is None:
+        return False
+    mark(result, task_id, "claimed_at", run_id=_kb._current_run_id(conn, task_id))
+    try:
+        resolved_branch_name = None
+        if claimed.workspace_kind == "worktree":
+            workspace, resolved_branch_name = _kbw._resolve_worktree_workspace(claimed, board=board)
+        else:
+            workspace = _kbw.resolve_workspace(claimed, board=board)
+    except Exception as exc:
+        if _record_task_failure(
+            conn, claimed.id, f"workspace: {exc}",
+            outcome="spawn_failed", failure_limit=failure_limit, release_claim=True, end_run=True,
+            event_payload_extra={"diagnostic": {"phase": "workspace", "error_type": type(exc).__name__}},
+        ):
+            result.auto_blocked.append(claimed.id)
+        return False
+    _kbw.set_workspace_path(conn, claimed.id, str(workspace))
+    if claimed.workspace_kind == "worktree":
+        _kbw.set_branch_name(conn, claimed.id, resolved_branch_name or (claimed.branch_name or "").strip() or f"wt/{claimed.id}")
+    _kbw._maybe_emit_scratch_tip(conn, claimed.id, claimed.workspace_kind)
+    if lane == "review":
+        # Force-load sdlc-review; the kanban lifecycle is already in every
+        # worker's system prompt via KANBAN_GUIDANCE.
+        claimed.skills = list(dict.fromkeys([*(claimed.skills or []), "sdlc-review"]))
+    try:
+        pid = call_spawn(spawn_fn if spawn_fn is not None else _default_spawn, claimed, str(workspace), board)
+        if pid:
+            _set_worker_pid(conn, claimed.id, int(pid), run_id=claimed.current_run_id, claim_lock=claimed.claim_lock)
+        # Fires AFTER the PID (when reported) is durably persisted. Best-effort.
+        _kb._fire_worker_spawned_hook(conn, claimed, str(workspace), pid, board=board)
+        # consecutive_failures is deliberately NOT reset here: resetting on
+        # spawn would let a task that keeps timing out loop forever. Cleared
+        # only on successful completion (complete_task).
+        mark(result, task_id, "spawn_returned_at")
+        result.spawned.append((claimed.id, claimed.assignee or "", str(workspace)))
+        _count_spawn(claimed.assignee)
+        return True
+    except Exception as exc:
+        from tools.process_registry import RestartSafeScopeUnavailable
+        result._spawn_attempt_failed = True
+
+        # The host refused the spawn (no restart-safe scope): nothing about the
+        # card ran, so it must not spend the card's retry budget (#114720).
+        infrastructure = isinstance(exc, RestartSafeScopeUnavailable)
+        if infrastructure:
+            _kb._log.warning("kanban dispatcher: spawn of %s deferred, host cannot place the worker: %s", claimed.id, exc)
+        if _record_task_failure(
+            conn, claimed.id, str(exc),
+            outcome="spawn_failed", failure_limit=failure_limit, release_claim=True, end_run=True,
+            infrastructure=infrastructure, event_payload_extra={"diagnostic": {"phase": "spawn", "error_type": type(exc).__name__}},
+        ):
+            result.auto_blocked.append(claimed.id)
+        return False
+
diff --git a/hermes_cli/kanban_dispatch_wake.py b/hermes_cli/kanban_dispatch_wake.py
new file mode 100644
index 0000000000000000000000000000000000000000..9e5abded4db7312898e58adcb76cbcc0baa3b034
--- /dev/null
+++ b/hermes_cli/kanban_dispatch_wake.py
@@ -0,0 +1,156 @@
+"""Coalesced local hints to the existing dispatcher, never an admission authority.
+
+A hint is emitted only after the outer native transaction commits. A lost hint
+is harmless: the normal periodic dispatcher still reads durable board state.
+"""
+from __future__ import annotations
+
+import asyncio
+import contextlib
+from contextvars import ContextVar
+from dataclasses import dataclass
+import logging
+import os
+from hermes_platform.host.identity import current_user_id
+from pathlib import Path
+import socket
+import stat
+import time
+
+log = logging.getLogger(__name__)
+_WAKE_KINDS = frozenset({
+    'created', 'promoted', 'completed', 'blocked', 'unblocked', 'assigned',
+    'review_requested', 'changes_requested', 'archived', 'unlinked',
+})
+
+
+@dataclass
+class _Frame:
+    conn: object
+    dirty: bool = False
+
+
+_FRAMES: ContextVar[tuple[_Frame, ...]] = ContextVar('kanban_dispatch_transactions', default=())
+
+
+def mark_event(conn, kind, payload):
+    if kind not in _WAKE_KINDS:
+        return
+    if kind == 'created' and (payload or {}).get('status') not in ('ready', 'review'):
+        return
+    for frame in reversed(_FRAMES.get()):
+        if frame.conn is conn:
+            frame.dirty = True
+            break
+
+
+@contextlib.contextmanager
+def transaction_events(conn):
+    parents = _FRAMES.get()
+    frame = _Frame(conn)
+    token = _FRAMES.set((*parents, frame))
+    try:
+        yield
+        if frame.dirty:
+            parent = next((f for f in reversed(parents) if f.conn is conn), None)
+            if parent is not None:
+                parent.dirty = True
+            elif not conn.in_transaction:
+                notify_dispatcher()
+    finally:
+        _FRAMES.reset(token)
+
+
+def wake_path(home: Path) -> Path:
+    return home / 'kanban' / '.dispatcher.wake.sock'
+
+
+def notify_dispatcher():
+    """One nonblocking, content-free datagram; no retry, network or model call."""
+    if not hasattr(socket, 'AF_UNIX'):
+        return
+    from hermes_cli.kanban_db import kanban_home
+    try:
+        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
+            sock.setblocking(False)
+            sock.sendto(b'1', str(wake_path(kanban_home())))
+    except OSError:
+        # No listener / full queue / unsupported path: periodic fallback owns recovery.
+        return
+
+
+class DispatchWakeReceiver:
+    """Single-lock-owner listener. Burst hints collapse to one extra ordinary tick."""
+    def __init__(self, home, *, enabled=True):
+        self.path = wake_path(Path(home))
+        self.enabled = enabled
+        self.sock = None
+        self.event = asyncio.Event()
+        self.last_tick = time.monotonic()
+        self.identity = None
+
+    def __enter__(self):
+        if not self.enabled or not hasattr(socket, 'AF_UNIX'):
+            return self
+        try:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            if self.path.exists():
+                st = self.path.lstat()
+                if not stat.S_ISSOCK(st.st_mode) or st.st_uid != current_user_id():
+                    raise OSError('dispatcher wake path is not an owned socket')
+                self.path.unlink()  # caller already owns the native singleton lock
+            self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
+            self.sock.setblocking(False)
+            self.sock.bind(str(self.path))
+            os.chmod(self.path, 0o600)
+            self.identity = self.path.stat().st_ino
+            asyncio.get_running_loop().add_reader(self.sock.fileno(), self._receive)
+        except (OSError, NotImplementedError) as exc:
+            log.warning('kanban event wake unavailable; keeping periodic dispatch: %s', type(exc).__name__)
+            self.close()
+        return self
+
+    def _receive(self):
+        for _ in range(256):  # bounded drain; the loop invokes us again if necessary
+            try:
+                self.sock.recv(1)
+            except BlockingIOError:
+                break
+            self.event.set()
+
+    async def wait(self, interval, running):
+        deadline = time.monotonic() + interval
+        # At most one tick per second during event storms. No model is involved.
+        earliest = self.last_tick + min(1.0, interval)
+        while running():
+            now = time.monotonic()
+            if now >= deadline or (now >= earliest and self.event.is_set()):
+                reason = 'event' if self.event.is_set() else 'periodic'
+                self.event.clear()
+                self.last_tick = now
+                return reason
+            delay = min(1.0, max(0.001, deadline - now))
+            if now < earliest:
+                await asyncio.sleep(min(delay, earliest - now))
+            else:
+                try:
+                    await asyncio.wait_for(self.event.wait(), delay)
+                except TimeoutError:
+                    continue
+        return 'stopped'
+
+    def close(self):
+        if self.sock is not None:
+            asyncio.get_running_loop().remove_reader(self.sock.fileno())
+            self.sock.close()
+            self.sock = None
+        if self.identity is not None:
+            try:
+                if self.path.lstat().st_ino == self.identity:
+                    self.path.unlink()
+            except FileNotFoundError:
+                pass
+            self.identity = None
+
+    def __exit__(self, *exc):
+        self.close()
