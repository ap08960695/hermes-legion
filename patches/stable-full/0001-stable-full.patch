+"""A rolled-back compaction must not announce a memory/UI boundary or erase real usage."""
+from types import SimpleNamespace
+
+import pytest
+
+from agent.context_compressor import SUMMARY_PREFIX
+from agent.conversation_compression import CompressionCommitFence
+from agent.memory_manager import MemoryManager
+from agent.usage_anchor import capture_usage_anchor, set_usage_anchor, persisted_anchor_tokens
+from hermes_state import SessionDB
+from tests.agent.test_compression_rotation_state import _build_agent_with_db, _seed_bulk_head
+
+
+@pytest.fixture
+def case(tmp_path, monkeypatch):
+    import httpx
+    import requests
+    def no_http(*args, **kwargs):
+        raise AssertionError('HTTP is forbidden in this offline compaction test')
+    monkeypatch.setattr(httpx.Client, 'send', no_http)
+    monkeypatch.setattr(httpx.AsyncClient, 'send', no_http)
+    monkeypatch.setattr(requests.sessions.Session, 'request', no_http)
+    db=SessionDB(tmp_path/'state.db')
+    sid='failed-compaction-parent'
+    db.create_session(sid,source='cli')
+    _seed_bulk_head(db,sid)
+    agent=_build_agent_with_db(db,sid,platform='cli')
+    agent._compression_feasibility_checked=True
+    agent.context_compressor.compress.return_value=[
+        {'role':'user','content':SUMMARY_PREFIX+'Earlier work retained.'},
+        {'role':'assistant','content':'persisted answer'},
+    ]
+    agent.context_compressor.last_prompt_tokens=120_000
+    agent.context_compressor.last_completion_tokens=250
+    agent.context_compressor.awaiting_real_usage_after_compression=False
+    messages=db.get_messages_as_conversation(sid)
+    events,switches=[],[]
+    manager=MemoryManager()
+    manager.add_provider(SimpleNamespace(name='builtin',get_tool_schemas=list,
+        on_session_end=lambda messages:None,on_session_switch=lambda *a,**kw:switches.append((a,kw)),
+        shutdown=lambda:None,system_prompt_block=lambda:""))
+    agent._memory_manager=manager
+    agent.event_callback=lambda kind,payload:events.append((kind,payload))
+    anchor=capture_usage_anchor(120_000,250,messages)
+    set_usage_anchor(agent,anchor)
+    yield SimpleNamespace(db=db,sid=sid,agent=agent,messages=messages,events=events,switches=switches,anchor=anchor)
+    agent.close()
+    db.close()
+
+
+@pytest.mark.parametrize('in_place',[True,False],ids=['in-place','rotation'])
+def test_failed_atomic_commit_keeps_memory_boundary_and_usage(case,in_place):
+    case.agent.compression_in_place=in_place
+    before=case.db.get_messages_as_conversation(case.sid)
+    # Abort INSIDE native SQLite publication, after archive/child writes began.
+    with case.db._conn:
+        case.db._conn.execute("CREATE TRIGGER refuse_compaction BEFORE INSERT ON messages "
+            "BEGIN SELECT RAISE(ABORT, 'fixture: atomic SQLite publication refused'); END")
+    returned,_=case.agent._compress_context(case.messages,'system',approx_tokens=120_000,
+        force=True,commit_fence=CompressionCommitFence())
+    assert returned==before and case.db.get_messages_as_conversation(case.sid)==before
+    assert case.agent.session_id==case.sid and case.db.get_session(case.sid)['ended_at'] is None
+    assert case.switches==[], 'a rolled-back transcript is not a provider session switch'
+    assert not [e for e in case.events if e[0]=='session:compress'], 'no successful UI/plugin boundary occurred'
+    assert case.agent._usage_anchor==case.anchor, 'the original provider-priced transcript is still current'
+    assert persisted_anchor_tokens(case.db,case.sid,before)==120_250
+    assert case.agent.context_compressor.last_prompt_tokens==120_000
+    assert case.agent.context_compressor.last_completion_tokens==250
+    assert case.agent.context_compressor.awaiting_real_usage_after_compression is False
+    assert case.agent._last_compression_attempt_in_place is None
+    # A later ordinary persist and cold reader must retain only the original rows.
+    assert case.agent._flush_messages_to_session_db(returned, before) is not False
+    with SessionDB(case.db.db_path, read_only=True) as reader:
+        assert reader.get_messages_as_conversation(case.sid)==before
+        assert persisted_anchor_tokens(reader,case.sid,before)==120_250
+
+
+@pytest.mark.parametrize('in_place',[True,False],ids=['in-place','rotation'])
+def test_committed_transcript_still_notifies_memory_and_ui(case,in_place):
+    case.agent.compression_in_place=in_place
+    returned,_=case.agent._compress_context(case.messages,'system',approx_tokens=120_000,
+        force=True,commit_fence=CompressionCommitFence())
+    assert len(returned)<len(case.messages)
+    assert len(case.switches)==1 and len([e for e in case.events if e[0]=='session:compress'])==1
+    assert case.agent._usage_anchor is None
+
+
+def test_successful_memory_only_compaction_still_announces_boundary(case):
+    case.agent.compression_in_place=True
+    case.agent._session_db=None
+    returned,_=case.agent._compress_context(case.messages,'system',approx_tokens=120_000,
+        force=True,commit_fence=CompressionCommitFence())
+    assert len(returned)<len(case.messages)
+    assert len(case.switches)==1 and len([e for e in case.events if e[0]=='session:compress'])==1
+
+
+@pytest.mark.parametrize('in_place',[True,False],ids=['in-place','rotation'])
+def test_error_after_real_commit_does_not_hide_the_applied_boundary(case,monkeypatch,in_place):
+    case.agent.compression_in_place=in_place
+    if in_place:
+        def fail_after_commit(*a,**kw):raise OSError('fixture: prompt bookkeeping failed after atomic commit')
+        monkeypatch.setattr('agent.context_compressor.stamp_db_persisted_markers',fail_after_commit)
+    else:
+        from agent import conversation_compression
+        def fail_after_commit(*a,**kw):raise OSError('fixture: carry metadata failed after child publication')
+        monkeypatch.setattr(conversation_compression,'_carry_session_state_to_child',fail_after_commit)
+    returned,_=case.agent._compress_context(case.messages,'system',approx_tokens=120_000,
+        force=True,commit_fence=CompressionCommitFence())
+    durable=case.db.get_messages_as_conversation(case.agent.session_id)
+    assert len(durable)==len(returned)<len(case.messages)
+    assert len(case.switches)==1 and len([e for e in case.events if e[0]=='session:compress'])==1
+    assert case.agent._usage_anchor is None
+    assert case.agent._last_compaction_in_place is in_place
+    assert case.agent._flush_messages_to_session_db(returned, durable) is not False
+    assert case.db.get_messages_as_conversation(case.agent.session_id) == durable
