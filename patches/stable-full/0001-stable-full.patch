+"""Concurrent native MCP cache writers retain peer servers without re-discovery."""
+import json
+import multiprocessing
+import os
+from pathlib import Path
+
+import pytest
+
+
+def _writer(root, server, started, read, release, done):
+    os.environ.update(HOME=str(root), HERMES_HOME=str(root), HERMES_MANAGED_DIR=str(root / 'managed'),
+                      HERMES_DISABLE_LAZY_INSTALLS='1')
+    from tools import mcp_schema_cache as cache
+    cache._cache_path = lambda: root / 'cache.json'
+    native = cache._load_all
+    if read is not None:
+        def snapshot():
+            data = native()
+            read.set()
+            if not release.wait(15):
+                raise TimeoutError('test writer was not released')
+            return data
+        cache._load_all = snapshot
+    started.set()
+    try:
+        cache.write_cache_entry(server, 'fixture', tools=[{'name': server}])
+    finally:
+        done.set()
+
+
+def test_two_process_writers_preserve_both_native_manifests(tmp_path):
+    ctx = multiprocessing.get_context('spawn')
+    started_a, started_b, read_a, release, done_a, done_b = [ctx.Event() for _ in range(6)]
+    first = ctx.Process(target=_writer, args=(tmp_path, 'first', started_a, read_a, release, done_a))
+    second = ctx.Process(target=_writer, args=(tmp_path, 'second', started_b, None, release, done_b))
+    first.start()
+    try:
+        assert read_a.wait(15)
+        second.start()
+        assert started_b.wait(15)
+        # The old writer finishes from A's old snapshot; a serialized writer waits for A.
+        # No timing assertion: either outcome is valid provided both entries survive.
+        done_b.wait(2)
+    finally:
+        release.set()
+        first.join(20)
+        if second.pid is not None:
+            second.join(20)
+        for process in (first, second):
+            if process.pid is not None and process.is_alive():
+                process.terminate()
+                process.join(5)
+    assert first.exitcode == second.exitcode == 0
+    data = json.loads((tmp_path / 'cache.json').read_text())
+    assert set(data) == {'first', 'second'}
+    assert data['first']['tools'] == [{'name': 'first'}]
+    assert data['second']['tools'] == [{'name': 'second'}]
+
+
+def test_failed_publish_preserves_good_manifest_and_releases_writer(tmp_path, monkeypatch):
+    from tools import mcp_schema_cache as cache
+    monkeypatch.setattr(cache, '_cache_path', lambda: tmp_path / 'cache.json')
+    cache.write_cache_entry('original', 'fixture', tools=[{'name': 'original'}])
+    original = (tmp_path / 'cache.json').read_bytes()
+    native = cache._save_all
+    def refused(data):
+        raise OSError('synthetic publication failure')
+    monkeypatch.setattr(cache, '_save_all', refused)
+    with pytest.raises(OSError, match='synthetic publication failure'):
+        cache.write_cache_entry('failed', 'fixture', tools=[])
+    assert (tmp_path / 'cache.json').read_bytes() == original
+    monkeypatch.setattr(cache, '_save_all', native)
+    cache.write_cache_entry('next', 'fixture', tools=[{'name': 'next'}])
+    assert cache.get_cached_entry('original', 'fixture')['tools'] == [{'name': 'original'}]
+    assert cache.get_cached_entry('next', 'fixture')['tools'] == [{'name': 'next'}]
+    assert cache.get_cached_entry('failed', 'fixture') is None
+
+
+def test_busy_publisher_never_proceeds_unlocked(tmp_path, monkeypatch):
+    from tools import mcp_schema_cache as cache
+    from pm import filesystem
+    monkeypatch.setattr(cache, '_cache_path', lambda: tmp_path / 'cache.json')
+    cache.write_cache_entry('original', 'fixture', tools=[])
+    original = (tmp_path / 'cache.json').read_bytes()
+    monkeypatch.setattr(filesystem, 'lock_fd', lambda *args, **kwargs: False)
+    with pytest.raises(TimeoutError, match='publisher is busy'):
+        cache.write_cache_entry('blocked', 'fixture', tools=[])
+    assert (tmp_path / 'cache.json').read_bytes() == original
+
+
+@pytest.mark.platforms('posix')
+def test_waiting_writer_does_not_hold_other_profiles_read_lock(tmp_path, monkeypatch):
+    from concurrent.futures import ThreadPoolExecutor
+    from contextvars import ContextVar
+    import threading
+    from tools import mcp_schema_cache as cache
+    from pm import filesystem
+
+    home_a, home_b = tmp_path / 'a', tmp_path / 'b'
+    home_a.mkdir()
+    home_b.mkdir()
+    owner = ContextVar('cache_test_owner', default=home_b)
+    monkeypatch.setattr(cache, '_cache_path', lambda: owner.get() / 'cache.json')
+    cache.write_cache_entry('survivor', 'fixture', tools=[{'name': 'survivor'}])
+    waiting = threading.Event()
+    native_lock = filesystem.lock_fd
+    def observe_wait(fd, **kwargs):
+        waiting.set()
+        return native_lock(fd, **kwargs)
+    monkeypatch.setattr(filesystem, 'lock_fd', observe_wait)
+    lock = os.open(home_a / 'cache.json.lock', os.O_RDWR | os.O_CREAT, 0o600)
+    assert native_lock(lock, wait=False)
+    def write_a():
+        token = owner.set(home_a)
+        try:
+            cache.write_cache_entry('a', 'fixture', tools=[])
+        finally:
+            owner.reset(token)
+    pool = ThreadPoolExecutor(max_workers=2)
+    try:
+        write = pool.submit(write_a)
+        assert waiting.wait(10)
+        read = pool.submit(cache.get_cached_entry, 'survivor', 'fixture')
+        assert read.result(timeout=2)['tools'] == [{'name': 'survivor'}]
+    finally:
+        os.close(lock)
+        pool.shutdown(wait=True)
+    write.result()
