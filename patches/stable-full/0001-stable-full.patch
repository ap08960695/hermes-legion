@@ -0,0 +1,105 @@
+from pathlib import Path
+import pytest
+from hermes_cli.spaces import Spaces,SpaceDenied,SpaceConflict
+
+def test_shared_members_read_the_same_version_nonmembers_cannot_read(tmp_path):
+    store=Spaces(tmp_path);space=store.create('Example project',['writer','reviewer'])
+    page=store.add(space['id'],'Brief',b'# Shared brief','page','text/markdown')
+    assert store.read(space['id'],page['id'],'writer')['data']==store.read(space['id'],page['id'],'reviewer')['data']
+    assert store.list('other')==[]
+    with pytest.raises(SpaceDenied):store.read(space['id'],page['id'],'other')
+    updated=store.save_page(space['id'],page['id'],'Brief','Updated',page['revision'])
+    assert store.read(space['id'],page['id'],'reviewer')['revision']==updated['revision']
+    with pytest.raises(SpaceConflict):store.save_page(space['id'],page['id'],'Brief','stale',page['revision'])
+
+def test_removal_is_recoverable_and_never_changes_the_original_file(tmp_path):
+    original=tmp_path/'source.txt';original.write_bytes(b'original bytes')
+    store=Spaces(tmp_path);space=store.create('Files',['writer']);item=store.add(space['id'],'source.txt',original.read_bytes(),mime='text/plain')
+    removed=store.remove(space['id'],item['id'],item['revision'])
+    assert store.items(space['id'],'writer')==[]
+    with pytest.raises(KeyError):store.read(space['id'],item['id'],'writer')
+    assert original.read_bytes()==b'original bytes'
+    store.remove(space['id'],item['id'],removed['revision'],False)
+    assert store.read(space['id'],item['id'],'writer')['data']==original.read_bytes()
+
+def test_private_empty_default_and_membership_revocation(tmp_path):
+    store=Spaces(tmp_path);assert store.list()==[];assert not store.path.exists()
+    space=store.create('Private',[]);page=store.add(space['id'],'Notes',b'private','page','text/markdown')
