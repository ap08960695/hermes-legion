+def test_content_cache_obeys_byte_count_and_lru_bounds(image, monkeypatch, character, with_note):
+    import sys
+    import threading
+    from concurrent.futures import ThreadPoolExecutor
+
+    now = [1000.0]
+    monkeypatch.setattr(vt.time, "monotonic", lambda: now[0])
+    keys = [f"{i:064x}" for i in range(3)]
+    value = (character * 48, character * 12 if with_note else None)
+    entry = (now[0], value)
+    charge = sum(sys.getsizeof(part) for part in (keys[0], entry, *entry, *value))
+    monkeypatch.setattr(vt, "_ANALYSIS_CACHE_MAX_BYTES", 2 * charge, raising=False)
+    vt._analysis_cache_put(keys[0], value)
+    vt._analysis_cache_put(keys[1], value)
+    assert _retained_charge() == 2 * charge
+    assert vt._analysis_cache_get(keys[0]) is value
+    vt._analysis_cache_put(keys[2], value)
+    assert list(vt._ANALYSIS_CACHE) == [keys[0], keys[2]]
+    assert _retained_charge() <= 2 * charge
+    smaller = (character, None)
+    vt._analysis_cache_put(keys[0], smaller)
+    assert vt._analysis_cache_get(keys[0]) is smaller
+    assert list(vt._ANALYSIS_CACHE) == [keys[2], keys[0]]
+    vt._analysis_cache_put(keys[0], (character * 4096, value[1]))
+    assert list(vt._ANALYSIS_CACHE) == [keys[2]]
+    assert vt._analysis_cache_get(keys[2]) is value
+
+    vt._ANALYSIS_CACHE.clear()
+    monkeypatch.setattr(vt, "_ANALYSIS_CACHE_MAX_BYTES", charge - 1)
+    vt._analysis_cache_put(keys[0], value)
+    assert not vt._ANALYSIS_CACHE
+    monkeypatch.setattr(vt, "_ANALYSIS_CACHE_MAX_BYTES", charge)
+    vt._analysis_cache_put(keys[0], value)
+    assert _retained_charge() == charge
+    assert vt._analysis_cache_get(keys[0]) is value
+    now[0] += vt._ANALYSIS_CACHE_TTL
+    assert vt._analysis_cache_get(keys[0]) is None
+    assert not vt._ANALYSIS_CACHE
+
+    monkeypatch.setattr(vt, "_ANALYSIS_CACHE_MAX_BYTES", 10**8)
+    monkeypatch.setattr(vt, "_ANALYSIS_CACHE_MAX", 2)
+    for key in keys[:2]:
+        vt._analysis_cache_put(key, value)
+    assert vt._analysis_cache_get(keys[0]) is value
+    vt._analysis_cache_put(keys[2], value)
+    assert list(vt._ANALYSIS_CACHE) == [keys[0], keys[2]]
+    monkeypatch.setattr(vt, "_ANALYSIS_CACHE_MAX_BYTES", 2 * charge)
+    start = threading.Barrier(4)
+
+    def produce(worker):
+        start.wait(timeout=3)
+        for i in range(8):
+            vt._analysis_cache_put(f"{worker * 8 + i + 10:064x}", value)
+            with vt._ANALYSIS_CACHE_LOCK:
+                assert len(vt._ANALYSIS_CACHE) <= 2
+                assert _retained_charge() <= 2 * charge
+
+    with ThreadPoolExecutor(4) as pool:
+        list(pool.map(produce, range(4)))
+
