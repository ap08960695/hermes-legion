+const originalOwner = { connectionId: 'source-a', profile: 'default' }
+
+beforeEach(() => {
+  clearAllSessionStates()
+  $sessionTiles.set([])
+  $activeSessionId.set(null)
+  $selectedStoredSessionId.set('reader')
+  $sessions.set([])
+  setApiRequestConnection('source-a')
+  setApiRequestProfile('default')
+  setSessionOwnerResolver(() => undefined)
+  openWindow.mockClear()
+  vi.mocked(notifyError).mockClear()
+  desktop.hermesDesktop = { openSessionWindow: openWindow } as unknown as Window['hermesDesktop']
+})
+
+afterEach(() => {
+  clearAllSessionStates()
+  $sessionTiles.set([])
+  $sessions.set([])
+  $activeSessionId.set(null)
+  $selectedStoredSessionId.set(null)
+  setApiRequestConnection(null)
+  setApiRequestProfile(null)
+  setSessionOwnerResolver(null)
+
+  if (originalBridge) {
+    desktop.hermesDesktop = originalBridge
+  } else {
+    delete desktop.hermesDesktop
+  }
+})
+
+describe('references preserve already-open history ownership', () => {
+  it('opens the other owner separately without retargeting a live tile', async () => {
+    const tile = { storedSessionId: 'shared-history', runtimeId: 'live-original', ownerRoute: originalOwner }
+    $sessionTiles.set([tile])
+
+    openSessionRef('work/shared-history')
+
+    await vi.waitFor(() =>
+      expect(openWindow).toHaveBeenCalledWith('shared-history', {
+        connectionId: 'source-a',
+        profile: 'work',
+        watch: undefined
+      })
+    )
+    expect($sessionTiles.get()).toEqual([tile])
+    expect($selectedStoredSessionId.get()).toBe('reader')
+  })
+
+  it('keeps an existing main session while opening the other profile', async () => {
+    $selectedStoredSessionId.set('shared-history')
+    $activeSessionId.set('main-original')
+
+    openSessionRef('work/shared-history')
+
+    await vi.waitFor(() =>
+      expect(openWindow).toHaveBeenCalledWith('shared-history', {
+        connectionId: 'source-a',
+        profile: 'work',
+        watch: undefined
+      })
+    )
+    expect($activeSessionId.get()).toBe('main-original')
+    expect($selectedStoredSessionId.get()).toBe('shared-history')
+  })
+
+  it('preserves the explicitly requested owner for an ordinary pop-out', async () => {
+    openSession('new-history', () => undefined, 'window', {
+      workspaceMode: 'sessions',
+      ownerRoute: { connectionId: 'source-a', profile: 'work' }
+    })
+
+    await vi.waitFor(() =>
+      expect(openWindow).toHaveBeenCalledWith('new-history', {
+        connectionId: 'source-a',
+        profile: 'work',
+        watch: undefined
+      })
+    )
+  })
+
+  it('distinguishes same-profile histories on different connections', async () => {
+    const tile = {
+      storedSessionId: 'shared-history',
+      runtimeId: 'remote-original',
+      ownerRoute: { connectionId: 'source-b', profile: 'work' }
+    }
+
+    $sessionTiles.set([tile])
+
+    openSessionRef('work/shared-history')
+
+    await vi.waitFor(() =>
+      expect(openWindow).toHaveBeenCalledWith('shared-history', {
+        connectionId: 'source-a',
+        profile: 'work',
+        watch: undefined
+      })
