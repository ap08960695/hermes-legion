+import json
+import pytest
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.setenv('HERMES_KANBAN_DB', str(tmp_path / 'board.db'))
+    kb.init_db()
+    with kbc.connect() as conn:
+        yield kb, conn
+
+
+def test_native_claim_records_attempt_reason_without_changing_lifecycle(board):
+    kb, conn = board
+    tid = kb.create_task(conn, title='test', assignee='worker')
+    task = kb.claim_task(conn, tid)
+    assert task.status == 'running'
+    event = kb.list_events(conn, tid)[-1]
+    payload = json.loads(event.payload) if isinstance(event.payload, str) else event.payload
+    assert payload['attempt']['reason'] == 'initial'
+    assert payload['attempt']['previous_run_id'] is None
+
+@pytest.mark.parametrize('lane,outcome,kind,reason', [
+    ('review','review_requested',None,'review_handoff'),
+    ('ready','crashed',None,'recovery'),
+    ('ready','rate_limited',None,'quota_retry'),
+    ('ready','completed','reopened','reopened'),
+    ('ready','completed','changes_requested','revision'),
+    ('ready','completed',None,'unknown'),
+])
+def test_classification_preserves_unknown(lane,outcome,kind,reason):
+    from hermes_cli.kanban_attempt_evidence import classify_attempt
+    assert classify_attempt(lane, {'id': 4, 'outcome': outcome}, kind)['reason'] == reason
+
+
+def test_historical_classification_cannot_see_future_revision(board):
+    from hermes_cli.kanban_attempt_evidence import claim_evidence
+    kb, conn = board
+    tid = kb.create_task(conn, title='test', assignee='worker')
+    kb.claim_task(conn, tid)
+    first = kb.get_task(conn, tid).current_run_id
+    with kb.write_txn(conn):
+        conn.execute("UPDATE task_runs SET outcome='completed',ended_at=started_at WHERE id=?", (first,))
+        conn.execute("UPDATE tasks SET status='ready',claim_lock=NULL WHERE id=?", (tid,))
+    kb.claim_task(conn, tid)
+    second = kb.get_task(conn, tid).current_run_id
+    with kb.write_txn(conn):
+        kb._append_event(conn, tid, 'changes_requested', {})
+    assert claim_evidence(conn, tid, 'ready', second)['reason'] == 'unknown'
