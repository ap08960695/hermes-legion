+"""A known missing preload settles as failure rather than an unknown worker crash."""
+import json
+import os
+from contextlib import closing
+
+import pytest
+
+from gateway import session_kanban
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_db_connect import connect
+
+
+class Agent:
+    session_id = "missing-skill-fixture"
+
+    def __init__(self):
+        self.prompts = []
+
+    def run_conversation(self, prompt, conversation_history=None):
+        self.prompts.append(prompt)
+        return {"completed": True, "final_response": "fixture turn finished"}
+
+
+@pytest.fixture
+def claimed(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(tmp_path / "board.db"))
+    monkeypatch.delenv("HERMES_DELEGATED_CHILD_CONTEXT", raising=False)
+    kb.init_db()
+    path = kb.kanban_db_path()
+    with closing(connect(path)) as conn:
+        tid = kb.create_task(conn, title="Required skill fixture", assignee="default")
+        task = kb.claim_task(conn, tid)
+        with kb.write_txn(conn):
+            kb._append_event(conn, tid, "worker_bound", {"pid": os.getpid(), "claim_lock": task.claim_lock},
+                             run_id=task.current_run_id)
+    context = {"db": str(path), "task_id": tid, "run_id": task.current_run_id,
+               "claim_lock": task.claim_lock, "skills": ["absent-fixture-skill"], "context": "fixture", "goal_mode": False}
+    return path, context
+
+
+def test_missing_skill_returns_actionable_failed_result_without_model_turn(claimed):
+    path, context = claimed
+    agent = Agent()
+    result = session_kanban.run_worker_turns(agent, {"text": "fixture", "policy": {"kanban_json": json.dumps(context)}}, [])
+
+    assert result["failed"] is True and result["completed"] is False
+    assert result["failure_retryable"] is False
+    assert result["failure_reason"] == "kanban_skills_unavailable"
+    assert "absent-fixture-skill" in result["final_response"]
+    assert "profile" in result["final_response"] and "skill" in result["error"]
+    assert agent.prompts == []
+    receipt = session_kanban.worker_result(path, context)
+    assert receipt["exit_code"] == 1 and "absent-fixture-skill" in receipt["last_output"]
+
+
+@pytest.mark.parametrize("requested", [[], ["present-fixture-skill"], ["present-fixture-skill", "absent-fixture-skill"]])
+def test_available_preloads_preserve_normal_turn_and_partial_loading_policy(claimed, tmp_path, requested):
+    path, context = claimed
+    skill = tmp_path / "skills" / "present-fixture-skill" / "SKILL.md"
+    skill.parent.mkdir(parents=True)
+    skill.write_text("---\nname: present-fixture-skill\ndescription: Test-only preload\n---\nINLINE_SKILL_CHECKPOINT\n")
+    context["skills"] = requested
+    agent = Agent()
+    result = session_kanban.run_worker_turns(agent, {"text": "fixture", "policy": {"kanban_json": json.dumps(context)}}, [])
+
+    assert result["completed"] is True and len(agent.prompts) == 1
+    if requested:
+        assert "INLINE_SKILL_CHECKPOINT" in agent.prompts[0]
+    assert session_kanban.worker_result(path, context)["exit_code"] == 0
