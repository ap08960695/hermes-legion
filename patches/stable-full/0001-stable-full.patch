@@ -0,0 +1,106 @@
+"""Actual native request builders obey caps even after explicit request overrides."""
+from copy import deepcopy
+from types import SimpleNamespace
+
+import pytest
+
+from agent.transports.codex import ResponsesApiTransport
+
+LIMITS = {'gpt-6.1-terra': 'high'}
+
+
+def acting_agent(monkeypatch, model='gpt-6.1-terra'):
+    from agent import chat_completion_helpers as helpers
+    monkeypatch.setattr(helpers, '_prompt_cache_scope_for_agent', lambda _: 'fixture-cache')
+    monkeypatch.setattr('agent.native_compaction.native_compaction_context_management', lambda *a, **k: None)
+    agent = SimpleNamespace(
+        model=model, provider='openai-codex', api_mode='codex_responses',
+        base_url='https://chatgpt.com/backend-api/codex', session_id='fixture',
+        tools=[], max_tokens=2048, reasoning_config={'enabled': True, 'effort': 'max'},
+        request_overrides={'reasoning': {'effort': 'max'}}, service_tier=None, _fast_until=0,
+        _ephemeral_reasoning_off=False, _ephemeral_max_output_tokens=None,
+        _reasoning_effort_rejected=False, _reasoning_disable_rejected=False,
+        _reasoning_effort_limits=deepcopy(LIMITS), _codex_reasoning_replay_enabled=False,
+        _is_codex_backend=lambda: True, _is_copilot_url=lambda: False,
+        _prepare_messages_for_non_vision_model=lambda rows: rows,
+        _resolved_api_call_timeout=lambda: 30,
+        _get_transport=lambda: ResponsesApiTransport(),
+    )
+    return agent
+
+
+def test_native_codex_builder_bounds_a_late_override_without_mutating_history(monkeypatch):
+    from agent.chat_completion_helpers import build_api_kwargs
+    agent = acting_agent(monkeypatch)
+    messages = [{'role': 'system', 'content': 'Stable fixture prefix'}, {'role': 'user', 'content': 'Fixture task'}]
+    original = deepcopy(messages)
+    request = build_api_kwargs(agent, messages)
+    assert request['reasoning']['effort'] == 'high'
+    assert agent.reasoning_config['effort'] == 'max'
+    assert agent.request_overrides['reasoning']['effort'] == 'max'
+    assert messages == original
+    assert agent._wire_reasoning_config['effort'] == 'high'
+
+
+def test_native_builder_keeps_a_different_model_at_max(monkeypatch):
+    from agent.chat_completion_helpers import build_api_kwargs
+    request = build_api_kwargs(acting_agent(monkeypatch, 'gpt-6.1-sol'), [{'role': 'user', 'content': 'Fixture'}])
+    assert request['reasoning']['effort'] == 'max'
+
+
+def test_model_override_is_checked_against_the_actual_wire_model(monkeypatch):
+    from agent.chat_completion_helpers import build_api_kwargs
+    agent = acting_agent(monkeypatch, 'gpt-6.1-sol')
+    agent.request_overrides = {'model': 'gpt-6.1-terra', 'reasoning': {'effort': 'max'}}
+    request = build_api_kwargs(agent, [])
+    assert request['model'] == 'gpt-6.1-terra'
+    assert request['reasoning']['effort'] == 'high'
+
+
+def test_last_native_execution_boundary_bounds_a_request_after_middleware(monkeypatch):
+    from tests.agent.test_cache_request_diagnostics import invoke
+    from agent.reasoning_limits import owner_reasoning_limits
+    calls = []
+    request = {'model': 'gpt-6.1-terra', 'input': [], 'reasoning': {'effort': 'max'}}
+    response = SimpleNamespace(usage=None)
+    with owner_reasoning_limits(LIMITS):
+        verdict = invoke(monkeypatch, request, lambda payload: calls.append(payload) or response)
+    assert verdict.response is response
+    assert len(calls) == 1
+    assert calls[0]['reasoning']['effort'] == 'high'
+    assert request['reasoning']['effort'] == 'max'
+
+
+def test_auxiliary_builder_limits_both_nested_and_top_level_carriers(monkeypatch):
+    from agent.auxiliary_client import _build_call_kwargs
+    monkeypatch.setattr('hermes_cli.config.load_config_readonly', lambda: {'agent': {'reasoning_effort_limits': LIMITS}})
+    request = _build_call_kwargs('openai', 'gpt-6.1-terra', [{'role': 'user', 'content': 'Fixture'}],
+                                reasoning_config={'enabled': True, 'effort': 'max'},
+                                extra_body={'reasoning': {'effort': 'max'}, 'reasoning_effort': 'max'})
+    assert request['extra_body']['reasoning']['effort'] == 'high'
+    assert request['extra_body']['reasoning_effort'] == 'high'
+
+
+def test_wire_limit_also_bounds_a_disabled_but_contradictory_effort_field():
+    from agent.reasoning_limits import limit_wire_request
+    original = {'reasoning': {'enabled': False, 'effort': 'max'}}
+    assert limit_wire_request(original, LIMITS, 'gpt-6.1-terra')['reasoning']['effort'] == 'high'
+    assert original['reasoning']['effort'] == 'max'
+
+
+def test_owner_scope_replaces_captured_limits_without_leaking_to_the_next_owner(monkeypatch):
+    from agent.chat_completion_helpers import build_api_kwargs
+    from agent.reasoning_limits import owner_reasoning_limits
+    agent = acting_agent(monkeypatch)
+    with owner_reasoning_limits({'gpt-6.1-terra': 'low'}):
+        assert build_api_kwargs(agent, [])['reasoning']['effort'] == 'low'
+        with owner_reasoning_limits({}):
+            assert build_api_kwargs(agent, [])['reasoning']['effort'] == 'max'
+        assert build_api_kwargs(agent, [])['reasoning']['effort'] == 'low'
+    assert build_api_kwargs(agent, [])['reasoning']['effort'] == 'high'
+
+
+@pytest.mark.parametrize('model', ['gpt-6.1-terra-2026-10-26', 'openai/gpt-6.1-terra-2026-10-26'])
+def test_dated_snapshot_uses_the_alias_ceiling(monkeypatch, model):
+    from agent.chat_completion_helpers import build_api_kwargs
+    assert build_api_kwargs(acting_agent(monkeypatch, model), [])['reasoning']['effort'] == 'high'
