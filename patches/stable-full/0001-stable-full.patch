+import { execFileSync } from 'node:child_process'
+import { mkdirSync, rmSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+
+export const petOverlayX11Path = arch => `native/linux-${arch}/pet-overlay-x11`
+
+export function buildPetOverlayX11({ source, distDir, platform, arch }) {
+  if (platform !== 'linux' || process.platform !== 'linux' || arch !== process.arch) return
+
+  const output = join(distDir, petOverlayX11Path(arch))
+
+  try {
+    mkdirSync(dirname(output), { recursive: true })
+    execFileSync(process.env.CC || 'cc', [
+      '-std=c11', '-O2', '-Wall', '-Wextra',
+      join(source, 'apps/desktop/electron/native/pet-overlay-x11.c'), '-o', output, '-lX11', '-lXext'
+    ], { stdio: 'pipe', timeout: 120_000 })
+  } catch {
+    rmSync(output, { force: true })
+    console.warn('[pet-overlay] X11 character windows need a C compiler, libx11-dev and libxext-dev')
+  }
+}
