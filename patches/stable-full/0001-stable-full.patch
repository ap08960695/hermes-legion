+    if (busy) return
+    if (title !== (item?.title || '') || text !== (item?.text || '')) setDiscarding(true)
+    else onClose()
+  }
+  const save = async () => {
+    setBusy(true)
+    setError('')
+    try {
+      await request(owner, `/${spaceId}/` + (item ? 'items/' + item.id : 'pages'), item ? 'PATCH' : 'POST', {
+        title,
+        text,
+        ...(item ? { revision: item.revision } : {})
+      })
+      onSaved()
+      onClose()
+    } catch (e) {
+      // Electron invoke preserves the HTTP status prefix in the error message.
+      const conflict =
+        item && e instanceof Error && /^(?:Error invoking remote method 'hermes:api': Error: )?409:/.test(e.message)
+      setError(conflict ? t.pageConflict : String(e))
+    } finally {
+      setBusy(false)
+    }
+  }
+  return (
+    <Dialog
+      open
+      onOpenChange={open => {
+        if (!open) requestClose()
+      }}
