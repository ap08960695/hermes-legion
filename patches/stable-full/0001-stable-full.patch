+    kick = goals.goal_kick_prompt(state.goal, last_user_message)
+    if not state.has_contract():
+        return kick
+    return f"{kick}\n\nCompletion contract:\n{state.contract.render_block()}\n\n{_KICK_EVIDENCE}"
 
