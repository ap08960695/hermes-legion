+        assert store._live_compression_child("parent") == "tip"
+        assert not owner._token_queue and not owner._token_writer_busy
+        row = owner._read_one("SELECT input_tokens, output_tokens FROM sessions WHERE id = ?", ("tip",))
+        assert tuple(row) == (17, 5)
+        for tip in ("parent", "missing", None):
+            monkeypatch.setattr(owner, "get_compression_tip", lambda sid, tip=tip: tip)
+            assert store._live_compression_child("parent") == ""
+        monkeypatch.setattr(owner, "get_compression_tip", lambda sid: "tip")
+        for method in ("flush_token_counts", "_read_one"):
+            with monkeypatch.context() as failure:
+                def fail(*args, **kwargs):
+                    raise sqlite3.OperationalError("synthetic metadata failure")
+                failure.setattr(owner, method, fail)
+                with pytest.raises(sqlite3.OperationalError, match="synthetic metadata failure"):
+                    store._live_compression_child("parent")
+        assert not store._dirty_transcripts
+    finally:
+        store.close_all_db_handles()
+    store._db = None
+    assert store._live_compression_child("parent") == ""
