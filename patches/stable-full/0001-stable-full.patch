+import { useRef, useState } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { useI18n } from '@/i18n'
+import { useSessionSlice } from '@/lib/use-session-slice'
+import type { ComposerAttachment } from '@/store/composer'
+import type { ComposerDraftRetry } from '@/store/composer-draft-retry'
+import {
+  $retainedSendScopes,
+  discardRejectedDraft,
+  readRetainedSend,
+  restoreRejectedDraft,
+  retainedMissingFiles,
+  retainedSendGroup
+} from '@/store/composer-rejected-drafts'
+import { notifyError } from '@/store/notifications'
+import type { SessionOwnerScope } from '@/store/session-request-router'
+
+interface Props {
+  scope: string | null
+  owner: SessionOwnerScope
+  occupied: boolean
+  browsingHistory?: boolean
+  disabled?: boolean
+  readCurrent: () => { text: string; attachments: ComposerAttachment[] } | undefined
+  onFocusComposer: () => void
+  onRestored: (text: string, attachments: ComposerAttachment[], retry?: ComposerDraftRetry) => void
+}
+
+export function RecoveryFiles({ count, labels }: { count: number; labels: string[] }) {
+  const { t } = useI18n()
+  if (count <= 0) return null
+
+  return (
+    <div className="text-xs text-muted-foreground">
+      <p>{t.composer.retainedSendFiles(count)}</p>
+      {labels.length > 0 && (
+        <ul className="list-inside list-disc break-all">
+          {labels.map((label, index) => (
+            <li key={index}>{label}</li>
+          ))}
+        </ul>
+      )}
+      <p>{t.composer.retainedSendMissingAttachments}</p>
+    </div>
+  )
+}
+
+/** The user switches editors here. The normal Send action owns dispatch. */
+export function RetainedSendNotice({
+  scope,
+  owner,
+  occupied,
+  browsingHistory,
+  disabled,
+  readCurrent,
+  onFocusComposer,
+  onRestored
+}: Props) {
+  const { t } = useI18n()
+  const copy = t.composer
+  const summary = useRef<HTMLElement>(null)
+  const [failedRow, setFailedRow] = useState<{ group: string; scope: string }>()
+  const group = retainedSendGroup(scope, owner)
+  const hasFailure = failedRow?.group === group
+  const rows = useSessionSlice($retainedSendScopes, group)
+  const entries = rows.flatMap(row => readRetainedSend(row.scope, owner) ?? [])
+  const hasFailed = entries.some(entry => !entry.meta?.parked)
+
+  if (!entries.length) return null
+
+  return (
+    <details className="text-xs text-muted-foreground" data-slot="composer-retained-send">
+      <summary className="cursor-pointer rounded-sm" ref={summary}>
+        {hasFailed ? copy.retainedSendNotice : copy.parkedDraftNotice} ({entries.length})
+      </summary>
+      {browsingHistory && <p className="mt-2" role="status">{copy.retainedSendBrowsingHistory}</p>}
+      <div className="mt-2 max-h-56 space-y-2 overflow-y-auto overscroll-contain">
+        {entries.map(entry => {
+          const failed = hasFailure && failedRow.scope === entry.scope
+          const action = entry.meta?.parked
+            ? copy.parkedDraftReturn
+            : occupied
+              ? copy.retainedSendEdit
+              : copy.retainedSendRestore
+          return (
+            <div className="space-y-2 rounded-md border border-border px-3 py-2" key={entry.scope}>
+              {entry.text && <p className="whitespace-pre-wrap wrap-anywhere text-foreground">{entry.text}</p>}
+              {entry.attachments.length > 0 && (
+                <p className="break-all">{entry.attachments.map(file => file.label).join(', ')}</p>
+              )}
+              <RecoveryFiles {...retainedMissingFiles(entry)} />
+              <div className="flex flex-wrap items-center gap-2">
+                <Button
+                  className="h-auto min-h-7 whitespace-normal text-left"
+                  disabled={disabled || browsingHistory}
+                  onClick={() => {
+                    const current = readCurrent()
+                    if (!current) return
+
+                    const restored = restoreRejectedDraft(entry.scope, scope, owner, current)
+                    if (!restored) return
+                    if (!restored.saved) {
+                      setFailedRow({ group, scope: entry.scope })
+                      return
+                    }
+
+                    if (hasFailure) setFailedRow(undefined)
+                    onRestored(restored.text, restored.attachments, restored.retry)
+                  }}
+                  size="sm"
+                  type="button"
+                  variant="outline"
+                >
+                  {action}
+                </Button>
+                <Button
+                  aria-label={copy.retainedSendDiscard}
+                  disabled={disabled}
+                  onClick={event => {
+                    const button = event.currentTarget
+                    const hadFocus = button.ownerDocument.activeElement === button
+                    if (!discardRejectedDraft(entry.scope, owner)) {
+                      notifyError(new Error('Could not discard the saved draft.'), copy.retainedSendDiscard)
+                      return
+                    }
+
+                    if (failed) setFailedRow(undefined)
+                    if (!hadFocus) return
+                    if ($retainedSendScopes.get()[group]?.length) {
+                      summary.current?.focus()
+                    } else {
+                      onFocusComposer()
+                    }
+                  }}
+                  size="sm"
+                  type="button"
+                  variant="ghost"
+                >
+                  ×
+                </Button>
+              </div>
+              {failed && <p className="text-destructive" role="alert">{copy.retainedSendSwitchFailed}</p>}
+            </div>
+          )
+        })}
+      </div>
+    </details>
+  )
+}
