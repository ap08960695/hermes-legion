new file mode 100644
index 0000000000000000000000000000000000000000..fc6c5b5fbdf181e4a9199b26a98491f62704e8cc
--- /dev/null
+++ b/apps/desktop/src/store/ssh-backend-status.ts
@@ -0,0 +1,77 @@
+import { atom } from 'nanostores'
+
+import type { SshBackendStatuses } from '../../electron/ssh-backend-status'
+
+export const $sshBackendStatuses = atom<SshBackendStatuses>({})
+
+export function observeSshBackendStatuses(
+  desktop: Pick<Window['hermesDesktop'], 'getSshBackendStatuses' | 'onSshBackendStatuses'>
+) {
+  let current = true
+  let receivedPush = false
+  const off = desktop?.onSshBackendStatuses?.(snapshot => {
+    receivedPush = true
+    $sshBackendStatuses.set(snapshot)
+  })
+
+  void desktop
+    ?.getSshBackendStatuses?.()
+    .then(snapshot => {
+      if (current && !receivedPush) {
+        $sshBackendStatuses.set(snapshot)
+      }
+    })
+    .catch(() => undefined)
+
+  return () => {
+    current = false
+    off?.()
+    $sshBackendStatuses.set({})
+  }
+}
+
+export const $startupConnectionId = atom<string | null>(null)
+
+interface SshRetry {
+  connectionId: string
+  at: number
+}
+
+export const $sshRetries = atom<ReadonlyMap<string, SshRetry>>(new Map())
+
+export function setSshRetry(scope: string, retry: SshRetry | null) {
+  const retries = $sshRetries.get()
+
+  if (!retry && !retries.has(scope)) {
+    return
+  }
+
+  const next = new Map(retries)
+
+  if (retry) {
+    next.set(scope, retry)
+  } else {
+    next.delete(scope)
+  }
+
+  $sshRetries.set(next)
+}
+
+export function nextSshRetry(retries: ReadonlyMap<string, SshRetry>, connectionId: string): number | undefined {
+  let next: number | undefined
+
+  for (const retry of retries.values()) {
+    if (retry.connectionId === connectionId && (next === undefined || retry.at < next)) {
+      next = retry.at
+    }
+  }
+
+  return next
+}
+
+export function sshRetryDelay(connectionId: string | null | undefined, delay: number): number {
+  const statuses = $sshBackendStatuses.get()
+  const status = connectionId && Object.hasOwn(statuses, connectionId) ? statuses[connectionId] : undefined
+
+  return status?.phase === 'disconnected' ? Math.max(delay, (status.retryNotBefore ?? 0) - Date.now()) : delay
+}
