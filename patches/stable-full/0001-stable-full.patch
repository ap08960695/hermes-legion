+"""On-demand process counters; no heap contents, user data or cache mutation."""
+
+import ctypes
+from functools import lru_cache
+import os
+from pathlib import Path
+import sys
+import time
+import weakref
+
+
+def start_requested_profiler(config):
+    """Explicit startup-only diagnostic for isolated launchers; disabled by default."""
+    section = config.get('runtime') if isinstance(config, dict) else None
+    frames = section.get('memory_profile_frames', 0) if isinstance(section, dict) else 0
+    if type(frames) is not int or not 1 <= frames <= 8:
+        return False
+    import tracemalloc
+
+    if tracemalloc.is_tracing():
+        return False
+    tracemalloc.start(frames)
+    return True
+
+
+@lru_cache(maxsize=1)
+def _sqlite_functions():
+    """Use the Python connection module's loaded SQLite library, never a guessed system copy."""
+    import _sqlite3
+
+    path = getattr(_sqlite3, '__file__', None)
+    if not path:
+        return None
+    try:
+        library = ctypes.CDLL(path)
+        used, highwater = library.sqlite3_memory_used, library.sqlite3_memory_highwater
+        used.argtypes, used.restype = [], ctypes.c_longlong
+        highwater.argtypes, highwater.restype = [ctypes.c_int], ctypes.c_longlong
+        return used, highwater
+    except (OSError, AttributeError):
+        return None
+
+
+def _sqlite_snapshot():
+    result = {'available': False, 'current_bytes': None, 'highwater_bytes': None,
+              'reset_highwater': False}
+    functions = _sqlite_functions()
+    if functions is not None:
+        current, highwater = int(functions[0]()), int(functions[1](0))
+        # Zero can mean disabled tracking, so it cannot certify an empty allocator.
+        if current > 0 and highwater >= current:
+            result.update(available=True, current_bytes=current, highwater_bytes=highwater)
+    return result
+
+
+def _current_runner():
+    reference = getattr(sys.modules.get('gateway.run'), '_gateway_runner_ref', None)
+    return reference() if isinstance(reference, weakref.ReferenceType) else None
+
+
+def _loaded_dict_count(module_name, attribute):
+    module = sys.modules.get(module_name)
+    value = vars(module).get(attribute) if module is not None else None
+    return len(value) if isinstance(value, dict) else None
+
+
+def _bundled_locale_counters():
+    module = sys.modules.get('agent.i18n_bundled')
+    cache = vars(module).get('_parse_verified') if module is not None else None
+    if cache is None:
+        return None
+    info = cache.cache_info()
+    return {'hits': info.hits, 'misses': info.misses,
+            'entries': info.currsize, 'max_entries': info.maxsize}
+
+
+def _plugin_code_counters():
+    module = sys.modules.get('hermes_cli.plugin_code_cache')
+    return module.cache_counts() if module is not None else None
+
+
+def _tool_counters():
+    result = {'global_entries': None, 'scopes': None, 'scoped_entries': None,
+              'definition_cache_entries': _loaded_dict_count('model_tools', '_tool_defs_cache'),
+              'mcp_server_entries': _loaded_dict_count('tools.mcp_tool', '_servers'),
+              'mcp_lazy_entries': _loaded_dict_count('tools.mcp_tool', '_lazy_server_configs')}
+    module = sys.modules.get('tools.registry')
+    registry = vars(module).get('registry') if module is not None else None
+    attributes = vars(registry) if registry is not None else {}
+    lock = attributes.get('_lock')
+    if lock is None or not lock.acquire(blocking=False):
+        return result
+    try:
+        global_tools, scopes = attributes.get('_tools'), attributes.get('_scoped_tools')
+        if isinstance(global_tools, dict):
+            result['global_entries'] = len(global_tools)
+        if isinstance(scopes, dict):
+            result['scopes'] = len(scopes)
+            result['scoped_entries'] = sum(len(value) for value in scopes.values() if isinstance(value, dict))
+    finally:
+        lock.release()
+    return result
+
+
+def _core_site(frames, roots):
+    packages = {'agent', 'gateway', 'hermes_cli', 'tools', 'tui_gateway', 'pm', 'hermes_platform'}
+    for frame in reversed(frames):
+        for root in roots:
+            if frame.filename.startswith(root):
+                relative = frame.filename[len(root):].replace(os.sep, '/')
+                if '..' not in relative.split('/') and (
+                    relative.split('/')[0] in packages or relative.startswith('hermes_state')
+                    or relative in {'run_agent.py', 'model_tools.py', 'utils.py'}
+                ):
+                    return relative + ':' + str(frame.lineno)
+    return '<python-or-extension>'
+
+
+def _allocation_snapshot():
+    import tracemalloc
+
+    if not tracemalloc.is_tracing():
+        return {'available': False, 'current_bytes': None, 'peak_bytes': None, 'sites': []}
+    current, peak = tracemalloc.get_traced_memory()
+    roots = {str(Path(__file__).absolute().parents[1]) + os.sep,
+             str(Path(__file__).resolve().parents[1]) + os.sep}
+    totals = {}
+    for row in tracemalloc.take_snapshot().statistics('traceback'):
+        site = _core_site(row.traceback, roots)
+        size, count = totals.get(site, (0, 0))
+        totals[site] = size + row.size, count + row.count
+    sites = [{'site': site, 'bytes': size, 'count': count}
+             for site, (size, count) in sorted(totals.items(), key=lambda row: row[1][0], reverse=True)[:30]]
+    return {'available': True, 'current_bytes': current, 'peak_bytes': peak, 'sites': sites}
+
+
+def collect_runtime_memory(*, include_allocations=False):
+    """Best-effort scalar observations for diagnosis, not an admission/eviction decision."""
+    from hermes_cli.mem_trim import collect_memory_snapshot
+
+    runner = _current_runner()
+    attributes = vars(runner) if runner is not None else {}
+    caches = {}
+    for label, name in [('agents', '_agent_cache'), ('session_states', '_sessions'),
+                        ('profile_configs', '_profile_configs')]:
+        value = attributes.get(name)
+        caches[label] = len(value) if isinstance(value, dict) else None
+    registry = sys.modules.get('hermes_state_registry')
+    result = {'pid': os.getpid(), 'sampled_at': time.time(), 'process': collect_memory_snapshot(),
+              'sqlite': _sqlite_snapshot(), 'caches': caches, 'tools': _tool_counters(),
+              'bundled_locales': _bundled_locale_counters(),
+              'plugin_code': _plugin_code_counters(),
+              'session_db_registry': registry.stats() if registry is not None else None}
+    if include_allocations:
+        result['allocations'] = _allocation_snapshot()
+    return result
