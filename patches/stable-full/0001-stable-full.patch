+    monkeypatch.setattr(vision, '_handle_vision_analyze_uncached', uncached)
+    # Use the same registered handler, not a separate test implementation.
+    handler = next(entry.handler for entry in registry.get_all_entries() if entry.name == 'vision_analyze')
+    args = {'image_url': str(image), 'question': 'q'}
