+@pytest.mark.parametrize("digest_error", [False, True])
+def test_content_key_closes_file_on_success_and_digest_error(image, monkeypatch, digest_error):
+    from pathlib import Path
+
+    native_open, native_digest = Path.open, vt.hashlib.file_digest
+    handles = []
+
+    def track_open(path, *args, **kwargs):
+        stream = native_open(path, *args, **kwargs)
+        if path == image:
+            handles.append(stream)
+        return stream
+
+    def digest(stream, *args, **kwargs):
+        if digest_error and stream in handles:
+            raise OSError("synthetic digest read error")
+        return native_digest(stream, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "open", track_open)
+    monkeypatch.setattr(vt.hashlib, "file_digest", digest)
+    key = vt._analysis_cache_key(image, "q", "m", {})
+    assert (key is None) == digest_error
+    assert len(handles) == 1 and handles[0].closed
+
+
+@pytest.mark.parametrize("missing", [False, True])
+def test_content_key_bypasses_cache_on_file_open_error(image, monkeypatch, missing):
+    from pathlib import Path
+
+    if missing:
+        image.unlink()
+    else:
+        native_open = Path.open
+
+        def fail_open(path, *args, **kwargs):
+            if path == image:
+                raise OSError("synthetic open error")
+            return native_open(path, *args, **kwargs)
+
+        monkeypatch.setattr(Path, "open", fail_open)
+    assert vt._analysis_cache_key(image, "q", "m", {}) is None
+
