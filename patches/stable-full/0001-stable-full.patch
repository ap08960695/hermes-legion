+def test_compact_view_clips_old_history_but_keeps_body_and_latest_run():
+    from tools.kanban_tools import _compact_show_payload
+    long = "x" * 5000
+    payload = {
+        "task": {"id": "t", "body": long},
+        "comments": [{"author": "a", "body": f"c{i}"} for i in range(20)] + [{"author": "a", "body": long}],
+        "events": [{"kind": "completed", "payload": {"summary": long}}],
+        "runs": [{"id": 1, "outcome": "crashed", "error": long}, {"id": 2, "outcome": "completed", "summary": long}],
