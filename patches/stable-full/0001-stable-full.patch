+import json
+from tools import kanban_show_cache as cache
+
+
+def test_small_output_never_grows(monkeypatch):
+    monkeypatch.setenv("HERMES_SESSION_ID", "tiny-budget-test")
+    assert cache.show_once("t_small", {}, "ok") == "ok"
+    assert cache.show_once("t_small", {}, "ok") == "ok"
+
+
+def test_budget_keeps_every_changed_field_and_recovery(monkeypatch):
+    monkeypatch.setenv("HERMES_SESSION_ID", "delta-budget-test")
+    payload = {"task": {"id": "t_delta", "body": "brief" * 9000}, "comments": [], "observed_at": 1}
+    first = json.dumps(payload)
+    assert cache.show_once("t_delta", {}, first) == first
+    payload["comments"] = [{"id": 1, "body": "Approval refused; preserve gate"}]
+    result = json.loads(cache.show_once("t_delta", {}, json.dumps(payload)))
+    assert result["changed_fields"]["comments"] == payload["comments"]
+    assert "task" in result["unchanged_fields"]
+    assert len(json.dumps(result)) < len(first)
+    cache.reset_session("delta-budget-test")
+    assert json.loads(cache.show_once("t_delta", {}, json.dumps(payload)))["task"] == payload["task"]
+
+
+def test_observation_metadata_does_not_defeat_dedup(monkeypatch):
+    monkeypatch.setenv("HERMES_SESSION_ID", "observed-budget-test")
+    value = {"task": {"id": "t_observed", "status": "running", "body": "a" * 2000}, "observed_at": 1}
+    cache.show_once("t_observed", {}, json.dumps(value))
+    value["observed_at"] = 2
+    assert json.loads(cache.show_once("t_observed", {}, json.dumps(value)))["unchanged_since_last_show"]
+    value["task"]["status"] = "blocked"
+    assert json.loads(cache.show_once("t_observed", {}, json.dumps(value)))["task"]["status"] == "blocked"
