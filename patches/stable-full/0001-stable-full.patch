+"""The Codex callback must export its curated tools even when Hermes defers schemas."""
+import asyncio
+from types import SimpleNamespace
+
+
+def test_managed_callback_keeps_worker_handoff_tools_when_tool_search_is_on(monkeypatch):
+    monkeypatch.setenv('HERMES_KANBAN_TASK', 't_public_test')
+    monkeypatch.delenv('HERMES_DELEGATED_CHILD_CONTEXT', raising=False)
+    from tools import tool_search
+    from agent.transports.hermes_tools_mcp_server import _build_server
+    # The normal model-facing catalog is collapsed. The MCP endpoint must
+    # request underlying schemas, then apply EXPOSED_TOOLS itself.
+    monkeypatch.setattr(tool_search, 'load_config', lambda: SimpleNamespace(enabled='on'))
+    monkeypatch.setattr(tool_search, 'assemble_tool_defs', lambda *a, **kw: SimpleNamespace(
+        activated=False, tool_defs=[]))
+    server = _build_server()
+    tools = asyncio.run(server.list_tools())
+    names = {tool.name for tool in tools}
+    assert {'kanban_complete', 'kanban_block', 'kanban_show'} <= names
+    assert not {'terminal', 'write_file', 'delegate_task'} & names
