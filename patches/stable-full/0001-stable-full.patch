+"""Installed characters through the authority-backed Desktop WebSocket dispatch."""
+import base64
+import json
+from types import SimpleNamespace
+
+from PIL import Image
+import pytest
+
+from tests.waiting import async_wait_until
+
+
+@pytest.fixture
+def character_route(tmp_path, monkeypatch):
+    from gateway.runtime_bootstrap import TicketStore
+    from gateway.session_authorities import SessionAuthorities
+    from gateway.session_controls import AuthorityConnection
+    from hermes_state import SessionDB
+    from tui_gateway import server
+    from tui_gateway.ws import _dispatch_request
+
+    root = tmp_path / ".hermes"
+    homes = {"default": root, "work": root / "profiles" / "work"}
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    monkeypatch.setattr(server, "_hermes_home", root)
+    monkeypatch.setattr(server, "_served_profile_homes", set())
+    runner = SimpleNamespace(_draining=False, session_authorities=SessionAuthorities(root))
+    authorities, sheets = {}, {}
+    for (name, home), color in zip(homes.items(), ("red", "blue"), strict=True):
+        pack = home / "pets" / "shared"
+        pack.mkdir(parents=True)
+        (home / "config.yaml").write_text("display: {pet: {enabled: false}}\n")
+        (home / "profile.yaml").write_text("ui_meta: {hermes-bots: {title: Existing}, other: keep}\n")
+        sheet = pack / "spritesheet.png"
+        Image.new("RGB", (1152, 1664), color).save(sheet)
+        sheets[name] = sheet.read_bytes()
+        (pack / "pet.json").write_text(json.dumps({"displayName": name.capitalize()}))
+        authority = SimpleNamespace(profile_id=str(home), instance_id="fixture",
+                                    db=SessionDB(home / "state.db"), runner=runner,
+                                    events={}, sessions={})
+        authorities[name] = authority
+        runner.session_authorities.add(home, authority, name=name)
+
+    tickets = TicketStore("fixture", frozenset(str(home) for home in homes.values()))
+
+    def connect(route="default", *, scope="profile", purpose="interactive"):
+        authority = authorities[route]
+        ticket = tickets.mint(profile_id=authority.profile_id, subject="uid:fixture", purpose=purpose, scope=scope)
+        grant = tickets.redeem(ticket, profile_id=None, purpose=purpose)
+        identity = {"provider": "local", "user_id": grant["subject"], "profile_id": grant["profile_id"],
+                    "instance_id": grant["instance_id"], "capabilities": grant["capabilities"],
+                    "profile_scope": grant["scope"], "native_bootstrap": True}
+        frames = []
+        transport = SimpleNamespace(desktop_local=True, write=lambda frame: frames.append(frame) or True)
+        connection = AuthorityConnection(authority, transport, identity, operator=purpose == "interactive")
+
+        async def call(method, **params):
+            frame = {"jsonrpc": "2.0", "id": 1, "method": method, "params": params}
+            result = await _dispatch_request(connection, frame, method, transport)
+            if result is None:
+                await async_wait_until(lambda: bool(frames), timeout=5)
+                result = frames.pop()
+            return result
+
+        return call
+
+    yield homes, sheets, connect
+    for authority in authorities.values():
+        authority.db.close()
+
+
+@pytest.mark.asyncio
+async def test_installed_characters_use_selected_profile_without_touching_petdex(character_route, monkeypatch):
+    from agent.pet import manifest
+
+    contacts = []
+
+    def unexpected_contact(*args, **kwargs):
+        contacts.append("manifest")
+        raise RuntimeError("petdex not available")
+
+    monkeypatch.setattr(manifest, "fetch_manifest", unexpected_contact)
+    monkeypatch.setattr(manifest, "prefetch", unexpected_contact, raising=False)
+    homes, sheets, connect = character_route
+    configs = {home: (home / "config.yaml").read_bytes() for home in homes.values()}
+    for profile, call in (("default", connect()), ("work", connect(scope="host")), ("work", connect("work"))):
+        gallery = await call("pet.gallery", profile=profile, localOnly=True)
+        sprite = await call("pet.sprite", profile=profile, slug="shared")
+        assert [(row["slug"], row["displayName"]) for row in gallery["result"]["pets"]] == [("shared", profile.capitalize())]
+        assert base64.b64decode(sprite["result"]["spritesheetBase64"]) == sheets[profile]
+        assert gallery["result"]["enabled"] is False
+    assert not contacts
+    assert all((home / "config.yaml").read_bytes() == before for home, before in configs.items())
+
+
+@pytest.mark.asyncio
+async def test_character_reads_keep_the_authority_scope(character_route):
+    _, _, connect = character_route
+    for method, params in (("pet.gallery", {"localOnly": True}), ("pet.sprite", {"slug": "shared"})):
+        cross = await connect()(method, profile="work", **params)
+        unserved = await connect(scope="host")(method, profile="missing", **params)
+        for reply in (cross, unserved):
+            assert reply["error"]["data"]["reason"] == "profile_mismatch"
+        limited = await connect(purpose="worker-adoption")(method, profile="default", **params)
+        assert limited["error"]["code"] == -32601
+
+
+@pytest.mark.asyncio
+async def test_explicit_full_gallery_still_merges_petdex(character_route, monkeypatch):
+    from agent.pet import manifest
+
+    remote = manifest.ManifestEntry("public", "Public", "", "", "https://example.invalid/public.png", "", "")
+    monkeypatch.setattr(manifest, "fetch_manifest", lambda: [remote])
+    _, _, connect = character_route
+    result = await connect()("pet.gallery")
+    assert [(row["slug"], row["installed"]) for row in result["result"]["pets"]] == [
+        ("public", False), ("shared", True)
+    ]
+
+
+@pytest.mark.asyncio
+async def test_desktop_character_save_clear_and_stale_cas_use_existing_dispatch(character_route):
+    from hermes_yaml import safe_load
+
+    homes, _, connect = character_route
+    call = connect("work")
+    root_meta = homes["default"] / "profile.yaml"
+    work_meta = homes["work"] / "profile.yaml"
+    root_before = root_meta.read_bytes()
+    roster = await call("profiles.list", include_sessions=False)
+    bot = next(row for row in roster["result"]["profiles"] if row["name"] == "work")
+    assert bot["ui_meta"]["hermes-bots"] == {"title": "Existing"}
+    revision = bot["ui_meta_revisions"].get("hermes-bots", 0)
+
+    async def save(character, expected):
+        return (await call("profiles.configure", name="work",
+                           ui_meta={"hermes-bots": {"title": "Existing", "character": character}},
+                           ui_meta_expected_revisions={"hermes-bots": expected}))["result"]
+
+    saved = await save("shared", revision)
+    assert saved["applied"]["ui_meta"] is True
+    saved_bytes = work_meta.read_bytes()
+    assert safe_load(saved_bytes)["ui_meta"]["hermes-bots"]["character"] == "shared"
+    # The stale clear leaves both the assignment and its revision unchanged.
+    stale = await save(None, revision)
+    assert stale["applied"]["ui_meta_conflicts"]["hermes-bots"]["actual"] == revision + 1
+    assert work_meta.read_bytes() == saved_bytes
+    cleared = await save(None, revision + 1)
+    assert cleared["applied"]["ui_meta"] is True
+    assert safe_load(work_meta.read_bytes())["ui_meta"] == {
+        "hermes-bots": {"title": "Existing", "character": None}, "other": "keep"
+    }
+    assert root_meta.read_bytes() == root_before
