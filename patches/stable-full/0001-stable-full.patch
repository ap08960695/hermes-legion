+"""Bound token-estimate retention and release closed conversations' entries.
 
 ``agent.model_metadata._MSG_TOKENS_CACHE`` pins every string it fingerprints (the pin keeps the ``id()``
-key sound), so a long-lived process kept each closed session's message bodies resident until 4096 newer
-messages pushed them out.
+key sound). A byte/count bound limits retention even before the owning conversation closes;
+close and compression also release entries holding message bodies they no longer need.
 """
@@ -9,2 +9,4 @@ from __future__ import annotations
 
+import sys
+import threading
 from typing import Any
@@ -12,2 +14,80 @@ from typing import Any
 
+def _retained_size(key: Any, value: Any) -> int:
+    """Conservatively charge shared immutable objects once per entry, not per process."""
+    seen: set[int] = set()
+    stack = [key, value]
+    size = 0
+    while stack:
+        item = stack.pop()
+        identity = id(item)
+        if identity in seen:
+            continue
+        seen.add(identity)
+        size += sys.getsizeof(item)
+        if type(item) in (list, tuple):
+            stack.extend(item)
+    return size
+
+
+class MessageTokenMemo:
+    """FIFO memo bounded by both entry count and retained key/value bytes.
+
+    Admission never truncates a message or changes an estimate. Oversized entries
+    simply remain uncached. Snapshots keep close/compression eviction safe while
+    other conversations estimate tokens in the same process.
+    """
+
+    def __init__(self, max_bytes: int = 32 * 1024 * 1024, max_entries: int = 4096):
+        self._max_bytes = max_bytes
+        self._max_entries = max_entries
+        self._entries: dict[Any, tuple[Any, int]] = {}
+        self._bytes = 0
+        self._lock = threading.Lock()
+
+    def get(self, key: Any) -> Any:
+        with self._lock:
+            entry = self._entries.get(key)
+            return entry[0] if entry is not None else None
+
+    def __setitem__(self, key: Any, value: Any) -> None:
+        size = _retained_size(key, value)
+        with self._lock:
+            old = self._entries.pop(key, None)
+            if old is not None:
+                self._bytes -= old[1]
+            if size > self._max_bytes or self._max_entries <= 0:
+                return
+            while self._entries and (self._bytes + size > self._max_bytes
+                                     or len(self._entries) >= self._max_entries):
+                _, evicted_size = self._entries.pop(next(iter(self._entries)))
+                self._bytes -= evicted_size
+            self._entries[key] = (value, size)
+            self._bytes += size
+
+    def pop(self, key: Any, default: Any = None) -> Any:
+        with self._lock:
+            entry = self._entries.pop(key, None)
+            if entry is None:
+                return default
+            self._bytes -= entry[1]
+            return entry[0]
+
+    def clear(self) -> None:
+        with self._lock:
+            self._entries.clear()
+            self._bytes = 0
+
+    def items(self) -> tuple:
+        with self._lock:
+            return tuple((key, entry[0]) for key, entry in self._entries.items())
+
+    def values(self) -> tuple:
+        with self._lock:
+            return tuple(entry[0] for entry in self._entries.values())
+
+    def __len__(self) -> int:
+        with self._lock:
+            return len(self._entries)
+
+
 def _long_string_ids(messages: Any) -> set[int]:
