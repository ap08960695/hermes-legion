+    expect(screen.getByRole('button', { name: 'Fixture card 0' })).toBeTruthy()
+    expect(screen.queryByRole('button', { name: /t_12345602/ })).toBeNull()
+    expect(io.read).not.toHaveBeenCalled()
+
+    fireEvent.click(screen.getByRole('button', { name: 'Show more · 50 / 51' }))
+    const button = screen.getByRole('button', { name: 'Review config Done · unassigned · t_12345602' })
+    fireEvent.click(button)
+    await screen.findByRole('article', { name: 'Review config' })
