+            # Supplemental hits receive a bounded logical excerpt below instead.
+            snippet_case = f'WHEN NOT {original} THEN NULL '
+            snippet_params = [match_query]
+        else:
+            guard = f'(CASE WHEN {structured} THEN ({logical}) ELSE 1 END)'
+            params = [match, *bound]
+            snippet_case, snippet_params = '', []
