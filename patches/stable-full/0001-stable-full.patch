index 0000000000000000000000000000000000000000..73d41102c54539207b10369cdb2eea681472654e
--- /dev/null
+++ b/apps/desktop/src/lib/pet-sprite-paint.ts
@@ -0,0 +1,16 @@
+const versions = new WeakMap<HTMLCanvasElement, number>()
+const listeners = new Set<() => void>()
+
+export const petSpritePaintVersion = (canvas: HTMLCanvasElement) => versions.get(canvas)
+
+export function subscribePetSpritePaint(listener: () => void): () => void {
+  listeners.add(listener)
+
+  return () => {listeners.delete(listener)}
+}
+
+export const markPetSpritePaint = (canvas: HTMLCanvasElement) => {
+  versions.set(canvas, (versions.get(canvas) ?? 0) + 1)
+
+  for (const listener of listeners) {listener()}
+}
