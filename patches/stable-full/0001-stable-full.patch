diff --git a/apps/desktop/src/app/focus/catalog.ts b/apps/desktop/src/app/focus/catalog.ts
new file mode 100644
index 0000000000000000000000000000000000000000..d2735542cf23cdc23d58e4d586d0c2fab3c48fc0
--- /dev/null
+++ b/apps/desktop/src/app/focus/catalog.ts
@@ -0,0 +1,48 @@
+import type { Contribution } from '@/contrib/types'
+import type { PluginRecord } from '@/contrib/plugins-store'
+import type { SidebarNavContribution, contributedRoutes } from '../routes'
+import { buildFeatureCatalog } from './model'
+/** Static metadata only: no plugin render is duplicated and no action runs while listing. */
+export function completeFeatureCatalog(
+  nav: readonly Contribution[],
+  routes: ReturnType<typeof contributedRoutes>,
+  panes: readonly Contribution[],
+  plugins: readonly PluginRecord[],
+  status: readonly Contribution[],
+  t: (key: string) => string
+) {
+  const rows = buildFeatureCatalog(
+    nav.flatMap(item => {
+      const data = item.data as SidebarNavContribution | undefined
+      return data?.path ? [{ id: item.id, ...data }] : []
+    }),
+    panes
+  )
+  for (const route of routes) {
+    if (['/spaces', '/artifacts', '/hub'].includes(route.path) || rows.some(row => row.path === route.path)) continue
+    rows.push({
+      id: route.key,
+      path: route.path,
+      label:
+        route.title ||
+        route.path
+          .slice(1)
+          .replaceAll('-', ' ')
+          .replace(/^./, value => value.toUpperCase()),
+      codicon: 'extensions',
+      group: 'team'
+    })
+  }
+  for (const row of rows) {
+    if (row.id === 'projects' || row.id === 'logs') row.label = t(row.id)
+  }
+  for (const plugin of plugins) {
+    if (
+      plugin.status !== 'loaded' ||
+      !status.some(row => row.source === plugin.id || row.source === 'plugin:' + plugin.id)
+    )
+      continue
+    rows.push({ id: `status:${plugin.id}`, label: `${plugin.name} · ${t('statusbar')}`, statusbar: true, codicon: 'pulse', group: 'team' })
+  }
+  return rows
+}
