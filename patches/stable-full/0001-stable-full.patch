+"""goals.delegated_decisions: in-scope user-decision blocks get a bounded auto-continue."""
+
+from __future__ import annotations
+
+from unittest.mock import patch
+
+import pytest
+
+from tests.hermes_cli.test_goals import hermes_home
+
+_DECISION_BLOCK = ("blocked", "waiting for the user to choose between option A and option B", False, None, False)
+
+
+def _run(mgr, verdict, flag):
+    with patch("hermes_cli.goals.judge_goal", return_value=verdict) as judge, \
+            patch("hermes_cli.goals._delegated_decisions_enabled", return_value=flag):
+        decision = mgr.evaluate_after_turn("Which option should I pick, A or B?")
+    return decision, judge.call_args.kwargs["delegated_decisions"]
+
+
+def test_flag_off_keeps_pausing_on_user_decision_block(hermes_home):
+    from hermes_cli.goals import GoalManager
+
+    mgr = GoalManager(session_id="dd-off")
+    mgr.set("ship the feature")
+    decision, passed = _run(mgr, _DECISION_BLOCK, False)
+    assert passed is False
+    assert decision["status"] == "paused"
+    assert mgr.state.delegated_auto_continues == 0
+
+
+def test_flag_on_auto_continues_twice_then_pauses(hermes_home):
+    from hermes_cli.goals import GoalManager, GoalState, load_goal
+
+    mgr = GoalManager(session_id="dd-on")
+    mgr.set("ship the feature")
+    for n in (1, 2):
+        decision, passed = _run(mgr, _DECISION_BLOCK, True)
+        assert passed is True
+        assert decision["should_continue"] is True and decision["status"] == "active"
+        assert "decide yourself within your authority" in decision["continuation_prompt"]
+        assert mgr.state.delegated_auto_continues == n
+    # Counter persists in goal state.
+    assert GoalState.from_json(load_goal("dd-on").to_json()).delegated_auto_continues == 2
+    decision, _ = _run(mgr, _DECISION_BLOCK, True)
+    assert decision["status"] == "paused"
+
+
+@pytest.mark.parametrize("reason", [
+    "missing API key for the payment provider",
+    "needs user approval to delete the production database",
+    "The user input file data.csv does not exist, so the goal cannot be completed",
+])
