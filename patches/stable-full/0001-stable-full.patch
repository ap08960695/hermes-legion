+@pytest.mark.parametrize('host_cap,profile_cap', [(1, None), (8, 1)])
+def test_parallel_claims_respect_shared_capacity(board, monkeypatch, host_cap, profile_cap):
+    kb.create_board('other')
+    with kbc.connect_closing() as conn:
+        first_id = kb.create_task(conn, title='first', assignee='alice')
+    with kbc.connect_closing(board='other') as conn:
+        kb.create_task(conn, title='second', assignee='alice')
+    entered = threading.Event()
+    release = threading.Event()
+    original_claim = kb.claim_task
+
+    def synchronized_claim(conn, tid, **kwargs):
+        if tid == first_id:
+            entered.set()
+            assert release.wait(timeout=10)
+        return original_claim(conn, tid, **kwargs)
+
+    monkeypatch.setattr(kb, 'claim_task', synchronized_claim)
+    spawns = []
+    def tick(slug):
+        with kbc.connect_closing(board=slug) as conn:
+            return kbd.dispatch_once(conn, board=slug, max_in_progress=host_cap,
+                                     max_in_progress_per_profile=profile_cap,
+                                     spawn_fn=lambda task, workspace, board=None: spawns.append(task.id))
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        first = pool.submit(tick, 'default')
+        assert entered.wait(timeout=10)
+        second = pool.submit(tick, 'other')
+        try:
+            second.result(timeout=10)
+        finally:
+            release.set()
+        first.result(timeout=10)
+    assert len(spawns) == 1
