@@ -0,0 +1,95 @@
+"""Read message bytes on the caller's snapshot without native Blob bookkeeping."""
+from __future__ import annotations
+
+import operator
+import sqlite3
+
+
+class SQLiteBlobReader:
+    """Seekable read-only view; callers choose bounded read sizes.
+
+    CPython retains weak references for every native blobopen on a connection.
+    SQL byte windows avoid that per-row retention. An unconsumed anchor cursor
+    pins the read snapshot across windows without altering caller transactions.
+    """
+
+    def __init__(self, conn, field: str, message_id: int):
+        if field not in {'content', 'tool_calls', 'tool_name'}:
+            raise ValueError('unsupported message field')
+        self._conn = conn
+        self._field = field
+        self._message_id = operator.index(message_id)
+        self._position = 0
+        self._anchor = conn.execute('SELECT id FROM messages WHERE id=?', (self._message_id,))
+        try:
+            row = conn.execute(
+                f'SELECT typeof({field}), length(CAST({field} AS BLOB)), '
+                f'substr(CAST({field} AS BLOB), 1, 65536) FROM messages WHERE id=?',
+                (self._message_id,),
+            ).fetchone()
+            if row is None or row[0] not in {'text', 'blob'}:
+                raise sqlite3.OperationalError('message field is not readable byte data')
+            self._size = row[1]
+            self._prefix = row[2]
+        except BaseException:
+            self._anchor.close()
+            self._anchor = None
+            self._conn = None
+            self._prefix = b''
+            raise
+
+    def _check_open(self):
+        if self._anchor is None:
+            raise sqlite3.ProgrammingError('message byte reader is closed')
+
+    def __enter__(self):
+        self._check_open()
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
+
+    def close(self):
+        if self._anchor is not None:
+            self._anchor.close()
+            self._anchor = None
+            self._conn = None
+            self._prefix = b''
+
+    def __len__(self):
+        self._check_open()
+        return self._size
+
+    def tell(self):
+        self._check_open()
+        return self._position
+
+    def seek(self, offset, origin=0):
+        self._check_open()
+        offset, origin = operator.index(offset), operator.index(origin)
+        if origin not in (0, 1, 2):
+            raise ValueError('invalid seek origin')
+        target = (0, self._position, self._size)[origin] + offset
+        if not 0 <= target <= self._size:
+            raise ValueError('seek outside message field')
+        self._position = target
+
+    def read(self, length=-1):
+        self._check_open()
+        length = operator.index(length)
+        remaining = self._size - self._position
+        length = remaining if length < 0 else min(length, remaining)
+        if not length:
+            return b''
+        if self._position + length <= len(self._prefix):
+            value = self._prefix[self._position:self._position + length]
+        else:
+            row = self._conn.execute(
+                f'SELECT substr(CAST({self._field} AS BLOB), ?, ?) FROM messages WHERE id=?',
+                (self._position + 1, length, self._message_id),
+            ).fetchone()
+            value = row[0] if row is not None else None
+        if not isinstance(value, bytes) or len(value) != length:
+            raise sqlite3.OperationalError('message field changed during byte reading')
+        self._position += length
+        return value
