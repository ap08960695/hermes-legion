+
+@pytest.mark.parametrize('field', ['failed_files', 'failed_dbs', 'oversized_skipped'])
+def test_restore_reports_snapshot_that_was_incomplete_at_creation(home, field):
+    sid = backup.create_quick_snapshot(label='original', hermes_home=home)
+    manifest = home / 'state-snapshots' / sid / 'manifest.json'
+    data = json.loads(manifest.read_text()); data[field] = ['pairing/other.json']
+    manifest.write_text(json.dumps(data))
+    assert backup.restore_quick_snapshot(sid, hermes_home=home) is False
+
+
+def test_failed_database_restore_is_not_reported_as_complete(home, monkeypatch):
+    sid = backup.create_quick_snapshot(label='original', hermes_home=home)
+    monkeypatch.setattr(backup, '_safe_restore_db', lambda *args: False)
+    assert backup.restore_quick_snapshot(sid, hermes_home=home) is False
+
+
+def test_snapshot_parent_directory_failure_retains_older_snapshot(home, monkeypatch):
+    first = backup.create_quick_snapshot(label='a', hermes_home=home, keep=1)
+    original = Path.mkdir
+    def fail_pairing(self, *args, **kwargs):
+        if self.name == 'pairing' and self.parent.name.endswith('.partial'):
+            raise OSError('injected directory failure')
+        return original(self, *args, **kwargs)
+    monkeypatch.setattr(Path, 'mkdir', fail_pairing)
+    second = backup.create_quick_snapshot(label='z', hermes_home=home, keep=1)
+    root = home / 'state-snapshots'
+    assert (root / first / 'pairing' / 'approved.json').is_file()
+    meta = json.loads((root / second / 'manifest.json').read_text())
+    assert 'pairing/approved.json' in meta['failed_files']
+
+
+def test_unreadable_nested_directory_preserves_previous_snapshot(home):
+    if __import__('os').geteuid() == 0:
+        pytest.skip('directory permissions do not deny root')
+    restricted = home / 'pairing' / 'restricted'; restricted.mkdir()
+    (restricted / 'approved.json').write_text('{"example": true}')
+    first = backup.create_quick_snapshot(label='a', hermes_home=home, keep=1)
+    restricted.chmod(0)
+    try:
+        second = backup.create_quick_snapshot(label='z', hermes_home=home, keep=1)
+    finally:
+        restricted.chmod(0o700)
+    root = home / 'state-snapshots'
+    assert (root / first / 'pairing' / 'restricted' / 'approved.json').is_file()
+    meta = json.loads((root / second / 'manifest.json').read_text())
+    assert 'pairing/restricted' in meta['failed_files']
+
+
+def test_snapshot_never_walks_excluded_board_subtrees(home, monkeypatch):
+    import os
+    board = home / 'kanban' / 'boards' / 'board-a'; board.mkdir(parents=True)
+    (board / 'manifest.json').write_text('{}')
+    for dirname in ('workspaces', 'attachments'):
+        hidden = board / dirname / 'deep'; hidden.mkdir(parents=True)
+        (hidden / 'large-artifact').write_text('not part of quick snapshots')
+    original = os.scandir; walked = []
+    def record(path):
+        walked.append(str(path))
+        return original(path)
+    monkeypatch.setattr(os, 'scandir', record)
+    sid = backup.create_quick_snapshot(label='walk', hermes_home=home)
+    snap = home / 'state-snapshots' / sid
+    assert (snap / 'kanban' / 'boards' / 'board-a' / 'manifest.json').is_file()
+    assert not any('/workspaces' in path or '/attachments' in path for path in walked)
+
+
+@pytest.mark.parametrize('relative,exc', [
+    ('config.yaml', PermissionError('injected stat denial')),
+    ('pairing/approved.json', FileNotFoundError('file vanished during traversal')),
+])
+def test_unstatable_critical_state_does_not_replace_previous_snapshot(home, monkeypatch, relative, exc):
+    first = backup.create_quick_snapshot(label='a', hermes_home=home, keep=1)
+    target = home / relative
+    original = Path.stat
+    def refuse(self, *args, **kwargs):
+        if self == target:
+            raise exc
+        return original(self, *args, **kwargs)
+    monkeypatch.setattr(Path, 'stat', refuse)
+    second = backup.create_quick_snapshot(label='z', hermes_home=home, keep=1)
+    root = home / 'state-snapshots'
+    assert (root / first / relative).is_file()
+    meta = json.loads((root / second / 'manifest.json').read_text())
+    assert relative in meta['failed_files']
