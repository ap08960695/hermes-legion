+import { fireEvent, render, screen } from '@testing-library/react'
+import { describe, expect, it, vi } from 'vitest'
+
+import { FocusFrame } from './frame'
+import { buildFeatureCatalog } from './model'
+
+const copy = (key: string) => key
+
+describe('native Focus frame', () => {
+  it('keeps the same mounted chat through presentation switches', () => {
+    const onMode = vi.fn()
+    const view = render(
+      <FocusFrame
+        mode="simple"
+        t={copy}
+        features={buildFeatureCatalog([])}
+        onMode={onMode}
+        onTarget={vi.fn()}
+        onPrimary={vi.fn()}
+        onSearch={vi.fn()}
+      >
+        <input aria-label="Native draft" defaultValue="Keep me" />
+      </FocusFrame>
+    )
+    fireEvent.click(screen.getByRole('button', { name: 'workspace' }))
+    expect(onMode).toHaveBeenCalledWith('advanced')
+    view.rerender(
+      <FocusFrame
+        mode="advanced"
+        t={copy}
+        features={buildFeatureCatalog([])}
+        onMode={onMode}
+        onTarget={vi.fn()}
+        onPrimary={vi.fn()}
+        onSearch={vi.fn()}
+      >
+        <input aria-label="Native draft" defaultValue="Keep me" />
+      </FocusFrame>
+    )
+    expect((screen.getByLabelText('Native draft') as HTMLInputElement).value).toBe('Keep me')
+  })
+  it('shows a searchable feature dialog and navigates once without background actions', () => {
+    const onTarget = vi.fn(),
+      onPrimary = vi.fn()
+    render(
+      <FocusFrame
+        mode="simple"
+        t={copy}
+        features={buildFeatureCatalog([])}
+        onMode={vi.fn()}
+        onTarget={onTarget}
+        onPrimary={onPrimary}
+        onSearch={vi.fn()}
+      >
+        <div>Native chat</div>
+      </FocusFrame>
+    )
+    expect(onTarget).not.toHaveBeenCalled()
+    expect(onPrimary).not.toHaveBeenCalled()
+    fireEvent.click(screen.getByRole('button', { name: 'all' }))
+    fireEvent.change(screen.getByRole('textbox', { name: 'searchFeatures' }), { target: { value: 'skills' } })
+    fireEvent.click(screen.getByRole('button', { name: 'features.skills' }))
+    expect(onTarget).toHaveBeenCalledExactlyOnceWith({ path: '/capabilities?tab=skills' })
+    expect(screen.queryByRole('dialog')).toBeNull()
+    expect(screen.getByText('Native chat')).not.toBeNull()
+  })
+})
+
+it('keeps context visible above the workspace, outside the navigation rail', () => {
+  const view = render(
+    <FocusFrame
+      mode="simple"
+      t={copy}
+      features={[]}
+      onMode={vi.fn()}
+      onTarget={vi.fn()}
+      onPrimary={vi.fn()}
+      onSearch={vi.fn()}
+      scopeControl={<section aria-label="Visible context">Device and profile</section>}
+    >
+      <input aria-label="Retained draft" defaultValue="Keep draft" />
+    </FocusFrame>
+  )
+  const context = screen.getByRole('region', { name: 'Visible context' })
+  expect(context.closest('.hermes-focus-content')).not.toBeNull()
+  expect(context.closest('.hermes-focus-rail')).toBeNull()
+  expect((screen.getByLabelText('Retained draft') as HTMLInputElement).value).toBe('Keep draft')
+  view.unmount()
+})
+
+it('exposes New chat without changing the current draft until explicitly selected', () => {
+  const target = vi.fn()
+  render(
+    <FocusFrame
+      mode="simple"
+      t={copy}
+      features={[]}
+      onMode={vi.fn()}
+      onTarget={target}
+      onPrimary={vi.fn()}
+      onSearch={vi.fn()}
+    >
+      <input aria-label="draft" defaultValue="Keep me" />
+    </FocusFrame>
+  )
+  expect(target).not.toHaveBeenCalled()
+  fireEvent.click(screen.getByRole('button', { name: 'newChat' }))
+  expect(target).toHaveBeenCalledExactlyOnceWith({ path: '/' })
+  expect((screen.getByLabelText('draft') as HTMLInputElement).value).toBe('Keep me')
+})
+
+it('uses the native new-chat action and identifies History even with a bot pane focused', () => {
+  const create = vi.fn(),
+    target = vi.fn()
+  render(
+    <FocusFrame
+      mode="advanced"
+      t={copy}
+      features={[]}
+      path="/history"
+      active="bots"
+      onNewChat={create}
+      onMode={vi.fn()}
+      onTarget={target}
+      onPrimary={vi.fn()}
+      onSearch={vi.fn()}
+    >
+      Chat
+    </FocusFrame>
+  )
+  expect(screen.getByRole('button', { name: 'chatHistory' }).getAttribute('aria-current')).toBe('page')
+  expect(screen.getByRole('button', { name: 'bots' }).getAttribute('aria-current')).toBeNull()
+  fireEvent.click(screen.getByRole('button', { name: 'newChat' }))
+  expect(create).toHaveBeenCalledTimes(1)
+  expect(target).not.toHaveBeenCalled()
+})
diff --git a/apps/desktop/src/app/focus/frame.tsx b/apps/desktop/src/app/focus/frame.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..ea98ba72a82481e2009f98f2a574f903c5443db1
--- /dev/null
+++ b/apps/desktop/src/app/focus/frame.tsx
@@ -0,0 +1,207 @@
+import { useState, type ReactNode } from 'react'
+
+import { Button } from '@/components/ui/button'
+import { Codicon } from '@/components/ui/codicon'
+import { Dialog, DialogContent, DialogTitle } from '@/components/ui/dialog'
+import { SearchField } from '@/components/ui/search-field'
+import type { InterfaceMode } from '@/store/interface-mode'
+
+import { FocusNavigationContext } from './context'
+import type { FocusFeature, FocusTarget, PrimarySection } from './model'
+import './frame.css'
+
+interface FocusFrameProps {
+  children: ReactNode
+  mode: InterfaceMode
+  features: readonly FocusFeature[]
+  t: (key: string) => string
+  onMode: (mode: InterfaceMode) => void
+  onPrimary: (section: PrimarySection) => void
+  onTarget: (target: FocusTarget) => void
+  onSessions?: () => void
+  onNewChat?: () => void
+  path?: string
+  scopeControl?: ReactNode
+  onSearch: () => void
+  active?: PrimarySection
+}
+const PRIMARY = [
+  { id: 'chat', icon: 'comment-discussion' },
+  { id: 'tasks', icon: 'checklist' },
+  { id: 'bots', icon: 'robot' },
+  { id: 'hub', icon: 'folder-library' }
+] as const
+
+/** One navigation owner around the native workspace, session and tool surfaces. */
+export function FocusFrame({
+  children,
+  mode,
+  features,
+  t,
+  onMode,
+  onPrimary,
+  onTarget,
+  onSearch,
+  onSessions,
+  onNewChat,
+  path,
+  scopeControl,
+  active
+}: FocusFrameProps) {
+  const [allOpen, setAllOpen] = useState(false)
+  const [query, setQuery] = useState('')
+  const matches = features.filter(feature =>
+    `${t(`features.${feature.id}`)} ${feature.label ?? ''} ${feature.id}`
+      .toLocaleLowerCase()
+      .includes(query.trim().toLocaleLowerCase())
+  )
+  const utilityPage = path === '/history' || path === '/projects' || path === '/settings'
+  const label = (feature: FocusFeature) => feature.label || t(`features.${feature.id}`)
+  return (
+    <div className="hermes-focus-frame" data-presentation={mode === 'simple' ? 'focus' : 'workspace'}>
+      <nav className="hermes-focus-rail" aria-label={t('navigation')}>
+        <div className="hermes-focus-brand" aria-label="Hermes">
+          <span>H</span>
+          <strong>Hermes</strong>
+        </div>
+        <div className="hermes-focus-primary">
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+            aria-label={t('newChat')}
+            onClick={onNewChat || (() => onTarget({ path: '/' }))}
+          >
+            <Codicon name="add" />
+            <span>{t('newChat')}</span>
+          </Button>
+          {PRIMARY.map(({ id, icon }) => (
+            <Button
+              key={id}
+              className="hermes-focus-nav"
+              variant="ghost"
+
+              aria-label={t(id)}
+              aria-current={!utilityPage && active === id ? 'page' : undefined}
+              onClick={() => onPrimary(id)}
+            >
+              <Codicon name={icon} />
+              <span>{t(id)}</span>
+            </Button>
+          ))}
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+
+            aria-label={t('all')}
+            aria-expanded={allOpen}
+            onClick={() => {
+              setQuery('')
+              setAllOpen(true)
+            }}
+          >
+            <Codicon name="extensions" />
+            <span>{t('all')}</span>
+          </Button>
+        </div>
+        <div className="hermes-focus-utilities">
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+            aria-label={t('chatHistory')}
+            aria-current={path === '/history' || path === '/projects' ? 'page' : undefined}
+            onClick={onSessions}
+          >
+            <Codicon name="history" />
+            <span>{t('history')}</span>
+          </Button>
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+            aria-label={t('summary')}
+
+            onClick={() => onTarget({ panel: 'work' })}
+          >
+            <Codicon name="bell" />
+            <span>{t('summary')}</span>
+          </Button>
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+            aria-label={t('search')}
+
+            onClick={onSearch}
+          >
+            <Codicon name="search" />
+            <span>{t('search')}</span>
+          </Button>
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+            aria-label={t(mode === 'simple' ? 'workspace' : 'focus')}
+
+            onClick={() => onMode(mode === 'simple' ? 'advanced' : 'simple')}
+          >
+            <Codicon name={mode === 'simple' ? 'layout' : 'layout-centered'} />
+            <span>{t(mode === 'simple' ? 'workspaceShort' : 'focus')}</span>
+          </Button>
+          <Button
+            className="hermes-focus-nav"
+            variant="ghost"
+            aria-label={t('settings')}
+            aria-current={path === '/settings' ? 'page' : undefined}
+
+            onClick={() => onTarget({ path: '/settings' })}
+          >
+            <Codicon name="settings-gear" />
+            <span>{t('settings')}</span>
+          </Button>
+        </div>
+      </nav>
+      <FocusNavigationContext.Provider value={true}>
+        <div className="hermes-focus-content">
+          {scopeControl}
+          {children}
+        </div>
+      </FocusNavigationContext.Provider>
+      <Dialog open={allOpen} onOpenChange={setAllOpen}>
+        <DialogContent aria-describedby={undefined} bodyClassName="hermes-focus-features">
+          <DialogTitle>{t('all')}</DialogTitle>
+          <SearchField
+            aria-label={t('searchFeatures')}
+            placeholder={t('searchFeatures')}
+            value={query}
+            onChange={setQuery}
+          />
+          {(['work', 'team', 'system'] as const).map(group => {
+            const rows = matches.filter(feature => feature.group === group)
+            return rows.length ? (
+              <section key={group}>
+                <h3>{t(`groups.${group}`)}</h3>
+                <div className="hermes-focus-feature-grid">
+                  {rows.map(feature => (
+                    <Button
+                      key={feature.id}
+                      variant="ghost"
+
+                      onClick={() => {
+                        setAllOpen(false)
+                        if (feature.path) onTarget({ path: feature.path })
+                        else if (feature.pane) onTarget({ pane: feature.pane })
+                        else if (feature.panel) onTarget({ panel: feature.panel })
+                        else if (feature.statusbar) onTarget({ statusbar: true })
+                      }}
+                    >
+                      <Codicon name={feature.codicon} />
+                      <span>{label(feature)}</span>
+                    </Button>
+                  ))}
+                </div>
+              </section>
+            ) : null
+          })}
+          {!matches.length && <p role="status">{t('noFeatures')}</p>}
+        </DialogContent>
+      </Dialog>
+    </div>
+  )
+}
