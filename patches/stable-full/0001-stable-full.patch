+++ b/apps/desktop/src/plugins/hermes-bots/monitor-characters.tsx
@@ -0,0 +1,305 @@
+import { atom, Dialog, host, MAX_PREVIEW_CHARACTERS, type PetCharacterPublisher, useValue } from '@hermes/plugin-sdk'
+import { useEffect, useMemo, useRef, useState } from 'react'
+
+import { notifyBotOpenFailure, openBotCanonicalChat } from './canonical-chat'
+import { $characterSpriteRefresh, type CharacterSpriteTarget, createCharacterSpriteLoader } from './character-sprites'
+import { $botMeta, botRosterKey } from './data'
+import { useBots } from './i18n'
+import { stripPreviewMarkdown } from './labels'
+// eslint-disable-next-line no-restricted-imports -- bundled Characters controller shares the shell setting.
+import type { CharacterSize } from '@/store/character-settings'
+// eslint-disable-next-line no-restricted-imports -- share the loaded default atlas with the desktop overlay.
+import { $petInfo, type PetInfo } from '@/store/pet'
+
+import type { BotMonitorProps } from './monitor'
+import { BotMonitorReportContent, type ReportSnapshot } from './monitor-reports'
+import { botRosterMeta, focusedBotClarificationRow, requestForBot, resolveBotConnectionRoute } from './routing'
+import { activeWorkerSessions, workerProgress } from './row-helpers'
+import { $botPluginCtx, bumpBotOpenGeneration, getBotOpenGeneration } from './shared'
+import type { BotDelegationReport } from './types'
+
+const unavailable = atom(false)
+const noClarification = atom(null)
+interface Actor {
+  character: Parameters<PetCharacterPublisher['update']>[0][number]
+  target?: CharacterSpriteTarget
+}
+
+type OutputReply = Awaited<ReturnType<NonNullable<NonNullable<Actor['character']['output']>['read']>>>
+type FileReply = Awaited<ReturnType<NonNullable<NonNullable<Actor['character']['output']>['previewFile']>>>
+
+function completionIsFresh(at: number | null, now: number) {
+  return typeof at === 'number' && at > 0 && now - at * 1000 >= 0 && now - at * 1000 < 60_000
+}
+
+function reportPreviewText(report: BotDelegationReport) {
+  return report.status === 'error' ? report.error.trim() || report.summary.trim() : report.summary.trim()
+}
+
+function savedWorkerReport(saved: BotDelegationReport[] | null | undefined, now: number) {
+  if (!Array.isArray(saved)) {return undefined}
+  const reports = saved.slice(0, 20)
+
+  return reports.find(report => (report?.status === 'completed' || report?.status === 'error') &&
+    completionIsFresh(report.completed_at, now) &&
+    typeof report.delegation_id === 'string' && report.delegation_id.length > 0 && report.delegation_id.length <= 512 &&
+    report.task_index !== null && Number.isSafeInteger(report.task_index) && report.task_index >= 0 &&
+    typeof report.summary === 'string' && typeof report.goal === 'string' && typeof report.error === 'string' &&
+    Boolean(reportPreviewText(report)) &&
+    reports.filter(other => other?.delegation_id === report.delegation_id && other.task_index === report.task_index).length === 1)
+}
+
+export function MonitorCharacters({ rows, now, stale, active, independent, includeSixth, size, anchor, defaultSprite, refreshOwner }: Pick<BotMonitorProps, 'rows' | 'now' | 'stale'> & {
+  active: boolean
+  independent?: boolean
+  includeSixth?: boolean
+  size?: CharacterSize
+  defaultSprite?: PetInfo
+  refreshOwner?: { connectionId: string; profile: string }
+  anchor: () => DOMRect
+}) {
+  const b = useBots(), pet = useValue($botPluginCtx)?.pet
+  const mascotVisible = useValue(pet?.visible || unavailable), metadata = useValue($botMeta)
+  const visible = independent || mascotVisible
+  const legacyAtlas = useValue($petInfo).spritesheetBase64
+  const hasDefaultAtlas = Boolean(defaultSprite || legacyAtlas)
+  const clarification = useValue(host.state.focusedClarification || noClarification)
+  const preview = useRef<PetCharacterPublisher | null>(null)
+  const loader = useRef<ReturnType<typeof createCharacterSpriteLoader> | null>(null)
+  const [spriteVersion, setSpriteVersion] = useState(0)
+  const limit = includeSixth ? MAX_PREVIEW_CHARACTERS : 5
+  const [reportSnapshot, setReportSnapshot] = useState<{ snapshot: ReportSnapshot; returnFocus: HTMLElement | null } | null>(null)
+
+  // eslint-disable-next-line no-restricted-syntax -- owns a non-atom loader lifecycle; no reactive value is mirrored
+  useEffect(() => {
+    loader.current = createCharacterSpriteLoader(() => setSpriteVersion(version => version + 1), reply => preview.current?.prepareSprite?.(reply) ?? null)
+
+    return () => {loader.current?.dispose(); loader.current = null}
+  }, [])
+
+  useEffect(() => {
+    if (!active || !visible) {return}
+    const publisher = pet?.previewCharacters?.(anchor(), independent) ?? null
+    preview.current = publisher
+
+    return () => {
+      publisher?.dispose()
+      preview.current = null
+    }
+  }, [active, anchor, independent, pet, visible])
+
+  const actors = useMemo(() => {
+    const current: Actor[] = [], workers: Actor[] = [], finished: Actor[] = []
+
+    if (!active || !visible || stale) {return current}
+
+    const waitingRow = focusedBotClarificationRow(rows, clarification)
+
+    for (const row of [...rows].sort((a, z) => botRosterKey(a.bot).localeCompare(botRosterKey(z.bot)))) {
+      if (!row.bot.connectionId || row.bot.retained || row.bot.ghost || row.source.key !== 'ready' || !row.source.available) {continue}
+      const key = botRosterKey(row.bot), source = row.bot.connectionLabel || row.bot.connectionId
+      const meta = botRosterMeta(row.bot, metadata)
+      const assigned = meta && Object.prototype.hasOwnProperty.call(meta, 'character') ? meta.character : row.bot.ui_meta?.['hermes-bots']?.character
+      if (independent && assigned == null && !hasDefaultAtlas) {continue}
+      let target: CharacterSpriteTarget | undefined
+
+      if (assigned != null) {
+        if (typeof assigned !== 'string' || !assigned || assigned.length > 128) {continue}
+        const bot = { ...row.bot, sourceScoped: true, route: row.bot.route ? { ...row.bot.route } : undefined }
+        const owner = resolveBotConnectionRoute(bot)
+
+        if (owner.status !== 'resolved') {continue}
+        target = { key: JSON.stringify([key, owner.route, bot.installId, assigned]),
+          read: async () => {
+            const params = { profile: bot.name, slug: assigned }
+            const variant = preview.current?.atlasVariant
+            const read = (query: Record<string, unknown>) => requestForBot<{ slug?: unknown }>(bot, 'pet.sprite', query, { timeoutMs: 8000 })
+
+            const sprite = await read(variant ? { ...params, variant } : params).catch((error: unknown) => {
+              if (!variant || !error || typeof error !== 'object' || !('message' in error) ||
+                  typeof error.message !== 'string' || !error.message.startsWith('invalid params for pet.sprite: variant:')) {throw error}
+
+              return read(params)
+            })
+
+            return sprite?.slug === assigned ? sprite : null
+          } }
+      }
+
+      const awaitingInput = row === waitingRow
+
+      if (row.working || row.needsAttention || awaitingInput) {
+        const { route } = resolveBotConnectionRoute({ ...row.bot, sourceScoped: true })
+        const bot = { ...row.bot, sourceScoped: true, route: route ?? undefined }
+        const registryId = bot.canonical_session?.id
+        const canonical = bot.canonical_session?.resolved_id || registryId
+
+        const output = route && registryId && canonical ? {
+          key: JSON.stringify([route, bot.installId, registryId, canonical]),
+          read: (pdfPreview?: true) => requestForBot<OutputReply>(bot, 'profiles.latest_output',
+            { canonical_id: canonical, ...(pdfPreview ? { pdf_preview: true } : {}) }, { timeoutMs: 8000 }),
+          ...(route.mode === 'local' && route.connectionId === 'local' ? {
+            previewFile: (token: string, pdfPreview?: true) => requestForBot<FileReply>(bot, 'profiles.output_file',
+              { canonical_id: canonical, token, ...(pdfPreview ? { pdf_preview: true } : {}) }, { timeoutMs: 8000 })
+          } : {}),
+          open: async (current: () => boolean) => {
+            const generation = bumpBotOpenGeneration()
+            const stillCurrent = () => current() && generation === getBotOpenGeneration()
+
+            try {
+              const opened = await openBotCanonicalChat(bot, { expectedRegistryId: registryId, openingStillCurrent: stillCurrent })
+
+              if (!opened && stillCurrent()) {notifyBotOpenFailure(new Error('The previewed Bot Chat is no longer available'), bot, 'open', row.name)}
+            } catch (error) {
+              if (generation === getBotOpenGeneration()) {notifyBotOpenFailure(error, bot, 'open', row.name)}
+            }
+          }
+        } : undefined
+
+        const detail = row.needsAttention ? row.attentionHint : awaitingInput
+          ? b.group.waitingForAnswer : row.bot.canonical_session?.preview || ''
+
+        current.push({ target, character: { id: `${key}:bot`, name: row.name, source,
+          output, detail: stripPreviewMarkdown(detail), state: row.needsAttention ? 'failed' : awaitingInput ? 'waiting' : 'run',
+          ...(awaitingInput && !row.needsAttention && clarification ? { waitingId: clarification.requestId } : {}) } })
+      }
+
+      const { route: workerRoute } = resolveBotConnectionRoute({ ...row.bot, sourceScoped: true })
+      const parent = row.bot.canonical_session
+      const parentId = parent?.resolved_id || parent?.id
+
+      if (current.length >= limit) {break}
+
+      for (const worker of activeWorkerSessions(row.bot, now)) {
+        if (workers.length >= limit) {break}
+
+        if (!worker.id) {continue}
+        const progress = workerProgress(worker, now)
+        const childId = worker.id
+
+        const output: Actor['character']['output'] = workerRoute?.mode === 'local' && workerRoute.connectionId === 'local' &&
+          parentId && childId.length <= 512 ? {
+            key: JSON.stringify([workerRoute, row.bot.installId, parent?.id, parentId, childId]),
+            prepareStop: async () => {
+              const bot = { ...row.bot, sourceScoped: true, route: workerRoute }
+              const params = { session_id: parentId, profile: workerRoute.profile }
+
+              const listing = await requestForBot<{ subagents?: { child_session_id?: string; subagent_id?: string; status?: string }[] }>(
+                bot, 'subagent.list', params, { timeoutMs: 8000 })
+
+              const matches = Array.isArray(listing?.subagents)
+                ? listing.subagents.filter(item => item?.child_session_id === childId)
+                : []
+
+              const candidate = matches[0]
+              const subagentId = candidate?.subagent_id
+
+              if (matches.length !== 1 || candidate.status !== 'running' ||
+                  typeof subagentId !== 'string' || !subagentId || subagentId.length > 512) {return undefined}
+
+              return async () => {
+                try {
+                  const result = await requestForBot<{ found?: boolean; subagent_id?: string }>(bot, 'subagent.interrupt',
+                    { ...params, subagent_id: subagentId, child_session_id: childId }, { timeoutMs: 8000, spawnPriority: 'foreground' })
+
+                  if (result?.subagent_id !== subagentId) {return 'unconfirmed'}
+
+                  return result.found === true ? 'requested' : result.found === false ? 'refused' : 'unconfirmed'
+                } catch {
+                  return 'unconfirmed'
+                }
+              }
+            }
+          } : undefined
+
+        const startedAt = typeof worker.started_at === 'number' ? Math.round(worker.started_at * 1000) : 0
+
+        workers.push({ target, character: { id: `${key}:worker:${childId}`, name: `${row.name} · ${b.monitor.worker}`, source, output,
+          ...(startedAt > 0 && startedAt <= now ? { handoff: { from: `${key}:bot`, at: startedAt } } : {}),
+          detail: [stripPreviewMarkdown(worker.last_activity_description || worker.current_tool || worker.title || ''),
+            progress.step ? b.roster.workerStep(progress.step.n, progress.step.max) : ''].filter(Boolean).join(' · '), state: 'run' } })
+      }
+
+      if (finished.length >= limit) {continue}
+
+      const session = row.bot.canonical_session
+      const saved = savedWorkerReport(session?.delegation_reports, now)
+
+      if (!saved || !session?.id) {continue}
+      const { route } = resolveBotConnectionRoute({ ...row.bot, sourceScoped: true })
+
+      if (!route) {continue}
+      const report = { ...saved }
+
+      const output = {
+        key: JSON.stringify([route, row.bot.installId, session.id, session.resolved_id || session.id, report]),
+        read: async () => {
+          if (!completionIsFresh(report.completed_at, Date.now())) {throw new Error('Saved report expired')}
+
+          return reportPreviewText(report)
+        },
+        open: async (stillCurrent: () => boolean) => {
+          if (stillCurrent() && completionIsFresh(report.completed_at, Date.now())) {
+            const activeElement = document.activeElement
+            const returnFocus = activeElement instanceof HTMLElement && activeElement !== document.body ? activeElement : null
+
+            setReportSnapshot(current => ({
+              snapshot: { at: now, name: row.name, profile: row.bot.name, reports: [report], retained: false, source },
+              returnFocus: current ? current.returnFocus : returnFocus
+            }))
+          }
+        }
+      }
+
+      const at = Math.round((report.completed_at ?? 0) * 1000)
+      const outcome = { id: JSON.stringify([session.id, report.delegation_id, report.task_index]), at }
+
+      finished.push({ target, character: { id: `${key}:saved-worker-report`,
+        name: `${row.name} · ${b.monitor.worker} · ${b.monitor.reports.statuses[report.status]}`, source,
+        output, detail: stripPreviewMarkdown(report.goal) || b.monitor.reports.summary,
+        handoff: report.status === 'completed' && report.completed_at !== null && report.task_index !== null
+          ? { to: `${key}:bot`, at, report: [report.delegation_id, report.task_index] }
+          : undefined,
+        ...(report.status === 'error' ? { failure: outcome } : { completion: outcome }),
+        state: report.status === 'error' ? 'failed' : 'wave' } })
+    }
+
+    return [...current, ...workers, ...finished].slice(0, limit)
+  }, [active, visible, stale, rows, now, metadata, b, clarification, limit, independent, hasDefaultAtlas])
+
+  useEffect(() => {loader.current?.update(actors.flatMap(actor => actor.target ? [actor.target] : []))}, [actors])
+
+  const refreshConnection = refreshOwner?.connectionId, refreshProfile = refreshOwner?.profile
+
+  useEffect(() => {
+    if (!active || !visible || stale || !refreshConnection || !refreshProfile) {return}
+
+    return $characterSpriteRefresh.listen(owner => {
+      if (owner?.connectionId === refreshConnection && owner.profile === refreshProfile) {loader.current?.retryFailed()}
+    })
+  }, [active, visible, stale, refreshConnection, refreshProfile])
+  useEffect(() => {
+    preview.current?.update(actors.flatMap(({ character, target }) => {
+      if (!target) {return [character]}
+      const sprite = loader.current?.get(target.key)
+
+      return sprite ? [{ ...character, sprite }] : []
+    }), now, size, defaultSprite)
+  }, [active, actors, defaultSprite, now, pet, size, spriteVersion])
+
+  return (
+    <Dialog onOpenChange={open => !open && setReportSnapshot(null)} open={reportSnapshot !== null}>
+      {reportSnapshot && <BotMonitorReportContent onCloseAutoFocus={event => {
+        event.preventDefault()
+        if (document.activeElement !== document.body) {return}
+        const { returnFocus } = reportSnapshot
+
+        if (returnFocus?.isConnected) {
+          returnFocus.focus({ preventScroll: true })
+          if (document.activeElement === returnFocus) {return}
+        }
+        document.querySelector<HTMLButtonElement>('[data-characters-switch]')?.focus({ preventScroll: true })
+      }} snapshot={reportSnapshot.snapshot} />}
+    </Dialog>
+  )
+}
