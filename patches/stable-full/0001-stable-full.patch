+"""Observe real call boundaries without spending inference or changing payloads."""
+import copy
+import json
+import logging
+from types import SimpleNamespace
+from agent.cache_request_diagnostics import observe_call, fingerprint
+
+
+def test_claude_and_chat_usage_remain_distinct(monkeypatch, caplog):
+    cases = [
+        ('anthropic', 'anthropic_messages', {'input_tokens':20,'cache_read_input_tokens':80,'cache_creation_input_tokens':10}, 110,80),
+        ('openai', 'chat_completions', {'prompt_tokens':110,'prompt_tokens_details':{'cached_tokens':80}},110,80),
+    ]
+    for provider, mode, usage, total, cached in cases:
+        caplog.clear()
+        agent=SimpleNamespace(provider=provider,api_mode=mode,session_id='private-session',base_url='private-route')
+        req={'model':'test','system':'private instructions','messages':[{'role':'user','content':'private body'}]}
+        original=copy.deepcopy(req); calls=[]; response={'usage':usage}
+        def send(payload):
+            calls.append(payload)
+            return response
+        with caplog.at_level(logging.INFO):
+            assert observe_call(agent,req,send,request_id='r') is response
+        rows=[json.loads(r.message.split('CACHE_DIAGNOSTIC ',1)[1]) for r in caplog.records if r.message.startswith('CACHE_DIAGNOSTIC ')]
+        assert len(rows)==1
+        assert rows[0]['usage']['input_tokens']==total
+        assert rows[0]['usage']['cached_tokens']==cached
+        assert len(calls)==1 and req==original
+        assert 'private' not in json.dumps(rows)
+
+
+def test_claude_history_and_system_changes_are_detectable():
+    kw=dict(key=b'k'*32,session_id='s',request_id='r',base_url='u')
+    req={'system':'one','messages':[{'role':'user','content':'first'}]}
+    first=fingerprint(req,**kw)
+    req['system']='two'
+    second=fingerprint(req,**kw)
+    assert first['instructions']!=second['instructions']
+    req['messages'].append({'role':'assistant','content':'second'})
+    assert fingerprint(req,**kw)['history']!=second['history']
