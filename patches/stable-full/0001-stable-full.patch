@@ -0,0 +1,30 @@
+// Build-time only. The app can use the shipped executable without Xcode.
+import { execFileSync } from 'node:child_process'
+import { chmodSync, copyFileSync, mkdirSync, mkdtempSync, renameSync, rmSync } from 'node:fs'
+import { join, resolve } from 'node:path'
+import { macosSysroot, xcrunClangArgv } from './macos-sysroot.mjs'
+
+export function buildPdfRaster({ source, distDir, platform }) {
+  if (platform !== 'darwin') return
+
+  const native = resolve(source, 'apps/desktop/electron/native')
+  const output = resolve(distDir, 'native')
+  mkdirSync(output, { recursive: true })
+  // Keep the executable's final basename while clang assigns its ad hoc identifier.
+  const stage = mkdtempSync(join(output, '.pdf-raster-'))
+  const binary = join(stage, 'pdf-raster')
+  const profile = 'pdf-raster.sb'
+  try {
+    execFileSync('xcrun', [
+      ...xcrunClangArgv(macosSysroot()), '-arch', 'arm64', '-arch', 'x86_64', '-mmacosx-version-min=13.0',
+      '-O2', '-Wall', '-Wextra', '-Werror', '-framework', 'CoreFoundation', '-framework', 'CoreGraphics',
+      '-framework', 'ImageIO', join(native, 'pdf-raster.c'), '-o', binary,
+    ], { stdio: 'inherit', timeout: 120_000 })
+    chmodSync(binary, 0o755)
+    copyFileSync(join(native, profile), join(stage, profile))
+    renameSync(binary, join(output, 'pdf-raster'))
+    renameSync(join(stage, profile), join(output, profile))
+  } finally {
+    rmSync(stage, { recursive: true, force: true })
+  }
+}
