+import { useEffect, type ReactNode } from 'react'
+import { useNavigate } from 'react-router'
+import { Button } from '@/components/ui/button'
+import { setSidebarAgentsGrouped } from '@/store/layout'
+import { useParityCopy } from '../focus/parity-copy'
+import './workspace.css'
+
+/** The original session/project actions, presented as a deliberate workspace page. */
+export function SessionManager({ mode, children }: { mode: 'history' | 'projects'; children: ReactNode }) {
+  const t = useParityCopy(),
+    navigate = useNavigate()
+  useEffect(() => {
+    setSidebarAgentsGrouped(mode === 'projects')
+  }, [mode])
+  return (
+    <section className="hermes-session-manager" aria-label={t(mode)}>
+      <header>
+        <div>
+          <h1>{t(mode)}</h1>
+          <p>{t('managerHint')}</p>
+        </div>
+        <nav aria-label={t('history')}>
+          {(['history', 'projects'] as const).map(view => (
+            <Button
+              key={view}
+              variant={view === mode ? 'secondary' : 'ghost'}
+              aria-current={view === mode ? 'page' : undefined}
+              onClick={() => navigate('/' + view)}
+            >
+              {t(view)}
+            </Button>
+          ))}
+        </nav>
+      </header>
+      <div className="hermes-session-manager-body">{children}</div>
+    </section>
+  )
+}
