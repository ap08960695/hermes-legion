+
+    text = 'prefix ' + '\\' * slashes + 'u0063afe'
+    expected = ('prefix ' + '\\' * (slashes - slashes % 2)
+                + ('cafe' if slashes % 2 else 'u0063afe'))
+    for size in (1, 7, 65536):
+        chunks = (text[i:i + size] for i in range(0, len(text), size))
+        fragments = list(_unicode_fragments(chunks))
+        assert ''.join(part for part, _, _ in fragments) == expected
+        for part, offset, unchanged in fragments:
+            if unchanged:
+                assert text[offset:offset + len(part)] == part
+            else:
+                assert text[offset:offset + 6] == r'\u0063'
