+import { EventEmitter } from 'node:events'
+
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+const io = vi.hoisted(() => ({
+  handlers: new Map<string, (event: unknown, value: unknown) => void>(),
+  trays: [] as { destroy: ReturnType<typeof vi.fn>; setContextMenu: ReturnType<typeof vi.fn> }[]
+}))
+
+vi.mock('electron', () => ({
+  ipcMain: { on: (channel: string, listener: (event: unknown, value: unknown) => void) => io.handlers.set(channel, listener) },
+  nativeImage: { createEmpty: () => ({}) },
+  Menu: { buildFromTemplate: (items: unknown[]) => items },
+  Tray: class {
+    destroy = vi.fn()
+    setTitle = vi.fn()
+    setToolTip = vi.fn()
+    setContextMenu = vi.fn()
+
+    constructor() {io.trays.push(this)}
+  }
+}))
+
+import { createCharacterMenu } from './character-menu'
+
+const ownerEvents = ['did-navigate', 'render-process-gone', 'destroyed'] as const
+
+function makeWindow() {
+  const webContents = Object.assign(new EventEmitter(), { mainFrame: {}, send: vi.fn(), isDestroyed: () => false })
+  return { webContents, isDestroyed: () => false, isMinimized: () => true }
+}
+
+function publish(window: ReturnType<typeof makeWindow>, scope: string, enabled = true) {
+  const sender = window.webContents
+  io.handlers.get('hermes:characters:menu-state')!({ sender, senderFrame: sender.mainFrame }, { scope, size: 'medium', enabled })
+}
+
+beforeEach(() => {vi.useFakeTimers()})
+afterEach(() => {
+  vi.restoreAllMocks()
+  vi.clearAllTimers()
+  vi.useRealTimers()
+  io.handlers.clear()
+  io.trays.length = 0
+})
+
+it.each(ownerEvents)('retires the menu and minimized refresh on %s', event => {
+  const schedule = vi.spyOn(globalThis, 'setInterval')
+  const window = makeWindow()
+  const owner = window.webContents
+  const controller = createCharacterMenu(() => window as never)
+  publish(window, 'first')
+  publish(window, 'updated')
+  expect(io.trays).toHaveLength(1)
+  const oldRefresh = schedule.mock.calls[0][0] as () => void
+  const attached = ownerEvents.map(ownerEvent => owner.listenerCount(ownerEvent))
+  const first = io.trays[0]
+  const oldClick = first.setContextMenu.mock.lastCall?.[0][0].click as (item: { checked: boolean }) => void
+
+  owner.emit('did-navigate-in-page')
