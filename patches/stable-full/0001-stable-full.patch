+  $botPluginCtx.set({ pet: { visible: atom(false), previewCharacters: vi.fn() } } as unknown as NonNullable<ReturnType<typeof $botPluginCtx.get>>)
+  $connection.set({ connectionId: 'local' } as NonNullable<ReturnType<typeof $connection.get>>)
