@@ -0,0 +1,159 @@
+"""Read-only observed usage attribution: python -m hermes_cli.usage_attribution --home PATH.
+
+Matching logged fields and failed calls are investigation signals, never proof of waste.
+"""
+import argparse
+from collections import Counter, defaultdict
+import json
+import math
+from pathlib import Path
+import re
+import time
+
+_REASONS={'initial','revision','reopened','review_reopened','review_handoff','quota_retry','recovery','unknown'}
+
+
+def mapping(value):
+    return value if isinstance(value,dict) else {}
+
+
+def number(value):
+    return isinstance(value,(int,float)) and not isinstance(value,bool) and math.isfinite(value) and value>=0
+
+
+def digest(value):
+    value=mapping(value)
+    text=value.get('hash')
+    return text if value.get('complete') is True and isinstance(text,str) and re.fullmatch('[0-9a-f]{64}',text) else None
+
+
+def normalize(raw,start,end):
+    raw=mapping(raw);fp=mapping(raw.get('fingerprint'));cross=mapping(fp.get('cross_bot'));fields=mapping(cross.get('fields'))
+    stamp=cross.get('started_at_ns');pid=raw.get('process_id');namespace=cross.get('namespace')
+    if not number(stamp) or not number(pid) or not isinstance(namespace,str) or not re.fullmatch('[0-9a-f]{16}',namespace):return None
+    at=stamp/1e9
+    profile,request=digest(fields.get('profile')),digest(fields.get('request'))
+    if not start<=at<end or not profile or not request:return None
+    values=tuple(digest(fp.get(k)) for k in ('session','route','instructions','tools','options','history'))
+    key=fp.get('key_id');key=key if isinstance(key,str) and re.fullmatch('[0-9a-f]{16}',key) else None
+    signature=(namespace,profile,key,*values) if all(values) and isinstance(key,str) and re.fullmatch('[0-9a-f]{16}',key) else None
+    usage=mapping(raw.get('usage'));total=usage.get('input_tokens');cached=usage.get('cached_tokens')
+    total=total if type(total) is int and total>=0 else None
+    cached=cached if type(cached) is int and total is not None and 0<=cached<=total else None
+    status=raw.get('status') if raw.get('status') in ('returned','failed_or_interrupted') else 'unknown'
+    return {'identity':(namespace,profile,pid,stamp,request),'signature':signature,'at':at,'pid':pid,'status':status,'input':total,'cached':cached,'binding':digest(fp.get('task_run')),'key_id':key,'has_binding': 'task_run' in fp}
+
+
+def correlate(records,runs,end):
+    by_pid=defaultdict(list);by_binding=defaultdict(list)
+    for run in runs:
+        if number(run.get('worker_pid')):by_pid[run['worker_pid']].append(run)
+        for binding in run.get('bindings',[]):by_binding[binding].append(run)
+    reasons={};outcomes={};matched=0;ambiguous=0;completed={};exact=0;legacy=0
+    for record in records:
+        if record['has_binding']:
+            candidates=[r for r in by_binding[(record['key_id'],record['binding'])] if _run_contains(r,record['at'],end)] if record['binding'] else []
+        else:
+            candidates=[r for r in by_pid[record['pid']] if _contains(r,record['at'],end)]
+        if len(candidates)!=1:
+            ambiguous+=len(candidates)>1
+            continue
+        run=candidates[0];matched+=1;exact+=record['has_binding'];legacy+=not record['has_binding']
