+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { act, cleanup, fireEvent, render, waitFor } from '@testing-library/react'
+import { atom, type WritableAtom } from 'nanostores'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+import { I18nProvider } from '@/i18n'
+const request = vi.hoisted(() => vi.fn(async (..._args: unknown[]) => ({ accounts: [] })))
+vi.mock('@/store/gateway', () => ({ requestGatewayForAgent: (...args: unknown[]) => request(...args) }))
+vi.mock('@/store/connections', () => ({ $activeConnectionId: atom('local') }))
+vi.mock('@/store/profile', () => ({
+  $activeGatewayProfile: atom('captain'), $profiles: atom([]),
+  normalizeProfileKey: (p: string | null) => p || 'default'
+}))
+import { $activeConnectionId } from '@/store/connections'
+import { $activeGatewayProfile } from '@/store/profile'
+import { AccountUsageStatusbar } from './account-usage-statusbar'
+
+const connection = $activeConnectionId as WritableAtom<string | null>
+
+beforeEach(() => {
+  request.mockClear()
+  connection.set('local')
+  $activeGatewayProfile.set('captain')
+  Element.prototype.scrollIntoView = vi.fn()
+})
+afterEach(cleanup)
+
+function mount() {
+  return render(
+    <QueryClientProvider client={new QueryClient()}>
+      <I18nProvider configClient={null} initialLocale="en">
+        <footer>
+          <AccountUsageStatusbar />
+        </footer>
+      </I18nProvider>
+    </QueryClientProvider>
+  )
+}
+
+it('opens the quota viewer from the bottom bar, loads cached shared accounts, and refreshes only explicitly', async () => {
+  const f = mount()
+  expect(request).not.toHaveBeenCalled()
+  await act(async () => fireEvent.click(f.getByRole('button', { name: 'Account usage' })))
+  await waitFor(() => expect(request).toHaveBeenCalledTimes(1))
+  expect(request.mock.calls[0]?.slice(0, 4)).toEqual([
+    'local',
+    'default',
+    'account.usage',
+    { profile: 'default', refresh: false }
+  ])
+  expect(f.getByRole('region', { name: 'Provider not reported' })).toBeTruthy()
+  await waitFor(() => expect(f.getByRole('button', { name: 'Refresh' }).hasAttribute('disabled')).toBe(false))
+  await act(async () => fireEvent.click(f.getByRole('button', { name: 'Refresh' })))
+  expect(request.mock.calls[1]?.[3]).toEqual({ profile: 'default', refresh: true })
+})
+
+
+it.each(['profile', 'device'] as const)('resets the selected profile when the active %s changes', async change => {
+  const f = mount()
+  await act(async () => fireEvent.click(f.getByRole('button', { name: 'Account usage' })))
+  await f.findByRole('region', { name: 'Provider not reported' })
+
+  const picker = () => f.getByRole('combobox', { name: 'Applies to' })
+  fireEvent.keyDown(picker(), { key: 'Enter' })
+  fireEvent.keyDown(await f.findByRole('option', { name: 'captain' }), { key: 'Enter' })
+  await waitFor(() => expect(request.mock.calls.at(-1)?.slice(0, 2)).toEqual(['local', 'captain']))
+  expect(picker().textContent).toBe('captain')
+
+  request.mockClear()
+  act(() => {
+    if (change === 'profile') $activeGatewayProfile.set('writer')
+    else connection.set('second')
+  })
+  const nextConnection = change === 'profile' ? 'local' : 'second'
+  expect(picker().textContent).toBe('default')
+  await waitFor(() => expect(request.mock.calls.at(-1)?.slice(0, 4)).toEqual([
+    nextConnection, 'default', 'account.usage', { profile: 'default', refresh: false }
+  ]))
+  await waitFor(() => expect(f.getByRole('button', { name: 'Refresh' }).getAttribute('aria-disabled')).toBe('false'))
+  await act(async () => fireEvent.click(f.getByRole('button', { name: 'Refresh' })))
+  expect(request.mock.calls.at(-1)?.slice(0, 4)).toEqual([
+    nextConnection, 'default', 'account.usage', { profile: 'default', refresh: true }
+  ])
+  expect(request.mock.calls.every(([, profile]) => profile === 'default')).toBe(true)
+
+  act(() => {
+    connection.set('local')
+    $activeGatewayProfile.set('captain')
+  })
+  expect(picker().textContent).toBe('default')
+})
