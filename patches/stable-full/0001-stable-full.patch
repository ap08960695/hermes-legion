diff --git a/tests/agent/test_auxiliary_async_retry_budget.py b/tests/agent/test_auxiliary_async_retry_budget.py
new file mode 100644
index 0000000000000000000000000000000000000000..db4ebe7b2ee116099a7645f56866f1731bb08ef2
--- /dev/null
+++ b/tests/agent/test_auxiliary_async_retry_budget.py
@@ -0,0 +1,108 @@
+"""Async auxiliary requests respect zero retry budget and main-owned clients."""
+import asyncio
+import json
+
+import httpx
+import pytest
+from openai import AsyncOpenAI, APIStatusError
+
+import agent.auxiliary_client as aux
+
+
+async def _exercise(monkeypatch, budget, statuses, *, main_bound=False):
+    requests = []
+    recovery_errors = []
+
+    def respond(request):
+        assert request.method == "POST"
+        assert request.url == "https://aux-fixture.invalid/v1/chat/completions"
+        body = json.loads(request.content)
+        assert body["model"] == "synthetic-aux"
+        requests.append(request.url.path)
+        status = statuses[min(len(requests) - 1, len(statuses) - 1)]
+        if status != 200:
+            return httpx.Response(status, json={"error": {"message": "synthetic failure", "type": "fixture"}})
+        return httpx.Response(200, json={
+            "id": "synthetic", "object": "chat.completion", "created": 0,
+            "model": "synthetic-aux", "choices": [{"index": 0,
+                "message": {"role": "assistant", "content": "ok"}, "finish_reason": "stop"}],
+            "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2},
+        })
+
+    def no_recovery(error, *args, **kwargs):
+        recovery_errors.append(error)
+        yield from ()
+        raise error
+
+    async def send(_client, request, *args, **kwargs):
+        # Relay may construct a protected SDK client. Intercept the HTTP boundary
+        # for that client too, rather than leaving its transport on real DNS.
+        response = respond(request)
+        response.request = request
+        return response
+
+    monkeypatch.setattr(httpx.AsyncClient, "send", send)
+    monkeypatch.setattr("hermes_cli.config.load_config", lambda: {"auxiliary": {"transient_retries": budget}})
+    monkeypatch.setattr(aux, "_start_recovery_ladder", no_recovery)
+    async with httpx.AsyncClient() as http:
+        async with AsyncOpenAI(api_key="synthetic", base_url="https://aux-fixture.invalid/v1",
+                               max_retries=0, http_client=http) as client:
+            client._main_compression_context_bound = main_bound
+            # Only client acquisition is replaced; real native preparation, retry
+            # admission, relay and SDK serialization exercise the transport above.
+            monkeypatch.setattr(aux, "resolve_vision_provider_client",
+                                lambda **kwargs: ("custom", client, "synthetic-aux"))
+            response = error = None
+            try:
+                response = await aux.async_call_llm(
+                    task="vision", provider="custom", model="synthetic-aux",
+                    base_url="https://aux-fixture.invalid/v1", api_key="synthetic",
+                    messages=[{"role": "user", "content": "synthetic"}], timeout=1,
+                )
+            except APIStatusError as exc:
+                error = exc
+            assert not http.is_closed, "Retry refusal must not close a borrowed transport"
+    return requests, response, error, recovery_errors
+
+
+@pytest.mark.parametrize("budget", [0, -1])
+def test_disabled_async_retry_sends_one_request_and_preserves_error(monkeypatch, budget):
+    requests, response, error, recovered = asyncio.run(_exercise(monkeypatch, budget, [503]))
+    assert len(requests) == 1
+    assert response is None and error.status_code == 503
+    assert recovered == [error]
+
+
+def test_disabled_async_retry_does_not_spend_a_successful_second_attempt(monkeypatch):
