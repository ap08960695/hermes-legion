+"""Cross-profile cache summaries are private, conservative and opt-in."""
+from copy import deepcopy
+import json
+
+
+def event(profile, request, at=100, *, account='2', status='returned', cached=80):
+    def field(c):
+        return {'complete': True, 'hash': c * 64}
+    fields = {name: field(c) for name, c in {
+        'profile': profile, 'request': request, 'route': '1', 'declared_account': account,
+        'cache_key': '3', 'common_prefix': '4', 'tools': '5', 'options': '6'}.items()}
+    return {'version': 1, 'status': status, 'usage': {'input_tokens': 100, 'cached_tokens': cached},
+            'prompt': 'PRIVATE_SENTINEL', 'fingerprint': {'cross_bot': {'version': 1,
+              'scope': 'same_installation', 'namespace': 'a' * 16, 'account_evidence': 'declared_headers',
+              'started_at_ns': int(at * 1e9), 'fields': fields}}}
+
+
+def test_groups_multiple_profiles_without_exposing_fingerprints():
+    from hermes_cli.usage_cross_profile import summarize
+    rows = [event('a', '1'), event('a', '2'), event('b', '3'), event('b', '4')]
+    result = summarize(rows + [deepcopy(rows[0])], 90, 110)
+    assert result['comparable_groups'] == 1
+    assert result['known_calls_in_comparable_groups'] == 4
+    assert result['groups_with_positive_cached_calls_in_multiple_profiles'] == 1
+    assert result['input_tokens_in_comparable_groups'] == 400
+    assert result['cached_tokens_in_comparable_groups'] == 320
+    assert result['identical_log_copies'] == 1
+    assert result['returned_requests_with_known_usage'] == 4
+    assert result['eligible_requests_with_complete_declared_fields'] == 4
+    assert result['provider_cache_origin_proven'] is False
+    encoded = json.dumps(result)
+    assert 'PRIVATE_SENTINEL' not in encoded and 'a' * 64 not in encoded
+
+
+def test_mismatched_accounts_incomplete_fields_and_failed_calls_cannot_form_group():
+    from hermes_cli.usage_cross_profile import summarize
+    rows = [event('a', '1'), event('a', '2'), event('b', '3', account='9'), event('b', '4', account='9')]
+    assert summarize(rows, 90, 110)['comparable_groups'] == 0
+    rows[2] = event('b', '3'); rows[3] = event('b', '4')
+    rows[2]['fingerprint']['cross_bot']['fields']['tools']['complete'] = False
+    rows[3]['status'] = 'failed_or_interrupted'
+    assert summarize(rows, 90, 110)['comparable_groups'] == 0
+    rows[2] = event('b', '3'); rows[3] = event('b', '4')
+    rows[2]['fingerprint']['cross_bot']['account_evidence'] = 'unknown'
+    rows[3]['usage']['cached_tokens'] = None
+    assert summarize(rows, 90, 110)['comparable_groups'] == 0
+
+
+def test_conflicting_copies_and_outside_window_are_excluded():
+    from hermes_cli.usage_cross_profile import summarize
+    a, b, c, d = event('a', '1'), event('a', '2'), event('b', '3'), event('b', '4')
+    conflict = deepcopy(a); conflict['usage']['cached_tokens'] = 20
+    result = summarize([a, b, c, d, conflict, event('a', '7', at=999)], 90, 110)
+    assert result['conflicting_request_identities'] == 1
+    assert result['comparable_groups'] == 0
+
+
+def test_cli_option_adds_summary_only_when_requested(tmp_path, monkeypatch, capsys):
+    import sys
+    from hermes_cli import usage_attribution
+    home = tmp_path / 'home'; (home / 'logs').mkdir(parents=True)
+    rows = [event('a', '1'), event('a', '2'), event('b', '3'), event('b', '4')]
+    log = home / 'logs' / 'agent.log'
+    log.write_text(''.join('CACHE_DIAGNOSTIC ' + json.dumps(row) + '\n' for row in rows))
+    before = log.read_bytes()
+    monkeypatch.setattr(usage_attribution.time, 'time', lambda: 110)
+    monkeypatch.setattr(sys, 'argv', ['usage_attribution', '--home', str(home), '--hours', '0.01', '--cross-profile'])
+    usage_attribution.main(); result = json.loads(capsys.readouterr().out)
+    assert result['cross_profile']['comparable_groups'] == 1
+    assert result['model_calls'] == 0 and log.read_bytes() == before
+    assert 'PRIVATE_SENTINEL' not in json.dumps(result)
+    monkeypatch.setattr(sys, 'argv', ['usage_attribution', '--home', str(home), '--hours', '0.01'])
+    usage_attribution.main(); assert 'cross_profile' not in json.loads(capsys.readouterr().out)
+
+
+def test_mismatched_prepared_fields_and_namespaces_do_not_mix():
+    from hermes_cli.usage_cross_profile import summarize
+    for name in ('route', 'cache_key', 'common_prefix', 'tools', 'options'):
+        rows = [event('a', '1'), event('a', '2'), event('b', '3'), event('b', '4')]
+        for row in rows[2:]:
+            row['fingerprint']['cross_bot']['fields'][name]['hash'] = 'e' * 64
+        assert summarize(rows, 90, 110)['comparable_groups'] == 0, name
+    rows = [event('a', '1'), event('a', '2'), event('b', '3'), event('b', '4')]
+    for row in rows[2:]:
+        row['fingerprint']['cross_bot']['namespace'] = 'f' * 16
+    assert summarize(rows, 90, 110)['comparable_groups'] == 0
+
+
+def test_invalid_schema_and_ambiguous_usage_are_not_promoted():
+    from hermes_cli.usage_cross_profile import summarize
+    rows = [event('a', '1'), event('a', '2'), event('b', '3'), event('b', '4')]
+    rows[2]['fingerprint']['cross_bot']['version'] = True
+    assert summarize(rows, 90, 110)['comparable_groups'] == 0
+    rows[2] = event('b', '3'); rows[3]['usage']['cached_tokens'] = 101
+    assert summarize(rows, 90, 110)['comparable_groups'] == 0
+    with_bool = deepcopy(rows[3]); with_bool['usage']['cached_tokens'] = True
+    assert summarize([rows[0], rows[1], event('b', '3'), with_bool], 90, 110)['comparable_groups'] == 0
