+def test_global_timeout_preserves_caller_writer_transaction(stores, monkeypatch):
+    import threading
+    import hermes_state_search
+    writer, _reader, _mid = stores
+    original = hermes_state_search._GlobalRecallSearch._prepare
+    def slow(self):
+        threading.Event().wait(0.06)
+        return original(self)
+    with monkeypatch.context() as patch:
+        patch.setattr(writer, '_wal_active', False)
+        writer._conn.execute('BEGIN')
+        try:
+            added = writer._conn.execute(
+                "INSERT INTO messages(session_id,role,content,timestamp) VALUES('example','user','完成率',123)"
+            ).lastrowid
+            patch.setattr(hermes_state_search, '_GLOBAL_SEARCH_TIMEOUT_S', 0.02)
+            patch.setattr(hermes_state_search._GlobalRecallSearch, '_prepare', slow)
+            with pytest.raises(TimeoutError):
+                writer.search_messages('完成率')
