+"""Boolean argument matches should not tokenize unrelated suffixes forever."""
+
+import json
+import sqlite3
+
+import pytest
+
+import hermes_state_global_recall as recall
+from hermes_state_stream_recall import UnsupportedJSON
+
+
+@pytest.fixture
+def conn():
+    with sqlite3.connect(":memory:") as db:
+        db.execute("CREATE TABLE messages(id INTEGER PRIMARY KEY, tool_calls TEXT)")
+        yield db
+
+
+@pytest.mark.parametrize("needle, route", [("fixture_command", "decoded"), ("ความจำ", "decoded"),
+                                          ("fixture_command", "native")])
+def test_early_argument_match_keeps_matching_work_bounded(conn, monkeypatch, needle, route):
+    calls = [{"function": {"name": needle, "arguments": json.dumps({"payload": "unrelated " * 50_000})}}]
+    conn.execute("INSERT INTO messages VALUES(1, ?)", (json.dumps(calls, ensure_ascii=False),))
+    work = {"token_characters": 0, "literal_characters": 0}
+    classify = recall._Unicode61.classify
+    fragments = recall._decoded_unicode_escapes
+
+    def observe_character(self, char):
+        work["token_characters"] += 1
+        if work["token_characters"] > 4096:
+            raise TimeoutError("synthetic tokenizer work budget exhausted")
+        return classify(self, char)
+
+    class ObservedText(str):
+        def __radd__(self, other):
+            return ObservedText(str(other) + str(self))
+
+        def translate(self, table):
+            work["literal_characters"] += len(self)
+            if work["literal_characters"] > 4096:
+                raise TimeoutError("synthetic literal work budget exhausted")
+            return super().translate(table)
+
+    def observe_fragments(chunks):
+        for text in fragments(chunks):
+            yield ObservedText(text)
+
+    monkeypatch.setattr(recall._Unicode61, "classify", observe_character)
+    monkeypatch.setattr(recall, "_decoded_unicode_escapes", observe_fragments)
+    search = recall.GlobalSearch(conn, [(needle, False)])
+    try:
+        matched = search.tool_contains(1, needle) if route == "decoded" else search.native_field_contains(
+            1, "tool_calls", needle)
+        assert matched == 1
+        assert max(work.values()) <= 4096
+    finally:
+        search.close()
+
+
+@pytest.mark.parametrize("suffix", [b',"tail":"\xff"}', b',"tail":}'])
+def test_positive_head_still_validates_the_entire_argument_suffix(conn, suffix):
+    raw = b'{"name":"fixture_command"' + suffix
+    conn.execute("INSERT INTO messages VALUES(1, CAST(? AS TEXT))", (raw,))
+    search = recall.GlobalSearch(conn, [("fixture_command", False)])
+    try:
+        with pytest.raises(UnsupportedJSON):
+            search.tool_contains(1, "fixture_command")
+    finally:
+        search.close()
+
+
+@pytest.mark.parametrize("term, prefix, expected", [("run", False, 0), ("run", True, 1),
+                                                   ("lateword", False, 1), ("absent", False, 0)])
+def test_absent_late_and_prefix_matches_remain_exact(conn, term, prefix, expected):
+    raw = json.dumps({"head": "runway", "body": "unrelated " * 1000, "tail": "lateword"})
+    conn.execute("INSERT INTO messages VALUES(1, ?)", (raw,))
+    search = recall.GlobalSearch(conn, [(term, prefix)])
+    try:
+        assert search.tool_contains(1, term, prefix) == expected
+    finally:
+        search.close()
+
+
+def test_early_match_preserves_full_unicode_lengths_and_binary_suffix(conn):
+    text = "needle " + "unrelated " * 5000 + "ไทย\x00\ud800"
+    conn.execute("ALTER TABLE messages ADD COLUMN content TEXT")
+    conn.execute("INSERT INTO messages(id, content) VALUES(1, ?)", (
+        "\x00json:" + json.dumps([{"type": "text", "text": text}]),))
+    search = recall.GlobalSearch(conn, [("needle", False)])
+    try:
+        info = search.info(1)
+        assert info["positions"][("needle", False)] == (0, 0)
+        assert info["chars"] == len(text)
+        assert info["bytes"] == len(text.encode("utf-8", "surrogatepass"))
+        assert info["binary"]
+    finally:
+        search.close()
+
+
+def test_a_positive_term_does_not_hide_other_terms_later_or_absent(conn):
+    conn.execute("INSERT INTO messages VALUES(1, ?)", (json.dumps({
+        "head": "earlyword", "body": "unrelated " * 1000, "tail": "lateword"}),))
+    search = recall.GlobalSearch(conn, [(word, False) for word in ("earlyword", "lateword", "absent")])
+    try:
+        assert search.tool_contains(1, "earlyword") == 1
+        assert search.tool_contains(1, "lateword") == 1
+        assert search.tool_contains(1, "absent") == 0
+    finally:
+        search.close()
