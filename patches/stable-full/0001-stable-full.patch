+  const unbind = $characterSpriteRefresh.listen(refreshCharacter)
+  const gatewayState = vi.spyOn(host.state.gateway, 'get').mockReturnValue('open')
+
+  try {
+    fireEvent.click(screen.getByRole('button', { name: 'Refresh' }))
