+import { bumpBotOpenGeneration } from './shared'
+import type { RosterRow } from './types'
+
+const route = { connectionId: 'local', mode: 'local' as const, profile: 'writer', targetProfile: 'writer' }
+let dispose: () => void
+
+beforeEach(() => {
+  dispose = registerPluginLocales('hermes-bots', BOTS_LOCALES)
+  $openBotChat.set(null)
+  $selectedBot.set('')
+  $selectedRosterKey.set('')
+  $botMeta.set({})
+  $groupChatWorkspace.set(null)
+  vi.spyOn(host, 'request').mockRejectedValue(new Error('Ambient requests forbidden'))
+  vi.spyOn(host, 'ensureAgent').mockRejectedValue(new Error('Source activation forbidden'))
+  vi.spyOn(host, 'newChat').mockImplementation(() => { throw new Error('Draft creation forbidden') })
+  vi.spyOn(host, 'setWorkspaceScope').mockReturnValue(true)
+  vi.spyOn(host, 'focusOpenWorkspaceSession').mockImplementation((_owner, _probe, allowed) =>
+    allowed?.includes('latest-side') ? 'latest-side' : null)
+  vi.spyOn(host, 'openSession').mockResolvedValue(undefined)
+  vi.spyOn(host, 'notify').mockReturnValue('fixture-notification')
+  vi.spyOn(host, 'requestProfile').mockResolvedValue({ sessions: [
+    { id: 'canonical-root', resolved_id: 'fresh-canonical-tip', title: 'Bot Chat', message_count: 4 }
+  ] })
+})
+
+afterEach(() => {
+  cleanup()
+  dispose()
+  bumpBotOpenGeneration()
+  $openBotChat.set(null)
+  $selectedBot.set('')
+  $selectedRosterKey.set('')
+  $botMeta.set({})
+  $groupChatWorkspace.set(null)
+  vi.restoreAllMocks()
+})
+
+function openMonitor(hasCanonical = true, signal?: AbortSignal) {
+  const now = Date.now()
+  const side = { id: 'latest-side', last_active: now / 1000, preview: 'Newer side conversation' }
+
+  const local: RosterRow = { name: 'writer', display_name: 'Writer', connectionId: 'local',
+    connectionKind: 'local', connectionLabel: 'Local fixture', sourceScoped: true, sourceReachable: true, route,
+    description: 'Canonical preview',
+    canonical_session: hasCanonical ? { id: 'canonical-root', resolved_id: 'old-snapshot-tip', preview: 'Canonical preview' } : undefined,
+    last_session: side, worker_sessions: [{ id: 'live-worker', title: 'Current fixture worker', last_active: now / 1000 }] }
+
+  const foreign: RosterRow = { name: 'writer', display_name: 'Writer', connectionId: 'other-fixture',
+    connectionKind: 'remote', connectionLabel: 'Unavailable fixture', sourceScoped: true, sourceReachable: false,
+    canonical_session: { id: 'foreign-canonical', preview: 'Foreign preview' } }
+
+  const rows = [local, foreign].map(bot => ({ bot, name: 'Writer', needsAttention: false, attentionHint: '',
+    source: botSourceStatus(bot), working: botWorkingMood(bot, null, false, 'local', now) !== 'idle' }))
+
+  render(<BotMonitor now={now} onOpen={(bot, waiting) => openRosterBot(bot, waiting, signal)} rows={rows} />)
+
+  return {
+    bot: within(screen.getByText('Canonical preview').closest('tr')!).getByRole('button', { name: 'Open chat · Writer' }),
+    worker: screen.getByRole('button', { name: 'Open chat · Writer · Current fixture worker' }),
+    foreign: within(screen.getByText('Foreign preview').closest('tr')!).getByRole('button', { name: 'Open chat · Writer' })
+  }
+}
+
+it('puts each Open chat action in the first cell so it appears before the metrics', () => {
+  const buttons = openMonitor()
+
+  for (const button of Object.values(buttons)) {
+    expect(button.closest('td')).toBe(button.closest('tr')?.firstElementChild)
+  }
+})
+
+it.each(['bot', 'worker'] as const)('opens the selected owner’s registry tip from the Monitor %s action', async action => {
+  const buttons = openMonitor()
+  expect(host.requestProfile).not.toHaveBeenCalled()
+  expect(host.openSession).not.toHaveBeenCalled()
+  expect((buttons.foreign as HTMLButtonElement).disabled).toBe(true)
+  fireEvent.click(buttons.foreign)
+  expect(host.requestProfile).not.toHaveBeenCalled()
+  fireEvent.click(buttons[action])
+  await waitFor(() => expect(host.openSession).toHaveBeenCalledTimes(1))
+  await waitFor(() => expect($pendingBotOpen.get()).toBeNull())
+  expect(host.requestProfile).toHaveBeenCalledExactlyOnceWith(route, 'session.list', {
+    profile: 'writer', title: 'Bot Chat', include_hidden: true, limit: 200
+  }, undefined, { spawnPriority: 'foreground' })
+  expect(host.openSession).toHaveBeenCalledWith('fresh-canonical-tip', expect.objectContaining({
+    route, profile: 'writer', intent: 'in-place', workspaceMode: 'bots', workspaceOwnerKey: 'bot:local::writer',
+    tabTitle: 'Bot Chat', forceResume: true, awaitHydration: true
+  }))
+  expect($openBotChat.get()).toEqual({ key: 'local::writer', openedRegistryId: 'canonical-root', openedSessionId: 'fresh-canonical-tip' })
+  expect(host.request).not.toHaveBeenCalled()
+  expect(host.ensureAgent).not.toHaveBeenCalled()
+  expect(host.newChat).not.toHaveBeenCalled()
+  expect(host.notify).not.toHaveBeenCalled()
+})
+
+it('keeps the same owner’s action focused and sends one lookup until it settles', async () => {
+  let fail!: (error: Error) => void
+  vi.mocked(host.requestProfile).mockImplementationOnce(async () => new Promise((_, reject) => { fail = reject }))
+
+  const { bot, worker } = openMonitor()
+  bot.focus()
+  fireEvent.click(bot)
+  await waitFor(() => expect(host.requestProfile).toHaveBeenCalledTimes(1))
+
+  fireEvent.click(bot)
+  fireEvent.click(worker)
+  expect(host.requestProfile).toHaveBeenCalledTimes(1)
+  expect(bot.textContent).toBe('Opening chat…')
+  expect(worker.getAttribute('aria-disabled')).toBe('true')
+  expect(bot.ownerDocument.activeElement).toBe(bot)
+
+  fail(new Error('Registry temporarily unavailable'))
+  await waitFor(() => expect(bot.getAttribute('aria-disabled')).toBeNull())
+  expect(bot.ownerDocument.activeElement).toBe(bot)
+  expect(host.openSession).not.toHaveBeenCalled()
+
+  fireEvent.click(bot)
+  await waitFor(() => expect(host.openSession).toHaveBeenCalledTimes(1))
+  expect(host.requestProfile).toHaveBeenCalledTimes(2)
+})
+
+it('lets a newly waiting question supersede a generic lookup and keeps one cold lookup for that question', async () => {
+  const descriptor = Object.getOwnPropertyDescriptor(host.state, 'focusedClarification')!
+  const focused = atom<ReturnType<typeof host.state.focusedClarification.get>>(null)
+  Object.defineProperty(host.state, 'focusedClarification', { configurable: true, value: focused })
+  const finish: (() => void)[] = []
+  vi.mocked(host.requestProfile).mockImplementation(async () => new Promise(resolve => {
+    finish.push(() => resolve({ sessions: [{ id: 'canonical-root', title: 'Bot Chat' }] }))
+  }))
+
+  try {
+    const { bot, worker } = openMonitor()
+    fireEvent.click(worker)
+    await waitFor(() => expect(host.requestProfile).toHaveBeenCalledTimes(1))
+
+    act(() => focused.set({ connectionId: 'local', profile: 'writer', storedSessionId: 'canonical-root', requestId: 'waiting-question' }))
+    expect(bot.getAttribute('aria-disabled')).toBeNull()
+    fireEvent.click(bot)
+    await waitFor(() => expect(host.requestProfile).toHaveBeenCalledTimes(2))
+    fireEvent.click(bot)
+    fireEvent.click(worker)
+    await act(async () => { finish.forEach(resolve => resolve()) })
+
+    expect(host.requestProfile).toHaveBeenCalledTimes(2)
+    expect(host.openSession).toHaveBeenCalledTimes(1)
+    expect($pendingBotOpen.get()).toBeNull()
+  } finally {
+    Object.defineProperty(host.state, 'focusedClarification', descriptor)
+  }
+})
+
+it.each(['found', 'empty', 'failed'] as const)('retires a Local lookup after leaving Monitor (%s)', async result => {
+  const scope = new AbortController()
+  let finish!: () => void
+  vi.mocked(host.requestProfile).mockImplementationOnce(async () => new Promise((resolve, reject) => {
+    finish = () => {
+      if (result === 'failed') {
+        reject(new Error('Registry unavailable'))
+      } else {
+        resolve({ sessions: result === 'empty' ? [] : [{ id: 'late-tip', title: 'Bot Chat' }] })
+      }
+    }
+  }))
+
+  fireEvent.click(openMonitor(result !== 'empty', scope.signal).bot)
+  await waitFor(() => expect(host.requestProfile).toHaveBeenCalledTimes(1))
+  await act(async () => {
+    scope.abort()
+    finish()
+  })
+
+  expect($pendingBotOpen.get()).toBeNull()
+  expect(host.requestProfile).toHaveBeenCalledTimes(1)
+  expect(host.openSession).not.toHaveBeenCalled()
+  expect(host.newChat).not.toHaveBeenCalled()
+  expect(host.notify).not.toHaveBeenCalled()
+})
+
+it('retires an empty creation recheck after leaving Monitor before it can write', async () => {
+  const scope = new AbortController()
+  let finish!: () => void
+  vi.mocked(host.requestProfile).mockResolvedValueOnce({ sessions: [] })
+    .mockImplementationOnce(async () => new Promise(resolve => { finish = () => resolve({ sessions: [] }) }))
+    .mockRejectedValue(new Error('Only registry reads are allowed'))
+
+  fireEvent.click(openMonitor(false, scope.signal).bot)
+  await waitFor(() => expect(host.requestProfile).toHaveBeenCalledTimes(2))
+  await act(async () => {
+    scope.abort()
+    finish()
+  })
+
+  expect(vi.mocked(host.requestProfile).mock.calls.map(([, method]) => method)).toEqual(['session.list', 'session.list'])
+  expect(host.openSession).not.toHaveBeenCalled()
+  expect(host.newChat).not.toHaveBeenCalled()
+  expect(host.notify).not.toHaveBeenCalled()
+})
+
+it('still shows a genuine SDK failure after the Chat handoff unmounts Monitor', async () => {
+  const scope = new AbortController()
+
+  vi.mocked(host.openSession).mockImplementationOnce(async () => {
+    scope.abort()
+    throw new Error('Transcript temporarily unavailable')
+  })
+
+  fireEvent.click(openMonitor(true, scope.signal).bot)
+  await waitFor(() => expect(host.notify).toHaveBeenCalledExactlyOnceWith(expect.objectContaining({
+    title: 'Could not open Writer’s chat', message: 'Try again.', detail: expect.stringContaining('Transcript temporarily unavailable')
+  })))
+})
+
+it.each(['row', 'empty', 'rejected'] as const)('discards an obsolete Local registry reply (%s)', async result => {
+  vi.spyOn(host.state.connectionId, 'get').mockReturnValue('local')
+  vi.spyOn(host.state.gateway, 'get').mockReturnValue('open')
+  const epoch = $localRosterEpoch.get()
+  let finish!: () => void
+  vi.mocked(host.requestProfile).mockImplementationOnce(async () => new Promise((resolve, reject) => {
+    finish = () => {
+      if (result === 'rejected') {
+        reject(new Error('method not found'))
+      } else {
+        resolve({ sessions: result === 'empty' ? [] : [{ id: 'canonical-root', resolved_id: 'old-tip', title: 'Bot Chat' }] })
+      }
+    }
+  }))
+
+  try {
+    fireEvent.click(openMonitor(result !== 'empty').bot)
+    await waitFor(() => expect(host.requestProfile).toHaveBeenCalledTimes(1))
+    $localRosterEpoch.set(epoch + 1)
+    finish()
+
+    await waitFor(() => expect($pendingBotOpen.get()).toBeNull())
+    expect(host.openSession).not.toHaveBeenCalled()
+    expect(host.newChat).not.toHaveBeenCalled()
+    expect(host.requestProfile).toHaveBeenCalledTimes(1)
+    expect(host.notify).toHaveBeenCalledExactlyOnceWith(expect.objectContaining({
+      title: 'Could not open Writer’s chat', message: 'Try again.', detail: expect.stringContaining('Local connection changed')
+    }))
+  } finally {
+    $localRosterEpoch.set(epoch)
+  }
+})
+
+it('reports a failed registry read without opening or creating a conversation', async () => {
+  vi.mocked(host.requestProfile).mockRejectedValue(new Error('Registry unavailable'))
+  fireEvent.click(openMonitor().bot)
+  await waitFor(() => expect(host.notify).toHaveBeenCalledWith(expect.objectContaining({
+    kind: 'error', title: 'Could not open Writer’s chat', message: 'Try again.',
+    detail: expect.stringContaining('Registry unavailable')
+  })))
+  await waitFor(() => expect($pendingBotOpen.get()).toBeNull())
+  expect(host.requestProfile).toHaveBeenCalledTimes(1)
+  expect(vi.mocked(host.requestProfile).mock.calls[0].slice(0, 3)).toEqual([route, 'session.list', {
+    profile: 'writer', title: 'Bot Chat', include_hidden: true, limit: 200
+  }])
+  expect(host.openSession).not.toHaveBeenCalled()
+  expect(host.newChat).not.toHaveBeenCalled()
+  expect(host.request).not.toHaveBeenCalled()
+  expect(host.ensureAgent).not.toHaveBeenCalled()
+  expect($openBotChat.get()).toBeNull()
+})
+
+it.each(['canonical-root', 'old-snapshot-tip'])('fronts only the tab holding the pending question (%s)', async storedSessionId => {
+  const descriptor = Object.getOwnPropertyDescriptor(host.state, 'focusedClarification')!
+  Object.defineProperty(host.state, 'focusedClarification', {
+    configurable: true,
+    value: atom({ connectionId: 'local', profile: 'writer', storedSessionId, requestId: 'waiting-question' })
+  })
+
+  try {
+    vi.mocked(host.focusOpenWorkspaceSession).mockImplementation((_owner, _probe, allowed) =>
+      allowed?.length === 1 ? allowed[0] : allowed?.find(id => id !== storedSessionId) ?? null)
+
+    const { bot } = openMonitor()
+    expect(within(bot.closest('tr')!).getByText('Waiting for your answer…')).toBeTruthy()
+    fireEvent.click(screen.getByRole('button', { name: 'Needs attention' }))
+    fireEvent.click(bot)
+
+    expect(host.focusOpenWorkspaceSession).toHaveBeenCalledExactlyOnceWith('bot:local::writer', expect.any(Function), [storedSessionId])
+    expect($openBotChat.get()).toEqual({ key: 'local::writer', openedRegistryId: 'canonical-root', openedSessionId: storedSessionId })
+    expect(host.requestProfile).not.toHaveBeenCalled()
+    expect(host.openSession).not.toHaveBeenCalled()
+  } finally {
+    Object.defineProperty(host.state, 'focusedClarification', descriptor)
+  }
+})
