+"""scope="fleet" searches every profile of the caller's own home, read-only, labelled by profile."""
+
+import json
+from types import SimpleNamespace
+
+from agent.inline_tool_executors import INLINE_TOOL_EXECUTORS, InlineToolContext
+
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+from hermes_state import SessionDB
+from tools.session_search_tool import session_search
+
+
+def test_fleet_scope_searches_own_fleet_profiles_and_skips_broken_stores(tmp_path, monkeypatch):
+    roots = [tmp_path / "fleet-a", tmp_path / "fleet-b"]
+    dbs = []
+    for root in roots:
+        (root / "profiles").mkdir(parents=True)
+        (root / "config.yaml").write_text("model: {}\n", encoding="utf-8")
+        for name in ("worker", "broken", "empty"):
+            (root / "profiles" / name).mkdir()
+            (root / "profiles" / name / "config.yaml").write_text("model: {}\n", encoding="utf-8")
+        for profile, home in (("default", root), ("worker", root / "profiles/worker")):
+            db = SessionDB(home / "state.db")
+            db.create_session(f"s_{profile}", source="cli")
+            db.append_message(f"s_{profile}", role="user", content=f"zebrafix {root.name} {profile}")
+            dbs.append(db)
+        (root / "profiles/broken/state.db").write_bytes(b"not a sqlite database" * 100)
+
+    monkeypatch.setenv("HERMES_HOME", str(roots[0]))
+    token = set_hermes_home_override(roots[1] / "profiles/worker")
+    try:
+        result = json.loads(session_search(query="zebrafix", limit=10, scope="fleet"))
+        # The caller's own live session stays excluded even without a db handle.
+        no_db = json.loads(session_search(query="zebrafix", limit=10, scope="fleet", current_session_id="s_worker"))
+        # The agent's real path (inline executor) must forward scope.
+        agent = SimpleNamespace(_get_session_db_for_recall=lambda: dbs[3], session_id="live")
+        inline = json.loads(INLINE_TOOL_EXECUTORS["session_search"](
+            agent, {"query": "zebrafix", "limit": 10, "scope": "fleet"}, InlineToolContext("t", "c")))
+        before = (roots[1] / "profiles/worker/state.db").read_bytes()
+        assert json.loads(session_search(query="zebrafix", limit=10))["count"] == 1  # default unchanged
+        assert (roots[1] / "profiles/worker/state.db").read_bytes() == before
+    finally:
+        reset_hermes_home_override(token)
+        for db in dbs:
+            db.close()
+
+    assert result["success"] is True and result["scope"] == "fleet"
+    hits = {(r["profile"], r["link"]) for r in result["results"]}
+    assert hits == {("default", "@session:default/s_default"), ("worker", "@session:worker/s_worker")}
+    assert [r["link"] for r in no_db["results"]] == ["@session:default/s_default"]
+    assert inline["scope"] == "fleet" and {r["link"] for r in inline["results"]} == {r["link"] for r in result["results"]}
+    assert "fleet-a" not in json.dumps(result)  # never another home
+    assert set(result["skipped_profiles"]) == {"broken", "empty"}
+    assert json.loads(session_search(query="x", scope="fleet", profile="worker"))["success"] is False
