+@pytest.mark.parametrize("winner", ["exits", "ready", "ready_during_recheck", "holds"])
+def test_ensure_recovers_lost_launch_admission(tmp_path, monkeypatch, startup_clock, winner):
+    from types import SimpleNamespace
+    from hermes_cli import gateway_launch_admission, gateway_runtime as runtime
+    from hermes_cli import gateway_runtime_service as service, gateway_runtime_start as start
+
+    home = tmp_path / "profile"
+    attempts = []
+    spawned = []
+    owner = runtime.GatewayDiscovery("ready")
+    winner_ready = False
+
+    @contextmanager
+    def admission(target):
+        nonlocal winner_ready
+        attempts.append(target)
+        if len(attempts) == 1 or winner == "holds":
+            yield None
+            winner_ready = winner == "ready"
+            return
+        winner_ready = winner == "ready_during_recheck"
+        yield (3,)
+
+    def discover(target, *, timeout):
+        assert target == home
+        assert timeout == pytest.approx(0.2 - startup_clock())
+        return owner if winner_ready or spawned else runtime.GatewayDiscovery("absent")
+
+    def spawn(target, *, deadline, idle_exit, launch_fds):
+        assert deadline == 0.2
+        assert launch_fds == (3,)
+        spawned.append(target)
+        return SimpleNamespace(poll=lambda: None)
+
+    monkeypatch.setattr(runtime, "discover_gateway_endpoint", discover)
+    monkeypatch.setattr(service, "discover_existing_gateway_service", lambda *a, **k: None)
+    monkeypatch.setattr(gateway_launch_admission, "gateway_launch_admission", admission)
+    monkeypatch.setattr(start, "spawn_unmanaged_gateway", spawn)
+
+    result = runtime.ensure_gateway_runtime(home, timeout=0.2)
+    if winner == "holds":
+        assert (result.state, result.reason_code) == ("starting", "deadline")
+        assert startup_clock() == pytest.approx(0.2)
+        assert len(attempts) > 1 and not spawned
+        return
+    assert result is owner
+    assert 0 < startup_clock() < 0.2
+    assert attempts == ([home] if winner == "ready" else [home, home])
+    assert spawned == ([home] if winner == "exits" else [])
+
