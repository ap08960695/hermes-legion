@@ -0,0 +1,147 @@
+"""An idempotency key must not create duplicate tasks during parallel requests."""
+import multiprocessing
+import sqlite3
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+import threading
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+
+
+@pytest.fixture
+def board(tmp_path, monkeypatch):
+    home = tmp_path / '.hermes'
+    home.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(home))
+    monkeypatch.setenv('HOME', str(tmp_path))
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    for name in ('HERMES_KANBAN_DB', 'HERMES_KANBAN_BOARD'):
+        monkeypatch.delenv(name, raising=False)
+    kb.init_db()
+    return home
+
+
+def _create_in_process(barrier, queue):
+    original = kb._new_task_id
+    first = True
+
+    def synchronized_id():
+        nonlocal first
+        if first:
+            first = False
+            barrier.wait(timeout=10)
+        return original()
+
+    kb._new_task_id = synchronized_id
+    try:
+        with kbc.connect_closing() as conn:
+            tid = kb.create_task(conn, title='parallel process', idempotency_key='process-fixture')
+        queue.put(('ok', tid))
+    except Exception as exc:
+        queue.put(('error', type(exc).__name__))
+
+
+def _race(monkeypatch, keys):
+    barrier = threading.Barrier(len(keys), timeout=10)
+    original = kb._new_task_id
+    local = threading.local()
+
+    def synchronized_id():
+        if not getattr(local, 'started', False):
+            local.started = True
+            barrier.wait()
+        return original()
+
+    monkeypatch.setattr(kb, '_new_task_id', synchronized_id)
+
+    def create(key):
+        with kbc.connect_closing() as conn:
+            return kb.create_task(conn, title='parallel fixture', assignee='worker', idempotency_key=key)
+    with ThreadPoolExecutor(max_workers=len(keys)) as pool:
+        futures = [pool.submit(create, key) for key in keys]
+        return [f.result(timeout=20) for f in futures]
+
+
+def test_same_key_from_parallel_connections_creates_one_task(board, monkeypatch):
+    ids = _race(monkeypatch, ('same-fixture-key', 'same-fixture-key'))
+    assert ids[0] == ids[1]
+    with kbc.connect_closing() as conn:
+        rows = conn.execute("SELECT id FROM tasks WHERE idempotency_key=? AND status!='archived'",
+                            ('same-fixture-key',)).fetchall()
+        assert [row['id'] for row in rows] == [ids[0]]
+        assert conn.execute("SELECT COUNT(*) FROM task_events WHERE task_id=? AND kind='created'",
+                            (ids[0],)).fetchone()[0] == 1
+
+
+def test_same_key_from_separate_processes_creates_one_task(board):
+    context = multiprocessing.get_context('spawn')
+    barrier, queue = context.Barrier(2), context.Queue()
+    children = [context.Process(target=_create_in_process, args=(barrier, queue)) for _ in range(2)]
+    try:
+        for child in children:
+            child.start()
+        for child in children:
+            child.join(timeout=20)
+        assert all(not child.is_alive() and child.exitcode == 0 for child in children)
+        rows = [queue.get(timeout=2) for _ in children]
+        assert all(row[0] == 'ok' for row in rows), rows
+        assert rows[0][1] == rows[1][1]
+        with kbc.connect_closing() as conn:
+            assert conn.execute('SELECT COUNT(*) FROM tasks WHERE idempotency_key=?',
+                                ('process-fixture',)).fetchone()[0] == 1
+    finally:
+        for child in children:
+            if child.is_alive():
+                child.terminate()
+                child.join(timeout=5)
+        queue.close()
+
+
+def test_existing_key_uses_read_only_fast_path(board, monkeypatch):
+    with kbc.connect_closing() as conn:
+        existing = kb.create_task(conn, title='existing', idempotency_key='existing')
+
+    def no_new_id():
+        raise AssertionError('existing key should not allocate a new id')
+
+    monkeypatch.setattr(kb, '_new_task_id', no_new_id)
+    db_path = kb.kanban_db_path()
+    with sqlite3.connect(f'file:{db_path}?mode=ro', uri=True) as conn:
+        conn.row_factory = sqlite3.Row
+        assert kb.create_task(conn, title='repeated', idempotency_key='existing') == existing
+
+
+def test_different_keys_remain_independent_when_parallel(board, monkeypatch):
+    ids = _race(monkeypatch, ('fixture-a', 'fixture-b'))
+    assert len(set(ids)) == 2
+
+
+def test_archived_key_can_be_used_for_new_task(board):
+    with kbc.connect_closing() as conn:
+        old = kb.create_task(conn, title='old fixture', idempotency_key='reusable')
+        assert kb.archive_task(conn, old)
+        new = kb.create_task(conn, title='new fixture', idempotency_key='reusable')
+        assert new != old and kb.get_task(conn, old).status == 'archived'
+
+
+def test_nested_graph_transaction_reuses_the_created_key(board):
+    with kbc.connect_closing() as conn, kb.write_txn(conn):
+        first = kb.create_task(conn, title='first', idempotency_key='nested')
+        second = kb.create_task(conn, title='duplicate', idempotency_key='nested')
+        assert first == second
+    with kbc.connect_closing() as conn:
+        assert conn.execute('SELECT COUNT(*) FROM tasks WHERE idempotency_key=?', ('nested',)).fetchone()[0] == 1
+
+
+def test_rolled_back_creation_does_not_reserve_key(board):
+    with kbc.connect_closing() as conn:
+        with pytest.raises(RuntimeError, match='fixture rollback'):
+            with kb.write_txn(conn):
+                kb.create_task(conn, title='rolled back', idempotency_key='rollback')
+                raise RuntimeError('fixture rollback')
+        new = kb.create_task(conn, title='after rollback', idempotency_key='rollback')
+        assert kb.get_task(conn, new).title == 'after rollback'
+        assert conn.execute('SELECT COUNT(*) FROM tasks WHERE idempotency_key=?', ('rollback',)).fetchone()[0] == 1
