+      {inbox.status === 'unavailable' && <div className="space-y-2 text-sm">
+        <p role="status">{inbox.retrying ? t.loading : unavailableStatus}</p>
+        {inbox.connected && <Button aria-disabled={inbox.retrying || undefined} className="aria-disabled:opacity-60"
+          onClick={inbox.retry} ref={retryButton} size="sm" variant="secondary">{t.retry}</Button>}
+      </div>}
+      {inbox.status === 'ready' && inbox.items.length === 0 && <p className="text-sm">{t.empty}</p>}
+      <p className={status ? "text-sm" : "sr-only"} role="status">{status}</p>
+      <ul className="grid min-h-0 gap-3 overflow-y-auto" ref={list}>
+        {inbox.items.map(prompt => <OwnerPromptRow
+          bot={bots.find(bot => bot.profile === prompt.profile)?.label || prompt.profile} drafts={drafts}
+          isRespondingNow={() => inbox.isRespondingNow(prompt)} key={ownerPromptKey(prompt)} onOpen={action => void openChat(prompt, action)} openFailed={openErrorKey === ownerPromptKey(prompt)}
+          onOpenCard={kanbanAvailable && connection === 'local' && prompt.card_board && prompt.card &&
+            isKanbanCardTarget(prompt.card_board, prompt.card) ? () => openCard(prompt) : undefined}
+          onRespond={value => respond(prompt, value)} openingChat={openingChat}
+          openingStatus={openingRowKey === ownerPromptKey(prompt) ? text.bot.openingChat : ''}
+          pending={inbox.isResponding(prompt)} prompt={prompt} stale={inbox.status !== 'ready'} text={text} />)}
