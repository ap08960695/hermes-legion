+import pytest
+from hermes_cli.kanban_dispatch_lane import call_spawn
+
+
+@pytest.mark.parametrize('error', [TypeError, ValueError])
+def test_spawn_body_failure_never_reinvokes(error):
+    calls = []
+    def spawn(task, workspace, *, board=None):
+        calls.append(board)
+        raise error('could have started a process already')
+    with pytest.raises(error):
+        call_spawn(spawn, object(), '/tmp/fixture', 'board')
+    assert calls == ['board']
+
+
+def test_legacy_signature_invoked_once():
+    calls = []
+    def spawn(task, workspace):
+        calls.append(workspace)
+        return 123
+    assert call_spawn(spawn, object(), '/tmp/fixture', None) == 123
+    assert calls == ['/tmp/fixture']
