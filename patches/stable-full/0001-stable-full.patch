+def test_compression_child_gate_flushes_counts_and_propagates_read_failure(db, monkeypatch):
+    _compression_parent(db)
+    db.create_session("child", source="cli", parent_session_id="parent")
+    child = db.get_session("child")
+    # No token writer starts, so this lookup must persist the pending delta itself.
+    db._token_queue.append(("parent", {"input_tokens": 17, "api_call_count": 1}))
+    assert db._conn.execute("SELECT input_tokens FROM sessions WHERE id='parent'").fetchone()[0] == 0
+    assert db._is_compression_child_row(child) is True
+    assert tuple(db._conn.execute(
+        "SELECT input_tokens, api_call_count FROM sessions WHERE id='parent'",
+    ).fetchone()) == (17, 1)
