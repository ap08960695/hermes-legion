diff --git a/tests/hermes_cli/test_goal_judge_memo.py b/tests/hermes_cli/test_goal_judge_memo.py
new file mode 100644
index 0000000000000000000000000000000000000000..d0b72d85c4b578481ae4b26db387b4fff06c6591
--- /dev/null
+++ b/tests/hermes_cli/test_goal_judge_memo.py
@@ -0,0 +1,121 @@
+"""An identical goal-judge input reuses the stored verdict instead of a second auxiliary call."""
+import json
+import copy
+
+import pytest
+
+from hermes_cli import goals
+
+
+@pytest.fixture
+def judge_calls(monkeypatch):
+    calls = []
+
+    def fake(call_llm, system_prompt, user_prompt, timeout):
+        calls.append(user_prompt)
+        return json.dumps(replies.pop(0))
+
+    replies = []
+    monkeypatch.setattr(goals, "_call_goal_judge_llm", fake)
+    return calls, replies
+
+
+def test_identical_turn_is_judged_once(judge_calls):
+    calls, replies = judge_calls
+    replies += [{"verdict": "continue", "reason": "not yet"}]
+    first = goals.judge_goal("ship the report", "still working on it")
+    second = goals.judge_goal("ship the report", "still working on it")
+    assert len(calls) == 1
+    assert first[:2] == second[:2] == ("continue", "not yet")
+
+
+def test_changed_response_is_judged_again(judge_calls):
+    calls, replies = judge_calls
+    replies += [{"verdict": "continue", "reason": "not yet"}, {"verdict": "done", "reason": "sent"}]
+    goals.judge_goal("ship the report", "still working on it")
+    assert goals.judge_goal("ship the report", "report sent")[0] == "done"
+    assert len(calls) == 2
+
+
+def test_unusable_reply_is_not_remembered(judge_calls, monkeypatch):
+    calls, _ = judge_calls
+    monkeypatch.setattr(goals, "_call_goal_judge_llm",
+                        lambda *a: (calls.append(a), "not json")[1])
+    goals.judge_goal("ship the report", "still working on it")
+    goals.judge_goal("ship the report", "still working on it")
+    assert len(calls) == 2
+
+
+@pytest.mark.parametrize("style,field", [
+    (style, field)
+    for style in ("plain", "subgoals", "contract")
+    for field in ("goal", "response", "background", "clock-line")
+] + [("subgoals", "criterion"), ("contract", "criterion"), ("contract", "extra")])
+def test_clock_text_in_evidence_is_judged_again(style, field, judge_calls, monkeypatch):
+    clock = "2026-11-14 10:00:00 UTC"
+    monkeypatch.setattr(goals, "safe_strftime", lambda *args: clock)
+    original = {"goal": "verify receipt", "last_response": "receipt checked", "timeout": 1}
+    if style == "subgoals":
+        original["subgoals"] = ["verify the receipt"]
+    elif style == "contract":
+        original["contract"] = goals.GoalContract(verification="verify the receipt")
+    changed = copy.deepcopy(original)
+    for arguments, text in ((original, f"receipt {clock} verified"), (changed, "receipt  verified")):
+        if field == "goal":
+            arguments["goal"] = text
+        elif field == "response":
+            arguments["last_response"] = text
+        elif field == "background":
+            arguments["background_processes"] = [{"pid": 123, "command": "echo synthetic", "output_preview": text}]
+        elif field == "clock-line":
+            timestamp = clock if arguments is original else ""
+            arguments["last_response"] = f"receipt\nCurrent time: {timestamp}\n\nverified"
+        elif field == "criterion" and style == "contract":
+            arguments["contract"].verification = text
+        else:
+            arguments["subgoals"] = [text]
+    calls, replies = judge_calls
+    replies += [{"verdict": "done", "reason": "timestamp evidence present"},
+                {"verdict": "continue", "reason": "timestamp evidence missing"}]
+    assert goals.judge_goal(**original)[:2] == ("done", "timestamp evidence present")
+    assert goals.judge_goal(**changed)[:2] == ("continue", "timestamp evidence missing")
+    assert len(calls) == 2
+    assert calls[0] != calls[1]
+
+
+@pytest.mark.parametrize("style", ["plain", "subgoals", "contract"])
+def test_only_generated_clock_changes_reuse_the_verdict(style, judge_calls, monkeypatch):
+    clocks = ["2026-11-14 10:00:00 UTC", "2026-11-14 10:00:01 UTC", "2026-11-14 10:00:02 UTC"]
+    clock = iter(clocks)
+    monkeypatch.setattr(goals, "safe_strftime", lambda *args: next(clock))
+    goal = f"verify receipt at {clocks[0]}"
+    response = f"receipt\nCurrent time: {clocks[0]}\n\nverified"
+    arguments = {"timeout": 1}
+    fields = {"goal": goal, "response": response, "background_block": "", "current_time": clocks[0]}
+    template = goals.JUDGE_USER_PROMPT_TEMPLATE
+    if style == "subgoals":
+        arguments["subgoals"] = ["verify the receipt"]
+        fields["subgoals_block"] = "- 1. verify the receipt"
+        template = goals.JUDGE_USER_PROMPT_WITH_SUBGOALS_TEMPLATE
+    elif style == "contract":
+        arguments.update(contract=goals.GoalContract(verification="verify the receipt"), subgoals=["retain evidence"])
+        fields["contract_block"] = "- Verification: verify the receipt\n- Extra criterion 1: retain evidence"
+        template = goals.JUDGE_USER_PROMPT_WITH_CONTRACT_TEMPLATE
+    keys = []
+    real_key = goals.judge_memo.key
+
+    def record_key(*args):
+        keys.append(args)
+        return real_key(*args)
+
+    monkeypatch.setattr(goals.judge_memo, "key", record_key)
+    calls, replies = judge_calls
+    replies += [{"verdict": "continue", "reason": "not yet"}] * 2
+    assert goals.judge_goal(goal, response, **arguments)[0] == "continue"
+    assert goals.judge_goal(goal, response, **arguments)[0] == "continue"
+    assert calls == [template.format(**fields)]
+    canonical = template.format(**{**fields, "current_time": ""})
+    assert keys == [(goals.JUDGE_SYSTEM_PROMPT, canonical)] * 2
+    goals.judge_memo.clear()
+    assert goals.judge_goal(goal, response, **arguments)[0] == "continue"
+    assert calls[1] == template.format(**{**fields, "current_time": clocks[2]})
