+import { act, cleanup, render, screen } from '@testing-library/react'
+import { MemoryRouter } from 'react-router'
+import type { WritableAtom } from 'nanostores'
+import { afterEach, expect, it, vi } from 'vitest'
+const io = vi.hoisted(() => ({ choose: vi.fn() }))
+vi.mock('../chat/sidebar/connection-switcher', () => ({
+  ConnectionSwitcher: () => <button onClick={io.choose}>Native device selector</button>
+}))
+vi.mock('./profile-selector', () => ({
+  InlineProfileSelector: () => <button onClick={io.choose}>Named profile selector</button>
+}))
+import { $activeConnectionId, $connectionsRegistry, $pendingConnectionId } from '@/store/connections'
+import { $gatewayState } from '@/store/session'
+import { ScopeControl } from './scope-panel'
+const activeConnection = $activeConnectionId as WritableAtom<string | null>
+afterEach(() => {
+  cleanup()
+  $connectionsRegistry.set(null)
+  activeConnection.set(null)
+  $pendingConnectionId.set(null)
+  $gatewayState.set('idle')
+  vi.clearAllMocks()
+})
+it('shows device, profile and status immediately with no dialog or action', () => {
+  activeConnection.set('local')
+  $gatewayState.set('open')
+  render(
+    <MemoryRouter>
+      <ScopeControl />
+    </MemoryRouter>
+  )
+  expect(screen.getByRole('region', { name: 'Device & profile' })).toBeTruthy()
+  expect(screen.getByText('This device')).toBeTruthy()
+  expect(screen.getByText('Profile for new chats')).toBeTruthy()
+  expect(screen.getByText('Connected')).toBeTruthy()
+  expect(screen.getByRole('button', { name: 'Named profile selector' })).toBeTruthy()
+  expect(screen.queryByRole('dialog')).toBeNull()
+  expect(io.choose).not.toHaveBeenCalled()
