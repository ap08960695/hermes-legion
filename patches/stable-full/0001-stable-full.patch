+def _chat(db, sid='chat', *, parent=None, config=None, named=True, source='local'):
+    db.create_session(sid, source, user_id='uid:desk', chat_id='local-' + sid,
+                      parent_session_id=parent, model_config=config)
+    if named:
+        assert db.set_session_title(sid, 'Bot Chat')
+    db.update_token_counts(sid, input_tokens=7, output_tokens=3, absolute=True)
+
+
+def _report(db, rid, parent='chat', *, state='completed', stamp=2000, task=None, result=None):
+    db._execute_write(lambda conn: conn.execute(
+        'INSERT INTO async_delegations (delegation_id,origin_session,parent_session_id,state,'
+        'dispatched_at,completed_at,updated_at,task_json,result_json) VALUES (?,?,?,?,?,?,?,?,?)',
+        (rid, 'source-not-a-UI-identity', parent, state, 1000, stamp, stamp,
+         json.dumps(task if task is not None else {'goal': rid + ' task'}),
+         json.dumps(result if result is not None else {'summary': rid + ' result'}))))
+
+
+def _rows(db, home):
+    return [_read_bot_sessions(db, 'uid:desk', False)['canonical_session'], srv._canonical_session_row(db, home)]
+
+
+def test_reports_keep_preferred_compression_chain_and_profile_subject_scope(tmp_path):
+    for name in ['alpha', 'beta']:
+        home = tmp_path / name
+        home.mkdir()
+        with SessionDB(db_path=home / 'state.db') as db:
+            _chat(db)
+            db.end_session('chat', 'compression')
+            _chat(db, 'tip', parent='chat', named=False)
+            for sid, config, source in [('branch', {'_branched_from': 'chat'}, 'local'),
+                                         ('reset', {'_reset_from': 'chat'}, 'local'),
+                                         ('delegate', {'_delegate_from': 'chat'}, 'subagent'),
+                                         ('tool', {}, 'tool'), ('side', {}, 'local')]:
+                _chat(db, sid, parent=None if sid == 'side' else 'chat', named=False, config=config, source=source)
+                _report(db, sid + '-foreign', sid, stamp=9000)
+            _report(db, name + '-before', 'chat', stamp=1000)
+            _report(db, name + '-after', 'tip', state='stalled', stamp=3000, result={'error': 'Recorded progress detector stopped task'})
+        with SessionDB(db_path=home / 'state.db', read_only=True) as db:
+            rows = _rows(db, home)
+            for row in rows:
+                assert row['id'] == 'chat' and row['resolved_id'] == 'tip'
+                assert row['input_tokens'] == 7
+                reports = row['delegation_reports']
+                assert [item['delegation_id'] for item in reports] == [name + '-after', name + '-before']
+                assert [item['status'] for item in reports] == ['stalled', 'completed']
+                assert reports[0]['error'] == 'Recorded progress detector stopped task'
+                assert 'source-not-a-UI-identity' not in str(reports)
+                assert 'current_tool' not in row and 'iteration' not in row
+                ProfileCanonicalSession.model_validate(row)
+            assert rows[0]['delegation_reports'] == rows[1]['delegation_reports']
+            assert _read_bot_sessions(db, 'uid:other', False)['canonical_session'] is None
