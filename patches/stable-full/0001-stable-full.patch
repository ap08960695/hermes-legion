+    compacted = db.append_message("target", role="user", content="visibilityneedle compacted")
+    db._conn.execute("UPDATE messages SET active=0, compacted=0 WHERE id=?", (rewound,))
+    db._conn.execute("UPDATE messages SET active=0, compacted=1 WHERE id=?", (compacted,))
+    db._conn.commit()
+    result = _search(db, query="visibilityneedle", session_id="target")
+    assert result["success"] is True
+    assert {row["match_message_id"] for row in result["results"]} == {compacted}
+    assert hidden != compacted
+
+
+def test_scoped_search_respects_sort_limit_and_time_filter(conversations):
