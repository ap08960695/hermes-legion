+"""Read-only global search must verify structured text before returning hits."""
+import shutil
+import sqlite3
+import subprocess
+from pathlib import Path
+import pytest
+from hermes_state import SessionDB
+
+REPO = Path(__file__).resolve().parent.parent.parent
+
+@pytest.fixture
+def stores(tmp_path, monkeypatch):
+    source = REPO / 'native/fts5_cjk/fts5_cjk.c'
+    if not shutil.which('gcc') or not source.exists():
+        pytest.skip('native CJK compiler or source unavailable')
+    so = tmp_path / 'libfts5_cjk.so'
+    subprocess.run(['gcc', '-shared', '-fPIC', '-O2', f'-I{source.parent / "vendor"}', str(source), '-o', str(so)], check=True, capture_output=True)
+    monkeypatch.setenv('HERMES_FTS5_CJK_SO', str(so))
+    writer = SessionDB(tmp_path / 'state.db')
+    writer.create_session('example', source='desktop')
+    mid = writer.append_message('example', role='user', content=[
+        {'type': 'text', 'text': 'Example 完成率 visible words'},
+        {'type': 'image_url', 'image_url': {'url': 'IMAGEONLYMARKER'}}])
+    reader = SessionDB(writer.db_path, read_only=True)
+    yield writer, reader, mid
+    reader.close()
+    writer.close()
+
+def test_readonly_cjk_global_finds_visible_structured_text(stores):
+    writer, reader, mid = stores
+    rows = reader.search_messages('完成率')
+    assert any(row['id'] == mid and '完成' in row['snippet'] for row in rows)
+    assert all('IMAGEONLYMARKER' not in row['snippet'] for row in rows)
+
+def test_readonly_global_does_not_search_image_payload(stores):
+    writer, reader, mid = stores
+    assert reader.search_messages('IMAGEONLYMARKER') == []
+
+
+@pytest.mark.parametrize('caller_transaction', [False, True])
+def test_readonly_search_preserves_caller_progress_handler(stores, caller_transaction):
+    writer, reader, mid = stores
+    calls = []
+    reader._conn.set_progress_handler(lambda: calls.append(1) or 0, 1)
+    if caller_transaction:
+        reader._conn.execute('BEGIN')
+    try:
+        assert any(row['id'] == mid for row in reader.search_messages('完成率'))
+        assert reader._conn.in_transaction is caller_transaction
+        before = len(calls)
+        reader._conn.execute('SELECT sum(id) FROM messages').fetchone()
+        assert len(calls) > before
+    finally:
+        reader._conn.set_progress_handler(None, 0)
+        if reader._conn.in_transaction:
+            reader._conn.rollback()
+
+
+def test_readonly_timeout_keeps_caller_handler_and_does_not_leave_watchdog(stores, monkeypatch):
+    import threading
+    import hermes_state_search
