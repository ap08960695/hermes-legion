+"""Cache reuse must preserve schema freshness, ranking and caller mutation isolation."""
+import json
+from unittest.mock import patch
+import pytest
+from tools import mcp_schema_cache as mc, tool_search_catalog as cat
+
+
+def test_mcp_reuses_manifest_but_not_returned_objects(tmp_path,monkeypatch):
+    path=tmp_path/'manifest.json'
+    monkeypatch.setattr(mc,'_cache_path',lambda:path)
+    mc.write_cache_entry('a','fp',tools=[{'name':'one'}])
+    # Warm once, then no whole-file parse; return objects remain caller-owned.
+    mc.get_cached_entry('a','fp')
+    with patch.object(mc.json,'loads',wraps=json.loads) as loads:
+        first=mc.get_cached_entry('a','fp');first['tools'][0]['name']='mutated'
+        assert mc.get_cached_entry('a','fp')['tools'][0]['name']=='one'
+    assert loads.call_count==0
+    replacement=tmp_path/'new.json'
+    replacement.write_text(json.dumps({'a':{'fingerprint':'fp','tools':[{'name':'new'}]}}))
+    replacement.replace(path)
+    assert mc.get_cached_entry('a','fp')['tools'][0]['name']=='new'
+
+
+@pytest.mark.parametrize('ttl,written',[(float('nan'),1),(float('inf'),1),(1000,float('nan')),(1000,None)])
+def test_corrupt_mcp_ttl_is_not_an_immortal_hit(tmp_path,monkeypatch,ttl,written):
+    path=tmp_path/'manifest.json';monkeypatch.setattr(mc,'_cache_path',lambda:path)
+    path.write_text(json.dumps({'a':{'fingerprint':'fp','ttl_ms':ttl,'written_at':written}}))
+    assert mc.get_cached_entry('a','fp') is None
+
+
+def defs():
+    return [{'type':'function','function':{'name':f'fixture_{i}','description':'find project issue','parameters':{'type':'object','properties':{'id':{'type':'string'}}}}} for i in range(40)]
+
+
+def test_catalog_reuses_text_tokens_with_fresh_schema(monkeypatch):
+    monkeypatch.setattr(cat,'_classify_source',lambda name:('plugin','fixture'))
+    tools=defs();cat.build_catalog(tools)
+    with patch.object(cat,'_tokenize',wraps=cat._tokenize) as tokenize:
+        entries=cat.build_catalog(tools)
+    assert tokenize.call_count==0
+    tools[0]['function']['parameters']['properties']['id']['type']='integer'
+    assert cat.build_catalog(tools)[0].schema['function']['parameters']['properties']['id']['type']=='integer'
+    tools[0]['function']['description']='changed marker'
+    assert cat.build_catalog(tools)[0]._tokens != entries[0]._tokens
+
+
+def test_batch_reuses_corpus_stats(monkeypatch):
