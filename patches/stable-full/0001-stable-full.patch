+import { host, queryClient } from '@hermes/plugin-sdk'
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { cleanup, fireEvent, render, screen, waitFor, within } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+// eslint-disable-next-line no-restricted-imports
+import * as profilesApi from '@/api/profiles'
+// eslint-disable-next-line no-restricted-imports
+import { registerPluginLocales } from '@/i18n/plugin-i18n'
+// eslint-disable-next-line no-restricted-imports
+import * as gateway from '@/store/gateway'
+// eslint-disable-next-line no-restricted-imports
+import { $activeGatewayProfile, $profiles } from '@/store/profile'
+// eslint-disable-next-line no-restricted-imports
+import { $connection, $gatewayState } from '@/store/session'
+
+import { $botAttention, $botMeta, $lastRoster, primeRoster, ROSTER_KEY, useRoster } from './data'
+import { BOTS_LOCALES } from './i18n'
+import { $botManagementOpen } from './management'
+import { $lastSources, usePublishRosterSnapshot } from './roster-pane-lifecycle'
+import { indexAliasRoutes } from './routing'
+import { BotsWorkspace } from './workspace'
+
+// Real SDK, preload, query, routing and Monitor; only native IPC/gateway I/O
+// are substituted. This does not exercise Electron main or a native window.
+const electron = vi.hoisted(() => ({
+  contextBridge: { exposeInMainWorld: vi.fn((name: string, bridge: unknown) => {
+    Object.defineProperty(window, name, { value: bridge, configurable: true, writable: true })
+  }) },
+  ipcRenderer: { invoke: vi.fn(), on: vi.fn(), removeListener: vi.fn(), send: vi.fn(), sendSync: vi.fn(() => ({})) },
+  webFrame: {}, webUtils: {}
+}))
+
+vi.mock('electron', () => electron)
+vi.mock('./avatar', () => ({
+  botAppearance: () => ({}), avatarColor: () => null, BotFace: () => <span aria-hidden="true">Avatar</span>
+}))
