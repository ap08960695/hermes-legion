+def test_live_compression_tip_keeps_owner_flush_and_errors(tmp_path, monkeypatch):
+    """An unpublished child stays with its parent's store, even with colliding ambient IDs."""
+    import sqlite3
+    from types import SimpleNamespace
+
+    home = tmp_path / "ambient"
+    owner_home = tmp_path / "named"
+    home.mkdir()
+    owner_home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    store = SessionStore(home / "sessions", GatewayConfig(multiplex_profiles=True))
+    store._profile_home_cache["named"] = owner_home
+    key = "agent:named:telegram:dm:1"
+    store._entries[key] = SimpleNamespace(session_id="parent", session_key=key)
+    store._loaded = True
+    store._save = lambda: None
+    owner = store._db_for_session_id("parent")
+    ambient = store._db
+    assert owner is not ambient
+    try:
+        for db in (owner, ambient):
+            db.create_session("parent", source="telegram")
+            db.end_session("parent", "compression")
+            db.create_session("tip", source="telegram", parent_session_id="parent")
+        ambient.end_session("tip", "closed-ambient")
+        ambient_rows = ambient._read_all("SELECT * FROM sessions ORDER BY id")
+        assert store._owner_key_for_session_id("tip") is None
+        assert store._live_compression_child("parent") == "tip"
+        store.append_to_transcript("parent", {"role": "assistant", "content": "owner continuation"})
+        assert store._entries[key].session_id == "tip"
+        assert [m["content"] for m in owner.get_messages_as_conversation("tip")] == ["owner continuation"]
+        assert ambient.get_messages_as_conversation("tip") == []
+        assert [tuple(r) for r in ambient._read_all("SELECT * FROM sessions ORDER BY id")] == [
+            tuple(r) for r in ambient_rows]
+        assert not store._dirty_transcripts
+
+        # Hold the unchanged resolver seam so only the liveness read can drain the pending delta.
