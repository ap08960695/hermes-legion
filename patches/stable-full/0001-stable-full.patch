index 0000000000000000000000000000000000000000..6677f514d19e9aae410bff8037bcdcdd275e0b16
--- /dev/null
+++ b/hermes_state_prefix.py
@@ -0,0 +1,25 @@
+"""Transaction-local request-prefix publication for native session compaction."""
+from __future__ import annotations
+
+import json
+
+
+def apply_compaction_prefix(db, conn, session_id: str, snapshot: dict | None) -> None:
+    """Publish provided prompt/pin fields on the transcript's existing write connection.
+
+    Omitted fields retain their stored bytes (seeded gateway compaction must not
+    replace the live tools pin with its reduced detached toolset).
+    """
+    if snapshot is None:
+        return
+    columns, values = [], []
+    if "system_prompt" in snapshot:
+        columns.extend(["system_prompt_hash = ?", "system_prompt = NULL"])
+        values.append(db._store_system_prompt(conn, snapshot["system_prompt"]))
+    if "tool_pin" in snapshot:
+        pin = snapshot["tool_pin"]
+        columns.append("tool_names = ?")
+        values.append(db._store_system_prompt(conn, json.dumps(pin) if pin is not None else None))
+    if columns:
+        conn.execute(f"UPDATE sessions SET {', '.join(columns)} WHERE id = ?", (*values, session_id))
+        db._delete_unreferenced_system_prompts(conn)
diff --git a/hermes_state_recall.py b/hermes_state_recall.py
new file mode 100644
index 0000000000000000000000000000000000000000..6c0b975bbbb0940234b5981301709b8120954e5e
--- /dev/null
+++ b/hermes_state_recall.py
@@ -0,0 +1,305 @@
+"""Bounded, visibility-filtered projections for model-facing session recall."""
+
+from __future__ import annotations
+
+from hermes_state_blob_reader import SQLiteBlobReader
+
+import base64
+import json
+import time
+from contextlib import contextmanager
+from typing import Any, Optional
+
+_VISIBLE = "(active = 1 OR compacted = 1) AND COALESCE(display_kind, '') <> 'hidden'"
+_LIVE_VISIBLE = "active = 1 AND COALESCE(display_kind, '') <> 'hidden'"
+_JSON_PREFIX = "substr(CAST(content AS BLOB), 1, 6) = X'006a736f6e3a'"
+_HAS_NUL = "instr(CAST(content AS BLOB), X'00') > 0"
+_TOOL_CALLS_MAX_BYTES = 512
+_RESPONSE_CONTENT_BUDGET = 16000
+
+
+def tool_argument_search_terms(terms: list[str]) -> list[str]:
+    """Match Unicode written directly or JSON-escaped once/twice in stored tool calls."""
+    variants: list[str] = []
+    for term in terms:
+        variants.append(term)
+        if not term.isascii():
+            escaped = json.dumps(term, ensure_ascii=True)[1:-1]
+            variants.extend((escaped, escaped.replace('\\', '\\\\')))
+    return list(dict.fromkeys(variants))
+
+
+@contextmanager
+def _snapshot(db):
+    """Use one read snapshot without leaving a transaction on a pooled connection."""
+    with db._read_ctx() as conn:
+        started = not conn.in_transaction
+        if started:
+            conn.execute("BEGIN")
+        try:
+            yield conn
+        finally:
+            if started:
+                conn.rollback()
+
+
+def _cap(max_rows: int, requested: int) -> int:
+    return max(1, min(4000, int(requested), _RESPONSE_CONTENT_BUDGET // max(1, max_rows)))
+
+
+def _columns(content_cap: int) -> str:
+    """Select bounded payloads; full original bodies never cross into Python."""
+    cap = max(1, min(4000, int(content_cap)))
+    return f"""id, role, timestamp, active, compacted,
+        substr(tool_name, 1, 256) AS tool_name, substr(tool_call_id, 1, 256) AS tool_call_id,
+        CASE WHEN length(CAST(tool_calls AS BLOB)) <= {_TOOL_CALLS_MAX_BYTES}
+             THEN tool_calls ELSE NULL END AS tool_calls,
+        length(CAST(tool_calls AS BLOB)) AS tool_calls_bytes,
+        CASE WHEN content IS NULL THEN 'none'
+             WHEN {_JSON_PREFIX} THEN 'json'
+             WHEN typeof(content) != 'text' OR {_HAS_NUL} THEN 'base64'
+             ELSE 'text' END AS content_kind,
+        CASE WHEN content IS NULL THEN NULL
+             WHEN {_JSON_PREFIX} AND length(CAST(content AS BLOB)) <= {cap} THEN content
+             WHEN typeof(content) != 'text' OR {_HAS_NUL} THEN NULL
+             ELSE substr(content, 1, {cap}) END AS content,
+        CASE WHEN typeof(content) = 'text' AND NOT ({_HAS_NUL}) THEN length(content) END AS content_chars,
+        length(CAST(content AS BLOB)) AS content_bytes"""
+
+
+def _row(db, raw, content_cap: int) -> dict[str, Any]:
+    row = dict(raw)
+    kind = row.pop("content_kind")
+    chars = row.pop("content_chars")
+    size = row.pop("content_bytes")
+    tool_size = row.pop("tool_calls_bytes")
+    if kind == "json" and row["content"] is not None:
+        row["content"] = db._decode_content(row["content"])
+    elif kind in ("json", "base64") and row["content"] is None:
+        row["content"] = "[Structured or binary content omitted; use message paging.]"
+        row.update(content_truncated=True, content_encoding=kind, original_content_bytes=size)
+    elif kind == "text" and chars is not None and chars > content_cap:
+        row.update(content_truncated=True, original_content_chars=chars)
+    if row.get("tool_calls"):
+        try:
+            row["tool_calls"] = json.loads(row["tool_calls"])
+        except (TypeError, ValueError):
+            row["tool_calls"] = None
+    elif tool_size and tool_size > _TOOL_CALLS_MAX_BYTES:
+        row.update(tool_calls_truncated=True, original_tool_calls_bytes=tool_size)
+    return row
+
+
+def _window(conn, db, session_id: str, message_id: int, window: int, cap: int) -> dict[str, Any]:
+    anchor = conn.execute(
+        f"SELECT 1 FROM messages WHERE session_id = ? AND id = ? AND {_VISIBLE}",
+        (session_id, message_id)).fetchone()
+    if anchor is None:
+        return {"window": [], "messages_before": 0, "messages_after": 0}
+    columns = _columns(cap)
+    before = conn.execute(
+        f"SELECT {columns} FROM messages WHERE session_id = ? AND id <= ? AND {_VISIBLE} "
+        "ORDER BY id DESC LIMIT ?", (session_id, message_id, window + 1)).fetchall()
+    after = conn.execute(
+        f"SELECT {columns} FROM messages WHERE session_id = ? AND id > ? AND {_VISIBLE} "
+        "ORDER BY id ASC LIMIT ?", (session_id, message_id, window)).fetchall()
+    return {"window": [_row(db, row, cap) for row in (*reversed(before), *after)],
+            "messages_before": max(0, len(before) - 1), "messages_after": len(after)}
+
+
+def recall_window(db, session_id: str, message_id: int, window: int = 5) -> dict[str, Any]:
+    window = max(0, min(20, int(window)))
+    cap = _cap(2 * window + 1, 4000)
+    with _snapshot(db) as conn:
+        return _window(conn, db, session_id, message_id, window, cap)
+
+
+def recall_anchored_view(db, session_id: str, message_id: int, window: int = 5, bookend: int = 3,
+                         keep_roles: Optional[tuple[str, ...]] = ("user", "assistant"),
+                         include_window_bookends: bool = False) -> dict[str, Any]:
+    window, bookend = max(0, min(20, int(window))), max(0, min(20, int(bookend)))
+    cap = _cap(2 * window + 1 + 2 * bookend, 4000)
+    empty = {"window": [], "messages_before": 0, "messages_after": 0, "bookend_start": [], "bookend_end": []}
+    with _snapshot(db) as conn:
+        view = _window(conn, db, session_id, message_id, window, cap)
+        rows = view["window"]
+        if not rows:
+            return empty
+        role_clause = "" if keep_roles is None else " AND role IN (" + ",".join("?" for _ in keep_roles) + ")"
+        role_args = [] if keep_roles is None else list(keep_roles)
+        columns = _columns(cap)
+        def book(op, boundary, order):
+            return conn.execute(
+                f"SELECT {columns} FROM messages WHERE session_id = ? AND id {op} ? AND {_VISIBLE}"
+                f"{role_clause} AND length(CAST(content AS BLOB)) > 0 ORDER BY id {order} LIMIT ?",
+                (session_id, boundary, *role_args, bookend)).fetchall()
+        def whole_book(order):
+            return conn.execute(
+                f"SELECT {columns} FROM messages WHERE session_id = ? AND {_VISIBLE}"
+                f"{role_clause} AND length(CAST(content AS BLOB)) > 0 ORDER BY id {order} LIMIT ?",
+                (session_id, *role_args, bookend)).fetchall()
+        if bookend and include_window_bookends:
+            start, end = whole_book("ASC"), list(reversed(whole_book("DESC")))
+        else:
+            start = book("<", rows[0]["id"], "ASC") if bookend else []
+            end = list(reversed(book(">", rows[-1]["id"], "DESC"))) if bookend else []
+        if keep_roles is not None:
+            rows = [row for row in rows if row["id"] == message_id or row.get("role") in keep_roles]
+        return {**view, "window": rows, "bookend_start": [_row(db, row, cap) for row in start],
+                "bookend_end": [_row(db, row, cap) for row in end]}
+
+
+def recall_bookends(db, session_id: str, head: int = 20, tail: int = 10) -> tuple[list[dict], int]:
+    if head < 0 or tail < 0:
+        raise ValueError("message bookend counts must be nonnegative")
+    cap = _cap(head + tail, 2000)
+    with _snapshot(db) as conn:
+        total = int(conn.execute(f"SELECT COUNT(*) FROM messages WHERE session_id = ? AND {_LIVE_VISIBLE}",
+                                 (session_id,)).fetchone()[0])
+        rows = conn.execute(f"""WITH first_ids AS (
+                SELECT id FROM messages WHERE session_id = ? AND {_LIVE_VISIBLE} ORDER BY id LIMIT ?
+            ), last_ids AS (
+                SELECT id FROM messages WHERE session_id = ? AND {_LIVE_VISIBLE} ORDER BY id DESC LIMIT ?
+            ) SELECT {_columns(cap)} FROM messages WHERE session_id = ? AND {_LIVE_VISIBLE}
+                AND id IN (SELECT id FROM first_ids UNION SELECT id FROM last_ids) ORDER BY id""",
+            (session_id, head, session_id, tail, session_id)).fetchall()
+        return [_row(db, row, cap) for row in rows], total
+
+
+def _page_from_connection(conn, session_id: str, message_id: int, offset: int, limit: int,
+                          field: str, deadline: Optional[float] = None,
+                          include_inactive: bool = False) -> Optional[dict[str, Any]]:
+    if field not in ("content", "tool_calls", "text"):
+        raise ValueError("content_field must be content, tool_calls or text")
+    visible = "COALESCE(display_kind, '') <> 'hidden'" if include_inactive else _VISIBLE
+    if field in ("content", "text"):
+        meta = conn.execute(f"""SELECT id, role, active, compacted, substr(tool_name,1,256) AS tool_name,
+            typeof(content) AS storage_type,
+            CASE WHEN typeof(content) = 'text' AND substr(content,1,1) = '' THEN 1 ELSE 0 END AS leading_nul
+            FROM messages WHERE session_id = ? AND id = ? AND {visible}""", (session_id, message_id)).fetchone()
+        if meta is None:
+            return None
+        if meta["leading_nul"]:
+            from hermes_state_stream_recall import InvalidJSON, page, raw_binary_page, raw_json_page, text_spans
+            with SQLiteBlobReader(conn, "content", message_id) as blob:
+                if blob.read(6) == b"\x00json:":
+                    try:
+                        spans = text_spans(blob, deadline)
+                    except InvalidJSON:
+                        paged = raw_binary_page(blob, offset, limit)
+                    else:
+                        paged = (page(blob, spans, offset, limit, deadline) if field == "text"
+                                 else raw_json_page(blob, offset, limit, deadline))
+                    result = {key: meta[key] for key in ("id", "role", "active", "compacted", "tool_name")}
+                    return {**result, **paged}
+        if field == "text":
+            field = "content"
+    column = field  # fixed allowlist, never a caller-supplied SQL identifier
+    default_kind = "json" if field == "tool_calls" else "text"
+    row = conn.execute(f"""WITH value_kind AS MATERIALIZED (
+        SELECT id, CASE WHEN {column} IS NULL THEN 'none'
+          WHEN typeof({column}) != 'text' THEN 'base64'
+          WHEN instr({column}, char(0)) > 0 THEN 'base64'
+          ELSE '{default_kind}' END AS kind FROM messages
+        WHERE session_id = ? AND id = ? AND {visible})
+        SELECT m.id, m.role, m.active, m.compacted, substr(m.tool_name,1,256) AS tool_name, k.kind AS encoding,
+            CASE WHEN k.kind = 'base64' THEN length(CAST(m.{column} AS BLOB)) ELSE length(m.{column}) END AS total,
+            CASE WHEN k.kind = 'base64' THEN substr(CAST(m.{column} AS BLOB), ?, ?)
+                 ELSE substr(m.{column}, ?, ?) END AS part
+        FROM messages m JOIN value_kind k ON k.id = m.id""",
+        (session_id, message_id, offset + 1, limit, offset + 1, limit)).fetchone()
