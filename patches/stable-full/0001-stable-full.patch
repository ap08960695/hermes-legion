+def test_goal_form_refuses_an_unreadable_budget_instead_of_expanding_it(server, session, hermes_home):
+    sid, _key, _entry = session
+    (hermes_home / "config.yaml").write_text("goals:\n  max_turns: not-a-number\n", encoding="utf-8")
