+    assert mgr.is_waiting() and mgr.state.status == 'paused'
+    assert mgr.state.waiting_on_pid == 4242 and mgr.state.waiting_on_pid_fingerprint is None
+
+
+def test_transient_probe_failure_parks_then_pauses_without_retry(home, monkeypatch):
+    fingerprint = 'boot|original'
+    monkeypatch.setattr(goals, '_pid_observation', lambda _: True)
+    monkeypatch.setattr(goals, '_pid_fingerprint', lambda _: fingerprint)
