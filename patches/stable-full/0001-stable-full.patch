+def test_historical_classification_cannot_see_future_revision(board):
+    from hermes_cli.kanban_attempt_evidence import claim_evidence
+    kb, conn = board
+    tid = kb.create_task(conn, title='test', assignee='worker')
+    kb.claim_task(conn, tid)
+    first = kb.get_task(conn, tid).current_run_id
+    with kb.write_txn(conn):
+        conn.execute("UPDATE task_runs SET outcome='completed',ended_at=started_at WHERE id=?", (first,))
+        conn.execute("UPDATE tasks SET status='ready',claim_lock=NULL WHERE id=?", (tid,))
+    kb.claim_task(conn, tid)
+    second = kb.get_task(conn, tid).current_run_id
+    with kb.write_txn(conn):
+        kb._append_event(conn, tid, 'changes_requested', {})
