+def test_roster_is_bounded_before_reading_extra_profile_configs(fleet,monkeypatch):
+    from hermes_cli import profile_routing,profiles
+    atomic_config_replace(fleet/'config.yaml',{'kanban':{}})
+    monkeypatch.setattr(profiles,'list_profile_names',lambda:[f'bot-{i:03}' for i in range(90)])
+    observed=[]
+    def entry(name,*args):
+        observed.append(name)
+        return {'name':name}
+    monkeypatch.setattr(profile_routing,'_entry',entry)
+    result=profile_routing.routing_snapshot()
+    assert len(observed)==len(result['profiles'])==64
+    assert result['total_profiles']==90 and result['truncated'] is True
