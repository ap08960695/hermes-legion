diff --git a/agent/i18n_bundled.py b/agent/i18n_bundled.py
new file mode 100644
index 0000000000000000000000000000000000000000..7ac3a4d332c7406755bba3cd70ac64e3e8a65961
--- /dev/null
+++ b/agent/i18n_bundled.py
@@ -0,0 +1,35 @@
+"""Bounded reuse of immutable bundled translations, never profile overlays."""
+
+from functools import lru_cache
+from pathlib import Path
+import threading
+from types import MappingProxyType
+from typing import Mapping
+
+
+_lock = threading.RLock()
+
+
+def _fingerprint(path: Path) -> tuple[int, ...]:
+    info = path.stat()
+    return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns,
+            info.st_mode, info.st_uid, info.st_gid)
+
+
+@lru_cache(maxsize=32)
+def _parse_verified(path: Path, fingerprint: tuple[int, ...]) -> Mapping[str, str]:
+    from agent.i18n_layers import parse_locale_file
+
+    messages = parse_locale_file(path)
+    if _fingerprint(path) != fingerprint:
+        raise OSError('Bundled locale changed during parsing')
+    return MappingProxyType(messages)
+
+
+def load_bundled_catalog(path: Path) -> dict[str, str]:
+    """Share parsed strings while each merged catalog owns its mutable dictionary."""
+    resolved = path.resolve(strict=True)
+    # lru_cache alone permits duplicate cold computations by concurrent callers.
+    with _lock:
+        catalog = _parse_verified(resolved, _fingerprint(resolved))
+    return dict(catalog)
