--- /dev/null
+++ b/tests/hermes_cli/test_prompt_suggestion_http.py
@@ -0,0 +1,129 @@
+"""Real loopback TCP verifies elapsed deadlines, cancellation and complete-only text."""
+from contextvars import ContextVar
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import json
+import threading
+import time
+
+import httpx
+import pytest
+
+from hermes_cli import prompt_suggestion_http as transport
+from tests.waiting import wait_until
+
+
+@pytest.fixture
+def local_http(monkeypatch):
+    stop = threading.Event()
+    closed = threading.Event()
+    requests_seen = []
+
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *args):
+            pass
+
+        def do_POST(self):
+            self.rfile.read(int(self.headers["Content-Length"]))
+            requests_seen.append(self.path)
+            try:
+                if self.path == "/headers":
+                    stop.wait(3)
+                self.send_response(200)
+                self.end_headers()
+                if self.path.startswith("/trickle"):
+                    # Every read progresses, yet JSON/SSE remains incomplete beyond our deadline.
+                    for _ in range(80):
+                        self.wfile.write(b" ")
+                        self.wfile.flush()
+                        if stop.wait(0.05):
+                            break
+                elif self.path == "/large":
+                    self.wfile.write(b" " * (transport._MAX_BODY_BYTES + 1))
+                elif self.path == "/sse":
+                    for event in [{"type": "response.output_text.delta", "delta": '["ทดสอบต่อ"]'},
+                                  {"type": "response.completed"}]:
+                        self.wfile.write(b"data: " + json.dumps(event).encode() + b"\r\n\r\n")
+                elif self.path == "/partial":
+                    self.wfile.write(b'data: {"type":"response.output_text.delta","delta":"partial"}\n')
+                else:
+                    self.wfile.write(b'{"complete":true}')
+                self.wfile.flush()
+            except (BrokenPipeError, ConnectionResetError):
+                closed.set()
+
+    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
+    server.daemon_threads = True
+    thread = threading.Thread(target=server.serve_forever, daemon=True)
+    thread.start()
+    original = httpx.AsyncClient.send
+
+    async def local_only(client, request, **kwargs):
+        assert request.url.host == "127.0.0.1" and request.url.port == server.server_port
+        return await original(client, request, **kwargs)
+
+    monkeypatch.setattr(httpx.AsyncClient, "send", local_only)
+    monkeypatch.setattr(transport, "_client", lambda timeout: httpx.AsyncClient(
+        timeout=httpx.Timeout(timeout, connect=min(0.5, timeout)), trust_env=False
+    ))
+    try:
+        yield f"http://127.0.0.1:{server.server_port}", requests_seen, closed
+    finally:
+        stop.set()
+        server.shutdown()
+        server.server_close()
+        thread.join(2)
+
+
+@pytest.mark.parametrize("path,stream", [("/trickle-json", False), ("/trickle-sse", True), ("/headers", False)])
+def test_total_deadline_cancels_even_if_stream_keeps_progressing(local_http, path, stream):
+    base, seen, closed = local_http
+    began = time.monotonic()
+    with pytest.raises((TimeoutError, httpx.RequestError)):
+        transport.request_payload(base + path, headers={}, payload={}, timeout=0.5, stream_text=stream)
+    assert time.monotonic() - began < 2  # scheduling-tolerant; producer keeps body open for4s
+    assert seen == [path]
+    if path != "/headers":
+        assert closed.wait(2), "native HTTP cancellation must close the TCP connection"
+    assert wait_until(
+        lambda: not any(t.name == "deadline-prompt-prediction-http" for t in threading.enumerate()),
+        timeout=2,
+    ), "the cancelled local HTTP worker must finish rather than linger"
+
+
+def test_complete_json_and_sse_are_preserved(local_http):
+    base, seen, _ = local_http
+    assert transport.request_payload(base + "/json", headers={}, payload={}, timeout=2) == (200, {"complete": True})
+    assert transport.request_payload(base + "/sse", headers={}, payload={}, timeout=2, stream_text=True) == (200, '["ทดสอบต่อ"]')
+    assert seen == ["/json", "/sse"]
+
+
+def test_partial_and_oversize_responses_are_not_suggestions(local_http):
+    base, _, _ = local_http
+    assert transport.request_payload(base + "/partial", headers={}, payload={}, timeout=2, stream_text=True) == (200, None)
+    with pytest.raises(ValueError, match="byte limit"):
+        transport.request_payload(base + "/large", headers={}, payload={}, timeout=2)
+
+
+def test_native_deadline_worker_preserves_owning_context(local_http, monkeypatch):
+    base, _, _ = local_http
+    profile = ContextVar("prediction-owner", default="wrong-profile")
+    token = profile.set("owning-profile")
+    original = transport._client
+    seen = []
+
+    def client(timeout):
+        seen.append(profile.get())
+        return original(timeout)
+
+    monkeypatch.setattr(transport, "_client", client)
+    try:
+        assert transport.request_payload(base + "/json", headers={}, payload={}, timeout=2)[0] == 200
+    finally:
+        profile.reset(token)
+    assert seen == ["owning-profile"]
+
+
+@pytest.mark.asyncio
+async def test_sync_entry_also_works_when_caller_has_an_event_loop(local_http):
+    base, _, _ = local_http
+    assert transport.request_payload(base + "/json", headers={}, payload={}, timeout=2)[1] == {"complete": True}
