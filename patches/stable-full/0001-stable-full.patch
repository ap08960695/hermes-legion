@@ -0,0 +1,48 @@
+import { useStore } from '@nanostores/react'
+
+import { StatusRow } from '@/components/chat/status-row'
+import { Codicon } from '@/components/ui/codicon'
+import { useI18n } from '@/i18n'
+import { $fleetPause, type FleetPause } from '@/store/fleet-pause'
+
+const fmtSince = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' })
+
+function usePauseText(pause: FleetPause): string {
+  const copy = useI18n().t.butterbar.paused
+  const at = pause.engaged_at ? Date.parse(pause.engaged_at) : NaN
+
+  return [copy.title, pause.reason, Number.isNaN(at) ? null : copy.since(fmtSince.format(at))]
+    .filter(Boolean)
+    .join(' · ')
+}
+
+/** Butterbar body for the global pause. No close button: it stands while the pause does. */
+export function PauseButterbarNotice({ pause }: { pause: FleetPause }) {
+  const copy = useI18n().t.butterbar.paused
+  const text = `${usePauseText(pause)} · ${copy.onHold}`
+
+  return <span title={text}>{text}</span>
+}
+
+/** Composer hint: a send while paused is refused, so say so before the user types. */
+export function PauseStatusRow() {
+  const pause = useStore($fleetPause)
+  const copy = useI18n().t.butterbar.paused
+  const text = usePauseText(pause ?? { engaged_at: null })
+
+  if (!pause) {
+    return null
+  }
+
+  return (
+    <StatusRow leading={<Codicon aria-hidden className="text-amber-600" name="debug-pause" size="0.8rem" />}>
+      <span
+        className="min-w-0 truncate text-[0.73rem] leading-4 text-foreground/92"
+        title={`${text} · ${copy.composer}`}
+      >
+        <span className="font-medium">{text}</span>
+        <span className="text-muted-foreground/80"> · {copy.composer}</span>
+      </span>
+    </StatusRow>
+  )
+}
