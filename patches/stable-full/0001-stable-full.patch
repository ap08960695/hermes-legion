diff --git a/apps/desktop/src/themes/overlay-fonts.test.tsx b/apps/desktop/src/themes/overlay-fonts.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a2659e91f62476306722c785992f1893bf0085f4
--- /dev/null
+++ b/apps/desktop/src/themes/overlay-fonts.test.tsx
@@ -0,0 +1,77 @@
+import { act, cleanup, render } from '@testing-library/react'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+const initialUrl = window.location.href
+let fonts: string[]
+
+beforeEach(() => {
+  window.localStorage.clear()
+  Reflect.deleteProperty(window, 'hermesDesktop')
+  vi.resetModules()
+  fonts = []
+  const head = window.document.head, append = head.appendChild.bind(head)
+  // Observe real font-link publication without attaching a network resource.
+  vi.spyOn(head, 'appendChild').mockImplementation(function <T extends Node>(node: T): T {
+    if (node instanceof HTMLLinkElement && node.dataset.hermesThemeFont === 'true') {
+      fonts.push(node.href)
+
+      return node
+    }
+
+    return append(node)
+  })
+})
+afterEach(() => {
+  cleanup()
+  window.history.replaceState(null, '', initialUrl)
+  window.localStorage.clear()
+  vi.restoreAllMocks()
+  vi.resetModules()
+})
+
+async function launch() {
+  const context = await import('./context')
+  let api: ReturnType<typeof context.useTheme> | undefined
+
+  function Probe() {
+    api = context.useTheme()
+
+    return null
+  }
+
+  const bootFonts = [...fonts]
+  render(<context.ThemeProvider><Probe /></context.ThemeProvider>)
+
+  return { bootFonts, api: () => api! }
+}
+
+it('keeps cold pet-overlay boot and later theme paints on local font stacks without poisoning font deduplication', async () => {
+  window.history.replaceState(null, '', '/?win=overlay#/')
+  const view = await launch()
+  expect(view.bootFonts).toEqual([])
+  expect(fonts).toEqual([])
+  act(() => view.api().setTheme('midnight'))
+  act(() => view.api().setMode('dark'))
+  expect(fonts).toEqual([])
+  expect(window.document.documentElement.dataset.hermesTheme).toBe('midnight')
+  expect(window.document.documentElement.style.getPropertyValue('--dt-font-mono')).toContain('JetBrains Mono')
+
+  // A suppressed font must not become "already injected" for a later normal paint.
+  window.history.replaceState(null, '', '/#/')
+  act(() => view.api().setTheme('nous'))
+  expect(fonts).toHaveLength(1)
+  expect(fonts[0]).toContain('family=Courier+Prime')
+})
+
+it.each(['', '?win=hud', '?win=secondary'])('preserves theme font loading and deduplication for chat window %s', async query => {
+  window.history.replaceState(null, '', `/${query}#/`)
+  const view = await launch()
+  expect(view.bootFonts).toHaveLength(1)
+  expect(fonts).toHaveLength(1)
+  act(() => view.api().setTheme('midnight'))
+  expect(fonts).toHaveLength(2)
+  expect(fonts[1]).toContain('family=JetBrains+Mono')
+  act(() => view.api().setMode('dark'))
+  act(() => view.api().setMode('light'))
+  expect(fonts).toHaveLength(2)
+})
