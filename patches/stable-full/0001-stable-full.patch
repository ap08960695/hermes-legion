+"""A profile config stat failure cannot silently remove a saved session's cost ceiling."""
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('follows', [False, True])
+@pytest.mark.parametrize('error', [PermissionError, OSError])
+async def test_owner_read_fault_keeps_the_ceiling_on_the_final_wire(tmp_path, monkeypatch, follows, error):
+    from gateway.config import GatewayConfig
+    from gateway.session import SessionStore
+    from gateway.session_authority import initialize_session_authority
+    from gateway.session_controls import AuthorityConnection
+    from gateway.session_local import create_local_session
+    from gateway.session_policy import policy_for_source, policy_scope
+    from gateway.session_cron import unbind_owner
+    from hermes_constants import get_hermes_home
+    from agent.reasoning_limits import limit_agent_request
+
+    def refuse(*args, **kwargs):
+        raise AssertionError('offline session cost test attempted network access')
+    monkeypatch.setattr('socket.socket.connect', refuse)
+    monkeypatch.setattr('socket.socket.connect_ex', refuse)
+    home = get_hermes_home().resolve()
+    managed = tmp_path / 'managed'
+    managed.mkdir()
+    monkeypatch.setenv('HERMES_MANAGED_DIR', str(managed))
+    path = home / 'config.yaml'
+    path.write_text(json.dumps({'model': {'default': 'gpt-6.1-terra', 'provider': 'openai-codex'},
+        'platform_toolsets': {'cli': []}, 'agent': {'reasoning_effort_limits': {'gpt-6.1-terra': 'high'}}}))
+    store = SessionStore(home / 'sessions', GatewayConfig())
+    runner = SimpleNamespace(session_store=store, _session_db=store._db, adapters={}, _draining=False,
+        _cached_agent_for=lambda route: None)
+    runner._adapter_for_source = lambda source: runner.adapters.get(source.platform)
+    authority = await initialize_session_authority(runner, profile_id=str(home), instance_id='fixture')
+    runner.session_authority = authority
+    connection = AuthorityConnection(authority, object(), {'user_id': 'owner'})
+    try:
+        assert Path(authority.db.db_path).resolve().parent == home
+        ref = create_local_session(authority, connection.actor, {'request_id': 'fixture', 'source': 'cli',
+            'cwd': str(home), 'model': 'gpt-6.1-terra', 'toolsets': [], 'reasoning': 'max',
+            'follow_profile_config': follows})
+        policy = policy_for_source(runner, authority.sessions[ref.session_id].source)
+        assert policy is not None
+        before = authority.db.get_session(ref.session_id)
+        native = Path.stat
+        denied_reads = []
+
+        def denied(self, *args, **kwargs):
+            if self == path:
+                denied_reads.append(True)
+                raise error('fixture owner metadata unavailable')
+            return native(self, *args, **kwargs)
+
+        agent = SimpleNamespace(model='gpt-6.1-terra', api_mode='codex_responses',
+                                _reasoning_effort_limits={'gpt-6.1-terra': 'high'})
+        inputs, tools = [{'role': 'user', 'content': 'fixture'}], []
+        with monkeypatch.context() as fault:
+            fault.setattr(Path, 'stat', denied)
+            with policy_scope(policy, authority=authority):
+                request = limit_agent_request(agent, {'model': agent.model, 'reasoning': {'effort': 'max'},
+                                                     'input': inputs, 'tools': tools})
+                assert request['reasoning']['effort'] == 'high'
+                assert request['input'] is inputs and request['tools'] is tools
+        assert denied_reads, 'fault must reach the native owner config read'
+        after = authority.db.get_session(ref.session_id)
+        assert after['model'] == before['model'] == 'gpt-6.1-terra'
+        assert after['system_prompt'] == before['system_prompt']
+    finally:
+        await connection.close()
+        unbind_owner(authority)
+        store.close_all_db_handles()
