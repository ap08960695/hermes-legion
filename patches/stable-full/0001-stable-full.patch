+"""Exact phrase and prefix behavior through native search fallbacks."""
+import shutil
+import sqlite3
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from hermes_state import SessionDB
+
+
+REPO = Path(__file__).resolve().parent.parent.parent
+
+
+@pytest.fixture(scope='session')
+def cjk_so(tmp_path_factory):
+    source = REPO / 'native/fts5_cjk/fts5_cjk.c'
+    vendor = REPO / 'native/fts5_cjk/vendor'
+    if not shutil.which('gcc') or not source.exists():
+        pytest.skip('native CJK compiler or source unavailable')
+    path = tmp_path_factory.mktemp('phrase-cjk') / 'libfts5_cjk.so'
+    subprocess.run(['gcc', '-shared', '-fPIC', '-O2', f'-I{vendor}', str(source), '-o', str(path)],
+                   check=True, capture_output=True)
+    probe = sqlite3.connect(':memory:')
+    try:
+        probe.enable_load_extension(True)
+        probe.load_extension(str(path))
+    finally:
+        probe.close()
+    return path
+
+
+@pytest.fixture
+def db(cjk_so, tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_FTS5_CJK_SO', str(cjk_so))
+    store = SessionDB(tmp_path / 'state.db')
+    assert store._fts_cjk_available
+    store.create_session('s', source='cli')
+    yield store
+    store.close()
+
+
+@pytest.mark.parametrize('route', ['cjk', 'trigram'])
+@pytest.mark.parametrize('text', ['alpha字beta', '修改alpha other beta服务'])
+def test_fallback_preserves_quoted_phrase_instead_of_loose_and(db, route, text):
+    if route == 'trigram':
+        db._fts_cjk_available = False
+        assert db._trigram_available
+    db.append_message('s', role='user', content=text)
+    assert db.search_messages('"alpha beta"') == []
+    assert db.search_messages('alpha AND beta')
+
+
+def test_cjk_fallback_preserves_true_phrase(db):
+    mid = db.append_message('s', role='user', content='修改alpha beta服务')
+    assert mid in {row['id'] for row in db.search_messages('"alpha beta"')}
+
+
+def test_cjk_fallback_preserves_prefix_wildcard(db):
+    db._trigram_available = False
+    mid = db.append_message('s', role='user', content='修改alphabet服务')
+    assert mid in {row['id'] for row in db.search_messages('alph*')}
+
+
+@pytest.mark.parametrize('route', ['cjk', 'trigram'])
+def test_fallback_preserves_boolean_semantics(db, route):
+    if route == 'trigram':
+        db._fts_cjk_available = False
+    only_alpha = db.append_message('s', role='user', content='修改alpha服务')
+    both = db.append_message('s', role='user', content='修改alpha字beta服务')
+    assert {row['id'] for row in db.search_messages('alpha NOT beta')} == {only_alpha}
+    assert {row['id'] for row in db.search_messages('alpha OR beta')} == {only_alpha, both}
+
+
+@pytest.mark.parametrize('route', ['cjk', 'trigram'])
+def test_fallback_handles_sanitized_punctuation(db, route):
+    if route == 'trigram':
+        db._fts_cjk_available = False
+    mid = db.append_message('s', role='user', content='修改my-app.config服务')
+    assert mid in {row['id'] for row in db.search_messages('my-app.config')}
+
+
+@pytest.mark.parametrize('route', ['cjk', 'trigram'])
+@pytest.mark.parametrize('query', ['"alpha beta" AND 웅기야', '웅기야 AND "alpha beta"'])
+def test_cjk_route_preserves_quoted_phrase_with_and(db, query, route):
+    if route == 'trigram':
+        db._fts_cjk_available = False
+    exact = db.append_message('s', role='user', content='웅기야 alpha beta')
+    db.append_message('s', role='user', content='웅기야 alpha other beta')
