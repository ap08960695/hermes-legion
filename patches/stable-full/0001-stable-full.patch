+"""Legacy dispatcher uses the exact live waiter and requires an authenticated socket."""
+from contextlib import nullcontext
+import queue
+import threading
+from types import SimpleNamespace
+
+import pytest
+
+
+@pytest.fixture
+def dashboard(monkeypatch):
+    from tui_gateway import server, server_requests
+
+    frames = queue.Queue()
+    locked = threading.RLock()
+    session = {'session_key': 'fixture-chat', 'history_lock': locked}
+    monkeypatch.setattr(server, '_sessions', {'fixture-runtime': session})
+    monkeypatch.setattr(server, '_session_db', lambda session: nullcontext())
+    monkeypatch.setattr(server_requests, '_write', frames.put)
+    monkeypatch.setattr(server_requests, '_emit', lambda *args: None)
+    monkeypatch.setattr(server_requests, '_answerable', lambda sid: True)
+    server_requests.reset_for_tests()
+    yield server, frames, session
+    server_requests.cancel()
+    server_requests.reset_for_tests()
+
+
+def call(server, peer, method, **params):
+    return server.dispatch({'jsonrpc': '2.0', 'id': 1, 'method': method, 'params': params}, peer)
+
+
+def test_legacy_dashboard_inbox_locks_only_the_unanswered_question(dashboard):
+    from tui_gateway import server_requests
+
+    server, wire, _ = dashboard
+    peer = SimpleNamespace(owner_inbox_operator=True)
+    questions = [
+        {'qid': 'q0', 'question': 'Use fixture A or B?', 'choices': ['A', 'B'], 'multi_select': False},
+        {'qid': 'q1', 'question': 'Which results should go in the report?', 'choices': [], 'multi_select': False},
+    ]
+    answers = queue.Queue()
+    waiter = threading.Thread(target=lambda: answers.put(server_requests.send(
+        'clarify', 'fixture-runtime', {'questions': questions}, timeout=3, qids=['q0', 'q1'])))
+    waiter.start()
+    try:
+        request = wire.get(timeout=2)
+        assert 'error' in call(server, SimpleNamespace(), 'owner_inbox.list')
+        listed = call(server, peer, 'owner_inbox.list')['result']['items']
+        assert [item['question'] for item in listed] == [q['question'] for q in questions]
+        assert listed[0]['chat_session_id'] == 'fixture-chat'
+        params = dict(profile='default', session_id='fixture-runtime', prompt_id=request['id'],
+                      execution_generation=0, kind='clarify')
+        assert call(server, peer, 'owner_inbox.respond', **params, question_id='q0', value='B')['result'] == {
+            'status': 'resolved'}
+        assert call(server, peer, 'owner_inbox.respond', **params, question_id='q0', value='A')['result'] == {
+            'status': 'expired'}
+        assert [item['question_id'] for item in call(server, peer, 'owner_inbox.list')['result']['items']] == ['q1']
+        assert call(server, peer, 'owner_inbox.respond', **params, question_id='q1', value='Only passed checks')['result'] == {
+            'status': 'resolved'}
+        assert answers.get(timeout=2) == {'answers': {'q0': 'B', 'q1': 'Only passed checks'}, 'outcome': 'submitted'}
+        assert call(server, peer, 'owner_inbox.list')['result']['items'] == []
+    finally:
+        waiter.join(timeout=4)
+
+
+def test_remote_mirror_keeps_the_request_until_the_child_acknowledges(dashboard, monkeypatch):
+    server, _, session = dashboard
+    peer = SimpleNamespace(owner_inbox_operator=True)
+    session['_compute_host_open_request'] = {'id': 'srq-fixture', 'method': 'clarify', 'params': {
+        'session_id': 'fixture-runtime', 'questions': [
+            {'qid': 'q0', 'question': 'Use fixture A?', 'choices': ['A'], 'multi_select': False},
+            {'qid': 'q1', 'question': 'Use fixture C?', 'choices': ['C'], 'multi_select': False},
+        ]}}
+    session['_compute_host_request_created_at'] = 1.0
+    response_mode = iter([queue.Empty(), {'status': 'expired', 'open': True, 'locked': ['q0']},
+                          {'status': 'resolved', 'open': False, 'locked': []}])
+
+    def respond(sid, body):
+        assert sid == 'fixture-runtime'
+        assert body['owner_inbox']['prompt_id'] == 'srq-fixture'
+        result = next(response_mode)
+        if isinstance(result, Exception):
+            raise result
+        return {'type': 'respond.ack', 'response': {'result': result}}
+
+    monkeypatch.setattr(server, '_get_compute_host_supervisor', lambda: SimpleNamespace(respond=respond))
+    params = dict(profile='default', session_id='fixture-runtime', prompt_id='srq-fixture',
+                  execution_generation=0, kind='clarify', value='A')
+    assert call(server, peer, 'owner_inbox.respond', **params, question_id='q0')['error']['code'] == 5019
+    listed = call(server, peer, 'owner_inbox.list')['result']['items']
+    assert [item['question_id'] for item in listed] == ['q0', 'q1']
+    assert all(item['created_at'] == 1 for item in listed)
+    assert call(server, peer, 'owner_inbox.respond', **params, question_id='q0')['result'] == {'status': 'expired'}
+    assert [item['question_id'] for item in call(server, peer, 'owner_inbox.list')['result']['items']] == ['q1']
+    assert call(server, peer, 'owner_inbox.respond', **{**params, 'value': 'C'}, question_id='q1')['result'] == {
+        'status': 'resolved'}
+    assert call(server, peer, 'owner_inbox.list')['result']['items'] == []
+
+
+def test_regular_approval_settles_the_exact_native_queue_entry(dashboard):
+    from tools import approval
+    from tools.approval_gateway_wait import _ApprovalEntry
+
+    server, wire, session = dashboard
+    peer = SimpleNamespace(owner_inbox_operator=True)
+    entry = _ApprovalEntry({'request_id': 'fixture-approval', 'command': 'fixture-check', 'description': 'Run the check?'})
+    with approval._lock:
+        approval._gateway_queues[session['session_key']] = [entry]
+    server._emit_approval_request('fixture-runtime', entry.data)
+    frame = wire.get(timeout=2)
+    params = dict(profile='default', session_id='fixture-runtime', prompt_id=frame['id'],
+                  execution_generation=0, kind='approval')
+    try:
+        listed = call(server, peer, 'owner_inbox.list')['result']['items']
+        assert [item['description'] for item in listed] == ['Run the check?']
+        assert call(server, peer, 'owner_inbox.respond', **params, value='always')['error']['code'] == 4002
+        assert not entry.event.is_set()
+        assert call(server, peer, 'owner_inbox.respond', **params, value='once')['result'] == {'status': 'resolved'}
+        assert entry.event.is_set() and entry.result == 'once'
+        assert call(server, peer, 'owner_inbox.respond', **params, value='deny')['result'] == {'status': 'expired'}
+        entry.settle('resolved')
+        assert call(server, peer, 'owner_inbox.list')['result']['items'] == []
+    finally:
+        approval.unregister_gateway_notify(session['session_key'])
