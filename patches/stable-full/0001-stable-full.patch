+import { Button, Codicon, MessageTextContent, useI18n, useMutation } from '@hermes/plugin-sdk'
+import { useRef } from 'react'
+
+import type { KanbanAttachment } from './types'
+
+// Task bodies, results, summaries and comments are agent-written markdown;
+// rendering them raw left `**Goal:**` and backticks literal. Same renderer as
+// chat. `media={false}`: kanban text is not session-scoped, so `MEDIA:` paths
+// must not be resolved against the active gateway.
+export function TaskMarkdown({ text }: { text: string }) {
+  return (
+    <div className="min-w-0 [&_.aui-md>:first-child]:mt-0 [&_.aui-md>:last-child]:mb-0" data-selectable-text="true">
+      <MessageTextContent media={false} text={text} />
+    </div>
+  )
+}
+
+// The filename is the download action. The path is the backend's own
+// stored_path, saved through the connection/profile that returned this detail;
+// a row without one (older backend) stays inert rather than guessing a path.
+export function AttachmentDownload({
+  attachment,
+  onDownload
+}: {
+  attachment: KanbanAttachment
+  onDownload: (path: string, suggestedName: string) => Promise<void>
+}) {
+  const { t } = useI18n()
+  const path = attachment.stored_path?.trim()
+  const saving = useRef(false)
+
+  const download = useMutation({
+    mutationFn: (storedPath: string) => onDownload(storedPath, attachment.filename),
+    onSettled: () => {
+      saving.current = false
+    }
+  })
+
+  return (
+    <Button
+      aria-disabled={download.isPending || undefined}
+      aria-label={`${t.fileMenu.download} ${attachment.filename}`}
+      className="kanban-attachment-download max-w-full min-w-0 justify-start text-start font-normal whitespace-normal"
+      disabled={!path}
+      onClick={() => {
+        if (!path || saving.current || download.isPending) return
+        saving.current = true
+        download.mutate(path)
+      }}
+      size="inline"
+      variant="text"
+    >
+      <Codicon
+        className="shrink-0"
+        name={download.isPending ? 'sync' : 'cloud-download'}
+        size="0.75rem"
+        spinning={download.isPending}
+      />
+      <span className="min-w-0 [overflow-wrap:anywhere]">{attachment.filename}</span>
+    </Button>
+  )
+}
