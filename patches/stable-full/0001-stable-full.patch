+++ b/tests/tools/test_derived_cache_disk_pressure.py
@@ -0,0 +1,99 @@
+"""Optional cache writes preserve useful results under storage pressure/failure."""
+
+import errno
+import os
+import shutil
+
+import pytest
+
+from tools import derived_cache, shared_document_cache
+
+
+@pytest.fixture
+def cache_root(tmp_path, monkeypatch):
+    root = tmp_path / 'derived'
+    root.mkdir(mode=0o700)
+    monkeypatch.setattr(shared_document_cache, '_root', lambda: root)
+    usage = shutil.disk_usage(root)
+    monkeypatch.setattr(shutil, 'disk_usage', lambda path: usage._replace(
+        total=16 * 1024**3, used=6 * 1024**3, free=10 * 1024**3,
+    ))
+    return root
+
+
+@pytest.mark.parametrize('measurement', ['full', 'unknown'])
+def test_pressure_keeps_previous_hit_and_returns_new_conversion(cache_root, monkeypatch, measurement):
+    extract = shared_document_cache.extract_shared
+    assert extract(b'previous', 'previous.docx', lambda data, path: data.decode()) == 'previous'
+    before = {path.name: path.read_bytes() for path in cache_root.glob('*.txt')}
+    monkeypatch.setattr(derived_cache, '_MAX_ENTRIES', 1)
+    usage = shutil.disk_usage(cache_root)
+
+    def pressure(path):
+        if measurement == 'unknown':
+            raise OSError('volume is not observable')
+        return usage._replace(used=usage.total, free=0)
+
+    monkeypatch.setattr(shutil, 'disk_usage', pressure)
+    assert extract(b'new result', 'new.docx', lambda data, path: data.decode()) == 'new result'
+    assert {path.name: path.read_bytes() for path in cache_root.glob('*.txt')} == before
+
+    def no_reconversion(data, path):
+        pytest.fail('A failed optional write must not discard the previous hit')
+
+    assert extract(b'previous', 'previous.docx', no_reconversion) == 'previous'
+    assert not list(cache_root.glob('write-*'))
+
+
+@pytest.mark.parametrize('failure', ['create', 'publish'])
+def test_failed_publication_does_not_evict_prior_results(cache_root, monkeypatch, failure):
+    extract = shared_document_cache.extract_shared
+    assert extract(b'previous', 'previous.docx', lambda data, path: data.decode()) == 'previous'
+    before = {path.name: path.read_bytes() for path in cache_root.glob('*.txt')}
+    monkeypatch.setattr(derived_cache, '_MAX_ENTRIES', 1)
+
+    def failed(*args, **kwargs):
+        raise OSError(errno.ENOSPC, 'fixture storage failure')
+
+    if failure == 'create':
+        monkeypatch.setattr(derived_cache.tempfile, 'mkstemp', failed)
+    else:
+        monkeypatch.setattr(derived_cache.os, 'replace', failed)
+    assert extract(b'new result', 'new.docx', lambda data, path: data.decode()) == 'new result'
+    assert {path.name: path.read_bytes() for path in cache_root.glob('*.txt')} == before
+    assert not list(cache_root.glob('write-*'))
+
+
+def test_replacing_entry_at_capacity_keeps_other_hits(cache_root, monkeypatch):
+    monkeypatch.setattr(derived_cache, '_MAX_ENTRIES', 2)
+    unrelated, target = cache_root / 'other.txt', cache_root / 'target.txt'
+    derived_cache._store(cache_root, unrelated, 'still reusable')
+    derived_cache._store(cache_root, target, 'old result')
+    os.utime(unrelated, (100, 100))
+    # Keep the old result eligible while making eviction order deterministic.
+    monkeypatch.setattr(derived_cache, '_TTL', float('inf'))
+    derived_cache._store(cache_root, target, 'replacement')
+    assert unrelated.read_text() == 'still reusable'
+    assert target.read_text() == 'replacement'
+
+
+def test_successful_new_entry_still_enforces_entry_quota(cache_root, monkeypatch):
+    monkeypatch.setattr(derived_cache, '_MAX_ENTRIES', 1)
+    old, new = cache_root / 'old.txt', cache_root / 'new.txt'
+    derived_cache._store(cache_root, old, 'old result')
+    derived_cache._store(cache_root, new, 'new result')
+    assert not old.exists()
+    assert new.read_text() == 'new result'
+    assert not list(cache_root.glob('write-*'))
+
+
+@pytest.mark.parametrize(('free_bytes', 'stored'), [(1026, False), (1027, True)])
+def test_reserve_admission_counts_encoded_bytes(cache_root, monkeypatch, free_bytes, stored):
+    usage = shutil.disk_usage(cache_root)
+    monkeypatch.setattr(derived_cache, '_MIN_FREE_BYTES', 1024, raising=False)
+    monkeypatch.setattr(shutil, 'disk_usage', lambda path: usage._replace(free=free_bytes))
+    target = cache_root / 'unicode.txt'
+    derived_cache._store(cache_root, target, '\u0e01')
+    assert target.exists() is stored
+    if stored:
+        assert target.read_bytes() == b'\xe0\xb8\x81'
