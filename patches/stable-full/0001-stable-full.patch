diff --git a/tests/gateway/test_idle_cache_cleanup_unittest.py b/tests/gateway/test_idle_cache_cleanup_unittest.py
new file mode 100644
index 0000000000000000000000000000000000000000..193db184c574f60a3989da8205fbd46fe35a94de
--- /dev/null
+++ b/tests/gateway/test_idle_cache_cleanup_unittest.py
@@ -0,0 +1,332 @@
+"""Native idle-cleanup behavior with synthetic provider callbacks; no inference."""
+import asyncio
+import logging
+from hermes_state import SessionDB
+
+from collections import OrderedDict
+from types import SimpleNamespace
+import threading
+from pathlib import Path
+import tempfile
+from concurrent.futures import Future
+from unittest.mock import patch
+import unittest
+
+from gateway.agent_cache_pressure import AgentCacheBounds
+from gateway.run import GatewayRunner
+
+
+class IdleCleanupFixture(unittest.TestCase):
+    def setUp(self):
+        self.runner = GatewayRunner.__new__(GatewayRunner)
+        self.runner._agent_cache_lock = threading.Lock()
+        self.runner._agent_cache = OrderedDict()
+        self.runner._running_agents = {}
+        self.runner._running = True
+        self.runner._agent_cache_bounds_cache = AgentCacheBounds(idle_ttl_secs=1)
+        self.gate = threading.Event()
+        self.entered = threading.Event()
+        self.done = threading.Event()
+        self.lock = threading.Lock()
+        self.active = self.peak = 0
+        self.closed = []
+
+    def tearDown(self):
+        self.gate.set()
+        self.runner._running = False
+        self.runner._shutdown_executor(drain_timeout=5)
+        for thread in threading.enumerate():
+            if thread.name.startswith('agent-cache-idle-'):
+                thread.join(5)
+                self.assertFalse(thread.is_alive())
+
+    def agent(self, key, *, block=False):
+        def commit(messages):
+            with self.lock:
+                self.active += 1
+                self.peak = max(self.peak, self.active)
+                self.entered.set()
+            try:
+                if block:
+                    self.assertTrue(self.gate.wait(5))
+            finally:
+                with self.lock:
+                    self.active -= 1
+        def close():
+            with self.lock:
+                self.closed.append(key)
+                if len(self.closed) == 4:
+                    self.done.set()
+        messages = [{'role': 'user', 'content': 'saved ' + key}]
+        agent = SimpleNamespace(_session_messages=messages, _db_flush_scan_prefix=messages[:],
+            _last_flushed_db_idx=1, _last_activity_ts=1, _memory_manager=object(),
+            commit_memory_session=commit, release_clients=close)
+        self.runner._agent_cache[key] = (agent, 'signature')
+        return agent
+
+class IdleCleanupTests(IdleCleanupFixture):
+    def test_one_idle_worker_leaves_waiting_agents_owned_by_cache(self):
+        agents = [self.agent(str(i), block=True) for i in range(4)]
+        self.assertTrue(self.runner._sweep_idle_cached_agents())
+        self.assertTrue(self.entered.wait(5))
+        with self.runner._agent_cache_lock:
+            self.assertEqual(len(self.runner._agent_cache), 3)
+        self.assertEqual(self.peak, 1)
+        self.assertFalse(self.runner._sweep_idle_cached_agents())
+        self.gate.set()
+        self.assertTrue(self.done.wait(5))
+        self.assertEqual(self.runner._shutdown_executor(drain_timeout=5), 0)
+        self.assertEqual(self.peak, 1)
+        self.assertCountEqual(self.closed, ['0', '1', '2', '3'])
+        for agent in agents:
+            self.assertEqual(agent._session_messages, [])
+            self.assertIsNone(agent._db_flush_scan_prefix)
+
+
+class ReservationTests(IdleCleanupFixture):
+    def watch_completion(self):
+        finished = threading.Event()
+        original = self.runner._finish_idle_cache_cleanup
+        def done(future, token):
+            original(future, token)
+            finished.set()
+        self.runner._finish_idle_cache_cleanup = done
+        return finished
+
+    def test_protected_entries_are_not_submitted(self):
+        agents = [self.agent(str(i)) for i in range(4)]
+        self.runner._running_agents['0'] = agents[0]
+        agents[1]._last_flushed_db_idx = 0
+        agents[2]._last_activity_ts = float('inf')
+        del agents[3]._last_activity_ts
+        self.runner._agent_cache['pending'] = (None, 'sig')
+        before = self.runner._agent_cache.copy()
+        self.assertFalse(self.runner._sweep_idle_cached_agents())
+        self.assertEqual(self.runner._agent_cache, before)
+        self.assertFalse(self.closed)
+
+    def test_waiting_entries_are_rechecked_before_claim(self):
+        agents = [self.agent(str(i), block=True) for i in range(4)]
+        finished = self.watch_completion()
+        self.assertTrue(self.runner._sweep_idle_cached_agents())
+        self.assertTrue(self.entered.wait(5))
+        with self.runner._agent_cache_lock:
+            self.runner._running_agents['1'] = agents[1]
+            agents[2]._last_flushed_db_idx = 0
+            replacement = SimpleNamespace(_last_activity_ts=float('inf'), _session_messages=[], _last_flushed_db_idx=0)
+            self.runner._agent_cache['3'] = (replacement, 'new')
+        self.gate.set()
+        self.assertTrue(finished.wait(5))
+        self.assertEqual(self.closed, ['0'])
+        self.assertIs(self.runner._agent_cache['3'][0], replacement)
+        self.assertEqual(set(self.runner._agent_cache), {'1', '2', '3'})
+        self.assertIsNone(self.runner._idle_cache_cleanup_token)
+
+    def test_partially_failed_submit_cannot_claim_after_resubmission(self):
+        for i in range(4):
+            self.agent(str(i), block=True)
+        captured = []
+        class FailingExecutor:
+            def submit(self, fn, *args):
+                captured.append((fn, args))
+                raise RuntimeError('synthetic thread start failure')
+        with patch.object(self.runner, '_get_housekeeping_executor', return_value=FailingExecutor()):
+            with self.assertRaisesRegex(RuntimeError, 'thread start failure'):
+                self.runner._sweep_idle_cached_agents()
+        self.assertEqual(len(self.runner._agent_cache), 4)
+        self.assertIsNone(self.runner._idle_cache_cleanup_token)
+        finished = self.watch_completion()
+        self.assertTrue(self.runner._sweep_idle_cached_agents())
+        self.assertTrue(self.entered.wait(5))
+        fn, args = captured[0]
+        fn(*args)
+        self.assertEqual(len(self.runner._agent_cache), 3)
+        self.assertEqual(self.peak, 1)
+        self.gate.set()
+        self.assertTrue(finished.wait(5))
+        self.assertCountEqual(self.closed, ['0', '1', '2', '3'])
+
+    def test_cancelled_queued_job_preserves_cache_and_allows_resubmission(self):
+        for i in range(4):
+            self.agent(str(i))
+        future = Future()
+        executor = SimpleNamespace(submit=lambda *args: future)
+        with patch.object(self.runner, '_get_housekeeping_executor', return_value=executor):
+            self.assertTrue(self.runner._sweep_idle_cached_agents())
+            self.assertFalse(self.runner._sweep_idle_cached_agents())
+            self.assertEqual(len(self.runner._agent_cache), 4)
+            self.assertTrue(future.cancel())
+        self.assertIsNone(self.runner._idle_cache_cleanup_token)
+        finished = self.watch_completion()
+        self.assertTrue(self.runner._sweep_idle_cached_agents())
+        self.assertTrue(finished.wait(5))
+        self.assertCountEqual(self.closed, ['0', '1', '2', '3'])
+
+    def test_already_completed_callback_attaches_without_cache_lock(self):
+        self.agent('0')
+        future = Future()
+        future.set_result(None)
+        with patch.object(self.runner, '_get_housekeeping_executor', return_value=SimpleNamespace(submit=lambda *args: future)):
+            self.assertTrue(self.runner._sweep_idle_cached_agents())
+        self.assertEqual(len(self.runner._agent_cache), 1)
+        self.assertIsNone(self.runner._idle_cache_cleanup_token)
+        finished = self.watch_completion()
+        self.assertTrue(self.runner._sweep_idle_cached_agents())
+        self.assertTrue(finished.wait(5))
+        self.assertEqual(self.closed, ['0'])
+
+    def test_old_completion_does_not_clear_replacement_reservation(self):
+        old, current = object(), object()
+        self.runner._idle_cache_cleanup_token = current
+        future = Future()
+        future.set_result(None)
+        self.runner._finish_idle_cache_cleanup(future, old)
+        self.assertIs(self.runner._idle_cache_cleanup_token, current)
+
+    def test_native_soft_provider_failure_still_releases_history(self):
+        agent = self.agent('0')
+        def fail(messages):
+            raise RuntimeError('synthetic provider failure')
+        agent.commit_memory_session = fail
+        finished = self.watch_completion()
+        with self.assertLogs('gateway.run', level='DEBUG') as logs:
+            self.assertTrue(self.runner._sweep_idle_cached_agents())
+            self.assertTrue(finished.wait(5))
+        self.assertTrue(any('Pre-evict memory commit failed' in row for row in logs.output))
+        self.assertEqual(self.closed, ['0'])
+        self.assertEqual(agent._session_messages, [])
+        self.assertIsNone(agent._db_flush_scan_prefix)
+
+    def test_each_claim_enters_its_own_profile_before_commit_and_release(self):
+        from agent import secret_scope
+        from hermes_constants import get_hermes_home
+        previous = secret_scope.is_multiplex_active()
+        seen = []
+        with tempfile.TemporaryDirectory() as temporary:
+            homes = {name: Path(temporary) / name for name in ('a', 'b')}
+            for name, home in homes.items():
+                home.mkdir()
+                (home / '.env').write_text('SYNTHETIC_MARKER=' + name + '\n')
+                agent = self.agent(name)
+                def observe(messages=None, *, name=name, phase='commit'):
+                    scope = secret_scope.current_secret_scope()
+                    seen.append((name, phase, get_hermes_home(), scope.get('SYNTHETIC_MARKER')))
+                agent.commit_memory_session = observe
+                agent.release_clients = lambda name=name, observe=observe: observe(phase='release')
+            self.runner.session_store = SimpleNamespace(_profile_home_for_key=lambda key: homes[key])
+            finished = self.watch_completion()
+            secret_scope.set_multiplex_active(True)
+            try:
+                self.assertTrue(self.runner._sweep_idle_cached_agents())
+                self.assertTrue(finished.wait(5))
+            finally:
+                self.gate.set()
+                self.runner._shutdown_executor(drain_timeout=5)
+                secret_scope.set_multiplex_active(previous)
+            self.assertEqual(seen, [
+                ('a', 'commit', homes['a'], 'a'), ('a', 'release', homes['a'], 'a'),
+                ('b', 'commit', homes['b'], 'b'), ('b', 'release', homes['b'], 'b')])
+
+    def test_stop_before_claim_keeps_agents_cached(self):
+        self.agent('0')
+        self.runner._running = False
+        self.assertFalse(self.runner._sweep_idle_cached_agents())
+        self.assertEqual(len(self.runner._agent_cache), 1)
+        self.assertFalse(self.closed)
+
+
+class ShutdownOwnershipTests(unittest.TestCase):
+    def test_shutdown_finalizes_waiting_agents_and_keeps_live_writer_db_open(self):
+        async def drive():
+            with tempfile.TemporaryDirectory() as temporary:
+                runner = GatewayRunner()
+                runner._running = True
+                runner._agent_cache_bounds_cache = AgentCacheBounds(idle_ttl_secs=1)
+                db = SessionDB(db_path=Path(temporary) / 'state.db')
+                runner._session_db = db
+                gate, entered = threading.Event(), threading.Event()
+                commits, closes, db_closes, messages = [], [], [], []
+                lock = threading.Lock()
+                native_close = db.close
+                def close_db():
+                    db_closes.append(True)
+                    native_close()
+                db.close = close_db
+                for index in range(4):
+                    key = 's' + str(index)
+                    db.create_session(key, 'cli')
+                    db.append_message(key, role='user', content='saved ' + key)
+                    def commit(history, key=key):
+                        if key == 's0':
+                            entered.set()
+                            assert gate.wait(15)
+                        db.append_message(key, role='assistant', content='committed ' + key)
+                        with lock:
+                            commits.append(key)
+                    def close(key=key):
+                        with lock:
+                            closes.append(key)
+                    history = [{'role': 'user', 'content': 'saved ' + key}]
+                    agent = SimpleNamespace(_session_messages=history, _db_flush_scan_prefix=history[:],
+                        _last_flushed_db_idx=1, _last_activity_ts=1, _memory_manager=object(),
+                        commit_memory_session=commit, shutdown_memory_provider=commit,
+                        release_clients=close, close=close)
+                    runner._agent_cache[key] = (agent, 'signature')
+                pool = None
+                try:
+                    assert runner._sweep_idle_cached_agents()
+                    assert entered.wait(5)
+                    pool = runner._get_housekeeping_executor()
+                    assert len(runner._agent_cache) == 3
+                    # This is the existing stop-begin gate; execute the real native finalization phase next.
+                    runner._running = False
+                    ctx = SimpleNamespace(active_agents={}, elapsed=lambda: 0, api_live=0, deferred_count=lambda: 0)
+                    await runner._stop_finalize_agents_and_adapters(ctx)
+                    assert sorted(commits) == ['s1', 's2', 's3'], commits
+                    assert sorted(closes) == ['s1', 's2', 's3'], closes
+                    assert not runner._agent_cache
+                    class Capture(logging.Handler):
+                        def emit(self, record):
+                            messages.append(record.getMessage())
+                    capture = Capture()
+                    logger = logging.getLogger('gateway.run')
+                    logger.addHandler(capture)
+                    try:
+                        # A short explicit test budget lets idle pool threads exit while the provider stays blocked.
+                        with patch("gateway.run._EXECUTOR_QUIESCE_TIMEOUT", 2.0):
+                            runner._stop_quiesce_and_close_session_dbs(0, ctx)
+                    finally:
+                        logger.removeHandler(capture)
+                    assert not db_closes, db_closes
+                    assert any('1 executor worker(s) still running' in line and 'skipping' in line for line in messages), messages
+                    assert sum(thread.is_alive() for thread in pool._threads) == 1
+                    assert not runner._sweep_idle_cached_agents()
+                    gate.set()
+                    for thread in pool._threads:
+                        thread.join(5)
+                        assert not thread.is_alive()
+                    assert sorted(commits) == ['s0', 's1', 's2', 's3'], commits
+                    assert sorted(closes) == ['s0', 's1', 's2', 's3'], closes
+                    runner._stop_quiesce_and_close_session_dbs(0, ctx)
+                    assert db_closes
+                    reopened = SessionDB(db_path=Path(temporary) / 'state.db')
+                    try:
+                        for index in range(4):
+                            key = 's' + str(index)
+                            assert [(m['role'], m['content']) for m in reopened.get_messages(key)] == [
+                                ('user', 'saved ' + key), ('assistant', 'committed ' + key)]
+                    finally:
+                        reopened.close()
+                finally:
+                    gate.set()
+                    runner._running = False
+                    runner._shutdown_executor(drain_timeout=5)
+                    if pool is not None:
+                        for thread in pool._threads:
+                            thread.join(5)
+                            assert not thread.is_alive()
+                    db.close()
+        asyncio.run(drive())
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
