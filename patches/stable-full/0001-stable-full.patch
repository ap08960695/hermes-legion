--- /dev/null
+++ b/tests/hermes_cli/test_plugin_manifest_cache.py
@@ -0,0 +1,88 @@
+"""Native YAML reuse must keep mutable manifest state private to each caller."""
+import os
+
+import pytest
+
+from hermes_cli.plugins_manifest import parse_manifest_file
+from tests.waiting import wait_for_ctime_tick
+
+
+_BODY = '''\ufeffmanifest_version: 2
+name: fixture
+kind: backend
+version: '1.0'
+provides_tools: [fixture_tool]
+config_schema:
+  options:
+    type: dict
+    default:
+      items: [clean]
+  enabled:
+    type: bool
+    default: yes
+'''
+
+
+def _manifest(tmp_path):
+    plugin = tmp_path / 'fixture'
+    plugin.mkdir()
+    path = plugin / 'plugin.yaml'
+    path.write_text(_BODY, encoding='utf-8')
+    return path, plugin
+
+
+def test_shared_manifest_parses_once_but_caller_mutations_and_metadata_stay_private(tmp_path, monkeypatch):
+    import hermes_yaml
+    path, plugin = _manifest(tmp_path)
+    parses = []
+    native = hermes_yaml.safe_load
+
+    def observe(document):
+        parses.append(1)
+        return native(document)
+
+    monkeypatch.setattr(hermes_yaml, 'safe_load', observe)
+    first = parse_manifest_file(path, plugin, 'bundled', 'alpha')
+    assert first.config_schema['enabled']['default'] is True
+    first.provides_tools.append('private_only')
+    first.config_schema['options']['default']['items'].append('private_only')
+    second = parse_manifest_file(path, plugin, 'user', 'beta')
+    assert second.provides_tools == ['fixture_tool']
+    assert second.config_schema['options']['default']['items'] == ['clean']
+    assert (second.key, second.source, second.path) == ('beta/fixture', 'user', str(plugin))
+    assert first.key == 'alpha/fixture'
+    assert len(parses) == 1, 'unchanged shared YAML must not be parsed again for another profile'
+
+
+def test_manifest_edit_with_preserved_mtime_and_deletion_are_observed(tmp_path):
+    path, plugin = _manifest(tmp_path)
+    first = parse_manifest_file(path, plugin, 'bundled', '')
+    assert first.version == '1.0'
+    st = path.stat()
+    wait_for_ctime_tick(plugin, st.st_ctime_ns)
+    path.write_text(_BODY.replace("'1.0'", "'2.0'"), encoding='utf-8')
+    os.utime(path, ns=(st.st_atime_ns, st.st_mtime_ns))
+    assert parse_manifest_file(path, plugin, 'bundled', '').version == '2.0'
+    path.unlink()
+    assert parse_manifest_file(path, plugin, 'bundled', '') is None
+
+
+def test_failed_manifest_parse_does_not_poison_a_repaired_file(tmp_path):
+    path, plugin = _manifest(tmp_path)
+    path.write_text('name: [broken\n')
+    assert parse_manifest_file(path, plugin, 'user', '') is None
+    path.write_text(_BODY, encoding='utf-8')
+    assert parse_manifest_file(path, plugin, 'user', '').name == 'fixture'
+
+
+@pytest.mark.platforms('posix')
+@pytest.mark.skipif(hasattr(os, 'geteuid') and os.geteuid() == 0, reason='root bypasses real file permissions')
+def test_warm_manifest_cannot_bypass_read_permission_revocation(tmp_path):
+    path, plugin = _manifest(tmp_path)
+    assert parse_manifest_file(path, plugin, 'user', '').name == 'fixture'
+    mode = path.stat().st_mode & 0o777
+    try:
+        path.chmod(0)
+        assert parse_manifest_file(path, plugin, 'user', '') is None
+    finally:
+        path.chmod(mode)
