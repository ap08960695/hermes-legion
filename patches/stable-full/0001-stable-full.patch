+import { act, cleanup, fireEvent, render } from '@testing-library/react'
+import { atom } from 'nanostores'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type { HermesGateway } from '@/hermes'
+import { I18nProvider } from '@/i18n'
+import type { ChatMessage } from '@/lib/chat-messages'
+
+import { PromptPredictionControls } from './prompt-prediction'
+import { composerPlainText, insertComposerContentsAtCaret, RICH_INPUT_SLOT } from './rich-editor'
+import { placeCaretAtEnd } from './test-utils'
+
+let editor: HTMLDivElement
+
+const messages = atom<ChatMessage[]>([
+  { id: 'goal', role: 'user', parts: [{ type: 'text', text: 'แก้ compact และ memory แล้วทดสอบ resume' }] },
+  { id: 'result', role: 'assistant', parts: [{ type: 'text', text: 'แก้ compact แล้ว ยังไม่ได้ทดสอบ resume' }] }
+])
+
+beforeEach(() => {
+  localStorage.setItem('hermes.desktop.promptPrediction.next', 'false')
+  localStorage.setItem('hermes.desktop.promptPrediction.autocomplete', 'false')
+  editor = window.document.createElement('div')
+  editor.contentEditable = 'true'
+  editor.tabIndex = 0
+  editor.dataset.slot = RICH_INPUT_SLOT
+  window.document.body.append(editor)
+  editor.focus()
+  placeCaretAtEnd(editor)
+})
+afterEach(() => {
+  cleanup()
+  editor.remove()
+})
+
+function mount(
+  request = vi.fn(async (_method: string, _params?: Record<string, unknown>, _timeout?: number) => ({
+    text: 'ทดสอบ resume กับ memory หลัง compact'
+  }))
+) {
+  const onAccept = vi.fn((text: string) => {
+    editor.textContent = ''
+    placeCaretAtEnd(editor)
+    insertComposerContentsAtCaret(editor, text)
+  })
+
+  const props = {
+    editorRef: { current: editor },
+    messages,
+    gateway: { request } as unknown as HermesGateway,
+    sessionId: 'mine',
+    busy: false,
+    blocked: false,
+    onAccept
+  }
+
+  const view = render(
+    <I18nProvider configClient={null} initialLocale="en">
+      <PromptPredictionControls {...props} />
+    </I18nProvider>
+  )
+
+  return { ...view, request, onAccept, props }
+}
+
+describe('manual predictive prompt controls', () => {
+  it('never queries on mount, typing, focus, or new assistant messages; explicit action predicts a new prompt', async () => {
+    const f = mount()
+    fireEvent.input(editor)
+    fireEvent.focus(editor)
+    await act(async () => {
+      messages.set([...messages.get()])
+      await new Promise(r => setTimeout(r, 40))
+    })
+    expect(f.request).not.toHaveBeenCalled()
+    await act(async () => {
+      fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' }))
+    })
+    expect(f.request).toHaveBeenCalledTimes(1)
+    expect(f.request.mock.calls[0]![0]).toBe('llm.oneshot')
+    expect(f.getByRole('button', { name: /ทดสอบ resume กับ memory/ })).toBeTruthy()
+    expect(composerPlainText(editor)).toBe('')
+    fireEvent.keyDown(editor, { key: 'Tab' })
+    expect(f.onAccept).toHaveBeenCalledExactlyOnceWith('ทดสอบ resume กับ memory หลัง compact')
+    expect(composerPlainText(editor)).toBe('ทดสอบ resume กับ memory หลัง compact')
+  })
+
+  it('has one action regardless of legacy disabled preferences, and sends the current draft', async () => {
+    const f = mount(vi.fn(async () => ({ text: 'ช่วยทดสอบ resume' })))
+    expect(f.queryByRole('button', { name: 'Next prompt' })).toBeNull()
+    expect(f.queryByRole('button', { name: 'Autocomplete' })).toBeNull()
+    expect(f.getAllByRole('button')).toHaveLength(1)
+    expect(f.getByRole('button', { name: 'Suggest prompt' }).hasAttribute('disabled')).toBe(false)
+    editor.textContent = 'ช่วยทดสอบ'
+    placeCaretAtEnd(editor)
+    fireEvent.input(editor)
+    expect(f.request).not.toHaveBeenCalled()
+    await act(async () => fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' })))
+    expect(f.request).toHaveBeenCalledExactlyOnceWith(
+      'llm.oneshot',
+      expect.objectContaining({
+        variables: { draft: 'ช่วยทดสอบ' }
+      }),
+      7000
+    )
+    fireEvent.keyDown(editor, { key: 'Tab' })
+    expect(f.onAccept).toHaveBeenCalledExactlyOnceWith('ช่วยทดสอบ resume')
+  })
+
+  it('does not apply a stale result after typing or switching session', async () => {
+    let resolve!: (value: { text: string }) => void
+
+    const request = vi.fn(
+      () =>
+        new Promise<{ text: string }>(r => {
+          resolve = r
+        })
+    )
+
+    const f = mount(request)
+    fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' }))
+    editor.textContent = 'Different draft'
+    placeCaretAtEnd(editor)
+    fireEvent.input(editor)
+    await act(async () => resolve({ text: 'Old prediction' }))
+    expect(f.queryByRole('button', { name: /Old prediction/ })).toBeNull()
+    expect(composerPlainText(editor)).toBe('Different draft')
+    expect(f.onAccept).not.toHaveBeenCalled()
+  })
+
+  it('only fills a matching draft, and Esc dismisses without sending or clearing text', async () => {
+    editor.textContent = 'ช่วยทดสอบ'
+    placeCaretAtEnd(editor)
+    const f = mount(vi.fn(async () => ({ text: 'ช่วยทดสอบ resume กับ memory' })))
+    await act(async () => {
+      fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' }))
+    })
+    expect(fireEvent.keyDown(editor, { key: 'Enter' })).toBe(true)
+    expect(fireEvent.keyDown(editor, { key: 'Tab', shiftKey: true })).toBe(true)
+    expect(fireEvent.keyDown(editor, { key: 'Escape' })).toBe(false)
+    expect(f.onAccept).not.toHaveBeenCalled()
+    expect(composerPlainText(editor)).toBe('ช่วยทดสอบ')
+  })
+})
+
+it('invalidates an in-flight prediction when switching sessions', async () => {
+  let resolve!: (value: { text: string }) => void
+
+  const f = mount(
+    vi.fn(
+      () =>
+        new Promise<{ text: string }>(r => {
+          resolve = r
+        })
+    )
+  )
+
+  fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' }))
+  f.rerender(
+    <I18nProvider configClient={null} initialLocale="en">
+      <PromptPredictionControls {...f.props} sessionId="other" />
+    </I18nProvider>
+  )
+  await act(async () => resolve({ text: 'Old session prediction' }))
+  expect(f.queryByRole('button', { name: /Old session prediction/ })).toBeNull()
+  expect(f.onAccept).not.toHaveBeenCalled()
+  expect(f.request).toHaveBeenCalledTimes(1)
+})
+
+it('does not generate or accept while an IME composition is active', async () => {
+  const f = mount()
+  fireEvent.compositionStart(editor)
+  fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' }))
+  expect(f.request).not.toHaveBeenCalled()
+  fireEvent.compositionEnd(editor)
+  await act(async () => fireEvent.click(f.getByRole('button', { name: 'Suggest prompt' })))
+  expect(f.request).toHaveBeenCalledTimes(1)
+  fireEvent.compositionStart(editor)
+  fireEvent.keyDown(editor, { key: 'Tab', isComposing: true })
+  expect(f.onAccept).not.toHaveBeenCalled()
+})
