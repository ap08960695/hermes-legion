+@pytest.mark.parametrize('term', ['needle','cafe','zqx','terminal','100'])
+def test_ordered_prefilter_never_rejects_native_unicode_matches(db,term):
+    rng=random.Random(417)
+    rows=[]
+    for i in range(250):
+        word=''.join(chr(rng.choice((ord(ch), ord(ch.upper()), *FOLD_ALIASES.get(ord(ch), ()))))
+                     for ch in term)
+        for nested in (False,True):
+            value=json.dumps(word,ensure_ascii=True) if nested else word
+            rows.append((len(rows)+1,json.dumps({'arguments':value,'noise':'ordinary '*150},ensure_ascii=True)))
+    db.executemany('INSERT INTO messages(id,tool_calls) VALUES(?,?)',rows)
+    search=GlobalSearch(db,[(term,False)])
+    try:
+        for mid,raw in rows:
+            assert search.tool_contains(mid,term,False)==1
+            assert search.small_json_token_maybe(raw,term)==1
+    finally:search.close()
