@@ -0,0 +1,96 @@
+"""Read-only lint for local native-atlas creator folders; not an installer."""
+from __future__ import annotations
+
+import io
+import json
+import os
+import stat
+from pathlib import Path
+
+from agent.pet.constants import MOTION_WEIGHTS
+
+IMAGE_LIMIT = 16 * 1024 * 1024
+MANIFEST_LIMIT = 64 * 1024
+
+
+def _validate_image(stream) -> dict:
+    from PIL import Image
+
+    from agent.pet.generate.atlas import ATLAS_HEIGHT, ATLAS_WIDTH, validate_atlas
+
+    try:
+        with Image.open(stream, formats=("PNG", "WEBP")) as image:
+            if image.size != (ATLAS_WIDTH, ATLAS_HEIGHT):
+                raise ValueError(f"expected {ATLAS_WIDTH}x{ATLAS_HEIGHT}, got {image.width}x{image.height}")
+            if getattr(image, "is_animated", False):
+                raise ValueError("expected a static sprite atlas, not an animated image")
+            return validate_atlas(image)
+    except Image.DecompressionBombError as exc:
+        raise ValueError("image dimensions exceed the decoder limit") from exc
+
+
+def validate_spritesheet(path: Path) -> dict:
+    """Preserve standalone IMAGE validation, including user-selected symlinks."""
+    if not path.is_file() or path.stat().st_size > IMAGE_LIMIT:
+        raise ValueError("expected a PNG/WebP file no larger than 16 MiB")
+    with path.open("rb") as stream:
+        return _validate_image(stream)
+
+
+def _read_pack_file(path: Path, limit: int) -> bytes:
+    before = path.lstat()
+    if not stat.S_ISREG(before.st_mode):
+        raise ValueError("pack files must be regular files, not symlinks or special files")
+    if before.st_size > limit:
+        raise ValueError("pack file exceeds its byte limit")
+    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
+    with os.fdopen(os.open(path, flags), "rb") as stream:
+        opened = os.fstat(stream.fileno())
+        if not stat.S_ISREG(opened.st_mode) or (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
+            raise ValueError("pack file changed while opening")
+        data = stream.read(limit + 1)
+    if len(data) > limit:
+        raise ValueError("pack file exceeds its byte limit")
+    return data
+
+
+def _unique_fields(pairs) -> dict:
+    fields = dict(pairs)
+    if len(fields) != len(pairs):
+        raise ValueError("duplicate manifest fields")
+    return fields
+
+
+def load_pack(root: Path) -> tuple[dict, bytes]:
+    """Return the lint report and exact bounded image snapshot it describes."""
+    if any(part.is_symlink() for part in (root.absolute(), *root.absolute().parents)):
+        raise ValueError("pack directory paths must not contain symlinks")
+    raw = _read_pack_file(root / "manifest.json", MANIFEST_LIMIT)
+    try:
+        meta = json.loads(raw.decode("utf-8-sig"), object_pairs_hook=_unique_fields)
+    except RecursionError as exc:
+        raise ValueError("manifest nesting is too deep") from exc
+    required = {"schema_version", "format", "name", "author", "licence", "spritesheet"}
+    if not isinstance(meta, dict) or not required <= meta.keys() <= required | {"motion_weight"}:
+        raise ValueError("manifest requires schema_version, format, name, author, licence and spritesheet")
+    if "motion_weight" in meta and meta["motion_weight"] not in MOTION_WEIGHTS:
+        raise ValueError("motion_weight must be light, standard or heavy")
+    if type(meta["schema_version"]) is not int or meta["schema_version"] != 1 or meta["format"] != "hermes-native-atlas":
+        raise ValueError("unsupported character pack format or schema version")
+    for field in ("name", "author", "licence"):
+        value = meta[field]
+        if not isinstance(value, str) or not value.strip() or len(value) > 160 or not value.isprintable():
+            raise ValueError(f"{field} must be 1-160 printable characters")
+    if meta["spritesheet"] not in ("spritesheet.png", "spritesheet.webp"):
+        raise ValueError("spritesheet must be spritesheet.png or spritesheet.webp in the pack folder")
+    data = _read_pack_file(root / meta["spritesheet"], IMAGE_LIMIT)
+    result = _validate_image(io.BytesIO(data))
+    if "idle" not in result["filled_states"]:
+        result["errors"].append("pack requires a populated idle row")
+        result["ok"] = False
+    return {**result, "pack": meta}, data
