+import { spawnSync } from 'node:child_process'
+import * as fs from 'node:fs'
+import * as path from 'node:path'
+
+import { _electron } from '@playwright/test'
+
+import { waitForChatReady } from '../../../tests-js/scripts/desktop-chat-smoke'
+import { writeEnvFile, writeMockProviderConfig } from '../../../tests-js/scripts/mock-provider-config'
+import { startMockServer } from '../../../tests-js/scripts/mock-server'
+
+import { buildAppEnv, createSandbox, launchDesktop, PACKAGED_BINARY_PATH } from './fixtures'
+import { expect, installErrorBannerGuard, test } from './test'
+
+const root = path.resolve(import.meta.dirname, '..', '..', '..')
+const oldId = '20261027_010000_000000'
+const oldText = 'Synthetic older session restore evidence'
+
+interface RestoreWindow extends Window {
+  hermesDesktop?: {
+    api: <T>(request: { path: string }) => Promise<T>
+  }
+}
+
+test('cold start restores an older session omitted from the first page', async () => {
+  test.setTimeout(120_000)
+  const sandbox = createSandbox('unlisted-restore')
+  const mock = await startMockServer()
+  writeMockProviderConfig(sandbox.hermesHome, mock.url)
+  writeEnvFile(sandbox.hermesHome)
+  const python = process.env.HERMES_E2E_PYTHON || 'python3'
+
+  const seed = `
+from pathlib import Path
+import sys,time
+from hermes_state import SessionDB
+root=Path(sys.argv[1]); db=SessionDB(db_path=root/'state.db'); now=time.time()
+for i in range(55):
+ sid=f'20261027_0100{i:02d}_{i:06x}'
+ db.create_session(sid,source='desktop',model='mock-model')
+ db.append_message(sid,'user','Synthetic older session restore evidence' if i==0 else f'Synthetic newer session {i}',timestamp=now-1200+i)
+ db.set_session_title(sid, 'Synthetic older' if i==0 else f'Synthetic newer {i}')
+db.close()
+`
+
+  const seeded = spawnSync(python, ['-c', seed, sandbox.hermesHome], {
+    cwd: root,
+    env: {
+      PATH: process.env.PATH,
+      HOME: sandbox.root,
+      HERMES_HOME: sandbox.hermesHome,
+      HERMES_DISABLE_LAZY_INSTALLS: '1',
+      PYTHONPATH: root
+    },
+    encoding: 'utf8'
+  })
+
+  expect(seeded.status, seeded.stderr).toBe(0)
+
+  const env = buildAppEnv(sandbox, {
+    HERMES_DESKTOP_PYTHON: python,
+    HERMES_DISABLE_LAZY_INSTALLS: '1'
+  })
+
+  // The packaged option exercises the built release renderer with the same
+  // isolated backend and synthetic data as the unpackaged source fixture.
+  const launch = async () =>
+    process.env.HERMES_E2E_PACKAGED === '1'
+      ? await (async () => {
+          const app = await _electron.launch({
+            executablePath:
+              process.platform === 'linux' && !fs.existsSync(PACKAGED_BINARY_PATH)
+                ? path.join(path.dirname(PACKAGED_BINARY_PATH), 'Hermes')
+                : PACKAGED_BINARY_PATH,
+            args: ['--disable-gpu', '--no-sandbox'],
+            env
+          })
+
+          const page = await app.firstWindow()
+          installErrorBannerGuard(page)
+
+          return { app, page }
+        })()
+      : await launchDesktop(env)
+
+  let { app, page } = await launch()
+
+  try {
+    await waitForChatReady(page, 60_000)
+
+    const initialPage = await page.evaluate(async () =>
+      (window as RestoreWindow).hermesDesktop!.api<{ sessions: Array<{ id: string }> }>({
+        path: '/api/profiles/sessions?limit=50&offset=0&min_messages=1&archived=exclude&order=recent&profile=default'
+      })
+    )
+
+    expect(initialPage.sessions).toHaveLength(50)
+    expect(initialPage.sessions.some(row => row.id === oldId)).toBe(false)
+    await page.evaluate(id => {
+      localStorage.setItem('hermes.desktop.lastRoute.profile.default', `/${id}`)
+      localStorage.setItem('hermes.desktop.lastSessionId.profile.default', id)
+    }, oldId)
+    await app.close()
+    const relaunched = await launch()
+    app = relaunched.app
+    page = relaunched.page
+    await expect(page.locator('[data-slot="aui_thread-viewport"]')).toContainText(oldText, { timeout: 60_000 })
+    await expect.poll(() => mock.receivedPrompts.length).toBe(0)
+  } finally {
+    await app.close().catch(() => undefined)
+    await mock.close()
+    sandbox.cleanup()
+  }
+})
