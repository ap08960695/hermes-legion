@@ -0,0 +1,53 @@
+"""Completed profile deletion/rename retires only that profile's parsed config copies."""
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import config, config_effective, profiles
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+
+def _load(home):
+    token = set_hermes_home_override(home)
+    try:
+        config.load_config()
+        config.read_raw_config()
+        config_effective.load_user_config_effective()
+    finally:
+        reset_hermes_home_override(token)
+
+
+@pytest.mark.parametrize('operation', ['delete', 'rename'])
+def test_retired_profile_drops_its_config_caches_only(tmp_path, monkeypatch, operation):
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path)
+    root = tmp_path / '.hermes'
+    root.mkdir()
+    managed = tmp_path / 'managed'
+    managed.mkdir()
+    monkeypatch.setenv('HERMES_HOME', str(root))
+    monkeypatch.setenv('HERMES_MANAGED_DIR', str(managed))
+    old = root / 'profiles' / 'retiring'
+    old.mkdir(parents=True)
+    for home in [root, old]:
+        (home / 'config.yaml').write_text('display:\n  skin: mono\n')
+        _load(home)
+    caches = [config._LOAD_CONFIG_CACHE, config._RAW_CONFIG_CACHE,
+              config._LAST_EXPANDED_CONFIG_BY_PATH, config_effective._EFFECTIVE_CACHE,
+              config_effective._LAST_GOOD_USER_RAW]
+    old_key, root_key = str(old / 'config.yaml'), str(root / 'config.yaml')
+    assert all(old_key in cache and root_key in cache for cache in caches)
+    held = [cache[root_key] for cache in caches]
+    # Synthetic profiles own no OS services/backends; exercise native filesystem and identity paths.
+    for name in ['_cleanup_gateway_service', '_stop_profile_backends', '_stop_bot_desktop',
+                 '_maybe_unregister_gateway_service', '_maybe_register_gateway_service']:
+        monkeypatch.setattr(profiles, name, lambda *args: None)
+    monkeypatch.setattr(profiles, '_check_gateway_running', lambda path: False)
+    monkeypatch.setattr(profiles, '_live_default_multiplexer', lambda: False)
+    monkeypatch.setattr(profiles, 'check_alias_collision', lambda name: 'fixture skips shell alias')
+    if operation == 'delete':
+        profiles.delete_profile('retiring', yes=True)
+    else:
+        profiles.rename_profile('retiring', 'renamed')
+    assert not old.exists()
+    assert all(old_key not in cache for cache in caches)
+    assert all(cache[root_key] is value for cache, value in zip(caches, held))
