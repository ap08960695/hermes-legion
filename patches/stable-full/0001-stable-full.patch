+
+
+def test_concurrent_structured_queries_keep_connection_callbacks_isolated(db):
+    expected = {}
+    for index in range(8):
+        needle = f"uniqueword{index}"
+        expected[needle] = db.append_message(
+            "s", role="user", content=[{"type": "text", "text": needle}]
+        )
+
+    def search(needle):
+        result = call(db, session_id="s", query=needle)
+        return [hit["match_message_id"] for hit in result["results"]]
+
+    with ThreadPoolExecutor(max_workers=4) as executor:
+        needles = list(expected) * 3
+        results = list(executor.map(search, needles))
+    assert results == [[expected[needle]] for needle in needles]
