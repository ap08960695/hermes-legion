+"""Official Codex aliases must not probe catalogs after every response."""
+from decimal import Decimal
+
+import pytest
+
+from agent.usage_pricing import CanonicalUsage, estimate_usage_cost, resolve_billing_route
+
+
+@pytest.mark.parametrize(("provider", "base_url"), [
+    ("custom", "https://chatgpt.com/backend-api/codex"),
+    ("custom", "https://chatgpt.com/backend-api/codex/"),
+    ("custom", "https://chatgpt.com:443/backend-api/codex"),
+    ("custom:example", "https://chatgpt.com/backend-api/codex"),
+    (None, "https://chatgpt.com/backend-api/codex"),
+])
+def test_official_codex_alias_keeps_usage_without_catalog_probes(monkeypatch, provider, base_url):
+    def unexpected_catalog(*args, **kwargs):
+        pytest.fail("Subscription usage must not request a model catalog")
+
+    monkeypatch.setattr("agent.usage_pricing.fetch_endpoint_model_metadata", unexpected_catalog)
+    monkeypatch.setattr("agent.usage_pricing.fetch_model_metadata", unexpected_catalog)
+    usage = CanonicalUsage(input_tokens=7, output_tokens=3, cache_read_tokens=5)
+
+    route = resolve_billing_route("gpt-6.1-sol", provider=provider, base_url=base_url)
+    assert route.billing_mode == "subscription_included"
+    result = estimate_usage_cost("gpt-6.1-sol", usage, provider=provider, base_url=base_url)
+
+    assert result.status == "included"
+    assert result.amount_usd == Decimal(0)
+    assert (usage.prompt_tokens, usage.output_tokens, usage.cache_read_tokens) == (12, 3, 5)
+
+
+@pytest.mark.parametrize("base_url", [
+    "http://chatgpt.com/backend-api/codex",
+    "https://chatgpt.com:444/backend-api/codex",
+    "https://chatgpt.com.example.invalid/backend-api/codex",
+    "https://proxy.example.invalid/backend-api/codex",
+    "https://chatgpt.com/v1",
+    "https://chatgpt.com/backend-api/codex-proxy",
+    "https://chatgpt.com@proxy.example.invalid/backend-api/codex",
+    "https://api.openai.com/v1",
+])
+def test_nonofficial_custom_routes_do_not_inherit_subscription_pricing(base_url):
+    route = resolve_billing_route("gpt-6.1-sol", provider="custom", base_url=base_url)
+
+    assert route.billing_mode == "unknown"
