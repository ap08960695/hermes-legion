+import { afterEach, expect, it, vi } from 'vitest'
+
+import { clearSessionDraft, rotateFreshDraftKey, stashSessionDraft, takeSessionDraft } from '@/store/composer'
+
+import type { ChatBarProps } from '../types'
+
+import { createComposerSubmitDispatch } from './composer-submit-dispatch'
+
+const owner = { connectionId: 'submit-source', profile: 'work' }
+const first = '__new__:first-owner-lifecycle'
+const next = '__new__:next-owner-lifecycle'
+
+afterEach(() => {
+  clearSessionDraft(first, owner)
+  clearSessionDraft(next, owner)
+})
+
+it.each([true, false])('keeps the raw fresh lifecycle bound while a send settles (%s)', async accepted => {
+  let settle!: (accepted: boolean) => void
+
+  const pending = new Promise<boolean>(resolve => {
+    settle = resolve
+  })
+
+  const rawScope = { current: first as string | null }
+  const ownerRef = { current: owner }
+  const loaded = vi.fn()
+  const onSubmit = vi.fn<ChatBarProps['onSubmit']>(() => pending)
+
+  const send = createComposerSubmitDispatch({
+    draftScopeRef: rawScope,
+    draftOwnerRef: ownerRef,
+    onSubmit,
+    stashAt: (scope, text = '', attachments = [], captured) => {
+      stashSessionDraft(scope, text, attachments, captured)
+    },
+    loadIntoComposer: loaded
+  })
+
+  stashSessionDraft(first, 'Original fresh send', [], owner)
+  // The actual typed submit path consumes the clicked draft synchronously.
+  clearSessionDraft(first, owner)
+  send('Original fresh send')
+  rawScope.current = next
+  const actualNext = rotateFreshDraftKey()
+  stashSessionDraft(next, 'Keep next fresh draft', [], owner)
+  stashSessionDraft(actualNext, 'Keep ambient fresh lifecycle', [], owner)
+  settle(accepted)
+  await pending
+  await Promise.resolve()
+
+  expect(onSubmit.mock.calls[0]?.[1]?.composerScope).toBeNull()
+  expect(takeSessionDraft(next, owner).text).toBe('Keep next fresh draft')
+  expect(takeSessionDraft(actualNext, owner).text).toBe('Keep ambient fresh lifecycle')
+  expect(takeSessionDraft(first, owner).text).toBe(accepted ? '' : 'Original fresh send')
+  expect(loaded).not.toHaveBeenCalled()
+  clearSessionDraft(actualNext, owner)
+})
+
+it.each([false, true])('preserves a newer same-owner draft after admission (hidden: %s)', async hidden => {
+  let accept!: () => void
+
+  const pending = new Promise<boolean>(resolve => {
+    accept = () => resolve(true)
+  })
+
+  const ownerRef = { current: owner }
+  const loaded = vi.fn()
+
+  const send = createComposerSubmitDispatch({
+    draftScopeRef: { current: first },
+    draftOwnerRef: ownerRef,
+    onSubmit: () => pending,
+    stashAt: (scope, text = '', attachments = [], captured) => stashSessionDraft(scope, text, attachments, captured),
+    loadIntoComposer: loaded
+  })
+
+  // Typed callers already cleared the editor before dispatch. Hidden callers
+  // never own its text. A user can type a follow-up while admission is pending.
+  send(hidden ? 'Machine setup note' : 'First submitted message', undefined, hidden ? 'hidden' : undefined)
+  stashSessionDraft(first, 'Keep my next unsent question', [], owner)
+  accept()
+  await pending
+  await Promise.resolve()
+
+  expect(takeSessionDraft(first, owner).text).toBe('Keep my next unsent question')
+  expect(loaded).not.toHaveBeenCalled()
+})
+
+it('an external accepted submit never consumes the editor draft it did not submit', async () => {
+  stashSessionDraft(first, 'Unrelated work in progress', [], owner)
+
+  const send = createComposerSubmitDispatch({
+    draftScopeRef: { current: first },
+    draftOwnerRef: { current: owner },
+    onSubmit: () => true,
+    stashAt: () => {
+      throw new Error('accepted request cannot restore')
+    },
+    loadIntoComposer: () => {
+      throw new Error('accepted request cannot repaint')
+    }
+  })
+
+  send('Text supplied by another surface')
+  await Promise.resolve()
+  await Promise.resolve()
+  expect(takeSessionDraft(first, owner).text).toBe('Unrelated work in progress')
+})
+
+it('keeps a newer live draft when the earlier send is rejected', async () => {
+  const stored = 'conflicting-send-draft'
+  let settle!: (value: boolean) => void
+
+  const pending = new Promise<boolean>(resolve => {
+    settle = resolve
+  })
+
+  const live = { text: '', attachments: [] }
+  const loaded = vi.fn()
+
+  const send = createComposerSubmitDispatch({
+    draftScopeRef: { current: stored },
+    draftOwnerRef: { current: owner },
+    onSubmit: () => pending,
+    readCurrentDraft: () => live,
+    stashAt: (scope, text = '', attachments = [], captured) => stashSessionDraft(scope, text, attachments, captured),
+    loadIntoComposer: loaded
+  })
+
+  send('Earlier message')
