+"""Predictive context belongs to the session, never a caller-supplied project/profile."""
+
+from pathlib import Path
+from unittest.mock import Mock
+
+import pytest
+
+from hermes_constants import get_hermes_home
+from tui_gateway import server
+
+
+def test_prompt_overview_uses_owning_session_scope(tmp_path, monkeypatch):
+    home = tmp_path / "profile"
+    home.mkdir()
+    (home / "config.yaml").write_text("{}")
+    project = str(tmp_path / "project")
+    monkeypatch.setitem(
+        server._sessions,
+        "prediction-scope",
+        {
+            "profile_home": str(home),
+            "session_key": "stored-session",
+            "cwd": project,
+            "running": False,
+            "agent": None,
+        },
+    )
+    seen = []
+
+    def overview(key, cwd):
+        seen.append((Path(get_hermes_home()), key, cwd))
+        return "Goal: resume; hold: never delete SIT"
+
+    monkeypatch.setattr("hermes_cli.prompt_suggestion_context.work_overview", overview)
+    generate = Mock(return_value="predict")
+    monkeypatch.setattr("agent.oneshot.run_oneshot", generate)
+    result = server._methods["llm.oneshot"](
+        "scope-test",
+        {
+            "session_id": "prediction-scope",
+            "template": "prompt_suggestions",
+            "variables": {
+                "scope": "forged",
+                "work_overview": "forged overview",
+                "draft": "ช่วย",
+            },
+            "input": "incidental last reply",
+        },
+    )
+    assert result["result"]["text"] == "predict"
+    assert seen == [(home, "stored-session", project)]
+    assert generate.call_args.kwargs["variables"] == {
+        "scope": "stored-session",
+        "work_overview": "Goal: resume; hold: never delete SIT",
+        "draft": "ช่วย",
+    }
+
+
+@pytest.mark.parametrize("session", [None, {"running": True}])
+def test_missing_or_busy_session_never_calls_prediction(tmp_path, monkeypatch, session):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    if session is not None:
+        monkeypatch.setitem(server._sessions, "prediction-busy", session)
+    generate = Mock(side_effect=AssertionError("must not generate"))
+    overview = Mock(side_effect=AssertionError("must not read overview"))
+    monkeypatch.setattr("agent.oneshot.run_oneshot", generate)
+    monkeypatch.setattr("hermes_cli.prompt_suggestion_context.work_overview", overview)
+    result = server._methods["llm.oneshot"](
+        "busy-test",
+        {
+            "session_id": "prediction-busy",
+            "template": "prompt_suggestions",
+            "input": "hello",
+        },
+    )
+    assert result["result"]["text"] == ""
+    generate.assert_not_called()
+    overview.assert_not_called()
