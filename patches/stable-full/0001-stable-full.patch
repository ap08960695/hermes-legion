@@ -0,0 +1,145 @@
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { MemoryRouter, useNavigate } from 'react-router'
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { setApiRequestConnection, setApiRequestLocalMode } from '@/api/client'
+import { useComposerDraft } from '@/app/chat/composer/hooks/use-composer-draft'
+import { useComposerDraftOwner } from '@/app/chat/composer/hooks/use-composer-owner'
+import { composerPlainText } from '@/app/chat/composer/rich-editor'
+import {
+  clearSessionDraft,
+  mainComposerScope,
+  NEW_SESSION_DRAFT_KEY,
+  stashSessionDraft,
+  takeSessionDraft
+} from '@/store/composer'
+
+import { WorkspaceRoutes } from './workspace-routes'
+
+const runtime = vi.hoisted(() => ({
+  text: '',
+  setText(value: string) {
+    runtime.text = value
+  },
+  getState: () => ({ text: runtime.text }),
+  subscribe: () => () => undefined
+}))
+
+vi.mock('@assistant-ui/react', () => ({
+  useAui: () => ({ composer: () => runtime }),
+  useAuiState: (select: (state: { composer: { text: string } }) => unknown) =>
+    select({ composer: { text: runtime.text } }),
+  useComposerRuntime: () => runtime
+}))
+vi.mock('./surfaces', () => ({ SidebarSurface: () => null }))
+vi.mock('./panes', () => ({ setStatusbarItemGroup: () => {} }))
+
+function Draft() {
+  const owner = useComposerDraftOwner(null, undefined, NEW_SESSION_DRAFT_KEY)
+
+  const draft = useComposerDraft({
+    activeQueueSessionKey: NEW_SESSION_DRAFT_KEY,
+    draftOwner: owner,
+    focusKey: null,
+    inputDisabled: false,
+    queueEditRef: { current: null },
+    sessionId: null
+  })
+
+  return (
+    <div
+      aria-label="Draft"
+      contentEditable
+      data-slot="composer-rich-input"
+      onInput={() => draft.syncDraftFromEditor()}
+      ref={draft.editorRef}
+      role="textbox"
+      suppressContentEditableWarning
+    />
+  )
+}
+
+function Harness() {
+  const navigate = useNavigate()
+
+  return (
+    <>
+      <button onClick={() => navigate('/settings')} type="button">
+        Settings
+      </button>
+      <button onClick={() => navigate('/')} type="button">
+        Close settings
+      </button>
+      <WorkspaceRoutes actions={{} as never} chatView={<Draft />} routeContributions={[]} />
+    </>
+  )
+}
+
+afterEach(() => {
+  cleanup()
+  clearSessionDraft(NEW_SESSION_DRAFT_KEY, 'default')
+  clearSessionDraft(NEW_SESSION_DRAFT_KEY, { connectionId: 'local', profile: 'default' })
+  clearSessionDraft(NEW_SESSION_DRAFT_KEY, { connectionId: 'remote-draft', profile: 'default' })
+  mainComposerScope.clear()
+  setApiRequestConnection(null)
+  setApiRequestLocalMode(false)
+  runtime.text = ''
+})
+
+it('restores a first-visit Settings draft when the Local pool gains its explicit registry tag', () => {
+  setApiRequestLocalMode(true)
+  setApiRequestConnection(null)
+  render(
+    <MemoryRouter initialEntries={['/']}>
+      <Harness />
+    </MemoryRouter>
+  )
+  const text = 'ทดสอบ Settings — keep this draft'
+  fireEvent.input(screen.getByRole('textbox', { name: 'Draft' }), { target: { textContent: text } })
+  const actual = runtime.text
+  expect(actual).toBe(text)
+  fireEvent.click(screen.getByRole('button', { name: 'Settings' }))
+  expect(screen.queryByRole('textbox')).toBeNull()
+  act(() => setApiRequestConnection('local'))
+  fireEvent.click(screen.getByRole('button', { name: 'Close settings' }))
+  expect(composerPlainText(screen.getByRole('textbox', { name: 'Draft' }))).toBe(actual)
+  expect(runtime.text).toBe(actual)
+})
+
+it('keeps the first Settings draft when legacy Local mode resolves after the composer mounted', () => {
+  setApiRequestLocalMode(false)
+  setApiRequestConnection(null)
+  render(
+    <MemoryRouter initialEntries={['/']}>
+      <Harness />
+    </MemoryRouter>
+  )
+  act(() => setApiRequestLocalMode(true))
+  const text = 'ทดสอบ Local startup — keep this draft'
+  fireEvent.input(screen.getByRole('textbox', { name: 'Draft' }), { target: { textContent: text } })
+  expect(runtime.text).toBe(text)
+  fireEvent.click(screen.getByRole('button', { name: 'Settings' }))
+  expect(screen.queryByRole('textbox')).toBeNull()
+  fireEvent.click(screen.getByRole('button', { name: 'Close settings' }))
+  expect(composerPlainText(screen.getByRole('textbox', { name: 'Draft' }))).toBe(text)
+  expect(runtime.text).toBe(text)
