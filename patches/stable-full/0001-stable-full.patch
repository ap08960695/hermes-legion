+def test_alias_metadata_edits_are_not_hidden_by_another_cache(fleet):
+    from tools.kanban_tools import _skills_available_for
+    from tools.skills_tool import clear_skills_cache
+    _skill(fleet, 'alpha', 'folder-name', 'before-name')
+    assert _skills_available_for('alpha', ['before-name']) == (['before-name'], [])
+    _skill(fleet, 'alpha', 'folder-name', 'after-name')
+    clear_skills_cache()
+    assert _skills_available_for('alpha', ['before-name', 'after-name']) == (['after-name'], ['before-name'])
+
+
+@pytest.mark.require_symlinks
+def test_repeated_symlink_views_do_not_make_one_alias_ambiguous(fleet):
+    from tools.kanban_tools import _skills_available_for
+    from tools.skills_tool import _skill_catalog
+    from hermes_cli.kanban_profile_config import assignee_config
+    path = _skill(fleet, 'alpha', 'real-folder', 'published-name')
