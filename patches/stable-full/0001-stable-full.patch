+"""Slow search telemetry must not record the user's search text."""
+import logging
+
+import pytest
+
+import hermes_state_search
+from hermes_state import SessionDB
+
+
+@pytest.mark.parametrize('scenario', ['hit', 'miss', 'error'])
+def test_slow_search_logging_omits_the_query(tmp_path, caplog, monkeypatch, scenario):
+    store = SessionDB(tmp_path / 'state.db')
+    query = 'sensitive-example-needle'
+    try:
+        store.create_session('synthetic', source='cli')
+        expected = store.append_message('synthetic', role='user', content=query)
+        monkeypatch.setattr(hermes_state_search, '_search_slow_ms', lambda: 0)
+        caplog.set_level(logging.INFO, logger='hermes_state')
+        if scenario == 'error':
+            def fail(*args, **kwargs):
+                raise RuntimeError('synthetic search failure')
+            monkeypatch.setattr(type(store), '_search_messages_impl', fail)
+            with pytest.raises(RuntimeError, match='synthetic search failure'):
+                store.search_messages(query)
+        else:
+            rows = store.search_messages(query if scenario == 'hit' else query + '-missing')
+            if scenario == 'hit':
+                assert [row['id'] for row in rows] == [expected]
+        records = [record.getMessage() for record in caplog.records if 'slow session search:' in record.getMessage()]
+        assert len(records) == 1
+        assert 'sensitive-example-needle' not in records[0]
+        assert 'query_chars=' in records[0]
+        assert ('rows=err' in records[0]) == (scenario == 'error')
+    finally:
+        store.close()
