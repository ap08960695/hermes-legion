+        c.db._conn.execute("CREATE TRIGGER refuse_memory_prefix BEFORE INSERT ON messages "
+            "BEGIN SELECT RAISE(ABORT, 'fixture: prefix rollback'); END")
+    c.agent._compress_context(c.messages, "trusted updated context", approx_tokens=120_000,
+        force=True, commit_fence=CompressionCommitFence())
+    assert store._system_prompt_snapshot == before
+    assert c.agent._memory_store is store
