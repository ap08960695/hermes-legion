@@ -0,0 +1,161 @@
+"""Durable source-preserving updates using the existing Git store and interrupted-update marker."""
+from __future__ import annotations
+
+import base64
+import os
+from pathlib import Path
+import shutil
+import tempfile
+import uuid
+
+from hermes_cli import update_preservation_io as io
+
+
+def prepare(root, metadata):
+    """Pin original source and index before native stash can remove a single local file."""
+    from hermes_cli import update_cmd_commit as commit
+    from hermes_cli._early_recovery import interrupted_pull_marker
+
+    root = Path(root).resolve()
+    if interrupted_pull_marker(root).exists():
+        raise OSError('An earlier source update still requires recovery')
+    directory = io.git_dir(root) / 'hermes-preservation'
+    directory.mkdir(mode=0o700, exist_ok=True)
+    path = directory / uuid.uuid4().hex
+    path.mkdir(mode=0o700)
+    before = io.git(root, 'rev-parse', 'HEAD').decode().strip()
+    branch = io.git(root, 'rev-parse', '--symbolic-full-name', 'HEAD').decode().strip()
+    raw = io.read_index(root)
+    if raw is None:
+        raise OSError('Source index is absent; preservation did not start')
+    io.replace_bytes(path / 'original.index', raw)
+    io.replace_bytes(path / 'staged.index', raw)
+    index_tree = io.indexed_tree(root, path / 'staged.index')
+    tree = io.capture_tree(root, path / 'snapshot.index')
+    ref = f'refs/hermes-preservation/{path.name}/snapshot'
+    index_commit = io.pin_tree(root, index_tree, ref, [before])
+    snapshot = io.pin_tree(root, tree, ref, [before, index_commit])
+    state = {'version': 1, 'root': str(root), 'before': before, 'branch': branch,
+             'snapshot': snapshot, 'index_tree': index_tree, 'metadata': metadata,
+             'targets': [], 'phase': 'prepared', 'stash': ''}
+    io.save(path, state)
+    commit.publish_recovery_closure(['git'], root, snapshot, preserve=True)
+    if io.read_index(root) != raw or io.capture_tree(root, path / 'verify.index') != tree:
+        raise OSError('Source changed during preservation; update did not start')
+    commit.arm_tree_move(['git'], root, pre=before, target=before, stash=None,
+                         preservation=(path, state))
+    _retire_previous(root, path)
+
+
+def _retire_previous(root, current):
+    """Only retire a completed owned generation after the replacement is durable."""
+    for old in current.parent.iterdir():
+        if old == current or old.is_symlink() or not old.is_dir():
+            continue
+        try:
+            saved = io.capsule(root, {'preserve': old.name})
+        except (OSError, ValueError):
+            continue
+        if saved and not saved[1].get('kept_files') and saved[1]['phase'] in ('source_ready', 'recovered'):
+            for suffix in ('snapshot', 'plan'):
+                io.git(root, 'update-ref', '-d', f'refs/hermes-preservation/{old.name}/{suffix}')
+            shutil.rmtree(old)
+
+
+def record_move(root, target, *, preservation=None):
+    active = preservation or io.capsule(root)
+    if active is None:
+        return ''
+    path, state = active
+    if target not in state['targets']:
+        state['targets'].append(target)
+    state['phase'] = 'moving'
+    io.save(path, state)
+    return f'preserve={path.name}\nrecovery={state["snapshot"]}\n'
+
+
+def before_stash(root):
+    active = io.capsule(root)
+    if active is None:
+        return ''
+    path, state = active
+    if io.read_index(root) != (path / 'original.index').read_bytes():
+        raise OSError('Source index changed before stashing; update refused')
+    if io.capture_tree(root, path / 'verify.index') != io.git(root, 'rev-parse', state['snapshot'] + '^{tree}').decode().strip():
+        raise OSError('Source files changed before stashing; update refused')
+    state['phase'] = 'stashing'
+    io.save(path, state)
+    return '-' + path.name
+
+
+def after_stash(root, stash):
+    active = io.capsule(root)
+    if active:
+        path, state = active
+        state.update(stash=stash, phase='stashed')
+        io.save(path, state)
+
+
+def record_obligations(root, before, armed, host, owner):
+    active = io.capsule(root)
+    if active is None:
+        return
+    path, state = active
+    encode = lambda data: base64.b64encode(data).decode() if data is not None else None
+    original = {record['path']: record['before'] for record in state.get('obligations', [])}
+    state['obligations'] = [{'path': str(p), 'before': original.get(str(p), encode(data)),
+                             'armed': encode(armed[p])} for p, data in before.items() if p != host]
+    state.update(host_path=str(host), host_owner=owner)
+    io.save(path, state)
+
+
+def plan_restore(root, stash):
+    """Apply in a disposable linked worktree before the live stash restore writes anything."""
+    active = io.capsule(root)
+    if active is None:
+        return
+    path, state = active
+    target = io.git(root, 'rev-parse', 'HEAD').decode().strip()
+    staging = Path(tempfile.mkdtemp(prefix='merge-', dir=path))
+    staging.rmdir()
+    try:
+        io.git(root, 'worktree', 'add', '--detach', '--quiet', str(staging), target)
+        if stash:
+            io.git(staging, 'stash', 'apply', '--index', stash)
+        index_tree = io.indexed_tree(staging, io.git_dir(staging) / 'index')
+        tree = io.capture_tree(staging, path / 'plan.index')
+        ref = f'refs/hermes-preservation/{path.name}/plan'
+        index_commit = io.pin_tree(root, index_tree, ref, [target])
+        plan = io.pin_tree(root, tree, ref, [target, index_commit])
+        state.update(plan=plan, plan_index=index_tree, phase='restoring')
+        io.save(path, state)
+    finally:
+        if staging.exists():
+            io.git(root, 'worktree', 'remove', '--force', str(staging))
+
+
+def finish(root):
+    """Source-ready is distinct from native dependency/build/restart completion."""
+    from hermes_cli._early_recovery import interrupted_pull_marker
+
+    active = io.capsule(root)
+    if active is None:
+        return
+    path, state = active
+    expected = state.get('plan', state['snapshot'])
+    tree = io.git(root, 'rev-parse', expected + '^{tree}').decode().strip()
+    if io.capture_tree(root, path / 'verify.index') != tree:
+        raise OSError('Restored customizations differ from the durable source plan')
+    if io.inspect_index(root, path / 'inspection.index') != state.get('plan_index', state['index_tree']):
+        raise OSError('Restored source index differs from the durable source plan')
+    state['phase'] = 'source_ready'
+    io.save(path, state)
+    interrupted_pull_marker(root).unlink()
+
+
+def retire_move_marker(root):
+    """A source-preserving transaction keeps the marker until its patches are verified back."""
+    from hermes_cli._early_recovery import interrupted_pull_marker
+
+    if io.capsule(root) is None:
+        interrupted_pull_marker(root).unlink(missing_ok=True)
