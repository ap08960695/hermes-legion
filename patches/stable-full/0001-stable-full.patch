+"""Destination routing must not load prompt/tool context just to verify session existence."""
+import sqlite3
+
+import pytest
+
+from hermes_constants import get_hermes_home
+from hermes_state import SessionDB
+from tui_gateway import server
+from tui_gateway.session_kanban_lineage import destination_keys
+
+
+@pytest.fixture
+def state(monkeypatch):
+    db = SessionDB(get_hermes_home() / 'state.db')
+    db.create_session('ancestor', source='desktop', system_prompt='Synthetic context. ' * 32768)
+    db.append_message('ancestor', role='user', content='Keep the existing ownership gate.')
+    assert db.try_acquire_compression_lock('ancestor', 'fixture-rotation')
+    db.publish_compression_child(
+        parent_session_id='ancestor', child_session_id='continuation', source='desktop',
+        messages=[{'role': 'user', 'content': 'Continue within the existing gates.'}],
+        compression_lock_holder='fixture-rotation', require_compression_lease=True,
+    )
+    monkeypatch.setattr(server, '_get_db', lambda: db)
+    yield db
+    db.close()
+
+
+def deny_context_reads(action, table, column, *_):
+    if action == sqlite3.SQLITE_READ and (
+        table == 'system_prompts' and column == 'prompt'
+        or table == 'sessions' and column in {'system_prompt', 'tool_names'}
+    ):
+        return sqlite3.SQLITE_DENY
+    return sqlite3.SQLITE_OK
+
+
+@pytest.mark.parametrize('named_profile', [False, True])
+def test_native_destination_routing_needs_no_context_columns(state, monkeypatch, named_profile):
+    def guarded_reader(*args, **kwargs):
+        assert kwargs.get('read_only') is True
+        db = SessionDB(*args, **kwargs)
+        with db._read_ctx() as conn:
+            conn.set_authorizer(deny_context_reads)
+        return db
+
+    monkeypatch.setattr('hermes_state.SessionDB', guarded_reader)
+    record = {'session_key': 'continuation'}
+    if named_profile:
+        record['profile_home'] = str(get_hermes_home())
+    else:
+        with state._read_ctx() as conn:
+            conn.set_authorizer(deny_context_reads)
+    try:
+        assert destination_keys(record, ['ancestor', 'continuation', 'missing']) == {'ancestor', 'continuation'}
+        assert destination_keys({**record, 'session_key': 'ancestor'}, ['ancestor']) == set()
+    finally:
+        with state._read_ctx() as conn:
+            conn.set_authorizer(None)
+
+
+def test_missing_metadata_extension_keeps_legacy_adapter(state, monkeypatch):
+    class LegacyAdapter:
+        def __getattr__(self, name):
+            if name == 'get_session_metadata':
+                raise AttributeError(name)
+            return getattr(state, name)
+
+    monkeypatch.setattr(server, '_get_db', lambda: LegacyAdapter())
+    assert destination_keys({'session_key': 'continuation'}, ['ancestor']) == {'ancestor'}
+
+
+def test_present_metadata_failure_holds_work_without_full_context_retry(state, monkeypatch):
+    def refused(*args):
+        raise RuntimeError('Synthetic metadata failure')
+
+    def forbid_full_context(*args):
+        pytest.fail('A present failed metadata reader must not retry full context')
+
+    monkeypatch.setattr(state, 'get_session_metadata', refused)
+    monkeypatch.setattr(state, 'get_session', forbid_full_context)
+    assert destination_keys({'session_key': 'continuation'}, ['ancestor', 'continuation']) == set()
diff --git a/tests/tui_gateway/test_kanban_notification_preparation.py b/tests/tui_gateway/test_kanban_notification_preparation.py
