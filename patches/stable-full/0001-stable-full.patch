@@ -0,0 +1,60 @@
+"""Anthropic throttles use the configured fallback after credential recovery declines."""
+
+import json
+import time
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from agent import conversation_loop
+from agent.credential_pool import load_pool
+from agent.error_classifier import FailoverReason
+from agent.turn_recovery import route_classified_error
+from agent.turn_retry_state import TurnRetryState
+
+
+@pytest.mark.parametrize("provider,status,reason,expected", [
+    ("anthropic", 429, FailoverReason.rate_limit, "break"),
+    ("openrouter", 429, FailoverReason.rate_limit, "fallthrough"),
+    ("anthropic", 503, FailoverReason.server_error, "fallthrough"),
+])
+def test_unrecovered_throttle_uses_fallback_without_waiting_on_the_pool(
+    tmp_path, monkeypatch, provider, status, reason, expected
+):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    entries = [
+        {"id": f"key-{i}", "auth_type": "api_key", "source": "manual",
+         "access_token": f"test-key-{i}", "priority": i, "last_status": "ok"}
+        for i in range(2)
+    ]
+    (tmp_path / "auth.json").write_text(
+        json.dumps({"version": 1, "credential_pool": {provider: entries}}), encoding="utf-8",
+    )
+    pool = load_pool(provider)
+    assert pool.has_available() and len(pool.entries()) == 2
+    fallback = Mock(return_value=True)
+    agent = SimpleNamespace(
+        provider=provider, _credential_pool=pool, _fallback_index=0,
+        _fallback_chain=[{"provider": "openai-codex", "model": "gpt-6.1-sol"}],
+        _try_activate_fallback=fallback, _buffer_diagnostic_status=Mock(),
+    )
+    retry = TurnRetryState()
+    monkeypatch.setattr(conversation_loop, "_sync_failover_system_message", lambda *a: "system")
+    reset_at = time.time() + 3600
+    verdict = route_classified_error(
+        agent, SimpleNamespace(status_code=status), SimpleNamespace(reason=reason, is_auth=False),
+        retry, error_msg="provider unavailable", error_context={"reset_at": reset_at},
+        recovered_with_pool=False, base_url="https://api.anthropic.com", model="claude-opus-5-5",
+        messages=[], api_messages=[], system_message="system", active_system_prompt="system",
+        conversation_history=[], retry_count=1, max_retries=3, compression_attempts=0,
+        max_compression_attempts=2, api_call_count=1, effective_task_id=None,
+    )
+    assert verdict.action == expected
+    assert retry.restart_with_rebuilt_messages is (expected == "break")
+    if expected == "break":
+        fallback.assert_called_once_with(reason=reason, reset_at=reset_at)
+    else:
+        fallback.assert_not_called()
