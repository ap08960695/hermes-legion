+def test_overlapping_cross_plan_action_waits_for_owner_and_can_be_sequenced(world):
+    from hermes_cli.kanban_role_create import create_planned_task, preview_planned_action
+    from tools import kanban_tools as kt
+
+    conn, home, root = world
+    for name, mode, peer in [('tester-think', 'think', 'tester-action'), ('tester-action', 'action', 'tester-think')]:
+        config = home / 'profiles' / name
+        config.mkdir(parents=True)
+        (config / 'config.yaml').write_text('model:\n  default: offline-only\n')
+        configure_workflow(config, {'role': 'tester', 'mode': mode, 'family': 'gpt',
+                                     'counterpart': peer}, workflow_snapshot(config)['revision'])
+    tester = create(world, 'tester-think')
+    run = kb.claim_task(conn, tester)
+    value = plan()
+    value['role'] = 'tester'
+    value['steps'][0]['write_scope'] = ['src']
+    assert kb.complete_task(conn, tester, summary='Tester plan', metadata={'role_plan': value},
+                            expected_run_id=run.current_run_id, fire_lifecycle_hook=False)
+    checkout = root / 'checkout'
+    checkout.mkdir()
+    alias = root / 'checkout-alias'
+    alias.symlink_to(checkout, target_is_directory=True)
+    peer = create_planned_task(conn, title='Tester config check', plan_task=tester, plan_step='code',
+                               assignee='tester-action', workspace_kind='dir', workspace_path=str(checkout))
+    parent, _ = finish_plan(world)
+    params = dict(plan_task=parent, plan_step='code', assignee='developer-action',
+                  workspace_kind='dir', workspace_path=str(alias))
+    different = root / 'other'
+    different.mkdir()
+    scope = '\n```hermes-contract\n{"version":1,"write_scope":["src"]}\n```'
+    kb.create_task(conn, title='Separate checkout', body=scope, workspace_kind='dir', workspace_path=str(different))
+    kb.create_task(conn, title='Legacy card', workspace_kind='dir', workspace_path=str(checkout))
+    kb.create_task(conn, title='Explicitly read-only', body=scope.replace('["src"]', '[]'),
+                   workspace_kind='dir', workspace_path=str(checkout))
+    changes = conn.total_changes
+    preview = preview_planned_action(conn, **params)['preview']
+    assert conn.total_changes == changes
+    assert preview['different_checkout'] == 1
+    assert preview['insufficient_information'] == 1
+    assert preview['conflicts'][0]['task_id'] == peer
+    assert preview['conflicts'][0]['actor'] == 'tester-action'
+    assert preview['conflicts'][0]['paths'] == [{'planned': 'src/a.py', 'existing': 'src'}]
+    refused = json.loads(kt._handle_create({'title': 'Developer config', **params}))
+    assert refused['write_scope']['conflicts'] == preview['conflicts']
+    assert conn.execute('SELECT COUNT(*) FROM tasks WHERE assignee=?', ('developer-action',)).fetchone()[0] == 0
+
+    from hermes_cli.kanban_action_conflicts import ActionScopeDecision
+    incoming = kb.create_task(conn, title='Another concurrent edit', body=scope, workspace_kind='dir',
+                              workspace_path=str(checkout))
+    with pytest.raises(ActionScopeDecision) as stale:
+        create_planned_task(conn, title='Developer config', **params, action_decision=(preview['token'], 'proceed'))
+    fresh = stale.value.preview
+    assert {card['task_id'] for card in fresh['conflicts']} == {peer, incoming}
+    tid = create_planned_task(conn, title='Developer config', **params, action_decision=(fresh['token'], 'sequence'))
+    assert kb.get_task(conn, tid).status == 'todo'
+    assert set(kb.parent_ids(conn, tid)) == {parent, incoming, peer}
+    assert create_planned_task(conn, title='Developer config', **params, action_decision=(fresh['token'], 'sequence')) == tid
+
