+  it('restores the selection direction in an unchanged split draft', () => {
+    render(<Split />)
+    startRebind(editor => {
+      const text = editor.firstChild!
+
+      window.getSelection()?.setBaseAndExtent(text, 10, text, 6)
+    })
+    act(() => patchSessionTile('split', { runtimeId: 'new' }))
+
+    const editor = screen.getByRole('textbox')
+    const selection = window.getSelection()
+
+    expect(editor.ownerDocument.activeElement).toBe(editor)
+    expect(selection?.toString()).toBe('text')
+    expect(selection?.anchorOffset).toBe(10)
+    expect(selection?.focusOffset).toBe(6)
