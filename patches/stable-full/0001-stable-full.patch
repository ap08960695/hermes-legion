@@ -0,0 +1,63 @@
+"""One account identity at different usage endpoints must keep separate observations."""
+from datetime import UTC, datetime
+from unittest.mock import Mock
+
+import pytest
+
+from agent import account_usage, account_usage_cache as cache
+from agent.account_usage import AccountUsageSnapshot, AccountUsageWindow
+
+
+@pytest.fixture(autouse=True)
+def empty_cache(monkeypatch):
+    for name in ('_snapshots', '_started', '_last_try'):
+        monkeypatch.setattr(cache, name, {})
+    monkeypatch.setattr(cache, '_inflight', set())
+
+
+def snapshot(used, identity=None):
+    return AccountUsageSnapshot(
+        provider='openrouter', source='fixture', fetched_at=datetime.now(UTC),
+        windows=(AccountUsageWindow(label='quota', used_percent=used),), identity=identity,
+    )
+
+
+def test_explicit_account_observations_do_not_cross_routes():
+    for route, used in [('https://first.example/v1', 20), ('https://second.example/v1', 80)]:
+        cache.remember_account_usage('openrouter', snapshot(used), identity_id='same-id', base_url=route)
+    first = cache.cached_account_usage('openrouter', identity_id='same-id', base_url='https://first.example/v1/')
+    second = cache.cached_account_usage('openrouter', identity_id='same-id', base_url='https://second.example/v1')
+    assert first is not None and second is not None
+    assert first.windows[0].used_percent == 20
+    assert second.windows[0].used_percent == 80
+
+
+def test_identified_per_turn_observation_keeps_its_route():
+    value = snapshot(35, identity='trusted-id')
+    cache.remember_account_usage('openrouter', value, base_url='https://first.example/v1')
+    assert cache.cached_account_usage('openrouter', identity_id='trusted-id', base_url='https://first.example/v1') is value
+    assert cache.cached_account_usage('openrouter', identity_id='trusted-id', base_url='https://second.example/v1') is None
+
+
+def test_each_route_gets_one_refresh_and_reopening_is_throttled(monkeypatch):
+    fetch = Mock()
+    monkeypatch.setattr(account_usage, 'fetch_account_usage', fetch)
+    requests = [dict(provider='openrouter', identity_id='same-id', api_key='fixture-key', base_url=url)
+                for url in ('https://first.example/v1', 'https://second.example/v1')]
+    workers = cache.refresh_account_usage_entries_async(requests)
+    for worker in workers:
+        worker.join(5)
+        assert not worker.is_alive()
+    assert {call.kwargs['base_url'] for call in fetch.call_args_list} == {r['base_url'] for r in requests}
+    assert fetch.call_count == 2
+    assert cache.refresh_account_usage_entries_async(requests) == []
+
+
+def test_unqualified_legacy_reader_requires_an_unambiguous_route():
+    value = snapshot(20)
+    cache.remember_account_usage('openrouter', value, identity_id='same-id', base_url='https://first.example/v1')
+    assert cache.cached_account_usage('openrouter', identity_id='same-id') is value
+    # An explicitly default-route read must never borrow the unique custom-route observation.
+    assert cache.cached_account_usage('openrouter', identity_id='same-id', base_url=None) is None
+    cache.remember_account_usage('openrouter', snapshot(80), identity_id='same-id', base_url='https://second.example/v1')
+    assert cache.cached_account_usage('openrouter', identity_id='same-id') is None
