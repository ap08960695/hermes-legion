@@ -0,0 +1,53 @@
+"""Effort selected by native auxiliary configuration survives Responses translation."""
+from copy import deepcopy
+from types import SimpleNamespace
+
+import pytest
+
+from agent.auxiliary_client import _CodexCompletionsAdapter, _build_call_kwargs
+from agent.reasoning_limits import owner_reasoning_limits
+
+
+def responses(kwargs, *, model='gpt-6.1-terra', host='https://chatgpt.com/backend-api/codex'):
+    adapter = _CodexCompletionsAdapter(SimpleNamespace(base_url=host), model)
+    return adapter._build_responses_kwargs({'messages': [{'role': 'user', 'content': 'Synthetic task'}],
+                                           **kwargs})[0]
+
+
+@pytest.mark.parametrize('effort', ['low', 'high', 'max', 'none'])
+def test_chat_effort_carrier_survives_codex_translation(effort):
+    request = {'reasoning_effort': effort}
+    original = deepcopy(request)
+    result = responses(request)
+    assert result['reasoning']['effort'] == effort
+    assert request == original
+
+
+@pytest.mark.parametrize('carrier', ['reasoning_effort', 'extra_body'])
+def test_nested_chat_effort_and_responses_effort_are_understood(carrier):
+    request = ({'extra_body': {'reasoning_effort': 'high'}} if carrier == 'extra_body'
+               else {'reasoning': {'effort': 'high'}})
+    assert responses(request)['reasoning']['effort'] == 'high'
+
+
+def test_native_auxiliary_cap_reaches_the_final_codex_wire():
+    with owner_reasoning_limits({'gpt-6.1-terra': 'high'}):
+        request = _build_call_kwargs('openai', 'gpt-6.1-terra',
+            [{'role': 'user', 'content': 'Synthetic task'}],
+            extra_body={'reasoning_effort': 'max'})
+    assert responses(request)['reasoning']['effort'] == 'high'
+
+
+def test_existing_explicit_nested_disable_keeps_precedence():
+    result = responses({'reasoning_effort': 'high', 'extra_body': {'reasoning': {'enabled': False}}})
+    assert result['reasoning'] == {'effort': 'none'}
+    assert 'include' not in result
+
+
+def test_omitted_reasoning_remains_omitted_without_an_owner_cap():
+    assert 'reasoning' not in responses({})
+
+
+def test_model_without_reasoning_does_not_gain_an_unsupported_field():
+    result = responses({'reasoning_effort': 'high'}, model='gpt-4o', host='https://api.openai.com/v1')
+    assert 'reasoning' not in result
