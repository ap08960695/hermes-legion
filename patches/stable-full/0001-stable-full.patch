+"""Cross-bot reads share conversion, never access checks or per-task read receipts."""
+import json
+from unittest.mock import Mock
+from tests.tools.test_document_read_dedup import write_document, read
+from tools import read_extract, file_tools as ft
+
+
+def test_two_tasks_reuse_conversion_but_both_get_full_content(tmp_path, monkeypatch):
+    path=tmp_path/'shared.docx'; write_document(path,'Approved common document')
+    spy=Mock(wraps=read_extract.extract_document_bytes)
+    monkeypatch.setattr(read_extract,'extract_document_bytes',spy)
+    assert 'Approved common document' in read(path,task='a')['content']
+    assert 'Approved common document' in read(path,task='b')['content']
+    assert spy.call_count==1
+    monkeypatch.setattr(ft,'get_read_block_error',lambda path:'Access denied')
+    assert 'Access denied' in read(path,task='c')['error']
+    assert spy.call_count==1
+
+
+def test_changed_bytes_never_reuse_prior_conversion(tmp_path, monkeypatch):
+    path=tmp_path/'shared.docx'; write_document(path,'before')
+    spy=Mock(wraps=read_extract.extract_document_bytes)
+    monkeypatch.setattr(read_extract,'extract_document_bytes',spy)
+    assert 'before' in read(path,task='a')['content']
+    write_document(path,'after')
+    assert 'after' in read(path,task='b')['content']
+    assert spy.call_count==2
+
+
+def test_profiles_share_only_after_reading_identical_bytes(tmp_path, monkeypatch):
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    from tools.shared_document_cache import extract_shared
+    monkeypatch.setattr('hermes_constants.get_default_hermes_root',lambda **kw:tmp_path/'owner')
+    convert=Mock(return_value='derived text')
+    for name in ('alpha','beta'):
+        token=set_hermes_home_override(tmp_path/'owner'/'profiles'/name)
+        try:
+            assert extract_shared(b'authorized bytes','/same.docx',convert)=='derived text'
+        finally:
+            reset_hermes_home_override(token)
+    assert convert.call_count==1
+    assert extract_shared(b'changed bytes','/same.docx',convert)=='derived text'
+    assert convert.call_count==2
+
+
+def test_storage_failure_does_not_repeat_conversion(tmp_path, monkeypatch):
+    from tools import shared_document_cache as cache
+    monkeypatch.setattr(cache,'_root',lambda:tmp_path)
+    def broken(*args): raise OSError('disk full')
+    monkeypatch.setattr(cache,'_store',broken)
+    convert=Mock(return_value='success')
+    assert cache.extract_shared(b'data','/a.docx',convert)=='success'
+    assert convert.call_count==1
+
+
+def test_converter_failure_remains_failure(tmp_path, monkeypatch):
+    import pytest
+    from tools import shared_document_cache as cache
+    monkeypatch.setattr(cache,'_root',lambda:tmp_path)
+    failure=OSError('converter error'); convert=Mock(side_effect=failure)
+    with pytest.raises(OSError) as caught:
+        cache.extract_shared(b'data','/a.docx',convert)
+    assert caught.value is failure and convert.call_count==1
+
+
+def test_parallel_processes_convert_once_and_release_locks(tmp_path):
+    import os
+    import subprocess
+    import sys
+    from pathlib import Path
+    code='''
+from tools.shared_document_cache import extract_shared
+from pathlib import Path
+import sys
+root=Path(sys.argv[1])
+def convert(data,path):
+    with (root/'conversions').open('a') as f: f.write('conversion\\n')
+    return 'same result'
+assert extract_shared(b'authorized identical bytes','shared.docx',convert)=='same result'
+'''
+    env={**os.environ,'HERMES_HOME':str(tmp_path/'owner'),'PYTHONPATH':str(Path.cwd())}
+    children=[subprocess.Popen([sys.executable,'-c',code,str(tmp_path)],env=env,stdout=subprocess.PIPE,stderr=subprocess.PIPE) for _ in range(4)]
+    for child in children:
+        stdout,stderr=child.communicate(timeout=15)
+        assert child.returncode==0,stderr.decode()
+    assert (tmp_path/'conversions').read_text().splitlines()==['conversion']
+
+
+def test_busy_cache_never_starts_duplicate_conversion(monkeypatch):
+    import pytest
+    from contextlib import contextmanager
+    from tools import shared_document_cache as cache
+    from tools.cache_file_lock import CacheLockBusy
+    @contextmanager
+    def busy(*args):
+        raise CacheLockBusy('already running')
+        yield
+    monkeypatch.setattr(cache,'_lock',busy)
+    convert=Mock(return_value='must not run')
+    with pytest.raises(CacheLockBusy):
+        cache.extract_shared(b'bytes','/a.docx',convert)
+    convert.assert_not_called()
