+@pytest.mark.parametrize("case", ["missing", "traversal", "sheet-link", "metadata-link", "folder-link", "hardlink", "oversized", "huge-geometry", "animated", "malformed-metadata", "invalid-body", "declared-escape", "nested-link", "fallback-link"])
+def test_unavailable_or_unsafe_character_never_becomes_a_default_or_opens_external_art(fleet, tmp_path, monkeypatch, case):
+    server, home = fleet
+    pet = home / "profiles/alpha/pets/same"
+    sheet = pet / "spritesheet.png"
+    outside = tmp_path / "outside.png"
+    Image.new("RGBA", (1536, 1872), "green").save(outside)
+    slug = "same"
+    if case == "missing":
+        slug = "absent"
+    elif case == "traversal":
+        slug = "../same"
+    elif case == "sheet-link":
+        sheet.unlink(); sheet.symlink_to(outside)
+    elif case == "metadata-link":
+        (pet / "pet.json").unlink(); (pet / "pet.json").symlink_to(outside)
+    elif case == "folder-link":
+        pet.rename(pet.with_name("saved")); pet.symlink_to(pet.with_name("saved"), target_is_directory=True)
+    elif case == "hardlink":
+        sheet.unlink()
+        os.link(outside, sheet)
+    elif case == "oversized":
+        with sheet.open("ab") as stream:
+            stream.truncate(4 * 1024 * 1024 + 1)
+    elif case in ("declared-escape", "nested-link", "fallback-link"):
+        if case == "declared-escape":
+            declared, forbidden = str(outside), outside
+        elif case == "nested-link":
+            (pet / "linked").symlink_to(tmp_path, target_is_directory=True)
+            declared, forbidden = "linked/outside.png", pet / "linked/outside.png"
+        else:
+            sheet.unlink(); sheet.symlink_to(outside)
+            declared, forbidden = "", sheet
+        (pet / "pet.json").write_text(json.dumps({"spritesheetPath": declared}))
+        native_stat = os.stat
+        def confined_stat(path, *args, **kwargs):
+            if isinstance(path, (str, bytes, os.PathLike)) and Path(os.fsdecode(path)) == forbidden:
+                raise RuntimeError("character read probed an external reference before validation")
+            return native_stat(path, *args, **kwargs)
+        monkeypatch.setattr(os, "stat", confined_stat)
+    elif case == "malformed-metadata":
+        (pet / "pet.json").write_text("[]")
+    elif case == "invalid-body":
+        raw = bytearray(sheet.read_bytes())
+        raw[raw.index(b"IDAT") + 4] ^= 255
+        sheet.write_bytes(raw)
+    elif case == "huge-geometry":
+        Image.new("RGBA", (1920, 2080), "red").save(sheet)
+    else:
+        Image.new("RGBA", (1536, 1872), "red").save(sheet, save_all=True, append_images=[Image.new("RGBA", (1536, 1872), "blue")], duration=100, loop=0)
+    before = (home / "profiles/alpha/config.yaml").read_bytes()
+    response = server.handle_request({"id": case, "method": "pet.sprite", "params": {"profile": "alpha", "slug": slug}})
+    assert response.get("result") == {"enabled": False}, response
+    assert (home / "profiles/alpha/config.yaml").read_bytes() == before
+
+
+@pytest.mark.parametrize(("profile", "format", "rows"), [("alpha", "png", 9), ("beta", "webp", 8)])
+def test_half_atlas_preserves_native_layout_and_default_reply(fleet, monkeypatch, profile, format, rows):
+    server, home = fleet
+    sheet = home / "profiles" / profile / "pets/same" / f"spritesheet.{format}"
+    with Image.new("RGBA", (1536, rows * 208)) as source:
+        source.paste("red", (0, 0, 192, 208))
+        source.paste("blue", (192, 0, 384, 208))
+        source.putpixel((0, 208), (255, 255, 255, 9))
+        source.save(sheet, lossless=True)
+    before = sheet.read_bytes()
+
+    def rpc(**params):
+        return server.handle_request({
+            "id": "sprite", "method": "pet.sprite",
+            "params": {"profile": profile, "slug": "same", **params},
+        })
+
+    full = rpc()["result"]
+    resized = []
+    resize = Image.Image.resize
+
+    def count_resize(image, size, *args, **kwargs):
+        resized.append(size)
+        return resize(image, size, *args, **kwargs)
+
+    monkeypatch.setattr(Image.Image, "resize", count_resize)
+    compact_reply = rpc(variant="half")
+    assert not compact_reply.get("error"), compact_reply
+    compact = compact_reply["result"]
+    assert compact["enabled"] and compact["mime"] == "image/png"
+    assert (compact["frameW"], compact["frameH"]) == (96, 104)
+    assert compact["scale"] * compact["frameW"] == full["scale"] * full["frameW"]
+    assert {key: compact[key] for key in ("framesByState", "framesByRow", "stateRows")} == {
+        key: full[key] for key in ("framesByState", "framesByRow", "stateRows")
+    }
+    with Image.open(BytesIO(base64.b64decode(compact["spritesheetBase64"], validate=True))) as image:
+        assert image.size == (768, 104 * rows)
+        assert image.getpixel((95, 103)) == (255, 0, 0, 255)
+        assert image.getpixel((96, 103)) == (0, 0, 255, 255)
+        assert image.getpixel((192, 103))[3] == 0
+    assert rpc(variant="half")["result"] == compact
+    assert (768, 104 * rows) in resized
+    # Pillow uses an internal premultiplied resize as part of the first call.
+    resize_count = len(resized)
+    assert rpc(variant="half")["result"] == compact
+    assert len(resized) == resize_count
+    assert rpc()["result"] == full
+    assert rpc(variant="arbitrary")["error"]["code"] == 4000
+    assert base64.b64decode(full["spritesheetBase64"]) == before == sheet.read_bytes()
+
