+import { expect, test, vi } from 'vitest'
+
+import { createSshBackendStatuses, sshBackendFailure } from './ssh-backend-status'
+
+test('only the latest SSH attempt can update or retire its registry status', () => {
+  const publish = vi.fn()
+  const status = createSshBackendStatuses(publish)
+  const original = status.start('fixture', 'default')
+  original.update({ phase: 'queued' })
+  const current = status.start('fixture', 'other')
+  original.update({ phase: 'memory-wait' })
+  original.cancel()
+
+  expect(status.snapshot()).toEqual({ fixture: { phase: 'starting' } })
+  current.update({ phase: 'memory-wait' })
+  current.update({ phase: 'memory-wait' })
+  expect(publish).toHaveBeenCalledTimes(4)
+
+  current.update({ phase: 'ready' })
+  status.disconnect('default')
+  expect(status.snapshot()).toEqual({ fixture: { phase: 'ready' } })
+  status.disconnect('other')
+  expect(status.snapshot()).toEqual({})
+})
+
+test('SSH status exposes a classified failure and a retry time without sending raw diagnostics', () => {
+  const now = Date.now()
+  const status = sshBackendFailure({ kind: 'memory-admission', message: 'raw stderr' }, 1000)
+
+  expect(status).toMatchObject({ phase: 'disconnected', reason: 'memory-admission' })
+  expect(status.phase === 'disconnected' && status.retryNotBefore).toBeGreaterThanOrEqual(now + 1000)
+  expect(JSON.stringify(status)).not.toContain('raw stderr')
+})
diff --git a/apps/desktop/electron/ssh-backend-status.ts b/apps/desktop/electron/ssh-backend-status.ts
new file mode 100644
index 0000000000000000000000000000000000000000..491ab676b0fc5df7c9150d96c4dc842f32eea28e
--- /dev/null
+++ b/apps/desktop/electron/ssh-backend-status.ts
@@ -0,0 +1,77 @@
+export type SshStartupPhase = 'starting' | 'queued' | 'memory-wait'
+
+const failureReasons = [
+  'auth-failed',
+  'host-key-changed',
+  'interactive-auth',
+  'host-busy',
+  'memory-admission',
+  'queue-full',
+  'reconnect-backoff',
+  'timeout',
+  'unreachable'
+] as const
+
+export type SshFailureReason = (typeof failureReasons)[number] | 'unknown'
+
+export type SshBackendStatus =
+  { phase: SshStartupPhase | 'ready' } | { phase: 'disconnected'; reason: SshFailureReason; retryNotBefore?: number }
+
+export type SshBackendStatuses = Record<string, SshBackendStatus>
+
+export function sshBackendFailure(error: unknown, transportDelayMs = 0): SshBackendStatus {
+  const failure = error as { kind?: SshFailureReason; sshError?: SshFailureReason; retryAfterMs?: number } | null
+  const kind = failure?.sshError ?? failure?.kind ?? 'unknown'
+  const reason = kind !== 'unknown' && failureReasons.includes(kind) ? kind : 'unknown'
+  const delay = Math.max(failure?.retryAfterMs ?? 0, transportDelayMs)
+
+  return {
+    phase: 'disconnected',
+    reason,
+    ...(delay > 0 ? { retryNotBefore: Date.now() + delay } : {})
+  }
+}
+
+export function createSshBackendStatuses(publish: (snapshot: SshBackendStatuses) => void) {
+  const entries = new Map<string, { scope: string; status: SshBackendStatus }>()
+
+  const snapshot = (): SshBackendStatuses => Object.fromEntries([...entries].map(([id, entry]) => [id, entry.status]))
+
+  function clear(id: string) {
+    if (entries.delete(id)) {
+      publish(snapshot())
+    }
+  }
+
+  function disconnect(scope: string) {
+    for (const [id, entry] of entries) {
+      if (entry.scope === scope && entry.status.phase === 'ready') {
+        clear(id)
+      }
+    }
+  }
+
+  function start(id: string, scope: string) {
+    const entry: { scope: string; status: SshBackendStatus } = { scope, status: { phase: 'starting' } }
+    entries.set(id, entry)
+    publish(snapshot())
+
+    return {
+      update(status: SshBackendStatus) {
+        if (entries.get(id) !== entry || (entry.status.phase === status.phase && status.phase !== 'disconnected')) {
+          return
+        }
+
+        entry.status = status
+        publish(snapshot())
+      },
+      cancel() {
+        if (entries.get(id) === entry) {
+          clear(id)
+        }
+      }
+    }
+  }
+
+  return { clear, disconnect, snapshot, start }
+}
