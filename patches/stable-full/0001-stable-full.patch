+def test_readonly_cjk_snapshot_survives_concurrent_stale_marker(tmp_path, monkeypatch, cjk_so):
+    monkeypatch.setenv("HERMES_FTS5_CJK_SO", str(cjk_so))
+    writer = SessionDB(tmp_path / "state.db")
+    reader = None
+    entered, release = threading.Event(), threading.Event()
+    try:
+        assert writer._wal_active
+        writer.create_session("s", source="cli")
+        accented = writer.append_message("s", role="user", content="café 完成率")
+        plain = writer.append_message("s", role="user", content="cafe 完成率")
+        reader = SessionDB(writer.db_path, read_only=True)
+
+        def authorizer(action, table, _column, _db, _trigger):
+            if action == sqlite3.SQLITE_READ and table == "messages_fts_cjk":
+                entered.set()
+                if not release.wait(5):
+                    return sqlite3.SQLITE_DENY
+            return sqlite3.SQLITE_OK
+        reader._conn.set_authorizer(authorizer)
+
+        def mark_stale(conn):
+            conn.execute("INSERT INTO state_meta(key,value) VALUES('fts_cjk_stale','1')")
+            conn.execute(
+                "INSERT INTO messages_fts_cjk(messages_fts_cjk,rowid,content,tool_name,tool_calls) "
+                "VALUES('delete',?, ?, NULL, NULL)", (plain, "cafe 完成率"))
+        with ThreadPoolExecutor(max_workers=1) as pool:
+            future = pool.submit(reader.search_messages, '"café" AND 完成率', fields=["id"])
+            try:
+                assert entered.wait(4), "read-only search did not reach the CJK index"
+                writer._execute_write(mark_stale)
+            finally:
+                release.set()
+            assert {row["id"] for row in future.result(timeout=5)} == {accented, plain}
+        reader._conn.set_authorizer(None)
+        assert {row["id"] for row in reader.search_messages("完成率", fields=["id"])} == {accented, plain}
+    finally:
+        release.set()
+        if reader is not None:
+            reader.close()
+        writer.close()
+
