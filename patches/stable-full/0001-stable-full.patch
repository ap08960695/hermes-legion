+import { describe, expect, it } from 'vitest'
+
+import type { SessionInfo } from '@/types/hermes'
+
+import { rankGroups, withFreshLiveSessions } from './index'
+
+const row = (id: string, extra: Partial<SessionInfo> = {}) => ({ id, message_count: 2, ...extra }) as SessionInfo
+const noop = () => undefined
+
+describe('command palette quick results', () => {
+  it('never renders a heading with no rows under it', () => {
+    const groups = [
+      { heading: 'Projects', items: [] },
+      { heading: 'Go to', items: [{ icon: noop as never, id: 'a', label: 'Chat', run: noop }] }
+    ]
+
+    expect(rankGroups(groups, '').map(group => group.heading)).toEqual(['Go to'])
+  })
+
+  it('lists a chat the sidebar has but the fetched page does not, so its title matches', () => {
+    const fetched = [row('old')]
+    const live = [row('fresh'), row('old'), row('empty', { message_count: 0 }), row('gone', { archived: true })]
+
+    expect(withFreshLiveSessions(fetched, live).map(session => session.id)).toEqual(['fresh', 'old'])
+    expect(withFreshLiveSessions(fetched, [])).toBe(fetched)
+  })
+})
