new file mode 100644
index 0000000000000000000000000000000000000000..eb6857cd7bd538435378b86154f8ba38eeadad93
--- /dev/null
+++ b/tui_gateway/methods_pet_characters.py
@@ -0,0 +1,138 @@
+"""Read-only installed character atlases; global mascot selection stays separate."""
+import json
+import os
+from contextlib import contextmanager
+from pathlib import Path
+
+from .method_ctx import HandlerRegistry, bind_module
+
+_registry = HandlerRegistry()
+method = _registry.method
+_profile_scoped = _registry.profile_scoped
+
+
+def _character_slug(value) -> bool:
+    return (isinstance(value, str) and 1 <= len(value) <= 128 and value.isprintable()
+            and value.strip() == value and value not in (".", "..")
+            and Path(value).name == value and "\\" not in value)
+
+
+@contextmanager
+def _character_directory(parts, *, dir_fd=None):
+    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+    names = iter(parts)
+    directory = os.open(next(names, "."), flags, dir_fd=dir_fd)
+    try:
+        for name in names:
+            child = os.open(name, flags, dir_fd=directory)
+            os.close(directory)
+            directory = child
+        yield directory
+    finally:
+        os.close(directory)
+
+
+def _character_stamp(info):
+    return info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns
+
+
+def _read_character_file(directory, name, limit):
+    import stat
+
+    leaf = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
+    try:
+        before = os.fstat(leaf)
+        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size > limit:
+            raise ValueError("invalid character file")
+        with os.fdopen(leaf, "rb", closefd=False) as stream:
+            raw = stream.read(limit + 1)
+        if (len(raw) > limit or len(raw) != before.st_size or
+                _character_stamp(os.fstat(leaf)) != _character_stamp(before)):
+            raise ValueError("character file changed while reading")
+        return raw, before
+    finally:
+        os.close(leaf)
+
+
+def _character_snapshot(pack):
+    import stat
+
+    if any(stat.S_ISLNK(os.stat(name, dir_fd=pack, follow_symlinks=False).st_mode)
+           for name in os.listdir(pack)):
+        raise ValueError("character directory contains a symlink")
+    try:
+        raw, _ = _read_character_file(pack, "pet.json", 65536)
+        meta = json.loads(raw.decode("utf-8-sig"))
+    except FileNotFoundError:
+        meta = {}
+    if not isinstance(meta, dict):
+        raise ValueError("invalid character metadata")
+
+    declared = meta.get("spritesheetPath")
+    if declared is not None and (not isinstance(declared, str) or
+                                 (declared and (not declared.isprintable() or "\\" in declared))):
+        raise ValueError("invalid character sprite reference")
+    declared = (declared or "").strip()
+    candidates = ([declared] if declared else []) + ["spritesheet.webp", "spritesheet.png", "sprite.webp", "sprite.png"]
+    for candidate in candidates:
+        relative = Path(candidate)
+        if relative.is_absolute() or not relative.parts or ".." in relative.parts:
+            raise ValueError("character sprite must stay inside its directory")
+        try:
+            with _character_directory(relative.parts[:-1], dir_fd=pack) as directory:
+                raw, before = _read_character_file(directory, relative.name, 4 * 1024 * 1024)
+            return meta, relative, raw, before
+        except FileNotFoundError:
+            continue
+    raise FileNotFoundError("character has no installed spritesheet")
+
+
+@method("pet.sprite")
+@_profile_scoped
+def _character_sprite(rid, params: dict) -> dict:
+    from io import BytesIO
+
+    from PIL import Image
+    from agent.pet import constants, store
+
+    disabled = {"enabled": False}
+    variant = params.get("variant")
+    if variant not in (None, "half"):
+        return _err(rid, 4000, "invalid params for pet.sprite: variant: expected half")
+    slug = params.get("slug")
+    if (os.name != "posix" or not hasattr(os, "O_NOFOLLOW") or not hasattr(os, "O_DIRECTORY")
+            or not _character_slug(slug)):
+        return _ok(rid, disabled)
+    try:
+        home = get_hermes_home().resolve(strict=True)
+        pack_parts = ("pets", slug)
+        with _character_directory(home.parts) as home_fd:
+            with _character_directory(pack_parts, dir_fd=home_fd) as pack:
+                meta, relative, raw, before = _character_snapshot(pack)
+            directory = home.joinpath(*pack_parts)
+            pet = store.InstalledPet(slug, str(meta.get("displayName") or slug), "", directory, directory / relative)
+            with Image.open(BytesIO(raw), formats=("PNG", "WEBP")) as image:
+                if (getattr(image, "is_animated", False) or image.width * image.height > 3_000_000
+                        or image.width % constants.FRAME_W or image.height % constants.FRAME_H
+                        or not 6 <= image.width // constants.FRAME_W <= 9
+                        or image.height // constants.FRAME_H not in (8, 9)):
+                    return _ok(rid, disabled)
+                image.load()
+                payload = _pet_sprite_payload(pet, scale=constants.DEFAULT_SCALE, atlas=image,
+                                              atlas_bytes=raw, atlas_stat=before, half_resolution=variant == "half")
+            # Rewalk from the pinned home so a replaced pack or nested directory is also noticed.
+            with _character_directory((*pack_parts, *relative.parts[:-1]), dir_fd=home_fd) as parent:
+                after = os.stat(relative.name, dir_fd=parent, follow_symlinks=False)
+                if _character_stamp(before) != _character_stamp(after):
+                    return _ok(rid, disabled)
+        result = {"enabled": True, **payload}
+        weight = meta.get("motionWeight")
+        if weight in constants.MOTION_WEIGHTS:
+            result["motionWeight"] = weight
+        return _ok(rid, result)
+    except (OSError, NotImplementedError, ValueError, RecursionError, Image.DecompressionBombError):
+        return _ok(rid, disabled)
+
+
+def register(server) -> None:
+    bind_module(globals(), server)
