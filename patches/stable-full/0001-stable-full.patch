diff --git a/apps/desktop/src/plugins/kanban/planned-action-review.tsx b/apps/desktop/src/plugins/kanban/planned-action-review.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..fd15746a0b2cabb7c9e8bd6b5c4018695952a157
--- /dev/null
+++ b/apps/desktop/src/plugins/kanban/planned-action-review.tsx
@@ -0,0 +1,251 @@
+import { Button, host, Input } from '@hermes/plugin-sdk'
+import { useLayoutEffect, useMemo, useRef, useState } from 'react'
+
+import { $boardSlug, reviewPlannedAction } from './api'
+import type { ActionScopePreview, KanbanTaskFull, PlannedAction, PlannedActionInput } from './types'
+import { errText, useKanban } from './ui'
+
+export function PlannedActionReview({
+  onCreated,
+  onOpen,
+  plan,
+  task
+}: {
+  onCreated: () => void
+  onOpen: (id: string) => void
+  plan: PlannedAction
+  task: KanbanTaskFull
+}) {
+  const a = useKanban().work.action
+  const [stepId, setStepId] = useState(plan.steps[0].id)
+
+  const [kind, setKind] = useState<PlannedActionInput['workspace_kind']>(
+    task.workspace_kind === 'worktree' ? 'worktree' : task.workspace_kind === 'dir' ? 'dir' : 'scratch'
+  )
+
+  const [path, setPath] = useState(task.workspace_kind === 'dir' ? task.workspace_path || '' : '')
+  const [busy, setBusy] = useState(false)
+  const [feedback, setFeedback] = useState<{
+    version: symbol
+    preview: ActionScopePreview | null
+    message: string
+    recheck: boolean
+  }>()
+  const planKey = JSON.stringify(plan)
+  const version = useMemo(() => Symbol(planKey), [planKey])
+  const currentVersion = useRef<symbol | null>(version)
+  const submitting = useRef(false)
+  const checkButton = useRef<HTMLButtonElement>(null)
+  const confirmationChoices = useRef<HTMLDivElement>(null)
+  const step = plan.steps.find(item => item.id === stepId) ?? plan.steps[0]
+  const currentFeedback = feedback?.version === version ? feedback : undefined
+  const preview = currentFeedback?.preview ?? null
+  const titleCounts = new Map<string, number>()
+  for (const { title } of preview?.conflicts ?? []) {
+    titleCounts.set(title, (titleCounts.get(title) ?? 0) + 1)
+  }
+  const message = currentFeedback?.message
+  const recheck = currentFeedback?.recheck
+  const incomplete = preview !== null && (preview.scan_limited || preview.insufficient_information > 0)
+
+  useLayoutEffect(() => {
+    currentVersion.current = version
+    return () => { currentVersion.current = null }
+  }, [version])
+
+  const reset = () => setFeedback(undefined)
+  const showFeedback = (preview: ActionScopePreview | null, message = '', recheck = false) => {
+    setFeedback({ version, preview, message, recheck })
+  }
+
+  const submit = async (decision?: PlannedActionInput['decision']) => {
+    if (submitting.current || (decision && (!preview || recheck))) return
+    const connection = host.activeConnectionId()
+    const board = $boardSlug.get()
+    const sameScope = () => host.activeConnectionId() === connection && $boardSlug.get() === board
+    const checkingAgain = !decision && preview !== null
+    submitting.current = true
+    showFeedback(preview, '', checkingAgain)
+    setBusy(true)
+
+    try {
+      const result = await reviewPlannedAction(task.id, {
+        step: step.id,
+        workspace_kind: kind,
+        workspace_path: kind !== 'scratch' && path.trim() ? path.trim() : undefined,
+        ...(decision && preview ? { decision, token: preview.token } : {})
+      })
+
+      if (!sameScope()) return
+      if ('task_id' in result) {
+        if (decision || currentVersion.current === version) {
+          onCreated()
+          if (currentVersion.current !== null) onOpen(result.task_id)
+        }
+      } else if (currentVersion.current === version) {
+        const choices = confirmationChoices.current
+        if (result.changed && choices?.contains(choices.ownerDocument.activeElement)) {
+          checkButton.current?.focus()
+        }
+        showFeedback(result.preview, result.changed ? a.updated : '')
+      }
+    } catch (err) {
+      if (sameScope() && currentVersion.current === version) showFeedback(preview, errText(err), checkingAgain)
+    } finally {
+      submitting.current = false
+      setBusy(false)
+    }
+  }
+
+  return (
+    <details className="kanban-action-preflight">
+      <summary>{a.heading}</summary>
+      <fieldset>
+        <label>
+          {a.step}
+          <select
+            disabled={busy}
+            onChange={event => {
+              setStepId(event.target.value)
+              reset()
+            }}
+            value={step.id}
+          >
+            {plan.steps.map(item => (
+              <option key={item.id} value={item.id}>
+                {item.id}
+              </option>
+            ))}
+          </select>
+        </label>
+        <label>
+          {a.checkout}
+          <select
+            disabled={busy}
+            onChange={event => {
+              setKind(event.target.value as typeof kind)
+              reset()
+            }}
+            value={kind}
+          >
+            <option value="dir">{a.directory}</option>
+            <option value="worktree">{a.worktree}</option>
+            <option value="scratch">{a.scratch}</option>
+          </select>
+        </label>
+        {kind !== 'scratch' && (
+          <label>
+            {a.path}
+            <Input
+              disabled={busy}
+              onChange={event => {
+                setPath(event.target.value)
+                reset()
+              }}
+              value={path}
+            />
+          </label>
+        )}
+        <p>
+          <strong>{plan.actor}</strong> · {step.instructions}
+        </p>
+        <p>{step.write_scope.length ? a.plannedWrites : a.noWrites}</p>
+        {step.write_scope.length > 0 && (
+          <ul>
+            {step.write_scope.map(name => (
+              <li key={name}>
+                <code>{name}</code>
+              </li>
+            ))}
+          </ul>
+        )}
+        <Button
+          aria-busy={busy || undefined}
+          aria-disabled={busy || undefined}
+          className="aria-disabled:opacity-60"
+          onClick={() => void submit()}
+          ref={checkButton}
+          size="sm"
+          variant="outline"
+        >
+          {a.check}
+        </Button>
+        {message && <p role="status">{message}</p>}
+        {preview && (
+          <div aria-live="polite" className="kanban-action-preview">
+            {recheck && <p className="font-semibold">{busy ? a.rechecking : a.recheckFailed}</p>}
+            {incomplete && <p className="font-semibold">{a.incomplete}</p>}
+            {preview.conflicts.length ? (
+              <ul>
+                {preview.conflicts.map(card => (
+                  <li key={card.task_id}>
+                    <p>{a.overlap(preview.actor, card.actor || a.unavailable)}</p>
+                    <Button
+                      className="h-auto max-w-full whitespace-normal wrap-anywhere text-left"
+                      disabled={busy}
+                      onClick={() => onOpen(card.task_id)}
+                      size="sm"
+                      variant="ghost"
+                    >
+                      <span>
+                        {card.title}
+                        {(titleCounts.get(card.title) ?? 0) > 1 && <> · <code>{card.task_id}</code></>}
+                      </span>
+                    </Button>
+                    <ul>
+                      {card.paths.map(({ planned, existing }) => (
+                        <li key={JSON.stringify([planned, existing])}>
+                          <code>{planned}</code> ↔ <code>{existing}</code>
+                        </li>
+                      ))}
+                    </ul>
+                    {card.paths_limited && <p>{a.morePaths}</p>}
+                  </li>
+                ))}
+              </ul>
+            ) : !incomplete && <p>{a.noConflicts}</p>}
+            {preview.different_checkout > 0 && <p>{a.different(preview.different_checkout)}</p>}
+            {preview.insufficient_information > 0 && <p>{a.insufficient(preview.insufficient_information)}</p>}
+            {preview.scan_limited && <p>{a.limited}</p>}
+            {!recheck && (
+              <div className="kanban-action-choices" ref={confirmationChoices}>
+                <Button
+                  aria-disabled={busy || undefined}
+                  className="aria-disabled:opacity-60"
+                  onClick={() => void submit('proceed')}
+                  size="sm"
+                  variant="outline"
+                >
+                  {a.proceed}
+                </Button>
+                {preview.conflicts.length > 0 && (
+                  <Button
+                    aria-disabled={busy || undefined}
+                    className="aria-disabled:opacity-60"
+                    onClick={() => void submit('sequence')}
+                    size="sm"
+                  >
+                    {a.sequence}
+                  </Button>
+                )}
+                <Button
+                  disabled={busy}
+                  onClick={event => {
+                    if (event.currentTarget.ownerDocument.activeElement === event.currentTarget) {
+                      checkButton.current?.focus()
+                    }
+                    showFeedback(null, a.replan)
+                  }}
+                  size="sm"
+                  variant="ghost"
+                >
+                  {a.rescope}
+                </Button>
+              </div>
+            )}
+          </div>
+        )}
+      </fieldset>
+    </details>
+  )
+}
