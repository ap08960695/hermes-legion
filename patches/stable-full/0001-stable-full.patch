+                    if len(self.cache) > 128:
+                        self.cache.popitem(last=False)
+            else:
+                self.cache.move_to_end(key)
+            if cached:
+                return True
+        return False
+
+    def reject(self, raw, term, deadline, *, escape_checked=False):
+        previous = self.samples.get(term)
+        if previous and previous[0] >= 32 and previous[1] < 8 and previous[2] < 8:
+            return False
+        if (not isinstance(raw, str) or not raw.isascii() or not 1024 < len(raw) <= 16384
