+"""Desktop cache reads never probe credentials; explicit refresh stays scoped."""
+
+from datetime import datetime, timedelta, UTC
+import json
+
+from agent.account_usage import AccountUsageSnapshot, AccountUsageWindow
+from hermes_cli import account_usage_report as report
+
+
+def _entry(route=None):
+    return dict(
+        id="login",
+        label="My account",
+        source="manual",
+        auth_type="oauth",
+        access_token="fixture-secret",
+        **({"base_url": route} if route else {}),
+    )
+
+
+def _snapshot(age=0):
+    return AccountUsageSnapshot(
+        "anthropic",
+        "test",
+        datetime.now(UTC) - timedelta(seconds=age),
+        windows=(AccountUsageWindow("Week", 35),),
+    )
+
+
+def test_cache_only_does_not_query_provider(monkeypatch):
+    monkeypatch.setattr(
+        report, "read_credential_pool", lambda: {"anthropic": [_entry()]}
+    )
+    monkeypatch.setattr(report, "load_external_accounts", lambda *_: [])
+    monkeypatch.setattr(
+        report,
+        "fetch_account_usage",
+        lambda *_a, **_kw: (_ for _ in ()).throw(AssertionError("provider called")),
+    )
+    calls = []
+
+    def cached(provider, **kwargs):
+        calls.append((provider, kwargs))
+        return _snapshot()
+
+    monkeypatch.setattr(report, "cached_account_usage", cached)
+    (row,) = report.collect_accounts(refresh=False)
+    assert row["windows"][0]["remaining_percent"] == 65
+    assert len(calls) == 1 and calls[0][1]["identity_id"]
+    assert "base_url" in calls[0][1]
+    assert "fixture-secret" not in json.dumps(row)
+
+
+def test_stale_cache_retains_timestamp_without_numeric_reading(monkeypatch):
+    monkeypatch.setattr(
+        report, "read_credential_pool", lambda: {"anthropic": [_entry()]}
+    )
+    monkeypatch.setattr(report, "load_external_accounts", lambda *_: [])
+    monkeypatch.setattr(
+        report, "cached_account_usage", lambda *_a, **_kw: _snapshot(901)
+    )
+    (row,) = report.collect_accounts(refresh=False)
+    assert (
+        row["stale"]
+        and row["fetched_at"]
+        and row["windows"] == []
+        and row["state"] == "unknown"
+    )
+
+
+def test_same_identity_at_different_routes_has_distinct_opaque_ids(monkeypatch):
+    monkeypatch.setattr(
+        report,
+        "read_credential_pool",
+        lambda: {
+            "anthropic": [_entry("https://one.invalid"), _entry("https://two.invalid")]
+        },
+    )
+    monkeypatch.setattr(report, "load_external_accounts", lambda *_: [])
+    calls = []
+
+    def cached(_provider, **kw):
+        calls.append(kw["base_url"])
+
+    monkeypatch.setattr(report, "cached_account_usage", cached)
+    rows = report.collect_accounts(refresh=False)
+    assert len(rows) == 2 and len({r["id"] for r in rows}) == 2
+    assert len(set(calls)) == 2
+    assert "invalid" not in json.dumps(rows)
