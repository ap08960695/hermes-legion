@@ -0,0 +1,80 @@
+import type { RefObject } from 'react'
+
+import { translateNow } from '@/i18n'
+import { type ComposerAttachment, freshDraftScope, takeSessionDraft } from '@/store/composer'
+import { draftOwnerKey } from '@/store/composer-draft-owner'
+import { type ComposerDraftRetry, draftRetry, readDraftRetry, writeDraftRetry } from '@/store/composer-draft-retry'
+import { retainRejectedDraft } from '@/store/composer-rejected-drafts'
+import { notifyError } from '@/store/notifications'
+import type { SessionOwnerScope } from '@/store/session-request-router'
+
+export interface ComposerDraftRestoreArgs {
+  draftScopeRef: RefObject<string | null>
+  draftOwnerRef?: RefObject<SessionOwnerScope>
+  readCurrentDraft?: () => { text: string; attachments: ComposerAttachment[] }
+  stashAt: (scope: string | null, text?: string, attachments?: ComposerAttachment[], owner?: SessionOwnerScope) => void
+  rememberDraftRetry?: (scope: string | null, retry: ComposerDraftRetry, owner?: SessionOwnerScope) => void
+  loadIntoComposer: (text: string, attachments: ComposerAttachment[]) => void
+}
+
+/** Capture before awaiting: only an empty editor may receive the earlier input. */
+export function createComposerDraftRestorer(args: ComposerDraftRestoreArgs) {
+  return (
+    scope: string | null | (() => string),
+    text: string,
+    attachments: ComposerAttachment[],
+    owner: SessionOwnerScope = args.draftOwnerRef?.current,
+    submissionId?: string,
+    keepRetained = false
+  ) => {
+    const captured = typeof owner === 'object' && owner ? { ...owner } : owner
+    const source = typeof scope === 'function' ? scope : scope || freshDraftScope()
+
+    return () => {
+      const target = typeof source === 'function' ? source() : source
+
+      const sameEditor =
+        (args.draftScopeRef.current || freshDraftScope()) === target &&
+        draftOwnerKey(args.draftOwnerRef?.current) === draftOwnerKey(captured)
+
+      const current = (sameEditor ? args.readCurrentDraft?.() : undefined) ?? takeSessionDraft(target, captured)
+
+      if (
+        keepRetained ||
+        current.text.trim() ||
+        current.attachments.length ||
+        readDraftRetry(target, captured)?.recovery
+      ) {
+        if (sameEditor) {
+          args.stashAt(target, current.text, current.attachments, captured ?? null)
+        }
+
+        if (!retainRejectedDraft(target, text, attachments, captured, submissionId)) {
+          notifyError(
+            new Error('Could not persist the retained message: storage failure'),
+            translateNow('composer.retainedSendRestore')
+          )
+        }
+
+        return
+      }
+
+      args.stashAt(target, text, attachments, captured ?? null)
+
+      if (submissionId) {
+        const retry = draftRetry(submissionId, text, attachments)
+
+        // A background restore cannot publish retry state into the foreground editor.
+        if (sameEditor && args.rememberDraftRetry) {
+          args.rememberDraftRetry(target, retry, captured ?? null)
+        } else {
+          writeDraftRetry(target, retry, captured)
+        }
+      }
+
+      if (sameEditor) {
+        args.loadIntoComposer(text, attachments)
+      }
+    }
+  }
+}
