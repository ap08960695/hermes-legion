@@ -0,0 +1,34 @@
+import { useStore } from '@nanostores/react'
+
+import { $apiLocalMode, $apiRequestScope } from '@/api/client'
+import { sessionDraftOwner } from '@/store/session-draft-owner'
+import type { SessionOwnerScope } from '@/store/session-request-router'
+
+import { useComposerScope } from '../scope'
+
+/** Capture the recipient from the surface or runtime; ambient routing only fills an unknown owner. */
+export function useComposerDraftOwner(
+  sessionId: string | null | undefined,
+  explicit?: SessionOwnerScope,
+  fallbackId?: string | null
+): SessionOwnerScope {
+  'use no memo' // Owner lookup reads registries outside compiler-tracked arguments.
+
+  const surface = useComposerScope()
+  const id = sessionId || fallbackId
+  const ambient = useStore($apiRequestScope)
+  useStore($apiLocalMode)
+
+  if (explicit != null || surface.ownerRoute != null) {
+    return sessionDraftOwner(id, explicit ?? surface.ownerRoute)
+  }
+
+  if (surface.connectionId !== undefined || surface.profile !== undefined) {
+    const connectionId = surface.connectionId ?? ambient.connectionId
+    const profile = surface.profile || ambient.profile || 'default'
+
+    return connectionId ? { connectionId, profile } : profile
+  }
+
+  return sessionDraftOwner(id)
+}
