index 0000000000000000000000000000000000000000..0ea3b57a9ff963fdfcbfb9c04b7c04a19af4fea0
--- /dev/null
+++ b/apps/desktop/src/app/artifacts/library-availability.test.tsx
@@ -0,0 +1,53 @@
+import { renderHook, waitFor, cleanup } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+const io = vi.hoisted(() => ({ api: vi.fn() }))
+vi.mock('@/api/client', async original => ({
+  ...(await original<typeof import('@/api/client')>()),
+  hermesApiAs: io.api
+}))
+import { useLibraryAvailability } from './library-availability'
+const item = (value: string) => ({
+  id: value,
+  value,
+  label: value,
+  href: value,
+  kind: 'file' as const,
+  sessionId: 'origin-session',
+  timestamp: 1,
+  sessionTitle: 'Example',
+  profile: 'writer',
+  owner: { connectionId: 'origin-connection', profile: 'writer' }
+})
+afterEach(() => {
+  cleanup()
+  vi.clearAllMocks()
+})
+it('keeps unknown and unreadable items disabled and only permits an explicitly ready response', async () => {
+  const files = [item('ready.md'), item('missing.txt'), item('bundle.zip')]
+  io.api.mockResolvedValue({
+    files: [
+      { path: 'ready.md', state: 'ready' },
+      { path: 'missing.txt', state: 'missing' },
+      { path: 'bundle.zip', state: 'unsupported' }
+    ]
+  })
+  const { result } = renderHook(() => useLibraryAvailability(files))
+  expect(result.current['ready.md']).not.toBe('ready')
+  await waitFor(() => expect(result.current['ready.md']).toBe('ready'))
+  expect(result.current['missing.txt']).toBe('missing')
+  expect(result.current['bundle.zip']).toBe('unsupported')
+  expect(io.api).toHaveBeenCalledTimes(1)
+  expect(io.api.mock.calls[0][0]).toEqual(files[0].owner)
+  expect(io.api.mock.calls[0][1].body).toEqual({
+    session_id: 'origin-session',
+    paths: files.map(x => x.value)
+  })
+})
+it('bounds batches and treats absent results as unavailable without retrying', async () => {
+  const files = Array.from({ length: 130 }, (_, i) => item(i + '.md'))
+  io.api.mockResolvedValue({ files: [] })
+  const { result } = renderHook(() => useLibraryAvailability(files))
+  await waitFor(() => expect(Object.values(result.current).filter(x => x === 'unavailable')).toHaveLength(130))
+  expect(io.api).toHaveBeenCalledTimes(3)
+  expect(io.api.mock.calls.every(([, req]) => req.body.paths.length <= 64)).toBe(true)
+})
