+
+const quote = (value: string) => `'${value.replaceAll("'", "'\\''")}'`
+const pause = (ms: number) => new Promise(resolve => setTimeout(resolve, ms))
+
+async function until(check: () => boolean, message: string, ms = 3000) {
+  const deadline = Date.now() + ms
+
+  while (Date.now() < deadline) {
+    if (check()) {
+      return
+    }
+
+    await pause(20)
+  }
+
+  assert.fail(message)
+}
+
+function running(pid: number) {
+  try {
+    process.kill(pid, 0)
+
+    return true
+  } catch {
+    return false
+  }
+}
+
+function localSession(modeledMemory = false) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'ssh-local-session-'))
+  const clients: ReturnType<typeof spawn>[] = []
+  const helpers: number[] = []
+
+  const connection = new SshConnection(
+    { host: 'mock.invalid', user: 'synthetic' },
+    {
+      mux: true,
+      controlDir: path.join(root, 'control'),
+      spawnFn(_binary, args, options) {
+        // A local shell models ONLY a remote session's pipes. Never invoke SSH.
+        let command = args.includes('-O') ? 'exit 0' : args.at(-1)
+
+        if (modeledMemory) {command = command.replaceAll('/usr/bin/vm_stat', path.join(root, 'vm-stat'))}
+
+        const proc = spawn('/bin/sh', ['-c', command], {
+          ...options,
+          cwd: root,
+          env: { HOME: root, PATH: `${root}/bin:/opt/homebrew/bin:/usr/bin:/bin` }
+        })
+
+        clients.push(proc)
+        const client: any = new EventEmitter()
+        client.stdin = proc.stdin
+        client.stdout = proc.stdout
+        client.stderr = proc.stderr
+
+        client.kill = () => {
+          // Losing a local mux client closes the remote channel input, not its PID.
+          proc.stdin?.end()
+          queueMicrotask(() => client.emit('close', null, 'SIGKILL'))
+
+          return true
+        }
+
+        proc.on('error', error => client.emit('error', error))
+        proc.on('close', (code, signal) => client.emit('close', code, signal))
+
+        return client
+      }
+    }
+  )
+
+  if (modeledMemory) {
+    fs.writeFileSync(path.join(root, 'vm-stat'), `#!/bin/sh
+printf '%s\\n' "$PPID" >> '${root}/probes'
+exec /bin/cat '${root}/memory'
+`, { mode: 0o700 })
+    fs.writeFileSync(path.join(root, 'memory'), 'unknown')
+  }
+
+  connection._opened = true
+  connection._posixRemote = true
+
+  return {
+    root,
+    connection,
+    clients,
+    helpers,
+    async cleanup() {
+      await connection.close()
+
+      for (const proc of clients) {
+        if (proc.exitCode === null && proc.signalCode === null) {
+          proc.kill('SIGKILL')
+        }
+      }
+
+      for (const pid of helpers) {
+        if (running(pid)) {
+          try {
+            process.kill(pid, 'SIGKILL')
+          } catch {
+            /* already reaped */
+          }
+        }
+      }
+
+      await pause(50)
+      fs.rmSync(root, { recursive: true, force: true })
+    }
+  }
+}
