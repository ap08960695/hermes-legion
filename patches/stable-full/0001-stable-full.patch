+
+def test_unreadable_content_remains_paused(sentinel_pair, monkeypatch):
+    profile, _ = sentinel_pair
+    profile.touch()
+    original = os.open
+
+    def guarded(path, flags, *args, **kwargs):
+        if os.fspath(path) == os.fspath(profile) and flags & os.O_ACCMODE == os.O_RDONLY:
+            raise PermissionError(errno.EACCES, "simulated unreadable sentinel")
+        return original(path, flags, *args, **kwargs)
+
+    monkeypatch.setattr(os, "open", guarded)
+    assert estop.is_engaged() is True
+    assert estop.get_state() == {"reason": None, "engaged_at": None}
