+
+    def small_string(self, span):
+        start, end = span
+        if end - start > 128:
+            return None
+        resume = self.blob.tell()
+        try:
+            self.blob.seek(start)
+            return json.loads(b'"' + self.blob.read(end - start) + b'"')
