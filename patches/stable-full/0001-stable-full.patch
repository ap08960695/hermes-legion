+"""Goal waiting sees followed work without mutating or escaping board scope."""
+from contextlib import closing
+from pathlib import Path
+import sqlite3
+
+import pytest
+
+from hermes_cli import goals, kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli import kanban_db_notify as notify
+
+
+@pytest.fixture
+def fleet(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    for name in ("HERMES_KANBAN_DB", "HERMES_KANBAN_BOARD", "HERMES_KANBAN_TASK", "HERMES_DELEGATED_CHILD_CONTEXT"):
+        monkeypatch.delenv(name, raising=False)
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(home))
+    goals._DB_CACHE.clear()
+    yield home
+    goals._DB_CACHE.clear()
+
+
+def _follow(board="default", *, chat="own-session", blocked=False, duplicate=False):
+    if board != "default":
+        kb.create_board(board)
+    with kbc.connect_closing(board=board) as conn:
+        task = kb.create_task(conn, title="synthetic", workspace_kind="scratch",
+                              initial_status="blocked" if blocked else "running")
+        notify.add_notify_sub(conn, task_id=task, platform="tui", chat_id=chat, delivery_mode="wake")
+        if duplicate:
+            notify.add_notify_sub(conn, task_id=task, platform="local", chat_id=chat, delivery_mode="wake")
+    return task
+
+
+def test_counts_followed_tasks_across_registered_live_boards(fleet):
+    _follow()
+    _follow("other")
+    assert goals.count_active_kanban_cards("own-session") == 2
+
+
+def test_current_board_selection_does_not_hide_other_followed_work(fleet):
+    _follow("left")
+    _follow("right")
+    kb.set_current_board("left")
+    assert goals.count_active_kanban_cards("own-session") == 2
+
+
+def test_empty_fleet_probe_creates_no_database_or_directories(fleet):
+    assert not list(fleet.iterdir())
+    assert goals.count_active_kanban_cards("own-session") == 0
+    assert not list(fleet.iterdir())
+
+
+def test_legacy_database_is_not_initialized_or_migrated(fleet):
+    path = fleet / "kanban.db"
+    with closing(sqlite3.connect(path)) as conn:
+        conn.execute("CREATE TABLE unrelated (id INTEGER)")
+        conn.commit()
+    before = path.read_bytes()
+    assert goals.count_active_kanban_cards("own-session") == 0
+    assert path.read_bytes() == before
+    with closing(sqlite3.connect(path)) as conn:
+        assert conn.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall() == [("unrelated",)]
+
+
+def test_same_task_notification_rows_count_once_and_other_chats_stay_out(fleet):
+    _follow(duplicate=True)
+    _follow(chat="another-session")
+    _follow(blocked=True)
+    assert goals.count_active_kanban_cards("own-session") == 1
+
+
+def test_archived_board_does_not_inflate_pending_work(fleet):
+    _follow()
+    _follow("retired")
+    kb.write_board_metadata("retired", archived=True)
+    assert goals.count_active_kanban_cards("own-session") == 1
+
+
+def test_same_database_alias_is_not_counted_twice(fleet):
+    _follow()
+    kb.write_board_metadata("alias")
+    kb.kanban_db_path(board="alias").symlink_to(kb.kanban_db_path(board="default"))
+    assert goals.count_active_kanban_cards("own-session") == 1
+
+
+def test_explicit_database_pin_does_not_enumerate_other_boards(fleet, monkeypatch):
+    _follow()
+    _follow("other")
+    monkeypatch.setenv("HERMES_KANBAN_DB", str(kb.kanban_db_path(board="default")))
+    def forbidden(**kwargs):
+        raise AssertionError("A pinned read must not enumerate the fleet")
+    monkeypatch.setattr(kb, "list_boards", forbidden)
+    assert goals.count_active_kanban_cards("own-session") == 1
+
+
+@pytest.mark.parametrize("fence", ["worker", "machine", "delegate"])
+def test_native_execution_fence_keeps_the_current_board(fleet, monkeypatch, fence):
+    _follow("left")
+    _follow("right")
+    kb.set_current_board("left")
+    if fence == "worker":
+        monkeypatch.setenv("HERMES_KANBAN_TASK", "synthetic-worker")
+        assert goals.count_active_kanban_cards("own-session") == 1
+    elif fence == "delegate":
+        monkeypatch.setenv("HERMES_DELEGATED_CHILD_CONTEXT", str(fleet))
+        assert goals.count_active_kanban_cards("own-session") == 1
+    else:
+        with kb.pin_first_board_resolution():
+            assert goals.count_active_kanban_cards("own-session") == 1
+
+
+def test_unreadable_sibling_does_not_hide_healthy_board_counts(fleet):
+    _follow()
+    _follow("healthy")
+    kb.write_board_metadata("broken")
+    kb.kanban_db_path(board="broken").write_bytes(b"synthetic non-SQLite data")
+    assert goals.count_active_kanban_cards("own-session") == 2
+
+
+def test_unregistered_other_fleet_is_not_enumerated(fleet, monkeypatch):
+    _follow()
+    with monkeypatch.context() as other:
+        root = fleet.parent / "separate-fleet"
+        root.mkdir()
+        other.setenv("HERMES_HOME", str(root))
+        other.setenv("HERMES_KANBAN_HOME", str(root))
+        _follow()
+        _follow("other")
+    assert goals.count_active_kanban_cards("own-session") == 1
+
+
+def test_committed_rows_in_uncheckpointed_wal_are_visible(fleet):
+    with kbc.connect_closing() as conn:
+        conn.execute("PRAGMA wal_checkpoint(TRUNCATE)")
+        task = kb.create_task(conn, title="synthetic WAL task", workspace_kind="scratch")
+        notify.add_notify_sub(conn, task_id=task, platform="tui", chat_id="own-session")
+        wal = Path(str(kb.kanban_db_path()) + "-wal")
+        assert wal.stat().st_size > 0
+        assert goals.count_active_kanban_cards("own-session") == 1
+
+
+def test_no_session_skips_board_discovery(fleet, monkeypatch):
+    def forbidden(**kwargs):
+        raise AssertionError("An unbound goal must not discover boards")
+    monkeypatch.setattr(kb, "list_boards", forbidden)
+    assert goals.count_active_kanban_cards(None) == 0
+    assert not list(fleet.iterdir())
+
+
+def test_goal_judge_sees_cross_board_count_and_then_parks_without_rejudging(fleet, monkeypatch):
+    _follow("left")
+    _follow("right")
+    manager = goals.GoalManager(session_id="own-session")
+    manager.set("finish the two original tasks", max_turns=3)
+    counts = []
+    def judge(*args, **kwargs):
+        counts.append(kwargs["active_kanban_cards"])
+        return "wait", "original tasks pending", False, {"seconds": 900}, False
+    monkeypatch.setattr(goals, "judge_goal", judge)
+    decision = manager.evaluate_after_turn("Both original tasks are pending")
+    assert counts == [2]
+    assert decision["verdict"] == "wait" and not decision["should_continue"]
+    assert manager.state.waiting_until > manager.state.last_turn_at
+    turns = manager.state.turns_used
+    again = manager.evaluate_after_turn("Still waiting")
+    assert not again["should_continue"] and counts == [2]
+    assert manager.state.turns_used == turns
