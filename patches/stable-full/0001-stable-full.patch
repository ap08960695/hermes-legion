+"""Conversation discovery needs identifying metadata, not prompt/tool context blobs."""
+import json
+import sqlite3
+
+import pytest
+
+from hermes_state import SessionDB
+from tools.session_search_tool import _get_session_meta, session_search
+
+
+@pytest.fixture
+def archive(tmp_path):
+    path = tmp_path / "state.db"
+    with SessionDB(path) as db:
+        db.create_session("archive", source="cli", model="offline-test-route",
+                          system_prompt="Synthetic context. " * 32768,
+                          model_config={"private_fixture": "x" * 32768})
+        db.set_session_title("archive", "Quarterly archive review")
+        db.append_message("archive", role="user", content="Remember the deployment checklist")
+        db.append_message("archive", role="assistant", content="Use the verified checklist")
+        db.end_session("archive", "cli_exit")
+        yield db, path
+
+
+def deny_context_reads(action, table, column, *_):
+    if action == sqlite3.SQLITE_READ and (
+        (table == "system_prompts" and column == "prompt")
+        or (table == "sessions" and column in {"system_prompt", "tool_names"})
+    ):
+        return sqlite3.SQLITE_DENY
+    return sqlite3.SQLITE_OK
+
+
+@pytest.mark.parametrize("read_only", [False, True])
+def test_native_search_keeps_metadata_when_context_reads_are_denied(archive, read_only):
+    writer, path = archive
+    db = SessionDB(path, read_only=True) if read_only else writer
+    with db._read_ctx() as connection:
+        connection.set_authorizer(deny_context_reads)
+    try:
+        result = json.loads(session_search(query="Quarterly archive review", db=db))
+        assert result["success"]
+        entry = next(row for row in result["results"] if row["matched_role"] == "session_title")
+        assert entry["source"] == "cli" and entry["model"] == "offline-test-route"
+        assert entry["title"] == "Quarterly archive review"
+        assert entry["messages"][0]["content"] == "Remember the deployment checklist"
+    finally:
+        with db._read_ctx() as connection:
+            connection.set_authorizer(None)
+        if read_only:
+            db.close()
+
+
+def test_native_metadata_is_small_fresh_and_missing_is_none(archive):
+    db, _ = archive
+    assert db.get_session_metadata("absent") is None
+    meta = db.get_session_metadata("archive")
+    assert set(meta) == {"id", "source", "model", "title", "parent_session_id",
+                         "started_at", "ended_at", "end_reason"}
+    assert meta["end_reason"] == "cli_exit" and meta["parent_session_id"] is None
+    db.set_session_title("archive", "Updated archive")
+    assert db.get_session_metadata("archive")["title"] == "Updated archive"
+    assert meta["title"] == "Quarterly archive review"
+
+
+def test_search_metadata_supports_an_older_adapter_without_extension(archive):
+    db, _ = archive
+
+    class LegacyAdapter:
+        def __getattr__(self, name):
+            if name == "get_session_metadata":
+                raise AttributeError(name)
+            return getattr(db, name)
+
+    assert _get_session_meta(LegacyAdapter(), "archive")["title"] == "Quarterly archive review"
+
+
+def test_failed_present_metadata_api_does_not_retry_full_context(archive, monkeypatch):
+    db, _ = archive
+
+    def refused(*args, **kwargs):
+        raise OSError("Synthetic metadata read failure")
+
+    def full_context_must_not_run(*args, **kwargs):
+        pytest.fail("A failed metadata read must not retry the full context reader")
+
+    monkeypatch.setattr(db, "get_session_metadata", refused, raising=False)
+    monkeypatch.setattr(db, "get_session", full_context_must_not_run)
+    assert _get_session_meta(db, "archive") == {}
+
+
+def test_title_resolution_keeps_canonical_bot_and_numbered_rules_without_context(archive):
+    db, _ = archive
+    db.create_session("continuation", source="cli")
+    db.set_session_title("continuation", "Quarterly archive review #2")
+    db._conn.execute("UPDATE sessions SET started_at=started_at+10 WHERE id='continuation'")
+    db.create_session("bot", source="cli")
+    db.set_session_title("bot", db.CANONICAL_BOT_CHAT_TITLE)
+    db.create_session("bot-sibling", source="cli")
+    db.set_session_title("bot-sibling", db.CANONICAL_BOT_CHAT_TITLE + " #2")
+    db._conn.execute("UPDATE sessions SET started_at=started_at+10 WHERE id='bot-sibling'")
+    db._conn.commit()
+    with db._read_ctx() as connection:
+        connection.set_authorizer(deny_context_reads)
+    try:
+        assert db.resolve_session_by_title("Quarterly archive review") == "continuation"
+        assert db.resolve_session_by_title(db.CANONICAL_BOT_CHAT_TITLE) == "bot"
+        assert db.resolve_session_by_title("Absent archive") is None
+    finally:
+        with db._read_ctx() as connection:
+            connection.set_authorizer(None)
+
+
+@pytest.mark.parametrize("read_only", [False, True])
+def test_session_id_resolution_does_not_load_context(archive, read_only):
+    def deny_id_context(action, table, column, *rest):
+        if action == sqlite3.SQLITE_READ and table == "sessions" and column == "model_config":
+            return sqlite3.SQLITE_DENY
+        return deny_context_reads(action, table, column, *rest)
+
+    writer, path = archive
+    db = SessionDB(path, read_only=True) if read_only else writer
+    with db._read_ctx() as connection:
+        connection.set_authorizer(deny_id_context)
+    try:
+        assert db.resolve_session_id("archive") == "archive"
+    finally:
+        with db._read_ctx() as connection:
+            connection.set_authorizer(None)
+        if read_only:
+            db.close()
+
+
+def test_session_id_resolution_keeps_exact_prefix_and_literal_rules(archive):
+    db, _ = archive
+    for sid in ("archive-child-a", "archive-child-b", "solo-session",
+                r"literal%_\target", r"literalAB\target", r"literal%X\target"):
+        db.create_session(sid, source="cli")
+    for query, expected in (
+        ("archive", "archive"),
+        ("archive-child", None),
+        ("solo-", "solo-session"),
+        (r"literal%_\t", r"literal%_\target"),
+        ("missing-session", None),
+    ):
+        assert db.resolve_session_id(query) == expected, query
+
+
+def test_session_id_resolution_flushes_pending_token_counts(archive):
+    db, _ = archive
+    # No writer starts, so resolution must drain this queued delta before returning.
+    db._token_queue.append(("archive", {"input_tokens": 17, "api_call_count": 1}))
+    assert db._conn.execute("SELECT input_tokens FROM sessions WHERE id='archive'").fetchone()[0] == 0
+    assert db.resolve_session_id("archive") == "archive"
+    row = db._conn.execute("SELECT input_tokens, api_call_count FROM sessions WHERE id='archive'").fetchone()
+    assert tuple(row) == (17, 1)
diff --git a/tests/hermes_state/test_sql_blob_reader.py b/tests/hermes_state/test_sql_blob_reader.py
new file mode 100644
index 0000000000000000000000000000000000000000..e1805d095e92ef3f73842773124df8679a7bf657
--- /dev/null
+++ b/tests/hermes_state/test_sql_blob_reader.py
@@ -0,0 +1,118 @@
+"""Byte-window readers preserve binary data, SQLite snapshots and caller state."""
+import sqlite3
+import tracemalloc
+
+import pytest
+
+from hermes_state_blob_reader import SQLiteBlobReader
+
+
+@pytest.mark.parametrize('payload', ['', 'a\x00ภาษาไทย café', b'\xff\x00\x80binary', 'x' * 2_000_000])
+def test_byte_reads_and_seeks_match_source(payload):
+    conn = sqlite3.connect(':memory:')
+    conn.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content)')
+    conn.execute('INSERT INTO messages VALUES(1,?)', (payload,))
+    expected = payload.encode() if isinstance(payload, str) else payload
+    try:
+        with SQLiteBlobReader(conn, 'content', 1) as view:
+            assert len(view) == len(expected)
+            assert view.read(6) == expected[:6]
+            assert view.tell() == min(6, len(expected))
+            view.seek(0)
+            parts = []
+            while part := view.read(65536):
+                parts.append(part)
+            assert b''.join(parts) == expected
+            view.seek(-min(3, len(expected)), 2)
+            assert view.read(10) == expected[len(expected) - min(3, len(expected)):]
+            with pytest.raises(ValueError):
+                view.seek(len(expected) + 1)
+        with pytest.raises(sqlite3.ProgrammingError):
+            view.read(1)
+        view.close()
+        assert conn.execute('SELECT count(*) FROM messages').fetchone()[0] == 1
+    finally:
+        conn.close()
+
+
+def test_anchor_preserves_snapshot_across_concurrent_update(tmp_path):
+    path = tmp_path / 'snapshot.db'
+    writer = sqlite3.connect(path, isolation_level=None)
+    writer.execute('PRAGMA journal_mode=WAL')
+    writer.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content TEXT)')
+    writer.execute("INSERT INTO messages VALUES(1,'old-value')")
+    reader = sqlite3.connect(path.as_uri() + '?mode=ro', uri=True)
+    reader.execute('PRAGMA query_only=ON')
+    try:
+        with SQLiteBlobReader(reader, 'content', 1) as view:
+            assert view.read(4) == b'old-'
+            writer.execute("UPDATE messages SET content='new-value' WHERE id=1")
+            assert view.read() == b'value'
+            view.seek(0)
+            assert view.read() == b'old-value'
+        with SQLiteBlobReader(reader, 'content', 1) as view:
+            assert view.read() == b'new-value'
+        assert reader.total_changes == 0
+        assert not reader.in_transaction
+    finally:
+        reader.close()
+        writer.close()
+
+
+def test_reader_leaves_caller_transaction_and_handler_intact():
+    conn = sqlite3.connect(':memory:')
+    conn.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content TEXT)')
+    conn.execute("INSERT INTO messages VALUES(1,'value')")
+    calls = []
+    conn.set_progress_handler(lambda: calls.append(1) or 0, 1)
+    try:
+        with SQLiteBlobReader(conn, 'content', 1) as view:
+            assert view.read() == b'value'
+        assert conn.in_transaction
+        before = len(calls)
+        conn.execute('SELECT count(*) FROM messages').fetchone()
+        assert len(calls) > before
+        conn.rollback()
+        assert conn.execute('SELECT count(*) FROM messages').fetchone()[0] == 0
+    finally:
+        conn.set_progress_handler(None, 0)
+        conn.close()
+
+
+@pytest.mark.parametrize(('field', 'mid'), [('content; DROP TABLE messages', 1), ('missing', 1)])
+def test_reader_refuses_unknown_columns(field, mid):
+    conn = sqlite3.connect(':memory:')
+    try:
+        with pytest.raises(ValueError):
+            SQLiteBlobReader(conn, field, mid)
+    finally:
+        conn.close()
+
+
+@pytest.mark.parametrize('mid', [1, 2])
+def test_reader_rejects_null_or_missing_fields(mid):
+    conn = sqlite3.connect(':memory:')
+    conn.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content)')
+    conn.execute('INSERT INTO messages VALUES(1,NULL)')
+    try:
+        with pytest.raises(sqlite3.OperationalError):
+            SQLiteBlobReader(conn, 'content', mid)
+    finally:
+        conn.close()
+
+
+def test_large_field_small_windows_keep_python_allocation_bounded():
+    conn = sqlite3.connect(':memory:')
+    conn.execute('CREATE TABLE messages(id INTEGER PRIMARY KEY, content TEXT)')
+    conn.execute('INSERT INTO messages VALUES(1,?)', ('x' * 2_000_000,))
+    tracemalloc.start()
+    try:
+        with SQLiteBlobReader(conn, 'content', 1) as view:
+            assert view.read(512) == b'x' * 512
+            view.seek(1_500_000)
+            assert view.read(512) == b'x' * 512
+            _, peak = tracemalloc.get_traced_memory()
+            assert peak < 256 * 1024
+    finally:
+        tracemalloc.stop()
+        conn.close()
