+
+def show_payload(kb, conn, task, *, full, summary):
+    """Keep the old view, while decoding only rows that can appear in that view."""
+    from tools import kanban_tools as tool
+
+    task_id = task.id
+    history, totals = _history(kb, conn, task_id, full)
+    payload = {
+        "task": tool._fields(task, tool._TASK_FIELDS),
+        "parents": kb.parent_ids(conn, task_id),
+        "unsatisfied_parents": [
+            {"id": pid, "status": status} for pid, status in kb.unsatisfied_parents(conn, task_id)
+        ],
+        "children": kb.child_ids(conn, task_id),
+        "comments": [tool._fields(row, tool._COMMENT_FIELDS) for row in history["comments"]],
+        "events": [tool._fields(row, tool._EVENT_FIELDS) for row in history["events"]],
+        "runs": [tool._fields(row, tool._RUN_FIELDS) for row in history["runs"]],
+    }
+    if full:
+        payload["worker_context"] = kb.build_worker_context(conn, task_id)
+        return payload
+    if summary:
+        result = tool._summary_show_payload(payload)
+        result["runs"] = totals["runs"]
+        return result
+    result = tool._compact_show_payload(payload)
+    result["compact_view"].update(comments_total=totals["comments"], runs_total=totals["runs"])
+    return result
