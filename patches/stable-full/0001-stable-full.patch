diff --git a/hermes_cli/account_usage_native_agy.py b/hermes_cli/account_usage_native_agy.py
new file mode 100644
index 0000000000000000000000000000000000000000..43b3dc65a69a049f51ce585991f8dedccb5737c6
--- /dev/null
+++ b/hermes_cli/account_usage_native_agy.py
@@ -0,0 +1,138 @@
+"""Read current AGY keyring sessions using the native metadata-only /usage command."""
+
+from datetime import datetime, UTC
+import json
+import math
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+
+PROVIDER = "antigravity-subscription-directsdk"
+
+
+def parse_native_usage(text):
+    doc = json.loads(text)
+    command = doc.get("command") or {}
+    usage = doc.get("usage") or {}
+    if (
+        doc.get("status") != "SUCCESS"
+        or command.get("name") != "usage"
+        or doc.get("num_turns") != 0
+        or usage.get("total_tokens") != 0
+        or any(value != 0 for value in usage.values())
+    ):
+        raise ValueError("Not a zero-turn native usage receipt")
+    groups = (command.get("data") or {}).get("groups")
+    if not isinstance(groups, list):
+        raise ValueError("Missing native quota groups")
+    windows = []
+    for group in groups:
+        if not isinstance(group, dict):
+            continue
+        for bucket in group.get("buckets") or []:
+            frac = bucket.get("remaining_fraction")
+            if (
+                bucket.get("disabled") is True
+                or isinstance(frac, bool)
+                or not isinstance(frac, (int, float))
+                or not math.isfinite(frac)
+                or not 0 <= frac <= 1
+            ):
+                continue
+            windows.append(
+                dict(
+                    label=f"{group.get('name', 'Quota')} / {bucket.get('window', 'window')}",
+                    used_percent=round((1 - frac) * 100, 6),
+                    scope="model",
+                    resets_at=bucket.get("reset_time") or None,
+                )
+            )
+    return windows
+
+
+def collect_native(source, *, runner=subprocess.run):
+    row = dict(
+        provider=PROVIDER,
+        id=source["id"],
+        label=source["label"],
+        fetched_at=datetime.now(UTC).isoformat(),
+        windows=[],
+        reason=None,
+    )
+    # The official CLI owns the OS keyring. Never read/copy the obsolete community
+    # CLI token file or substitute another account, API key, prompt or paid fallback.
+    names = (
+        "HOME",
+        "USERPROFILE",
+        "PATH",
+        "LANG",
+        "LC_ALL",
+        "DBUS_SESSION_BUS_ADDRESS",
+        "XDG_RUNTIME_DIR",
+        "DISPLAY",
+        "WAYLAND_DISPLAY",
+        "XAUTHORITY",
+        "SSL_CERT_FILE",
+        "SSL_CERT_DIR",
+        "HTTPS_PROXY",
+        "HTTP_PROXY",
+        "NO_PROXY",
+    )
+    env = {k: os.environ[k] for k in names if k in os.environ}
+    env["AGY_CLI_DISABLE_AUTO_UPDATE"] = "1"
+    try:
+        with tempfile.TemporaryDirectory(prefix="hermes-agy-metadata-") as cwd:
+            result = runner(
+                [source["command"], "-p", "/usage", "--output-format", "json"],
+                cwd=cwd,
+                env=env,
+                capture_output=True,
+                text=True,
+                timeout=20,
+            )
+        if result.returncode:
+            row["reason"] = (
+                "Native AGY usage unavailable; no inference fallback was attempted."
+            )
+        else:
+            row["windows"] = parse_native_usage(result.stdout)
+            if not row["windows"]:
+                row["reason"] = "Native AGY returned no active quota buckets."
+    except (OSError, subprocess.TimeoutExpired, ValueError, TypeError, AttributeError):
+        row["reason"] = (
+            "Native AGY metadata could not be read; no inference fallback was attempted."
+        )
+    return row
+
+
+def refresh_native_accounts(home):
+    """Refresh explicitly configured native accounts; preserve unrelated adapter observations."""
+    home = Path(home)
+    try:
+        config = json.loads((home / "account-usage.json").read_text(encoding="utf-8-sig"))
+    except (OSError, ValueError):
+        return
+    sources = [
+        s for s in config.get("agy_accounts", []) if s.get("mode") == "native-keyring"
+    ]
+    if not sources:
+        return
+    path = home / "state/account-usage/external.json"
+    try:
+        prior = json.loads(path.read_text(encoding="utf-8-sig")).get("accounts", [])
+    except (OSError, ValueError):
+        prior = []
+    ids = {s["id"] for s in sources}
+    rows = [r for r in prior if r.get("provider") != PROVIDER or r.get("id") not in ids]
+    rows.extend(collect_native(s) for s in sources)
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    with tempfile.NamedTemporaryFile(
+        mode="w", encoding="utf-8", prefix=".native-", dir=path.parent, delete=False
+    ) as f:
+        pending = Path(f.name)
+        json.dump({"accounts": rows}, f)
+    try:
+        os.replace(pending, path)
+    finally:
+        pending.unlink(missing_ok=True)
diff --git a/hermes_cli/account_usage_report.py b/hermes_cli/account_usage_report.py
new file mode 100644
index 0000000000000000000000000000000000000000..fe395b16895892ff24d89365f8b9441375fff718
--- /dev/null
+++ b/hermes_cli/account_usage_report.py
@@ -0,0 +1,222 @@
+"""Read-only per-account quota report, plus sanitized external adapter snapshots."""
+
+from __future__ import annotations
+
+from datetime import datetime, UTC
+import hashlib
+import json
+import math
+
+from agent.account_usage import fetch_account_usage
+from agent.account_usage_cache import (
+    _identity_id_for,
+    cached_account_usage,
+    snapshot_is_stale,
+)
+from agent.credential_pool import PooledCredential, STATUS_DEAD
+from hermes_cli.auth import read_credential_pool
+from hermes_constants import get_hermes_home
+
+STALE_SECONDS = 900
+DEFAULT_PROVIDERS = ("anthropic", "openai-codex")
+
+
+def _windows(raw):
+    result = []
+    for window in raw:
+        if not isinstance(window, dict):
+            continue
+        used = window.get("used_percent")
+        if (
+            isinstance(used, bool)
+            or not isinstance(used, (int, float))
+            or not math.isfinite(used)
+        ):
+            continue
+        used = max(0.0, min(100.0, used))
+        result.append(
+            {
+                "label": str(window.get("label") or "Quota"),
+                "used_percent": used,
+                "remaining_percent": round(100 - used, 2),
+                "resets_at": window.get("resets_at"),
+                "scope": "model" if window.get("scope") == "model" else "account",
+            }
+        )
+    return result
+
+
+def _state(windows):
+    if not windows:
+        return "unknown"
+    return (
+        "limited"
+        if any(w["scope"] == "account" and w["used_percent"] >= 100 for w in windows)
+        else "ready"
+    )
+
+
+def _entry_report(provider, entry, identity, *, refresh=True):
+    from hermes_cli.inventory import _pool_entry_route_base_url
+
+    row = {
+        "provider": provider,
+        "id": hashlib.sha256(identity.encode()).hexdigest()[:16],
+        "label": entry.label or entry.id,
+        "state": "unknown",
+        "windows": [],
+        "fetched_at": None,
+        "stale": False,
+        "reason": None,
+    }
+    if entry.last_status == STATUS_DEAD:
+        row.update(
+            state="unavailable",
+            reason="Credential is marked unavailable; it was not queried.",
+        )
+        return row
+    if not entry.runtime_api_key:
+        row["reason"] = "No persisted credential is available; no account was selected."
+        return row
+    route = _pool_entry_route_base_url(provider, entry)
+    snapshot = (
+        fetch_account_usage(
+            provider,
+            base_url=route,
+            api_key=entry.runtime_api_key,
+            read_only=True,
+            identity_id=identity,
+        )
+        if refresh
+        else cached_account_usage(provider, identity_id=identity, base_url=route)
+    )
+    if snapshot is None:
+        row["reason"] = "Usage unavailable; no refresh or account rotation attempted."
+        return row
+    row["fetched_at"] = snapshot.fetched_at.isoformat()
+    if snapshot_is_stale(snapshot):
+        row.update(
+            stale=True, reason="The previous usage reading is stale. Refresh usage."
+        )
+        return row
+    row["windows"] = _windows(
+        [
+            {
+                "label": w.label,
+                "used_percent": w.used_percent,
+                "scope": w.scope,
+                "resets_at": w.reset_at.isoformat() if w.reset_at else None,
+            }
+            for w in snapshot.windows
+        ]
+    )
+    row["state"] = _state(row["windows"])
+    row["reason"] = snapshot.unavailable_reason
+    return row
+
+
+def configured_account_route():
+    """Project the profile's configured model without resolving credentials or probing an endpoint."""
+    from agent.model_metadata import is_local_endpoint
+    from hermes_cli.config import coerce_provider_id, load_config
+    from hermes_cli.models import normalize_provider, provider_label
+    from hermes_cli.providers import LLAMACPP_ALIASES
+    from hermes_cli.runtime_provider_custom import _get_named_custom_provider
+
+    config = load_config()
+    model_config = config.get("model")
+    if not isinstance(model_config, dict):
+        return {"provider": None, "label": None, "model": str(model_config or ""), "local_endpoint": False}
+
+    requested = coerce_provider_id(model_config.get("provider", "")).strip()
+    model = str(model_config.get("default", model_config.get("name", "")) or "")
+    named = _get_named_custom_provider(requested, config=config, resolve_credentials=False) if requested else None
+    base_url = str(model_config.get("base_url") or (named or {}).get("base_url") or "")
+    local = requested.lower() in LLAMACPP_ALIASES or is_local_endpoint(base_url)
+    provider = normalize_provider(requested) if requested else ("custom" if local else None)
+    label = (named or {}).get("name") or (provider_label(provider) if provider else None)
+    return {"provider": provider, "label": label, "model": model, "local_endpoint": local}
+
+
+def collect_accounts(provider=None, *, refresh=True, refresh_external=True):
+    """Inspect persisted rows, never load_pool/select/refresh/rotate a credential."""
+    from hermes_cli.inventory import _pool_entry_host
+
+    if refresh and refresh_external and provider in (None, "antigravity-subscription-directsdk"):
+        from hermes_cli.account_usage_native_agy import refresh_native_accounts
+
+        refresh_native_accounts(get_hermes_home())
+
+    pools = read_credential_pool()
+    providers = (provider,) if provider else DEFAULT_PROVIDERS
+    rows, seen = [], set()
+    for slug in providers:
+        for raw in sorted(
+            pools.get(slug, []), key=lambda r: r.get("last_status") == STATUS_DEAD
+        ):
+            entry = PooledCredential.from_dict(slug, raw)
+            identity = _identity_id_for(slug, entry)
+            host = _pool_entry_host(slug, entry)
+            key = (slug, host, identity)
+            if key in seen:
+                continue
+            seen.add(key)
+            row = _entry_report(slug, entry, identity, refresh=refresh)
+            row["id"] = hashlib.sha256(json.dumps(key).encode()).hexdigest()[:16]
+            rows.append(row)
+    rows.extend(load_external_accounts(provider))
+    return sorted(rows, key=lambda r: (r["provider"], r["label"]))
+
+
+def _external_row(raw, now):
+    if not isinstance(raw, dict) or not raw.get("provider") or not raw.get("id"):
+        return None
+    stamp = raw.get("fetched_at")
+    try:
+        age = (now - datetime.fromisoformat(stamp)).total_seconds()
+        stale = age < 0 or age > STALE_SECONDS
+    except (ValueError, TypeError, AttributeError):
+        stale = True
+    windows = _windows(raw.get("windows") or []) if not stale else []
+    return {
+        "provider": str(raw["provider"]),
+        "id": str(raw["id"]),
+        "label": str(raw.get("label") or raw["id"]),
+        "state": _state(windows),
+        "windows": windows,
+        "fetched_at": stamp if isinstance(stamp, str) else None,
+        "stale": stale,
+        "reason": "External observation is stale or has no timestamp."
+        if stale
+        else raw.get("reason"),
+    }
+
+
+def load_external_accounts(provider=None):
+    """External integrations publish only quota observations, never credentials."""
+    path = get_hermes_home() / "state/account-usage/external.json"
+    try:
+        doc = json.loads(path.read_text(encoding="utf-8-sig"))
+    except (OSError, ValueError):
+        return []
+    if not isinstance(doc, dict) or not isinstance(doc.get("accounts"), list):
+        return []
+    now = datetime.now(UTC)
+    rows = [_external_row(raw, now) for raw in doc["accounts"]]
+    return [
+        row for row in rows if row and (not provider or row["provider"] == provider)
+    ]
+
+
+def render_accounts(rows):
+    lines = ["Account usage (per login; unknown is not zero usage)"]
+    for row in rows:
+        lines.append(f"\n{row['provider']} / {row['label']} [{row['state']}]")
+        for window in row["windows"]:
+            reset = f"; resets {window['resets_at']}" if window["resets_at"] else ""
+            lines.append(
+                f"  {window['label']}: {window['remaining_percent']:g}% remaining{reset}"
+            )
+        if not row["windows"]:
+            lines.append("  " + (row.get("reason") or "Usage is unknown."))
+    return "\n".join(lines)
