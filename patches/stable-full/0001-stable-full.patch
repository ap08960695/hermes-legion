+
+def test_read_only_session_db_can_search_structured_text(db):
+    mid = db.append_message(
+        "s", role="user", content=[{"type": "text", "text": "ข้อความภาษาไทย"}]
+    )
+    with SessionDB(db.db_path, read_only=True) as reader:
