@@ -0,0 +1,56 @@
+"""Private bounded disk storage for disposable derived read results."""
+import os
+from pathlib import Path
+import shutil
+import stat
+import tempfile
+import time
+from tools.cache_file_lock import cache_file_lock
+
+_MAX_ENTRY = 8 * 1024 * 1024
+_MAX_BYTES = 64 * 1024 * 1024
+_MAX_ENTRIES = 128
+_TTL = 86400
+_MIN_FREE_BYTES = 1024 * 1024 * 1024
+
+def _read(path):
+    fd=os.open(path,os.O_RDONLY|getattr(os,'O_NOFOLLOW',0))
+    with os.fdopen(fd,'rb') as stream:
+        info=os.fstat(stream.fileno())
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077
+                or info.st_size > _MAX_ENTRY or not 0 <= time.time()-info.st_mtime < _TTL):
+            return None
+        return stream.read(_MAX_ENTRY+1).decode('utf-8')
+
+
+def _store(root, path, text):
+    data=text.encode('utf-8')
+    if len(data)>_MAX_ENTRY:
+        return
+    # Serialize eviction/publication across hash buckets; never hold during extraction.
+    with cache_file_lock(root, '0'*64, namespace='index'):
+        # Disposable results must leave room for transcripts and other durable writes.
+        # Include the full incoming file: replacement is published before eviction.
+        if shutil.disk_usage(root).free - len(data) < _MIN_FREE_BYTES:
+            return
+        entries=[]
+        for entry in root.glob('*.txt'):
+            if entry == path:
+                continue
+            info=entry.lstat()
+            if stat.S_ISREG(info.st_mode):
+                entries.append((info.st_mtime,info.st_size,entry))
+        entries.sort()
+        size=sum(e[1] for e in entries)
+        fd, name = tempfile.mkstemp(dir=root, prefix='write-')
+        tmp=Path(name)
+        try:
+            with os.fdopen(fd, 'wb') as stream:
+                stream.write(data)
+            os.replace(tmp,path)
+            # A failed write/rename must not discard useful hits from other keys.
+            while entries and (len(entries)>=_MAX_ENTRIES or size+len(data)>_MAX_BYTES or time.time()-entries[0][0]>=_TTL):
+                _,n,old=entries.pop(0); old.unlink(missing_ok=True); size-=n
+        finally:
+            tmp.unlink(missing_ok=True)
+
