+"""Canonical worker judges retain usage between turns, stopping at the native terminal fence."""
+from types import SimpleNamespace
+
+import pytest
+
+from agent.aux_accounting import record_aux_usage, reset_accounting_context, set_accounting_context
+from agent.auxiliary_client import _validate_llm_response
+from gateway.session_kanban import _run_task_turns
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_db_connect import connect_closing
+from hermes_state import SessionDB
+
+
+@pytest.mark.parametrize("already_terminal,completion_turn", [(False, 2), (False, 3), (True, 1)])
+def test_worker_judge_accounts_to_bound_session_and_never_after_completion(
+    tmp_path, monkeypatch, already_terminal, completion_turn,
+):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(tmp_path))
+    monkeypatch.setattr("agent.usage_pricing.estimate_usage_cost", lambda *a, **kw: SimpleNamespace(amount_usd=None))
+    kb.init_db()
+    with connect_closing() as conn:
+        tid = kb.create_task(conn, title="offline fixture", assignee="default")
+        task = kb.claim_task(conn, tid, claimer="offline-owner")
+    context = {"skills": [], "context": "", "goal_mode": True, "goal_text": "finish fixture",
+               "goal_max_turns": 3, "task_id": tid, "run_id": task.current_run_id}
+    response = SimpleNamespace(model="offline-judge", choices=[SimpleNamespace(message=SimpleNamespace(
+        content='{"done":true,"reason":"verified"}'))], usage=SimpleNamespace(
+            prompt_tokens=100, completion_tokens=20, prompt_tokens_details=SimpleNamespace(cached_tokens=60)))
+    attempts = []
+
+    def response_boundary(*, task, **kwargs):
+        attempts.append(task)
+        response.choices[0].message.content = (
+            '{"done":false,"reason":"continue fixture"}' if len(attempts) < completion_turn - 1
+            else '{"done":true,"reason":"verified"}')
+        return _validate_llm_response(response, task, provider="offline")
+
+    monkeypatch.setattr("agent.auxiliary_client.call_llm", response_boundary)
+    with SessionDB(tmp_path / "session.db") as db:
+        for sid in ("worker", "outer"):
+            db.create_session(sid, source="cli")
+        turns = []
+
+        def run_conversation(prompt, conversation_history=None):
+            turns.append(prompt)
+            token = set_accounting_context(db, "worker")
+            try:
+                if already_terminal or len(turns) == completion_turn:
+                    with connect_closing() as conn:
+                        assert kb.complete_task(conn, tid, result="offline evidence", expected_run_id=task.current_run_id)
+                return {"completed": True, "final_response": "fixture completed"}
+            finally:
+                reset_accounting_context(token)
+
+        agent = SimpleNamespace(session_id="worker", _session_db=db, run_conversation=run_conversation)
+        token = set_accounting_context(db, "outer")
+        try:
+            result = _run_task_turns(agent, {"text": "offline fixture"}, [], context)
+            record_aux_usage(response, "owner-probe", provider="offline")
+        finally:
+            reset_accounting_context(token)
+        with db._read_ctx() as conn:
+            rows = [tuple(row) for row in conn.execute(
+                "SELECT session_id,task,input_tokens,output_tokens,cache_read_tokens,api_call_count "
+                "FROM session_model_usage ORDER BY session_id,task")]
+    expected = [("outer", "owner-probe", 40, 20, 60, 1)]
+    if not already_terminal:
+        calls = completion_turn - 1
+        expected.append(("worker", "goal_judge", 40 * calls, 20 * calls, 60 * calls, calls))
+    assert rows == expected
+    assert len(turns) == completion_turn
+    assert attempts == ["goal_judge"] * (completion_turn - 1)
+    assert result["final_response"] == "fixture completed"
