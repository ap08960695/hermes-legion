index 0000000..351300c
--- /dev/null
+++ b/tests/hermes_state/test_fresh_schema_atomicity.py
@@ -0,0 +1,63 @@
+"""A fresh declared schema publishes atomically without changing existing-store recovery."""
+from contextlib import closing
+import sqlite3
+
+import pytest
+
+
+def _observe_writer(monkeypatch, *, deny=None):
+    import hermes_state
+    native = hermes_state._connect_tracked_db
+    created = []
+
+    def connect(*args, **kwargs):
+        conn = native(*args, **kwargs)
+
+        def authorize(operation, name, _column, _database, _trigger):
+            if operation == sqlite3.SQLITE_CREATE_TABLE:
+                created.append((name, conn.in_transaction))
+                if name == deny:
+                    return sqlite3.SQLITE_DENY
+            return sqlite3.SQLITE_OK
+
+        conn.set_authorizer(authorize)
+        return conn
+
+    monkeypatch.setattr(hermes_state, '_connect_tracked_db', connect)
+    return created
+
+
+def test_fresh_declared_tables_stay_in_one_transaction(tmp_path, monkeypatch):
+    from hermes_state import SessionDB
+    created = _observe_writer(monkeypatch)
+    with SessionDB(tmp_path / 'state.db') as db:
+        declared = {name: pending for name, pending in created
+                    if name in {'schema_version', 'system_prompts', 'sessions', 'messages', 'runtime_epoch'}}
+        assert set(declared) == {'schema_version', 'system_prompts', 'sessions', 'messages', 'runtime_epoch'}
+        assert all(declared.values()), 'fresh declared tables must not commit one at a time'
+        assert not db._conn.in_transaction
+        assert db._conn.execute('PRAGMA quick_check').fetchone()[0] == 'ok'
+
+
+def test_failed_fresh_ddl_leaves_no_partial_declared_tables(tmp_path, monkeypatch):
+    from hermes_state import SessionDB
+    path = tmp_path / 'state.db'
+    _observe_writer(monkeypatch, deny='system_prompts')
+    with pytest.raises(sqlite3.DatabaseError, match='not authorized'):
+        SessionDB(path)
+    with closing(sqlite3.connect(path)) as conn:
+        assert conn.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall() == []
+
+
+def test_a_failed_existing_store_reconcile_preserves_its_data(tmp_path, monkeypatch):
+    from hermes_state import SessionDB
+    path = tmp_path / 'state.db'
+    with closing(sqlite3.connect(path)) as conn:
+        conn.execute('CREATE TABLE owner_fixture (value TEXT NOT NULL)')
+        conn.execute("INSERT INTO owner_fixture VALUES ('preserve')")
+        conn.commit()
+    _observe_writer(monkeypatch, deny='system_prompts')
+    with pytest.raises(sqlite3.DatabaseError, match='not authorized'):
+        SessionDB(path)
+    with closing(sqlite3.connect(path)) as conn:
+        assert conn.execute('SELECT value FROM owner_fixture').fetchall() == [('preserve',)]
