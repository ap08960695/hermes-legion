+  expect(rest).toHaveBeenLastCalledWith('/tasks/t_example/planned-action', expect.objectContaining({
+    body: { step: 'configure', workspace_kind: 'dir', workspace_path: '/fixture/repo' }
+  }))
+
+  rest.mockRejectedValueOnce(new Error('Fixture confirmation failed'))
