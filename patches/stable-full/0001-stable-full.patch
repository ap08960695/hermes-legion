+++ b/tests/gateway/test_session_interrupt_goal.py
@@ -0,0 +1,189 @@
+"""Stop pauses only its current goal; a dropped pause write cannot suppress cancellation."""
+import asyncio
+import json
+import sqlite3
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from gateway.session_contract import Principal, SessionRef
+from hermes_cli import goals
+from hermes_state import SessionDB
+from hermes_state_runtime import RuntimeStoreError
+from tests.gateway.test_session_authority_cancel_settlement import _authority
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(('control', 'verdict'), [
+    ('stop', 'continue'),
+    ('stop', 'done'),
+    ('stop-resume', 'continue'),
+    ('uninterrupted', 'continue'),
+    ('uninterrupted', 'done'),
+    ('legacy-uninterrupted', 'continue'),
+])
+async def test_post_turn_judge_cannot_continue_a_stopped_goal(tmp_path, monkeypatch, control, verdict):
+    from gateway import session_automation
+    from gateway.config import Platform
+    from gateway.run_goals import GatewayGoalsMixin
+
+    class Runner(GatewayGoalsMixin):
+        async def _post_turn_manager(self, entry, *_args):
+            return goals.GoalManager(entry.session_id)
+
+        async def _run_in_executor_with_context(self, fn):
+            return await asyncio.to_thread(fn)
+
+        async def _defer_goal_status_notice_after_delivery(self, _source, message):
+            notices.append(message)
+
+        def _goal_kanban_notification_target(self, _source):
+            return None
+
+        def _delivery_adapter_for(self, _source):
+            return None
+
+    db, authority = _authority(tmp_path, monkeypatch)
+    authority.profile_id = str(tmp_path)
+    actor = Principal('human', str(tmp_path), frozenset({'session:control'}), 'cli')
+    ref = SessionRef(str(tmp_path), 's')
+    started = asyncio.Event()
+    release = threading.Event()
+    loop = asyncio.get_running_loop()
+    follow_ups = []
+    notices = []
+
+    def judge(*_args, **_kwargs):
+        loop.call_soon_threadsafe(started.set)
+        assert release.wait(5)
+        return verdict, 'Fixture judge result', False, None, False
+
+    async def admit(_runner, _adapter, _source, prompt, wake_kind):
+        follow_ups.append((prompt, wake_kind))
+
+    def read_goal():
+        with SessionDB(db_path=tmp_path / 'state.db') as reader:
+            return json.loads(reader.get_meta('goal:s'))
+
+    monkeypatch.setattr(goals, 'judge_goal', judge)
+    monkeypatch.setattr(session_automation, 'admit_route_wake', admit)
+    with db:
+        if control == 'legacy-uninterrupted':
+            db.set_meta('goal:s', '{"goal":"Collect evidence","status":"active"}')
+        else:
+            goals.GoalManager('s').set('Collect evidence')
+        task = asyncio.create_task(Runner()._post_turn_goal_continuation(
+            session_entry=SimpleNamespace(session_id='s'),
+            source=SimpleNamespace(platform=Platform.LOCAL), final_response='Partial progress',
+        ))
+        try:
+            await asyncio.wait_for(started.wait(), timeout=5)
+            if control.startswith('stop'):
+                await authority.interrupt(actor, ref, authority._handle(ref).execution_generation)
+                assert read_goal()['status'] == 'paused'
+                if control == 'stop-resume':
+                    goals.GoalManager('s').resume()
+                    assert read_goal()['status'] == 'active'
+                acknowledged = read_goal()
+        finally:
+            release.set()
+            await task
+
+        if control.startswith('stop'):
+            assert (read_goal(), notices, follow_ups) == (acknowledged, [], [])
+        else:
+            result = read_goal()
+            assert (result['last_verdict'], result['turns_used']) == (verdict, 1)
+            assert len(notices) == 1
+            if verdict == 'done':
+                assert result['status'] == 'done'
+                assert 'Goal achieved' in notices[0]
+                assert not follow_ups
+            else:
+                assert result['status'] == 'active'
+                assert len(follow_ups) == 1 and follow_ups[0][1] == 'goal-continuation'
+
+
+@pytest.mark.asyncio
+async def test_expired_wait_cannot_reactivate_a_stopped_goal(tmp_path, monkeypatch):
+    db, authority = _authority(tmp_path, monkeypatch)
+    authority.profile_id = str(tmp_path)
+    actor = Principal('human', str(tmp_path), frozenset({'session:control'}), 'cli')
+    ref = SessionRef(str(tmp_path), 's')
+    manager = goals.GoalManager('s')
+    manager.set('Wait for evidence')
+    expired_at = manager.wait_for_seconds(600).waiting_until + 1
+    with db:
+        await authority.interrupt(actor, ref, authority._handle(ref).execution_generation)
+        stopped = db.get_meta('goal:s')
+        assert json.loads(stopped)['status'] == 'paused'
+        monkeypatch.setattr(time, 'time', lambda: expired_at)
+        assert not manager.is_waiting()
+        assert db.get_meta('goal:s') == stopped
+        assert manager.state.status == 'paused'
+
+
+@pytest.mark.parametrize('status', ['active', 'paused', 'done', 'cleared', None])
+def test_stop_preserves_other_goals_and_resolves_compression_tip(tmp_path, monkeypatch, status):
+    db, authority = _authority(tmp_path, monkeypatch)
+    authority.profile_id = str(tmp_path)
+    actor = Principal('human', str(tmp_path), frozenset({'session:control'}), 'cli')
+    ref = SessionRef(str(tmp_path), 's')
+    db.publish_compression_child(parent_session_id='s', child_session_id='tip', source='test',
+                                 messages=[{'role': 'user', 'content': 'summary'}], require_compression_lease=False)
+    manager = goals.GoalManager('tip')
+    if status:
+        manager.set('Keep this goal and its budget')
+        if status == 'paused':
+            manager.pause('existing owner pause')
+        elif status == 'done':
+            manager.mark_done('already verified')
+        elif status == 'cleared':
+            manager.clear()
+    control = goals.GoalManager('independent')
+    control.set('Independent goal')
+    control.pause('independent owner pause')
+    before = db.get_meta('goal:tip')
+    independent = db.get_meta('goal:independent')
+    generation = authority._handle(ref).execution_generation
+    async def run():
+        with pytest.raises(RuntimeStoreError, match='stale_generation'):
+            await authority.interrupt(actor, ref, (generation or 0) + 1)
+        assert db.get_meta('goal:tip') == before
+        foreign = Principal('foreign', 'another-profile', actor.capabilities, 'cli')
+        with pytest.raises(RuntimeStoreError):
+            await authority.interrupt(foreign, ref, generation)
+        assert db.get_meta('goal:tip') == before
+        await authority.interrupt(actor, ref, generation)
+    with db:
+        asyncio.run(run())
+        after = db.get_meta('goal:tip')
+        if status == 'active':
+            state = json.loads(after)
+            assert state['status'] == 'paused' and state['turns_used'] == 0
+            assert state['paused_reason'] == 'user-interrupted (Stop)'
+        else:
+            assert after == before
+        assert db.get_meta('goal:s') is None and db.get_meta('goal:independent') == independent
+
+
+def test_pause_persistence_failure_still_cancels_and_reports_failure(tmp_path, monkeypatch):
+    from tools import async_delegation
+    db, authority = _authority(tmp_path, monkeypatch)
+    authority.profile_id = str(tmp_path)
+    actor = Principal('human', str(tmp_path), frozenset({'session:control'}), 'cli')
+    ref = SessionRef(str(tmp_path), 's')
+    goals.GoalManager('s').set('Do not lose Stop if pause cannot be saved')
+    before = db.get_meta('goal:s')
+    cancelled = []
+    def failed_write(*_args, **_kwargs):
+        raise sqlite3.OperationalError('fixture write failure')
+    monkeypatch.setattr(db, 'set_meta', failed_write)
+    monkeypatch.setattr(async_delegation, 'interrupt_for_session', lambda **args: cancelled.append(args))
+    with db:
+        with pytest.raises(RuntimeStoreError, match='storage_unavailable'):
+            asyncio.run(authority.interrupt(actor, ref, authority._handle(ref).execution_generation))
+        assert cancelled == [{'session_key': 'route', 'parent_session_id': 's', 'reason': 'user_stop'}]
+        assert db.get_meta('goal:s') == before
