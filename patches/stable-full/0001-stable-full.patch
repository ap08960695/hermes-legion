index 0000000000000000000000000000000000000000..95d8c02f6d7740246844655b6b1f290f695fdf62
--- /dev/null
+++ b/tests/hermes_cli/test_goal_result_wait.py
@@ -0,0 +1,229 @@
+"""Fresh completed turns can rejudge advisory card waits; passive polls cannot."""
+import os
+import queue
+import time
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.config import GatewayConfig, Platform
+from gateway.run import GatewayRunner
+from gateway.session import SessionSource
+from gateway.session_viewer_automation import invoke
+from hermes_cli import goals, kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli import kanban_db_notify as notify
+from hermes_cli.cli_loops_mixin import CLILoopsMixin
+
+
+@pytest.fixture
+def fleet(tmp_path, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_HOME", str(home))
+    for name in ("HERMES_KANBAN_DB", "HERMES_KANBAN_TASK", "HERMES_KANBAN_BOARD"):
+        monkeypatch.delenv(name, raising=False)
+    goals._DB_CACHE.clear()
+    goals._get_session_db()
+    yield home
+    goals._DB_CACHE.clear()
+
+
+class Cli(CLILoopsMixin):
+    def __init__(self, manager):
+        self.manager = manager
+        self.agent = SimpleNamespace(session_id=manager.session_id)
+        self.session_id = manager.session_id
+        self._pending_input = queue.Queue()
+        self.response = "Original work pending"
+
+    def _get_goal_manager(self):
+        return self.manager
+
+    def _last_assistant_response_text(self):
+        return self.response
+
+
+def pending(session, *, gateway=False):
+    with kbc.connect_closing() as conn:
+        task = kb.create_task(conn, title="synthetic original work", workspace_kind="scratch")
+        notify.add_notify_sub(conn, task_id=task, platform="local" if gateway else "tui",
+                              chat_id="synthetic-room" if gateway else session, notifier_profile="default")
+        claimed = kb.claim_task(conn, task, claimer="synthetic-owned-run")
+        assert claimed and claimed.current_run_id
+        return task, claimed.current_run_id
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("surface", ["gateway", "tui", "cli", "viewer"])
+async def test_real_completed_turn_rejudges_card_result_before_timer_expiry(fleet, monkeypatch, surface):
+    sid = "synthetic-result-history"
+    task, run = pending(sid, gateway=surface == "gateway")
+    manager = goals.GoalManager(session_id=sid)
+    manager.set("Verify the original task before finishing", max_turns=4)
+    calls = []
+
+    def judge(*args, **kwargs):
+        calls.append(kwargs["active_kanban_cards"])
+        return (("wait", "Original task pending", False, {"seconds": 900}, False)
+                if len(calls) == 1 else ("done", "Original result verified", False, None, False))
+
+    monkeypatch.setattr(goals, "judge_goal", judge)
+    runner = object.__new__(GatewayRunner)
+    runner.config = GatewayConfig(multiplex_profiles=False)
+    runner.adapters = {}
+    runner._defer_goal_status_notice_after_delivery = AsyncMock()
+    source = SessionSource(platform=Platform.LOCAL, chat_id="synthetic-room", profile="default")
+    cli = Cli(manager)
+    import cli as cli_module
+    monkeypatch.setattr(cli_module, "_cprint", lambda *args, **kwargs: None)
+    from tui_gateway import server
+    monkeypatch.setattr(server, "_emit", lambda *args, **kwargs: None)
+    session = {"session_key": sid, "agent": SimpleNamespace(session_id=sid)}
+
+    async def finished_turn(text):
+        if surface == "gateway":
+            await runner._post_turn_goal_continuation(session_entry=SimpleNamespace(session_id=sid),
+                                                     source=source, final_response=text)
+        elif surface == "tui":
+            server._goal_followup_after_turn("synthetic-ui", session, {"completed": True}, "complete", text)
+        elif surface == "cli":
+            cli.response = text
+            cli._maybe_continue_goal_after_turn()
+        else:
+            result = invoke(runner, "goal", sid, "evaluate_after_turn", [text], {"after_model_turn": True})
+            assert "error" not in result
+
+    try:
+        await finished_turn("Original task is still pending")
+        assert calls == [1] and goals.GoalManager(sid).is_waiting()
+        with kbc.connect_closing() as conn:
+            assert kb.complete_task(conn, task, result="Synthetic original result verified",
+                                    expected_run_id=run, fire_lifecycle_hook=False)
+            assert kb.get_run(conn, run).outcome == "completed"
+        assert goals.GoalManager(sid).state.waiting_until > time.time() + 800
+        await finished_turn("The original completed result has been verified")
+        assert calls == [1, 0]
+        assert goals.GoalManager(sid).state.status == "done"
+    finally:
+        runner._shutdown_executor(drain_timeout=5)
+
+
+def test_passive_evaluation_does_not_rejudge_even_after_original_task_finishes(fleet, monkeypatch):
+    sid = "synthetic-passive-history"
+    task, run = pending(sid)
+    manager = goals.GoalManager(session_id=sid)
+    manager.set("Finish original work", max_turns=4)
+    calls = []
+
+    def judge(*args, **kwargs):
+        calls.append(kwargs["active_kanban_cards"])
+        return "wait", "Pending original work", False, {"seconds": 900}, False
+
+    monkeypatch.setattr(goals, "judge_goal", judge)
+    assert manager.evaluate_after_turn("Pending")["verdict"] == "wait"
+    used = manager.state.turns_used
+    with kbc.connect_closing() as conn:
+        kb.complete_task(conn, task, result="Synthetic verified result", expected_run_id=run, fire_lifecycle_hook=False)
+    for _ in range(3):
+        assert manager.is_waiting()
+        assert not manager.evaluate_after_turn("Passive status observation")["should_continue"]
+    assert calls == [1] and manager.state.turns_used == used
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("barrier", ["manual-time", "live-pid"])
+async def test_real_turn_does_not_clear_explicit_owner_wait(fleet, monkeypatch, barrier):
+    sid = "synthetic-explicit-wait"
+    manager = goals.GoalManager(session_id=sid)
+    manager.set("Preserve the explicit wait", max_turns=4)
+    if barrier == "manual-time":
+        manager.wait_for_seconds(900, reason="Explicit owner deadline")
+    else:
+        manager.wait_on(os.getpid(), reason="Original verified process remains live")
+    def forbidden(*args, **kwargs):
+        raise AssertionError("Explicit wait must not call the judge")
+    monkeypatch.setattr(goals, "judge_goal", forbidden)
+    runner = object.__new__(GatewayRunner)
+    runner.config = GatewayConfig(multiplex_profiles=False)
+    runner.adapters = {}
+    runner._defer_goal_status_notice_after_delivery = AsyncMock()
+    try:
+        await runner._post_turn_goal_continuation(session_entry=SimpleNamespace(session_id=sid),
+            source=SessionSource(platform=Platform.LOCAL, chat_id="synthetic-room"), final_response="New reply")
+        assert goals.GoalManager(sid).is_waiting()
+        assert goals.GoalManager(sid).state.turns_used == 0
+    finally:
+        runner._shutdown_executor(drain_timeout=5)
+
