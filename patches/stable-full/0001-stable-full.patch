+"""A closed-session host admits exactly one real receipt, never a general resume."""
+from dataclasses import asdict
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_constants import get_hermes_home
+from hermes_state import SessionDB
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_tui_delivery as delivery
+from hermes_cli import kanban_db_attention as attention
+from tests.hermes_cli.test_kanban_attention import KEY, DAY, NOW, _fixture, _request
+
+
+@pytest.fixture
+def case(tmp_path, monkeypatch):
+    monkeypatch.setattr(attention, 'time', SimpleNamespace(time=lambda: NOW))
+    home = get_hermes_home()
+    db = SessionDB(home / 'state.db')
+    db.create_session(KEY, source='desktop', model='saved-model', model_config={
+        'provider': 'openai-codex', 'reasoning_config': {'effort': 'high'}, 'service_tier': 'priority'})
+    db.update_session_cwd(KEY, str(tmp_path))
+    db.append_message(KEY, 'user', 'Remember the whole project, keep its gates.')
+    db.append_message(KEY, 'assistant', 'Project context retained.')
+    db.end_session(KEY, 'tui_close')
+    with kbc.connect_closing() as c:
+        tid, guard = _fixture(c, tmp_path)
+        request = _request(c, tid, guard)
+        before = asdict(kb.get_task(c, tid))
+    yield SimpleNamespace(home=home, db=db, tid=tid, guard=guard, request=request, before=before, cwd=str(tmp_path))
+    db.close()
+
+
+def _host():
+    from hermes_cli import kanban_attention_host
+    return kanban_attention_host
+
+
+def _state(case):
+    rows = delivery.read_receipts(kb.kanban_db_path(), home=str(case.home.resolve()), session_key=KEY)
+    return next(r['state'] for r in rows if r['id'] == case.request['delivery_id'])
+
+
+def _fake(monkeypatch, case, *, result=None, action=None):
+    built, calls, closed = [], [], []
+    def factory(**kwargs):
+        built.append(kwargs)
+        class Agent:
+            session_id = kwargs['session_id']
+            def run_conversation(self, prompt, *, conversation_history):
+                calls.append((prompt, conversation_history))
+                if action:
+                    action()
+                return result if result is not None else {'completed': True, 'final_response': 'Inspected the plan.'}
+            def close(self):
+                closed.append(True)
+        return Agent()
+    monkeypatch.setattr(_host(), 'build_agent', factory)
+    return built, calls, closed
+
+
+def _run(case):
+    return _host().run(kb.kanban_db_path(), delivery_id=case.request['delivery_id'], session_key=KEY)
+
+
+def test_one_receipt_preserves_task_and_stored_context(case, monkeypatch):
+    built, calls, closed = _fake(monkeypatch, case)
+    out = _run(case)
+    assert out['state'] == 'settled' and out['ran'] is True
+    assert len(built) == len(calls) == len(closed) == 1
+    assert built[0]['row']['model'] == 'saved-model'
+    assert json.loads(built[0]['row']['model_config'])['reasoning_config'] == {'effort': 'high'}
+    assert built[0]['cwd'] == case.cwd
+    assert 'Inspect this existing plan' in calls[0][0]
+    assert [m['content'] for m in calls[0][1]] == [
+        'Remember the whole project, keep its gates.', 'Project context retained.']
+    with kbc.connect_closing() as c:
+        assert asdict(kb.get_task(c, case.tid)) == case.before
+    assert _run(case)['ran'] is False and len(calls) == 1
+
+
+@pytest.mark.parametrize('result,state', [
+    ({'completed': False, 'partial': True, 'final_response': 'half'}, 'failed'),
+    ({'error': 'provider unavailable', 'failed': True}, 'failed'),
+    ({'interrupted': True}, 'cancelled'),
+    ({}, 'unknown'),
+    (None, 'unknown'),
+])
+def test_incomplete_turn_is_not_a_success(case, monkeypatch, result, state):
+    if result is None:
+        def ambiguous(): raise RuntimeError('worker outcome lost')
+        _fake(monkeypatch, case, action=ambiguous)
+        with pytest.raises(RuntimeError): _run(case)
+    else:
+        _fake(monkeypatch, case, result=result)
+        assert _run(case)['state'] == state
+    assert _state(case) == state
+    assert _run(case)['ran'] is False
+
+
+def test_failed_build_leaves_pending(case, monkeypatch):
+    def failed(**kwargs): raise RuntimeError('no configured provider')
+    monkeypatch.setattr(_host(), 'build_agent', failed)
+    with pytest.raises(RuntimeError): _run(case)
+    assert _state(case) == 'pending'
+
+
+def test_live_owner_is_refused_before_build(case, monkeypatch):
+    from hermes_cli.active_sessions import try_acquire_active_session
+    lease, err = try_acquire_active_session(session_id=KEY, surface='desktop', config={},
+        registry_home=case.home, metadata={'live_session_id': 'other-owner'})
+    assert err is None
+    built, calls, _ = _fake(monkeypatch, case)
+    try:
+        with pytest.raises(RuntimeError, match='owner'): _run(case)
+        assert built == calls == [] and _state(case) == 'pending'
+    finally: lease.release()
+
+
+def test_changed_owner_gate_is_rechecked_after_build(case, monkeypatch):
+    original = None
+    built, calls, closed = _fake(monkeypatch, case)
+    original = _host().build_agent
+    def change(**kwargs):
+        agent = original(**kwargs)
+        with kbc.connect_closing() as c: kb.add_comment(c, case.tid, 'owner', 'OwnerGATE: pause')
+        return agent
+    monkeypatch.setattr(_host(), 'build_agent', change)
+    assert _run(case)['state'] == 'cancelled'
+    assert len(built) == len(closed) == 1 and calls == []
+
+
+def test_another_consumer_winning_cas_prevents_execution(case, monkeypatch):
+    _fake(monkeypatch, case)
+    original = _host().build_agent
+    def race(**kwargs):
+        agent = original(**kwargs)
+        pending = delivery.pending(kb.kanban_db_path(), home=str(case.home.resolve()), session_key=KEY)
+        texts, claim = delivery.claim(pending, home=str(case.home.resolve()), session_key=KEY)
+        assert len(texts) == 1
+        claim.mark('unknown')
+        return agent
+    monkeypatch.setattr(_host(), 'build_agent', race)
+    assert _run(case) == {'delivery_id': case.request['delivery_id'], 'state': 'unknown', 'ran': False}
+
+
+def test_foreign_profile_cannot_open_same_receipt(case, monkeypatch, tmp_path):
+    from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+    built, calls, _ = _fake(monkeypatch, case)
+    token = set_hermes_home_override(tmp_path / 'other-home')
+    try:
+        with pytest.raises(ValueError): _run(case)
+    finally: reset_hermes_home_override(token)
+    assert built == calls == []
+
+
+def test_compressed_destination_uses_selected_tip(case, monkeypatch):
+    case.db.reopen_session(KEY)
+    assert case.db.try_acquire_compression_lock(KEY, 'host-fixture')
+    case.db.publish_compression_child(parent_session_id=KEY, child_session_id='host-tip', source='desktop',
+        messages=[{'role': 'user', 'content': 'Canonical compacted context'}],
+        compression_lock_holder='host-fixture', require_compression_lease=True)
+    built, calls, _ = _fake(monkeypatch, case)
+    assert _run(case)['state'] == 'settled'
+    assert built[0]['session_id'] == 'host-tip'
+    assert calls[0][1][0]['content'] == 'Canonical compacted context'
+    assert _state(case) == 'settled'
+
+
+def test_ordinary_lifecycle_receipt_cannot_open_a_closed_session(case, monkeypatch):
+    built, calls, _ = _fake(monkeypatch, case)
+    with kbc.connect_closing() as c:
+        c.execute('DELETE FROM kanban_task_attention')
+        c.commit()
+    with pytest.raises(ValueError, match='daily attention'): _run(case)
+    assert built == calls == []
+
+
+@pytest.mark.parametrize('stage,expected', [('build', 'pending'), ('model', 'claimed'), ('settled', 'settled')])
+def test_actual_process_crash_never_replays_ambiguous_work(case, stage, expected):
+    import os
+    from pathlib import Path
+    import subprocess
+    import sys
+    script = '''
+import os,sys
+from pathlib import Path
+from types import SimpleNamespace
+from hermes_cli import kanban_attention_host as host,kanban_db_attention as attention
+attention.time=SimpleNamespace(time=lambda: float(sys.argv[5]))
+class Agent:
+    def run_conversation(self,*args,**kwargs):
+        if sys.argv[4]=='model': os._exit(73)
+        return {'completed':True}
+    def close(self): pass
+def build(**kwargs):
+    if sys.argv[4]=='build': os._exit(73)
+    return Agent()
+host.build_agent=build
+host.run(Path(sys.argv[1]),delivery_id=int(sys.argv[2]),session_key=sys.argv[3])
+os._exit(73)
+'''
+    env = {**os.environ, 'HERMES_TEST_ISOLATION': '1', 'HERMES_DISABLE_LAZY_INSTALLS': '1'}
+    child = subprocess.run([sys.executable, '-c', script, str(kb.kanban_db_path()),
+        str(case.request['delivery_id']), KEY, stage, str(NOW)], cwd=str(Path(__file__).resolve().parents[2]),
+        env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30, check=False)
+    assert child.returncode == 73, child.stderr
+    assert _state(case) == expected
+    if expected != 'pending':
+        assert _run(case)['ran'] is False
+
+
+@pytest.mark.parametrize('stage,expected', [('build', 'pending'), ('model', 'unknown')])
+def test_interrupt_does_not_release_potentially_started_work(case, monkeypatch, stage, expected):
+    if stage == 'build':
+        def interrupt(**kwargs): raise KeyboardInterrupt()
+        monkeypatch.setattr(_host(), 'build_agent', interrupt)
+    else:
+        def interrupt(): raise KeyboardInterrupt()
+        _fake(monkeypatch, case, action=interrupt)
+    with pytest.raises(KeyboardInterrupt): _run(case)
+    assert _state(case) == expected
+
+
+def test_pending_routine_events_are_not_collected_by_explicit_host(case, monkeypatch):
+    with kbc.connect_closing() as c:
+        other = kb.create_task(c, title='unrelated task')
+        from hermes_cli import kanban_db_notify as notify
+        notify.add_notify_sub(c, task_id=other, platform='tui', chat_id=KEY,
+            notifier_profile='default', delivery_mode='notify+wake')
