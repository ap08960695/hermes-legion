new file mode 100644
index 0000000000000000000000000000000000000000..02c2f0c5eab84aaf8304244b577ee3ac4ed6d0c6
--- /dev/null
+++ b/apps/desktop/src/i18n/load-bundled-locales.ts
@@ -0,0 +1,21 @@
+import { ar } from './ar'
+import { TRANSLATIONS } from './catalog'
+import { de } from './de'
+import { es } from './es'
+import { fr } from './fr'
+import { ja } from './ja'
+import { ru } from './ru'
+import { zh } from './zh'
+import { zhHant } from './zh-hant'
+
+// Regular Desktop windows and the UI test runner load the full catalog before mounting.
+Object.assign(TRANSLATIONS, {
+  zh,
+  'zh-hant': zhHant,
+  ja,
+  ar,
+  ru,
+  fr,
+  de,
+  es
+})
diff --git a/apps/desktop/src/i18n/overlay-catalog.test.ts b/apps/desktop/src/i18n/overlay-catalog.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..77e133ea45d2932d66c53b7861d3b3c42468c873
--- /dev/null
+++ b/apps/desktop/src/i18n/overlay-catalog.test.ts
@@ -0,0 +1,16 @@
+import { expect, it, vi } from 'vitest'
+
+it('uses English in an isolated overlay and restores bundled translations at Desktop startup', async () => {
+  vi.resetModules()
+  const { BUNDLED_LOCALES, TRANSLATIONS } = await import('./catalog')
+  const { resolveTranslations } = await import('./registry')
+
+  expect(BUNDLED_LOCALES).toContain('de')
+  expect(TRANSLATIONS.de).toBe(TRANSLATIONS.en)
+  expect(resolveTranslations('en').boot.ready).toBe(TRANSLATIONS.en.boot.ready)
+
+  await import('./load-bundled-locales')
+
+  expect(resolveTranslations('de').language.label).toBe(TRANSLATIONS.de.language.label)
+  expect(TRANSLATIONS.de.language.label).not.toBe(TRANSLATIONS.en.language.label)
+})
