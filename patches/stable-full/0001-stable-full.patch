+import { afterEach, expect, it } from 'vitest'
+
+import { setApiRequestConnection, setApiRequestProfile } from '@/api/client'
+import { clearSessionDraft, stashSessionDraft } from '@/store/composer'
+import { $activeSessionId, $selectedStoredSessionId, $sessions } from '@/store/session'
+import { clearAllSessionStates, recordSessionEventScope } from '@/store/session-states'
+
+import { composerHost } from './composer'
+
+const id = 'sdk-owned-history'
+const original = { connectionId: 'source-a', profile: 'default' }
+const work = { connectionId: 'source-a', profile: 'work' }
+
+afterEach(() => {
+  clearAllSessionStates()
+  $sessions.set([])
+  $activeSessionId.set(null)
+  $selectedStoredSessionId.set(null)
+
+  for (const owner of [original, work, undefined]) {
+    clearSessionDraft(id, owner)
+  }
+
+  setApiRequestConnection(null)
+  setApiRequestProfile(null)
+})
+
+it('uses the displayed runtime owner for an unmounted persisted-stash fallback', async () => {
+  setApiRequestConnection('source-a')
+  setApiRequestProfile('default')
+  $activeSessionId.set('sdk-live-original')
+  $selectedStoredSessionId.set(id)
+  $sessions.set([{ id, profile: 'work', connection_id: 'source-a' } as never])
+  recordSessionEventScope({ session_id: 'sdk-live-original', connectionId: 'source-a', profile: 'default' })
+  stashSessionDraft(id, 'Original unsent words', [], original)
+  stashSessionDraft(id, 'Other owner words', [], work)
+
+  await expect(composerHost.getDraft(id)).resolves.toBe('Original unsent words')
+})
+
+it('does not reveal legacy unassigned text through the plugin fallback', async () => {
+  stashSessionDraft(id, 'Unassigned private words', [])
+
+  await expect(composerHost.getDraft(id)).resolves.toBeNull()
+})
+
+it('captures fallback ownership before waiting for a mounted composer response', async () => {
+  setApiRequestConnection('source-a')
+  setApiRequestProfile('default')
+  stashSessionDraft(id, 'Original fallback words', [], original)
+  stashSessionDraft(id, 'Other fallback words', [], work)
+  const pending = composerHost.getDraft(id)
+  setApiRequestProfile('work')
+
+  await expect(pending).resolves.toBe('Original fallback words')
+})
