+
+def test_scoped_windows_are_bounded_without_retiring_anonymous_entries():
+    metadata.save_context_length("legacy-anonymous", BASE, 65536)
+    for index in range(130):
+        adopt(f"synthetic-owner-{index}")
+    cache = metadata._load_context_cache()
+    assert len([key for key in cache if key.startswith("credential-v1:")]) == 128
+    assert metadata.get_cached_context_length("legacy-anonymous", BASE) == 65536
+    assert resolve("synthetic-owner-129") == 131072
+    assert "synthetic-owner" not in metadata._get_context_cache_path().read_text()
+
+
+@pytest.mark.platforms("posix")
+def test_parallel_window_writes_preserve_each_other(monkeypatch):
+    from concurrent.futures import ThreadPoolExecutor
+    import threading
+    from hermes_cli import auth
+
+    first_waiting, release = threading.Event(), threading.Event()
+    write = metadata._write_context_cache
+    kernel_lock = auth._kernel_lock
+
+    def enter_lock(handle, exclusive):
+        if threading.current_thread().name.endswith("_1"):
+            release.set()
+        return kernel_lock(handle, exclusive)
+
+    def write_window(cache, confirmed=None):
+        first = threading.current_thread().name.endswith("_0")
+        if first:
+            first_waiting.set()
+            assert release.wait(timeout=3)
+        write(cache, confirmed)
+        if not first:
+            release.set()
+
+    monkeypatch.setattr(auth, "_kernel_lock", enter_lock)
+    monkeypatch.setattr(metadata, "_write_context_cache", write_window)
+    with ThreadPoolExecutor(max_workers=2, thread_name_prefix="context-write") as pool:
+        one = pool.submit(metadata.save_context_length, "first-model", BASE, 65536)
+        try:
+            assert first_waiting.wait(timeout=2)
+            two = pool.submit(metadata.save_context_length, "second-model", BASE, 131072)
+            two.result(timeout=4)
+            one.result(timeout=4)
+        finally:
+            release.set()
+    assert metadata.get_cached_context_length("first-model", BASE) == 65536
+    assert metadata.get_cached_context_length("second-model", BASE) == 131072
diff --git a/tests/agent/test_endpoint_metadata_scope.py b/tests/agent/test_endpoint_metadata_scope.py
new file mode 100644
index 0000000000000000000000000000000000000000..bad7eb444661cc1bd21999dce680d6423a6390f5
--- /dev/null
+++ b/tests/agent/test_endpoint_metadata_scope.py
@@ -0,0 +1,257 @@
+"""Native endpoint catalogs must follow credentials and coalesce startup reads."""
+
+from concurrent.futures import ThreadPoolExecutor
+from contextlib import contextmanager
+import json
+import threading
+import time
+
+import httpx
+import pytest
+
+from agent import model_metadata as metadata
+
+BASE = "https://catalog.example.invalid/v1"
+
+
+@pytest.fixture(autouse=True)
+def isolated_catalog(monkeypatch):
+    metadata._endpoint_model_metadata_cache.clear()
+    metadata._endpoint_model_metadata_cache_time.clear()
+    metadata._endpoint_blackhole_cache.clear()
+    monkeypatch.setattr(metadata.model_metadata_http, "resolve_verify", lambda _: False)
+    yield
+    metadata._endpoint_model_metadata_cache.clear()
+    metadata._endpoint_model_metadata_cache_time.clear()
+
+
+def transport(monkeypatch, reply):
+    calls = []
+
+    @contextmanager
+    def stream(url, *, headers, **kwargs):
+        calls.append((url, headers.get("Authorization"), kwargs.get("verify")))
+        result = reply(url, headers, kwargs)
+        yield httpx.Response(200, json={"data": [{"id": result, "context_length": 65536}]},
+                             request=httpx.Request("GET", url))
+
+    monkeypatch.setattr(metadata.model_metadata_http, "stream", stream)
+    return calls
+
+
+def parked_callers(monkeypatch, expected):
+    """Release a held transport only after all callers park; never delay by wall clock."""
+    reached = threading.Event()
+    seen = set()
+    lock = threading.Lock()
+    original = threading.Condition.wait
+
+    def wait(condition, *args, **kwargs):
+        if threading.current_thread().name.startswith("catalog-scope"):
+            with lock:
+                seen.add(threading.get_ident())
+                if len(seen) == expected:
+                    reached.set()
+        return original(condition, *args, **kwargs)
+
+    monkeypatch.setattr(threading.Condition, "wait", wait)
+    return reached
+
+
+@pytest.mark.parametrize("new_process", [False, True])
+def test_changed_credential_never_reuses_another_catalog(monkeypatch, new_process):
+    calls = transport(monkeypatch, lambda _, headers, __: headers["Authorization"].split()[-1])
+    assert "synthetic-a" in metadata.fetch_endpoint_model_metadata(BASE, "synthetic-a")
+    if new_process:
+        metadata._endpoint_model_metadata_cache.clear()
+        metadata._endpoint_model_metadata_cache_time.clear()
+    assert "synthetic-b" in metadata.fetch_endpoint_model_metadata(BASE, "synthetic-b")
+    assert len(calls) == 2
+
+
+def test_same_credential_reuses_its_disk_catalog(monkeypatch):
+    calls = transport(monkeypatch, lambda *_: "same-catalog")
+    metadata.fetch_endpoint_model_metadata(BASE, "synthetic-a")
+    metadata._endpoint_model_metadata_cache.clear()
+    metadata._endpoint_model_metadata_cache_time.clear()
+    assert "same-catalog" in metadata.fetch_endpoint_model_metadata(BASE, "synthetic-a")
+    assert len(calls) == 1
+    contents = metadata._get_endpoint_metadata_cache_path().read_text()
+    assert "synthetic-a" not in contents
+
+
+def test_unscoped_legacy_disk_entry_is_not_credential_evidence(monkeypatch):
+    path = metadata._get_endpoint_metadata_cache_path()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps({BASE: {"at": time.time(), "models": {"legacy-only": {}}}}))
+    calls = transport(monkeypatch, lambda *_: "authorized-catalog")
+    result = metadata.fetch_endpoint_model_metadata(BASE, "synthetic-a")
+    assert "authorized-catalog" in result and "legacy-only" not in result
+    assert len(calls) == 1
+
+
+def test_profile_tls_scope_is_resolved_before_reusing_metadata(monkeypatch, tmp_path):
+    from hermes_constants import get_hermes_home
+
+    first = tmp_path / "first"
+    second = tmp_path / "second"
+    first.mkdir()
+    second.mkdir()
+    monkeypatch.setattr(metadata.model_metadata_http, "resolve_verify", lambda _: str(get_hermes_home()))
+    calls = transport(monkeypatch, lambda _, __, options: options["verify"])
+    monkeypatch.setenv("HERMES_HOME", str(first))
+    assert str(first) in metadata.fetch_endpoint_model_metadata(BASE, "synthetic-a")
+    monkeypatch.setenv("HERMES_HOME", str(second))
+    assert str(second) in metadata.fetch_endpoint_model_metadata(BASE, "synthetic-a")
+    assert len(calls) == 2
+
+
+def test_concurrent_same_scope_startup_read_uses_one_request(monkeypatch):
+    release = threading.Event()
+    parked = parked_callers(monkeypatch, 4)
+
+    def reply(*_):
+        assert release.wait(timeout=3)
+        return "shared-catalog"
+
+    calls = transport(monkeypatch, reply)
+
+    with ThreadPoolExecutor(max_workers=4, thread_name_prefix="catalog-scope") as pool:
+        futures = [pool.submit(metadata.fetch_endpoint_model_metadata, BASE, "synthetic-a") for _ in range(4)]
+        try:
+            assert parked.wait(timeout=2)
+        finally:
+            release.set()
+        values = [future.result(timeout=2) for future in futures]
+    assert all("shared-catalog" in value for value in values)
+    assert len(calls) == 1
+
+
+def test_other_credential_is_not_blocked_by_an_inflight_request(monkeypatch):
+    entered = threading.Event()
+    release = threading.Event()
+
+    def reply(_, headers, __):
+        if headers["Authorization"] == "Bearer synthetic-a":
+            entered.set()
+            assert release.wait(timeout=3)
+        return "own-catalog"
+
+    transport(monkeypatch, reply)
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        first = pool.submit(metadata.fetch_endpoint_model_metadata, BASE, "synthetic-a")
+        try:
+            assert entered.wait(timeout=2)
+            second = pool.submit(metadata.fetch_endpoint_model_metadata, BASE, "synthetic-b")
+            assert "own-catalog" in second.result(timeout=2)
+        finally:
+            release.set()
+        assert "own-catalog" in first.result(timeout=2)
+
+
+def test_force_refresh_still_reads_the_endpoint(monkeypatch):
+    generation = iter(("old-catalog", "new-catalog"))
+    calls = transport(monkeypatch, lambda *_: next(generation))
+    assert "old-catalog" in metadata.fetch_endpoint_model_metadata(BASE, "synthetic-a")
+    assert "new-catalog" in metadata.fetch_endpoint_model_metadata(BASE, "synthetic-a", force_refresh=True)
+    assert len(calls) == 2
+
+
+def test_refresh_after_an_inflight_read_keeps_the_fresh_catalog(monkeypatch):
+    entered = threading.Event()
+    release = threading.Event()
+    parked = parked_callers(monkeypatch, 2)
+    count = 0
+
+    def reply(*_):
+        nonlocal count
+        count += 1
+        if count == 1:
+            entered.set()
+            assert release.wait(timeout=3)
+            return "old-catalog"
+        return "new-catalog"
+
+    transport(monkeypatch, reply)
+    with ThreadPoolExecutor(max_workers=2, thread_name_prefix="catalog-scope") as pool:
+        ordinary = pool.submit(metadata.fetch_endpoint_model_metadata, BASE, "synthetic-a")
+        assert entered.wait(timeout=2)
+        refresh = pool.submit(metadata.fetch_endpoint_model_metadata, BASE, "synthetic-a", True)
+        try:
+            assert parked.wait(timeout=2)
+        finally:
+            release.set()
+        assert "old-catalog" in ordinary.result(timeout=2)
+        assert "new-catalog" in refresh.result(timeout=2)
+    assert "new-catalog" in metadata.fetch_endpoint_model_metadata(BASE, "synthetic-a")
+
+
+def test_interrupted_read_does_not_leave_a_stuck_flight(monkeypatch):
+    attempts = 0
+
+    def reply(*_):
+        nonlocal attempts
+        attempts += 1
+        if attempts == 1:
+            raise KeyboardInterrupt
+        return "recovered-catalog"
+
+    transport(monkeypatch, reply)
+    with pytest.raises(KeyboardInterrupt):
+        metadata.fetch_endpoint_model_metadata(BASE, "synthetic-a")
+    assert "recovered-catalog" in metadata.fetch_endpoint_model_metadata(BASE, "synthetic-a")
+    assert attempts == 2
+
+
+def test_queued_refresh_callers_share_one_fresh_request(monkeypatch):
+    entered = threading.Event()
+    release = threading.Event()
+    parked = parked_callers(monkeypatch, 4)
+    count = 0
+
+    def reply(*_):
+        nonlocal count
+        count += 1
+        if count == 1:
+            entered.set()
+            assert release.wait(timeout=3)
+            return "old-catalog"
+        assert release.wait(timeout=3)
+        return "new-catalog"
+
+    calls = transport(monkeypatch, reply)
+
+    with ThreadPoolExecutor(max_workers=4, thread_name_prefix="catalog-scope") as pool:
+        ordinary = pool.submit(metadata.fetch_endpoint_model_metadata, BASE, "synthetic-a")
+        assert entered.wait(timeout=2)
+        refreshes = [pool.submit(metadata.fetch_endpoint_model_metadata, BASE, "synthetic-a", True) for _ in range(3)]
+        try:
+            assert parked.wait(timeout=2)
+        finally:
+            release.set()
+        assert "old-catalog" in ordinary.result(timeout=2)
+        assert all("new-catalog" in future.result(timeout=2) for future in refreshes)
+    assert len(calls) == 2
+
+
+def test_completed_catalog_retention_is_bounded(monkeypatch):
+    monkeypatch.setattr(metadata, "_endpoint_disk_cache_get", lambda *_: None)
+    monkeypatch.setattr(metadata, "_endpoint_disk_cache_put", lambda *_: None)
+    calls = transport(monkeypatch, lambda *_: "own-catalog")
+    for index in range(300):
+        metadata.fetch_endpoint_model_metadata(f"https://catalog-{index}.example.invalid/v1", "synthetic-a")
+    before = len(calls)
+    metadata.fetch_endpoint_model_metadata("https://catalog-0.example.invalid/v1", "synthetic-a")
+    assert len(calls) == before + 1
+
+
+@pytest.mark.parametrize("capability", [["text", "image"], {"kind": "text"}, True, "text", 4096])
+def test_capability_fields_do_not_break_or_override_catalog_pricing(capability):
+    payload = {"data": [{"id": "multimodal-model", "context_length": 65536,
+                         "modalities": {"input": capability},
+                         "pricing": {"prompt": "0.0000006", "completion": "0.0000012"}}]}
+    result = metadata._parse_models_payload(payload)
+    entry = result["multimodal-model"]
+    assert entry["context_length"] == 65536
+    assert float(entry["pricing"]["prompt"]) == 0.0000006
+    assert float(entry["pricing"]["completion"]) == 0.0000012
