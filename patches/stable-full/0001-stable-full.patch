+
+
+def test_unpaired_surrogate_in_structured_text_is_safe_and_recoverable(db):
+    value = [{"type": "text", "text": "alpha\ud800beta"}]
+    mid = db.append_message("s", role="user", content=value)
+    raw = session_search(db=db, session_id="s", query="beta")
