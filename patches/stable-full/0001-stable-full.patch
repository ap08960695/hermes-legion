--- /dev/null
+++ b/tests/tools/test_browser_stop_pid_encoding.py
@@ -0,0 +1,24 @@
+"""Owned daemon PID parsing is read-only and accepts optional UTF-8 BOMs."""
+from types import SimpleNamespace
+
+import pytest
+
+from tools.browser_tool_stop_proof import NativeStopProbe
+
+
+@pytest.mark.parametrize('encoding', ['utf-8', 'utf-8-sig'])
+@pytest.mark.parametrize('text', ['42\n', '0\n', '-1\n', 'invalid\n'])
+def test_pid_text_decoding_preserves_positive_integer_validation(tmp_path, encoding, text):
+    path = tmp_path / 'test.pid'
+    path.write_text(text, encoding=encoding)
+    before = path.read_bytes()
+    probe = NativeStopProbe(SimpleNamespace(socket_dir=str(tmp_path), session_name='test'),
+                            verify=None, processes=object())
+    if text == '42\n':
+        assert probe.pid() == 42
+        assert probe.root_pid == 42
+    else:
+        with pytest.raises(ValueError):
+            probe.pid()
+        assert probe.root_pid is None
+    assert path.read_bytes() == before
