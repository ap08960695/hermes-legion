+class ProbeAdmissionTests(ProbeFixture):
+    async def test_pre_admission_outcomes_start_no_probe(self):
+        cases = [("profile-refusal", False, None, None, True, True, False),
+                 ("host-attach", True, True, None, True, True, False),
+                 ("host-refusal", True, False, None, True, True, False),
+                 ("duplicate", True, None, 123456, True, True, False),
+                 ("reservation", True, None, None, False, True, False),
+                 ("pid-loss", True, None, None, True, False, True)]
+        for name, profile_ok, host, pid, reserve, claim, releases in cases:
+            with self.subTest(outcome=name), contextlib.ExitStack() as stack:
+                warm = stack.enter_context(patch.object(self.boot, "_start_gateway_early_environment_probe"))
+                stack.enter_context(patch.object(self.boot, "_start_gateway_resolve_terminal_cwd"))
+                stack.enter_context(patch("hermes_cli.resource_limits.apply_nofile_soft_limit"))
+                stack.enter_context(patch("gateway.code_skew.record_boot_fingerprint"))
+                homes = [self.home] if not profile_ok else []
+                stack.enter_context(patch.object(self.run, "_multiplex_profile_homes", return_value=homes))
+                stack.enter_context(patch.object(self.boot, "_launch_home_may_multiplex", return_value=profile_ok))
+                stack.enter_context(patch.object(self.run, "_host_attach_or_none", new=AsyncMock(return_value=host)))
+                stack.enter_context(patch("gateway.status.get_running_pid", return_value=pid))
+                stack.enter_context(patch.object(self.boot, "_start_gateway_replace_existing_instance", new=AsyncMock(return_value=False)))
+                stack.enter_context(patch.object(self.boot, "_start_gateway_reserve_profiles", return_value=reserve))
+                stack.enter_context(patch.object(self.boot, "_start_gateway_claim_pid_file", return_value=claim))
+                release = stack.enter_context(patch("gateway.status.release_gateway_runtime_lock"))
+                result = await self.boot.start_gateway(config=SimpleNamespace(multiplex_profiles=not profile_ok))
+                self.assertIs(result, True if name == "host-attach" else False)
+                warm.assert_not_called()
+                self.assertEqual(release.call_count, int(releases))
+
+    async def test_probe_admission_follows_pid_and_logging_before_runner(self):
+        events = []
+        with contextlib.ExitStack() as stack:
+            stack.enter_context(patch.object(self.boot, "_start_gateway_resolve_terminal_cwd"))
+            stack.enter_context(patch("hermes_cli.resource_limits.apply_nofile_soft_limit"))
+            stack.enter_context(patch("gateway.code_skew.record_boot_fingerprint"))
+            stack.enter_context(patch.object(self.run, "_host_attach_or_none", new=AsyncMock(return_value=None)))
+            stack.enter_context(patch("gateway.status.get_running_pid", return_value=None))
+            stack.enter_context(patch.object(self.boot, "_start_gateway_reserve_profiles", return_value=True))
+            stack.enter_context(patch.object(self.boot, "_start_gateway_claim_pid_file", side_effect=lambda **kw: events.append("pid") or True))
+            stack.enter_context(patch.object(self.boot, "_start_gateway_configure_logging", side_effect=lambda *a: events.append("logging")))
+            stack.enter_context(patch.object(self.boot, "_start_gateway_early_environment_probe", side_effect=lambda: events.append("probe")))
+            stack.enter_context(patch("gateway.run_startup.recover_left_core_at_gateway_start", side_effect=lambda: events.append("recovery")))
+            def runner_boundary(*args):
+                events.append("runner")
