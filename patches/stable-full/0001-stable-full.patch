+"""An error before publication must not expose a candidate as an applied transcript.
+
+The public extraction hook is a controlled failing extension seam. Ordinary
+MemoryManager provider errors are separately proved to remain best-effort.
+"""
+import builtins
+import copy
+from types import SimpleNamespace
+
+import pytest
+
+from agent.context_compressor import SUMMARY_PREFIX
+from agent.conversation_compression import CompressionCommitFence
+from agent.usage_anchor import persisted_anchor_tokens
+from hermes_state import SessionDB
+
+pytest_plugins = ["tests.agent.test_compression_prompt_publication"]
+
+
+@pytest.mark.parametrize("in_place", [True, False], ids=["in-place", "rotation"])
+@pytest.mark.parametrize("mutates", [False, True], ids=["copied-candidate", "mutating-engine"])
+@pytest.mark.parametrize("failure", ["extension", "import"])
+def test_failed_prepublication_step_never_publishes_candidate(prefix_case, monkeypatch, in_place, mutates, failure):
+    c = prefix_case
+    c.agent.compression_in_place = in_place
+    original = copy.deepcopy(c.messages)
+    if mutates:
+        def fold_in_place(messages, **kwargs):
+            messages[:] = [{"role": "user", "content": SUMMARY_PREFIX + "Earlier work retained."},
+                {"role": "assistant", "content": "persisted answer"}]
+            return messages
+        c.agent.context_compressor.compress.side_effect = fold_in_place
+    extraction_calls, import_failures = [], []
+    native_extract, native_import = c.agent.commit_memory_session, builtins.__import__
+    extraction_finished = False
+    def extraction(messages):
+        nonlocal extraction_finished
+        extraction_calls.append(copy.deepcopy(messages))
+        if failure == "extension":
+            raise OSError("fixture: extraction extension failed before publication")
+        native_extract(messages)
+        extraction_finished = True
+    def dependency_import(name, *args, **kwargs):
+        if extraction_finished and name == "hermes_cli.partial_compress":
+            import_failures.append(name)
+            raise ImportError("fixture: dependency import failed before publication")
+        return native_import(name, *args, **kwargs)
+    monkeypatch.setattr(c.agent, "commit_memory_session", extraction)
+    monkeypatch.setattr(builtins, "__import__", dependency_import)
+    try:
+        returned, prompt = c.agent._compress_context(c.messages, "trusted updated context",
+            approx_tokens=120_000, force=True, commit_fence=CompressionCommitFence())
+    finally:
+        extraction_finished = False
+    assert import_failures == (["hermes_cli.partial_compress"] if failure == "import" else [])
+    assert extraction_calls == [original]
+    assert c.db.get_messages_as_conversation(c.sid) == original
+    assert returned == original, "an uncommitted candidate must not become the next provider transcript"
+    assert c.messages == original and c.agent.session_id == c.sid
+    assert prompt == c.prompt and c.agent._cached_system_prompt is c.prompt
+    assert c.agent.tools == c.tools and c.db.get_session(c.sid)["tool_names"] == c.pin
+    assert c.switches == [] and not [e for e in c.events if e[0] == "session:compress"]
+    assert c.agent._usage_anchor == c.anchor
+    assert persisted_anchor_tokens(c.db, c.sid, original) == 120_250
+    assert c.agent._last_compression_attempt_in_place is None
+    assert c.db.get_session(c.sid)["ended_at"] is None
+    assert c.db.get_compression_lock_holder(c.sid) is None
+    assert c.agent._flush_messages_to_session_db(returned, original) is not False
+    with SessionDB(c.db.db_path, read_only=True) as cold:
+        assert cold.get_messages_as_conversation(c.sid) == original
+        assert persisted_anchor_tokens(cold, c.sid, original) == 120_250
+
+
+@pytest.mark.parametrize("in_place", [True, False], ids=["in-place", "rotation"])
+def test_ordinary_provider_failure_keeps_best_effort_commit(prefix_case, in_place):
+    c = prefix_case
+    c.agent.compression_in_place = in_place
+    calls = []
+    def fail_provider(messages):
+        calls.append(copy.deepcopy(messages))
+        raise OSError("fixture: ordinary memory sink unavailable")
+    c.agent._memory_manager.add_provider(SimpleNamespace(name="failing-sink",get_tool_schemas=list,
+        on_session_end=fail_provider,shutdown=lambda:None,system_prompt_block=lambda:""))
+    before = copy.deepcopy(c.messages)
+    returned, prompt = c.agent._compress_context(c.messages, "trusted updated context",
+        approx_tokens=120_000, force=True, commit_fence=CompressionCommitFence())
+    assert calls == [before], "the real MemoryManager must attempt and isolate the failing provider"
+    assert len(c.db.get_messages_as_conversation(c.agent.session_id)) == len(returned) < len(before)
+    assert "trusted updated context" in prompt and c.agent._usage_anchor is None
+    assert len(c.switches) == 1 and len([e for e in c.events if e[0] == "session:compress"]) == 1
