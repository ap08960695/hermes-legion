+    comments: [],
+    links: { parents: [], children: [] }
+  })
+})
+afterEach(() => {
+  cleanup()
+  client.clear()
+  dispose()
+  vi.clearAllMocks()
+})
+const board = {
+  columns: [
+    {
+      name: 'blocked',
+      tasks: [
+        { id: 'first', title: 'Research the example', status: 'blocked', assignee: 'reviewer' },
