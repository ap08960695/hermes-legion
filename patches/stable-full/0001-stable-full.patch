+    if (onlyIfEmpty && existed) {
+      return { saved: false, retired: [] }
+    }
+
+    if (!text) {
+      window.localStorage.removeItem(key)
+
+      return { saved: true, retired: [] }
+    }
+
+    window.localStorage.setItem(key, JSON.stringify({ text, updatedAt: Date.now() }))
+
+    // Updating a draft is the hot typing path; scan retention only for a newly saved scope.
+    return { saved: true, retired: existed ? [] : retireOldOwnedDrafts(key, preserveKeys) }
+  } catch {
+    return { saved: false, retired: [] }
+  }
+}
+
+function retireOldOwnedDrafts(currentKey: string, preserveKeys: readonly string[]): string[] {
+  const owner = parseOwnedDraftKey(currentKey)?.ownerKey
+  const rows = loadOwnedDraftTexts()?.entries.filter(row => parseOwnedDraftKey(row.key)?.ownerKey === owner) ?? []
