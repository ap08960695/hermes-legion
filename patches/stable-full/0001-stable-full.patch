+++ b/apps/desktop/electron/roster-source-fetch.ts
@@ -1 +1,42 @@
+import type { ConnectionRegistry, ResolvedConnectionDescriptor } from './connection-registry'
+import { resolvedConnectionId } from './connection-registry'
+
+/** Read only already-settled, still-owned descriptors; a roster never owns a dial. */
+export async function readConnectedRosterSource(
+  registry: ConnectionRegistry,
+  connectionId: string,
+  primary: { getPromise: () => Promise<ResolvedConnectionDescriptor> | null },
+  pool: Map<string, { connectionPromise: Promise<ResolvedConnectionDescriptor> | null }>
+): Promise<null | { descriptor: ResolvedConnectionDescriptor; scope: null | string; isCurrent: () => boolean }> {
+  if (!registry.connections.some(source => source.id === connectionId)) {
+    return null
+  }
+
+  const primaryPromise = primary.getPromise()
+
+  const candidates = [
+    { promise: primaryPromise, scope: null as null | string, isCurrent: () => primary.getPromise() === primaryPromise },
+    ...[...pool].map(([scope, entry]) => {
+      const promise = entry.connectionPromise
+
+      return { promise, scope, isCurrent: () => pool.get(scope) === entry && entry.connectionPromise === promise }
+    })
+  ]
+
+  for (const candidate of candidates) {
+    if (!candidate.promise) {
+      continue
+    }
+
+    // A pending or rejected dial stays on demand; never wait for it or retry it here.
+    const descriptor = await Promise.race([candidate.promise, Promise.resolve(null)]).catch(() => null)
+
+    if (descriptor && candidate.isCurrent() && resolvedConnectionId(registry, descriptor) === connectionId) {
+      return { descriptor, scope: candidate.scope, isCurrent: candidate.isCurrent }
+    }
+  }
+
+  return null
+}
