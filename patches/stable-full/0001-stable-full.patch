+const ids =
+  'sessions goals summary runs hub schedules import profiles skills tools connectors plugins starmap messaging webhooks models accounts gateway usage memory appearance notifications keybinds privacy storage settings about'.split(
+    ' '
+  )
+const features = (labels: string[]) => Object.fromEntries(ids.map((id, i) => [id, labels[i]]))
+const en = {
+  newChat: 'New chat',
+  searchAllChats: 'Search all saved chats',
+  searchInMessages: 'Search in messages',
+  messageSearchPlaceholder: 'Search saved messages…',
+  searchMatchId: 'Session ID match',
+  searchMatchTitle: 'Title match',
+  messageSearchHint: 'Enter a word or phrase from a saved chat.',
+  messageSearchLoading: 'Searching saved messages…',
+  messageSearchFailed: 'Could not search saved messages.',
