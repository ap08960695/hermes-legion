+@pytest.mark.platforms('posix')
+def test_native_control_socket_exposes_read_only_memory_counters(tmp_path):
+    async def exercise():
+        server = GatewayControlServer(tmp_path)
+        assert await server.start()
+        try:
+            result = await asyncio.to_thread(query_gateway_control, tmp_path, 'memory-stats')
+            assert result and result.get('pid') == os.getpid()
+            assert isinstance(result.get('process'), dict)
+            assert result['sqlite']['reset_highwater'] is False
+        finally:
+            await server.stop()
+    asyncio.run(exercise())
+
+
+def test_cache_diagnostics_count_containers_without_inspecting_their_contents(monkeypatch):
