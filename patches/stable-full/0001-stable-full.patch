+import { resolve } from 'node:path'
+
+import { expect, test } from '@playwright/test'
+import { createServer } from 'vite'
+
+test.use({
+  launchOptions: {
+    args: ['--disable-gpu'],
+    executablePath: process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH
+  },
+  viewport: { width: 640, height: 480 }
+})
+
+test('saved answer cards request only the external images approved for that card', async ({ page }) => {
+  const server = await createServer({
+    root: resolve(import.meta.dirname, '..'),
+    optimizeDeps: { entries: ['e2e/answer-cards-images.fixture.html'] },
+    server: { port: 0, hmr: false }
+  })
+
+  try {
+    await server.listen()
+    const [origin] = server.resolvedUrls!.local
+    const fixtureOrigin = new URL(origin).origin
+    const image = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aWQAAAABJRU5ErkJggg=='
+    const embedded = `data:image/png;base64,${image}`
+    const singleUrl = 'https://single.example.invalid/image.png'
+    const galleryUrls = ['https://gallery.example.invalid/first.png', 'https://photos.example.invalid/second.png']
+    const updatedUrls = [galleryUrls[0].replace('first.png', 'updated.png'), galleryUrls[1]]
+    const cards = (urls: string[]) =>
+      JSON.stringify({
+        cards: [
+          { title: 'Single image', images: [singleUrl] },
+          { title: 'Image gallery', images: [embedded, ...urls] }
+        ]
+      })
+    const remoteRequests: string[] = []
+
+    await page.route(
+      url => (url.protocol === 'http:' || url.protocol === 'https:') && url.origin !== fixtureOrigin,
+      async route => {
+        remoteRequests.push(route.request().url())
+        await route.fulfill({ contentType: 'image/png', body: Buffer.from(image, 'base64') })
+      }
+    )
+    await page.addInitScript(
+      ({ original, updated }) => {
+        localStorage.setItem('saved-answer', original)
+        localStorage.setItem('updated-answer', updated)
+      },
+      { original: cards(galleryUrls), updated: cards(updatedUrls) }
+    )
+    await page.goto(new URL('e2e/answer-cards-images.fixture.html', origin).href)
+    await page.getByRole('button', { name: 'Open saved answer' }).click()
+
+    const single = page.getByRole('article').filter({ has: page.getByRole('heading', { name: 'Single image' }) })
+    const gallery = page.getByRole('article').filter({ has: page.getByRole('heading', { name: 'Image gallery' }) })
+    await single.scrollIntoViewIfNeeded()
+    await gallery.scrollIntoViewIfNeeded()
+    const embeddedImage = gallery.getByRole('img', { name: 'Image gallery 1' })
+
+    await embeddedImage.evaluate(node => (node as HTMLImageElement).decode())
+    expect(remoteRequests).toEqual([])
+    await expect(single.locator('img')).toHaveCount(0)
+    await expect(gallery.locator('img')).toHaveCount(1)
+    await expect(single.getByText('single.example.invalid', { exact: true })).toBeVisible()
+    await expect(gallery.getByText('gallery.example.invalid', { exact: true })).toBeVisible()
+    await expect(gallery.getByText('photos.example.invalid', { exact: true })).toBeVisible()
+
+    await single.getByRole('button', { name: 'Preview anyway' }).focus()
+    await page.keyboard.press('Tab')
+    const loadGallery = gallery.getByRole('button', { name: 'Preview anyway' })
+
+    await expect(loadGallery).toBeFocused()
+    await page.keyboard.press('Enter')
+    await gallery.getByRole('img', { name: 'Image gallery 3' }).scrollIntoViewIfNeeded()
+    await expect.poll(() => [...remoteRequests].sort()).toEqual([...galleryUrls].sort())
+    await expect(single.locator('img')).toHaveCount(0)
+
+    await page.getByRole('button', { name: 'Replace saved answer' }).click()
+    await gallery.scrollIntoViewIfNeeded()
+    await expect(loadGallery).toBeVisible()
+    await expect(gallery.locator('img')).toHaveCount(1)
+    await embeddedImage.evaluate(node => (node as HTMLImageElement).decode())
+    expect([...remoteRequests].sort()).toEqual([...galleryUrls].sort())
+  } finally {
+    await server.close()
+  }
+})
