diff --git a/apps/desktop/src/app/contrib/workspace-routes.tsx b/apps/desktop/src/app/contrib/workspace-routes.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..49c319fe54968e8bc78badd2dd2ec8664bf97eb3
--- /dev/null
+++ b/apps/desktop/src/app/contrib/workspace-routes.tsx
@@ -0,0 +1,79 @@
+import { lazy, Suspense, type ReactNode } from 'react'
+import { Navigate, Route, Routes, useParams } from 'react-router'
+import { ContribBoundary, ContribRender } from '@/contrib/react/boundary'
+import { type contributedRoutes, NEW_CHAT_ROUTE, sessionRoute } from '../routes'
+const SessionManager = lazy(async () => ({ default: (await import('../session-manager')).SessionManager }))
+import { setStatusbarItemGroup } from './panes'
+import { SidebarSurface } from './surfaces'
+import type { WiringActions } from './types'
+const ArtifactsView = lazy(async () => ({ default: (await import('@/plugins/hermes-spaces/page')).SpacesPage }))
+const MessagingView = lazy(async () => ({ default: (await import('../messaging')).MessagingView }))
+const CapabilitiesView = lazy(async () => ({ default: (await import('../capabilities')).CapabilitiesView }))
+function LegacySessionRedirect() {
+  const { sessionId } = useParams()
+  return <Navigate replace to={sessionId ? sessionRoute(sessionId) : NEW_CHAT_ROUTE} />
+}
+const page = (view: ReactNode) => (
+  <div className="contents">
+    <Suspense fallback={null}>{view}</Suspense>
+  </div>
+)
+export function WorkspaceRoutes({
+  actions,
+  chatView,
+  routeContributions
+}: {
+  actions: WiringActions
+  chatView: ReactNode
+  routeContributions: ReturnType<typeof contributedRoutes>
+}) {
+  return (
+    <Routes>
+      <Route
+        element={page(
+          <SessionManager mode="history">
+            <SidebarSurface key="history" actions={actions} currentView="chat" managerPage />
+          </SessionManager>
+        )}
+        path="history"
+      />
+      <Route
+        element={page(
+          <SessionManager mode="projects">
+            <SidebarSurface key="projects" actions={actions} currentView="chat" managerPage />
+          </SessionManager>
+        )}
+        path="projects"
+      />
+      <Route element={chatView} index />
+      <Route element={chatView} path=":sessionId" />
+      <Route element={page(<CapabilitiesView setStatusbarItemGroup={setStatusbarItemGroup} />)} path="capabilities" />
+      <Route element={page(<MessagingView setStatusbarItemGroup={setStatusbarItemGroup} />)} path="messaging" />
+      <Route element={page(<ArtifactsView />)} path="artifacts" />
+      <Route element={null} path="agents" />
+      <Route element={null} path="command-center" />
+      <Route element={null} path="cron" />
+      <Route element={null} path="profiles" />
+      <Route element={null} path="settings" />
+      <Route element={null} path="starmap" />
+      <Route element={null} path="webhooks" />
+      {/* Registry-contributed pages (core features + plugins) render in the
+          workspace pane like any built-in view — behind the same blast wall
+          as every other contribution mount. */}
+      {routeContributions.map(route => (
+        <Route
+          element={page(
+            <ContribBoundary id={route.key}>
+              <ContribRender render={route.render} />
+            </ContribBoundary>
+          )}
+          key={route.key}
+          path={route.path.slice(1)}
+        />
+      ))}
+      <Route element={<Navigate replace to={NEW_CHAT_ROUTE} />} path="new" />
+      <Route element={<LegacySessionRedirect />} path="sessions/:sessionId" />
+      <Route element={<Navigate replace to={NEW_CHAT_ROUTE} />} path="*" />
+    </Routes>
+  )
+}
