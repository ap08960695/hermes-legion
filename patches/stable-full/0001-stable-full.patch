+"""Deep native pagination keeps shell-visible content and full-file tracking."""
+import hashlib
+import json
+
+import pytest
+
+from tools.environments.local import LocalEnvironment
+from tools.file_operations import ShellFileOperations
+
+pytestmark = pytest.mark.platforms("linux", "macos")
+
+CHUNK = 1 << 20
+
+
+@pytest.mark.parametrize("offset", [CHUNK // 2 - 1, CHUNK // 2, CHUNK // 2 + 1, CHUNK + 3])
+@pytest.mark.parametrize("ending", [b"\n", b""])
+def test_deep_page_matches_shell_at_chunk_and_eof(tmp_path, monkeypatch, offset, ending):
+    data = b"x\n" * CHUNK + b"last" + ending
+    path = tmp_path / "generated.txt"
+    path.write_bytes(data)
+    ops = ShellFileOperations(LocalEnvironment(cwd=str(tmp_path)), cwd=str(tmp_path))
+    monkeypatch.setenv("HERMES_NATIVE_FILE_READ", "1")
+    native = ops.read_file(str(path), offset=offset, limit=3)
+    monkeypatch.setenv("HERMES_NATIVE_FILE_READ", "0")
+    shell = ops.read_file(str(path), offset=offset, limit=3)
+    assert native.to_dict() == shell.to_dict()
+    assert native._snapshot[-1] == hashlib.sha256(data).digest()
+
+
+@pytest.mark.parametrize("prefix", [
+    b"a" * (CHUNK + 7) + b"\n",
+    b"x\n" * (CHUNK // 2) + b"long" * CHUNK + b"\n",
+    ("ข้อมูล\r\n" * 100_000).encode(),
+], ids=["long-prefix-line", "long-cross-chunk-line", "thai-crlf"])
+def test_deep_page_after_partial_and_multibyte_lines(tmp_path, monkeypatch, prefix):
+    data = prefix + "ท้ายไฟล์\r\nnext\nfinal".encode()
+    path = tmp_path / "generated.txt"
+    path.write_bytes(data)
+    offset = prefix.count(b"\n") + 1
+    ops = ShellFileOperations(LocalEnvironment(cwd=str(tmp_path)), cwd=str(tmp_path))
+    monkeypatch.setenv("HERMES_NATIVE_FILE_READ", "1")
+    native = ops.read_file(str(path), offset=offset, limit=3)
+    monkeypatch.setenv("HERMES_NATIVE_FILE_READ", "0")
+    shell = ops.read_file(str(path), offset=offset, limit=3)
+    assert native.to_dict() == shell.to_dict()
+    assert native._snapshot[-1] == hashlib.sha256(data).digest()
+
+
+def test_registry_deep_read_preserves_page_metadata(tmp_path, monkeypatch):
+    from tools import file_tools
+
+    path = tmp_path / "generated.txt"
+    path.write_bytes(b"x\n" * CHUNK + b"tail\n")
+    ops = ShellFileOperations(LocalEnvironment(cwd=str(tmp_path)), cwd=str(tmp_path))
+    monkeypatch.setenv("HERMES_NATIVE_FILE_READ", "1")
+    monkeypatch.setattr(file_tools, "_get_file_ops", lambda task_id: ops)
+    result = json.loads(file_tools.registry.dispatch(
+        "read_file", {"path": str(path), "offset": CHUNK, "limit": 2}, task_id="deep-read-test",
+    ))
+    assert "error" not in result
+    assert result["total_lines"] == CHUNK + 1
+    assert "tail" in result["content"]
+    assert len(result["content"].splitlines()) == 2
