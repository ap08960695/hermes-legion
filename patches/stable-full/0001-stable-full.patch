+"""Profile-bound data markers refuse dispatch and direct claims before a worker starts."""
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+from hermes_cli.config import atomic_config_replace
+
+
+@pytest.fixture
+def world(tmp_path, monkeypatch):
+    home = tmp_path / 'state'
+    home.mkdir()
+    monkeypatch.setattr(Path, 'home', lambda: tmp_path / 'user')
+    monkeypatch.setenv('HERMES_HOME', str(home))
+    monkeypatch.setenv('HERMES_KANBAN_HOME', str(tmp_path / 'board'))
+    monkeypatch.delenv('HERMES_KANBAN_DB', raising=False)
+    profile = home / 'profiles' / 'bounded-lane'
+    profile.mkdir(parents=True)
+    atomic_config_replace(profile / 'config.yaml', {'kanban': {'blocked_task_markers': ['confidential-fixture']}})
+    conn = kbc.connect()
+    yield conn, home, profile, tmp_path
+    conn.close()
+
+
+@pytest.mark.parametrize('field', ['title', 'body', 'tenant', 'workspace_path'])
+def test_confidential_task_cannot_claim_or_consume_a_run(world, field):
+    conn, _, _, root = world
+    args = {'title': 'Allowed task', 'body': 'Bounded fixture', 'assignee': 'bounded-lane'}
+    args[field] = str(root / 'CONFIDENTIAL-fixture') if field == 'workspace_path' else 'CONFIDENTIAL-fixture'
+    tid = kb.create_task(conn, **args)
+    with pytest.raises(ValueError, match='profile data boundary'):
+        kb.claim_task(conn, tid)
+    assert kb.get_task(conn, tid).status == 'ready'
+    assert kb.list_runs(conn, tid) == []
+
+
+def test_dispatch_blocks_the_same_task_without_spawning_or_retry(world):
+    from hermes_cli.kanban_task_contract import guard_dispatch
+
+    conn = world[0]
+    tid = kb.create_task(conn, title='Confidential-fixture task', assignee='bounded-lane')
+    row = conn.execute('SELECT * FROM tasks WHERE id=?', (tid,)).fetchone()
+    result = SimpleNamespace(respawn_guarded=[])
+    assert guard_dispatch(conn, row, 'bounded-lane', result, dry_run=False)
+    assert result.respawn_guarded and kb.get_task(conn, tid).status == 'blocked'
+    # Native capability blocks retain an administrative terminal run, without a claim or worker.
+    assert all(run.outcome == 'blocked' and run.claim_lock is None and run.worker_pid is None
+               for run in kb.list_runs(conn, tid))
+    assert conn.execute("SELECT count(*) FROM task_events WHERE task_id=? "
+                        "AND kind IN ('claimed','worker_started','worker_spawned')", (tid,)).fetchone()[0] == 0
+
+
+def test_lane_policy_uses_worker_profile_and_fails_closed_when_malformed(world):
+    conn, home, profile, _ = world
+    atomic_config_replace(home / 'config.yaml', {'kanban': {'blocked_task_markers': ['ordinary']}})
+    tid = kb.create_task(conn, title='ordinary allowed task', assignee='bounded-lane')
+    assert kb.claim_task(conn, tid) is not None
+    assert kb.complete_task(conn, tid, summary='Fixture complete', fire_lifecycle_hook=False)
+    atomic_config_replace(profile / 'config.yaml', {'kanban': {'blocked_task_markers': 'invalid'}})
+    other = kb.create_task(conn, title='another task', assignee='bounded-lane')
+    with pytest.raises(ValueError, match='invalid.*data boundary'):
+        kb.claim_task(conn, other)
+    assert kb.list_runs(conn, other) == []
diff --git a/tests/hermes_cli/test_kanban_tui_delivery.py b/tests/hermes_cli/test_kanban_tui_delivery.py
new file mode 100644
index 0000000000000000000000000000000000000000..dafbff77c848b4232f6c9c5a0df9aaaa89a79e59
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_tui_delivery.py
@@ -0,0 +1,161 @@
+"""Durable TUI receipt identity, atomicity and fencing on real isolated SQLite."""
+from concurrent.futures import ThreadPoolExecutor
+import threading
+
+import pytest
+
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_tui_delivery as delivery
+from hermes_cli import kanban_db_notify as notify
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+KEY = 'storage-fixture'
+
+
+def _prepared(conn, *, text='same rendered text'):
+    tid = kb.create_task(conn, title='receipt fixture')
+    event = kb.list_events(conn, tid)[-1]
+    sub = {'task_id': tid, 'chat_id': KEY}
+    notify.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY)
+    with kbc.write_txn(conn):
+        result = delivery.prepare(conn, sub, event.id, text)
+    return result
+
+
+def _receipts(path, **kwargs):
+    return delivery.read_receipts(path, home=delivery.owner_home(), session_key=KEY, **kwargs)
+
+
+def test_prepare_rolls_back_with_the_cursor_transaction():
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title='atomic prepare')
+        event = kb.list_events(conn, tid)[-1]
+        with pytest.raises(RuntimeError, match='rollback'):
+            with kbc.write_txn(conn):
+                delivery.prepare(conn, {'task_id': tid, 'chat_id': KEY}, event.id, 'not committed')
+                raise RuntimeError('rollback')
+    assert _receipts(kb.kanban_db_path()) == []
+
+
+def test_two_consumers_cannot_claim_the_same_receipt():
+    with kbc.connect_closing() as conn:
+        text = _prepared(conn)
+    barrier = threading.Barrier(2, timeout=5)
+    home = delivery.owner_home()
+
+    def claim():
+        barrier.wait()
+        texts, claim = delivery.claim([text], home=home, session_key=KEY)
+        return len(texts), claim
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        outcomes = list(pool.map(lambda _: claim(), range(2)))
+    assert sorted(size for size, _ in outcomes) == [0, 1]
+    assert _receipts(kb.kanban_db_path())[0]['state'] == 'claimed'
+
+
+def test_refusal_release_is_fenced_against_a_late_callback():
+    with kbc.connect_closing() as conn:
+        text = _prepared(conn)
+    args = {'home': delivery.owner_home(), 'session_key': KEY}
+    _, old = delivery.claim([text], **args)
+    old.mark('pending')
+    _, current = delivery.claim([text], **args)
+    assert old.token != current.token
+    old.mark('settled')
+    assert _receipts(kb.kanban_db_path())[0]['state'] == 'claimed'
+    current.mark('admitted')
+    current.mark('settled')
+    current.mark('failed')
+    assert _receipts(kb.kanban_db_path())[0]['state'] == 'settled'
+
+
+def test_fast_terminal_callback_cannot_be_downgraded_to_admitted():
+    with kbc.connect_closing() as conn:
+        text = _prepared(conn)
+    _, claim = delivery.claim([text], home=delivery.owner_home(), session_key=KEY)
+    claim.mark('settled')
+    claim.mark('admitted')
+    assert _receipts(kb.kanban_db_path())[0]['state'] == 'settled'
+
+
+def test_pending_and_claims_are_scoped_by_profile_home(tmp_path):
+    with kbc.connect_closing() as conn:
+        text = _prepared(conn)
+    own = delivery.owner_home()
+    token = set_hermes_home_override(tmp_path / 'other-profile')
+    try:
+        assert delivery.owner_home() != own
+        assert delivery.pending(kb.kanban_db_path(), home=delivery.owner_home(), session_key=KEY) == []
+        texts, claim = delivery.claim([text], home=delivery.owner_home(), session_key=KEY)
+        assert texts == [] and claim.refs == ()
+    finally:
+        reset_hermes_home_override(token)
+    assert len(delivery.pending(kb.kanban_db_path(), home=own, session_key=KEY)) == 1
+
+
+def test_receipt_reads_do_not_create_a_missing_database_or_legacy_schema(tmp_path):
+    missing = tmp_path / 'absent.db'
+    assert _receipts(missing) == []
+    assert not missing.exists()
+    with kbc.connect_closing() as conn:
+        assert not conn.execute("SELECT 1 FROM sqlite_master WHERE name=?", (delivery.TABLE,)).fetchone()
+    assert _receipts(kb.kanban_db_path()) == []
+    with kbc.connect_closing() as conn:
+        assert not conn.execute("SELECT 1 FROM sqlite_master WHERE name=?", (delivery.TABLE,)).fetchone()
+
+
+def test_identical_text_for_distinct_events_retains_distinct_receipts():
+    with kbc.connect_closing() as conn:
+        first, second = _prepared(conn), _prepared(conn)
+    assert first == second
+    assert first.delivery_ref != second.delivery_ref
+    texts, claim = delivery.claim([first, second], home=delivery.owner_home(), session_key=KEY)
+    assert len(texts) == len(claim.refs) == 2
+
+
+def test_symlinked_board_recovery_keeps_the_same_delivery_identity(tmp_path):
+    real = tmp_path / 'real.db'
+    with kbc.connect_closing(real):
+        pass
+    alias = tmp_path / 'alias.db'
+    alias.symlink_to(real)
+    with kbc.connect_closing(alias) as conn:
+        text = _prepared(conn)
+    restored = delivery.pending(real, home=delivery.owner_home(), session_key=KEY)
+    assert len(restored) == 1 and restored[0].delivery_ref == text.delivery_ref
+
+
+def test_terminal_callback_keeps_its_captured_home_when_context_changes(tmp_path):
+    path, home = kb.kanban_db_path(), delivery.owner_home()
+    with kbc.connect_closing(path) as conn:
+        text = _prepared(conn)
+    _, claim = delivery.claim([text], home=home, session_key=KEY)
+    token = set_hermes_home_override(tmp_path / 'unrelated-profile')
+    try:
+        claim.mark('settled')
+    finally:
+        reset_hermes_home_override(token)
+    assert delivery.read_receipts(path, home=home, session_key=KEY)[0]['state'] == 'settled'
+
+
+def test_unsubscribe_cancels_pending_receipts_even_if_the_route_is_recreated():
+    with kbc.connect_closing() as conn:
+        text = _prepared(conn)
+        tid = _receipts(kb.kanban_db_path())[0]['task_id']
+        assert notify.remove_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY)
+        notify.add_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY)
+    assert _receipts(kb.kanban_db_path())[0]['state'] == 'cancelled'
+    texts, claim = delivery.claim([text], home=delivery.owner_home(), session_key=KEY)
+    assert texts == [] and claim.refs == ()
+
+
+def test_unsubscribe_preserves_an_already_claimed_ambiguous_receipt():
+    with kbc.connect_closing() as conn:
+        text = _prepared(conn)
+    _, claim = delivery.claim([text], home=delivery.owner_home(), session_key=KEY)
+    with kbc.connect_closing() as conn:
+        tid = _receipts(kb.kanban_db_path())[0]['task_id']
+        assert notify.remove_notify_sub(conn, task_id=tid, platform='tui', chat_id=KEY)
+    assert _receipts(kb.kanban_db_path())[0]['state'] == 'claimed'
+    claim.mark('settled')
+    assert _receipts(kb.kanban_db_path())[0]['state'] == 'settled'
