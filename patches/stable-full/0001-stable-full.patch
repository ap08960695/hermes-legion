diff --git a/apps/desktop/electron/native/pet-overlay-x11.c b/apps/desktop/electron/native/pet-overlay-x11.c
new file mode 100644
index 0000000000000000000000000000000000000000..cd91950b016d7ce8e896897d2d4d0217df58f47e
--- /dev/null
+++ b/apps/desktop/electron/native/pet-overlay-x11.c
@@ -0,0 +1,56 @@
+// Keep the ARGB surface intact and set only the X Shape input region.
+#include <X11/Xlib.h>
+#include <X11/extensions/shape.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#define MAX_RECTS 4096
+
+static int x_error(Display *display, XErrorEvent *event) {
+  (void)display;
+  (void)event;
+  _Exit(1);
+}
+
+int main(int argc, char **argv) {
+  if (argc != 2) return 1;
+  char *end = NULL;
+  unsigned long window = strtoul(argv[1], &end, 10);
+  if (!window || *end) return 1;
+
+  Display *display = XOpenDisplay(NULL);
+  if (!display) return 1;
+  XSetErrorHandler(x_error);
+  int major, minor;
+  if (!XShapeQueryVersion(display, &major, &minor) ||
+      major < 1 || (major == 1 && minor < 1)) return 1;
+
+  XRectangle rects[MAX_RECTS];
+  // Reset on entering and leaving character mode. Unlike ShapeBounding,
+  // ShapeInput does not clip shadows, hints, or a falling sprite.
+  for (int count = 0; ; ) {
+    if (count < 0) {
+      XShapeCombineMask(display, window, ShapeInput, 0, 0, None, ShapeSet);
+    } else {
+      for (int i = 0; i < count; i++) {
+        unsigned int x, y, width, height;
+        if (scanf("%u%u%u%u", &x, &y, &width, &height) != 4 ||
+            x > 32767 || y > 32767 || !width || !height ||
+            width > 32767 || height > 32767) return 1;
+        rects[i] = (XRectangle) { (short)x, (short)y, (unsigned short)width, (unsigned short)height };
+      }
+      XShapeCombineRectangles(display, window, ShapeInput, 0, 0, rects,
+                              count, ShapeSet, Unsorted);
+    }
+    XSync(display, False);
+    // Acknowledge after the server has accepted the region. The caller keeps
+    // at most one update in flight and may replace an unsent frame.
+    if (puts("ok") == EOF || fflush(stdout) == EOF) break;
+
+    int result = scanf("%d", &count);
+    if (result == EOF) break;
+    if (result != 1 || count < -1 || count > MAX_RECTS) return 1;
+  }
+  XCloseDisplay(display);
+  return 0;
+}
