+def test_explicit_profiler_statistics_expose_only_bounded_sanitized_counts():
+    from gateway import runtime_memory
+    owned = not tracemalloc.is_tracing()
+    if owned:
+        tracemalloc.start(4)
+    try:
+        result = runtime_memory.collect_runtime_memory(include_allocations=True)
+        stats = result['allocations']
+        assert stats['available'] is True and len(stats['sites']) <= 30
+        for site in stats['sites']:
+            assert set(site) == {'site', 'bytes', 'count'}
+            assert not site['site'].startswith('/')
+            assert site['bytes'] >= 0 and site['count'] >= 0
+        assert 'traceback' not in json.dumps(stats)
+    finally:
+        if owned:
+            tracemalloc.stop()
