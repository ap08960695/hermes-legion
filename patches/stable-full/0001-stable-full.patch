+import { goToProject } from '@/store/projects'
+import { navigateToWorkspacePage } from '../routes'
+/** A project selection now reveals its actual manager instead of a hidden column. */
+export function openProjectTarget(
+  id: string,
+  event: { ctrlKey?: boolean; metaKey?: boolean } | undefined,
+  navigate: (path: string) => void
+) {
