+import { expect, it } from 'vitest'
+
+import { encodePetInputRegion, x11PetOverlayAvailable } from './pet-overlay-linux'
+
+it('admits XWayland only when the X11 backend was selected and has a display', () => {
+  const session = { XDG_SESSION_TYPE: 'wayland', WAYLAND_DISPLAY: 'wayland-0', DISPLAY: ':0' }
+  expect(x11PetOverlayAvailable(session, [])).toBe(false)
+  expect(x11PetOverlayAvailable(session, ['--ozone-platform=x11'])).toBe(true)
+  expect(x11PetOverlayAvailable({ DISPLAY: ':0' }, [])).toBe(true)
+  expect(x11PetOverlayAvailable({ WAYLAND_DISPLAY: 'wayland-0' }, ['--ozone-platform=x11'])).toBe(false)
+})
+
+it('only serializes bounded, integral input regions', () => {
+  expect(encodePetInputRegion([])).toBe('0\n')
+  expect(encodePetInputRegion([1, 2, 3, 4, 10, 20, 30, 40])).toBe('2 1 2 3 4 10 20 30 40\n')
+  expect(encodePetInputRegion([1, 2, 0, 4])).toBeUndefined()
+  expect(encodePetInputRegion([1, 2, 3.5, 4])).toBeUndefined()
+  expect(encodePetInputRegion([1, 2, 30, 32768])).toBeUndefined()
+  expect(encodePetInputRegion(Array(4 * 4097).fill(1))).toBeUndefined()
+})
