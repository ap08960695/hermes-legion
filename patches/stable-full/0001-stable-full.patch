+beforeEach(() => {
+  dispose = registerPluginLocales('hermes-bots', BOTS_LOCALES)
+  client = new QueryClient({ defaultOptions: { queries: {
+    retry: false, refetchOnWindowFocus: false, refetchOnReconnect: false
+  } } })
+  $botManagementOpen.set(false)
+  $botAttention.set({})
+  $botMeta.set({})
