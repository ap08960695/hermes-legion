+        {selected && (
+          <Button onClick={event => {
+            if (event.currentTarget === event.currentTarget.ownerDocument.activeElement) {
+              const target = picker.current?.querySelector<HTMLButtonElement>('button[aria-pressed="true"]') ?? picker.current
+              target?.focus()
+            }
+            select(null)
+          }} size="sm" variant="ghost">
+            <Codicon name="arrow-left" />
+            {k.work.all}
+          </Button>
+        )}
+        {tasks.slice(0, limit).map(task => (
+          <Button aria-pressed={selected === task.id} key={task.id} onClick={() => select(task.id)} variant="ghost">
+            <Codicon name="tasklist" />
+            <span className="min-w-0">
+              <span className="block">{task.title}</span>{' '}
+              {(titleCounts.get(task.title) ?? 0) > 1 && (
+                <span className="block text-xs text-muted-foreground">
+                  {columnLabel(k, task.status)} · {task.assignee || k.unassigned} · <code>{task.id}</code>
+                </span>
+              )}
+            </span>
+          </Button>
+        ))}
+        <ShowMore
+          cardSelector="button[aria-pressed]"
+          k={k}
+          onMore={() => setLimit(limit + 50)}
+          total={tasks.length}
+          visible={Math.min(limit, tasks.length)}
+        />
+      </nav>
+      {selected ? (
+        <WorkDetail board={selectedBoard} id={selected} key={`${selectedBoard}:${selected}`} onOpen={onOpen} />
+      ) : (
+        <p className="kanban-delivery-empty">{k.work.choose}</p>
+      )}
+    </section>
+  )
+}
