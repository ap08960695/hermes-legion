+import json
+from hermes_cli import kanban_db as kb, kanban_db_connect as kbc, kanban_db_dispatch as kd
+from hermes_cli.kanban_failure_receipt import failure_receipt
+
+
+def test_failure_receipt_never_contains_raw_error():
+    receipt = failure_receipt('t', 12, 'spawn_failed', phase='spawn', error_type='secret arbitrary text')
+    assert receipt['error_type'] == 'unknown'
+    assert receipt['run_id'] == 12
+    assert receipt['process_started'] is None
+    assert 'secret' not in json.dumps(receipt)
+    assert failure_receipt('t', 12, 'spawn_failed', phase='workspace')['process_started'] is False
+
+
+def test_native_failure_event_bound_to_ended_run():
+    with kbc.connect_closing() as conn:
+        task = kb.create_task(conn, title='fixture', assignee='worker')
+        kb.claim_task(conn, task)
+        run = kb.get_task(conn, task).current_run_id
+        kd._record_task_failure(conn, task, 'fixture failure', outcome='spawn_failed',
+                                release_claim=True, end_run=True, failure_limit=5,
+                                event_payload_extra={'diagnostic': {'phase': 'workspace', 'error_type': 'OSError'}})
+        row = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='spawn_failed' ORDER BY id DESC LIMIT 1", (task,)).fetchone()
+        evidence = json.loads(row['payload'])['failure_diagnostic']
+        assert evidence['run_id'] == run
+        assert evidence['phase'] == 'workspace'
+        assert kb.get_task(conn, task).consecutive_failures == 1
+
+
+def test_advisory_records_uncertainty_without_changing_completion_gate():
+    with kbc.connect_closing() as conn:
+        task = kb.create_task(conn, title='fixture', assignee='worker')
+        assert kb.complete_task(conn, task, summary='TBD')
+        assert kb.get_task(conn, task).status == 'done'
+        row = conn.execute("SELECT payload FROM task_events WHERE task_id=? AND kind='completed' ORDER BY id DESC LIMIT 1", (task,)).fetchone()
+        assert 'placeholder_completion_summary' in row['payload']
+
+
+def test_clean_completion_metadata_is_not_inflated():
+    from hermes_cli.kanban_completion_advisory import annotate
+    assert annotate(None, 'Implemented and checked') is None
+    evidence = {'verification': {'status': 'prepared', 'checks': [{'status': 'skipped'}]}}
+    result = annotate(evidence)
+    assert result['completion_advisory']['verified'] is False
+    assert set(result['completion_advisory']['warnings']) == {'verification_not_observed', 'skipped_check_without_reason'}
+    assert 'completion_advisory' not in evidence
