@@ -0,0 +1,63 @@
+import type { RefObject } from 'react'
+
+import {
+  type ComposerAttachment,
+  type ComposerAttachmentScope,
+  isFreshDraftScope,
+  stashSessionDraft
+} from '@/store/composer'
+import { draftOwnerKey } from '@/store/composer-draft-owner'
+import { type ComposerDraftRetry, matchingDraftRetry, writeDraftRetry } from '@/store/composer-draft-retry'
+import type { SessionOwnerScope } from '@/store/session-request-router'
+
+interface DraftAccessArgs {
+  attachmentScope: ComposerAttachmentScope
+  draftRef: RefObject<string>
+  draftOwnerRef: RefObject<SessionOwnerScope>
+  draftRetryRef: RefObject<ComposerDraftRetry | undefined>
+  draftScopeRef: RefObject<string | null>
+}
+
+/** All writes carry the committed editor owner; async callers supply their captured owner explicitly. */
+export function createComposerDraftAccess({
+  attachmentScope,
+  draftRef,
+  draftOwnerRef,
+  draftRetryRef,
+  draftScopeRef
+}: DraftAccessArgs) {
+  const stashAt = (
+    scope: string | null,
+    text = draftRef.current,
+    attachments = attachmentScope.$attachments.get(),
+    owner = draftOwnerRef.current
+  ) => stashSessionDraft(scope, text, attachments, owner)
+
+  const sameDraftScope = (a: string | null | undefined, b: string | null | undefined) =>
+    (isFreshDraftScope(a) || !a ? null : a) === (isFreshDraftScope(b) || !b ? null : b)
+
+  // A rejected or unconfirmed send is restored with its identity, so Enter on that exact draft is
+  // the explicit retry. Recorded per draft scope (it survives a reload with the draft text).
+  const rememberDraftRetry = (scope: string | null, retry: ComposerDraftRetry, owner = draftOwnerRef.current) => {
+    writeDraftRetry(scope, retry, owner)
+
+    if (sameDraftScope(scope, draftScopeRef.current) && draftOwnerKey(owner) === draftOwnerKey(draftOwnerRef.current)) {
+      draftRetryRef.current = retry
+    }
+  }
+
+  // The identity a send of exactly this draft retries, if any. Spent by the send either way: a
+  // rejection restores it again, and an accepted send leaves nothing to retry.
+  const takeDraftRetry = (text: string, attachments: ComposerAttachment[]) => {
+    const retry = matchingDraftRetry(draftRetryRef.current, text, attachments)
+    draftRetryRef.current = undefined
+
+    if (retry) {
+      writeDraftRetry(draftScopeRef.current, undefined, draftOwnerRef.current)
+    }
+
+    return retry
+  }
+
+  return { stashAt, rememberDraftRetry, takeDraftRetry }
+}
