@@ -0,0 +1,209 @@
+import { useStore } from '@nanostores/react'
+import type { ReactNode } from 'react'
+import { useNavigate } from 'react-router'
+
+import { Button } from '@/components/ui/button'
+import { Codicon } from '@/components/ui/codicon'
+import { CommandGroup, CommandItem, CommandList } from '@/components/ui/command'
+import { sessionTitle } from '@/lib/chat-runtime'
+import { closeCommandPalette } from '@/store/command-palette'
+import { $activeConnectionId, $pendingConnectionId } from '@/store/connections'
+import { $activeGatewayProfile, normalizeProfileKey } from '@/store/profile'
+import { $sessions, lineageAliases } from '@/store/session'
+import { $focusedTreePaneId, TILE_PANE_PREFIX } from '@/store/session-focus'
+import { isSessionOwnerRoute, sessionOwnerRouteFromRow } from '@/store/session-request-router'
+import { $sessionTiles, runtimeSessionOwner } from '@/store/session-states'
+
+import { searchResultToSession, stripFtsMarkers } from '../chat/sidebar/search-hit'
+import { useServerSessionSearch } from '../chat/sidebar/use-server-session-search'
+import { useFocusCopy } from '../focus/copy'
+import { openSessionFromPicker } from '../open-session'
+
+function openSearchInHistory(navigate: (path: string) => void, query: string) {
+  closeCommandPalette()
+  navigate('/history?search=' + encodeURIComponent(query))
+}
+
+export function SavedChatSearch({ query }: { query: string }) {
+  const navigate = useNavigate()
+  const t = useFocusCopy()
+  if (!query.trim()) return null
+
+  return (
+    <CommandGroup>
+      <CommandItem value="search-all-saved-chats" onSelect={() => openSearchInHistory(navigate, query.trim())}>
+        <Codicon name="search" />
+        <span>
+          {t('searchAllChats')} · {query.trim()}
+        </span>
+      </CommandItem>
+    </CommandGroup>
+  )
+}
+
+function MessageSnippet({ highlight, snippet }: { highlight: boolean; snippet: string }) {
+  // shortcut: literal paired markers can resemble matches, use structured ranges if the server exposes them.
+  const parts = highlight ? snippet.split(/>>>((?:(?!>>>|<<<).)+)<<</s) : null
+
+  return (
+    <span className="line-clamp-2 text-xs text-foreground/75">
+      {parts ? parts.map((part, index) =>
+        index % 2 ? (
+          <mark className="bg-transparent font-medium text-(--ui-accent)" key={index}>{part}</mark>
+        ) : (
+          stripFtsMarkers(part)
+        )
+      ) : snippet}
+    </span>
+  )
+}
+
+export function SavedChatMessageResults({
+  onFocusSplitAfterClose,
+  query
+}: {
+  onFocusSplitAfterClose?: (paneId: string) => void
+  query: string
+}) {
+  const navigate = useNavigate()
+  const t = useFocusCopy()
+  const connectionId = useStore($activeConnectionId)
+  const profile = normalizeProfileKey(useStore($activeGatewayProfile))
+  const search = query.trim()
+  const { serverMatches, searchPending, searchError, retrySearch, waitingForLocal } = useServerSessionSearch(search, profile)
+  const status = !search
+    ? t('messageSearchHint')
+    : waitingForLocal
+      ? t('sessionSearchWaitingForLocal')
+      : searchPending
+        ? t('messageSearchLoading')
+        : searchError
+          ? t('messageSearchFailed')
+          : serverMatches.length
+            ? serverMatches.length === 1
+              ? t('messageSearchSingle')
+              : t('messageSearchCount').replace('{count}', String(serverMatches.length))
+            : t('messageSearchEmpty')
+
+  return (
+    <>
+      <p aria-live="polite" aria-atomic="true" role="status" className="px-3 py-2 text-xs text-muted-foreground">
+        {status}
+      </p>
+      <CommandList className="dt-portal-scrollbar max-h-[min(20rem,56vh)]">
+        {searchError && (
+          <CommandGroup>
+            <CommandItem value="retry-saved-message-search" onSelect={retrySearch}>
+              <Codicon name="refresh" />
+              {t('retrySearch')}
+            </CommandItem>
+          </CommandGroup>
+        )}
+        {serverMatches.length > 0 && (
+          <CommandGroup>
+            {serverMatches.map(hit => {
+              const session = searchResultToSession(hit)
+              const matchLabel = hit.match_kind === 'id' ? t('searchMatchId')
+                : hit.match_kind === 'title' ? t('searchMatchTitle') : null
+              const snippet = hit.snippet?.trim()
+              const owner = sessionOwnerRouteFromRow({ connection_id: connectionId, profile: hit.profile || profile })
+
+              return (
+                <CommandItem
+                  className="items-start"
+                  key={session.id}
+                  value={`saved-message:${session.id}`}
+                  onSelect={() => {
+                    if (
+                      $activeConnectionId.get() !== connectionId ||
+                      $pendingConnectionId.get() ||
+                      normalizeProfileKey($activeGatewayProfile.get()) !== profile
+                    )
+                      return
+
+                    openSessionFromPicker(session.id, navigate, 'stack', owner)
+
+                    if (waitingForLocal && owner && onFocusSplitAfterClose) {
+                      const ownerProfile = normalizeProfileKey(owner.profile)
+                      const paneId = $focusedTreePaneId.get()
+                      const tile = $sessionTiles.get().find(tile => TILE_PANE_PREFIX + tile.storedSessionId === paneId)
+                      const route = tile ? runtimeSessionOwner(tile.runtimeId) ?? tile.ownerRoute : undefined
+
+                      if (
+                        paneId && tile && isSessionOwnerRoute(route) &&
+                        route.connectionId === owner.connectionId &&
+                        normalizeProfileKey(route.profile) === ownerProfile &&
+                        normalizeProfileKey(route.targetProfile ?? route.profile) === ownerProfile &&
+                        lineageAliases(session.id, $sessions.get()).includes(tile.storedSessionId)
+                      ) {
+                        onFocusSplitAfterClose(paneId)
+                      }
+                    }
+
+                    closeCommandPalette()
+                  }}
+                >
+                  <Codicon className="mt-0.5" name="comment" />
+                  <span className="min-w-0">
+                    <span className="block truncate font-medium">{sessionTitle(session)}</span>
+                    {matchLabel && <span className="block text-xs text-muted-foreground">{matchLabel}</span>}
+                    {snippet && (matchLabel || session.preview) && (
+                      <MessageSnippet highlight={!matchLabel} snippet={snippet} />
+                    )}
+                  </span>
+                </CommandItem>
+              )
+            })}
+          </CommandGroup>
+        )}
+      </CommandList>
+      {search && (
+        <div className="border-t border-border px-2 py-1">
+          <Button
+            onClick={() => openSearchInHistory(navigate, search)}
+            onKeyDown={event => {
+              if (event.key === 'Enter') event.stopPropagation()
+            }}
+            size="sm"
+            type="button"
+            variant="ghost"
+          >
+            {t('searchAllChats')}
+          </Button>
+        </div>
+      )}
+    </>
+  )
+}
+
+export function SavedChatList({
+  query,
+  onFocusSplitAfterClose,
+  onSearchMessages,
+  searchingMessages,
+  children
+}: {
+  query: string
+  onFocusSplitAfterClose?: (paneId: string) => void
+  onSearchMessages: () => void
+  searchingMessages: boolean
+  children: ReactNode
+}) {
+  const t = useFocusCopy()
+  if (searchingMessages) return <SavedChatMessageResults onFocusSplitAfterClose={onFocusSplitAfterClose} query={query} />
+
+  return (
+    <CommandList className="dt-portal-scrollbar max-h-[min(20rem,56vh)]">
+      {query.trim() && (
+        <CommandGroup>
+          <CommandItem value="search-in-saved-messages" onSelect={onSearchMessages}>
+            <Codicon name="search" />
+            {t('searchInMessages')}
+          </CommandItem>
+        </CommandGroup>
+      )}
+      <SavedChatSearch query={query} />
+      {children}
+    </CommandList>
+  )
+}
