+      { name: 'running', tasks: [{ id: 'working-example', title: 'Verify current build', status: 'running' }] },
+      {
+        name: 'done',
+        tasks: Array.from({ length: source.history }, (_, i) => ({
+          id: `done-${i}`,
+          title: `Completed example ${i}`,
+          status: 'done'
+        }))
+      }
+    ]
+  })),
+  fetchOrchestration: vi.fn(async () => ({ default_assignee: '' })),
+  fetchProfiles: vi.fn(async () => ({ profiles: [] })),
+  patchTask: source.writes,
+  bulkTasks: source.writes,
+  deleteTask: source.writes,
+  createTask: source.writes
+}))
+let dispose = () => {}
+let client: QueryClient
+beforeEach(() => {
+  source.history = 2000
+  client = new QueryClient({ defaultOptions: { queries: { retry: false } } })
+  dispose = registerPluginLocales('kanban', KANBAN_LOCALES)
+  $introDismissed.set(true)
+})
+afterEach(() => {
+  cleanup()
+  client.clear()
+  dispose()
+  $boardSlug.set('')
+  $introDismissed.set(false)
+  vi.clearAllMocks()
+})
+
+it('keeps completed history off the current-work canvas and reveals it in bounded batches', async () => {
+  render(
+    <QueryClientProvider client={client}>
+      <KanbanBoardPage />
+    </QueryClientProvider>
+  )
+  await screen.findByText('Review current guide')
+  expect(screen.queryAllByText(/^Completed example /)).toHaveLength(0)
+  fireEvent.click(screen.getByRole('button', { name: /History/ }))
+  await waitFor(() => expect(screen.getAllByText(/^Completed example /)).toHaveLength(50))
+  expect(screen.queryByText('Review current guide')).toBeNull()
+  fireEvent.click(screen.getByRole('button', { name: /Show more/ }))
+  expect(screen.getAllByText(/^Completed example /)).toHaveLength(100)
+  fireEvent.change(screen.getByRole('textbox', { name: 'Filter cards…' }), {
+    target: { value: 'Completed example 1999' }
+  })
+  await waitFor(() => expect(screen.getAllByText(/^Completed example /)).toHaveLength(1))
+  expect(source.writes).not.toHaveBeenCalled()
+})
+
+it('explains an empty history separately and returns to current work', async () => {
+  source.history = 0
+  render(
+    <QueryClientProvider client={client}>
+      <KanbanBoardPage />
+    </QueryClientProvider>
+  )
+  await screen.findByText('Review current guide')
+  fireEvent.click(screen.getByRole('button', { name: /History/ }))
+  expect(await screen.findByText('No completed tasks yet')).toBeTruthy()
+  expect(screen.queryByText('No tasks on this board')).toBeNull()
+  fireEvent.click(screen.getByRole('button', { name: 'Back to current work' }))
+  expect(await screen.findByText('Review current guide')).toBeTruthy()
+  expect(source.writes).not.toHaveBeenCalled()
+})
