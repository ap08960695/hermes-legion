+            assert error.value is sentinel
+            assert conn.in_transaction and conn.total_changes == before
+            assert list(db._token_queue) == [('s', {'input_tokens': 17, 'api_call_count': 1})]
+        finally:
+            conn.set_authorizer(None)
+            conn.execute('ROLLBACK TO scope_identity')
+            conn.execute('RELEASE scope_identity')
+        assert db._conn.execute("SELECT source,input_tokens FROM sessions WHERE id='s'").fetchone()[:] == ('cli', 0)
+        db._token_queue.clear()
+
+
+def test_declared_identity_preserves_direct_flush_and_fail_closed_errors(tmp_path, monkeypatch):
+    from agent.prompt_cache_scope import declared_conversation_scope
+
+    with SessionDB(tmp_path / 'flush.db') as db:
+        db.create_session('s', 'cli')
+        real_flush = db.flush_token_counts
+        calls = []
+        def flush():
+            calls.append('flush')
+            return real_flush()
+        monkeypatch.setattr(db, 'flush_token_counts', flush)
+        real_read = db._read_one
+        reads = []
+        def read(sql, params=()):
+            totals = db._conn.execute("SELECT input_tokens,api_call_count FROM sessions WHERE id='s'").fetchone()
+            assert tuple(totals) == (17 * len(calls), len(calls))
+            reads.append(params[0])
+            return real_read(sql, params)
+        monkeypatch.setattr(db, '_read_one', read)
+        for target in ('s', 'missing'):
+            db._token_queue.append(('s', {'input_tokens': 17, 'api_call_count': 1}))
+            assert db.declared_scope_identity(target) == (False, 'cli' if target == 's' else '')
+            assert not db._token_queue
+        assert calls == ['flush', 'flush'] and reads == ['s', 'missing']
+        assert db._conn.execute("SELECT input_tokens,api_call_count FROM sessions WHERE id='s'").fetchone()[:] == (34, 2)
+        sentinel = OSError('Synthetic scope read refused')
+        def refused(*args, **kwargs):
+            raise sentinel
+        monkeypatch.setattr(db, '_read_one', refused)
+        with pytest.raises(OSError) as error:
+            db.declared_scope_identity('s')
+        assert error.value is sentinel and calls == ['flush'] * 3
+        assert declared_conversation_scope(SimpleNamespace(session_id='s', _session_db=db,
+                                                           _gateway_session_key='synthetic-chat')) is None
+        monkeypatch.setattr(db, 'flush_token_counts', refused)
+        with pytest.raises(OSError) as error:
+            db.declared_scope_identity('missing')
+        assert error.value is sentinel
+        monkeypatch.setattr(db, '_read_one', lambda *args: pytest.fail('read ran after failed flush'))
+        assert declared_conversation_scope(SimpleNamespace(session_id='s', _session_db=db,
+                                                           _gateway_session_key='synthetic-chat')) is None
+        monkeypatch.setattr(db, 'flush_token_counts', real_flush)
