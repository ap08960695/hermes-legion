diff --git a/apps/desktop/electron/pet-overlay-linux-fixture/absolute-pointer.py b/apps/desktop/electron/pet-overlay-linux-fixture/absolute-pointer.py
new file mode 100644
index 0000000000000000000000000000000000000000..4f1c2fa4c11c3477b321d4ddf67c5fbf9d381f42
--- /dev/null
+++ b/apps/desktop/electron/pet-overlay-linux-fixture/absolute-pointer.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Virtual absolute pointer (uinput) for compositor-level click tests.
+
+Reads commands from stdin, one per line:
+  move X Y      (screen pixels, mapped over [0,W)x[0,H))
+  down | up | click
+  sleep MS
+Env: ABS_W, ABS_H (default 1920x1080).
+"""
+import fcntl, os, struct, sys, time
+
+UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT, UI_SET_PROPBIT = 0x40045564, 0x40045565, 0x40045567, 0x4004556e
+UI_DEV_CREATE, UI_DEV_DESTROY = 0x5501, 0x5502
+EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
+ABS_X, ABS_Y, BTN_LEFT, INPUT_PROP_POINTER = 0, 1, 0x110, 0
+W, H = int(os.environ.get("ABS_W", 1920)), int(os.environ.get("ABS_H", 1080))
+
+fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
+for req, val in ((UI_SET_EVBIT, EV_KEY), (UI_SET_EVBIT, EV_ABS), (UI_SET_EVBIT, EV_SYN),
+                 (UI_SET_KEYBIT, BTN_LEFT), (UI_SET_ABSBIT, ABS_X), (UI_SET_ABSBIT, ABS_Y),
+                 (UI_SET_PROPBIT, INPUT_PROP_POINTER)):
+    fcntl.ioctl(fd, req, val)
+absmax, absmin = [0] * 64, [0] * 64
+absmax[ABS_X], absmax[ABS_Y] = W - 1, H - 1
+dev = struct.pack("80sHHHHi" + "i" * 256, b"lane-abs-pointer", 0x03, 0x1234, 0x5678, 1, 0,
+                  *(absmax + absmin + [0] * 64 + [0] * 64))
+os.write(fd, dev)
+fcntl.ioctl(fd, UI_DEV_CREATE)
+time.sleep(1.0)
+
+
+def emit(etype, code, value):
+    now = time.time()
+    os.write(fd, struct.pack("llHHi", int(now), int(now % 1 * 1e6), etype, code, value))
+
+
+def syn():
+    emit(EV_SYN, 0, 0)
+
+
+try:
+    for line in sys.stdin:
+        cmd = line.split()
+        if not cmd:
+            continue
+        if cmd[0] == "move":
+            emit(EV_ABS, ABS_X, int(cmd[1])); emit(EV_ABS, ABS_Y, int(cmd[2])); syn()
+        elif cmd[0] in ("down", "up", "click"):
+            if cmd[0] in ("down", "click"):
+                emit(EV_KEY, BTN_LEFT, 1); syn()
+            if cmd[0] == "click":
+                time.sleep(0.05)
+            if cmd[0] in ("up", "click"):
+                emit(EV_KEY, BTN_LEFT, 0); syn()
+        elif cmd[0] == "sleep":
+            time.sleep(int(cmd[1]) / 1000)
+        print("ok", *cmd, flush=True)
+finally:
+    fcntl.ioctl(fd, UI_DEV_DESTROY)
+    os.close(fd)
