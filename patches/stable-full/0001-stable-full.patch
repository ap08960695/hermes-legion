+        monkeypatch.setattr(tool, '_request_approval', lambda *a: None)
+        result = json.loads(tool.handle_computer_use({'action': 'click', 'element': idx, 'app': 'Different app'}, session_id='denied'))
+        assert result['code'] == 'input_target_mismatch'
+        assert all(c[0][1] == 'snapshot' for c in calls)
+    finally:
+        tool.reset_backend_for_tests()
+
+
+def test_native_value_readback_does_not_claim_application_commit(controls):
+    _, backend, _, state, cap = controls
+    result = completed('set-value')
+    value = json.loads(result.stdout)
+    value['data']['disposition']['delivery'] = 'delivered_verified'
+    value['data']['details'] = {'application_commit': 'not_verified'}
+    result.stdout = json.dumps(value)
+    state['action'] = result
+    out = backend.set_value('private value', element=cap.elements[2].index)
+    assert out.ok and out.verified is None and out.meta['recapture_required'] is True
+
+
+def test_action_indices_cannot_cross_backend_sessions(controls):
+    module, backend, calls, _, old = controls
