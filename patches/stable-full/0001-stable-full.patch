+"""``/api/status`` carries the global pause (ESTOP) so the Desktop can show it."""
+import pytest
+
+from agent import estop
+
+
+@pytest.fixture
+def client():
+    try:
+        from starlette.testclient import TestClient
+    except ImportError:
+        pytest.skip("fastapi/starlette not installed")
+    from hermes_cli.web_server import app, _SESSION_HEADER_NAME, _SESSION_TOKEN
+
+    c = TestClient(app)
+    c.headers[_SESSION_HEADER_NAME] = _SESSION_TOKEN
+    return c
+
+
+def test_status_estop_null_when_running_and_detailed_when_paused(client, monkeypatch):
+    monkeypatch.setattr(estop, "get_state", lambda: None)
+    assert client.get("/api/status").json()["estop"] is None
+
+    monkeypatch.setattr(estop, "get_state",
+                        lambda: {"reason": "maintenance", "engaged_at": "2026-11-01T10:00:00+00:00"})
+    data = client.get("/api/status").json()
+    assert data["estop"]["engaged_at"] == "2026-11-01T10:00:00+00:00"
+    if not data["auth_required"]:
+        assert data["estop"]["reason"] == "maintenance"
+    else:
+        assert "reason" not in data["estop"]
