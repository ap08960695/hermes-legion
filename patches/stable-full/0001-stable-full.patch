+    screen.getByLabelText('Recorded bot runs').textContent!.indexOf('#2')
+  )
+  expect(screen.getByText('Currently assigned: reviewer')).toBeTruthy()
+})
+it('never turns an assignee into a recorded execution', () => {
+  render(<BotJourney assignee="planner" runs={[]} />)
+  expect(screen.getByText('No recorded bot runs')).toBeTruthy()
+  expect(screen.queryByRole('list')).toBeNull()
+  expect(screen.getByText('Currently assigned: planner')).toBeTruthy()
+})
+it('keeps unknown profiles explicit and bounds a long run history', () => {
+  render(
