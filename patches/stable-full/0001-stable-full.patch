+    home = get_hermes_home()
+    (home / '.env').write_text('NVIDIA_API_KEY=fixture-profile-key\n')
+    (home / 'config.yaml').write_text('''model:
+  default: ambient-model
+  provider: nvidia
+fallback_providers:
+  - provider: openrouter
+    model: paid-model-that-must-not-be-used
+reasoning_effort: low
+agent:
+  max_turns: 7
+  disabled_toolsets: [terminal]
+''')
+    seen = []
+    monkeypatch.setattr(run_agent, 'AIAgent', lambda **kwargs: seen.append(kwargs) or SimpleNamespace())
+    marker = object()
+    row = {'model': 'saved-model', 'source': 'desktop', 'model_config': json.dumps({
+        'provider': 'nvidia', 'reasoning_config': {'effort': 'high'}, 'service_tier': 'priority'})}
+    with server._session_profile_runtime_scope({'profile_home': str(home)}):
+        build_agent(session_id='stored-session', row=row, cwd=str(tmp_path), session_db=marker)
+    assert len(seen) == 1
+    kw = seen[0]
+    assert kw['model'] == 'saved-model' and kw['provider'] == 'nvidia'
