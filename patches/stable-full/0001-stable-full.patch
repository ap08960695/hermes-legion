+"""Gateway memory uses native parsing/dispatch and one selected-home observation."""
+import argparse
+import contextlib
+import io
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from hermes_cli.gateway import gateway_command
+from hermes_cli.subcommands.gateway import build_gateway_parser
+from hermes_constants import reset_hermes_home_override, set_hermes_home_override
+
+
+class GatewayMemoryCommandTests(unittest.TestCase):
+    def setUp(self):
+        self.parser = argparse.ArgumentParser()
+        build_gateway_parser(self.parser.add_subparsers(), cmd_gateway=gateway_command,
+                             cmd_proxy=lambda args: None, cmd_gateway_enroll=lambda args: None)
+
+    def invoke(self, payload):
+        args = self.parser.parse_args(['gateway', 'memory'])
+        output, error = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(output), contextlib.redirect_stderr(error), patch(
+            'gateway.control_socket.query_gateway_control', return_value=payload
+        ) as query:
+            try:
+                args.func(args)
+            except SystemExit as exc:
+                code = exc.code
+            else:
+                code = 0
+        return code, output.getvalue(), error.getvalue(), query
+
+    def test_native_parser_dispatches_one_selected_home_query(self):
+        with tempfile.TemporaryDirectory() as directory:
+            home = Path(directory) / 'selected-profile'
+            token = set_hermes_home_override(home)
+            try:
+                payload = {'pid': 123, 'process': {'rss_kib': 456}, 'caches': {'agents': 2}}
+                code, output, error, query = self.invoke(payload)
+            finally:
+                reset_hermes_home_override(token)
+        self.assertEqual(code, 0)
+        self.assertEqual(json.loads(output), payload)
+        self.assertTrue(output.endswith('\n'))
+        self.assertEqual(error, '')
+        query.assert_called_once_with(home, 'memory-stats', timeout=5)
+
+    def test_unknown_and_zero_rss_are_successful_observations(self):
+        for rss in (None, 0):
+            with self.subTest(rss=rss):
+                payload = {'pid': 123, 'process': {'rss_kib': rss}}
+                code, output, error, query = self.invoke(payload)
+                self.assertEqual((code, json.loads(output), error), (0, payload, ''))
+                self.assertEqual(query.call_count, 1)
+
+    def test_unavailable_and_malformed_observations_fail_without_output(self):
+        invalid = [None, [], {}, {'pid': True, 'process': {'rss_kib': 1}},
+                   {'pid': 0, 'process': {'rss_kib': 1}}, {'pid': 1, 'process': []},
+                   {'pid': 1, 'process': {}}, {'pid': 1, 'process': {'rss_kib': True}},
+                   {'pid': 1, 'process': {'rss_kib': -1}}, {'pid': 1, 'process': {'rss_kib': 1.5}}]
+        for payload in invalid:
+            with self.subTest(payload=payload):
+                code, output, error, query = self.invoke(payload)
+                self.assertEqual((code, output), (1, ''))
+                self.assertIn('unavailable', error)
+                self.assertEqual(query.call_count, 1)
+
+    def test_extra_arguments_are_parser_errors(self):
+        with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit) as error:
+            self.parser.parse_args(['gateway', 'memory', '--start'])
+        self.assertEqual(error.exception.code, 2)
+
+
+if __name__ == '__main__':
+    unittest.main()
