index 0000000000000000000000000000000000000000..cefcc7acbc27953a2ed66d6640db3d0b4cb0e369
--- /dev/null
+++ b/hermes_cli/goals_judge_memo.py
@@ -0,0 +1,40 @@
+"""Goal-judge verdict memo.
+
+Identical judge inputs (same goal, contract, response and background, ignoring the clock) get
+the same verdict, so a repeated response costs no second auxiliary call. ``wait`` depends on
+elapsed time, and unusable or failed calls are never stored.
+"""
+from __future__ import annotations
+
+import hashlib
+import threading
+from typing import Optional
+
+_MEMO: dict[str, tuple[str, str]] = {}
+_MAX = 256
+_LOCK = threading.Lock()
+
+
+def key(system_prompt: str, prompt: str) -> str:
+    """Hash the caller's canonical prompt without rewriting evidence."""
+    body = system_prompt + "\0" + prompt
+    return hashlib.sha256(body.encode("utf-8", "surrogatepass")).hexdigest()
+
+
+def lookup(memo_key: str) -> Optional[tuple[str, str]]:
+    with _LOCK:
+        return _MEMO.get(memo_key)
+
+
+def store(memo_key: str, verdict: str, reason: str, parse_failed: bool) -> None:
+    if parse_failed or verdict not in ("done", "blocked", "continue"):
+        return
+    with _LOCK:
+        _MEMO[memo_key] = (verdict, reason)
+        while len(_MEMO) > _MAX:
+            _MEMO.pop(next(iter(_MEMO)))
+
+
+def clear() -> None:
+    with _LOCK:
+        _MEMO.clear()
