--- /dev/null
+++ b/apps/desktop/src/lib/chart-spec.ts
@@ -0,0 +1,45 @@
+/** A model-authored ```chart fence: explicit, bounded data only. */
+export interface ChartSpec {
+  type: 'bar' | 'line' | 'pie'
+  title?: string
+  labels: string[]
+  series: { name: string; values: number[] }[]
+  unit?: string
+}
+
+const MAX_SERIES = 12
+const MAX_POINTS = 200
+
+const text = (value: unknown, max = 120) =>
+  typeof value === 'string' ? value.trim().slice(0, max) || undefined : undefined
+
+/** Parse and validate; null means "show the code block instead". */
+export function parseChartSpec(code: string): ChartSpec | null {
+  if (code.length > 64000) return null
+  let raw: unknown
+  try {
+    raw = JSON.parse(code)
+  } catch {
+    return null
+  }
+  if (!raw || typeof raw !== 'object') return null
+  const value = raw as Record<string, unknown>
+  const type = value.type
+  if (type !== 'bar' && type !== 'line' && type !== 'pie') return null
+  if (!Array.isArray(value.labels) || !Array.isArray(value.series)) return null
+  const labels = value.labels.map(label => (typeof label === 'number' ? String(label) : text(label)))
+  if (!labels.length || labels.length > MAX_POINTS || labels.some(label => label === undefined)) return null
+  if (!value.series.length || value.series.length > MAX_SERIES) return null
+  const series: ChartSpec['series'] = []
+  for (const [index, entry] of value.series.entries()) {
+    if (!entry || typeof entry !== 'object') return null
+    const { name, values } = entry as Record<string, unknown>
+    if (!Array.isArray(values) || values.length !== labels.length) return null
+    if (!values.every(v => typeof v === 'number' && Number.isFinite(v))) return null
+    series.push({ name: text(name) ?? `Series ${index + 1}`, values: values as number[] })
+  }
+  // A pie is one series of non-negative shares with something to divide.
+  if (type === 'pie' && (series.length !== 1 || series[0].values.some(v => v < 0) || !series[0].values.some(v => v > 0)))
+    return null
+  return { type, title: text(value.title, 200), labels: labels as string[], series, unit: text(value.unit, 16) }
+}
