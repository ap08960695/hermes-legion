index 0000000000000000000000000000000000000000..83da2451f444dd6f95a0fd358c63bbbcab1a7209
--- /dev/null
+++ b/apps/desktop/src/app/focus/native-navigation.test.tsx
@@ -0,0 +1,370 @@
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query'
+import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { Profiler } from 'react'
+import { MemoryRouter, useLocation } from 'react-router'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+const io = vi.hoisted(() => ({
+  resume: vi.fn(),
+  restore: vi.fn(),
+  skills: vi.fn(async () => []),
+  controlRead: vi.fn(),
+  list: vi.fn(async () => ({ sessions: [{ id: 'kept-session', title: 'Pinned example', profile: 'default' }] })),
+  rpc: vi.fn()
+}))
+vi.mock('@/components/pane-shell/tree/store', async original => ({
+  ...(await original<object>()),
+  restoreTreePane: io.restore
+}))
+vi.mock('../open-session', () => ({ openSessionFromPicker: io.resume }))
+vi.mock('@/components/session-history-data', async original => ({
+  ...(await original<object>()),
+  readHistory: io.list
+}))
+vi.mock('@/hermes', async original => ({
+  ...(await original<object>()),
+  getSkills: io.skills,
+  listAllProfileSessions: io.list
+}))
+vi.mock('@/store/gateway', async original => ({
+  ...(await original<object>()),
+  requestGatewayForProfile: (_profile: string, method: string, params: unknown) => io.rpc(method, params)
+}))
+
+import { registry } from '@/contrib/registry'
+import { $gateway } from '@/store/gateway'
+import { $activeSessionId, $selectedStoredSessionId, $sessions } from '@/store/session'
+import { $sessionStates } from '@/store/session-states'
+import { $sessionControlBySession, clearAllSessionControl } from '@/store/session-control'
+import { FocusDesktop } from './index'
+
+function RouteProbe() { return <span data-testid="current-route">{useLocation().pathname}</span> }
+const snapshot = { goal: null, heartbeat: null, loop: null, revision: '', updated_at: 0 }
+const wrap = (children: React.ReactNode) => (
+  <QueryClientProvider client={new QueryClient({ defaultOptions: { queries: { retry: false } } })}>
+    <MemoryRouter initialEntries={['/saved-existing']}>{children}</MemoryRouter>
+  </QueryClientProvider>
+)
+
+afterEach(() => {
+  cleanup()
+  $gateway.set(null as never)
+  $activeSessionId.set(null)
+  $selectedStoredSessionId.set(null)
+  $sessions.set([])
+  clearAllSessionControl()
+  vi.clearAllMocks()
+  localStorage.clear()
+})
+
+describe('native Focus integration', () => {
+  it('mounts without reads or inference and opens the existing chat through its native door', () => {
+    $selectedStoredSessionId.set('saved-existing')
+    render(
+      wrap(
+        <FocusDesktop>
+          <input aria-label="Existing native composer" defaultValue="My unsent draft" />
+        </FocusDesktop>
+      )
+    )
+    expect(io.skills).not.toHaveBeenCalled()
+    expect(io.controlRead).not.toHaveBeenCalled()
+    fireEvent.click(screen.getByRole('button', { name: 'Chat' }))
+    expect(io.resume).toHaveBeenCalledExactlyOnceWith('saved-existing', expect.any(Function))
+    expect((screen.getByLabelText('Existing native composer') as HTMLInputElement).value).toBe('My unsent draft')
+  })
+  it('uses a late registered native Bots pane and keeps all feature navigation available', () => {
+    render(
+      wrap(
+        <FocusDesktop>
+          <div>Native layout tree</div>
+        </FocusDesktop>
+      )
+    )
+    let dispose = () => {}
+    act(() => {
+      dispose = registry.registerMany([{ id: 'hermes-bots:pane', area: 'panes', render: () => null }])
+    })
+    fireEvent.click(screen.getByRole('button', { name: 'Bots' }))
+    expect(io.restore).toHaveBeenCalledWith('hermes-bots:pane')
+    fireEvent.click(screen.getByRole('button', { name: 'All features' }))
+    expect(screen.getByRole('button', { name: 'Skills' })).not.toBeNull()
+    act(() => dispose())
+  })
+  it('reads goal state only after the user opens the form and never submits a prompt', async () => {
+    $selectedStoredSessionId.set('saved-existing')
+    $activeSessionId.set('runtime-existing')
+    $sessions.set([{ id: 'saved-existing', profile: 'default', title: 'Original chat' }] as never)
+    const request = vi.fn(async (method: string) => {
+      io.controlRead(method)
+      return { control: snapshot }
+    })
+    io.rpc.mockImplementation(request)
+    $gateway.set({ request } as never)
+    render(
+      wrap(
+        <FocusDesktop>
+          <div>Native layout tree</div>
+        </FocusDesktop>
+      )
+    )
+    expect(request).not.toHaveBeenCalled()
+    fireEvent.click(screen.getByRole('button', { name: 'All features' }))
+    fireEvent.click(screen.getByRole('button', { name: 'Goal' }))
+    await screen.findByLabelText('Objective')
+    expect(request.mock.calls.map(call => call[0])).toEqual(['session.control.read'])
+    expect(screen.getByText('Original chat').getAttribute('title')).toBe('runtime-existing')
+    expect(io.resume).not.toHaveBeenCalled()
+    expect(io.skills).toHaveBeenCalledWith('default')
+  })
+  it('does not repaint the shell for unrelated streaming-token updates while catch-up is closed', () => {
+    const committed = vi.fn()
+    render(
+      wrap(
+        <Profiler id="focus-shell" onRender={committed}>
+          <FocusDesktop>
+            <div>Native layout tree</div>
+          </FocusDesktop>
+        </Profiler>
+      )
+    )
+    const before = committed.mock.calls.length
+    act(() => {
+      for (let token = 0; token < 100; token++)
+        $sessionStates.set({
+          'background-runtime': {
+            messages: [],
+            busy: true,
+            turnLive: true,
+            needsInput: false,
+            storedSessionId: 'background-chat',
+            token
+          }
+        } as never)
+    })
+    expect(committed.mock.calls.length).toBe(before)
+    expect(io.controlRead).not.toHaveBeenCalled()
+    expect(io.skills).not.toHaveBeenCalled()
+    cleanup()
+    $sessionStates.set({})
+  })
+  it('keeps a dismissed goal draft in its own chat and starts a fresh draft for another cached chat', async () => {
+    $sessions.set([
+      { id: 'saved-first', profile: 'default', title: 'First chat' },
+      { id: 'saved-second', profile: 'default', title: 'Second chat' }
+    ] as never)
+    $selectedStoredSessionId.set('saved-first')
+    $activeSessionId.set('runtime-first')
+    const entry = { capability: 'supported', error: null, loading: false, pendingAction: null, snapshot } as const
+    $sessionControlBySession.set({ 'runtime-first': entry, 'runtime-second': entry })
+    io.rpc.mockResolvedValue({ control: snapshot })
+    $gateway.set({ request: io.rpc } as never)
+    render(
+      wrap(
+        <FocusDesktop>
+          <div>Native layout tree</div>
+        </FocusDesktop>
+      )
+    )
+    const openGoal = () => {
+      fireEvent.click(screen.getByRole('button', { name: 'All features' }))
+      fireEvent.click(screen.getByRole('button', { name: 'Goal' }))
+    }
+    openGoal()
+    const title = await screen.findByLabelText('Objective')
+    fireEvent.change(title, { target: { value: 'Private first-chat draft' } })
+    fireEvent.keyDown(title, { key: 'Escape' })
+    openGoal()
+    expect(((await screen.findByLabelText('Objective')) as HTMLInputElement).value).toBe('Private first-chat draft')
+    fireEvent.keyDown(screen.getByLabelText('Objective'), { key: 'Escape' })
+    act(() => {
+      $selectedStoredSessionId.set('saved-second')
+      $activeSessionId.set('runtime-second')
+    })
+    openGoal()
+    expect(((await screen.findByLabelText('Objective')) as HTMLInputElement).value).toBe('')
+    expect(screen.getByText('Second chat').getAttribute('title')).toBe('runtime-second')
+  })
+})
+
+it('opens Work without leaving the legacy sessions pane beside the page or losing a draft', async () => {
+  const { $sidebarOpen, setSidebarOpen } = await import('@/store/layout')
+  const dispose = registry.register({
+    area: 'routes',
+    id: 'example:board',
+    data: { path: '/kanban' },
+    render: () => null
+  })
+  try {
+    render(
+      wrap(
+        <FocusDesktop>
+          <input aria-label="Preserved draft" defaultValue="Do not send this" />
+        </FocusDesktop>
+      )
+    )
+    act(() => setSidebarOpen(true))
+    expect($sidebarOpen.get()).toBe(false)
+    fireEvent.click(screen.getByRole('button', { name: 'Work' }))
+    expect($sidebarOpen.get()).toBe(false)
+    expect((screen.getByLabelText('Preserved draft') as HTMLInputElement).value).toBe('Do not send this')
+    expect(io.rpc).not.toHaveBeenCalled()
+    expect(io.resume).not.toHaveBeenCalled()
+  } finally {
+    dispose()
+  }
+})
+
+it('marks the visible native Bots pane as active and follows a tab switch back to Sessions', async () => {
+  const { $layoutTree, $activeTreeGroup, noteActiveTreeGroup } = await import('@/components/pane-shell/tree/store')
+  const prior = $layoutTree.get(),
+    priorFocus = $activeTreeGroup.get()
+  render(
+    wrap(
+      <FocusDesktop>
+        <div>Native workspace</div>
+      </FocusDesktop>
+    )
+  )
+  try {
+    act(() =>
+      $layoutTree.set({
+        type: 'group',
+        id: 'example-side',
+        panes: ['sessions', 'hermes-bots:pane'],
+        active: 'hermes-bots:pane'
+      })
+    )
+    act(() => noteActiveTreeGroup('example-side'))
+    expect(screen.getByRole('button', { name: 'Bots' }).getAttribute('aria-current')).toBe('page')
+    act(() =>
+      $layoutTree.set({
+        type: 'group',
+        id: 'example-side',
+        panes: ['sessions', 'hermes-bots:pane'],
+        active: 'sessions'
+      })
+    )
+    expect(screen.getByRole('button', { name: 'Bots' }).getAttribute('aria-current')).toBeNull()
+  } finally {
+    act(() => {
+      $layoutTree.set(prior)
+      noteActiveTreeGroup(priorFocus)
+    })
+  }
+})
+
+it('releases the Bots highlight on Work, Hub and Chat while the legacy roster remains mounted', async () => {
+  const { $layoutTree, $activeTreeGroup, noteActiveTreeGroup } = await import('@/components/pane-shell/tree/store')
+  const nativeTree = await vi.importActual<typeof import('@/components/pane-shell/tree/store')>(
+    '@/components/pane-shell/tree/store'
+  )
+  io.restore.mockImplementation(nativeTree.restoreTreePane)
+  const tree = $layoutTree.get(),
+    focus = $activeTreeGroup.get()
+  const dispose = registry.registerMany([
+    { area: 'routes', id: 'test:board', data: { path: '/kanban' }, render: () => null },
+    { area: 'routes', id: 'test:bots', data: { path: '/bots' }, render: () => null },
+    { area: 'routes', id: 'test:hub', data: { path: '/hub' }, render: () => null },
+    { area: 'panes', id: 'hermes-bots:pane', render: () => null }
+  ])
+  render(
+    wrap(
+      <FocusDesktop>
+        <input aria-label="Keep draft" defaultValue="Do not submit" />
+      </FocusDesktop>
+    )
+  )
+  try {
+    act(() => {
+      $layoutTree.set({
+        type: 'split',
+        id: 'test-layout',
+        orientation: 'row',
+        weights: [1, 3],
+        children: [
+          { type: 'group', id: 'side-test', panes: ['sessions', 'hermes-bots:pane'], active: 'hermes-bots:pane' },
+          { type: 'group', id: 'main-test', panes: ['workspace'], active: 'workspace' }
+        ]
+      })
+      noteActiveTreeGroup('side-test')
+    })
+    for (const name of ['Work', 'Hub', 'Chat']) {
+      fireEvent.click(screen.getByRole('button', { name: 'Bots' }))
+      expect(screen.getByRole('button', { name: 'Bots' }).getAttribute('aria-current')).toBe('page')
+      fireEvent.click(screen.getByRole('button', { name }))
+      expect(screen.getByRole('button', { name: 'Bots' }).getAttribute('aria-current')).toBeNull()
+      expect(screen.getByRole('button', { name }).getAttribute('aria-current')).toBe('page')
+    }
+    expect((screen.getByLabelText('Keep draft') as HTMLInputElement).value).toBe('Do not submit')
+    expect(io.rpc).not.toHaveBeenCalled()
+  } finally {
+    act(() => {
+      $layoutTree.set(tree)
+      noteActiveTreeGroup(focus)
+    })
+    io.restore.mockReset()
+    dispose()
+  }
+})
+
+it('keeps the legacy rail hidden while native History opens as a real page', async () => {
+  const { $interfaceMode, setInterfaceMode } = await import('@/store/interface-mode')
+  const { $sidebarOpen, setSidebarOpen } = await import('@/store/layout')
+  const previous = $interfaceMode.get()
+  act(() => setInterfaceMode('simple'))
+  try {
+    render(
+      wrap(
+        <FocusDesktop>
+          <RouteProbe />
+          <input aria-label="Kept composer" defaultValue="Unsent draft" />
+        </FocusDesktop>
+      )
+    )
+    act(() => setSidebarOpen(true))
+    expect($sidebarOpen.get()).toBe(false)
+    fireEvent.click(screen.getByRole('button', { name: 'All features' }))
+    fireEvent.click(screen.getByRole('button', { name: /^Sessions$/ }))
+    expect(screen.getByTestId('current-route').textContent).toBe('/history')
+    expect((screen.getByLabelText('Kept composer') as HTMLInputElement).value).toBe('Unsent draft')
+    expect(io.resume).not.toHaveBeenCalled()
+    expect(io.rpc).not.toHaveBeenCalled()
+  } finally {
+    act(() => setInterfaceMode(previous))
+  }
+})
+
+it('keeps the legacy sidebar closed in both main presentations without losing the draft', async () => {
+  const { setInterfaceMode } = await import('@/store/interface-mode')
+  const layout = await import('@/store/layout')
+  act(() => setInterfaceMode('simple'))
+  render(
+    wrap(
+      <FocusDesktop>
+        <input aria-label="Mode draft" defaultValue="Keep" />
+      </FocusDesktop>
+    )
+  )
+  act(() => {
+    setInterfaceMode('advanced')
+    layout.setSidebarOpen(true)
+  })
+  expect(layout.$sidebarOpen.get()).toBe(false)
+  expect((screen.getByLabelText('Mode draft') as HTMLInputElement).value).toBe('Keep')
+})
+
+it('provides a direct Chat history door without submitting the current draft', async () => {
+  render(
+    wrap(
+      <FocusDesktop>
+        <RouteProbe />
+        <input aria-label="History draft" defaultValue="Keep unsent" />
+      </FocusDesktop>
+    )
+  )
+  fireEvent.click(screen.getByRole('button', { name: 'Chat history' }))
+  expect(screen.getByTestId('current-route').textContent).toBe('/history')
+  expect((screen.getByLabelText('History draft') as HTMLInputElement).value).toBe('Keep unsent')
+  expect(io.rpc).not.toHaveBeenCalled()
+})
