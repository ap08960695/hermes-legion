@@ -0,0 +1,52 @@
+"""A missing installation bootstrap never falls through to another editable checkout."""
+import os
+import subprocess
+import sys
+
+import pytest
+
+from hermes_cli import _launchers
+from pm.environments import site_packages
+
+
+@pytest.mark.platforms('posix')
+@pytest.mark.parametrize('kind', ['runtime-command', 'minted-launcher'])
+@pytest.mark.parametrize('healthy', [False, True])
+def test_launch_stays_bound_to_its_selected_checkout(tmp_path, kind, healthy):
+    selected = tmp_path / 'selected'
+    selected.mkdir()
+    foreign = tmp_path / 'foreign'
+    foreign.mkdir()
+    foreign_ran = tmp_path / 'foreign-ran'
+    (foreign / 'hermes_bootstrap.py').write_text(
+        f'from pathlib import Path\nPath({str(foreign_ran)!r}).touch()\n')
+    (selected / 'hermes_constants.py').write_text(
+        f'from pathlib import Path\ndef get_default_hermes_root(): return Path({str(tmp_path / "home")!r})\n')
+    package = selected / 'hermes_cli'
+    package.mkdir()
+    (package / '__init__.py').write_text('')
+    (package / 'main.py').write_text('def main():\n    print("SELECTED_ENTRY")\n')
+    if healthy:
+        (selected / 'hermes_bootstrap.py').write_text('# selected bootstrap\n')
+    venv = tmp_path / 'runtime'
+    subprocess.run([sys._base_executable, '-m', 'venv', '--without-pip', str(venv)],
+                   check=True, capture_output=True)
+    (site_packages(venv) / 'foreign-checkout.pth').write_text(str(foreign) + '\n')
+    python = venv / 'bin/python'
+    if kind == 'runtime-command':
+        command = _launchers.runtime_command(selected, code='print("SELECTED_ENTRY")', python=python)
+    else:
+        binary = tmp_path / 'bin'
+        binary.mkdir()
+        launcher = _launchers._mint_shell_launcher(
+            'hermes', binary, python, _launchers._launcher_script('hermes', selected, None))
+        assert launcher is not None
+        command = [str(launcher)]
+    env = {'HOME': str(tmp_path / 'home'), 'PATH': os.environ.get('PATH', ''), 'LANG': 'C.UTF-8'}
+    result = subprocess.run(command, check=False, cwd=tmp_path, env=env, capture_output=True, text=True, timeout=30)
+    assert not foreign_ran.exists(), result.stderr
+    if healthy:
+        assert result.returncode == 0 and 'SELECTED_ENTRY' in result.stdout, result.stderr
+    else:
+        assert result.returncode != 0 and 'bootstrap is missing from the selected checkout' in result.stderr
+        assert 'SELECTED_ENTRY' not in result.stdout
diff --git a/tests/hermes_cli/test_linux_desktop_bootstrap_alias.py b/tests/hermes_cli/test_linux_desktop_bootstrap_alias.py
