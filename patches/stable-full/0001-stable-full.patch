+        for text in chunks:
+            if self.deadline is not None and time.monotonic() >= self.deadline:
+                raise TimeoutError('structured global search timed out')
+            for char in text:
+                code = ord(char)
+                binary |= code == 0 or 0xD800 <= code <= 0xDFFF
+                is_token, folded = self.oracle.classify(char)
+                if cjk_split and any(_cjk_token_boundary(ord(c)) for c in folded):
