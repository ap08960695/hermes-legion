diff --git a/apps/desktop/electron/mermaid-renderer.ts b/apps/desktop/electron/mermaid-renderer.ts
new file mode 100644
index 0000000000000000000000000000000000000000..39daa3ad4912131ed3fe21ccde598ab15984f00c
--- /dev/null
+++ b/apps/desktop/electron/mermaid-renderer.ts
@@ -0,0 +1,174 @@
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+import { session, webContents, WebContentsView } from 'electron'
+
+import { MERMAID_SOURCE_LIMIT, MERMAID_SVG_LIMIT, type MermaidRenderResult } from '../../shared/src/mermaid-render'
+
+const RENDER_MS = 5_000
+const RETIRE_MS = 750
+const MAX_REQUESTS = 16
+const UNAVAILABLE = { error: 'unavailable' } as const
+
+function rendererIsExclusive(contents: Electron.WebContents): boolean {
+  if (contents.isDestroyed()) {
+    return false
+  }
+
+  const pid = contents.getOSProcessId()
+
+  return pid > 0 && webContents.getAllWebContents().every(other => other === contents || other.getOSProcessId() !== pid)
+}
+
+function localRequest(entry: URL, target: string, resource: string): boolean {
+  const url = new URL(target)
+
+  if (resource === 'mainFrame') {
+    return url.href === entry.href
+  }
+
+  if (resource !== 'script' && resource !== 'stylesheet') {
+    return false
+  }
+
+  if (entry.protocol !== 'file:') {
+    return url.origin === entry.origin
+  }
+
+  const relative = path.relative(path.dirname(fileURLToPath(entry)), fileURLToPath(url))
+
+  return relative.startsWith(`assets${path.sep}`)
+}
+
+// A document with a separate in-memory partition, no preload and no app
+// access. Keep one renderer across a burst, then dispose it completely.
+export function createMermaidRenderer(getEntry: () => URL) {
+  let helper: WebContentsView | undefined
+  let retire: ReturnType<typeof setTimeout> | undefined
+  let active = 0
+  let queue = Promise.resolve()
+
+  const close = (view: WebContentsView | undefined) => {
+    if (helper === view) {
+      helper = undefined
+    }
+
+    const contents = view?.webContents
+
+    if (contents && !contents.isDestroyed()) {
+      contents.close()
+    }
+  }
+
+  function getView() {
+    if (helper && !helper.webContents.isDestroyed()) {
+      return { view: helper, ready: Promise.resolve() }
+    }
+
+    const entry = getEntry()
+    const partition = session.fromPartition('hermes-mermaid-renderer')
+    partition.setPermissionCheckHandler(() => false)
+    partition.setPermissionRequestHandler((_contents, _permission, callback) => callback(false))
+    partition.webRequest.onBeforeRequest((details, callback) => {
+      let allowed = false
+
+      try {
+        allowed = localRequest(entry, details.url, details.resourceType)
+      } catch {
+        // Malformed and non-file paths are refused.
+      }
+
+      callback({ cancel: !allowed })
+    })
+
+    const view = new WebContentsView({
+      webPreferences: { backgroundThrottling: false, contextIsolation: true, sandbox: true, session: partition }
+    })
+
+    helper = view
+    view.webContents.setWindowOpenHandler(() => ({ action: 'deny' }))
+    view.webContents.on('will-frame-navigate', event => event.preventDefault())
+
+    return { view, ready: view.webContents.loadURL(entry.href) }
+  }
+
+  async function draw(code: string, dark: boolean): Promise<MermaidRenderResult> {
+    let view: WebContentsView | undefined
+    let timer: ReturnType<typeof setTimeout> | undefined
+
+    const expired = new Promise<MermaidRenderResult>(resolve => {
+      timer = setTimeout(() => {
+        resolve({ error: 'timeout' })
+        const contents = view?.webContents
+
+        // Electron can share a renderer across WebContents. Never crash a
+        // renderer that also owns a user window.
+        if (contents && rendererIsExclusive(contents)) {
+          contents.forcefullyCrashRenderer()
+        }
+
+        close(view)
+      }, RENDER_MS)
+    })
+
+    const result = (async (): Promise<MermaidRenderResult> => {
+      try {
+        const loading = getView()
+        view = loading.view
+        await loading.ready
+        const contents = view.webContents
+
+        if (!rendererIsExclusive(contents)) {
+          close(view)
+
+          return UNAVAILABLE
+        }
+
+        const data = await contents.executeJavaScript(`window.hermesRenderMermaid(${JSON.stringify(code)}, ${dark})`)
+
+        if (typeof data?.svg === 'string' && data.svg.length <= MERMAID_SVG_LIMIT) {
+          return { svg: data.svg }
+        }
+
+        if (data?.error === 'invalid' || data?.error === 'limit' || data?.error === 'restricted') {
+          return { error: data.error }
+        }
+
+        return UNAVAILABLE
+      } catch {
+        close(view)
+
+        return UNAVAILABLE
+      }
+    })()
+
+    try {
+      return await Promise.race([result, expired])
+    } finally {
+      clearTimeout(timer)
+    }
+  }
+
+  return (code: unknown, dark: unknown): Promise<MermaidRenderResult> => {
+    if (typeof code !== 'string' || typeof dark !== 'boolean') {
+      return Promise.resolve(UNAVAILABLE)
+    }
+
+    if (code.length > MERMAID_SOURCE_LIMIT || active >= MAX_REQUESTS) {
+      return Promise.resolve({ error: 'limit' })
+    }
+
+    clearTimeout(retire)
+    active += 1
+    const result = queue.then(() => draw(code, dark))
+    queue = result.then(() => {
+      active -= 1
+
+      if (!active) {
+        retire = setTimeout(() => close(helper), RETIRE_MS)
+      }
+    })
+
+    return result
+  }
+}
diff --git a/apps/desktop/electron/native/pdf-raster-memory.test.c b/apps/desktop/electron/native/pdf-raster-memory.test.c
new file mode 100644
index 0000000000000000000000000000000000000000..23c32f309256ae1f4b0b7535da3f845a21496b4f
--- /dev/null
+++ b/apps/desktop/electron/native/pdf-raster-memory.test.c
@@ -0,0 +1,31 @@
+// Insert a bounded allocation inside the parser call without changing the shipped helper.
+#include <CoreGraphics/CoreGraphics.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <unistd.h>
+
+static CGPDFDocumentRef parser_with_pressure(CGDataProviderRef provider);
+#define CGPDFDocumentCreateWithProvider parser_with_pressure
+#define main pdf_raster_main
+#include "pdf-raster.c"
+#undef main
+#undef CGPDFDocumentCreateWithProvider
+
+static CGPDFDocumentRef parser_with_pressure(CGDataProviderRef provider) {
+    fputs("pressure-start\n", stderr);
+    const size_t bytes = 160 * 1024 * 1024;
+    const size_t page = (size_t)getpagesize();
+    volatile unsigned char *memory = malloc(bytes);
+    if (!memory) _Exit(10);
+    for (size_t offset = 0; offset < bytes; offset += page) memory[offset] = 1;
+    const struct timespec hold = {0, 350 * 1000 * 1000};
+    nanosleep(&hold, NULL);
+    free((void *)memory);
+    fputs("pressure-return\n", stderr);
+    return CGPDFDocumentCreateWithProvider(provider);
+}
+
+int main(void) {
+    return pdf_raster_main(1, NULL);
+}
diff --git a/apps/desktop/electron/native/pdf-raster.c b/apps/desktop/electron/native/pdf-raster.c
new file mode 100644
index 0000000000000000000000000000000000000000..9384c3d660ffce6bb34a2700cd7167c6f5d76ac4
--- /dev/null
+++ b/apps/desktop/electron/native/pdf-raster.c
@@ -0,0 +1,103 @@
+#include <CoreFoundation/CoreFoundation.h>
+#include <CoreGraphics/CoreGraphics.h>
+#include <ImageIO/ImageIO.h>
+#include <libproc.h>
+#include <math.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#include <time.h>
+#include <unistd.h>
+
+enum {
+    inputLimit = 512 * 1024, pngLimit = 128 * 1024, maxEdge = 640, maxPoints = 8192,
+    memoryLimit = 128 * 1024 * 1024, memoryExit = 9
+};
+
+static void enforce_memory_budget(void) {
+    struct rusage_info_v4 usage;
+    if (proc_pid_rusage(getpid(), RUSAGE_INFO_V4, (rusage_info_t *)&usage) != 0 ||
+        usage.ri_lifetime_max_phys_footprint >= memoryLimit) _Exit(memoryExit);
+}
+
+static void *watch_memory(void *unused) {
+    (void)unused;
+    const struct timespec interval = {0, 10 * 1000 * 1000};
+    // shortcut: a sampled peak guard can overshoot, use a kernel cap when available.
+    for (;;) {
+        nanosleep(&interval, NULL);
+        enforce_memory_budget();
+    }
+}
+
+static int render(void) {
+    static UInt8 input[inputLimit + 1];
+    size_t count = fread(input, 1, sizeof(input), stdin);
+    if (ferror(stdin) || count < 5 || count > inputLimit || memcmp(input, "%PDF-", 5) != 0) return 2;
+
+    CFDataRef bytes = CFDataCreateWithBytesNoCopy(NULL, input, (CFIndex)count, kCFAllocatorNull);
+    CGDataProviderRef provider = bytes ? CGDataProviderCreateWithCFData(bytes) : NULL;
+    CGPDFDocumentRef doc = provider ? CGPDFDocumentCreateWithProvider(provider) : NULL;
+    CGPDFPageRef page = doc && !CGPDFDocumentIsEncrypted(doc) ? CGPDFDocumentGetPage(doc, 1) : NULL;
+    if (!page) return 3;
+
+    CGRect crop = CGPDFPageGetBoxRect(page, kCGPDFCropBox);
+    double width = crop.size.width, height = crop.size.height;
+    if (!isfinite(width) || !isfinite(height) || width <= 0 || height <= 0 ||
+        width > maxPoints || height > maxPoints ||
+        !isfinite(crop.origin.x) || !isfinite(crop.origin.y) ||
+        fabs(crop.origin.x) > maxPoints || fabs(crop.origin.y) > maxPoints) return 4;
+
+    int rotation = CGPDFPageGetRotationAngle(page);
+    if (rotation % 90 != 0) return 4;
+    if (rotation % 180 != 0) {
+        double swap = width;
+        width = height;
+        height = swap;
+    }
+    double scale = fmin(1., maxEdge / fmax(width,height));
+    size_t rasterWidth = (size_t)fmax(1, round(width * scale));
+    size_t rasterHeight = (size_t)fmax(1, round(height * scale));
+    CGRect output = CGRectMake(0, 0, rasterWidth, rasterHeight);
+
+    CGColorSpaceRef color = CGColorSpaceCreateDeviceRGB();
+    CGContextRef ctx = color ? CGBitmapContextCreate(NULL,rasterWidth,rasterHeight,8,0,color,kCGImageAlphaNoneSkipLast) : NULL;
+    if (!ctx) return 5;
+    CGContextSetRGBFillColor(ctx,1,1,1,1);
+    CGContextFillRect(ctx,output);
+    CGContextConcatCTM(ctx,CGPDFPageGetDrawingTransform(page,kCGPDFCropBox,output,0,true));
+    CGContextDrawPDFPage(ctx,page);
+    CGImageRef image = CGBitmapContextCreateImage(ctx);
+    CFMutableDataRef data = CFDataCreateMutable(NULL,0);
+    CGImageDestinationRef dest = image && data ? CGImageDestinationCreateWithData(data, CFSTR("public.png"), 1, NULL) : NULL;
+    if (!dest) return 6;
+    CGImageDestinationAddImage(dest,image,NULL);
+    if (!CGImageDestinationFinalize(dest) || CFDataGetLength(data) > pngLimit) return 7;
+    size_t size = (size_t)CFDataGetLength(data);
+    enforce_memory_budget();
+    if (fwrite(CFDataGetBytePtr(data),1,size,stdout) != size || fflush(stdout) != 0) return 8;
+
+    CGPDFDocumentRelease(doc);
+    CGDataProviderRelease(provider);
+    CGImageRelease(image);
+    CGContextRelease(ctx);
+    CGColorSpaceRelease(color);
+    CFRelease(bytes);
+    CFRelease(dest);
+    CFRelease(data);
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    (void)argv;
+    // One bounded document on stdin, one static PNG on stdout.
+    if (argc != 1) return 1;
+    enforce_memory_budget();
+    pthread_t watchdog;
+    if (pthread_create(&watchdog, NULL, watch_memory, NULL) != 0) return memoryExit;
+    int result = render();
+    if (result == 0) enforce_memory_budget();
+    return result;
+}
