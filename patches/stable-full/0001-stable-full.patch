+"""Byte-exact patch source reads must avoid local shell probes."""
+import hashlib
+import json
+import os
+from unittest.mock import Mock
+
+import pytest
+
+from tools.environments.local import LocalEnvironment
+from tools.file_operations import ShellFileOperations
+
+pytestmark = pytest.mark.platforms("linux", "macos")
+
+
+@pytest.fixture
+def ops(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_NATIVE_FILE_READ", "1")
+    result = ShellFileOperations(LocalEnvironment(cwd=str(tmp_path)), cwd=str(tmp_path))
+    monkeypatch.setattr(result, "_exec", Mock(wraps=result._exec))
+    return result
+
+
+@pytest.mark.parametrize("data", [
+    b"", b"\xef\xbb\xbfhello\r\n", ("ทดสอบ漢字\n" * 200).encode(),
+    b"a" * 1100 + b"\xff\xfe\r\n", b"literal __HERMES_FENCE_ content\x1b[31m\n",
+], ids=["empty", "bom-crlf", "multibyte", "late-invalid-utf8", "literal-escapes"])
+def test_exact_patch_source_without_shell(ops, tmp_path, data):
+    path = tmp_path / "source.txt"
+    path.write_bytes(data)
+    result = ops.read_file_raw(str(path))
+    assert result.error is None and not result.is_binary
+    expected = data[3:] if data.startswith(b"\xef\xbb\xbf") else data
+    assert result.content.encode("utf-8", "surrogateescape") == expected
+    assert result._content_sha256 == hashlib.sha256(data).hexdigest()
+    assert result.file_size == len(data)
+    assert ops._exec.call_count == 0
+
+
+def test_current_cwd_and_symlink(ops, tmp_path):
+    (tmp_path / "source.txt").write_text("old")
+    folder = tmp_path / "next"
+    folder.mkdir()
+    (folder / "source.txt").write_text("new")
+    (folder / "alias.txt").symlink_to(folder / "source.txt")
+    ops.env.cwd = str(folder)
+    assert ops.read_file_raw("alias.txt").content == "new"
+    assert ops._exec.call_count == 0
+
+
+def test_nonregular_files_never_read(ops, tmp_path):
+    pipe = tmp_path / "pipe"
+    os.mkfifo(pipe)
+    dangling = tmp_path / "dangling"
+    dangling.symlink_to(tmp_path / "absent")
+    for path in [pipe, dangling, tmp_path]:
+        result = ops.read_file_raw(str(path))
+        assert result.error and "not a regular file" in result.error
+        assert not result.not_found
+    assert ops._exec.call_count == 0
+
+
+def test_binary_and_image_contract(ops, tmp_path):
+    for name, data in [("nul.dat", b"a\x00b"), ("image.png", b"image"), ("source.zip", b"text")]:
+        path = tmp_path / name
+        path.write_bytes(data)
+        result = ops.read_file_raw(str(path))
+        assert result.is_binary and result.file_size == len(data)
+        assert bool(result.is_image) == (name == "image.png")
+    assert ops._exec.call_count == 0
+
+
+def test_native_opt_out_preserves_shell(ops, tmp_path, monkeypatch):
+    path = tmp_path / "source.txt"
+    path.write_bytes(b"hello\r\n")
+    monkeypatch.setenv("HERMES_NATIVE_FILE_READ", "0")
+    assert ops.read_file_raw(str(path)).content == "hello\r\n"
+    assert ops._exec.call_count > 0
+
+
+def test_missing_cwd_is_not_missing_file(ops, tmp_path):
+    path = tmp_path / "source.txt"
+    path.write_text("present")
+    ops.env.cwd = str(tmp_path / "missing-directory")
+    result = ops.read_file_raw(str(path))
+    assert result.error and not result.not_found and not result.content
+
+
+def test_missing_file_keeps_suggestions(ops, tmp_path):
+    (tmp_path / "source.txt").write_text("nearby")
+    result = ops.read_file_raw(str(tmp_path / "sourc.txt"))
+    assert result.not_found
+    assert str(tmp_path / "source.txt") in result.similar_files
+
+
+def test_remote_backend_keeps_remote_bytes(tmp_path, monkeypatch):
+    from types import SimpleNamespace
+
+    path = tmp_path / "source.txt"
+    path.write_text("HOST")
+    ops = ShellFileOperations(SimpleNamespace(cwd=str(tmp_path)))
+    monkeypatch.setattr(ops, "_probe_regular_file", lambda path: (6, "ok"))
+    monkeypatch.setattr(ops, "_detect_binary", lambda path: (False, b"REMOTE"))
+    monkeypatch.setattr(ops, "_read_exact_bytes", lambda path: (b"REMOTE", None))
+    assert ops.read_file_raw(str(path)).content == "REMOTE"
+
+
+def test_descriptor_stays_bound_to_classified_file(ops, tmp_path, monkeypatch):
+    path = tmp_path / "source.txt"
+    path.write_bytes(b"original\n")
+    replacement = tmp_path / "replacement"
+    replacement.write_bytes(b"new\x00binary")
+    original_fstat = os.fstat
+
+    def replace_after_open(fd):
+        info = original_fstat(fd)
+        os.replace(replacement, path)
+        return info
+
+    monkeypatch.setattr(os, "fstat", replace_after_open)
+    result = ops.read_file_raw(str(path))
+    assert result.content == "original\n"
+    assert result._content_sha256 == hashlib.sha256(b"original\n").hexdigest()
+    assert path.read_bytes() == b"new\x00binary"
+    assert ops._exec.call_count == 0
+
+
+def test_permission_error_never_falls_back_or_claims_absence(ops, tmp_path, monkeypatch):
+    def denied(*args, **kwargs):
+        raise PermissionError("fixture access denied")
+
+    monkeypatch.setattr(os, "open", denied)
+    result = ops.read_file_raw(str(tmp_path / "private"))
+    assert result.error and "fixture access denied" in result.error
+    assert not result.not_found and not result.content
+    assert ops._exec.call_count == 0
+
+
+def test_registry_patch_preserves_bytes_and_conflict_guard(ops, tmp_path, monkeypatch):
+    from tools import file_tools as ft
+    from tools.registry import registry
+
+    monkeypatch.setattr(ft, "_get_file_ops", lambda task_id: ops)
+    target = tmp_path / "notes.txt"
+    before = b"\xef\xbb\xbfold line\r\n" + b"a" * 1100 + b"\xff\r\n"
+    target.write_bytes(before)
+    raw_calls = []
+    original = ops.read_file_raw
+
+    def observed(path):
+        count = ops._exec.call_count
+        result = original(path)
+        raw_calls.append(ops._exec.call_count - count)
+        return result
+
+    monkeypatch.setattr(ops, "read_file_raw", observed)
+    patch = f"*** Begin Patch\n*** Update File: {target}\n@@\n-old line\n+new line\n*** End Patch"
+    result = json.loads(registry.dispatch("patch", {"mode": "patch", "patch": patch}, task_id="raw-native-integration"))
+    assert result.get("success"), result
+    assert target.read_bytes() == before.replace(b"old line", b"new line")
+    assert raw_calls and not any(raw_calls)
+    # A stale edit is refused rather than overwriting an external writer.
+    external = before.replace(b"old line", b"external change")
+    target.write_bytes(external)
+    result = json.loads(registry.dispatch("patch", {"mode": "patch", "patch": patch}, task_id="raw-native-integration"))
+    assert not result.get("success")
+    assert target.read_bytes() == external
