+def test_discovery_contract_example_can_complete_a_native_think_handoff(fleet):
+    import re
+    from hermes_cli import kanban_db as kb, kanban_db_connect as kbc
+    from hermes_cli.profile_routing import routing_snapshot
+    from hermes_cli.kanban_role_flow import completed_plan
+    before = {p: p.read_bytes() for p in fleet.rglob('config.yaml')}
+    snapshot = routing_snapshot()
+    contract = snapshot['role_plan_contract']
+    step_id = contract['step_id']['example']
+    assert contract['handoff'] == 'metadata.role_plan' and contract['version'] == 1
+    assert contract['step_id']['owner'] == 'think'
+    assert re.fullmatch(contract['step_id']['pattern'], step_id)
+    assert not re.fullmatch(contract['step_id']['pattern'], 'implement_inventory')
+    with kbc.connect_closing() as conn:
+        tid = kb.create_task(conn, title='Discoverable synthetic plan', assignee='think',
+                              workspace_kind='dir', workspace_path=str(fleet))
+        run = kb.claim_task(conn, tid)
+        value = {'version': 1, 'role': 'developer', 'constraints': ['No new authority'],
+                 'steps': [{'id': step_id, 'instructions': 'Preserve summarize_records in inventory_data.py',
+                            'acceptance': ['Offline checks pass'], 'write_scope': ['inventory_data.py']}]}
+        assert kb.complete_task(conn, tid, summary='Plan ready', metadata={'role_plan': value},
+                                expected_run_id=run.current_run_id, fire_lifecycle_hook=False)
+        assert completed_plan(conn, tid)[3]['plan'] == value
+    assert {p: p.read_bytes() for p in fleet.rglob('config.yaml')} == before
+
+
+def test_legacy_only_discovery_omits_plan_contract(fleet):
+    from hermes_cli.profile_routing import routing_snapshot
+    atomic_config_replace(fleet/'config.yaml', {'kanban': {'dispatch_profiles': ['analyst']}})
+    snapshot = routing_snapshot()
+    assert [row['name'] for row in snapshot['profiles']] == ['analyst']
+    assert 'role_plan_contract' not in snapshot
