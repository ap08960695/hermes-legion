+"""An explicit preserving update keeps local source usable and never parks edits as success."""
+import os
+import stat
+
+import pytest
+
+from hermes_cli import main, update_cmd
+from tests.hermes_cli import test_update_target_identity as target
+
+git = target.git
+update_tree = target.update_tree
+_publish_stable = target._publish_stable
+
+
+def local_changes(t):
+    staged = t.clone / '.gitignore'
+    staged.write_text(staged.read_text() + 'my-local-output/\n')
+    git(t.clone, 'add', '.gitignore')
+    untracked = t.clone / 'local-helper.py'
+    untracked.write_text('LOCAL_SETTING = 7\n')
+    return staged.read_bytes(), untracked.read_bytes()
+
+
+def test_preserving_update_keeps_index_and_added_source(update_tree, monkeypatch):
+    t = update_tree
+    _publish_stable(monkeypatch, t)
+    monkeypatch.setattr(update_cmd, '_UPDATE_CRITICAL_MODULES', ())
+    staged, added = local_changes(t)
+    t.args.preserve_local_changes = True
+    main.cmd_update(t.args)
+    assert git(t.clone, 'rev-parse', 'HEAD') == t.wanted
+    assert (t.clone / '.gitignore').read_bytes() == staged
+    assert (t.clone / 'local-helper.py').read_bytes() == added
+    assert git(t.clone, 'diff', '--cached', '--name-only') == '.gitignore'
+    assert len(t.requests) == 1
+
+
+def test_already_current_preserving_update_keeps_the_staged_index(update_tree, monkeypatch):
+    t = update_tree
+    git(t.clone, 'fetch', '-q', 'origin', 'main')
+    git(t.clone, 'checkout', '-q', '--detach', t.wanted)
+    _publish_stable(monkeypatch, t)
+    monkeypatch.setattr(update_cmd, '_UPDATE_CRITICAL_MODULES', ())
+    staged, added = local_changes(t)
+    t.args.preserve_local_changes = True
+    main.cmd_update(t.args)
+    assert (t.clone / '.gitignore').read_bytes() == staged
+    assert (t.clone / 'local-helper.py').read_bytes() == added
+    assert git(t.clone, 'diff', '--cached', '--name-only') == '.gitignore'
+
+
+def test_preserve_conflict_returns_to_the_original_patched_install(update_tree, monkeypatch):
+    t = update_tree
+    _publish_stable(monkeypatch, t)
+    monkeypatch.setattr(update_cmd, '_UPDATE_CRITICAL_MODULES', ())
+    staged, added = local_changes(t)
+    content = t.clone / 'content.txt'
+    content.write_text('local customization\n')
+    before_head = git(t.clone, 'rev-parse', 'HEAD')
+    t.args.preserve_local_changes = True
+    with pytest.raises(SystemExit) as failure:
+        main.cmd_update(t.args)
+    assert failure.value.code == 1
+    assert git(t.clone, 'rev-parse', 'HEAD') == before_head
+    assert content.read_text() == 'local customization\n'
+    assert (t.clone / '.gitignore').read_bytes() == staged
+    assert (t.clone / 'local-helper.py').read_bytes() == added
+    assert git(t.clone, 'diff', '--cached', '--name-only') == '.gitignore'
+    assert t.requests == []
+
+
+@pytest.mark.platforms('posix')
+def test_preserving_update_retains_private_modes_and_symlinks(update_tree, monkeypatch):
+    t = update_tree
+    _publish_stable(monkeypatch, t)
+    monkeypatch.setattr(update_cmd, '_UPDATE_CRITICAL_MODULES', ())
+    local_changes(t)
+    helper = t.clone / 'local-helper.py'
+    helper.chmod(0o640)
+    original_owner = (helper.stat().st_uid, helper.stat().st_gid)
+    link = t.clone / 'helper-link'
+    link.symlink_to('local-helper.py')
+    t.args.preserve_local_changes = True
+    main.cmd_update(t.args)
+    assert stat.S_IMODE(helper.stat().st_mode) == 0o640
+    assert (helper.stat().st_uid, helper.stat().st_gid) == original_owner
+    assert link.is_symlink() and os.readlink(link) == 'local-helper.py'
+
+
+@pytest.mark.platforms('posix')
+def test_clean_checkout_also_retains_non_git_permission_bits(update_tree, monkeypatch):
+    t = update_tree
+    _publish_stable(monkeypatch, t)
+    monkeypatch.setattr(update_cmd, '_UPDATE_CRITICAL_MODULES', ())
+    content = t.clone / 'content.txt'
+    content.chmod(0o640)
+    assert not git(t.clone, 'status', '--porcelain')
+    t.args.preserve_local_changes = True
+    main.cmd_update(t.args)
+    assert git(t.clone, 'rev-parse', 'HEAD') == t.wanted
+    assert stat.S_IMODE(content.stat().st_mode) == 0o640
+
+
+@pytest.mark.parametrize('failure', ['collision', 'invalid-python'])
+def test_preservation_refusal_does_not_complete_an_unpatched_install(update_tree, monkeypatch, failure):
+    t = update_tree
+    _publish_stable(monkeypatch, t)
+    monkeypatch.setattr(update_cmd, '_UPDATE_CRITICAL_MODULES', ())
+    staged, added = local_changes(t)
+    if failure == 'collision':
+        (t.origin / 'local-helper.py').write_text('UPSTREAM_SETTING = 8\n')
+        git(t.origin, 'add', 'local-helper.py')
+        git(t.origin, '-c', 'commit.gpgsign=false', 'commit', '-qm', 'added upstream helper')
+        t.wanted = git(t.origin, 'rev-parse', 'HEAD')
+        _publish_stable(monkeypatch, t)
+    else:
+        added = b'def invalid(\n'
+        (t.clone / 'local-helper.py').write_bytes(added)
+    t.args.preserve_local_changes = True
+    with pytest.raises(SystemExit) as failure:
+        main.cmd_update(t.args)
+    assert failure.value.code == 1
+    assert git(t.clone, 'rev-parse', 'HEAD') == t.base
+    assert (t.clone / '.gitignore').read_bytes() == staged
+    assert (t.clone / 'local-helper.py').read_bytes() == added
+    assert t.requests == []
+
+
+def test_preserving_update_runs_its_native_import_health_probe(update_tree, monkeypatch):
+    t = update_tree
+    _publish_stable(monkeypatch, t)
+    monkeypatch.setattr(update_cmd, '_UPDATE_CRITICAL_MODULES', ())
+    local_changes(t)
+    t.args.preserve_local_changes = True
+    inspect = update_cmd._critical_module_import_failures
+    findings = []
+
+    def observed(*args, **kwargs):
+        result = inspect(*args, **kwargs)
+        findings.append(result)
+        return result
+
+    monkeypatch.setattr(update_cmd, '_critical_module_import_failures', observed)
+    main.cmd_update(t.args)
+    assert findings and all(not item for item in findings), findings
