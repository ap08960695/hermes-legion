+
+
+# Stamps written by agent/tool_executor.py while ONE tool runs; group 1 is the bare tool name (never args).
+_RUNNING_TOOL_RE = re.compile(r"^(?:executing tool|sequential tool running \(\d+s\)): ([\w.:-]{1,64})$")
+
+
+def current_tool_from_description(description: Optional[str]) -> Optional[str]:
+    """Name of the tool an activity stamp says is running now, else ``None``."""
+    match = _RUNNING_TOOL_RE.match((description or "").strip())
+    return match.group(1) if match else None
+
+
+def _non_negative_int(value: Any) -> Optional[int]:
+    try:
+        n = int(value)
+    except (TypeError, ValueError):
+        return None
+    return n if n >= 0 else None
+
+
+def _recorded_cost(value: Any, status: Any, zero_status: str) -> Optional[float]:
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return None
+    try:
+        valid = math.isfinite(value) and (value > 0 or value == 0 and status == zero_status)
+    except OverflowError:
+        return None
+    return value if valid else None
+
+
+def session_row_usage(row: Mapping[str, Any]) -> dict[str, Any]:
+    """Recorded usage from one already-selected row, without lineage or worker aggregation."""
+    model = row.get("model")
+    return {
+        "input_tokens": _non_negative_int(row.get("input_tokens")),
+        "output_tokens": _non_negative_int(row.get("output_tokens")),
+        # Storage zeros lack pricing evidence; latest status does not establish total coverage.
+        "estimated_cost_usd": _recorded_cost(row.get("estimated_cost_usd"), row.get("cost_status"), "estimated"),
+        "actual_cost_usd": _recorded_cost(row.get("actual_cost_usd"), row.get("cost_status"), "actual"),
+        "model": (model.strip()[:256] or None) if isinstance(model, str) else None,
+    }
+
+
+def session_row_progress(row: Mapping[str, Any]) -> dict[str, Any]:
+    """Bounded "what is it doing now" fields read off a SessionDB row already in hand (no extra reads)."""
+    config = row.get("model_config")
+    if isinstance(config, str):
+        try:
+            config = json.loads(config)
+        except ValueError:
+            config = None
+    started = row.get("started_at")
+    return {
+        "current_tool": current_tool_from_description(row.get("last_activity_description")),
+        "iteration": _non_negative_int(row.get("api_call_count")),
+        "max_iterations": bounded_iteration_cap(config.get("max_iterations")) if isinstance(config, dict) else None,
+        "started_at": float(started) if isinstance(started, (int, float)) else None,
+        **session_row_usage(row),
+    }

