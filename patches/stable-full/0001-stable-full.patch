@@ -0,0 +1,154 @@
+"""Incomplete state snapshots must not replace the only recoverable copy."""
+import json
+import sqlite3
+from pathlib import Path
+
+import pytest
+from hermes_cli import backup
+
+
+@pytest.fixture
+def home(tmp_path):
+    root = tmp_path / 'hermes'; root.mkdir()
+    (root / 'config.yaml').write_text('example: original\n')
+    (root / 'auth.json').write_text('{"providers": {}}\n')
+    pairing = root / 'pairing'; pairing.mkdir()
+    (pairing / 'approved.json').write_text('{"example": true}\n')
+    with sqlite3.connect(root / 'state.db') as db:
+        db.execute('CREATE TABLE facts (value TEXT)')
+        db.execute("INSERT INTO facts VALUES ('original')")
+    return root
+
+
+@pytest.mark.parametrize('relative', ['config.yaml', 'auth.json', 'pairing/approved.json'])
+def test_failed_file_copy_retains_previous_complete_snapshot_and_records_failure(home, monkeypatch, relative):
+    first = backup.create_quick_snapshot(label='a', hermes_home=home, keep=1)
+    root = home / 'state-snapshots'; first_dir = root / first
+    original = backup.shutil.copy2
+    target = home / relative
+    def interrupted(src, dst, *args, **kwargs):
+        if Path(src) == target:
+            Path(dst).write_bytes(b'partial')
+            raise OSError('injected interrupted copy')
+        return original(src, dst, *args, **kwargs)
+    monkeypatch.setattr(backup.shutil, 'copy2', interrupted)
+    second = backup.create_quick_snapshot(label='z', hermes_home=home, keep=1)
+    assert first_dir.is_dir(), 'last complete snapshot must survive a failed file copy'
+    assert (first_dir / relative).is_file()
+    current = root / second
+    meta = json.loads((current / 'manifest.json').read_text())
+    assert relative in meta['failed_files'] and relative not in meta['files']
+    assert not (current / relative).exists(), 'a partial copy is not a recovery file'
+
+
+def test_database_copy_exception_retains_previous_complete_snapshot(home, monkeypatch):
+    first = backup.create_quick_snapshot(label='a', hermes_home=home, keep=1)
+    def fail(*args): raise OSError('injected SQLite copy failure')
+    monkeypatch.setattr(backup, '_safe_copy_db', fail)
+    second = backup.create_quick_snapshot(label='z', hermes_home=home, keep=1)
+    root = home / 'state-snapshots'
+    assert (root / first / 'state.db').is_file()
+    meta = json.loads((root / second / 'manifest.json').read_text())
+    assert 'state.db' in meta['failed_dbs'] and 'state.db' not in meta['files']
+
+
+def test_oversized_critical_file_retains_previous_complete_snapshot(home):
+    first = backup.create_quick_snapshot(label='a', hermes_home=home, keep=1)
+    (home / 'auth.json').write_bytes(b'X' * 65536)
+    second = backup.create_quick_snapshot(label='z', hermes_home=home, keep=1, max_file_size=32768)
