+  const local = within(await f.findByRole('region', { name: 'Studio' }))
+  expect(local.getByText('Local endpoint')).toBeTruthy()
+  expect(local.getByText('example-local')).toBeTruthy()
+  expect(local.queryByRole('progressbar')).toBeNull()
+})
