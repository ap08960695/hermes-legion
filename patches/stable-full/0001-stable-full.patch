+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import type { HermesApiRequest } from '../../shared/src/api-request'
+
+import { configRouteRevision, createConfigRouteCapture } from './config-autosave-route'
+import { normalizeRegistry } from './connection-registry'
+
+const write: HermesApiRequest = {
+  path: '/api/config', method: 'PUT', profile: 'mara', body: { config: { enabled: true } }
+}
+
+function setup() {
+  let revision = 'original'
+  const calls: string[] = []
+  const received: { backend: string; path: string; request: HermesApiRequest }[] = []
+
+  const capture = createConfigRouteCapture({
+    revision: () => revision,
+    primaryProfile: () => 'captain',
+    legacyOptions: () => ({ primaryProfile: 'captain', profileRemoteOverride: true, backendProfile: 'default' }),
+    ensureLegacy: async profile => { calls.push(`legacy:${profile}`);
+
+ return { mode: 'remote', target: revision } },
+    ensureRegistry: async id => { calls.push(`registry:${id}`);
+
+ return { mode: 'local', target: revision } },
+    forgetLegacy: async () => { calls.push('forget') },
+    send: async (connection, path, request) => {
+      received.push({ backend: connection.target, path, request })
+
+      return { ok: true }
+    }
+  })
+
+  return { capture, calls, received, switchDestination: () => { revision = 'replacement' } }
+}
+
+test('legacy profile overrides are captured as legacy routes, never repinned to local', async () => {
+  const fixture = setup()
+  const route = fixture.capture(write)
+  assert.deepEqual(fixture.calls, ['legacy:mara'])
+  await Promise.resolve()
+  fixture.switchDestination()
+  await route.send(write)
+  assert.equal(fixture.received[0].backend, 'original')
+  assert.equal(fixture.received[0].request.connectionId, undefined)
+  assert.equal(fixture.received[0].path, '/api/config')
+})
+
+test('a destination change during resolution rejects instead of selecting the replacement', async () => {
+  const fixture = setup()
+  const route = fixture.capture(write)
+  fixture.switchDestination()
+  await assert.rejects(route.send(write), /destination changed/)
+  assert.equal(fixture.received.length, 0)
+})
+
+test('a concrete local registry request keeps local routing and profile query scope', async () => {
+  const fixture = setup()
+  const request = { ...write, connectionId: 'local' }
+  const route = fixture.capture(request)
+  await route.send(request)
+  assert.deepEqual(fixture.calls, ['registry:local'])
+  assert.equal(fixture.received[0].path, '/api/config?profile=mara')
+})
+
+test('implicit registry and legacy profiles have distinct owner identities', () => {
+  const fixture = setup()
+  const legacy = fixture.capture({ ...write, profile: undefined })
+  const registry = fixture.capture({ ...write, profile: undefined, connectionId: 'local' })
+  assert.notEqual(legacy.key, registry.key)
+})
+
+test('a failed resolution retries under the original destination when connectivity recovers', async () => {
+  let online = false
+  let sends = 0
+
+  const capture = createConfigRouteCapture({
+    revision: () => 'original', primaryProfile: () => 'default',
+    legacyOptions: () => ({ primaryProfile: 'default' }),
+    ensureLegacy: async () => {
+      if (!online) { throw new Error('offline') }
+
+      return { mode: 'local' }
+    },
+    ensureRegistry: async () => ({ mode: 'local' }),
+    forgetLegacy: async () => {},
+    send: async () => { sends += 1;
+
+ return { ok: true } }
+  })
+
+  const route = capture(write)
+  await assert.rejects(route.send(write), /offline/)
+  online = true
+  await route.send(write)
+  assert.equal(sends, 1)
+})
+
+test('registry metadata keeps the guard stable while credentials and tenant headers change it', () => {
+  const registry = normalizeRegistry({ primary: 'local', connections: [
+    { id: 'local', kind: 'local', label: 'Local' },
+    { id: 'remote-a', kind: 'remote', label: 'A', url: 'https://a.example', token: 'old' }
+  ] })
+
+  const input = { registry, config: { mode: 'local', profiles: {} } }
+  const request = { ...write, connectionId: 'remote-a' }
+  const before = configRouteRevision(request, input, 'default', {})
+  registry.lastUsed = 'remote-a'
+  registry.connections[1].label = 'Renamed'
+  registry.connections.push({ id: 'unrelated', kind: 'remote', label: 'B', url: 'https://b.example' })
+  assert.equal(configRouteRevision(request, input, 'default', {}), before)
+  registry.connections[1].headers = { 'X-Tenant': 'replacement' }
+  assert.notEqual(configRouteRevision(request, input, 'default', {}), before)
+})
