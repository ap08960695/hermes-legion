diff --git a/plugins/computer_use/agent-desktop/__init__.py b/plugins/computer_use/agent-desktop/__init__.py
new file mode 100644
index 0000000000000000000000000000000000000000..eab6702e978ff5dbf24c816881bba9a2ab33fb32
--- /dev/null
+++ b/plugins/computer_use/agent-desktop/__init__.py
@@ -0,0 +1,23 @@
+"""Opt-in agent-desktop provider with scoped AX reads and semantic ref input."""
+from tools.computer_use.backend import ComputerUseProvider
+
+
+class AgentDesktopProvider(ComputerUseProvider):
+    name = 'agent-desktop'
+    display_name = 'agent-desktop (AX refs)'
+
+    def create_backend(self, *, permission_mode):
+        from tools.computer_use.agent_desktop_backend import AgentDesktopBackend
+        return AgentDesktopBackend(permission_mode=permission_mode)
+
+    def is_available(self):
+        from tools.computer_use.agent_desktop_backend import binary_available
+        return binary_available()
+
+    def doctor(self):
+        from tools.computer_use.agent_desktop import print_agent_desktop_status
+        return print_agent_desktop_status()
+
+
+def register(ctx):
+    ctx.register_computer_use_provider(AgentDesktopProvider())
