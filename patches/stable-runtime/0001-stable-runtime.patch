+def codex_request_hooks(base_url: str, *, async_mode: bool = False) -> dict[str, list] | None:
+    """Bind workspace identity to the SDK's current bearer, then optionally compress.
+
+    A ``key_cmd`` bearer is materialized by the SDK after client construction. Reading
+    Authorization here also follows token rotation without minting a second token.
+    Check the actual request origin so another URL on this client is left untouched.
+    """
+    if not is_official_codex_base_url(base_url):
+        return None
+    compression = (codex_request_compression_hooks(base_url, async_mode=async_mode) or {}).get("request", [])
+
+    def identify(request: Any) -> None:
+        scheme, _, bearer = request.headers.get("Authorization", "").partition(" ")
+        current = codex_account_headers(bearer) if scheme.lower() == "bearer" else {}
+        if current:
+            for name in ("ChatGPT-Account-ID", "x-openai-internal-codex-residency"):
+                request.headers.pop(name, None)
+            request.headers.update(current)
+
+    def prepare(request: Any) -> None:
+        if is_official_codex_base_url(str(request.url)):
+            identify(request)
+            for hook in compression:
+                hook(request)
+
+    async def prepare_async(request: Any) -> None:
+        if is_official_codex_base_url(str(request.url)):
+            identify(request)
+            for hook in compression:
+                await hook(request)
+
+    return {"request": [prepare_async if async_mode else prepare]}
+
+
