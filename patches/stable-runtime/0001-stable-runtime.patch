@@ -0,0 +1,28 @@
+"""Managed workers must retain their named provider's explicit wire dialect."""
+import json
+
+import pytest
+
+from tests.gateway.test_managed_turn_contract import assignment
+from tests.gateway.test_managed_worker_route_key import _execute
+
+
+@pytest.mark.parametrize("wire", ["codex_responses", "anthropic_messages", "chat_completions"])
+@pytest.mark.parametrize("launch_key", [None, "synthetic-launch-key"])
+def test_worker_uses_frozen_provider_wire_with_or_without_launch_key(tmp_path, monkeypatch, wire, launch_key):
+    frame, _ = assignment(tmp_path, monkeypatch)
+    config = json.loads(frame["policy"]["config_json"])
+    config["model"] = {"provider": "custom:wire-fixture", "default": "synthetic-model"}
+    config["providers"] = {"wire-fixture": {
+        "base_url": "https://wire.example/api", "api_mode": wire, "api_key": "synthetic-route-key"}}
+    request = {k: v for k, v in json.loads(frame["policy"]["request_json"]).items()
+               if k not in ("base_url", "provider")}
+    frame = {**frame, "api_key": launch_key, "policy": {
+        **frame["policy"], "model": "synthetic-model", "config_json": json.dumps(config),
+        "request_json": json.dumps(request)}}
+
+    built = _execute(frame, monkeypatch)
+
+    assert built.get("api_mode") == wire
+    assert built["api_key"] == (launch_key or "synthetic-route-key")
+    assert built["base_url"] == "https://wire.example/api"
