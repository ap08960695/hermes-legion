@@ -0,0 +1,108 @@
+"""A callable bearer must identify its current Codex workspace on every request."""
+import base64
+import json
+
+import httpx
+from openai import AsyncOpenAI, OpenAI
+import pytest
+
+from agent import process_bootstrap as bootstrap
+
+BASE = "https://chatgpt.com/backend-api/codex"
+
+
+def token(account, residency):
+    claims = {"https://api.openai.com/auth": {
+        "chatgpt_account_id": account, "chatgpt_data_residency": residency}}
+    payload = base64.urlsafe_b64encode(json.dumps(claims).encode()).decode().rstrip("=")
+    return f"synthetic.{payload}.signature"
+
+
+def response(request):
+    return httpx.Response(200, request=request, json={
+        "id": "resp_synthetic", "object": "response", "created_at": 0,
+        "model": "synthetic", "status": "completed", "output": []})
+
+
+@pytest.fixture
+def wire(monkeypatch):
+    seen = []
+
+    def handler(request):
+        seen.append(dict(request.headers))
+        return response(request)
+
+    transport = httpx.MockTransport(handler)
+    monkeypatch.setattr(bootstrap, "_get_proxy_for_base_url", lambda _url: None)
+    monkeypatch.setattr(bootstrap, "_get_shared_transport", lambda _key, _build: transport)
+    monkeypatch.setattr(httpx, "AsyncHTTPTransport", lambda **_kw: httpx.MockTransport(handler))
+    return seen
+
+
+def test_callable_bearer_workspace_headers_follow_rotation(wire):
+    tokens = iter([token("workspace-one", "eu"), token("workspace-two", "us")])
+    client = OpenAI(api_key=lambda: next(tokens), base_url=BASE,
+                    http_client=bootstrap.build_keepalive_http_client(BASE), max_retries=0)
+    try:
+        for _ in range(2):
+            client.responses.create(model="synthetic", input="offline fixture")
+    finally:
+        client.close()
+    assert [r.get("chatgpt-account-id") for r in wire] == ["workspace-one", "workspace-two"]
+    assert [r.get("x-openai-internal-codex-residency") for r in wire] == ["eu", "us"]
+
+
+@pytest.mark.asyncio
+async def test_async_callable_bearer_workspace_headers_follow_rotation(wire):
+    tokens = iter([token("workspace-one", "eu"), token("workspace-two", "us")])
+
+    async def mint():
+        return next(tokens)
+
+    client = AsyncOpenAI(api_key=mint, base_url=BASE,
+                         http_client=bootstrap.build_keepalive_http_client(BASE, async_mode=True),
+                         max_retries=0)
+    try:
+        for _ in range(2):
+            await client.responses.create(model="synthetic", input="offline fixture")
+    finally:
+        await client.close()
+    assert [r.get("chatgpt-account-id") for r in wire] == ["workspace-one", "workspace-two"]
+    assert [r.get("x-openai-internal-codex-residency") for r in wire] == ["eu", "us"]
+
+
+def test_bearer_identity_is_not_added_to_other_origins(wire):
+    client = bootstrap.build_keepalive_http_client(BASE)
+    try:
+        client.post("https://proxy.example/responses", headers={
+            "Authorization": "Bearer " + token("workspace-one", "eu")}, json={"input": "offline"})
+    finally:
+        client.close()
+    assert wire[0].get("chatgpt-account-id") is None
+    assert wire[0].get("x-openai-internal-codex-residency") is None
+
+
+def test_identity_still_applies_without_optional_compression(wire, monkeypatch):
+    from agent import codex_headers
+
+    monkeypatch.setattr(codex_headers, "codex_request_compression_hooks", lambda *_a, **_kw: None)
+    client = OpenAI(api_key=lambda: token("workspace-one", "eu"), base_url=BASE,
+                    http_client=bootstrap.build_keepalive_http_client(BASE), max_retries=0)
+    try:
+        client.responses.create(model="synthetic", input="offline fixture")
+    finally:
+        client.close()
+    assert wire[0].get("chatgpt-account-id") == "workspace-one"
+    assert "content-encoding" not in wire[0]
+
+
+def test_current_bearer_replaces_stale_workspace_and_residency(wire):
+    client = OpenAI(api_key=lambda: token("workspace-two", None), base_url=BASE,
+                    http_client=bootstrap.build_keepalive_http_client(BASE), max_retries=0,
+                    default_headers={"ChatGPT-Account-ID": "stale", "x-openai-internal-codex-residency": "eu"})
+    try:
+        client.responses.create(model="synthetic", input="offline fixture")
+    finally:
+        client.close()
+    assert wire[0].get("chatgpt-account-id") == "workspace-two"
+    assert "x-openai-internal-codex-residency" not in wire[0]
