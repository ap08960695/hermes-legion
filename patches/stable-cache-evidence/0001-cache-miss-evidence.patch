diff --git a/tests/hermes_cli/test_cache_miss_evidence.py b/tests/hermes_cli/test_cache_miss_evidence.py
new file mode 100644
index 00000000..a082fb2a
--- /dev/null
+++ b/tests/hermes_cli/test_cache_miss_evidence.py
@@ -0,0 +1,24 @@
+"""An idle interval cannot establish why a provider stopped reporting cache reads."""
+
+import pytest
+
+from hermes_cli.observability.shared_metrics_efficiency import SessionEfficiency
+
+
+@pytest.mark.parametrize(
+    ("provider", "idle_seconds"),
+    [("openai-codex", 600), ("anthropic", 7_200)],
+)
+def test_long_idle_cache_miss_keeps_cause_unproven(provider, idle_seconds):
+    route = {"provider": provider, "model": "example-model"}
+    efficiency = SessionEfficiency()
+    assert efficiency.observe_cache(
+        route, {"cache_read_tokens": 8_192}, 1_000_000_000, 2_000_000_000, expected=False,
+    ) is None
+
+    started = 2_000_000_000 + idle_seconds * 1_000_000_000
+    cause = efficiency.observe_cache(
+        route, {"cache_read_tokens": 0}, started, started + 1_000_000_000, expected=False,
+    )
+
+    assert cause == "provider_reported_miss"
